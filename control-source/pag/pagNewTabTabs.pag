Private Sub RemoveCustomColor()
    ' Empty and not the general color: the control no longer collapses the two
    mTabData(mTab).CustomColor(cboColorID.ItemData(cboColorID.ListIndex)) = Empty
    Changed = True
    ShowCustomColor
End Sub

Private Sub cmdRemoveTab_Click()
    Dim iTabData() As T_TabDataP
    Dim t As Long
    
    If mTabData(mTab).Controls.Count > 0 Then
        MsgBox "Tab " & CStr(mTab) & " has controls, can't remove tabs with controls. Remove the contained controls first.", vbCritical
        Exit Sub
    End If
    If mTabs = 1 Then
        MsgBox "Can't remove last tab.", vbCritical
        Exit Sub
    End If
    
    ReDim iTabData(mTabs - 2)
    For t = 0 To mTab - 1
        iTabData(t) = mTabData(t)
    Next t
    For t = mTab + 1 To mTabs - 1
        iTabData(t - 1) = mTabData(t)
        If iTabData(t - 1).Caption = "Tab " & CStr(t) Then
            iTabData(t - 1).Caption = "Tab " & CStr(t - 1)
        End If
    Next t
    mTabs = mTabs - 1
    
    ReDim mTabData(mTabs - 1)
    For t = 0 To mTabs - 1
        mTabData(t) = iTabData(t)
    Next t
    
    If mTab = mTabs Then
        mTab = mTab - 1
    End If
    
    Changed = True
    
    ' The preview has to shrink with the mirror: a removed tab left on screen hands back a TabSel
    ' that mTabData no longer has
    RefreshPreviewFromMirror
    
    ShowTabData
End Sub

Private Sub cmdTabNext_Click()
    mLoading = True
    If mTab < UBound(mTabData) Then
        mTab = mTab + 1
        ShowTabData
    Else
        cmdTabNext.Enabled = False
    End If
    mLoading = False
End Sub

