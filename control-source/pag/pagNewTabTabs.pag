Private Sub PropertyPage_ApplyChanges()
    Dim t As Integer
    Dim iSC As NewTab
    Dim iDefaultIconFont As StdFont
    Dim iTabsPrev As Long
    Dim c As Long
    
    Set iDefaultIconFont = New StdFont
    iDefaultIconFont.Name = cPropDef_IconFontName
    iDefaultIconFont.Size = cPropDef_IconFontSize
    
    FinishTabCountEdit
    Set iSC = SelectedControls(0)
    iSC.HideAllContainedControls
    iTabsPrev = iSC.Tabs
    If Not mTDIMode Then
        If mTabs > iSC.Tabs Then
            iSC.Tabs = mTabs
        End If
    End If
    For t = 0 To iSC.Tabs - 1
        iSC.TabKey(t) = ""
    Next
    For t = 0 To mTabs - 1
        iSC.TabCaption(t) = mTabData(t).Caption
        iSC.TabToolTipText(t) = mTabData(t).ToolTipText
        iSC.TabTag(t) = mTabData(t).Tag
        iSC.TabData(t) = mTabData(t).Data
        iSC.TabKey(t) = mTabData(t).Key
        iSC.TabFixedWidth(t) = mTabData(t).FixedWidth
        iSC.TabEnabled(t) = mTabData(t).Enabled
        iSC.TabVisible(t) = mTabData(t).Visible
        iSC.TabCloseButton(t) = mTabData(t).CloseButton
        iSC.TabCloseButtonEnabled(t) = mTabData(t).CloseButtonEnabled
        iSC.TabMovable(t) = mTabData(t).Movable
        Set iSC.TabPicture(t) = mTabData(t).Picture
        Set iSC.TabPic16(t) = mTabData(t).Pic16
        Set iSC.TabPic20(t) = mTabData(t).Pic20
        Set iSC.TabPic24(t) = mTabData(t).Pic24
        If Not mTDIMode Then Set iSC.TabControlsNames(t) = mTabData(t).Controls
        If mTabData(t).IconFont Is Nothing Then
            Set iSC.TabIconFont(t) = Nothing
        ElseIf FontsAreEqual(mTabData(t).IconFont, iDefaultIconFont) Then
            Set iSC.TabIconFont(t) = Nothing
        Else
            Set iSC.TabIconFont(t) = CloneFont(mTabData(t).IconFont)
        End If
        iSC.TabIconCharHex(t) = "&H" & Hex$(mTabData(t).IconChar) & "&"
        iSC.TabIconLeftOffset(t) = mTabData(t).IconLeftOffset
        iSC.TabIconTopOffset(t) = mTabData(t).IconTopOffset
        iSC.TabIconInColor(t) = mTabData(t).IconInColor
        For c = 0 To ntCCFlatTabBorderColorInactive
            iSC.TabCustomColor(t, c) = CustomColorForControl(mTabData(t).CustomColor(c))
        Next
    Next t
    If Not mTDIMode Then
        For t = mTabs To iTabsPrev - 1
            Set iSC.TabControlsNames(t) = New Collection
        Next
        iSC.Tabs = mTabs
        If Not iSC.Subclassed Then If iSC.TabVisible(Val(txtTab.Text)) Then iSC.TabSel = Val(txtTab.Text)
    End If
    iSC.MakeContainedControlsInSelTabVisible
    gPagTabsApplyTime = Timer
    gPagTabsLastSelectedTab = mTab
    Set mSC = Nothing
End Sub

Private Sub PropertyPage_Initialize()
    Const ES_AUTOHSCROLL As Long = &H80&
    Const ES_LEFT As Long = &H0&
    Const WS_VISIBLE As Long = &H10000000
    Const WS_EX_CLIENTEDGE  As Long = &H200
    
    picTabCaptionHolder.ScaleMode = vbPixels
    Set mUniTextTabCaption = New cUniTextBox
    mUniTextTabCaption.CreateTextBox picTabCaptionHolder.hWnd, 0, 0, picTabCaptionHolder.ScaleWidth, picTabCaptionHolder.ScaleHeight, ES_AUTOHSCROLL Or ES_LEFT Or WS_VISIBLE, WS_EX_CLIENTEDGE, ""
    picTabToolTipTextHolder.ScaleMode = vbPixels
    Set mUniTextTabToolTipText = New cUniTextBox
    mUniTextTabToolTipText.CreateTextBox picTabToolTipTextHolder.hWnd, 0, 0, picTabToolTipTextHolder.ScaleWidth, picTabToolTipTextHolder.ScaleHeight, ES_AUTOHSCROLL Or ES_LEFT Or WS_VISIBLE, WS_EX_CLIENTEDGE, ""
    picTabTagHolder.ScaleMode = vbPixels
    Set mUniTextTabTag = New cUniTextBox
    mUniTextTabTag.CreateTextBox picTabTagHolder.hWnd, 0, 0, picTabTagHolder.ScaleWidth, picTabTagHolder.ScaleHeight, ES_AUTOHSCROLL Or ES_LEFT Or WS_VISIBLE, WS_EX_CLIENTEDGE, ""
    picTabKeyHolder.ScaleMode = vbPixels
    Set mUniTextTabKey = New cUniTextBox
    mUniTextTabKey.CreateTextBox picTabKeyHolder.hWnd, 0, 0, picTabKeyHolder.ScaleWidth, picTabKeyHolder.ScaleHeight, ES_AUTOHSCROLL Or ES_LEFT Or WS_VISIBLE, WS_EX_CLIENTEDGE, ""
    
    ' Seeded here and not written in the .pag so that the file stays pure ASCII: as a literal the
    ' glyph is the byte &HFB, which a UTF-8 round trip corrupts
    cmdRemoveTab.Caption = Chr$(&HFB)
End Sub

Private Sub PropertyPage_Paint()
    If tmrShowTabData.Enabled Then tmrShowTabData_Timer
End Sub

Private Sub PropertyPage_SelectionChanged()
    Dim t As Integer
    Dim iVar As Variant
    Dim c As Long
    
    SetTextBoxNumeric txtTabFixedWidth
    SetTextBoxNumeric txtTabs
    mLoading = True
    Set mSC = SelectedControls(0)
    
    mTDIMode = (mSC.TDIMode <> ntTDIModeNone)
    
    If mTDIMode Then
        picTDICover.Move 0, 0, PropertyPage.ScaleWidth, PropertyPage.ScaleHeight
        picTDICover.Visible = True
        picTDICover.ZOrder
    End If
    
    chkTabVisible.Enabled = Not mTDIMode
    cmdMovePrevious.Enabled = Not mTDIMode
    cmdMoveNext.Enabled = Not mTDIMode
    cmdMoveContainedControls.Enabled = Not mTDIMode
    cmdMoveControlToTab.Enabled = Not mTDIMode
    cmdInsertTab.Enabled = Not mTDIMode
    cmdRemoveTab.Enabled = Not mTDIMode
    
    If TypeName(SelectedControls(0)) <> "NewTab" Then Exit Sub
    
    Set mDefaultIconFont = New StdFont
    mDefaultIconFont.Name = cPropDef_IconFontName
    mDefaultIconFont.Size = cPropDef_IconFontSize
    
    mTabs = mSC.Tabs
    mStashedTabs = 0
    txtTabs.Text = mTabs
    lblTabs.Enabled = Not mTDIMode
    txtTabs.Enabled = Not mTDIMode
    mSC.StoreVisibleControlsInSelectedTab
    ReDim mTabData(mTabs - 1)
    NewTab1.RightToLeft = mSC.RightToLeft
    NewTab1.CloseButton = mSC.CloseButton
    NewTab1.CloseButtonPosition = mSC.CloseButtonPosition
    NewTab1.CaptionAlignment = mSC.CaptionAlignment
    For t = 0 To mTabs - 1
        mTabData(t).Caption = mSC.TabCaption(t)
        mTabData(t).ToolTipText = mSC.TabToolTipText(t)
        mTabData(t).Tag = mSC.TabTag(t)
        mTabData(t).Data = mSC.TabData(t)
        mTabData(t).Key = mSC.TabKey(t)
        mTabData(t).FixedWidth = mSC.TabFixedWidth(t)
        mTabData(t).Enabled = mSC.TabEnabled(t)
        mTabData(t).Visible = mSC.TabVisible(t)
        mTabData(t).CloseButton = mSC.TabCloseButton(t)
        mTabData(t).CloseButtonEnabled = mSC.TabCloseButtonEnabled(t)
        mTabData(t).Movable = mSC.TabMovable(t)
        Set mTabData(t).IconFont = CloneFont(mSC.TabIconFont(t))
        mTabData(t).IconChar = Val(mSC.TabIconCharHex(t) & "&")
        mTabData(t).IconLeftOffset = mSC.TabIconLeftOffset(t)
        mTabData(t).IconTopOffset = mSC.TabIconTopOffset(t)
        mTabData(t).IconInColor = mSC.TabIconInColor(t)
        Set mTabData(t).Picture = mSC.TabPicture(t)
        Set mTabData(t).Pic16 = mSC.TabPic16(t)
        Set mTabData(t).Pic20 = mSC.TabPic20(t)
        Set mTabData(t).Pic24 = mSC.TabPic24(t)
        Set mTabData(t).Controls = New Collection
        For Each iVar In mSC.TabControlsNames(t)
            mTabData(t).Controls.Add iVar
        Next
        For c = 0 To ntCCFlatTabBorderColorInactive
            ' the state first and only then the value: the public Get resolves an inherited slot
            If mSC.TabCustomColorIsSet(t, c) Then
                mTabData(t).CustomColor(c) = mSC.TabCustomColor(t, c)
            Else
                mTabData(t).CustomColor(c) = Empty
            End If
        Next
    Next t
    ' Seeded from the mirror so that CloseButton, CloseButtonEnabled and Movable reach every tab
    RefreshPreviewFromMirror
    If mTabs > 0 Then
        Set mLastIconFont = CloneFont(mSC.TabIconFont(mTabs - 1))
    Else
        Set mLastIconFont = CloneFont(mDefaultIconFont)
    End If
    
    Select Case mSC.TabOrientation
        Case ssTabOrientationRight, ssTabOrientationLeft, ntTabOrientationRightBottom, ntTabOrientationLeftTop
            NewTab1.Width = mSC.Height
            NewTab1.Height = mSC.Width
        Case Else
            NewTab1.Width = mSC.Width
            NewTab1.Height = mSC.Height
    End Select
    NewTab1.Left = (PropertyPage.ScaleWidth - NewTab1.Width) / 2
    
    If ((Timer - gPagTabsApplyTime) < 3) And (gPagTabsApplyTime <> 0) Then
        mTab = gPagTabsLastSelectedTab
    Else
        mTab = mSC.TabSel
    End If
    
    CopyControlProperties mSC, NewTab1
    If mTDIMode Then NewTab1.TabWidthStyle = ntTWTabCaptionWidthFillRows
    
    cboColorID.Clear
    cboColorID.AddItem ntCCBackColorTab & " - ntCCBackColorTab": cboColorID.ItemData(cboColorID.NewIndex) = ntCCBackColorTab
    cboColorID.AddItem ntCCBackColorSelectedTab & " - ntCCBackColorSelectedTab": cboColorID.ItemData(cboColorID.NewIndex) = ntCCBackColorSelectedTab
    cboColorID.AddItem ntCCHighlightColor & " - ntCCHighlightColor": cboColorID.ItemData(cboColorID.NewIndex) = ntCCHighlightColor
    cboColorID.AddItem ntCCHighlightColorSelectedTab & " - ntCCHighlightColorSelectedTab": cboColorID.ItemData(cboColorID.NewIndex) = ntCCHighlightColorSelectedTab
    cboColorID.AddItem ntCCHighlightGradientColor & " - ntCCHighlightGradientColor": cboColorID.ItemData(cboColorID.NewIndex) = ntCCHighlightGradientColor
    cboColorID.AddItem ntCCHighlightGradientColorSelectedTab & " - ntCCHighlightGradientColorSelectedTab": cboColorID.ItemData(cboColorID.NewIndex) = ntCCHighlightGradientColorSelectedTab
    cboColorID.AddItem ntCCFlatBarColorInactive & " - ntCCFlatBarColorInactive": cboColorID.ItemData(cboColorID.NewIndex) = ntCCFlatBarColorInactive
    cboColorID.AddItem ntCCFlatBarColorHighlighted & " - ntCCFlatBarColorHighlighted": cboColorID.ItemData(cboColorID.NewIndex) = ntCCFlatBarColorHighlighted
    cboColorID.AddItem ntCCFlatBarColorSelectedTab & " - ntCCFlatBarColorSelectedTab": cboColorID.ItemData(cboColorID.NewIndex) = ntCCFlatBarColorSelectedTab
    cboColorID.AddItem ntCCFlatTabBorderColorHighlighted & " - ntCCFlatTabBorderColorHighlighted": cboColorID.ItemData(cboColorID.NewIndex) = ntCCFlatTabBorderColorHighlighted
    cboColorID.AddItem ntCCFlatTabBorderColorSelectedTab & " - ntCCFlatTabBorderColorSelectedTab": cboColorID.ItemData(cboColorID.NewIndex) = ntCCFlatTabBorderColorSelectedTab
    cboColorID.AddItem ntCCFlatTabBorderColorInactive & " - ntCCFlatTabBorderColorInactive": cboColorID.ItemData(cboColorID.NewIndex) = ntCCFlatTabBorderColorInactive
    cboColorID.AddItem ntCCForeColor & " - ntCCForeColor": cboColorID.ItemData(cboColorID.NewIndex) = ntCCForeColor
    cboColorID.AddItem ntCCForeColorHighlighted & " - ntCCForeColorHighlighted": cboColorID.ItemData(cboColorID.NewIndex) = ntCCForeColorHighlighted
    cboColorID.AddItem ntCCForeColorSelectedTab & " - ntCCForeColorSelectedTab": cboColorID.ItemData(cboColorID.NewIndex) = ntCCForeColorSelectedTab
    cboColorID.AddItem ntCCIconColor & " - ntCCIconColor": cboColorID.ItemData(cboColorID.NewIndex) = ntCCIconColor
    cboColorID.AddItem ntCCIconColorSelectedTab & " - ntCCIconColorSelectedTab": cboColorID.ItemData(cboColorID.NewIndex) = ntCCIconColorSelectedTab
    cboColorID.AddItem ntCCIconColorMouseHover & " - ntCCIconColorMouseHover": cboColorID.ItemData(cboColorID.NewIndex) = ntCCIconColorMouseHover
    cboColorID.AddItem ntCCIconColorMouseHoverSelectedTab & " - ntCCIconColorMouseHoverSelectedTab": cboColorID.ItemData(cboColorID.NewIndex) = ntCCIconColorMouseHoverSelectedTab
    cboColorID.AddItem ntCCIconColorTabHighlighted & " - ntCCIconColorTabHighlighted": cboColorID.ItemData(cboColorID.NewIndex) = ntCCIconColorTabHighlighted
    cboColorID.AddItem ntCCCloseButtonColor & " - ntCCCloseButtonColor": cboColorID.ItemData(cboColorID.NewIndex) = ntCCCloseButtonColor
    cboColorID.AddItem ntCCCloseButtonColorSelectedTab & " - ntCCCloseButtonColorSelectedTab": cboColorID.ItemData(cboColorID.NewIndex) = ntCCCloseButtonColorSelectedTab
    cboColorID.AddItem ntCCCloseButtonColorMouseHover & " - ntCCCloseButtonColorMouseHover": cboColorID.ItemData(cboColorID.NewIndex) = ntCCCloseButtonColorMouseHover
    cboColorID.AddItem ntCCCloseButtonColorMouseHoverSelectedTab & " - ntCCCloseButtonColorMouseHoverSelectedTab": cboColorID.ItemData(cboColorID.NewIndex) = ntCCCloseButtonColorMouseHoverSelectedTab
    cboColorID.AddItem ntCCCloseButtonColorTabHighlighted & " - ntCCCloseButtonColorTabHighlighted": cboColorID.ItemData(cboColorID.NewIndex) = ntCCCloseButtonColorTabHighlighted
    cboColorID.ListIndex = 0
    
    cboTabCloseButton.Clear
    cboTabCloseButton.AddItem "ntYNAuto": cboTabCloseButton.ItemData(cboTabCloseButton.NewIndex) = ntYNAuto
    cboTabCloseButton.AddItem "ntYes": cboTabCloseButton.ItemData(cboTabCloseButton.NewIndex) = ntYes
    cboTabCloseButton.AddItem "ntNo": cboTabCloseButton.ItemData(cboTabCloseButton.NewIndex) = ntNo
    
    ShowTabData
    
    mLoading = False
End Sub
Private Sub SelectInComboByItemData(nCombo As Control, nItemData As Long)
    Dim c As Long
    
    For c = 0 To nCombo.ListCount - 1
        If nCombo.ItemData(c) = nItemData Then
            nCombo.ListIndex = c
            Exit Sub
        End If
    Next c
End Sub

Private Sub ShowTabData()
    tmrShowTabData.Enabled = False
    tmrShowTabData.Enabled = True
End Sub

Private Sub DoShowTabData()
    Dim t As Long
    
    If mShowingTabData Then Exit Sub
    If tmrRestoreSampleContainer.Enabled Then tmrRestoreSampleContainer_Timer
    mShowingTabData = True
    t = mTab
    txtTab.Text = t
    txtTab.Refresh
    If Not (ActiveControl Is txtTabs) Then
        If txtTabs.Text <> CStr(mTabs) Then txtTabs.Text = mTabs
    End If
    If mUniTextTabCaption.Text <> mTabData(t).Caption Then
        mUniTextTabCaption.Text = mTabData(t).Caption
    End If
    If mUniTextTabToolTipText.Text <> mTabData(t).ToolTipText Then
        mUniTextTabToolTipText.Text = mTabData(t).ToolTipText
    End If
    If mUniTextTabTag.Text <> mTabData(t).Tag Then
        mUniTextTabTag.Text = mTabData(t).Tag
    End If
    If mUniTextTabKey.Text <> mTabData(t).Key Then
        mUniTextTabKey.Text = mTabData(t).Key
    End If
    ' Compared before assigning: assigning .Text sends the caret back to position 0
    If txtTabData.Text <> CStr(mTabData(t).Data) Then
        txtTabData.Text = mTabData(t).Data
    End If
    If txtTabFixedWidth.Text <> CStr(mTabData(t).FixedWidth) Then
        txtTabFixedWidth.Text = mTabData(t).FixedWidth
    End If
    chkTabEnabled.Value = CLng(mTabData(t).Enabled) * -1
    chkTabVisible.Value = CLng(mTabData(t).Visible) * -1
    SelectInComboByItemData cboTabCloseButton, mTabData(t).CloseButton
    chkTabCloseButtonEnabled.Value = CLng(mTabData(t).CloseButtonEnabled) * -1
    chkTabMovable.Value = CLng(mTabData(t).Movable) * -1
    
    cmdTabPrev.Enabled = t > 0
    cmdTabNext.Enabled = t < (mTabs - 1)
    cmdMovePrevious.Enabled = t > 0
    cmdMoveNext.Enabled = t < (mTabs - 1)
    
    lblContainedControls.Caption = "Controls in tab: " & mTabData(t).Controls.Count
    cmdMoveContainedControls.Enabled = (mTabData(t).Controls.Count > 0)
    
    PushTabToPreview t
    
    ShowCustomColor
    
    If (NewTab1.Left + NewTab1.GetTabLeft(mTab) + NewTab1.GetTabWidth(mTab)) > PropertyPage.ScaleWidth Then
        tmrTabChanged.Enabled = True
        NewTab1.Left = PropertyPage.ScaleWidth - (NewTab1.GetTabLeft(mTab) + NewTab1.GetTabWidth(mTab)) - 120
    ElseIf (NewTab1.Left + NewTab1.GetTabLeft(mTab)) < 0 Then
        tmrTabChanged.Enabled = True
        NewTab1.Left = 120 - NewTab1.GetTabLeft(mTab)
    End If
    
    NewTab1.ToolTipText = ""
    If NewTab1.Width > PropertyPage.ScaleWidth Then
        mEnableHorizontalDragging = True
        NewTab1.ToolTipText = "Drag to move the tab control and see other tabs"
    End If
    If PreviewNeedsVerticalDrag(NewTab1, picSampleContainer.ScaleHeight) Then
        mEnableVerticalDragging = True
        NewTab1.ToolTipText = "Drag to move the tab control and see other tabs"
    End If
    
    NewTab1.Top = PreviewTop(NewTab1, picSampleContainer.ScaleHeight)
    

    mShowingTabData = False
End Sub

' Everything the preview can show about one tab, taken from the mirror: mSC is an editing session
' behind until ApplyChanges runs. Visible is left out so that a hidden tab can still be looked at.
' The icon font travels as the same object: the control compares by identity, so a repeated push is
' free; no path on this page mutates a font in place and ApplyChanges clones on the way out
Private Sub PushTabToPreview(ByVal nTab As Long)
    Dim c As Long
    
    NewTab1.TabCaption(nTab) = mTabData(nTab).Caption
    NewTab1.TabToolTipText(nTab) = mTabData(nTab).ToolTipText
    NewTab1.TabFixedWidth(nTab) = mTabData(nTab).FixedWidth
    NewTab1.TabEnabled(nTab) = mTabData(nTab).Enabled
    NewTab1.TabCloseButton(nTab) = mTabData(nTab).CloseButton
    NewTab1.TabCloseButtonEnabled(nTab) = mTabData(nTab).CloseButtonEnabled
    NewTab1.TabMovable(nTab) = mTabData(nTab).Movable
    Set NewTab1.TabPic16(nTab) = mTabData(nTab).Pic16
    Set NewTab1.TabPic20(nTab) = mTabData(nTab).Pic20
    Set NewTab1.TabPic24(nTab) = mTabData(nTab).Pic24
    Set NewTab1.TabPicture(nTab) = mTabData(nTab).Picture
    Set NewTab1.TabIconFont(nTab) = mTabData(nTab).IconFont
    NewTab1.TabIconCharHex(nTab) = "&H" & Hex$(mTabData(nTab).IconChar) & "&"
    NewTab1.TabIconLeftOffset(nTab) = mTabData(nTab).IconLeftOffset
    NewTab1.TabIconTopOffset(nTab) = mTabData(nTab).IconTopOffset
    NewTab1.TabIconInColor(nTab) = mTabData(nTab).IconInColor
    For c = 0 To ntCCFlatTabBorderColorInactive
        NewTab1.TabCustomColor(nTab, c) = CustomColorForControl(mTabData(nTab).CustomColor(c))
    Next c
End Sub

' Inserting or removing shifts every tab from that point up, so the whole preview is re-seeded.
' mLoading is raised because changing the count can move TabSel and re-enter NewTab1_Click, and it
' is restored and not dropped: PropertyPage_SelectionChanged calls this with it already raised
Private Sub RefreshPreviewFromMirror()
    Dim t As Long
    Dim iLoadingPrev As Boolean
    Dim iRedrawPrev As Boolean
    
    iLoadingPrev = mLoading
    iRedrawPrev = NewTab1.Redraw
    mLoading = True
    NewTab1.Redraw = False
    NewTab1.Tabs = mTabs
    For t = 0 To mTabs - 1
        PushTabToPreview t
    Next t
    NewTab1.Redraw = iRedrawPrev
    mLoading = iLoadingPrev
End Sub

Private Sub PropertyPage_Terminate()
    Set mUniTextTabCaption = Nothing
    Set mUniTextTabToolTipText = Nothing
    Set mUniTextTabTag = Nothing
    Set mUniTextTabKey = Nothing
End Sub

Private Sub tmrAutoClick_Timer()
    Dim iHwnd As LongPtr
    
    If Not MouseIsPressingAButton Then
        tmrAutoClick.Enabled = False
    Else
        iHwnd = WindowsUnderMouse
        If (iHwnd = cmdTabPrev.hWnd) Then
            If cmdTabPrev.Enabled Then cmdTabPrev_Click
        ElseIf (iHwnd = cmdTabNext.hWnd) Then
            If cmdTabNext.Enabled Then cmdTabNext_Click
        ElseIf (iHwnd = cmdMovePrevious.hWnd) Then
            If cmdMovePrevious.Enabled Then cmdMovePrevious_Click
        ElseIf (iHwnd = cmdMoveNext.hWnd) Then
            If cmdMoveNext.Enabled Then cmdMoveNext_Click
        End If
    End If
End Sub

Private Sub tmrClick_Timer()
    tmrClick.Enabled = False
    If MouseIsPressingAButton Then
        tmrAutoClick.Enabled = True
    End If
End Sub

Private Sub mUniTextTabCaption_Change()
    If Not mLoading And Not mShowingTabData Then
        Changed = True
        mTabData(mTab).Caption = mUniTextTabCaption.Text
        ShowTabData
    End If
End Sub

Private Sub mUniTextTabToolTipText_Change()
    If Not mLoading And Not mShowingTabData Then
        Changed = True
        mTabData(mTab).ToolTipText = mUniTextTabToolTipText.Text
        ShowTabData
    End If
End Sub

Private Sub mUniTextTabTag_Change()
    If Not mLoading And Not mShowingTabData Then
        Changed = True
        mTabData(mTab).Tag = mUniTextTabTag.Text
    End If
End Sub

Private Sub mUniTextTabKey_Change()
    If Not mLoading And Not mShowingTabData Then
        If mUniTextTabKey.Text <> "" Then
            If IsNumeric(Left$(mUniTextTabKey.Text, 1)) Then
                MsgBox "The TabKey must not start with a number.", vbExclamation
                picTabKeyHolder.SetFocus
                Exit Sub
            End If
        End If
        Changed = True
        mTabData(mTab).Key = mUniTextTabKey.Text
    End If
End Sub

Private Function WindowsUnderMouse() As LongPtr
    Dim iPt As POINTAPI
    
    GetCursorPos iPt
    WindowsUnderMouse = WindowFromPoint(iPt.X, iPt.Y)
End Function

Private Function IsMouseButtonPressed(nButton As NTMouseButtonsConstants) As Boolean
    Dim iButton As Long
    
    iButton = nButton
    If GetSystemMetrics(SM_SWAPBUTTON) <> 0 Then
        If nButton = ntMBLeft Then
            iButton = VK_RBUTTON
        ElseIf nButton = ntMBRight Then
            iButton = VK_LBUTTON
        End If
    End If
    IsMouseButtonPressed = GetAsyncKeyState(iButton) <> 0
End Function

Private Function MouseIsPressingAButton() As Boolean
    Dim iHwnd As LongPtr
    
    If IsMouseButtonPressed(ntMBLeft) Then
        iHwnd = WindowsUnderMouse
        If (iHwnd = cmdTabPrev.hWnd) Or (iHwnd = cmdTabNext.hWnd) Or (iHwnd = cmdMovePrevious.hWnd) Or (iHwnd = cmdMoveNext.hWnd) Then
            MouseIsPressingAButton = True
        End If
    End If
End Function

Private Sub tmrRestoreSampleContainer_Timer()
    tmrRestoreSampleContainer.Enabled = False
    If mDraggingSample Then
        Set NewTab1.Container = picSampleContainer
        NewTab1.Move NewTab1.Left - picSampleContainer.Left, NewTab1.Top - picSampleContainer.Top
        mDraggingSample = False
    End If
End Sub

Private Sub tmrShowTabData_Timer()
    tmrShowTabData.Enabled = False
    DoShowTabData
End Sub

Private Function CloneFont(nOrigFont As iFont) As StdFont
    If nOrigFont Is Nothing Then Exit Function
    nOrigFont.Clone CloneFont
End Function

Private Function FontsAreEqual(nFont1 As StdFont, nFont2 As StdFont) As Boolean
    If nFont1 Is Nothing Or nFont2 Is Nothing Then Exit Function
    
    If (nFont1 Is Nothing) And (nFont2 Is Nothing) Then
        FontsAreEqual = True
        Exit Function
    End If
    If (nFont1 Is Nothing) Then Exit Function
    If (nFont2 Is Nothing) Then Exit Function
    
    If nFont1.Name = nFont2.Name Then
        If nFont1.Size = nFont2.Size Then
            If nFont1.Bold = nFont2.Bold Then
                If nFont1.Italic = nFont2.Italic Then
                    If nFont1.Strikethrough = nFont2.Strikethrough Then
                        If nFont1.Underline = nFont2.Underline Then
                            If nFont1.Weight = nFont2.Weight Then
                                If nFont1.Charset = nFont2.Charset Then
                                    FontsAreEqual = True
                                    Exit Function
                                End If
                            End If
                        End If
                    End If
                End If
            End If
        End If
    End If
End Function

Private Sub tmrStartDraggingSample_Timer()
    Const WM_SETREDRAW = &HB
    
    tmrStartDraggingSample.Enabled = False
    If mMouseDown Then
        If Not tmrRestoreSampleContainer.Enabled Then
            SendMessage PropertyPage.hWnd, WM_SETREDRAW, 0, 0
            NewTab1.Visible = False
            Set NewTab1.Container = Me
            NewTab1.Visible = True
            NewTab1.Move NewTab1.Left + picSampleContainer.Left, NewTab1.Top + picSampleContainer.Top
            SendMessage PropertyPage.hWnd, WM_SETREDRAW, -1, 0
            mDraggingSample = True
        End If
    End If
End Sub

Private Sub txtCustomColor_Change()
    Dim iColor As Long
    Dim iColorID As Long
    
    iColor = -1
    iColorID = cboColorID.ItemData(cboColorID.ListIndex)
    On Error Resume Next
    iColor = CLng(txtCustomColor.Text)
    On Error GoTo 0
    If IsValidOLE_COLOR(iColor) Then
        ' the IsEmpty half is not redundant with the comparison: an unset slot compares equal
        ' to black, so without it typing &H0 into a slot nobody set reads as "no change"
        If IsEmpty(mTabData(mTab).CustomColor(iColorID)) Or (iColor <> mTabData(mTab).CustomColor(iColorID)) Then
            mTabData(mTab).CustomColor(iColorID) = iColor
            ShowCustomColor
            Changed = True
        End If
    ElseIf Trim$(txtCustomColor.Text) = "" Then
        RemoveCustomColor
    End If
End Sub

Private Sub txtTabData_Change()
    Static sPrevValue As String
    Dim iVal As String
    
    If Not mLoading And Not mShowingTabData Then
        ' An emptied box is zero and not a typing error. Nothing is written back to .Text, so the caret
        ' stays put and the box can be left empty while typing
        If Trim$(txtTabData.Text) = "" Then
            sPrevValue = txtTabData.Text
            Changed = True
            mTabData(mTab).Data = 0
            Exit Sub
        End If
        If Not IsNumeric(txtTabData.Text) Then
            MsgBox "This data can hold only numeric Long values", vbExclamation
            txtTabData.Text = sPrevValue
            txtTabData.SetFocus
            Exit Sub
        End If
        
        iVal = "a"
        On Error Resume Next
        iVal = CStr(CLng(txtTabData.Text))
        On Error GoTo 0
        If iVal = "a" Then
            MsgBox "This data can hold only numeric Long values", vbExclamation
            txtTabData.Text = sPrevValue
            txtTabData.SetFocus
            Exit Sub
        End If
        
        sPrevValue = txtTabData.Text
    
        Changed = True
        mTabData(mTab).Data = Val(txtTabData.Text)
    End If
End Sub

Private Sub txtTabFixedWidth_Change()
    Static sPrevValue As String
    Dim iVal As String
    
    If Not mLoading And Not mShowingTabData Then
        ' An emptied box is zero, which here means no fixed width
        If Trim$(txtTabFixedWidth.Text) = "" Then
            sPrevValue = txtTabFixedWidth.Text
            Changed = True
            mTabData(mTab).FixedWidth = 0
            PushTabToPreview mTab
            Exit Sub
        End If
        iVal = "a"
        On Error Resume Next
        iVal = CStr(CLng(txtTabFixedWidth.Text))
        On Error GoTo 0
        If (iVal = "a") Or (Val(iVal) < 0) Then
            txtTabFixedWidth.Text = sPrevValue
            txtTabFixedWidth.SetFocus
            Exit Sub
        End If
        
        sPrevValue = txtTabFixedWidth.Text
    
        Changed = True
        mTabData(mTab).FixedWidth = Val(txtTabFixedWidth.Text)
        ' Pushed straight and not through ShowTabData, which would reassign the box and move the caret
        PushTabToPreview mTab
    End If
End Sub

Private Sub SetTextBoxNumeric(nTxt As Object)
    Const ES_NUMBER As Long = &H2000&
    Const GWL_STYLE = (-16)
    
    SetWindowLong nTxt.hWnd, GWL_STYLE, GetWindowLong(nTxt.hWnd, GWL_STYLE) Or ES_NUMBER
End Sub

Private Sub ShowCustomColor()
    Dim iColorID As NTTabCustomColorIDConstants
    Dim iSlots(ntCCFlatTabBorderColorInactive) As Variant
    Dim iAutomaticColor As Long
    Dim iSelector As New cColorSelector
    Dim c As Long
    
    iColorID = cboColorID.ItemData(cboColorID.ListIndex)
    ' What an unset slot would show: the tab inherits from its own colours first, so the resolver is
    ' asked with the mirror's slots
    For c = 0 To ntCCFlatTabBorderColorInactive
        iSlots(c) = mTabData(mTab).CustomColor(c)
    Next c
    iAutomaticColor = mSC.TabAutomaticCustomColor(iSlots, iColorID)
    If IsEmpty(mTabData(mTab).CustomColor(iColorID)) Then
        picCustomColor.BackColor = iAutomaticColor
        lblCustomColorState.Caption = "(Automatic)"
        txtCustomColor.Text = ""
    Else
        picCustomColor.BackColor = mTabData(mTab).CustomColor(iColorID)
        lblCustomColorState.Caption = ""
        txtCustomColor.Text = "&H" & Hex(mTabData(mTab).CustomColor(iColorID))
        txtCustomColor.SelStart = Len(txtCustomColor.Text)
    End If
    picAutomaticColor.BackColor = iAutomaticColor
    picAutomaticColor.ToolTipText = "&H" & Hex(iAutomaticColor)
    picCustomColor.ToolTipText = iSelector.ColorDisplayName(CustomColorForControl(mTabData(mTab).CustomColor(iColorID))) & " - click to change"
    NewTab1.TabCustomColor(mTab, iColorID) = CustomColorForControl(mTabData(mTab).CustomColor(iColorID))
End Sub

' The mirror says "nobody set this" with Empty and the control says it with -1. Assigning the
' Variant straight through would hand an Empty to an OLE_COLOR parameter, which arrives as
' black and reads as a decision, which is exactly what this page must never write
Private Function CustomColorForControl(ByRef nValue As Variant) As Long
    If IsEmpty(nValue) Then
        CustomColorForControl = -1
    Else
        CustomColorForControl = CLng(nValue)
    End If
End Function

Private Sub tmrTabChanged_Timer()
    tmrTabChanged.Enabled = False
End Sub

Private Sub NewTab1_Click(PreviousTab As Integer)
    If Not mLoading And Not mShowingTabData And Not mDraggingSample Then
        mLoading = True
        mTab = NewTab1.TabSel
        ShowTabData
        mLoading = False
    End If
End Sub

Private Sub NewTab1_MouseDown(Button As Integer, Shift As Integer, X As Single, Y As Single)
    mMouseDown = True
    tmrStartDraggingSample.Enabled = False
    tmrStartDraggingSample.Enabled = True
    If mEnableHorizontalDragging Then
        If Button = vbLeftButton Then
            mXMouseDown = X
        End If
    End If
    If mEnableVerticalDragging Then
        If Button = vbLeftButton Then
            mYMouseDown = Y
        End If
    End If
End Sub

Private Sub NewTab1_MouseMove(Button As Integer, Shift As Integer, X As Single, Y As Single)
    If Not tmrTabChanged.Enabled Then
        If Button = vbLeftButton Then
            If mEnableHorizontalDragging Or mEnableVerticalDragging Then
                If mEnableHorizontalDragging Then
                    NewTab1.Left = NewTab1.Left + X - mXMouseDown
                End If
                If mEnableVerticalDragging Then
                    NewTab1.Top = NewTab1.Top + Y - mYMouseDown
                End If
                DoEvents
            End If
        End If
    End If
End Sub

Private Sub txtTabs_Change()
    Dim iCount As Long
    
    If mLoading Or mShowingTabData Then Exit Sub
    If Not ReadTabCount(iCount) Then Exit Sub
    If iCount = mTabs Then Exit Sub
    If FirstTabWithControlsFrom(iCount) > -1 Then Exit Sub
    SetMirrorTabCount iCount
End Sub

Private Sub txtTabs_LostFocus()
    FinishTabCountEdit
End Sub

Private Function ReadTabCount(ByRef nCount As Long) As Boolean
    Dim iText As String
    
    iText = Trim$(txtTabs.Text)
    If (Len(iText) = 0) Or (Len(iText) > 4) Or (iText Like "*[!0-9]*") Then Exit Function
    If (CLng(iText) < 1) Or (CLng(iText) > 1000) Then Exit Function
    nCount = CLng(iText)
    ReadTabCount = True
End Function

Private Function FirstTabWithControlsFrom(ByVal nCount As Long) As Long
    Dim t As Long
    
    FirstTabWithControlsFrom = -1
    For t = nCount To mTabs - 1
        If mTabData(t).Controls.Count > 0 Then
            FirstTabWithControlsFrom = t
            Exit Function
        End If
    Next t
End Function

' Applied on each keystroke. The tabs cut away are kept aside until the box is left, so that
' typing 20 over 3 goes through 2 without losing the data of tab 2
Private Sub SetMirrorTabCount(ByVal nCount As Long)
    Dim t As Long
    
    If nCount < mTabs Then
        If mStashedTabs < mTabs Then
            ReDim Preserve mStashedTabData(mTabs - 1)
            For t = mStashedTabs To mTabs - 1
                mStashedTabData(t) = mTabData(t)
            Next t
            mStashedTabs = mTabs
        End If
        For t = nCount To mTabs - 1
            mStashedTabData(t) = mTabData(t)
        Next t
        ReDim Preserve mTabData(nCount - 1)
        If mTab > (nCount - 1) Then mTab = nCount - 1
    Else
        ReDim Preserve mTabData(nCount - 1)
        For t = mTabs To nCount - 1
            If t < mStashedTabs Then
                mTabData(t) = mStashedTabData(t)
            Else
                mTabData(t).Caption = "Tab " & CStr(t)
                Set mTabData(t).Controls = New Collection
                Set mTabData(t).IconFont = CloneFont(mLastIconFont)
                mTabData(t).Enabled = True
                mTabData(t).Visible = True
                mTabData(t).CloseButton = ntYNAuto
                mTabData(t).CloseButtonEnabled = True
                mTabData(t).Movable = True
            End If
        Next t
    End If
    mTabs = nCount
    Changed = True
    RefreshPreviewFromMirror
    ShowTabData
End Sub

' A count that could not be applied while typing is explained here, once, and the box shows the
' count in use again
Private Sub FinishTabCountEdit()
    Dim iCount As Long
    Dim iTab As Long
    
    mStashedTabs = 0
    Erase mStashedTabData
    If ReadTabCount(iCount) Then
        If iCount <> mTabs Then
            iTab = FirstTabWithControlsFrom(iCount)
            If iTab > -1 Then MsgBox "Tab " & CStr(iTab) & " has controls, can't remove tabs with controls. Remove the contained controls first.", vbCritical
        End If
    End If
    If txtTabs.Text <> CStr(mTabs) Then txtTabs.Text = mTabs
End Sub

Private Sub txtTab_Change()
    If NewTab1.TabVisible(Val(txtTab.Text)) Then NewTab1.TabSel = Val(txtTab.Text)
    If Not mLoading And Not mShowingTabData Then Changed = True
End Sub
