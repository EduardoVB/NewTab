' What applies and when

Private Function OrientationIsHorizontal(ByVal nTabOrientation As Long) As Boolean
    Select Case nTabOrientation
        Case ntTabOrientationLeftHorizontal, ntTabOrientationRightHorizontal, ntTabOrientationLeftBottomHorizontal, ntTabOrientationRightBottomHorizontal
            OrientationIsHorizontal = True
    End Select
End Function

Private Function EffectiveWidthStyle() As Long
    EffectiveWidthStyle = ComboValue(cboTabWidthStyle)
    If EffectiveWidthStyle = ntTWAuto Then EffectiveWidthStyle = mAutoWidthStyle
End Function

Private Sub SetRowEnabled(nLabel As Label, nField As Control, ByVal nEnabled As Boolean)
    nLabel.Enabled = nEnabled
    nField.Enabled = nEnabled
End Sub

' TabsPerRow only breaks the rows of the grid styles, and the *Horizontal orientations lay out
' columns by TabHeightStyleForHorizontal instead. The two GeneralFixed styles pin the width, so
' they take the place of TabMinWidth and TabMaxWidth, which ntTWEqualWidth does not use either
Private Sub SetEnabledStates()
    Dim iHorizontal As Boolean
    Dim iWidthStyle As Long
    Dim iFixed As Boolean

    iHorizontal = OrientationIsHorizontal(ComboValue(cboTabOrientation))
    iWidthStyle = EffectiveWidthStyle
    iFixed = (iWidthStyle = ntTWGeneralFixedWidth) Or (iWidthStyle = ntTWGeneralFixedWidthFillRows)
    SetRowEnabled lblTabsPerRow, txtTabsPerRow, (Not iHorizontal) And ((iWidthStyle = ntTWEqualWidth) Or (iWidthStyle = ntTWTabCaptionWidth) Or (iWidthStyle = ntTWGeneralFixedWidth))
    SetRowEnabled lblTabHeightStyleForHorizontal, cboTabHeightStyleForHorizontal, iHorizontal
    SetRowEnabled lblStripButtonsRow, cboStripButtonsRow, (ComboValue(cboTabsOverflow) = ntTOMultiRow)
    SetRowEnabled lblShowRowsInPerspective, cboShowRowsInPerspective, (ComboValue(cboTabsOverflow) = ntTOMultiRow)
    SetRowEnabled lblTabHeight, txtTabHeight, (chkAutoTabHeight.Value <> vbChecked)
    SetRowEnabled lblTabGeneralFixedWidth, txtTabGeneralFixedWidth, iFixed
    SetRowEnabled lblTabMinWidth, txtTabMinWidth, (Not iFixed) And (iHorizontal Or (iWidthStyle <> ntTWEqualWidth))
    SetRowEnabled lblTabMaxWidth, txtTabMaxWidth, txtTabMinWidth.Enabled
End Sub

Private Function WidthStyleName(ByVal nWidthStyle As Long) As String
    Select Case nWidthStyle
        Case ntTWTabStripEmulation: WidthStyleName = "TabStripEmulation"
        Case ntTWTabCaptionWidth: WidthStyleName = "TabCaptionWidth"
        Case ntTWEqualWidth: WidthStyleName = "EqualWidth"
        Case ntTWStretchToFill: WidthStyleName = "StretchToFill"
        Case ntTWTabCaptionWidthFillRows: WidthStyleName = "TabCaptionWidthFillRows"
        Case ntTWGeneralFixedWidth: WidthStyleName = "GeneralFixedWidth"
        Case ntTWGeneralFixedWidthFillRows: WidthStyleName = "GeneralFixedWidthFillRows"
    End Select
End Function

Private Sub ShowWidthStyleInfo()
    Dim iText As String

    Select Case ComboValue(cboTabWidthStyle)
        Case ntTWTabStripEmulation: iText = "caption widths, rows as TabStrip"
        Case ntTWTabCaptionWidth: iText = "each tab as wide as its caption"
        Case ntTWEqualWidth: iText = "all equal, TabsPerRow in a row"
        Case ntTWAuto: iText = "Auto = " & WidthStyleName(mAutoWidthStyle)
        Case ntTWStretchToFill: iText = "caption widths, stretched to fill"
        Case ntTWTabCaptionWidthFillRows: iText = "caption widths, rows filled"
        Case ntTWGeneralFixedWidth: iText = "all TabGeneralFixedWidth wide"
        Case ntTWGeneralFixedWidthFillRows: iText = "the same, rows filled"
    End Select
    lblTabWidthStyleInfo.Caption = iText
    lblTabWidthStyleInfo.ToolTipText = iText
End Sub

' Preview

' Converted through himetric: the developer's container and the preview's can have different units
Private Function PreviewSizeX(ByVal nValue As Single) As Single
    Dim iPreviewUnit As Single

    iPreviewUnit = mPreview.FromContainerSizeX(1, vbHimetric)
    If iPreviewUnit <> 0 Then PreviewSizeX = mSC.FromContainerSizeX(nValue, vbHimetric) / iPreviewUnit
End Function

Private Function PreviewSizeY(ByVal nValue As Single) As Single
    Dim iPreviewUnit As Single

    iPreviewUnit = mPreview.FromContainerSizeY(1, vbHimetric)
    If iPreviewUnit <> 0 Then PreviewSizeY = mSC.FromContainerSizeY(nValue, vbHimetric) / iPreviewUnit
End Function

' Same order as ApplyChanges. A value the preview refuses is simply not shown
Private Sub UpdatePreview()
    On Error Resume Next
    mPreview.Redraw = False
    ' As in the other pages: a vertical strip would not fit in the sample
    mPreview.TabOrientation = PreviewTabOrientation(ComboValue(cboTabOrientation))
    Select Case ComboValue(cboTabOrientation)
        Case ssTabOrientationRight, ssTabOrientationLeft, ntTabOrientationRightBottom, ntTabOrientationLeftTop
            mPreview.Move mPreview.Left, mPreview.Top, mSC.Height, mSC.Width
        Case Else
            mPreview.Move mPreview.Left, mPreview.Top, mSC.Width, mSC.Height
    End Select
    mPreview.TabWidthStyle = ComboValue(cboTabWidthStyle)
    mPreview.TabsPerRow = mTabsPerRow
    mPreview.TabHeightStyleForHorizontal = ComboValue(cboTabHeightStyleForHorizontal)
    mPreview.ShowRowsInPerspective = ComboValue(cboShowRowsInPerspective)
    mPreview.TabsOverflow = ComboValue(cboTabsOverflow)
    mPreview.StripButtonsRow = ComboValue(cboStripButtonsRow)
    mPreview.StripEndFreeSpace = PreviewSizeX(mStripEndFreeSpace)
    mPreview.WordWrap = (chkWordWrap.Value = vbChecked)
    mPreview.TabSeparation = mTabSeparation
    mPreview.TabPaddingWidth = mTabPaddingWidth
    mPreview.TabPaddingHeight = mTabPaddingHeight
    mPreview.TabGeneralFixedWidth = PreviewSizeX(mTabGeneralFixedWidth)
    mPreview.TabMaxWidth = 0
    mPreview.TabMinWidth = PreviewSizeX(mTabMinWidth)
    mPreview.TabMaxWidth = PreviewSizeX(mTabMaxWidth)
    If chkAutoTabHeight.Value = vbChecked Then
        mPreview.AutoTabHeight = True
    Else
        mPreview.AutoTabHeight = False
        mPreview.TabHeight = PreviewSizeY(mTabHeight)
    End If
    mPreview.Redraw = True
    On Error GoTo 0
    PlacePreview
End Sub

Private Sub SeedPreviewTab(ByVal nSC As NewTab, ByVal nTab As Long)
    Dim c As Long
    
    For c = 0 To ntCCFlatTabBorderColorInactive
        If nSC.TabCustomColorIsSet(nTab, c) Then
            mPreview.TabCustomColor(nTab, c) = nSC.TabCustomColor(nTab, c)
        Else
            mPreview.TabCustomColor(nTab, c) = -1
        End If
    Next c
    mPreview.TabCaption(nTab) = nSC.TabCaption(nTab)
    mPreview.TabEnabled(nTab) = nSC.TabEnabled(nTab)
    mPreview.TabVisible(nTab) = nSC.TabVisible(nTab)
    mPreview.TabCloseButton(nTab) = nSC.TabCloseButton(nTab)
    mPreview.TabCloseButtonEnabled(nTab) = nSC.TabCloseButtonEnabled(nTab)
    Set mPreview.TabPic16(nTab) = nSC.TabPic16(nTab)
    Set mPreview.TabPic20(nTab) = nSC.TabPic20(nTab)
    Set mPreview.TabPic24(nTab) = nSC.TabPic24(nTab)
    Set mPreview.TabPicture(nTab) = nSC.TabPicture(nTab)
    Set mPreview.TabIconFont(nTab) = CloneFont(nSC.TabIconFont(nTab))
    mPreview.TabIconCharHex(nTab) = nSC.TabIconCharHex(nTab)
    mPreview.TabIconLeftOffset(nTab) = nSC.TabIconLeftOffset(nTab)
    mPreview.TabIconTopOffset(nTab) = nSC.TabIconTopOffset(nTab)
End Sub

' Placed the way Tabs places its sample: centred against the page, then moved so that the selected
' tab is in sight. No dragging as in Tabs and Icons: here only a few tabs are needed to hover
Private Sub PlacePreview()
    mPreview.Left = (PropertyPage.ScaleWidth - mPreview.Width) / 2
    If mPreview.TabSel > -1 Then
        If (mPreview.Left + mPreview.GetTabLeft(mPreview.TabSel) + mPreview.GetTabWidth(mPreview.TabSel)) > PropertyPage.ScaleWidth Then
            mPreview.Left = PropertyPage.ScaleWidth - (mPreview.GetTabLeft(mPreview.TabSel) + mPreview.GetTabWidth(mPreview.TabSel)) - 120
        ElseIf (mPreview.Left + mPreview.GetTabLeft(mPreview.TabSel)) < 0 Then
            mPreview.Left = 120 - mPreview.GetTabLeft(mPreview.TabSel)
        End If
    End If
    mPreview.Top = PreviewTop(mPreview, picSampleContainer.ScaleHeight)
End Sub

Private Sub NewTab1_CloseButtonClick(ByVal nTab As Long, Cancel As Boolean)
    Cancel = True
End Sub

Private Function CloneFont(nOrigFont As iFont) As StdFont
    If nOrigFont Is Nothing Then Exit Function
    nOrigFont.Clone CloneFont
End Function

' The list opens as wide as its longest item. picSampleContainer measures because it has the page
' font, the same as the combos
Private Sub SetComboDropWidth(nCombo As ComboBox)
    Dim c As Long
    Dim iWidth As Single
    Dim iMaxWidth As Single
    
    For c = 0 To nCombo.ListCount - 1
        iWidth = picSampleContainer.TextWidth(nCombo.List(c))
        If iWidth > iMaxWidth Then iMaxWidth = iWidth
    Next c
    ' room for the item margins and a vertical scroll bar
    iMaxWidth = mPreview.pScaleX(iMaxWidth, vbTwips, vbPixels) + mPreview.pScaleX(360, vbTwips, vbPixels)
    If iMaxWidth > mPreview.pScaleX(nCombo.Width, vbTwips, vbPixels) Then SendMessageW nCombo.hWnd, CB_SETDROPPEDWIDTH, CLng(iMaxWidth), 0
End Sub

Private Function SelectInComboByItemData(nCombo As Control, nItemData As Long) As Boolean
    Dim c As Long
    
    For c = 0 To nCombo.ListCount - 1
        If nCombo.ItemData(c) = nItemData Then
            nCombo.ListIndex = c
            SelectInComboByItemData = True
            Exit Function
        End If
    Next c
End Function

