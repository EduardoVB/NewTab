Attribute VB_Name = "pagNewTabStrip"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Option Explicit

Private Declare Function SendMessageW Lib "user32" (ByVal hWnd As LongPtr, ByVal wMsg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr

Private Const CB_SETDROPPEDWIDTH As Long = &H160&

' The sizes are kept in the units of the developer's container and converted for the preview,
' whose container is the page
Private mPreview As NewTab
Private mSC As NewTab
Private mLoading As Boolean
Private mSettingText As Boolean
Private mAutoWidthStyle As Long
Private mTabsPerRow As Long
Private mTabSeparation As Long
Private mTabPaddingWidth As Long
Private mTabPaddingHeight As Long
Private mTabHeight As Single
Private mTabGeneralFixedWidth As Single
Private mTabMinWidth As Single
Private mTabMaxWidth As Single
Private mStripEndFreeSpace As Single

Private Sub PropertyPage_SelectionChanged()
    Dim iSC As NewTab
    Dim t As Long

    If TypeName(SelectedControls(0)) <> "NewTab" Then Exit Sub
    mLoading = True
    Set iSC = SelectedControls(0)
    Set mSC = iSC
    Set mPreview = NewTab1

    LoadCombos
    ' Read once: this page does not change Style, TDIMode or NewTabButton
    mAutoWidthStyle = iSC.AutoTabWidthStyle

    mTabsPerRow = iSC.TabsPerRow
    mTabSeparation = iSC.TabSeparation
    mTabPaddingWidth = iSC.TabPaddingWidth
    mTabPaddingHeight = iSC.TabPaddingHeight
    mTabHeight = iSC.TabHeight
    mTabGeneralFixedWidth = iSC.TabGeneralFixedWidth
    mTabMinWidth = iSC.TabMinWidth
    mTabMaxWidth = iSC.TabMaxWidth
    mStripEndFreeSpace = iSC.StripEndFreeSpace

    SelectInComboByItemData cboTabOrientation, iSC.TabOrientation
    SelectInComboByItemData cboTabWidthStyle, iSC.TabWidthStyle
    SelectInComboByItemData cboTabHeightStyleForHorizontal, iSC.TabHeightStyleForHorizontal
    SelectInComboByItemData cboShowRowsInPerspective, iSC.ShowRowsInPerspective
    SelectInComboByItemData cboTabsOverflow, iSC.TabsOverflow
    SelectInComboByItemData cboStripButtonsRow, iSC.StripButtonsRow
    chkAutoTabHeight.Value = IIf(iSC.AutoTabHeight, vbChecked, vbUnchecked)
    chkWordWrap.Value = IIf(iSC.WordWrap, vbChecked, vbUnchecked)
    ShowAllValues

    ' The sample is the developer's control, as in the other pages
    mPreview.Redraw = False
    mPreview.RightToLeft = iSC.RightToLeft
    mPreview.CloseButton = iSC.CloseButton
    mPreview.CloseButtonPosition = iSC.CloseButtonPosition
    mPreview.CaptionAlignment = iSC.CaptionAlignment
    mPreview.Tabs = iSC.Tabs
    For t = 0 To iSC.Tabs - 1
        SeedPreviewTab iSC, t
    Next t
    CopyControlProperties iSC, mPreview
    If iSC.TabSel > -1 Then
        If mPreview.TabVisible(iSC.TabSel) Then mPreview.TabSel = iSC.TabSel
    End If
    UpdatePreview

    SetComboDropWidth cboTabOrientation
    SetComboDropWidth cboTabWidthStyle
    SetComboDropWidth cboTabHeightStyleForHorizontal
    SetComboDropWidth cboShowRowsInPerspective
    SetComboDropWidth cboTabsOverflow
    SetComboDropWidth cboStripButtonsRow
    SetEnabledStates
    ShowWidthStyleInfo
    Changed = False
    mLoading = False
End Sub

Private Sub PropertyPage_EditProperty(PropertyName As String)
    On Error Resume Next
    Select Case PropertyName
        Case "TabsPerRow": txtTabsPerRow.SetFocus
        Case "TabHeight": txtTabHeight.SetFocus
        Case "TabGeneralFixedWidth": txtTabGeneralFixedWidth.SetFocus
        Case "TabMinWidth": txtTabMinWidth.SetFocus
        Case "TabMaxWidth": txtTabMaxWidth.SetFocus
        Case "StripEndFreeSpace": txtStripEndFreeSpace.SetFocus
        Case "TabSeparation": txtTabSeparation.SetFocus
        Case "TabPaddingWidth": txtTabPaddingWidth.SetFocus
        Case "TabPaddingHeight": txtTabPaddingHeight.SetFocus
        Case Else: cboTabOrientation.SetFocus
    End Select
End Sub

' TabWidthStyle goes before the widths: TabMinWidth and TabMaxWidth are refused while it is
' ntTWEqualWidth. Max is cleared first so that neither Let clamps the other on the way
Private Sub PropertyPage_ApplyChanges()
    Dim iSC As NewTab

    If mPreview Is Nothing Then Exit Sub
    Set iSC = SelectedControls(0)
    On Error Resume Next
    iSC.Redraw = False
    If iSC.TabOrientation <> ComboValue(cboTabOrientation) Then iSC.TabOrientation = ComboValue(cboTabOrientation)
    If iSC.TabWidthStyle <> ComboValue(cboTabWidthStyle) Then iSC.TabWidthStyle = ComboValue(cboTabWidthStyle)
    If iSC.TabsPerRow <> mTabsPerRow Then iSC.TabsPerRow = mTabsPerRow
    If iSC.TabHeightStyleForHorizontal <> ComboValue(cboTabHeightStyleForHorizontal) Then iSC.TabHeightStyleForHorizontal = ComboValue(cboTabHeightStyleForHorizontal)
    If iSC.ShowRowsInPerspective <> ComboValue(cboShowRowsInPerspective) Then iSC.ShowRowsInPerspective = ComboValue(cboShowRowsInPerspective)
    If iSC.TabsOverflow <> ComboValue(cboTabsOverflow) Then iSC.TabsOverflow = ComboValue(cboTabsOverflow)
    If iSC.StripButtonsRow <> ComboValue(cboStripButtonsRow) Then iSC.StripButtonsRow = ComboValue(cboStripButtonsRow)
    If iSC.WordWrap <> (chkWordWrap.Value = vbChecked) Then iSC.WordWrap = (chkWordWrap.Value = vbChecked)
    If iSC.TabSeparation <> mTabSeparation Then iSC.TabSeparation = mTabSeparation
    If iSC.TabPaddingWidth <> mTabPaddingWidth Then iSC.TabPaddingWidth = mTabPaddingWidth
    If iSC.TabPaddingHeight <> mTabPaddingHeight Then iSC.TabPaddingHeight = mTabPaddingHeight
    If SizeDiffers(iSC.StripEndFreeSpace, mStripEndFreeSpace) Then iSC.StripEndFreeSpace = mStripEndFreeSpace
    If SizeDiffers(iSC.TabGeneralFixedWidth, mTabGeneralFixedWidth) Then iSC.TabGeneralFixedWidth = mTabGeneralFixedWidth
    If SizeDiffers(iSC.TabMinWidth, mTabMinWidth) Or SizeDiffers(iSC.TabMaxWidth, mTabMaxWidth) Then
        iSC.TabMaxWidth = 0
        iSC.TabMinWidth = mTabMinWidth
        iSC.TabMaxWidth = mTabMaxWidth
    End If
    If chkAutoTabHeight.Value = vbChecked Then
        If Not iSC.AutoTabHeight Then iSC.AutoTabHeight = True
    Else
        If iSC.AutoTabHeight Then iSC.AutoTabHeight = False
        If SizeDiffers(iSC.TabHeight, mTabHeight) Then iSC.TabHeight = mTabHeight
    End If
    iSC.Redraw = True
    On Error GoTo 0
End Sub

Private Function SizeDiffers(ByVal nValue1 As Single, ByVal nValue2 As Single) As Boolean
    SizeDiffers = Abs(nValue1 - nValue2) > 0.0001
End Function

Private Function ComboValue(nCombo As ComboBox) As Long
    If nCombo.ListIndex > -1 Then ComboValue = nCombo.ItemData(nCombo.ListIndex)
End Function

Private Sub LoadCombos()
    cboTabOrientation.Clear
    cboTabOrientation.AddItem ssTabOrientationTop & " - ssTabOrientationTop": cboTabOrientation.ItemData(cboTabOrientation.NewIndex) = ssTabOrientationTop
    cboTabOrientation.AddItem ssTabOrientationBottom & " - ssTabOrientationBottom": cboTabOrientation.ItemData(cboTabOrientation.NewIndex) = ssTabOrientationBottom
    cboTabOrientation.AddItem ssTabOrientationLeft & " - ssTabOrientationLeft": cboTabOrientation.ItemData(cboTabOrientation.NewIndex) = ssTabOrientationLeft
    cboTabOrientation.AddItem ssTabOrientationRight & " - ssTabOrientationRight": cboTabOrientation.ItemData(cboTabOrientation.NewIndex) = ssTabOrientationRight
    cboTabOrientation.AddItem ntTabOrientationLeftHorizontal & " - ntTabOrientationLeftHorizontal": cboTabOrientation.ItemData(cboTabOrientation.NewIndex) = ntTabOrientationLeftHorizontal
    cboTabOrientation.AddItem ntTabOrientationRightHorizontal & " - ntTabOrientationRightHorizontal": cboTabOrientation.ItemData(cboTabOrientation.NewIndex) = ntTabOrientationRightHorizontal
    cboTabOrientation.AddItem ntTabOrientationTopRight & " - ntTabOrientationTopRight": cboTabOrientation.ItemData(cboTabOrientation.NewIndex) = ntTabOrientationTopRight
    cboTabOrientation.AddItem ntTabOrientationBottomRight & " - ntTabOrientationBottomRight": cboTabOrientation.ItemData(cboTabOrientation.NewIndex) = ntTabOrientationBottomRight
    cboTabOrientation.AddItem ntTabOrientationLeftTop & " - ntTabOrientationLeftTop": cboTabOrientation.ItemData(cboTabOrientation.NewIndex) = ntTabOrientationLeftTop
    cboTabOrientation.AddItem ntTabOrientationRightBottom & " - ntTabOrientationRightBottom": cboTabOrientation.ItemData(cboTabOrientation.NewIndex) = ntTabOrientationRightBottom
    cboTabOrientation.AddItem ntTabOrientationLeftBottomHorizontal & " - ntTabOrientationLeftBottomHorizontal": cboTabOrientation.ItemData(cboTabOrientation.NewIndex) = ntTabOrientationLeftBottomHorizontal
    cboTabOrientation.AddItem ntTabOrientationRightBottomHorizontal & " - ntTabOrientationRightBottomHorizontal": cboTabOrientation.ItemData(cboTabOrientation.NewIndex) = ntTabOrientationRightBottomHorizontal

    cboTabWidthStyle.Clear
    cboTabWidthStyle.AddItem ntTWTabStripEmulation & " - ntTWTabStripEmulation": cboTabWidthStyle.ItemData(cboTabWidthStyle.NewIndex) = ntTWTabStripEmulation
    cboTabWidthStyle.AddItem ntTWTabCaptionWidth & " - ntTWTabCaptionWidth": cboTabWidthStyle.ItemData(cboTabWidthStyle.NewIndex) = ntTWTabCaptionWidth
    cboTabWidthStyle.AddItem ntTWEqualWidth & " - ntTWEqualWidth": cboTabWidthStyle.ItemData(cboTabWidthStyle.NewIndex) = ntTWEqualWidth
    cboTabWidthStyle.AddItem ntTWAuto & " - ntTWAuto": cboTabWidthStyle.ItemData(cboTabWidthStyle.NewIndex) = ntTWAuto
    cboTabWidthStyle.AddItem ntTWStretchToFill & " - ntTWStretchToFill": cboTabWidthStyle.ItemData(cboTabWidthStyle.NewIndex) = ntTWStretchToFill
    cboTabWidthStyle.AddItem ntTWTabCaptionWidthFillRows & " - ntTWTabCaptionWidthFillRows": cboTabWidthStyle.ItemData(cboTabWidthStyle.NewIndex) = ntTWTabCaptionWidthFillRows
    cboTabWidthStyle.AddItem ntTWGeneralFixedWidth & " - ntTWGeneralFixedWidth": cboTabWidthStyle.ItemData(cboTabWidthStyle.NewIndex) = ntTWGeneralFixedWidth
    cboTabWidthStyle.AddItem ntTWGeneralFixedWidthFillRows & " - ntTWGeneralFixedWidthFillRows": cboTabWidthStyle.ItemData(cboTabWidthStyle.NewIndex) = ntTWGeneralFixedWidthFillRows

    cboTabHeightStyleForHorizontal.Clear
    cboTabHeightStyleForHorizontal.AddItem ntTHFill & " - ntTHFill": cboTabHeightStyleForHorizontal.ItemData(cboTabHeightStyleForHorizontal.NewIndex) = ntTHFill
    cboTabHeightStyleForHorizontal.AddItem ntTHTabCaptionHeight & " - ntTHTabCaptionHeight": cboTabHeightStyleForHorizontal.ItemData(cboTabHeightStyleForHorizontal.NewIndex) = ntTHTabCaptionHeight
    cboTabHeightStyleForHorizontal.AddItem ntTHMaxCaptionHeight & " - ntTHMaxCaptionHeight": cboTabHeightStyleForHorizontal.ItemData(cboTabHeightStyleForHorizontal.NewIndex) = ntTHMaxCaptionHeight
    cboTabHeightStyleForHorizontal.AddItem ntTHFixed & " - ntTHFixed": cboTabHeightStyleForHorizontal.ItemData(cboTabHeightStyleForHorizontal.NewIndex) = ntTHFixed
    cboTabHeightStyleForHorizontal.AddItem ntTHStretchToFill & " - ntTHStretchToFill": cboTabHeightStyleForHorizontal.ItemData(cboTabHeightStyleForHorizontal.NewIndex) = ntTHStretchToFill

    cboShowRowsInPerspective.Clear
    cboShowRowsInPerspective.AddItem ntNo & " - ntNo": cboShowRowsInPerspective.ItemData(cboShowRowsInPerspective.NewIndex) = ntNo
    cboShowRowsInPerspective.AddItem ntYes & " - ntYes": cboShowRowsInPerspective.ItemData(cboShowRowsInPerspective.NewIndex) = ntYes
    cboShowRowsInPerspective.AddItem ntYNAuto & " - ntYNAuto": cboShowRowsInPerspective.ItemData(cboShowRowsInPerspective.NewIndex) = ntYNAuto

    cboTabsOverflow.Clear
    cboTabsOverflow.AddItem ntTOMultiRow & " - ntTOMultiRow": cboTabsOverflow.ItemData(cboTabsOverflow.NewIndex) = ntTOMultiRow
    cboTabsOverflow.AddItem ntTOScroll & " - ntTOScroll": cboTabsOverflow.ItemData(cboTabsOverflow.NewIndex) = ntTOScroll
    cboTabsOverflow.AddItem ntTOScrollWithList & " - ntTOScrollWithList": cboTabsOverflow.ItemData(cboTabsOverflow.NewIndex) = ntTOScrollWithList

    cboStripButtonsRow.Clear
    cboStripButtonsRow.AddItem ntSBSelectedTabRow & " - ntSBSelectedTabRow": cboStripButtonsRow.ItemData(cboStripButtonsRow.NewIndex) = ntSBSelectedTabRow
    cboStripButtonsRow.AddItem ntSBOuterRow & " - ntSBOuterRow": cboStripButtonsRow.ItemData(cboStripButtonsRow.NewIndex) = ntSBOuterRow
End Sub

' Values

Private Sub ShowAllValues()
    mSettingText = True
    txtTabsPerRow.Text = CStr(mTabsPerRow)
    txtTabSeparation.Text = CStr(mTabSeparation)
    txtTabPaddingWidth.Text = CStr(mTabPaddingWidth)
    txtTabPaddingHeight.Text = CStr(mTabPaddingHeight)
    txtTabHeight.Text = CStr(mTabHeight)
    txtTabGeneralFixedWidth.Text = CStr(mTabGeneralFixedWidth)
    txtTabMinWidth.Text = CStr(mTabMinWidth)
    txtTabMaxWidth.Text = CStr(mTabMaxWidth)
    txtStripEndFreeSpace.Text = CStr(mStripEndFreeSpace)
    mSettingText = False
End Sub

' A text that is not a valid value yet leaves the last valid one in place; leaving the box shows it
Private Function ReadInteger(ByVal nText As String, ByVal nMin As Long, ByVal nMax As Long, ByRef nValue As Long) As Boolean
    nText = Trim$(nText)
    If (Len(nText) = 0) Or (Len(nText) > 4) Then Exit Function
    If nText Like "*[!0-9]*" Then Exit Function
    If (CLng(nText) < nMin) Or (CLng(nText) > nMax) Then Exit Function
    nValue = CLng(nText)
    ReadInteger = True
End Function

Private Function ReadSize(ByVal nText As String, ByRef nValue As Single) As Boolean
    If Not IsNumeric(nText) Then Exit Function
    If CSng(nText) < 0 Then Exit Function
    nValue = CSng(nText)
    ReadSize = True
End Function

Private Function SizeInTwipsX(ByVal nValue As Single) As Single
    SizeInTwipsX = mSC.pScaleX(mSC.FromContainerSizeX(nValue, vbHimetric), vbHimetric, vbTwips)
End Function

Private Sub ValueEdited()
    If mLoading Or mSettingText Then Exit Sub
    UpdatePreview
    Changed = True
End Sub

Private Sub txtTabsPerRow_Change()
    If mLoading Or mSettingText Then Exit Sub
    If ReadInteger(txtTabsPerRow.Text, 1, 1000, mTabsPerRow) Then ValueEdited
End Sub

Private Sub txtTabSeparation_Change()
    If mLoading Or mSettingText Then Exit Sub
    If ReadInteger(txtTabSeparation.Text, 0, 20, mTabSeparation) Then ValueEdited
End Sub

Private Sub txtTabPaddingWidth_Change()
    If mLoading Or mSettingText Then Exit Sub
    If ReadInteger(txtTabPaddingWidth.Text, 0, 40, mTabPaddingWidth) Then ValueEdited
End Sub

Private Sub txtTabPaddingHeight_Change()
    If mLoading Or mSettingText Then Exit Sub
    If ReadInteger(txtTabPaddingHeight.Text, 0, 40, mTabPaddingHeight) Then ValueEdited
End Sub

Private Sub txtTabHeight_Change()
    Dim iValue As Single

    If mLoading Or mSettingText Then Exit Sub
    If Not ReadSize(txtTabHeight.Text, iValue) Then Exit Sub
    If iValue = 0 Then Exit Sub
    mTabHeight = iValue
    ValueEdited
End Sub

' The same minimums the properties have: 150 twips, and 0 for TabMaxWidth meaning no limit
Private Sub txtTabGeneralFixedWidth_Change()
    Dim iValue As Single

    If mLoading Or mSettingText Then Exit Sub
    If Not ReadSize(txtTabGeneralFixedWidth.Text, iValue) Then Exit Sub
    If SizeInTwipsX(iValue) < 150 Then Exit Sub
    mTabGeneralFixedWidth = iValue
    ValueEdited
End Sub

Private Sub txtTabMinWidth_Change()
    Dim iValue As Single

    If mLoading Or mSettingText Then Exit Sub
    If Not ReadSize(txtTabMinWidth.Text, iValue) Then Exit Sub
    mTabMinWidth = iValue
    ValueEdited
End Sub

Private Sub txtTabMaxWidth_Change()
    Dim iValue As Single

    If mLoading Or mSettingText Then Exit Sub
    If Not ReadSize(txtTabMaxWidth.Text, iValue) Then Exit Sub
    If (iValue <> 0) And (SizeInTwipsX(iValue) < 150) Then Exit Sub
    mTabMaxWidth = iValue
    ValueEdited
End Sub

Private Sub txtStripEndFreeSpace_Change()
    Dim iValue As Single

    If mLoading Or mSettingText Then Exit Sub
    If Not ReadSize(txtStripEndFreeSpace.Text, iValue) Then Exit Sub
    mStripEndFreeSpace = iValue
    ValueEdited
End Sub

