Private Sub PropertyPage_ApplyChanges()
    Dim t As Integer
    Dim iSC As NewTab
    Dim iDefaultIconFont As StdFont
    Dim iTabsPrev As Long
    
    Set iDefaultIconFont = New StdFont
    iDefaultIconFont.Name = cPropDef_IconFontName
    iDefaultIconFont.Size = cPropDef_IconFontSize
    
    Set iSC = SelectedControls(0)
    iSC.HideAllContainedControls
    If mTDIMode = ntTDIModeNone Then iSC.IconAlignment = cboIconAlignment.ItemData(cboIconAlignment.ListIndex)
    ' no TDI guard: a TDI strip shows the form icons and scales them the same way
    If cboScalePicturesForDPI.ListIndex > -1 Then iSC.ScalePicturesForDPI = cboScalePicturesForDPI.ItemData(cboScalePicturesForDPI.ListIndex)
    ' likewise unguarded: the combo is seeded from the control in every mode, so
    ' writing it back where it is not shown puts the same value in again
    If cboTDIFormsIconSize.ListIndex > -1 Then iSC.TDIFormsIconSize = cboTDIFormsIconSize.ItemData(cboTDIFormsIconSize.ListIndex)
    iSC.MaskColor = NewTab1.MaskColor
    iSC.UseMaskColor = (chkUseMaskColor.Value = vbChecked)
    iTabsPrev = iSC.Tabs
    If mTDIMode = ntTDIModeNone Then
        If mTabs > iSC.Tabs Then
            iSC.Tabs = mTabs
        End If
    End If
    For t = 0 To mTabs - 1
        iSC.TabCaption(t) = mTabData(t).Caption
        iSC.TabToolTipText(t) = mTabData(t).ToolTipText
        iSC.TabEnabled(t) = mTabData(t).Enabled
        iSC.TabVisible(t) = mTabData(t).Visible
        Set iSC.TabPicture(t) = mTabData(t).Picture
        Set iSC.TabPic16(t) = mTabData(t).Pic16
        Set iSC.TabPic20(t) = mTabData(t).Pic20
        Set iSC.TabPic24(t) = mTabData(t).Pic24
        If mTDIMode = ntTDIModeNone Then Set iSC.TabControlsNames(t) = mTabData(t).Controls
        If mTabData(t).IconFont Is Nothing Then
            Set iSC.TabIconFont(t) = Nothing
        ElseIf FontsAreEqual(mTabData(t).IconFont, iDefaultIconFont) Then
            Set iSC.TabIconFont(t) = Nothing
        Else
            Set iSC.TabIconFont(t) = CloneFont(mTabData(t).IconFont)
        End If
        iSC.TabIconCharHex(t) = "&H" & Hex$(mTabData(t).IconChar) & "&"
        iSC.TabIconLeftOffset(t) = mTabData(t).IconLeftOffset
        iSC.TabIconTopOffset(t) = mTabData(t).IconTopOffset
        iSC.TabIconInColor(t) = mTabData(t).IconInColor
    Next t
    If mTDIMode = ntTDIModeNone Then
        For t = mTabs To iTabsPrev - 1
            Set iSC.TabControlsNames(t) = New Collection
        Next
        iSC.Tabs = mTabs
    End If
    iSC.MakeContainedControlsInSelTabVisible
    gPagTabsApplyTime = Timer
    gPagTabsLastSelectedTab = mTab
    Unsubclass
End Sub

Private Sub PropertyPage_Initialize()
    lblHeadNote.Caption = "If your program is DPI aware, the Picture can be automatically scaled with the ScalePicturesForDPI property or use a different image for each DPI setting. Font icons are already DPI aware."
    cmdDeletePicture.Caption = Chr$(&HFB)
    cmdDeletePic16.Caption = Chr$(&HFB)
    cmdDeletePic20.Caption = Chr$(&HFB)
    cmdDeletePic24.Caption = Chr$(&HFB)
    
    Set picIconCharHexHolder.Font = PropertyPage.Font
    picIconCharHexHolder.ScaleMode = vbPixels
    Set mUniTextIconCharHex = New cUniTextBox
    mIconCharHexHwnd = mUniTextIconCharHex.CreateTextBox(picIconCharHexHolder.hWnd, 0, 0, picIconCharHexHolder.ScaleWidth, picIconCharHexHolder.ScaleHeight, ES_AUTOHSCROLL Or WS_VISIBLE, WS_EX_CLIENTEDGE, "")
    cmdRemoveIconChar.Caption = Chr$(&HFB)
    picIconCharHexHolder.BackColor = vbWindowBackground
End Sub

Private Sub PropertyPage_Paint()
    If tmrShowTabData.Enabled Then tmrShowTabData_Timer
    If tmrScrollCharMapToSelected.Enabled Then tmrScrollCharMapToSelected_Timer
    If tmrDrawCharMapFromScrollPosition.Enabled Then tmrDrawCharMapFromScrollPosition_Timer
End Sub

Private Sub PropertyPage_SelectionChanged()
    Dim t As Integer
    Dim iSC As NewTab
    Dim iVar As Variant
    Dim c As Long
    
    mLoading = True
    Set iSC = SelectedControls(0)
    
    mTDIMode = iSC.TDIMode
    
    If mTDIMode <> ntTDIModeNone Then
        picTDICover.Move 0, 0, PropertyPage.ScaleWidth, PropertyPage.ScaleHeight
        picTDICover.Visible = True
        ' In forms mode the picture is the hosted form's icon: its size is a choice, and the mask reaches
        ' only bitmaps handed in by TDIFormsShowTabIcon; in
        ' controls mode the pictures are still TabPicture, so ScalePicturesForDPI is what applies
        If mTDIMode = ntTDIModeForms Then
            lblNoteTDI.Caption = "In TDI mode forms the tab pictures are the icons of the hosted forms. Only the settings below apply. TDIFormsShowTabIcon can override the icon for one tab; the mask only affects bitmaps given there."
            lblTDIFormsIconSize.Visible = True
            cboTDIFormsIconSize.Visible = True
            PutMaskColorOnTDICover lblTDIFormsIconSize.Left, lblTDIFormsIconSize.Width
        Else
            lblNoteTDI.Caption = "In TDI mode controls the tab pictures still come from TabPicture, set at run time. Only the settings below apply."
            Set lblScalePicturesForDPI.Container = picTDICover
            Set cboScalePicturesForDPI.Container = picTDICover
            ' the full name on the cover, where there is room for it
            lblScalePicturesForDPI.Caption = "ScalePicturesForDPI:"
            lblScalePicturesForDPI.Alignment = vbRightJustify
            lblScalePicturesForDPI.Move lblTDIFormsIconSize.Left - 300, lblTDIFormsIconSize.Top, lblTDIFormsIconSize.Width + 300
            cboScalePicturesForDPI.Move cboTDIFormsIconSize.Left, cboTDIFormsIconSize.Top, cboTDIFormsIconSize.Width
            PutMaskColorOnTDICover lblScalePicturesForDPI.Left, lblScalePicturesForDPI.Width
        End If
        picTDICover.ZOrder
    End If
    
    If TypeName(SelectedControls(0)) <> "NewTab" Then Exit Sub
    
    cboIconAlignment.Clear
    cboIconAlignment.AddItem ntIconAlignBeforeCaption & " - ntIconAlignBeforeCaption": cboIconAlignment.ItemData(cboIconAlignment.NewIndex) = ntIconAlignBeforeCaption
    cboIconAlignment.AddItem ntIconAlignCenteredBeforeCaption & " - ntIconAlignCenteredBeforeCaption": cboIconAlignment.ItemData(cboIconAlignment.NewIndex) = ntIconAlignCenteredBeforeCaption
    cboIconAlignment.AddItem ntIconAlignAfterCaption & " - ntIconAlignAfterCaption": cboIconAlignment.ItemData(cboIconAlignment.NewIndex) = ntIconAlignAfterCaption
    cboIconAlignment.AddItem ntIconAlignCenteredAfterCaption & " - ntIconAlignCenteredAfterCaption": cboIconAlignment.ItemData(cboIconAlignment.NewIndex) = ntIconAlignCenteredAfterCaption
    cboIconAlignment.AddItem ntIconAlignStart & " - ntIconAlignStart": cboIconAlignment.ItemData(cboIconAlignment.NewIndex) = ntIconAlignStart
    cboIconAlignment.AddItem ntIconAlignEnd & " - ntIconAlignEnd": cboIconAlignment.ItemData(cboIconAlignment.NewIndex) = ntIconAlignEnd
    cboIconAlignment.AddItem ntIconAlignCenteredOnTab & " - ntIconAlignCenteredOnTab": cboIconAlignment.ItemData(cboIconAlignment.NewIndex) = ntIconAlignCenteredOnTab
    cboIconAlignment.AddItem ntIconAlignAtTop & " - ntIconAlignAtTop": cboIconAlignment.ItemData(cboIconAlignment.NewIndex) = ntIconAlignAtTop
    cboIconAlignment.AddItem ntIconAlignAtBottom & " - ntIconAlignAtBottom": cboIconAlignment.ItemData(cboIconAlignment.NewIndex) = ntIconAlignAtBottom
    
    cboTDIFormsIconSize.Clear
    cboTDIFormsIconSize.AddItem ntTDIFormsIconNative & " - ntTDIFormsIconNative": cboTDIFormsIconSize.ItemData(cboTDIFormsIconSize.NewIndex) = ntTDIFormsIconNative
    cboTDIFormsIconSize.AddItem ntTDIFormsIcon16 & " - ntTDIFormsIcon16": cboTDIFormsIconSize.ItemData(cboTDIFormsIconSize.NewIndex) = ntTDIFormsIcon16
    cboTDIFormsIconSize.AddItem ntTDIFormsIcon20 & " - ntTDIFormsIcon20": cboTDIFormsIconSize.ItemData(cboTDIFormsIconSize.NewIndex) = ntTDIFormsIcon20
    cboTDIFormsIconSize.AddItem ntTDIFormsIcon24 & " - ntTDIFormsIcon24": cboTDIFormsIconSize.ItemData(cboTDIFormsIconSize.NewIndex) = ntTDIFormsIcon24
    cboTDIFormsIconSize.AddItem ntTDIFormsIcon32 & " - ntTDIFormsIcon32": cboTDIFormsIconSize.ItemData(cboTDIFormsIconSize.NewIndex) = ntTDIFormsIcon32
    cboTDIFormsIconSize.AddItem ntTDIFormsIcon48 & " - ntTDIFormsIcon48": cboTDIFormsIconSize.ItemData(cboTDIFormsIconSize.NewIndex) = ntTDIFormsIcon48
    
    cboScalePicturesForDPI.Clear
    cboScalePicturesForDPI.AddItem "Disabled": cboScalePicturesForDPI.ItemData(cboScalePicturesForDPI.NewIndex) = ntScalePicturesDisabled
    cboScalePicturesForDPI.AddItem "Smooth": cboScalePicturesForDPI.ItemData(cboScalePicturesForDPI.NewIndex) = ntScalePicturesSmooth
    cboScalePicturesForDPI.AddItem "Crisp": cboScalePicturesForDPI.ItemData(cboScalePicturesForDPI.NewIndex) = ntScalePicturesCrisp
    cboScalePicturesForDPI.AddItem "Balanced": cboScalePicturesForDPI.ItemData(cboScalePicturesForDPI.NewIndex) = ntScalePicturesBalanced
    
    Set mDefaultIconFont = New StdFont
    mDefaultIconFont.Name = cPropDef_IconFontName
    mDefaultIconFont.Size = cPropDef_IconFontSize
    
    mTabs = iSC.Tabs
    iSC.StoreVisibleControlsInSelectedTab
    ReDim mTabData(mTabs - 1)
    NewTab1.RightToLeft = iSC.RightToLeft
    NewTab1.CloseButton = iSC.CloseButton
    NewTab1.CloseButtonPosition = iSC.CloseButtonPosition
    NewTab1.CaptionAlignment = iSC.CaptionAlignment
    NewTab1.Tabs = iSC.Tabs
    For t = 0 To mTabs - 1
        mTabData(t).Caption = iSC.TabCaption(t)
        mTabData(t).ToolTipText = iSC.TabToolTipText(t)
        mTabData(t).Enabled = iSC.TabEnabled(t)
        mTabData(t).Visible = iSC.TabVisible(t)
        Set mTabData(t).IconFont = CloneFont(iSC.TabIconFont(t))
        mTabData(t).IconChar = Val(iSC.TabIconCharHex(t) & "&")
        mTabData(t).IconLeftOffset = iSC.TabIconLeftOffset(t)
        mTabData(t).IconTopOffset = iSC.TabIconTopOffset(t)
        mTabData(t).IconInColor = iSC.TabIconInColor(t)
        Set mTabData(t).Picture = iSC.TabPicture(t)
        Set mTabData(t).Pic16 = iSC.TabPic16(t)
        Set mTabData(t).Pic20 = iSC.TabPic20(t)
        Set mTabData(t).Pic24 = iSC.TabPic24(t)
        Set mTabData(t).Controls = New Collection
        For Each iVar In iSC.TabControlsNames(t)
            mTabData(t).Controls.Add iVar
        Next
        For c = 0 To ntCCFlatTabBorderColorInactive
            ' straight into the preview: these colors are not edited here. The state travels with them
            If iSC.TabCustomColorIsSet(t, c) Then
                NewTab1.TabCustomColor(t, c) = iSC.TabCustomColor(t, c)
            Else
                NewTab1.TabCustomColor(t, c) = -1
            End If
        Next
        NewTab1.TabCaption(t) = iSC.TabCaption(t)
        NewTab1.TabEnabled(t) = iSC.TabEnabled(t)
        Set NewTab1.TabPic16(t) = iSC.TabPic16(t)
        Set NewTab1.TabPic20(t) = iSC.TabPic20(t)
        Set NewTab1.TabPic24(t) = iSC.TabPic24(t)
        Set NewTab1.TabPicture(t) = iSC.TabPicture(t)
        Set NewTab1.TabIconFont(t) = CloneFont(iSC.TabIconFont(t))
        NewTab1.TabIconCharHex(t) = iSC.TabIconCharHex(t)
        NewTab1.TabIconLeftOffset(t) = iSC.TabIconLeftOffset(t)
        NewTab1.TabIconTopOffset(t) = iSC.TabIconTopOffset(t)
        NewTab1.TabIconInColor(t) = iSC.TabIconInColor(t)
    Next t
    If mTabs > 0 Then
        Set mLastIconFont = CloneFont(iSC.TabIconFont(mTabs - 1))
    Else
        Set mLastIconFont = CloneFont(mDefaultIconFont)
    End If
    
    SelectInComboByItemData cboIconAlignment, iSC.IconAlignment
    SelectInComboByItemData cboScalePicturesForDPI, iSC.ScalePicturesForDPI
    NewTab1.MaskColor = iSC.MaskColor
    NewTab1.UseMaskColor = iSC.UseMaskColor
    chkUseMaskColor.Value = IIf(iSC.UseMaskColor, vbChecked, vbUnchecked)
    ShowMaskColor
    chkIconInColor.Enabled = ColorGlyphsSupported
    SelectInComboByItemData cboTDIFormsIconSize, iSC.TDIFormsIconSize
    
    Select Case iSC.TabOrientation
        Case ssTabOrientationRight, ssTabOrientationLeft, ntTabOrientationRightBottom, ntTabOrientationLeftTop
            NewTab1.Width = iSC.Height
            NewTab1.Height = iSC.Width
        Case Else
            NewTab1.Width = iSC.Width
            NewTab1.Height = iSC.Height
    End Select
    NewTab1.Left = 0
    
    If ((Timer - gPagTabsApplyTime) < 3) And (gPagTabsApplyTime <> 0) Then
        mTab = gPagTabsLastSelectedTab
    Else
        mTab = iSC.TabSel
    End If
    
    CopyControlProperties iSC, NewTab1
    ShowTabData
    CheckImageSizes
    CheckImageSizes
    scrChars.Move picCharMap.ScaleWidth - scrChars.Width, 0, scrChars.Width, picCharMap.ScaleHeight
    
    Subclass
    mLoading = False
End Sub
Private Sub ShowTabData()
    tmrShowTabData.Enabled = False
    tmrShowTabData.Enabled = True
End Sub

Private Sub DoShowTabData()
    Dim t As Long
    Dim iHexText As String
    
    If mShowingTabData Then Exit Sub
    If tmrRestoreSampleContainer.Enabled Then tmrRestoreSampleContainer_Timer
    mShowingTabData = True
    t = mTab
    txtTab.Text = t
    txtTab.Refresh
    lblTabCaption.Caption = mTabData(t).Caption
    
    cmdTabPrev.Enabled = t > 0
    cmdTabNext.Enabled = t < (mTabs - 1)
    
    Set picImgPicture.Picture = mTabData(t).Picture
    If mTabData(t).Picture Is Nothing Then
        picImgPicture.ToolTipText = ""
        cmdDeletePicture.Enabled = False
    Else
        picImgPicture.ToolTipText = cCopyImageTTT
        cmdDeletePicture.Enabled = True
    End If
    
    Set picImgPic16.Picture = mTabData(t).Pic16
    If mTabData(t).Pic16 Is Nothing Then
        picImgPic16.ToolTipText = ""
        cmdDeletePic16.Enabled = False
    Else
        picImgPic16.ToolTipText = cCopyImageTTT
        cmdDeletePic16.Enabled = True
    End If

    Set picImgPic20.Picture = mTabData(t).Pic20
    If mTabData(t).Pic20 Is Nothing Then
        picImgPic20.ToolTipText = ""
        cmdDeletePic20.Enabled = False
    Else
        picImgPic20.ToolTipText = cCopyImageTTT
        cmdDeletePic20.Enabled = True
    End If

    Set picImgPic24.Picture = mTabData(t).Pic24
    If mTabData(t).Pic24 Is Nothing Then
        picImgPic24.ToolTipText = ""
        cmdDeletePic24.Enabled = False
    Else
        picImgPic24.ToolTipText = cCopyImageTTT
        cmdDeletePic24.Enabled = True
    End If
    
    EnsureFontListLoaded
    If Not SelectInCombo(cboTabIconFont, mTabData(t).IconFont.Name) Then
        cboTabIconFont.ListIndex = 0
    End If
    mIconCharSelected = mTabData(mTab).IconChar
    chkIconInColor.Value = IIf(mTabData(t).IconInColor, vbChecked, vbUnchecked)
    mIconInColor = mTabData(t).IconInColor
    
    If mTabData(t).IconChar = 0 Then
        If mUniTextIconCharHex.Text <> "&H" Then SetIconCharHexText "&H"
        cmdRemoveIconChar.Enabled = False
        picCharSelected.Cls
        DrawCharMapFromScrollPosition
    Else
        iHexText = "&H" & Hex$(mTabData(t).IconChar)
        If StrComp(mUniTextIconCharHex.Text, iHexText, vbTextCompare) <> 0 Then SetIconCharHexText iHexText
        cmdRemoveIconChar.Enabled = True
        If Not picCharSelected.Font Is mTabData(mTab).IconFont Then
            Set picCharSelected.Font = mTabData(mTab).IconFont
        End If
        DrawChar mTabData(mTab).IconChar, picCharSelected
        ScrollCharMapToSelected
    End If
    lblFontSize.Caption = "Font size: " & mTabData(t).IconFont.Size
    lblFontSize.Refresh
    
    txtIconLeftOffset.Text = mTabData(t).IconLeftOffset
    txtIconTopOffset.Text = mTabData(t).IconTopOffset
    
    NewTab1.TabCaption(t) = mTabData(t).Caption
    NewTab1.TabEnabled(t) = mTabData(t).Enabled
    Set NewTab1.TabPic16(t) = mTabData(t).Pic16
    Set NewTab1.TabPic20(t) = mTabData(t).Pic20
    Set NewTab1.TabPic24(t) = mTabData(t).Pic24
    Set NewTab1.TabPicture(t) = mTabData(t).Picture
    Set NewTab1.TabIconFont(t) = mTabData(t).IconFont
    NewTab1.TabIconCharHex(t) = "&H" & Hex$(mTabData(t).IconChar) & "&"
    NewTab1.TabIconLeftOffset(t) = mTabData(t).IconLeftOffset
    NewTab1.TabIconTopOffset(t) = mTabData(t).IconTopOffset
    NewTab1.TabIconInColor(t) = mTabData(t).IconInColor
    
    If NewTab1.Width < picCharMap.Width Then
        NewTab1.Left = (PropertyPage.ScaleWidth - NewTab1.Width) / 2
    End If
    NewTab1.ToolTipText = ""
    If NewTab1.Width > PropertyPage.ScaleWidth Then
        mEnableHorizontalDragging = True
        NewTab1.ToolTipText = "Drag to move the tab control and see other tabs"
    End If
    If PreviewNeedsVerticalDrag(NewTab1, picSampleContainer.ScaleHeight) Then
        mEnableVerticalDragging = True
        NewTab1.ToolTipText = "Drag to move the tab control and see other tabs"
    End If
    
    NewTab1.Top = PreviewTop(NewTab1, picSampleContainer.ScaleHeight)
    
    mShowingTabData = False
End Sub

Private Sub PropertyPage_Terminate()
    Set mUniTextIconCharHex = Nothing
    Unsubclass
End Sub

Private Sub tmrAutoClick_Timer()
    Dim iHwnd As LongPtr
    
    If Not MouseIsPressingAButton Then
        tmrAutoClick.Enabled = False
    Else
        iHwnd = WindowsUnderMouse
        If (iHwnd = cmdTabPrev.hWnd) Then
            If cmdTabPrev.Enabled Then cmdTabPrev_Click
        ElseIf (iHwnd = cmdTabNext.hWnd) Then
            If cmdTabNext.Enabled Then cmdTabNext_Click
        End If
    End If
End Sub

Private Sub tmrClick_Timer()
    tmrClick.Enabled = False
    If MouseIsPressingAButton Then
        tmrAutoClick.Enabled = True
    End If
End Sub

Private Sub tmrRestoreSampleContainer_Timer()
    tmrRestoreSampleContainer.Enabled = False
    Set NewTab1.Container = picSampleContainer
    NewTab1.Move NewTab1.Left - picSampleContainer.Left, NewTab1.Top - picSampleContainer.Top
    mDraggingSample = False
End Sub

Private Sub tmrStartDraggingSample_Timer()
    Const WM_SETREDRAW = &HB
    
    tmrStartDraggingSample.Enabled = False
    If mMouseDown Then
        If Not tmrRestoreSampleContainer.Enabled Then
            SendMessage PropertyPage.hWnd, WM_SETREDRAW, 0, 0
            NewTab1.Visible = False
            Set NewTab1.Container = Me
            NewTab1.Visible = True
            NewTab1.Move NewTab1.Left + picSampleContainer.Left, NewTab1.Top + picSampleContainer.Top
            SendMessage PropertyPage.hWnd, WM_SETREDRAW, -1, 0
            mDraggingSample = True
        End If
    End If
End Sub

Private Sub tmrTabChanged_Timer()
    tmrTabChanged.Enabled = False
End Sub

Private Sub txtIconLeftOffset_Change()
    If (Not mLoading) And (Not mShowingTabData) Then
        Changed = True
        mTabData(mTab).IconLeftOffset = Val(txtIconLeftOffset.Text)
        NewTab1.IconLeftOffset = mTabData(mTab).IconLeftOffset
    End If
End Sub

Private Sub txtIconTopOffset_Change()
    If (Not mLoading) And (Not mShowingTabData) Then
        Changed = True
        mTabData(mTab).IconTopOffset = Val(txtIconTopOffset.Text)
        NewTab1.IconTopOffset = mTabData(mTab).IconTopOffset
    End If
End Sub

Private Sub txtTab_Change()
    If NewTab1.TabVisible(Val(txtTab.Text)) Then NewTab1.TabSel = Val(txtTab.Text)
    If Not mLoading And Not mShowingTabData Then Changed = True
End Sub

Private Function WindowsUnderMouse() As LongPtr
    Dim iPt As POINTAPI
    
    GetCursorPos iPt
    WindowsUnderMouse = WindowFromPoint(iPt.X, iPt.Y)
End Function

Private Function IsMouseButtonPressed(nButton As NTMouseButtonsConstants) As Boolean
    Dim iButton As Long
    
    iButton = nButton
    If GetSystemMetrics(SM_SWAPBUTTON) <> 0 Then
        If nButton = ntMBLeft Then
            iButton = VK_RBUTTON
        ElseIf nButton = ntMBRight Then
            iButton = VK_LBUTTON
        End If
    End If
    IsMouseButtonPressed = GetAsyncKeyState(iButton) <> 0
End Function

Private Function MouseIsPressingAButton() As Boolean
    Dim iHwnd As LongPtr
    
    If IsMouseButtonPressed(ntMBLeft) Then
        iHwnd = WindowsUnderMouse
        If (iHwnd = cmdTabPrev.hWnd) Or (iHwnd = cmdTabNext.hWnd) Then
            MouseIsPressingAButton = True
        End If
    End If
End Function

Private Sub CheckImageSizes()
    Dim t As Long
    Dim iStrImgSize As String
    Dim iStrImgSize_Tab As Long
    Dim iStr As String
    Dim iAuxNT As NewTab
    
    ' Typed as NewTab and not used through NewTab1 directly, because the extender the container
    ' wraps the control in does not publish Friend members, and pScaleX is one
    Set iAuxNT = NewTab1
    mStrImagesDifferences = ""
    
    iStrImgSize = ""
    For t = 0 To mTabs - 1
        If Not mTabData(t).Pic16 Is Nothing Then
            iStr = Round(iAuxNT.pScaleX(mTabData(t).Pic16.Width, vbHimetric, vbPixels)) & "x" & Round(iAuxNT.pScaleY(mTabData(t).Pic16.Height, vbHimetric, vbPixels))
            If iStrImgSize = "" Then
                iStrImgSize = iStr
                iStrImgSize_Tab = t
            ElseIf iStr <> iStrImgSize Then
                mStrImagesDifferences = mStrImagesDifferences & "The Image size of the property 'Pic16' in Tab " & CStr(iStrImgSize_Tab) & " is " & iStrImgSize & " and in Tab " & CStr(t) & " it is " & iStr & "." & vbCrLf
                Exit For
            End If
        End If
    Next t
    
    iStrImgSize = ""
    For t = 0 To mTabs - 1
        If Not mTabData(t).Pic20 Is Nothing Then
            iStr = Round(iAuxNT.pScaleX(mTabData(t).Pic20.Width, vbHimetric, vbPixels)) & "x" & Round(iAuxNT.pScaleY(mTabData(t).Pic20.Height, vbHimetric, vbPixels))
            If iStrImgSize = "" Then
                iStrImgSize = iStr
                iStrImgSize_Tab = t
            ElseIf iStr <> iStrImgSize Then
                mStrImagesDifferences = mStrImagesDifferences & "The Image size of the property 'Pic20' in Tab " & CStr(iStrImgSize_Tab) & " is " & iStrImgSize & " and in Tab " & CStr(t) & " it is " & iStr & "." & vbCrLf
                Exit For
            End If
        End If
    Next t
    
    iStrImgSize = ""
    For t = 0 To mTabs - 1
        If Not mTabData(t).Pic24 Is Nothing Then
            iStr = Round(iAuxNT.pScaleX(mTabData(t).Pic24.Width, vbHimetric, vbPixels)) & "x" & Round(iAuxNT.pScaleY(mTabData(t).Pic24.Height, vbHimetric, vbPixels))
            If iStrImgSize = "" Then
                iStrImgSize = iStr
                iStrImgSize_Tab = t
            ElseIf iStr <> iStrImgSize Then
                mStrImagesDifferences = mStrImagesDifferences & "The Image size of the property 'Pic24' in Tab " & CStr(iStrImgSize_Tab) & " is " & iStrImgSize & " and in Tab " & CStr(t) & " it is " & iStr & "." & vbCrLf
                Exit For
            End If
        End If
    Next t
    
    If mStrImagesDifferences <> "" Then
        mStrImagesDifferences = mStrImagesDifferences & vbCrLf & "(There might be other images that have different sizes besides these ones)."
        lblWarningImgSizes.Visible = True
    Else
        lblWarningImgSizes.Visible = False
    End If
End Sub

Private Sub scrChars_Change()
    DrawCharMapFromScrollPosition
End Sub

Private Sub scrChars_Scroll()
    scrChars_Change
End Sub

Private Sub tmrDrawCharMapFromScrollPosition_Timer()
    tmrDrawCharMapFromScrollPosition.Enabled = False
    If (Not tmrShowTabData.Enabled) And (Not tmrScrollCharMapToSelected.Enabled) Then
        DoDrawCharMapFromScrollPosition
    End If
End Sub

Private Sub tmrScrollCharMapToSelected_Timer()
    tmrScrollCharMapToSelected.Enabled = False
    tmrDrawCharMapFromScrollPosition.Enabled = False
    If Not tmrShowTabData.Enabled Then
        DoScrollCharMapToSelected
    End If
End Sub

Private Sub tmrShowTabData_Timer()
    tmrShowTabData.Enabled = False
    DoShowTabData
End Sub

Private Sub picIconCharHexHolder_GotFocus()
    If Not mUniTextIconCharHexSync Then
        mUniTextIconCharHexSync = True
        mUniTextIconCharHex.SetFocus
    End If
End Sub

Private Sub mUniTextIconCharHex_GotFocus()
    If Not mUniTextIconCharHexSync Then picIconCharHexHolder.SetFocus
End Sub

Private Sub mUniTextIconCharHex_LostFocus()
    mUniTextIconCharHexSync = False
End Sub

Private Sub SetIconCharHexText(ByVal nText As String)
    mUniTextIconCharHex.Text = nText
    SendMessage mIconCharHexHwnd, EM_SETSEL, Len(nText), Len(nText)
End Sub

' The box holds the hex code. Anything else in it (pasted, or typed with the emoji panel) is taken
' as the character itself and replaced by its code.
Private Sub mUniTextIconCharHex_Change()
    Dim iText As String
    Dim iRest As String
    Dim iPos As Long
    Dim iCode As Long
    Dim iCharCode As Long
    Dim iWantsEmoji As Boolean
    Dim iDropped As Boolean
    
    iText = mUniTextIconCharHex.Text
    If (Len(iText) = 10) And (Left$(iText, 6) = "&HFFFF") Then
        SetIconCharHexText "&H" & Mid$(iText, 7)
        Exit Sub
    End If
    If Not mKeepIconCharNote Then lblIconCharNote.Visible = False
    If mLoading Or mShowingTabData Then Exit Sub
    If Len(iText) > 0 Then
        ' typed input delivers a surrogate pair as two changes: wait for the second half
        iCode = AscW(Right$(iText, 1)) And &HFFFF&
        If (iCode >= &HD800&) And (iCode <= &HDBFF&) Then Exit Sub
    End If
    
    iRest = iText
    If UCase$(Left$(iRest, 2)) = "&H" Then iRest = Mid$(iRest, 3)
    If Right$(iRest, 1) = "&" Then iRest = Left$(iRest, Len(iRest) - 1)
    If iRest Like "*[!0-9A-Fa-f]*" Then
        iPos = 1
        Do While iPos <= Len(iRest)
            iCode = CodePointAt(iRest, iPos)
            Select Case iCode
                Case Is <= 32, 48 To 57, 65 To 70, 97 To 102, &HFE0E&
                Case &HFE0F&
                    ' variation selector: asks for the emoji drawing of the previous character
                    iWantsEmoji = True
                Case Else
                    If iCharCode = 0 Then
                        iCharCode = iCode
                    Else
                        iDropped = True
                    End If
            End Select
        Loop
        UseEnteredIconChar iCharCode, iWantsEmoji, iDropped
        Exit Sub
    End If
    Changed = True
    mTabData(mTab).IconChar = Val("&H" & Left$(iRest, 6) & "&")
    mIconCharSelected = mTabData(mTab).IconChar
    If mTabData(mTab).IconChar > 0 Then
        If Not picCharSelected.Font Is mTabData(mTab).IconFont Then
            Set picCharSelected.Font = mTabData(mTab).IconFont
        End If
        DrawChar mTabData(mTab).IconChar, picCharSelected
        cmdRemoveIconChar.Enabled = True
    Else
        picCharSelected.Cls
        cmdRemoveIconChar.Enabled = False
    End If
    ShowTabData
End Sub

Private Sub UseEnteredIconChar(ByVal nCharCode As Long, ByVal nWantsEmoji As Boolean, ByVal nDropped As Boolean)
    Dim iFontName As String
    Dim iNote As String
    Dim t As Long
    
    If nCharCode = 0 Then
        SetIconCharHexText "&H" & IIf(mTabData(mTab).IconChar = 0, "", Hex$(mTabData(mTab).IconChar))
        Exit Sub
    End If
    If Not nWantsEmoji Then nWantsEmoji = IsEmojiPresentation(nCharCode)
    iFontName = FindFontForChar(nCharCode, mTabData(mTab).IconFont.Name, nWantsEmoji)
    If iFontName = "" Then
        iNote = "No installed font was found for this character."
    ElseIf StrComp(iFontName, mTabData(mTab).IconFont.Name, vbTextCompare) <> 0 Then
        mTabData(mTab).IconFont.Name = iFontName
        If (iFontName = cEmojiFontName) And ColorGlyphsSupported Then
            mTabData(mTab).IconInColor = True
            For t = 0 To mTabs - 1
                If mTabData(t).IconChar = 0 Then mTabData(t).IconInColor = True
            Next
        End If
        CheckOtherTabsFonts
    End If
    If nDropped Then iNote = Trim$("Only the first character was used. " & iNote)
    lblIconCharNote.Caption = iNote
    lblIconCharNote.Visible = (iNote <> "")
    mKeepIconCharNote = True
    SetIconCharHexText "&H" & Hex$(nCharCode)
    mKeepIconCharNote = False
End Sub

' Returns the name of an installed font that has the character, or "" when none was found.
' The place to ask DirectWrite (IDWriteFontFallback) when the list comes up empty.
Private Function FindFontForChar(ByVal nCharCode As Long, ByVal nCurrentFontName As String, ByVal nWantsEmoji As Boolean) As String
    Dim iCandidates As Variant
    Dim c As Long
    
    If nWantsEmoji Then
        If FontHasChar(cEmojiFontName, nCharCode) Then
            FindFontForChar = cEmojiFontName
            Exit Function
        End If
    End If
    If FontHasChar(nCurrentFontName, nCharCode) Then
        FindFontForChar = nCurrentFontName
        Exit Function
    End If
    ' Private use area: the same code is a different drawing in every icon font, nothing to detect
    If ((nCharCode >= &HE000&) And (nCharCode <= &HF8FF&)) Or (nCharCode >= &HF0000) Then Exit Function
    
    iCandidates = Array("Segoe UI Symbol", "Segoe UI", cEmojiFontName, "Cambria Math", "Yu Gothic UI", "Microsoft YaHei UI", "Malgun Gothic", "Microsoft JhengHei UI", "Nirmala UI", "Leelawadee UI", "Ebrima", "Gadugi")
    For c = 0 To UBound(iCandidates)
        If FontHasChar(iCandidates(c), nCharCode) Then
            FindFontForChar = iCandidates(c)
            Exit Function
        End If
    Next
End Function

Private Function FontHasChar(ByVal nFontName As String, ByVal nCharCode As Long) As Boolean
    Const GGI_MARK_NONEXISTING_GLYPHS As Long = &H1
    Const DEFAULT_CHARSET As Long = 1
    Dim iDC As LongPtr
    Dim iFont As LongPtr
    Dim iFontPrev As LongPtr
    Dim iFace As String
    Dim iStr As String
    Dim iGlyph As Integer
    
    If nFontName = "" Then Exit Function
    iDC = CreateCompatibleDC(0)
    If iDC = 0 Then Exit Function
    iFont = CreateFontW(-16, 0, 0, 0, 400, 0, 0, 0, DEFAULT_CHARSET, 0, 0, 0, 0, StrPtr(nFontName))
    If iFont <> 0 Then
        iFontPrev = SelectObject(iDC, iFont)
        ' a font that is not installed is silently replaced by another one
        iFace = String$(64, vbNullChar)
        GetTextFaceW iDC, 64, StrPtr(iFace)
        iFace = Left$(iFace, InStr(iFace, vbNullChar) - 1)
        If StrComp(iFace, nFontName, vbTextCompare) = 0 Then
            If nCharCode <= &HFFFF& Then
                iStr = ChrW$(nCharCode)
                iGlyph = -1
                GetGlyphIndicesW iDC, StrPtr(iStr), 1, VarPtr(iGlyph), GGI_MARK_NONEXISTING_GLYPHS
                FontHasChar = (iGlyph <> -1)
            Else
                ' GetGlyphIndicesW does not handle surrogate pairs
                FontHasChar = FontMapsCharCmap12(iDC, nCharCode)
            End If
        End If
        SelectObject iDC, iFontPrev
        DeleteObject iFont
    End If
    DeleteDC iDC
End Function

Private Function FontMapsCharCmap12(ByVal nHdc As LongPtr, ByVal nCharCode As Long) As Boolean
    Const cTagCmap As Long = &H70616D63
    Const GDI_ERROR As Long = &HFFFFFFFF
    Dim iSize As Long
    Dim iData() As Byte
    Dim iNumTables As Long
    Dim iRec As Long
    Dim iPlatform As Long
    Dim iEncoding As Long
    Dim iSubOffset As Long
    Dim iTableOffset As Long
    Dim iNumGroups As Long
    Dim iGroup As Long
    Dim iPos As Long
    Dim iStartChar As Long
    
    iSize = GetFontData(nHdc, cTagCmap, 0, ByVal 0&, 0)
    If (iSize = GDI_ERROR) Or (iSize < 4) Then Exit Function
    ReDim iData(iSize - 1)
    If GetFontData(nHdc, cTagCmap, 0, iData(0), iSize) <> iSize Then Exit Function
    
    iNumTables = BEWord(iData, 2)
    iTableOffset = -1
    For iRec = 0 To iNumTables - 1
        iPos = 4 + iRec * 8
        If (iPos + 8) > iSize Then Exit Function
        iPlatform = BEWord(iData, iPos)
        iEncoding = BEWord(iData, iPos + 2)
        iSubOffset = BEDWord(iData, iPos + 4)
        If ((iPlatform = 3) And (iEncoding = 10)) Or ((iPlatform = 0) And ((iEncoding = 4) Or (iEncoding = 6))) Then
            If (iSubOffset + 16) <= iSize Then
                If BEWord(iData, iSubOffset) = 12 Then
                    iTableOffset = iSubOffset
                    Exit For
                End If
            End If
        End If
    Next
    If iTableOffset = -1 Then Exit Function
    
    iNumGroups = BEDWord(iData, iTableOffset + 12)
    If (iNumGroups <= 0) Or ((iTableOffset + 16 + iNumGroups * 12) > iSize) Then Exit Function
    For iGroup = 0 To iNumGroups - 1
        iPos = iTableOffset + 16 + iGroup * 12
        iStartChar = BEDWord(iData, iPos)
        If (nCharCode >= iStartChar) And (nCharCode <= BEDWord(iData, iPos + 4)) Then
            FontMapsCharCmap12 = (BEDWord(iData, iPos + 8) + (nCharCode - iStartChar)) <> 0
            Exit Function
        End If
    Next
End Function

' The characters Windows draws as emoji without being asked to (Unicode Emoji_Presentation)
Private Function IsEmojiPresentation(ByVal nCharCode As Long) As Boolean
    Select Case nCharCode
        Case Is >= &H1F000
            IsEmojiPresentation = True
        Case &H231A& To &H231B&, &H23E9& To &H23EC&, &H23F0&, &H23F3&, &H25FD& To &H25FE&, &H2614& To &H2615&, &H2648& To &H2653&, &H267F&, &H2693&, &H26A1&, &H26AA& To &H26AB&, &H26BD& To &H26BE&, &H26C4& To &H26C5&, &H26CE&, &H26D4&, &H26EA&, &H26F2& To &H26F3&, &H26F5&, &H26FA&, &H26FD&
            IsEmojiPresentation = True
        Case &H2705&, &H270A& To &H270B&, &H2728&, &H274C&, &H274E&, &H2753& To &H2755&, &H2757&, &H2795& To &H2797&, &H27B0&, &H27BF&, &H2B1B& To &H2B1C&, &H2B50&, &H2B55&
            IsEmojiPresentation = True
    End Select
End Function

' Reads the code point at nPos and moves nPos past it
Private Function CodePointAt(nText As String, nPos As Long) As Long
    Dim iHigh As Long
    Dim iLow As Long
    
    iHigh = AscW(Mid$(nText, nPos, 1)) And &HFFFF&
    nPos = nPos + 1
    CodePointAt = iHigh
    If (iHigh >= &HD800&) And (iHigh <= &HDBFF&) And (nPos <= Len(nText)) Then
        iLow = AscW(Mid$(nText, nPos, 1)) And &HFFFF&
        If (iLow >= &HDC00&) And (iLow <= &HDFFF&) Then
            CodePointAt = &H10000 + (iHigh - &HD800&) * &H400& + (iLow - &HDC00&)
            nPos = nPos + 1
        End If
    End If
End Function

Private Function SelectInCombo(nCombo As Control, nListItem As String) As Boolean
    Dim c As Long
    
    For c = 0 To nCombo.ListCount - 1
        If nCombo.List(c) = nListItem Then
            nCombo.ListIndex = c
            SelectInCombo = True
            Exit Function
        End If
    Next c
End Function

Private Function SelectInComboByItemData(nCombo As Control, nItemData As Long) As Boolean
    Dim c As Long
    
    For c = 0 To nCombo.ListCount - 1
        If nCombo.ItemData(c) = nItemData Then
            nCombo.ListIndex = c
            SelectInComboByItemData = True
            Exit Function
        End If
    Next c
End Function

Private Function CloneFont(nOrigFont As iFont) As StdFont
    If nOrigFont Is Nothing Then Exit Function
    nOrigFont.Clone CloneFont
End Function

Private Sub DrawCharMapFromScrollPosition()
    If mPreparingCharPics Then Exit Sub
    tmrDrawCharMapFromScrollPosition.Enabled = False
    tmrDrawCharMapFromScrollPosition.Enabled = True
End Sub

Private Sub ScrollCharMapToSelected()
    tmrScrollCharMapToSelected.Enabled = False
    tmrScrollCharMapToSelected.Enabled = True
End Sub

Private Sub DoDrawCharMapFromScrollPosition()
    Dim c As Long
    Dim iStart As Long
    Dim p As Long
    Dim iTopSelectable As Long
    
    tmrDrawCharMapFromScrollPosition.Enabled = False
    EnsureCharPicsAndFontDataReady
    
    iStart = scrChars.Value * mCharColumns
    iTopSelectable = iStart + (mCharColumns * mCharSelectableRows)
    p = 0
    mIconCharCurrentlySelectedInCharMap = -1
    mFirstCharInMap = -1
    mLastCharInMap = 0
    For c = iStart To iStart + (mCharColumns * mCharRows) - 1
        If c >= mCharCount Then Exit For
        If c > -1 Then
            If Not picChar(p).Font Is mFontForCharMap Then
                Set picChar(p).Font = mFontForCharMap
            End If
            DrawChar mChars(c), picChar(p)
            If mFirstCharInMap = -1 Then
                mFirstCharInMap = mChars(c)
            End If
            If c < iTopSelectable Then
                mLastCharInMap = mChars(c)
            End If
            If mChars(c) = mIconCharSelected Then
                If mIconCharSelected > 0 Then
                    If c < iTopSelectable Then
                        picChar(p).Line (1, 1)-(picChar(p).ScaleWidth - 1, picChar(p).ScaleHeight - 1), vbRed, B
                        mIconCharCurrentlySelectedInCharMap = mChars(c)
                    End If
                End If
            End If
            picChar(p).Visible = True
            p = p + 1
        End If
    Next
    For p = p To picChar.UBound
        picChar(p).Visible = False
    Next
    lblMapFromTo.Caption = "Showing characters from &&H" & Hex$(mFirstCharInMap) & " to &&H" & Hex$(mLastCharInMap) & ":"
    lblMapFromTo.Visible = True
End Sub

Private Sub DoScrollCharMapToSelected()
    Dim c As Long
    Dim s1 As Long
    Dim s3() As Long
    Dim s4 As Long
    Dim s As Long
    
    EnsureCharPicsAndFontDataReady
    If mTabData(mTab).IconChar = 0 Then
        scrChars.Value = scrChars.Min
        DoDrawCharMapFromScrollPosition
    Else
        If (mIconCharCurrentlySelectedInCharMap <> mTabData(mTab).IconChar) Then
            ReDim s3(0)
            For s1 = scrChars.Min To scrChars.Max Step scrChars.LargeChange
                ReDim Preserve s3(UBound(s3) + 1)
                s3(UBound(s3)) = s1
            Next
            If s3(UBound(s3)) <> scrChars.Max Then
                ReDim Preserve s3(UBound(s3) + 1)
                s3(UBound(s3)) = scrChars.Max
            End If
            For s4 = 1 To UBound(s3)
                s = s3(s4) * mCharColumns
                For c = s To s + mCharColumns * mCharSelectableRows - 1
                    If (c > -1) And (c < mCharCount) Then
                        If mChars(c) = mTabData(mTab).IconChar Then
                            If (mIconCharSelected < mFirstCharInMap) Or (mIconCharSelected > mLastCharInMap) Then
                                scrChars.Value = s3(s4)
                            End If
                            DoDrawCharMapFromScrollPosition
                            Exit Sub
                        End If
                    End If
                Next
            Next
            scrChars.Value = scrChars.Min
            DoDrawCharMapFromScrollPosition
        End If
    End If
End Sub

Private Sub EnsureCharPicsAndFontDataReady()
    Dim iStr As String
    
    iStr = GetIconFontString
    If iStr <> mLastGetIconFontString Then
        PrepareIconFontData
        PrepareCharPics
        ' the range of the last map drawn belongs to the previous font; left there, it can claim
        ' the selected character is already in view and DoScrollCharMapToSelected does not scroll
        mFirstCharInMap = -1
        mLastCharInMap = -1
        mLastGetIconFontString = iStr
    End If
End Sub

Private Function GetIconFontString() As String
    Dim f As StdFont
    
    Set f = mTabData(mTab).IconFont
    GetIconFontString = f.Name & "|" & f.Bold & "|" & f.Charset & "|" & f.Italic & "|" & f.Size & "|" & f.Strikethrough & "|" & f.Underline & "|" & f.Weight
End Function

Private Sub PrepareIconFontData()
    Dim r As Long
    Dim g As Long
    Dim iLow As Long
    Dim iTM As TEXTMETRICW
    Dim iStr As String
    Dim ub As Long
    
    Set mFontForCharMap = CloneFont(mTabData(mTab).IconFont)
    ' limit charmap font size
    If mFontForCharMap.Size < 11 Then mFontForCharMap.Size = 11
    If mFontForCharMap.Size > 30 Then mFontForCharMap.Size = 30
    Set picCharSelected.Font = mFontForCharMap
    GetTextMetricsW picCharSelected.hDC, iTM
    mCharWidth = iTM.tmAveCharWidth * 3
    If mCharWidth > iTM.tmMaxCharWidth Then mCharWidth = iTM.tmMaxCharWidth
    iStr = ChrU(iTM.tmDefaultChar)
    GetGlyphIndicesW picCharSelected.hDC, StrPtr(iStr), Len(iStr), VarPtr(mDefaultGlyph), 0
    iStr = ChrU(32)
    GetGlyphIndicesW picCharSelected.hDC, StrPtr(iStr), Len(iStr), VarPtr(mSpaceGlyph), 0
    
    mCharCount = 0
    If Not LoadCharsFromCmap12(picCharSelected.hDC) Then
        mGlyphSet = GetGlyphSet(picCharSelected.hDC)
        ub = 2000
        ReDim mChars(ub)
        With mGlyphSet
            For r = 0 To .cRanges - 1
                With .ranges(r)
                    If .wcLow < 0 Then
                        iLow = .wcLow And &HFFFF&
                    Else
                        iLow = .wcLow
                    End If
                    For g = iLow To iLow + .cGlyphs - 1
                        If (g >= -1) Then
                            If IsGlyphValid(g, picCharSelected.hDC) Then
                                mChars(mCharCount) = g
                                mCharCount = mCharCount + 1
                                If mCharCount > ub Then
                                    ub = ub + 2000
                                    ReDim Preserve mChars(ub)
                                End If
                            End If
                        End If
                    Next
                End With
            Next
        End With
    End If
    ReDim Preserve mChars(mCharCount - 1)
End Sub

' GetFontUnicodeRanges only knows 16-bit ranges, so characters above &HFFFF never reached the
' map. The format 12 subtable of the font's cmap lists every code point the font maps, in 32
' bits. Fonts without one - most of the classic ones - return False and take the old path
Private Function LoadCharsFromCmap12(ByVal nHdc As LongPtr) As Boolean
    Const cTagCmap As Long = &H70616D63
    Const GDI_ERROR As Long = &HFFFFFFFF
    Dim iSize As Long
    Dim iData() As Byte
    Dim iNumTables As Long
    Dim iRec As Long
    Dim iPlatform As Long
    Dim iEncoding As Long
    Dim iSubOffset As Long
    Dim iTableOffset As Long
    Dim iNumGroups As Long
    Dim iGroup As Long
    Dim iPos As Long
    Dim iStartChar As Long
    Dim iEndChar As Long
    Dim iStartGlyph As Long
    Dim iCharCode As Long
    Dim iGlyph As Long
    Dim iTotal As Long
    
    iSize = GetFontData(nHdc, cTagCmap, 0, ByVal 0&, 0)
    If (iSize = GDI_ERROR) Or (iSize < 4) Then Exit Function
    ReDim iData(iSize - 1)
    If GetFontData(nHdc, cTagCmap, 0, iData(0), iSize) <> iSize Then Exit Function
    
    iNumTables = BEWord(iData, 2)
    iTableOffset = -1
    For iRec = 0 To iNumTables - 1
        iPos = 4 + iRec * 8
        If (iPos + 8) > iSize Then Exit Function
        iPlatform = BEWord(iData, iPos)
        iEncoding = BEWord(iData, iPos + 2)
        iSubOffset = BEDWord(iData, iPos + 4)
        If ((iPlatform = 3) And (iEncoding = 10)) Or ((iPlatform = 0) And ((iEncoding = 4) Or (iEncoding = 6))) Then
            If (iSubOffset + 16) <= iSize Then
                If BEWord(iData, iSubOffset) = 12 Then
                    iTableOffset = iSubOffset
                    Exit For
                End If
            End If
        End If
    Next
    If iTableOffset = -1 Then Exit Function
    
    iNumGroups = BEDWord(iData, iTableOffset + 12)
    If (iNumGroups <= 0) Or ((iTableOffset + 16 + iNumGroups * 12) > iSize) Then Exit Function
    
    ' sized once: a CJK font can map tens of thousands of characters
    For iGroup = 0 To iNumGroups - 1
        iPos = iTableOffset + 16 + iGroup * 12
        iStartChar = BEDWord(iData, iPos)
        iEndChar = BEDWord(iData, iPos + 4)
        If (iEndChar < iStartChar) Or (iEndChar > &H10FFFF) Then Exit Function
        iTotal = iTotal + (iEndChar - iStartChar + 1)
    Next
    ReDim mChars(iTotal - 1)
    
    mCharCount = 0
    For iGroup = 0 To iNumGroups - 1
        iPos = iTableOffset + 16 + iGroup * 12
        iStartChar = BEDWord(iData, iPos)
        iEndChar = BEDWord(iData, iPos + 4)
        iStartGlyph = BEDWord(iData, iPos + 8)
        For iCharCode = iStartChar To iEndChar
            iGlyph = iStartGlyph + (iCharCode - iStartChar)
            ' the same exclusions IsGlyphValid makes on the old path
            If (iCharCode > 31) And (iGlyph <> 0) And (iGlyph <> (mDefaultGlyph And &HFFFF&)) And (iGlyph <> (mSpaceGlyph And &HFFFF&)) Then
                mChars(mCharCount) = iCharCode
                mCharCount = mCharCount + 1
            End If
        Next
    Next
    LoadCharsFromCmap12 = mCharCount > 0
End Function

' Font tables are big-endian
Private Function BEWord(nData() As Byte, ByVal nPos As Long) As Long
    BEWord = nData(nPos) * &H100& + nData(nPos + 1)
End Function

' The top bit is never set in the values read here; masking it keeps the result a positive Long
Private Function BEDWord(nData() As Byte, ByVal nPos As Long) As Long
    BEDWord = (nData(nPos) And &H7F) * &H1000000 + nData(nPos + 1) * &H10000 + nData(nPos + 2) * &H100& + nData(nPos + 3)
End Function

Private Function GetGlyphSet(ByVal nHdc As LongPtr) As GLYPHSET
    Dim Data() As Byte, i As Long, j As Long
    Dim Result As Long, Count As Long
    Dim GS As GLYPHSET
    
    'Get the size of the GLYPHSET structure required to store the information
    Result = GetFontUnicodeRanges(nHdc, ByVal 0&)
    If Result = 0 Then Exit Function
    ReDim Data(0 To (Result - 1)) As Byte
    'Get the data and the number of bytes written
    Result = GetFontUnicodeRanges(nHdc, Data(LBound(Data)))
    If Result = 0 Then Exit Function
    
    'Copy the first 4 LONG into the GLYPHSET structure
    i = LBound(Data)
    Count = 4 * 4
    CopyMemory GS, Data(i), Count
    i = i + Count
    With GS
        'Did the font support unicode?
        If .cRanges > 0 Then
            'Create the array of ranges and copy the data into there
            ReDim .ranges(0 To (.cRanges - 1)) As WCRANGE
            j = 0 ' LBound(.ranges)
            Count = .cRanges
            Do While Count > 0
                CopyMemory .ranges(j), Data(i), LenB(.ranges(j))
                i = i + Len(.ranges(j))
                j = j + 1
                Count = Count - 1
            Loop
        End If
    End With
    GetGlyphSet = GS
End Function

Private Sub PrepareCharPics()
    Dim c As Long
    Dim iLeft As Long
    Dim iTop As Long
    Dim iWidth As Long
    Dim iHeight As Long
    Dim iRow As Long
    Dim iHorSpacing As Long
    Dim iVerSpacing As Long
    Dim iSng As Single
    Dim iLng As Long
    Dim iAuxNT As NewTab
    
    ' See the note in CheckImageSizes: pScaleX is Friend and the extender does not publish it
    Set iAuxNT = NewTab1
    mPreparingCharPics = True
    mIconCharCurrentlySelectedInCharMap = -1
    iHorSpacing = 20 + mFontForCharMap.Size
    iVerSpacing = iHorSpacing
    iWidth = iAuxNT.pScaleX(mCharWidth, vbPixels, PropertyPage.ScaleMode)
    
    ' put some limits to size
    If iWidth < 230 Then iWidth = 230
    If ((iWidth + iVerSpacing) * 3) > picCharMap.ScaleHeight Then
        iWidth = picCharMap.ScaleHeight / 3 - iVerSpacing
    End If
    
    ' adjust to fix horizontally
    mCharColumns = Int((picCharMap.ScaleWidth - (picChar(0).Left * 2) - scrChars.Width) / (iWidth + iVerSpacing))
    iLng = picCharMap.ScaleWidth - (picChar(0).Left * 2) - scrChars.Width - mCharColumns * (iWidth + iVerSpacing)
    iWidth = iWidth + iLng / mCharColumns
    
    iHeight = iWidth
    picChar(0).Move picChar(0).Left, picChar(0).Top, iWidth, iHeight
    
    iRow = 0
    c = 1
    iLeft = picChar(0).Left
    iTop = picChar(0).Top
    Do
        iLeft = iLeft + iWidth + iHorSpacing
        If (iLeft + iWidth) > (picCharMap.ScaleWidth - scrChars.Width) Then
            iRow = iRow + 1
            iLeft = picChar(0).Left
            iTop = iTop + iHeight + iVerSpacing
            If iTop > picCharMap.ScaleHeight Then
                mCharRows = iRow
                If (iTop + iHeight) > picCharMap.ScaleHeight Then
                    mCharSelectableRows = mCharRows - 1
                Else
                    mCharSelectableRows = mCharRows
                End If
                Exit Do
            End If
        End If
        If c > picChar.UBound Then
            Load picChar(c)
        End If
        picChar(c).Move iLeft, iTop, iWidth, iHeight
        c = c + 1
    Loop
    For c = 0 To picChar.UBound
        picChar(0).Visible = False
    Next
    
    iSng = mCharCount / mCharColumns
    If Int(iSng) <> iSng Then
        iSng = Int(iSng) + 1
    End If
    scrChars.Min = 0
    scrChars.SmallChange = 1
    scrChars.LargeChange = mCharSelectableRows - 1
    scrChars.Max = iSng - mCharSelectableRows
    scrChars.Value = scrChars.Min
    mPreparingCharPics = False
End Sub

Private Sub DrawChar(nCharCode As Long, nPic As PictureBox)
    Dim iIconCharacter As String
    Dim iFlags As Long
    Dim iIconCharRect As RECT
    Dim iLeft As Long
    Dim iTop As Long
    Dim iWidth As Long
    Dim iHeight As Long
    Dim iDrawnInColor As Boolean
    
    iIconCharRect.Right = nPic.ScaleWidth
    iIconCharRect.Bottom = 0
    iIconCharacter = ChrU(nCharCode)
    nPic.Cls
    If mIconInColor Then iDrawnInColor = DrawColorGlyph(nPic.hDC, nCharCode, nPic.ForeColor, nPic.BackColor, 0, 0, CLng(nPic.ScaleWidth), CLng(nPic.ScaleHeight))
    If Not iDrawnInColor Then
        iFlags = DT_CALCRECT Or DT_SINGLELINE Or DT_CENTER
        DrawTextW nPic.hDC, StrPtr(iIconCharacter), -1, iIconCharRect, iFlags
        iWidth = (iIconCharRect.Right - iIconCharRect.Left)
        iHeight = (iIconCharRect.Bottom - iIconCharRect.Top)
        If (iWidth <= nPic.ScaleWidth) And (iHeight <= nPic.ScaleHeight) Then
            iLeft = nPic.ScaleWidth / 2 - iWidth / 2
            iTop = nPic.ScaleHeight / 2 - iHeight / 2
        Else
            iLeft = 0
            iTop = 0
        End If
        iIconCharRect.Right = iIconCharRect.Right + iLeft
        iIconCharRect.Left = iIconCharRect.Left + iLeft
        iIconCharRect.Bottom = iIconCharRect.Bottom + iTop
        iIconCharRect.Top = iIconCharRect.Top + iTop
        iFlags = DT_SINGLELINE Or DT_CENTER
        DrawTextW nPic.hDC, StrPtr(iIconCharacter), -1, iIconCharRect, iFlags
    End If
    nPic.Tag = nCharCode
    nPic.ToolTipText = "&H" & Hex$(nCharCode) & " (" & nCharCode & ")"
End Sub

Private Function ChrU(ByVal nCharCodeU As Long) As String
    Const cPOW10 As Long = 2 ^ 10
    
    If nCharCodeU <= &HFFFF& Then
        ChrU = ChrW$(nCharCodeU)
    Else
        ChrU = ChrW$(&HD800& + (nCharCodeU - &H10000) \ cPOW10) & ChrW$(&HDC00& + (nCharCodeU And (cPOW10 - 1)))
    End If
End Function

Private Function IsGlyphValid(nCharCode As Long, nHdc As LongPtr) As Boolean
    Const GGI_MARK_NONEXISTING_GLYPHS As Long = &H1
    Dim iStr As String
    Dim iGlyph As Integer
    Dim iLen As Long
    
    iStr = ChrU(nCharCode)
    iLen = Len(iStr)
    GetGlyphIndicesW nHdc, StrPtr(iStr), iLen, VarPtr(iGlyph), GGI_MARK_NONEXISTING_GLYPHS
    If (iGlyph <> mDefaultGlyph) And (iGlyph <> -1) And (iGlyph <> mSpaceGlyph) Then
        IsGlyphValid = True
    End If
End Function

Private Sub CheckOtherTabsFonts()
    Dim t As Long
    
    If Not FontsAreEqual(mTabData(mTab).IconFont, mDefaultIconFont) Then
        For t = 0 To mTabs - 1
            If t <> mTab Then
                If mTabData(t).IconChar = 0 Then
                    If FontsAreEqual(mTabData(t).IconFont, mDefaultIconFont) Then
                        Set mTabData(t).IconFont = CloneFont(mTabData(mTab).IconFont)
                    End If
                End If
            End If
        Next
        Set mDefaultIconFont = CloneFont(mTabData(mTab).IconFont)
    End If
End Sub

Private Function FontsAreEqual(nFont1 As StdFont, nFont2 As StdFont) As Boolean
    If nFont1 Is Nothing Or nFont2 Is Nothing Then Exit Function
    
    If (nFont1 Is Nothing) And (nFont2 Is Nothing) Then
        FontsAreEqual = True
        Exit Function
    End If
    If (nFont1 Is Nothing) Then Exit Function
    If (nFont2 Is Nothing) Then Exit Function
    
    If nFont1.Name = nFont2.Name Then
        If nFont1.Size = nFont2.Size Then
            If nFont1.Bold = nFont2.Bold Then
                If nFont1.Italic = nFont2.Italic Then
                    If nFont1.Strikethrough = nFont2.Strikethrough Then
                        If nFont1.Underline = nFont2.Underline Then
                            If nFont1.Weight = nFont2.Weight Then
                                If nFont1.Charset = nFont2.Charset Then
                                    FontsAreEqual = True
                                    Exit Function
                                End If
                            End If
                        End If
                    End If
                End If
            End If
        End If
    End If
End Function

Private Sub EnsureFontListLoaded()
    Const WM_SETREDRAW = &HB
    Dim c As Long
    
    SendMessage cboTabIconFont.hWnd, WM_SETREDRAW, 0, 0
    If Not mFontListLoaded Then
        cboTabIconFont.Clear
        cboTabIconFont.AddItem ""
        For c = 0 To Screen.FontCount - 1
            cboTabIconFont.AddItem Screen.Fonts(c)
        Next
        mFontListLoaded = True
    End If
    SendMessage cboTabIconFont.hWnd, WM_SETREDRAW, -1, 0
End Sub

' LoadPicture that keeps the original file data, so PropertyBag persists it unchanged (incl. icon alpha)
Public Function LoadPictureFile(sFileName As String) As IPictureDisp
    Const STGM_READ As Long = &H0&
    Const STGM_SHARE_DENY_WRITE As Long = &H20&
    Const NULL_PTR As Long = 0&
    Const ERR_INVALID_PICTURE As Long = 481
    Const STR_IID_IPICTUREDISP As String = "{7BF80981-BF32-101A-8BBB-00AA00300CAB}"
    Dim pStream         As IUnknown
    Dim uIID            As GUID
    Dim oPicture        As IPictureDisp

    ' Same behavior as LoadPicture(""): return Nothing
    If LenB(sFileName) = 0 Then
        Set LoadPictureFile = Nothing
        Exit Function
    End If

    If SHCreateStreamOnFileEx(StrPtr(sFileName), STGM_READ Or STGM_SHARE_DENY_WRITE, 0, 0, NULL_PTR, pStream) < 0 Then
        Err.Raise ERR_INVALID_PICTURE
    End If
    Call IIDFromString(StrPtr(STR_IID_IPICTUREDISP), uIID)

    ' lSize = 0: read the whole stream
    ' fRunmode = 0 (False): KeepOriginalFormat = True, original bytes are retained
    If OleLoadPicture(pStream, 0, 0, uIID, oPicture) < 0 Then
        Err.Raise ERR_INVALID_PICTURE
    End If
    Set LoadPictureFile = oPicture
End Function

