Private Sub cboIconAlignment_Click()
    If Not mLoading And Not mShowingTabData Then Changed = True
    NewTab1.IconAlignment = cboIconAlignment.ItemData(cboIconAlignment.ListIndex)
End Sub

Private Sub cboTDIFormsIconSize_Click()
    If Not mLoading And Not mShowingTabData Then Changed = True
    ' no preview to update: the sample is covered in TDI modes, and it is not
    ' hosting forms anyway
End Sub

Private Sub chkIconInColor_Click()
    Dim t As Long
    
    mIconInColor = (chkIconInColor.Value = vbChecked)
    ' DoShowTabData sets the box and redraws the map itself
    If mLoading Or mShowingTabData Then Exit Sub
    Changed = True
    mTabData(mTab).IconInColor = mIconInColor
    NewTab1.TabIconInColor(mTab) = mIconInColor
    ' Tabs with no icon yet take it along, as they take the font in CheckOtherTabsFonts
    For t = 0 To mTabs - 1
        If t <> mTab Then
            If mTabData(t).IconChar = 0 Then mTabData(t).IconInColor = mIconInColor
        End If
    Next
    DrawCharMapFromScrollPosition
    If mIconCharSelected > 0 Then DrawChar mIconCharSelected, picCharSelected
End Sub

Private Sub cboScalePicturesForDPI_Click()
    If Not mLoading And Not mShowingTabData Then Changed = True
    NewTab1.ScalePicturesForDPI = cboScalePicturesForDPI.ItemData(cboScalePicturesForDPI.ListIndex)
End Sub

Private Sub chkUseMaskColor_Click()
    If Not mLoading Then Changed = True
    NewTab1.UseMaskColor = (chkUseMaskColor.Value = vbChecked)
    picMaskColor.Enabled = (chkUseMaskColor.Value = vbChecked)
End Sub

Private Sub picMaskColor_Click()
    PickMaskColor
End Sub

Private Sub picMaskColor_KeyDown(KeyCode As Integer, Shift As Integer)
    If (KeyCode = vbKeySpace) Or (KeyCode = vbKeyF4) Then PickMaskColor
End Sub

Private Sub PickMaskColor()
    Dim iSelector As New cColorSelector
    Dim iPicked As Long
    
    If Not iSelector.PickColor(PropertyPage.hWnd, picMaskColor.hWnd, NewTab1.MaskColor, NewTab1.MaskColor, iPicked, False) Then Exit Sub
    If iPicked = NewTab1.MaskColor Then Exit Sub
    NewTab1.MaskColor = iPicked
    Changed = True
    ShowMaskColor
End Sub

Private Sub PutMaskColorOnTDICover(ByVal nLabelLeft As Single, ByVal nLabelWidth As Single)
    Set chkUseMaskColor.Container = picTDICover
    Set lblMaskColor.Container = picTDICover
    Set picMaskColor.Container = picTDICover
    chkUseMaskColor.Move cboTDIFormsIconSize.Left, cboTDIFormsIconSize.Top + 450
    lblMaskColor.Move nLabelLeft, cboTDIFormsIconSize.Top + 860, nLabelWidth
    picMaskColor.Move cboTDIFormsIconSize.Left, cboTDIFormsIconSize.Top + 830
End Sub

Private Sub ShowMaskColor()
    Dim iSelector As New cColorSelector
    
    picMaskColor.BackColor = NewTab1.MaskColor
    picMaskColor.ToolTipText = "MaskColor: " & iSelector.ColorDisplayName(NewTab1.MaskColor) & ", applied to the pictures of all tabs - click to change"
    picMaskColor.Enabled = (chkUseMaskColor.Value = vbChecked)
End Sub

Private Sub cboTabIconFont_Click()
    If (Not mLoading) And (Not mShowingTabData) Then
        Changed = True
        If cboTabIconFont.Text <> "" Then
            mTabData(mTab).IconFont.Name = cboTabIconFont.Text
        End If
        CheckOtherTabsFonts
        ShowTabData
    End If
End Sub

Private Sub cmdBrowsePicture_Click()
    Dim iDlg As New cCommonDialog
    
    iDlg.Filter = "Image files|*.bmp;*.ico"
    iDlg.ShowOpen
    If Not iDlg.Canceled Then
        Changed = True
        On Error Resume Next
        Set mTabData(mTab).Picture = LoadPictureFile(iDlg.FileName)
        If Err.Number <> 0 Then
            MsgBox "Error: " & Err.Number & ", " & Err.Description, vbCritical
        End If
        On Error GoTo 0
        ShowTabData
    End If
End Sub

Private Sub cmdChangeIconFont_Click()
    Dim cDlg As New cCommonDialog
    
    Set cDlg.Font = mTabData(mTab).IconFont
    cDlg.ShowFont
    If Not cDlg.Canceled Then
        Changed = True
        Set mTabData(mTab).IconFont = CloneFont(cDlg.Font)
        CheckOtherTabsFonts
        ShowTabData
        Set mLastIconFont = CloneFont(cDlg.Font)
    End If
End Sub

Private Sub cmdDecreaseIconFontSize_Click()
    Dim iPrev As Single
    
    If mTabData(mTab).IconFont.Size > 3 Then
        iPrev = mTabData(mTab).IconFont.Size
        mTabData(mTab).IconFont.Size = mTabData(mTab).IconFont.Size - 0.5
        If mTabData(mTab).IconFont.Size = iPrev Then
            mTabData(mTab).IconFont.Size = mTabData(mTab).IconFont.Size - 1
            If mTabData(mTab).IconFont.Size = iPrev Then
                mTabData(mTab).IconFont.Size = mTabData(mTab).IconFont.Size - 2
            End If
        End If
        If mLastIconFont.Name <> mTabData(mTab).IconFont.Name Then
            Set mLastIconFont = CloneFont(mTabData(mTab).IconFont)
        End If
        mLastIconFont.Size = mTabData(mTab).IconFont.Size
        Changed = True
        CheckOtherTabsFonts
        ShowTabData
    End If
End Sub

Private Sub cmdDeletePicture_Click()
    Changed = True
    Set mTabData(mTab).Picture = Nothing
    ShowTabData
End Sub


