Private Sub SetRowEnabled(nLabel As Label, nField As Control, ByVal nEnabled As Boolean)
    nLabel.Enabled = nEnabled
    nField.Enabled = nEnabled
End Sub

' OLEDropOnOtherTabs only filters the drops that OLEDropMode Manual lets in
Private Sub SetEnabledStates()
    SetRowEnabled lblOLEDropOnOtherTabs, chkOLEDropOnOtherTabs, (ComboValue(cboOLEDropMode) = ssOLEDropManual)
    lblOLEDropOnOtherTabsInfo.Enabled = chkOLEDropOnOtherTabs.Enabled
    SetRowEnabled lblTDIMode, cboTDIMode, mTDIModeCanChange
End Sub

' Preview

' What can be tried on the sample. The contained controls, OLE drop, Enabled and TDIMode are left out
Private Sub UpdatePreview()
    On Error Resume Next
    mPreview.CanReorderTabs = CheckValue(chkCanReorderTabs)
    mPreview.TabMousePointerHand = CheckValue(chkTabMousePointerHand)
    mPreview.TabTransition = ComboValue(cboTabTransition)
    mPreview.ShowFocusRect = CheckValue(chkShowFocusRect)
    mPreview.HandleHighContrastTheme = CheckValue(chkHandleHighContrastTheme)
    On Error GoTo 0
End Sub

Private Sub SeedPreviewTab(ByVal nSC As NewTab, ByVal nTab As Long)
    Dim c As Long
    
    For c = 0 To ntCCFlatTabBorderColorInactive
        If nSC.TabCustomColorIsSet(nTab, c) Then
            mPreview.TabCustomColor(nTab, c) = nSC.TabCustomColor(nTab, c)
        Else
            mPreview.TabCustomColor(nTab, c) = -1
        End If
    Next c
    mPreview.TabCaption(nTab) = nSC.TabCaption(nTab)
    mPreview.TabEnabled(nTab) = nSC.TabEnabled(nTab)
    mPreview.TabVisible(nTab) = nSC.TabVisible(nTab)
    mPreview.TabCloseButton(nTab) = nSC.TabCloseButton(nTab)
    mPreview.TabCloseButtonEnabled(nTab) = nSC.TabCloseButtonEnabled(nTab)
    Set mPreview.TabPic16(nTab) = nSC.TabPic16(nTab)
    Set mPreview.TabPic20(nTab) = nSC.TabPic20(nTab)
    Set mPreview.TabPic24(nTab) = nSC.TabPic24(nTab)
    Set mPreview.TabPicture(nTab) = nSC.TabPicture(nTab)
    Set mPreview.TabIconFont(nTab) = CloneFont(nSC.TabIconFont(nTab))
    mPreview.TabIconCharHex(nTab) = nSC.TabIconCharHex(nTab)
    mPreview.TabIconLeftOffset(nTab) = nSC.TabIconLeftOffset(nTab)
    mPreview.TabIconTopOffset(nTab) = nSC.TabIconTopOffset(nTab)
End Sub

' Placed the way Tabs places its sample: centred against the page, then moved so that the selected
' tab is in sight
Private Sub PlacePreview()
    mPreview.Left = (PropertyPage.ScaleWidth - mPreview.Width) / 2
    If mPreview.TabSel > -1 Then
        If (mPreview.Left + mPreview.GetTabLeft(mPreview.TabSel) + mPreview.GetTabWidth(mPreview.TabSel)) > PropertyPage.ScaleWidth Then
            mPreview.Left = PropertyPage.ScaleWidth - (mPreview.GetTabLeft(mPreview.TabSel) + mPreview.GetTabWidth(mPreview.TabSel)) - 120
        ElseIf (mPreview.Left + mPreview.GetTabLeft(mPreview.TabSel)) < 0 Then
            mPreview.Left = 120 - mPreview.GetTabLeft(mPreview.TabSel)
        End If
    End If
    mPreview.Top = PreviewTop(mPreview, picSampleContainer.ScaleHeight)
End Sub

Private Sub NewTab1_CloseButtonClick(ByVal nTab As Long, Cancel As Boolean)
    Cancel = True
End Sub

Private Function CloneFont(nOrigFont As iFont) As StdFont
    If nOrigFont Is Nothing Then Exit Function
    nOrigFont.Clone CloneFont
End Function

' The list opens as wide as its longest item. picSampleContainer measures because it has the page
' font, the same as the combos
Private Sub SetComboDropWidth(nCombo As ComboBox)
    Dim c As Long
    Dim iWidth As Single
    Dim iMaxWidth As Single
    
    For c = 0 To nCombo.ListCount - 1
        iWidth = picSampleContainer.TextWidth(nCombo.List(c))
        If iWidth > iMaxWidth Then iMaxWidth = iWidth
    Next c
    ' room for the item margins and a vertical scroll bar
    iMaxWidth = mPreview.pScaleX(iMaxWidth, vbTwips, vbPixels) + mPreview.pScaleX(360, vbTwips, vbPixels)
    If iMaxWidth > mPreview.pScaleX(nCombo.Width, vbTwips, vbPixels) Then SendMessageW nCombo.hWnd, CB_SETDROPPEDWIDTH, CLng(iMaxWidth), 0
End Sub

Private Function SelectInComboByItemData(nCombo As Control, nItemData As Long) As Boolean
    Dim c As Long
    
    For c = 0 To nCombo.ListCount - 1
        If nCombo.ItemData(c) = nItemData Then
            nCombo.ListIndex = c
            SelectInComboByItemData = True
            Exit Function
        End If
    Next c
End Function

