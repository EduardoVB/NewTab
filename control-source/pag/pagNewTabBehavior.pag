Attribute VB_Name = "pagNewTabBehavior"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Option Explicit

Private Declare Function SendMessageW Lib "user32" (ByVal hWnd As LongPtr, ByVal wMsg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr

Private Const CB_SETDROPPEDWIDTH As Long = &H160&

Private mPreview As NewTab
Private mLoading As Boolean
Private mTDIModeCanChange As Boolean

Private Sub PropertyPage_SelectionChanged()
    Dim iSC As NewTab
    Dim t As Long

    If TypeName(SelectedControls(0)) <> "NewTab" Then Exit Sub
    mLoading = True
    Set iSC = SelectedControls(0)
    Set mPreview = NewTab1

    LoadCombos
    mTDIModeCanChange = iSC.TDIModeCanChange

    chkCanReorderTabs.Value = IIf(iSC.CanReorderTabs, vbChecked, vbUnchecked)
    chkTabMousePointerHand.Value = IIf(iSC.TabMousePointerHand, vbChecked, vbUnchecked)
    SelectInComboByItemData cboTabTransition, iSC.TabTransition
    chkShowFocusRect.Value = IIf(iSC.ShowFocusRect, vbChecked, vbUnchecked)
    chkEnabled.Value = IIf(iSC.Enabled, vbChecked, vbUnchecked)
    SelectInComboByItemData cboAutoRelocateControls, iSC.AutoRelocateControls
    chkChangeControlsBackColor.Value = IIf(iSC.ChangeControlsBackColor, vbChecked, vbUnchecked)
    chkChangeControlsForeColor.Value = IIf(iSC.ChangeControlsForeColor, vbChecked, vbUnchecked)
    SelectInComboByItemData cboOLEDropMode, iSC.OLEDropMode
    chkOLEDropOnOtherTabs.Value = IIf(iSC.OLEDropOnOtherTabs, vbChecked, vbUnchecked)
    chkHandleHighContrastTheme.Value = IIf(iSC.HandleHighContrastTheme, vbChecked, vbUnchecked)
    SelectInComboByItemData cboTDIMode, iSC.TDIMode

    ' The sample is the developer's control, as in the other pages. Not disabled with it: then it
    ' could not be tried
    mPreview.Redraw = False
    mPreview.RightToLeft = iSC.RightToLeft
    mPreview.CloseButton = iSC.CloseButton
    mPreview.CloseButtonPosition = iSC.CloseButtonPosition
    mPreview.CaptionAlignment = iSC.CaptionAlignment
    mPreview.Tabs = iSC.Tabs
    For t = 0 To iSC.Tabs - 1
        SeedPreviewTab iSC, t
    Next t
    Select Case iSC.TabOrientation
        Case ssTabOrientationRight, ssTabOrientationLeft, ntTabOrientationRightBottom, ntTabOrientationLeftTop
            mPreview.Width = iSC.Height
            mPreview.Height = iSC.Width
        Case Else
            mPreview.Width = iSC.Width
            mPreview.Height = iSC.Height
    End Select
    CopyControlProperties iSC, mPreview
    If iSC.TabSel > -1 Then
        If mPreview.TabVisible(iSC.TabSel) Then mPreview.TabSel = iSC.TabSel
    End If
    UpdatePreview
    mPreview.Redraw = True
    PlacePreview

    SetComboDropWidth cboTabTransition
    SetComboDropWidth cboAutoRelocateControls
    SetComboDropWidth cboOLEDropMode
    SetComboDropWidth cboTDIMode
    SetEnabledStates
    Changed = False
    mLoading = False
End Sub

Private Sub PropertyPage_EditProperty(PropertyName As String)
    On Error Resume Next
    Select Case PropertyName
        Case "TabMousePointerHand": chkTabMousePointerHand.SetFocus
        Case "TabTransition": cboTabTransition.SetFocus
        Case "ShowFocusRect": chkShowFocusRect.SetFocus
        Case "Enabled": chkEnabled.SetFocus
        Case "AutoRelocateControls": cboAutoRelocateControls.SetFocus
        Case "ChangeControlsBackColor": chkChangeControlsBackColor.SetFocus
        Case "ChangeControlsForeColor": chkChangeControlsForeColor.SetFocus
        Case "OLEDropMode": cboOLEDropMode.SetFocus
        Case "OLEDropOnOtherTabs": chkOLEDropOnOtherTabs.SetFocus
        Case "HandleHighContrastTheme": chkHandleHighContrastTheme.SetFocus
        Case "TDIMode": cboTDIMode.SetFocus
        Case Else: chkCanReorderTabs.SetFocus
    End Select
End Sub

' TDIMode goes first: the control takes it only until any other property is set
Private Sub PropertyPage_ApplyChanges()
    Dim iSC As NewTab

    If mPreview Is Nothing Then Exit Sub
    Set iSC = SelectedControls(0)
    On Error Resume Next
    If mTDIModeCanChange And (iSC.TDIMode <> ComboValue(cboTDIMode)) Then iSC.TDIMode = ComboValue(cboTDIMode)
    iSC.Redraw = False
    If iSC.CanReorderTabs <> CheckValue(chkCanReorderTabs) Then iSC.CanReorderTabs = CheckValue(chkCanReorderTabs)
    If iSC.TabMousePointerHand <> CheckValue(chkTabMousePointerHand) Then iSC.TabMousePointerHand = CheckValue(chkTabMousePointerHand)
    If iSC.TabTransition <> ComboValue(cboTabTransition) Then iSC.TabTransition = ComboValue(cboTabTransition)
    If iSC.ShowFocusRect <> CheckValue(chkShowFocusRect) Then iSC.ShowFocusRect = CheckValue(chkShowFocusRect)
    If iSC.AutoRelocateControls <> ComboValue(cboAutoRelocateControls) Then iSC.AutoRelocateControls = ComboValue(cboAutoRelocateControls)
    If iSC.ChangeControlsBackColor <> CheckValue(chkChangeControlsBackColor) Then iSC.ChangeControlsBackColor = CheckValue(chkChangeControlsBackColor)
    If iSC.ChangeControlsForeColor <> CheckValue(chkChangeControlsForeColor) Then iSC.ChangeControlsForeColor = CheckValue(chkChangeControlsForeColor)
    If iSC.OLEDropMode <> ComboValue(cboOLEDropMode) Then iSC.OLEDropMode = ComboValue(cboOLEDropMode)
    If iSC.OLEDropOnOtherTabs <> CheckValue(chkOLEDropOnOtherTabs) Then iSC.OLEDropOnOtherTabs = CheckValue(chkOLEDropOnOtherTabs)
    If iSC.HandleHighContrastTheme <> CheckValue(chkHandleHighContrastTheme) Then iSC.HandleHighContrastTheme = CheckValue(chkHandleHighContrastTheme)
    If iSC.Enabled <> CheckValue(chkEnabled) Then iSC.Enabled = CheckValue(chkEnabled)
    iSC.Redraw = True
    mTDIModeCanChange = iSC.TDIModeCanChange
    On Error GoTo 0
    SetEnabledStates
End Sub

Private Function CheckValue(nCheck As CheckBox) As Boolean
    CheckValue = (nCheck.Value = vbChecked)
End Function

Private Function ComboValue(nCombo As ComboBox) As Long
    If nCombo.ListIndex > -1 Then ComboValue = nCombo.ItemData(nCombo.ListIndex)
End Function

Private Sub LoadCombos()
    cboTabTransition.Clear
    cboTabTransition.AddItem ntAnimationNone & " - ntAnimationNone": cboTabTransition.ItemData(cboTabTransition.NewIndex) = ntAnimationNone
    cboTabTransition.AddItem ntAnimationFaster & " - ntAnimationFaster": cboTabTransition.ItemData(cboTabTransition.NewIndex) = ntAnimationFaster
    cboTabTransition.AddItem ntAnimationFast & " - ntAnimationFast": cboTabTransition.ItemData(cboTabTransition.NewIndex) = ntAnimationFast
    cboTabTransition.AddItem ntAnimationMedium & " - ntAnimationMedium": cboTabTransition.ItemData(cboTabTransition.NewIndex) = ntAnimationMedium
    cboTabTransition.AddItem ntAnimationSlow & " - ntAnimationSlow": cboTabTransition.ItemData(cboTabTransition.NewIndex) = ntAnimationSlow
    cboTabTransition.AddItem ntAnimationSlower & " - ntAnimationSlower": cboTabTransition.ItemData(cboTabTransition.NewIndex) = ntAnimationSlower

    cboAutoRelocateControls.Clear
    cboAutoRelocateControls.AddItem ntRelocateNever & " - ntRelocateNever": cboAutoRelocateControls.ItemData(cboAutoRelocateControls.NewIndex) = ntRelocateNever
    cboAutoRelocateControls.AddItem ntRelocateAlways & " - ntRelocateAlways": cboAutoRelocateControls.ItemData(cboAutoRelocateControls.NewIndex) = ntRelocateAlways
    cboAutoRelocateControls.AddItem ntRelocateOnTabOrientationChange & " - ntRelocateOnTabOrientationChange": cboAutoRelocateControls.ItemData(cboAutoRelocateControls.NewIndex) = ntRelocateOnTabOrientationChange

    cboOLEDropMode.Clear
    cboOLEDropMode.AddItem ssOLEDropNone & " - ssOLEDropNone": cboOLEDropMode.ItemData(cboOLEDropMode.NewIndex) = ssOLEDropNone
    cboOLEDropMode.AddItem ssOLEDropManual & " - ssOLEDropManual": cboOLEDropMode.ItemData(cboOLEDropMode.NewIndex) = ssOLEDropManual

    cboTDIMode.Clear
    cboTDIMode.AddItem ntTDIModeNone & " - ntTDIModeNone": cboTDIMode.ItemData(cboTDIMode.NewIndex) = ntTDIModeNone
    cboTDIMode.AddItem ntTDIModeControls & " - ntTDIModeControls": cboTDIMode.ItemData(cboTDIMode.NewIndex) = ntTDIModeControls
    cboTDIMode.AddItem ntTDIModeForms & " - ntTDIModeForms": cboTDIMode.ItemData(cboTDIMode.NewIndex) = ntTDIModeForms
End Sub

Private Sub Edited()
    If mLoading Then Exit Sub
    SetEnabledStates
    UpdatePreview
    Changed = True
End Sub

Private Sub chkCanReorderTabs_Click()
    Edited
End Sub

