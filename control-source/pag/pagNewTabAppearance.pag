' What applies and when

' The same resolution the control does at the start of Draw
Private Function EffectiveAppearance() As Long
    EffectiveAppearance = ComboValue(cboTabAppearance)
    If EffectiveAppearance <> ntTAAuto Then Exit Function
    Select Case ComboValue(cboStyle)
        Case ntStyleWindows: EffectiveAppearance = ntTAWindows
        Case ntStyleTabStrip: EffectiveAppearance = ntTATabStrip
        Case ssStylePropertyPage: EffectiveAppearance = ntTAPropertyPage
        Case ntStyleFlat: EffectiveAppearance = ntTAFlat
        Case Else: EffectiveAppearance = ntTATabbedDialog
    End Select
End Function

Private Function AppearanceName(ByVal nAppearance As Long) As String
    Select Case nAppearance
        Case ntTATabbedDialog: AppearanceName = "ntTATabbedDialog"
        Case ntTATabbedDialogRounded: AppearanceName = "ntTATabbedDialogRounded"
        Case ntTAPropertyPage: AppearanceName = "ntTAPropertyPage"
        Case ntTAPropertyPageRounded: AppearanceName = "ntTAPropertyPageRounded"
        Case ntTAFlat: AppearanceName = "ntTAFlat"
        Case ntTATabStrip: AppearanceName = "ntTATabStrip"
        Case ntTAWindows: AppearanceName = "ntTAWindows"
    End Select
End Function

Private Sub ShowAppearanceInfo()
    Dim iText As String

    If ComboValue(cboTabAppearance) = ntTAAuto Then iText = "Auto = " & AppearanceName(EffectiveAppearance) & ", by Style"
    lblTabAppearanceInfo.Caption = iText
    lblTabAppearanceInfo.ToolTipText = iText

    Select Case ComboValue(cboBackStyle)
        Case ntTransparent: iText = "back, body and selected tab; no ntTAWindows"
        Case ntTransparentBackOnly: iText = "only the BackColor area"
        Case Else: iText = ""
    End Select
    lblBackStyleInfo.Caption = iText
    lblBackStyleInfo.ToolTipText = iText
End Sub

Private Sub SetRowEnabled(nLabel As Label, nField As Control, nInfo As Label, ByVal nEnabled As Boolean)
    nLabel.Enabled = nEnabled
    nField.Enabled = nEnabled
    nInfo.Enabled = nEnabled
End Sub

' The frame is not disabled: its children would keep looking enabled
Private Sub SetEnabledStates()
    Dim iAppearance As Long
    Dim iFlat As Boolean

    iAppearance = EffectiveAppearance
    iFlat = (iAppearance = ntTAFlat)
    SetRowEnabled lblSoftEdges, chkSoftEdges, lblSoftEdgesInfo, (iAppearance <> ntTAFlat) And (iAppearance <> ntTAWindows)
    SetRowEnabled lblShowDisabledState, chkShowDisabledState, lblShowDisabledStateInfo, (iAppearance <> ntTAWindows)
    SetRowEnabled lblFlatBorderMode, cboFlatBorderMode, lblFlatBorderModeInfo, iFlat
    SetRowEnabled lblFlatBarPosition, cboFlatBarPosition, lblFlatBarPositionInfo, iFlat
    SetRowEnabled lblFlatBarHeight, txtFlatBarHeight, lblFlatBarHeightInfo, iFlat
    SetRowEnabled lblFlatBarGripHeight, txtFlatBarGripHeight, lblFlatBarGripHeightInfo, iFlat
    SetRowEnabled lblFlatBodySeparationLineHeight, txtFlatBodySeparationLineHeight, lblFlatBodySeparationLineHeightInfo, iFlat
    SetRowEnabled lblFlatTabBodyGap, txtFlatTabBodyGap, lblFlatTabBodyGapInfo, iFlat
    SetRowEnabled lblFlatRoundnessTop, txtFlatRoundnessTop, lblFlatRoundnessTopInfo, iFlat
    SetRowEnabled lblFlatRoundnessBottom, txtFlatRoundnessBottom, lblFlatRoundnessBottomInfo, iFlat
    SetRowEnabled lblFlatRoundnessTabs, txtFlatRoundnessTabs, lblFlatRoundnessTabsInfo, iFlat
End Sub

' Preview

' Same order as ApplyChanges. A value the preview refuses is simply not shown
Private Sub UpdatePreview()
    On Error Resume Next
    mPreview.Redraw = False
    mPreview.Style = ComboValue(cboStyle)
    mPreview.TabAppearance = ComboValue(cboTabAppearance)
    mPreview.BackStyle = ComboValue(cboBackStyle)
    mPreview.CaptionAlignment = ComboValue(cboCaptionAlignment)
    mPreview.RightToLeft = CheckValue(chkRightToLeft)
    mPreview.SoftEdges = CheckValue(chkSoftEdges)
    mPreview.ShowDisabledState = CheckValue(chkShowDisabledState)
    mPreview.FlatBorderMode = ComboValue(cboFlatBorderMode)
    mPreview.FlatBarPosition = ComboValue(cboFlatBarPosition)
    mPreview.FlatBarHeight = mFlatBarHeight
    mPreview.FlatBarGripHeight = mFlatBarGripHeight
    mPreview.FlatBodySeparationLineHeight = mFlatBodySeparationLineHeight
    mPreview.FlatTabBodyGap = mFlatTabBodyGap
    mPreview.FlatRoundnessTop = mFlatRoundnessTop
    mPreview.FlatRoundnessBottom = mFlatRoundnessBottom
    mPreview.FlatRoundnessTabs = mFlatRoundnessTabs
    mPreview.Redraw = True
    On Error GoTo 0
    PlacePreview
End Sub

Private Sub SeedPreviewTab(ByVal nSC As NewTab, ByVal nTab As Long)
    Dim c As Long
    
    For c = 0 To ntCCFlatTabBorderColorInactive
        If nSC.TabCustomColorIsSet(nTab, c) Then
            mPreview.TabCustomColor(nTab, c) = nSC.TabCustomColor(nTab, c)
        Else
            mPreview.TabCustomColor(nTab, c) = -1
        End If
    Next c
    mPreview.TabCaption(nTab) = nSC.TabCaption(nTab)
    mPreview.TabEnabled(nTab) = nSC.TabEnabled(nTab)
    mPreview.TabVisible(nTab) = nSC.TabVisible(nTab)
    mPreview.TabCloseButton(nTab) = nSC.TabCloseButton(nTab)
    mPreview.TabCloseButtonEnabled(nTab) = nSC.TabCloseButtonEnabled(nTab)
    Set mPreview.TabPic16(nTab) = nSC.TabPic16(nTab)
    Set mPreview.TabPic20(nTab) = nSC.TabPic20(nTab)
    Set mPreview.TabPic24(nTab) = nSC.TabPic24(nTab)
    Set mPreview.TabPicture(nTab) = nSC.TabPicture(nTab)
    Set mPreview.TabIconFont(nTab) = CloneFont(nSC.TabIconFont(nTab))
    mPreview.TabIconCharHex(nTab) = nSC.TabIconCharHex(nTab)
    mPreview.TabIconLeftOffset(nTab) = nSC.TabIconLeftOffset(nTab)
    mPreview.TabIconTopOffset(nTab) = nSC.TabIconTopOffset(nTab)
End Sub

' Placed the way Tabs places its sample: centred against the page, then moved so that the selected
' tab is in sight
Private Sub PlacePreview()
    mPreview.Left = (PropertyPage.ScaleWidth - mPreview.Width) / 2
    If mPreview.TabSel > -1 Then
        If (mPreview.Left + mPreview.GetTabLeft(mPreview.TabSel) + mPreview.GetTabWidth(mPreview.TabSel)) > PropertyPage.ScaleWidth Then
            mPreview.Left = PropertyPage.ScaleWidth - (mPreview.GetTabLeft(mPreview.TabSel) + mPreview.GetTabWidth(mPreview.TabSel)) - 120
        ElseIf (mPreview.Left + mPreview.GetTabLeft(mPreview.TabSel)) < 0 Then
            mPreview.Left = 120 - mPreview.GetTabLeft(mPreview.TabSel)
        End If
    End If
    mPreview.Top = PreviewTop(mPreview, picSampleContainer.ScaleHeight)
End Sub

Private Sub NewTab1_CloseButtonClick(ByVal nTab As Long, Cancel As Boolean)
    Cancel = True
End Sub

Private Function CloneFont(nOrigFont As iFont) As StdFont
    If nOrigFont Is Nothing Then Exit Function
    nOrigFont.Clone CloneFont
End Function

' The list opens as wide as its longest item. picSampleContainer measures because it has the page
' font, the same as the combos
Private Sub SetComboDropWidth(nCombo As ComboBox)
    Dim c As Long
    Dim iWidth As Single
    Dim iMaxWidth As Single
    
    For c = 0 To nCombo.ListCount - 1
        iWidth = picSampleContainer.TextWidth(nCombo.List(c))
        If iWidth > iMaxWidth Then iMaxWidth = iWidth
    Next c
    ' room for the item margins and a vertical scroll bar
    iMaxWidth = mPreview.pScaleX(iMaxWidth, vbTwips, vbPixels) + mPreview.pScaleX(360, vbTwips, vbPixels)
    If iMaxWidth > mPreview.pScaleX(nCombo.Width, vbTwips, vbPixels) Then SendMessageW nCombo.hWnd, CB_SETDROPPEDWIDTH, CLng(iMaxWidth), 0
End Sub

Private Function SelectInComboByItemData(nCombo As Control, nItemData As Long) As Boolean
    Dim c As Long
    
    For c = 0 To nCombo.ListCount - 1
        If nCombo.ItemData(c) = nItemData Then
            nCombo.ListIndex = c
            SelectInComboByItemData = True
            Exit Function
        End If
    Next c
End Function

