Attribute VB_Name = "pagNewTabAppearance"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Option Explicit

Private Declare Function SendMessageW Lib "user32" (ByVal hWnd As LongPtr, ByVal wMsg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr

Private Const CB_SETDROPPEDWIDTH As Long = &H160&

Private mPreview As NewTab
Private mLoading As Boolean
Private mSettingText As Boolean
Private mFlatBarHeight As Long
Private mFlatBarGripHeight As Long
Private mFlatBodySeparationLineHeight As Long
Private mFlatTabBodyGap As Long
Private mFlatRoundnessTop As Long
Private mFlatRoundnessBottom As Long
Private mFlatRoundnessTabs As Long

Private Sub PropertyPage_SelectionChanged()
    Dim iSC As NewTab
    Dim t As Long

    If TypeName(SelectedControls(0)) <> "NewTab" Then Exit Sub
    mLoading = True
    Set iSC = SelectedControls(0)
    Set mPreview = NewTab1

    LoadCombos
    SelectInComboByItemData cboStyle, iSC.Style
    SelectInComboByItemData cboTabAppearance, iSC.TabAppearance
    SelectInComboByItemData cboBackStyle, iSC.BackStyle
    SelectInComboByItemData cboCaptionAlignment, iSC.CaptionAlignment
    chkRightToLeft.Value = IIf(iSC.RightToLeft, vbChecked, vbUnchecked)
    chkSoftEdges.Value = IIf(iSC.SoftEdges, vbChecked, vbUnchecked)
    chkShowDisabledState.Value = IIf(iSC.ShowDisabledState, vbChecked, vbUnchecked)
    SelectInComboByItemData cboFlatBorderMode, iSC.FlatBorderMode
    SelectInComboByItemData cboFlatBarPosition, iSC.FlatBarPosition
    mFlatBarHeight = iSC.FlatBarHeight
    mFlatBarGripHeight = iSC.FlatBarGripHeight
    mFlatBodySeparationLineHeight = iSC.FlatBodySeparationLineHeight
    mFlatTabBodyGap = iSC.FlatTabBodyGap
    mFlatRoundnessTop = iSC.FlatRoundnessTop
    mFlatRoundnessBottom = iSC.FlatRoundnessBottom
    mFlatRoundnessTabs = iSC.FlatRoundnessTabs
    ShowAllValues

    ' The sample is the developer's control, as in the other pages
    mPreview.Redraw = False
    mPreview.RightToLeft = iSC.RightToLeft
    mPreview.CloseButton = iSC.CloseButton
    mPreview.CloseButtonPosition = iSC.CloseButtonPosition
    mPreview.CaptionAlignment = iSC.CaptionAlignment
    mPreview.Tabs = iSC.Tabs
    For t = 0 To iSC.Tabs - 1
        SeedPreviewTab iSC, t
    Next t
    Select Case iSC.TabOrientation
        Case ssTabOrientationRight, ssTabOrientationLeft, ntTabOrientationRightBottom, ntTabOrientationLeftTop
            mPreview.Width = iSC.Height
            mPreview.Height = iSC.Width
        Case Else
            mPreview.Width = iSC.Width
            mPreview.Height = iSC.Height
    End Select
    CopyControlProperties iSC, mPreview
    If iSC.TabSel > -1 Then
        If mPreview.TabVisible(iSC.TabSel) Then mPreview.TabSel = iSC.TabSel
    End If
    UpdatePreview

    SetComboDropWidth cboStyle
    SetComboDropWidth cboTabAppearance
    SetComboDropWidth cboBackStyle
    SetComboDropWidth cboCaptionAlignment
    SetComboDropWidth cboFlatBorderMode
    SetComboDropWidth cboFlatBarPosition
    SetEnabledStates
    ShowAppearanceInfo
    Changed = False
    mLoading = False
End Sub

Private Sub PropertyPage_EditProperty(PropertyName As String)
    On Error Resume Next
    Select Case PropertyName
        Case "TabAppearance": cboTabAppearance.SetFocus
        Case "BackStyle": cboBackStyle.SetFocus
        Case "CaptionAlignment": cboCaptionAlignment.SetFocus
        Case "RightToLeft": chkRightToLeft.SetFocus
        Case "SoftEdges": chkSoftEdges.SetFocus
        Case "ShowDisabledState": chkShowDisabledState.SetFocus
        Case "FlatBorderMode": cboFlatBorderMode.SetFocus
        Case "FlatBarPosition": cboFlatBarPosition.SetFocus
        Case "FlatBarHeight": txtFlatBarHeight.SetFocus
        Case "FlatBarGripHeight": txtFlatBarGripHeight.SetFocus
        Case "FlatBodySeparationLineHeight": txtFlatBodySeparationLineHeight.SetFocus
        Case "FlatTabBodyGap": txtFlatTabBodyGap.SetFocus
        Case "FlatRoundnessTop": txtFlatRoundnessTop.SetFocus
        Case "FlatRoundnessBottom": txtFlatRoundnessBottom.SetFocus
        Case "FlatRoundnessTabs": txtFlatRoundnessTabs.SetFocus
        Case Else: cboStyle.SetFocus
    End Select
End Sub

Private Sub PropertyPage_ApplyChanges()
    Dim iSC As NewTab

    If mPreview Is Nothing Then Exit Sub
    Set iSC = SelectedControls(0)
    On Error Resume Next
    iSC.Redraw = False
    If iSC.Style <> ComboValue(cboStyle) Then iSC.Style = ComboValue(cboStyle)
    If iSC.TabAppearance <> ComboValue(cboTabAppearance) Then iSC.TabAppearance = ComboValue(cboTabAppearance)
    If iSC.BackStyle <> ComboValue(cboBackStyle) Then iSC.BackStyle = ComboValue(cboBackStyle)
    If iSC.CaptionAlignment <> ComboValue(cboCaptionAlignment) Then iSC.CaptionAlignment = ComboValue(cboCaptionAlignment)
    If iSC.RightToLeft <> CheckValue(chkRightToLeft) Then iSC.RightToLeft = CheckValue(chkRightToLeft)
    If iSC.SoftEdges <> CheckValue(chkSoftEdges) Then iSC.SoftEdges = CheckValue(chkSoftEdges)
    If iSC.ShowDisabledState <> CheckValue(chkShowDisabledState) Then iSC.ShowDisabledState = CheckValue(chkShowDisabledState)
    If iSC.FlatBorderMode <> ComboValue(cboFlatBorderMode) Then iSC.FlatBorderMode = ComboValue(cboFlatBorderMode)
    If iSC.FlatBarPosition <> ComboValue(cboFlatBarPosition) Then iSC.FlatBarPosition = ComboValue(cboFlatBarPosition)
    If iSC.FlatBarHeight <> mFlatBarHeight Then iSC.FlatBarHeight = mFlatBarHeight
    If iSC.FlatBarGripHeight <> mFlatBarGripHeight Then iSC.FlatBarGripHeight = mFlatBarGripHeight
    If iSC.FlatBodySeparationLineHeight <> mFlatBodySeparationLineHeight Then iSC.FlatBodySeparationLineHeight = mFlatBodySeparationLineHeight
    If iSC.FlatTabBodyGap <> mFlatTabBodyGap Then iSC.FlatTabBodyGap = mFlatTabBodyGap
    If iSC.FlatRoundnessTop <> mFlatRoundnessTop Then iSC.FlatRoundnessTop = mFlatRoundnessTop
    If iSC.FlatRoundnessBottom <> mFlatRoundnessBottom Then iSC.FlatRoundnessBottom = mFlatRoundnessBottom
    If iSC.FlatRoundnessTabs <> mFlatRoundnessTabs Then iSC.FlatRoundnessTabs = mFlatRoundnessTabs
    iSC.Redraw = True
    On Error GoTo 0
End Sub

Private Function CheckValue(nCheck As CheckBox) As Boolean
    CheckValue = (nCheck.Value = vbChecked)
End Function

Private Function ComboValue(nCombo As ComboBox) As Long
    If nCombo.ListIndex > -1 Then ComboValue = nCombo.ItemData(nCombo.ListIndex)
End Function

Private Sub LoadCombos()
    cboStyle.Clear
    cboStyle.AddItem ssStyleTabbedDialog & " - ssStyleTabbedDialog": cboStyle.ItemData(cboStyle.NewIndex) = ssStyleTabbedDialog
    cboStyle.AddItem ssStylePropertyPage & " - ssStylePropertyPage": cboStyle.ItemData(cboStyle.NewIndex) = ssStylePropertyPage
    cboStyle.AddItem ntStyleTabStrip & " - ntStyleTabStrip": cboStyle.ItemData(cboStyle.NewIndex) = ntStyleTabStrip
    cboStyle.AddItem ntStyleFlat & " - ntStyleFlat": cboStyle.ItemData(cboStyle.NewIndex) = ntStyleFlat
    cboStyle.AddItem ntStyleWindows & " - ntStyleWindows": cboStyle.ItemData(cboStyle.NewIndex) = ntStyleWindows

    cboTabAppearance.Clear
    cboTabAppearance.AddItem ntTAAuto & " - ntTAAuto": cboTabAppearance.ItemData(cboTabAppearance.NewIndex) = ntTAAuto
    cboTabAppearance.AddItem ntTATabbedDialog & " - ntTATabbedDialog": cboTabAppearance.ItemData(cboTabAppearance.NewIndex) = ntTATabbedDialog
    cboTabAppearance.AddItem ntTATabbedDialogRounded & " - ntTATabbedDialogRounded": cboTabAppearance.ItemData(cboTabAppearance.NewIndex) = ntTATabbedDialogRounded
    cboTabAppearance.AddItem ntTAPropertyPage & " - ntTAPropertyPage": cboTabAppearance.ItemData(cboTabAppearance.NewIndex) = ntTAPropertyPage
    cboTabAppearance.AddItem ntTAPropertyPageRounded & " - ntTAPropertyPageRounded": cboTabAppearance.ItemData(cboTabAppearance.NewIndex) = ntTAPropertyPageRounded
    cboTabAppearance.AddItem ntTAFlat & " - ntTAFlat": cboTabAppearance.ItemData(cboTabAppearance.NewIndex) = ntTAFlat
    cboTabAppearance.AddItem ntTATabStrip & " - ntTATabStrip": cboTabAppearance.ItemData(cboTabAppearance.NewIndex) = ntTATabStrip
    cboTabAppearance.AddItem ntTAWindows & " - ntTAWindows": cboTabAppearance.ItemData(cboTabAppearance.NewIndex) = ntTAWindows

    cboBackStyle.Clear
    cboBackStyle.AddItem ntTransparent & " - ntTransparent": cboBackStyle.ItemData(cboBackStyle.NewIndex) = ntTransparent
    cboBackStyle.AddItem ntOpaque & " - ntOpaque": cboBackStyle.ItemData(cboBackStyle.NewIndex) = ntOpaque
    cboBackStyle.AddItem ntTransparentBackOnly & " - ntTransparentBackOnly": cboBackStyle.ItemData(cboBackStyle.NewIndex) = ntTransparentBackOnly

    cboCaptionAlignment.Clear
    cboCaptionAlignment.AddItem ntAlignmentLeft & " - ntAlignmentLeft": cboCaptionAlignment.ItemData(cboCaptionAlignment.NewIndex) = ntAlignmentLeft
    cboCaptionAlignment.AddItem ntAlignmentRight & " - ntAlignmentRight": cboCaptionAlignment.ItemData(cboCaptionAlignment.NewIndex) = ntAlignmentRight
    cboCaptionAlignment.AddItem ntAlignmentCenter & " - ntAlignmentCenter": cboCaptionAlignment.ItemData(cboCaptionAlignment.NewIndex) = ntAlignmentCenter

    cboFlatBorderMode.Clear
    cboFlatBorderMode.AddItem ntBorderTabs & " - ntBorderTabs": cboFlatBorderMode.ItemData(cboFlatBorderMode.NewIndex) = ntBorderTabs
    cboFlatBorderMode.AddItem ntBorderSelectedTab & " - ntBorderSelectedTab": cboFlatBorderMode.ItemData(cboFlatBorderMode.NewIndex) = ntBorderSelectedTab

    cboFlatBarPosition.Clear
    cboFlatBarPosition.AddItem ntBarPositionTop & " - ntBarPositionTop": cboFlatBarPosition.ItemData(cboFlatBarPosition.NewIndex) = ntBarPositionTop
    cboFlatBarPosition.AddItem ntBarPositionBottom & " - ntBarPositionBottom": cboFlatBarPosition.ItemData(cboFlatBarPosition.NewIndex) = ntBarPositionBottom
End Sub

' Values

Private Sub ShowAllValues()
    mSettingText = True
    txtFlatBarHeight.Text = CStr(mFlatBarHeight)
    txtFlatBarGripHeight.Text = CStr(mFlatBarGripHeight)
    txtFlatBodySeparationLineHeight.Text = CStr(mFlatBodySeparationLineHeight)
    txtFlatTabBodyGap.Text = CStr(mFlatTabBodyGap)
    txtFlatRoundnessTop.Text = CStr(mFlatRoundnessTop)
    txtFlatRoundnessBottom.Text = CStr(mFlatRoundnessBottom)
    txtFlatRoundnessTabs.Text = CStr(mFlatRoundnessTabs)
    mSettingText = False
End Sub

' A text that is not a valid value yet leaves the last valid one in place; leaving the box shows it
Private Function ReadInteger(ByVal nText As String, ByVal nMin As Long, ByVal nMax As Long, ByRef nValue As Long) As Boolean
    Dim iDigits As String

    nText = Trim$(nText)
    iDigits = nText
    If Left$(iDigits, 1) = "-" Then iDigits = Mid$(iDigits, 2)
    If (Len(iDigits) = 0) Or (Len(iDigits) > 4) Then Exit Function
    If iDigits Like "*[!0-9]*" Then Exit Function
    If (CLng(nText) < nMin) Or (CLng(nText) > nMax) Then Exit Function
    nValue = CLng(nText)
    ReadInteger = True
End Function

Private Sub ValueEdited()
    If mLoading Or mSettingText Then Exit Sub
    UpdatePreview
    Changed = True
End Sub

Private Sub txtFlatBarHeight_Change()
    If mLoading Or mSettingText Then Exit Sub
    If ReadInteger(txtFlatBarHeight.Text, 0, 15, mFlatBarHeight) Then ValueEdited
