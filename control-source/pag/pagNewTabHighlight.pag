Attribute VB_Name = "pagNewTabHighlight"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Option Explicit

Private Declare Function SendMessageW Lib "user32" (ByVal hWnd As LongPtr, ByVal wMsg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr
Private Declare Function OleTranslateColor Lib "oleaut32.dll" (ByVal clr As OLE_COLOR, ByVal palet As LongPtr, Col As Long) As Long

Private Const CB_SETDROPPEDWIDTH As Long = &H160&

Private Const cColorLast As Long = 10

' Column 0 is HighlightMode, column 1 HighlightModeSelectedTab

' The preview shows every edit. The two sizes are kept here in the units of the developer's
' container, not read back from the preview, whose container has other units
Private mPreview As NewTab
Private mLoading As Boolean
Private mSettingText As Boolean
Private mExtraHeight As Single
Private mCaptionShift As Single
Private mUpdateingValue As Boolean
' What Auto resolves to, per column. Read once: this page does not change Style
Private mAutoFlags(1) As Long
' The flags that do something in the control's appearance, per column. A flag outside it is greyed and keeps its tick
Private mFlagsWithEffect(1) As Long

Private Sub PropertyPage_SelectionChanged()
    Dim iSC As NewTab
    Dim t As Long
    Dim c As Long
    
    If TypeName(SelectedControls(0)) <> "NewTab" Then Exit Sub
    mLoading = True
    Set iSC = SelectedControls(0)
    Set mPreview = NewTab1
    
    LoadSpeedCombo cboHighlightEffect
    LoadSpeedCombo cboHighlightEffectOut
    cboColor.Clear
    For c = 0 To cColorLast
        cboColor.AddItem ColorPropertyName(c)
        cboColor.ItemData(cboColor.NewIndex) = c
    Next c
    
    ' The sample is the developer's control, as the samples of Tabs and Icons are
    mPreview.Redraw = False
    mPreview.RightToLeft = iSC.RightToLeft
    mPreview.CloseButton = iSC.CloseButton
    mPreview.CloseButtonPosition = iSC.CloseButtonPosition
    mPreview.CaptionAlignment = iSC.CaptionAlignment
    mPreview.Tabs = iSC.Tabs
    For t = 0 To iSC.Tabs - 1
        SeedPreviewTab iSC, t
    Next t
    Select Case iSC.TabOrientation
        Case ssTabOrientationRight, ssTabOrientationLeft, ntTabOrientationRightBottom, ntTabOrientationLeftTop
            mPreview.Width = iSC.Height
            mPreview.Height = iSC.Width
        Case Else
            mPreview.Width = iSC.Width
            mPreview.Height = iSC.Height
    End Select
    CopyControlProperties iSC, mPreview
    If iSC.TabSel > -1 Then
        If mPreview.TabVisible(iSC.TabSel) Then mPreview.TabSel = iSC.TabSel
    End If
    mPreview.HighlightMode = iSC.HighlightMode
    mPreview.HighlightModeSelectedTab = iSC.HighlightModeSelectedTab
    mPreview.HighlightEffect = iSC.HighlightEffect
    mPreview.HighlightEffectOut = iSC.HighlightEffectOut
    mExtraHeight = iSC.HighlightTabExtraHeight
    mCaptionShift = iSC.HighlightTabCaptionShift
    SetPreviewSizes iSC
    mPreview.Redraw = True
    PlacePreview
    
    txtHighlightModeValue.Text = iSC.HighlightMode
    txtHighlightModeSelectedTabValue.Text = iSC.HighlightModeSelectedTab
    
    mAutoFlags(0) = iSC.AutoHighlightMode(False)
    mAutoFlags(1) = iSC.AutoHighlightMode(True)
    mFlagsWithEffect(0) = iSC.HighlightFlagsWithEffect(False)
    mFlagsWithEffect(1) = iSC.HighlightFlagsWithEffect(True)
    LoadColumn 0, iSC.HighlightMode
    LoadColumn 1, iSC.HighlightModeSelectedTab
    SelectInComboByItemData cboHighlightEffect, iSC.HighlightEffect
    SelectInComboByItemData cboHighlightEffectOut, iSC.HighlightEffectOut
    txtHighlightTabExtraHeight.Text = CStr(mExtraHeight)
    txtHighlightTabCaptionShift.Text = CStr(mCaptionShift)
    SetComboDropWidth cboHighlightEffect
    SetComboDropWidth cboHighlightEffectOut
    SetComboDropWidth cboColor
    If cboColor.ListIndex = -1 Then cboColor.ListIndex = 0
    ShowCurrentColor True
    Changed = False
    mLoading = False
End Sub

Private Sub PropertyPage_EditProperty(PropertyName As String)
    On Error Resume Next
    If PropertyName = "HighlightModeSelectedTab" Then
        chkHLAuto(1).SetFocus
    Else
        chkHLAuto(0).SetFocus
    End If
End Sub

Private Sub PropertyPage_ApplyChanges()
    Dim iSC As NewTab
    Dim iValue As Long
    Dim iUnused As Long
    Dim c As Long
    
    If mPreview Is Nothing Then Exit Sub
    Set iSC = SelectedControls(0)
    If iSC.HighlightMode <> mPreview.HighlightMode Then iSC.HighlightMode = mPreview.HighlightMode
    If iSC.HighlightModeSelectedTab <> mPreview.HighlightModeSelectedTab Then iSC.HighlightModeSelectedTab = mPreview.HighlightModeSelectedTab
    If iSC.HighlightEffect <> mPreview.HighlightEffect Then iSC.HighlightEffect = mPreview.HighlightEffect
    If iSC.HighlightEffectOut <> mPreview.HighlightEffectOut Then iSC.HighlightEffectOut = mPreview.HighlightEffectOut
    If iSC.HighlightTabExtraHeight <> mExtraHeight Then iSC.HighlightTabExtraHeight = mExtraHeight
    If iSC.HighlightTabCaptionShift <> mCaptionShift Then iSC.HighlightTabCaptionShift = mCaptionShift
    ' -1 against -1 is two automatic ones, so a plain comparison covers the state too
    For c = 0 To cColorLast
        iValue = ColorValue(mPreview, c, iUnused)
        If iValue <> ColorValue(iSC, c, iUnused) Then CallByName iSC, ColorPropertyName(c), VbLet, iValue
    Next c
End Sub

' Converted through himetric: the developer's container and the preview's can have different units
Private Sub SetPreviewSizes(ByVal nSC As NewTab)
    Dim iPreviewUnit As Single
    
    iPreviewUnit = mPreview.FromContainerSizeY(1, vbHimetric)
    If iPreviewUnit = 0 Then Exit Sub
    mPreview.HighlightTabExtraHeight = nSC.FromContainerSizeY(mExtraHeight, vbHimetric) / iPreviewUnit
    mPreview.HighlightTabCaptionShift = nSC.FromContainerSizeY(mCaptionShift, vbHimetric) / iPreviewUnit
End Sub

Private Sub SeedPreviewTab(ByVal nSC As NewTab, ByVal nTab As Long)
    Dim c As Long
    
    For c = 0 To ntCCFlatTabBorderColorInactive
        If nSC.TabCustomColorIsSet(nTab, c) Then
            mPreview.TabCustomColor(nTab, c) = nSC.TabCustomColor(nTab, c)
        Else
            mPreview.TabCustomColor(nTab, c) = -1
        End If
    Next c
    mPreview.TabCaption(nTab) = nSC.TabCaption(nTab)
    mPreview.TabEnabled(nTab) = nSC.TabEnabled(nTab)
    mPreview.TabVisible(nTab) = nSC.TabVisible(nTab)
    mPreview.TabCloseButton(nTab) = nSC.TabCloseButton(nTab)
    mPreview.TabCloseButtonEnabled(nTab) = nSC.TabCloseButtonEnabled(nTab)
    Set mPreview.TabPic16(nTab) = nSC.TabPic16(nTab)
    Set mPreview.TabPic20(nTab) = nSC.TabPic20(nTab)
    Set mPreview.TabPic24(nTab) = nSC.TabPic24(nTab)
    Set mPreview.TabPicture(nTab) = nSC.TabPicture(nTab)
    Set mPreview.TabIconFont(nTab) = CloneFont(nSC.TabIconFont(nTab))
    mPreview.TabIconCharHex(nTab) = nSC.TabIconCharHex(nTab)
    mPreview.TabIconLeftOffset(nTab) = nSC.TabIconLeftOffset(nTab)
    mPreview.TabIconTopOffset(nTab) = nSC.TabIconTopOffset(nTab)
End Sub

' Placed the way Tabs places its sample: centred against the page, then moved so that the selected
' tab is in sight. No dragging as in Tabs and Icons: here only a few tabs are needed to hover
Private Sub PlacePreview()
    mPreview.Left = (PropertyPage.ScaleWidth - mPreview.Width) / 2
    If mPreview.TabSel > -1 Then
        If (mPreview.Left + mPreview.GetTabLeft(mPreview.TabSel) + mPreview.GetTabWidth(mPreview.TabSel)) > PropertyPage.ScaleWidth Then
            mPreview.Left = PropertyPage.ScaleWidth - (mPreview.GetTabLeft(mPreview.TabSel) + mPreview.GetTabWidth(mPreview.TabSel)) - 120
        ElseIf (mPreview.Left + mPreview.GetTabLeft(mPreview.TabSel)) < 0 Then
            mPreview.Left = 120 - mPreview.GetTabLeft(mPreview.TabSel)
        End If
    End If
    mPreview.Top = PreviewTop(mPreview, picSampleContainer.ScaleHeight)
End Sub

Private Sub NewTab1_CloseButtonClick(ByVal nTab As Long, Cancel As Boolean)
    Cancel = True
End Sub

Private Function CloneFont(nOrigFont As iFont) As StdFont
    If nOrigFont Is Nothing Then Exit Function
    nOrigFont.Clone CloneFont
End Function

' Highlight mode columns

Private Sub LoadColumn(ByVal nColumn As Long, ByVal nFlags As Long)
    Dim iBackground As Long
    
    chkHLAuto(nColumn).Value = IIf(nFlags = ntHLAuto, vbChecked, vbUnchecked)
    ' Under Auto the greyed boxes show what it applies, and are left ticked when Auto is cleared
    If nFlags = ntHLAuto Then nFlags = mAutoFlags(nColumn)
    If nFlags = ntHLNone Then nFlags = 0
    iBackground = nFlags And ntHLBackgroundTypeFilter
    chkHLBackground(nColumn).Value = IIf(iBackground <> 0, vbChecked, vbUnchecked)
    chkHLBackgroundGradient(nColumn).Value = IIf((iBackground = ntHLBackgroundGradient) Or (iBackground = ntHLBackgroundDoubleGradient), vbChecked, vbUnchecked)
    chkHLBackgroundDoubleGradient(nColumn).Value = IIf(iBackground = ntHLBackgroundDoubleGradient, vbChecked, vbUnchecked)
    chkHLBackgroundLight(nColumn).Value = FlagCheck(nFlags, ntHLBackgroundLight)
    chkHLCaptionBold(nColumn).Value = FlagCheck(nFlags, ntHLCaptionBold)
    chkHLCaptionUnderlined(nColumn).Value = FlagCheck(nFlags, ntHLCaptionUnderlined)
    chkHLFlatBar(nColumn).Value = FlagCheck(nFlags, ntHLFlatBar)
    chkHLFlatBarGrip(nColumn).Value = FlagCheck(nFlags, ntHLFlatBarGrip)
    chkHLExtraHeight(nColumn).Value = FlagCheck(nFlags, ntHLExtraHeight)
    chkHLShiftCaption(nColumn).Value = FlagCheck(nFlags, ntHLShiftCaption)
    chkHLWidenTab(nColumn).Value = FlagCheck(nFlags, ntHLWidenTab)
    chkHLFlatDrawBorder(nColumn).Value = FlagCheck(nFlags, ntHLFlatDrawBorder)
    chkHLRoundBottom(nColumn).Value = FlagCheck(nFlags, ntHLRoundBottom)
    If nColumn = 0 Then chkHLFlatShapeInactive.Value = FlagCheck(nFlags, ntHLFlatShapeInactive)
    SetColumnEnabledState nColumn
End Sub

Private Function FlagCheck(ByVal nFlags As Long, ByVal nFlag As Long) As Integer
    If (nFlags And nFlag) <> 0 Then FlagCheck = vbChecked
End Function

' A box that depends on another keeps its tick while greyed, and only counts while its parent is ticked
Private Function ColumnFlags(ByVal nColumn As Long) As Long
    Dim iValue As Long
    
    If chkHLAuto(nColumn).Value = vbChecked Then
        ColumnFlags = ntHLAuto
        Exit Function
    End If
    If chkHLBackground(nColumn).Value = vbChecked Then
        If chkHLBackgroundGradient(nColumn).Value <> vbChecked Then
            iValue = ntHLBackgroundPlain
        ElseIf chkHLBackgroundDoubleGradient(nColumn).Value = vbChecked Then
            iValue = ntHLBackgroundDoubleGradient
        Else
            iValue = ntHLBackgroundGradient
        End If
        If chkHLBackgroundLight(nColumn).Value = vbChecked Then iValue = iValue Or ntHLBackgroundLight
    End If
    If chkHLCaptionBold(nColumn).Value = vbChecked Then iValue = iValue Or ntHLCaptionBold
    If chkHLCaptionUnderlined(nColumn).Value = vbChecked Then iValue = iValue Or ntHLCaptionUnderlined
    If chkHLFlatBar(nColumn).Value = vbChecked Then
        iValue = iValue Or ntHLFlatBar
        If chkHLFlatBarGrip(nColumn).Value = vbChecked Then iValue = iValue Or ntHLFlatBarGrip
    End If
    If chkHLExtraHeight(nColumn).Value = vbChecked Then iValue = iValue Or ntHLExtraHeight
    If chkHLShiftCaption(nColumn).Value = vbChecked Then iValue = iValue Or ntHLShiftCaption
    If chkHLWidenTab(nColumn).Value = vbChecked Then iValue = iValue Or ntHLWidenTab
    If chkHLFlatDrawBorder(nColumn).Value = vbChecked Then iValue = iValue Or ntHLFlatDrawBorder
    If chkHLRoundBottom(nColumn).Value = vbChecked Then iValue = iValue Or ntHLRoundBottom
    If nColumn = 0 Then
        If chkHLFlatShapeInactive.Value = vbChecked Then iValue = iValue Or ntHLFlatShapeInactive
    End If
    ' Nothing ticked and not Auto is asking for no highlight
    If iValue = ntHLAuto Then iValue = ntHLNone
    ColumnFlags = iValue
End Function

Private Sub SetColumnEnabledState(ByVal nColumn As Long)
    Dim iFree As Boolean
    Dim iBackgroundOn As Boolean
    
    iFree = (chkHLAuto(nColumn).Value <> vbChecked)
    chkHLBackground(nColumn).Enabled = iFree And HasEffect(nColumn, ntHLBackgroundPlain)
    iBackgroundOn = chkHLBackground(nColumn).Enabled And (chkHLBackground(nColumn).Value = vbChecked)
    chkHLBackgroundGradient(nColumn).Enabled = iBackgroundOn And HasEffect(nColumn, ntHLBackgroundGradient)
    chkHLBackgroundDoubleGradient(nColumn).Enabled = chkHLBackgroundGradient(nColumn).Enabled And (chkHLBackgroundGradient(nColumn).Value = vbChecked)
    chkHLBackgroundLight(nColumn).Enabled = iBackgroundOn And HasEffect(nColumn, ntHLBackgroundLight)
    chkHLCaptionBold(nColumn).Enabled = iFree And HasEffect(nColumn, ntHLCaptionBold)
    chkHLCaptionUnderlined(nColumn).Enabled = iFree And HasEffect(nColumn, ntHLCaptionUnderlined)
    chkHLFlatBar(nColumn).Enabled = iFree And HasEffect(nColumn, ntHLFlatBar)
    chkHLFlatBarGrip(nColumn).Enabled = chkHLFlatBar(nColumn).Enabled And (chkHLFlatBar(nColumn).Value = vbChecked)
    chkHLExtraHeight(nColumn).Enabled = iFree And HasEffect(nColumn, ntHLExtraHeight)
    chkHLShiftCaption(nColumn).Enabled = iFree And HasEffect(nColumn, ntHLShiftCaption)
    chkHLWidenTab(nColumn).Enabled = iFree And HasEffect(nColumn, ntHLWidenTab)
    chkHLFlatDrawBorder(nColumn).Enabled = iFree And HasEffect(nColumn, ntHLFlatDrawBorder)
    ' It rounds the highlight fill and the highlight border. Unlike the dependent boxes above, it stays in the value while greyed
    chkHLRoundBottom(nColumn).Enabled = iFree And HasEffect(nColumn, ntHLRoundBottom) And (iBackgroundOn Or (chkHLFlatDrawBorder(nColumn).Value = vbChecked))
    ' HighlightMode only. It takes the shape from the two boxes above and, like RoundBottom, stays in the value while greyed
    If nColumn = 0 Then chkHLFlatShapeInactive.Enabled = iFree And HasEffect(0, ntHLFlatShapeInactive) And ((chkHLFlatDrawBorder(0).Value = vbChecked) Or (chkHLRoundBottom(0).Value = vbChecked))
End Sub

Private Function HasEffect(ByVal nColumn As Long, ByVal nFlag As Long) As Boolean
    HasEffect = (mFlagsWithEffect(nColumn) And nFlag) <> 0
End Function

Private Sub ColumnClicked(ByVal nColumn As Long)
    SetColumnEnabledState nColumn
    If mLoading Then Exit Sub
    If nColumn = 0 Then
        mPreview.HighlightMode = ColumnFlags(0)
        If Not mUpdateingValue Then txtHighlightModeValue.Text = ColumnFlags(0)
    Else
        mPreview.HighlightModeSelectedTab = ColumnFlags(1)
        If Not mUpdateingValue Then txtHighlightModeSelectedTabValue.Text = ColumnFlags(1)
    End If
    Changed = True
End Sub

Private Sub chkHLAuto_Click(nIndex As Integer)
    If (chkHLAuto(nIndex).Value = vbChecked) And (Not mLoading) And (Not mUpdateingValue) Then
        mUpdateingValue = True
        LoadColumn nIndex, ntHLAuto
        mUpdateingValue = False
    End If
    ColumnClicked nIndex
End Sub

