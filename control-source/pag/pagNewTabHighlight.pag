    If mLoading Then Exit Sub
    mPreview.HighlightEffect = cboHighlightEffect.ItemData(cboHighlightEffect.ListIndex)
    Changed = True
End Sub

Private Sub cboHighlightEffectOut_Click()
    If mLoading Then Exit Sub
    mPreview.HighlightEffectOut = cboHighlightEffectOut.ItemData(cboHighlightEffectOut.ListIndex)
    Changed = True
End Sub

Private Sub txtHighlightModeValue_Change()
    If Not IsFlagsText(txtHighlightModeValue.Text) Then Exit Sub
    If Not mLoading Then
        mUpdateingValue = True
        LoadColumn 0, Val(txtHighlightModeValue.Text)
        mUpdateingValue = False
    End If
End Sub

Private Sub txtHighlightModeValue_LostFocus()
    txtHighlightModeValue.Text = CStr(ColumnFlags(0))
End Sub

Private Sub txtHighlightModeSelectedTabValue_Change()
    If Not IsFlagsText(txtHighlightModeSelectedTabValue.Text) Then Exit Sub
    If Not mLoading Then
        mUpdateingValue = True
        LoadColumn 1, Val(txtHighlightModeSelectedTabValue.Text)
        mUpdateingValue = False
    End If
End Sub

Private Sub txtHighlightModeSelectedTabValue_LostFocus()
    txtHighlightModeSelectedTabValue.Text = CStr(ColumnFlags(1))
End Sub

' Empty or half typed is not a value yet: Val would read it as 0, which is Auto
Private Function IsFlagsText(ByVal nText As String) As Boolean
    nText = Trim$(nText)
    If (Len(nText) = 0) Or (Len(nText) > 9) Then Exit Function
    IsFlagsText = Not (nText Like "*[!0-9]*")
End Function

' A text that is not a number yet leaves the last valid value in place
Private Sub txtHighlightTabExtraHeight_Change()
    If mLoading Then Exit Sub
    If Not IsNumeric(txtHighlightTabExtraHeight.Text) Then Exit Sub
    If CSng(txtHighlightTabExtraHeight.Text) < 0 Then Exit Sub
    mExtraHeight = CSng(txtHighlightTabExtraHeight.Text)
    SetPreviewSizes SelectedControls(0)
    Changed = True
End Sub

Private Sub txtHighlightTabCaptionShift_Change()
    If mLoading Then Exit Sub
    If Not IsNumeric(txtHighlightTabCaptionShift.Text) Then Exit Sub
    mCaptionShift = CSng(txtHighlightTabCaptionShift.Text)
    SetPreviewSizes SelectedControls(0)
    Changed = True
End Sub

' Colors

Private Function ColorPropertyName(ByVal nIndex As Long) As String
    Select Case nIndex
        Case 0: ColorPropertyName = "HighlightColor"
        Case 1: ColorPropertyName = "HighlightColorSelectedTab"
        Case 2: ColorPropertyName = "HighlightGradientColor"
        Case 3: ColorPropertyName = "HighlightGradientColorSelectedTab"
        Case 4: ColorPropertyName = "ForeColorHighlighted"
        Case 5: ColorPropertyName = "IconColorTabHighlighted"
        Case 6: ColorPropertyName = "FlatBarColorHighlighted"
        Case 7: ColorPropertyName = "FlatBarColorSelectedTab"
        Case 8: ColorPropertyName = "FlatTabBorderColorHighlighted"
        Case 9: ColorPropertyName = "FlatTabBorderColorSelectedTab"
        Case 10: ColorPropertyName = "FlatTabBorderColorInactive"
    End Select
End Function

' -1 when automatic. For the one that has no automatic state nAutomaticColor is the value itself
Private Function ColorValue(ByVal nCtl As NewTab, ByVal nIndex As Long, ByRef nAutomaticColor As Long) As Long
    Dim iName As String
    Dim iHasState As Boolean
    Dim iIsAutomatic As Boolean
    
    iName = ColorPropertyName(nIndex)
    iHasState = nCtl.ColorAutomaticState(iName, iIsAutomatic, nAutomaticColor)
    If iHasState And iIsAutomatic Then
        ColorValue = -1
    Else
        ColorValue = CLng(CallByName(nCtl, iName, VbGet))
        If Not iHasState Then nAutomaticColor = ColorValue
    End If
End Function

Private Function ColorHasAutomatic(ByVal nIndex As Long) As Boolean
    ColorHasAutomatic = (ColorPropertyName(nIndex) <> "FlatBarColorSelectedTab")
End Function

Private Function CurrentColorIndex() As Long
    CurrentColorIndex = cboColor.ItemData(cboColor.ListIndex)
End Function

Private Sub ShowCurrentColor(ByVal nUpdateText As Boolean)
    Dim iIndex As Long
    Dim iCurrent As Long
    Dim iAutomatic As Long
    Dim iSelector As New cColorSelector
    
    iIndex = CurrentColorIndex
    iCurrent = ColorValue(mPreview, iIndex, iAutomatic)
    If iCurrent = -1 Then
        picColor.BackColor = iAutomatic
        lblColorState.Caption = "(Automatic)"
    Else
        picColor.BackColor = iCurrent
        lblColorState.Caption = ""
    End If
    picColor.ToolTipText = iSelector.ColorDisplayName(iCurrent) & " - click to change"
    lblAutomaticColor.Visible = ColorHasAutomatic(iIndex)
    picAutomaticColor.Visible = ColorHasAutomatic(iIndex)
    lblColorTip.Visible = ColorHasAutomatic(iIndex)
    picAutomaticColor.BackColor = iAutomatic
    picAutomaticColor.ToolTipText = iSelector.ColorDisplayName(iAutomatic)
    If nUpdateText Then
        mSettingText = True
        If iCurrent = -1 Then
            txtColorHex.Text = ""
        Else
            txtColorHex.Text = "&H" & Hex$(iCurrent) & "&"
        End If
        mSettingText = False
    End If
End Sub

Private Sub PickCurrentColor()
    Dim iSelector As New cColorSelector
    Dim iIndex As Long
    Dim iCurrent As Long
    Dim iAutomatic As Long
    Dim iPicked As Long
    
    iIndex = CurrentColorIndex
    iCurrent = ColorValue(mPreview, iIndex, iAutomatic)
    If Not iSelector.PickColor(PropertyPage.hWnd, picColor.hWnd, iCurrent, iAutomatic, iPicked, ColorHasAutomatic(iIndex)) Then Exit Sub
    If iPicked = iCurrent Then Exit Sub
    CallByName mPreview, ColorPropertyName(iIndex), VbLet, iPicked
    Changed = True
    ShowCurrentColor True
End Sub

Private Sub cboColor_Click()
    If Not mLoading Then ShowCurrentColor True
End Sub

Private Sub picColor_Click()
    PickCurrentColor
End Sub

Private Sub picColor_KeyDown(KeyCode As Integer, Shift As Integer)
    If (KeyCode = vbKeySpace) Or (KeyCode = vbKeyF4) Then PickCurrentColor
End Sub

' Empty is automatic, where the colour has one
Private Sub txtColorHex_Change()
    Dim iIndex As Long
    Dim iValue As Long
    Dim iAutomatic As Long
    
    If mLoading Or mSettingText Then Exit Sub
    iIndex = CurrentColorIndex
    If Len(Trim$(txtColorHex.Text)) = 0 Then
        If Not ColorHasAutomatic(iIndex) Then Exit Sub
        iValue = -1
    Else
        If Not ParseHexValue(txtColorHex.Text, 8, iValue) Then Exit Sub
        If Not (((iValue And &HFF000000) = 0) Or (((iValue And &HFFFFFF00) = &H80000000) And ((iValue And &HFF&) <= &H18&))) Then Exit Sub
    End If
    If iValue = ColorValue(mPreview, iIndex, iAutomatic) Then Exit Sub
    CallByName mPreview, ColorPropertyName(iIndex), VbLet, iValue
    Changed = True
    ShowCurrentColor False
End Sub

' Hex, with or without &H and the trailing &
Private Function ParseHexValue(ByVal nText As String, ByVal nMaxDigits As Long, ByRef nValue As Long) As Boolean
    Dim iText As String
    
    iText = UCase$(Trim$(nText))
    If VBA.Left$(iText, 2) = "&H" Then iText = Mid$(iText, 3)
    If VBA.Right$(iText, 1) = "&" Then iText = VBA.Left$(iText, Len(iText) - 1)
    If (Len(iText) = 0) Or (Len(iText) > nMaxDigits) Then Exit Function
    If iText Like "*[!0-9A-F]*" Then Exit Function
    nValue = Val("&H" & iText & "&")
    ParseHexValue = True
End Function

' The list opens as wide as its longest item. picSampleContainer measures because it has the page
' font, the same as the combos
Private Sub SetComboDropWidth(nCombo As ComboBox)
    Dim c As Long
    Dim iWidth As Single
    Dim iMaxWidth As Single
    
    For c = 0 To nCombo.ListCount - 1
        iWidth = picSampleContainer.TextWidth(nCombo.List(c))
        If iWidth > iMaxWidth Then iMaxWidth = iWidth
    Next c
    ' room for the item margins and a vertical scroll bar
    iMaxWidth = mPreview.pScaleX(iMaxWidth, vbTwips, vbPixels) + mPreview.pScaleX(360, vbTwips, vbPixels)
    If iMaxWidth > mPreview.pScaleX(nCombo.Width, vbTwips, vbPixels) Then SendMessageW nCombo.hWnd, CB_SETDROPPEDWIDTH, CLng(iMaxWidth), 0
End Sub

Private Function SelectInComboByItemData(nCombo As Control, nItemData As Long) As Boolean
    Dim c As Long
    
    For c = 0 To nCombo.ListCount - 1
        If nCombo.ItemData(c) = nItemData Then
            nCombo.ListIndex = c
            SelectInComboByItemData = True
            Exit Function
        End If
    Next c
End Function
