End Sub

Private Sub chkHLFlatShapeInactive_Click()
    ColumnClicked 0
    If mLoading Or mUpdateingValue Then Exit Sub
    If (chkHLFlatShapeInactive.Value = vbChecked) And (chkHLFlatDrawBorder(0).Value = vbChecked) Then WarnIfInactiveBorderIsInvisible
End Sub

Private Sub WarnIfInactiveBorderIsInvisible()
    If RGBColor(mPreview.FlatTabBorderColorInactive) <> RGBColor(mPreview.BackColorTabs) Then Exit Sub
    MsgBox "The border of the inactive tabs has the same color as their background, so it will not be visible." & vbCrLf & vbCrLf & "Set a color for FlatTabBorderColorInactive in Colors.", vbInformation
    SelectInComboByItemData cboColor, 10
End Sub

' The automatic border is the bar colour, and some themes hide the bar by giving it the colour of
' the tab. Only equal is warned about: a border meant to be subtle is a valid choice
Private Sub WarnIfBorderIsInvisible(ByVal nColumn As Long)
    Dim iBorderColor As Long
    Dim iTabBackColor As Long
    Dim iBorderName As String
    
    iBorderName = ColorPropertyName(8 + nColumn)
    iBorderColor = CLng(CallByName(mPreview, iBorderName, VbGet))
    If (chkHLBackground(nColumn).Value = vbChecked) And chkHLBackground(nColumn).Enabled Then
        If nColumn = 0 Then iTabBackColor = mPreview.HighlightColor Else iTabBackColor = mPreview.HighlightColorSelectedTab
    Else
        If nColumn = 0 Then iTabBackColor = mPreview.BackColorTabs Else iTabBackColor = mPreview.BackColorSelectedTab
    End If
    If RGBColor(iBorderColor) <> RGBColor(iTabBackColor) Then Exit Sub
    MsgBox "The border has the same color as the background of the tab, so it will not be visible." & vbCrLf & vbCrLf & "Set a color for " & iBorderName & " in Colors.", vbInformation
    SelectInComboByItemData cboColor, 8 + nColumn
End Sub

Private Function RGBColor(ByVal nColor As Long) As Long
    If OleTranslateColor(nColor, 0, RGBColor) <> 0 Then RGBColor = nColor
End Function

Private Sub chkHLRoundBottom_Click(nIndex As Integer)
    ColumnClicked nIndex
End Sub

' Settings

Private Sub LoadSpeedCombo(nCombo As ComboBox)
    nCombo.Clear
    nCombo.AddItem ntAnimationNone & " - ntAnimationNone": nCombo.ItemData(nCombo.NewIndex) = ntAnimationNone
    nCombo.AddItem ntAnimationFaster & " - ntAnimationFaster": nCombo.ItemData(nCombo.NewIndex) = ntAnimationFaster
    nCombo.AddItem ntAnimationFast & " - ntAnimationFast": nCombo.ItemData(nCombo.NewIndex) = ntAnimationFast
    nCombo.AddItem ntAnimationMedium & " - ntAnimationMedium": nCombo.ItemData(nCombo.NewIndex) = ntAnimationMedium
    nCombo.AddItem ntAnimationSlow & " - ntAnimationSlow": nCombo.ItemData(nCombo.NewIndex) = ntAnimationSlow
    nCombo.AddItem ntAnimationSlower & " - ntAnimationSlower": nCombo.ItemData(nCombo.NewIndex) = ntAnimationSlower
End Sub

