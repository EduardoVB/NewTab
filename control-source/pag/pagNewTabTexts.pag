Attribute VB_Name = "pagNewTabTexts"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Option Explicit

Private Type RECT
    Left As Long
    Top As Long
    Right As Long
    Bottom As Long
End Type

Private Declare Function CreatePopupMenu Lib "user32" () As LongPtr
Private Declare Function AppendMenuW Lib "user32" (ByVal hMenu As LongPtr, ByVal uFlags As Long, ByVal uIDNewItem As LongPtr, ByVal lpNewItem As LongPtr) As Long
Private Declare Function TrackPopupMenuEx Lib "user32" (ByVal hMenu As LongPtr, ByVal uFlags As Long, ByVal X As Long, ByVal Y As Long, ByVal hWnd As LongPtr, ByVal lptpm As LongPtr) As Long
Private Declare Function DestroyMenu Lib "user32" (ByVal hMenu As LongPtr) As Long
Private Declare Function GetWindowRect Lib "user32" (ByVal hWnd As LongPtr, lpRect As RECT) As Long

Private Const MF_STRING As Long = &H0&
Private Const MF_GRAYED As Long = &H1&
Private Const TPM_RIGHTALIGN As Long = &H8&
Private Const TPM_NONOTIFY As Long = &H80&
Private Const TPM_RETURNCMD As Long = &H100&
Private Const ES_AUTOHSCROLL As Long = &H80&
Private Const WS_VISIBLE As Long = &H10000000
Private Const WS_EX_CLIENTEDGE As Long = &H200&

Private Const cMenuSaveDefaults As Long = 1
Private Const cMenuApplyDefaults As Long = 2
Private Const cMenuFactory As Long = 3

' VB's TextBox is ANSI; these are the Unicode ones pagNewTabTabs uses. WithEvents takes no arrays,
' so one variable per text, in the order of mNewTabTexts.TextPropertyName
Private WithEvents mUniText0 As cUniTextBox
Attribute mUniText0.VB_VarHelpID = -1
Private WithEvents mUniText1 As cUniTextBox
Attribute mUniText1.VB_VarHelpID = -1
Private WithEvents mUniText2 As cUniTextBox
Attribute mUniText2.VB_VarHelpID = -1
Private WithEvents mUniText3 As cUniTextBox
Attribute mUniText3.VB_VarHelpID = -1
Private WithEvents mUniText4 As cUniTextBox
Attribute mUniText4.VB_VarHelpID = -1
Private WithEvents mUniText5 As cUniTextBox
Attribute mUniText5.VB_VarHelpID = -1

Private mTextValue(cTextsLast) As String
' True while focus is being handed from a holder to its edit box, see cUniTextBox
Private mTextFocusSync(cTextsLast) As Boolean
Private mAppName As String
Private mLoading As Boolean

Private Sub PropertyPage_Initialize()
    Dim c As Long
    
    For c = 0 To cTextsLast
        Set picTextHolder(c).Font = PropertyPage.Font
        picTextHolder(c).ScaleMode = vbPixels
    Next c
    Set mUniText0 = New cUniTextBox
    Set mUniText1 = New cUniTextBox
    Set mUniText2 = New cUniTextBox
    Set mUniText3 = New cUniTextBox
    Set mUniText4 = New cUniTextBox
    Set mUniText5 = New cUniTextBox
    For c = 0 To cTextsLast
        UniText(c).CreateTextBox picTextHolder(c).hWnd, 0, 0, picTextHolder(c).ScaleWidth, picTextHolder(c).ScaleHeight, ES_AUTOHSCROLL Or WS_VISIBLE, WS_EX_CLIENTEDGE, ""
    Next c
End Sub

Private Sub PropertyPage_Terminate()
    Set mUniText0 = Nothing
    Set mUniText1 = Nothing
    Set mUniText2 = Nothing
    Set mUniText3 = Nothing
    Set mUniText4 = Nothing
    Set mUniText5 = Nothing
End Sub

Private Function UniText(ByVal nIndex As Long) As cUniTextBox
    Select Case nIndex
        Case 0: Set UniText = mUniText0
        Case 1: Set UniText = mUniText1
        Case 2: Set UniText = mUniText2
        Case 3: Set UniText = mUniText3
        Case 4: Set UniText = mUniText4
        Case 5: Set UniText = mUniText5
    End Select
End Function

Private Sub PropertyPage_SelectionChanged()
    Dim iSC As NewTab
    Dim c As Long
    
    If TypeName(SelectedControls(0)) <> "NewTab" Then Exit Sub
    Set iSC = SelectedControls(0)
    mAppName = TypeName(iSC)
    For c = 0 To cTextsLast
        mTextValue(c) = CStr(CallByName(iSC, TextPropertyName(c), VbGet))
    Next c
    ShowTextValues
    Changed = False
End Sub

Private Sub PropertyPage_ApplyChanges()
    Dim iSC As NewTab
    Dim c As Long
    
    Set iSC = SelectedControls(0)
    For c = 0 To cTextsLast
        If CStr(CallByName(iSC, TextPropertyName(c), VbGet)) <> mTextValue(c) Then CallByName iSC, TextPropertyName(c), VbLet, mTextValue(c)
    Next c
End Sub

Private Sub ShowTextValues()
    Dim c As Long
    
    mLoading = True
    For c = 0 To cTextsLast
        UniText(c).Text = mTextValue(c)
    Next c
    mLoading = False
End Sub

' Defaults menu

Private Sub cmdDefaults_Click()
    Dim iMenu As LongPtr
    Dim iRect As RECT
    Dim iCaption As String
    Dim iFlags As Long
    Dim iCommand As Long
    Dim iTexts() As String
    Dim c As Long
    
    iMenu = CreatePopupMenu
    If iMenu = 0 Then Exit Sub
    iCaption = "Save as defaults for new controls"
    AppendMenuW iMenu, MF_STRING, cMenuSaveDefaults, StrPtr(iCaption)
    iCaption = "Apply saved defaults"
    iFlags = MF_STRING
    If Not SavedTextsExist(mAppName) Then iFlags = iFlags Or MF_GRAYED
    AppendMenuW iMenu, iFlags, cMenuApplyDefaults, StrPtr(iCaption)
    iCaption = "Restore factory texts"
    AppendMenuW iMenu, MF_STRING, cMenuFactory, StrPtr(iCaption)
    GetWindowRect cmdDefaults.hWnd, iRect
    iCommand = TrackPopupMenuEx(iMenu, TPM_RETURNCMD Or TPM_NONOTIFY Or TPM_RIGHTALIGN, iRect.Right, iRect.Bottom, PropertyPage.hWnd, 0)
    DestroyMenu iMenu
    
    Select Case iCommand
        Case cMenuSaveDefaults
            SaveTexts mAppName, mTextValue
        Case cMenuApplyDefaults
            GetSavedTexts mAppName, iTexts
            For c = 0 To cTextsLast
                mTextValue(c) = iTexts(c)
            Next c
            ShowTextValues
            Changed = True
        Case cMenuFactory
            For c = 0 To cTextsLast
                mTextValue(c) = TextFactoryValue(c)
            Next c
            ShowTextValues
            Changed = True
    End Select
End Sub

' Edit boxes

Private Sub TextChanged(ByVal nIndex As Long)
    If mLoading Then Exit Sub
    mTextValue(nIndex) = UniText(nIndex).Text
    Changed = True
End Sub

Private Sub TextGotFocus(ByVal nIndex As Long)
    ' a click on the edit box itself: route it through the holder so tabbing stays in step
    If Not mTextFocusSync(nIndex) Then picTextHolder(nIndex).SetFocus
End Sub

Private Sub TextLostFocus(ByVal nIndex As Long)
    mTextFocusSync(nIndex) = False
End Sub

Private Sub picTextHolder_GotFocus(nIndex As Integer)
    If Not mTextFocusSync(nIndex) Then
        mTextFocusSync(nIndex) = True
        UniText(nIndex).SetFocus
    End If
End Sub

Private Sub mUniText0_Change()
    TextChanged 0
End Sub

Private Sub mUniText0_GotFocus()
    TextGotFocus 0
End Sub

Private Sub mUniText0_LostFocus()
    TextLostFocus 0
End Sub

Private Sub mUniText1_Change()
    TextChanged 1
End Sub

Private Sub mUniText1_GotFocus()
    TextGotFocus 1
End Sub

Private Sub mUniText1_LostFocus()
    TextLostFocus 1
End Sub

Private Sub mUniText2_Change()
    TextChanged 2
End Sub

Private Sub mUniText2_GotFocus()
    TextGotFocus 2
End Sub

Private Sub mUniText2_LostFocus()
    TextLostFocus 2
End Sub

Private Sub mUniText3_Change()
    TextChanged 3
End Sub

Private Sub mUniText3_GotFocus()
    TextGotFocus 3
End Sub

Private Sub mUniText3_LostFocus()
    TextLostFocus 3
End Sub

Private Sub mUniText4_Change()
    TextChanged 4
End Sub

Private Sub mUniText4_GotFocus()
    TextGotFocus 4
End Sub

Private Sub mUniText4_LostFocus()
    TextLostFocus 4
End Sub

Private Sub mUniText5_Change()
    TextChanged 5
End Sub

Private Sub mUniText5_GotFocus()
    TextGotFocus 5
End Sub

Private Sub mUniText5_LostFocus()
    TextLostFocus 5
End Sub
