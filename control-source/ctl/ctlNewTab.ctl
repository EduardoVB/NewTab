End Property


Public Property Get HighlightTabExtraHeight() As Single
Attribute HighlightTabExtraHeight.VB_Description = "Returns/sets a value that determines the extra height that a tab will have when it is highlighted. This value is in units of the container."
Attribute HighlightTabExtraHeight.VB_ProcData.VB_Invoke_Property = ";Highlight"
    HighlightTabExtraHeight = FixRoundingError(ToContainerSizeY(mHighlightTabExtraHeight, vbHimetric))
End Property

Public Property Let HighlightTabExtraHeight(ByVal nValue As Single)
    Dim iValue As Single
    
    iValue = FromContainerSizeY(nValue, vbHimetric)
    If iValue < 0 Then
        RaiseError 380, TypeName(Me) ' invalid property value
        Exit Property
    End If
    If iValue > mTabHeight Then
        iValue = mTabHeight 'limit
    End If
    If Round(iValue * 10000) <> Round(mHighlightTabExtraHeight * 10000) Then
        mHighlightTabExtraHeight = iValue
        SetPropertyChanged "HighlightTabExtraHeight"
        DrawDelayed
    End If
End Property


Public Property Get HighlightTabCaptionShift() As Single
Attribute HighlightTabCaptionShift.VB_Description = "Returns/sets how far the contents of a tab move towards the outer edge of the strip when it is highlighted. It does nothing unless the highlight mode carries the ntHLShiftCaption flag. This value is in units of the container."
Attribute HighlightTabCaptionShift.VB_ProcData.VB_Invoke_Property = ";Highlight"
    HighlightTabCaptionShift = FixRoundingError(ToContainerSizeY(mHighlightTabCaptionShift, vbHimetric))
End Property

Public Property Let HighlightTabCaptionShift(ByVal nValue As Single)
    Dim iValue As Single
    
    iValue = FromContainerSizeY(nValue, vbHimetric)
    ' A negative value is legal here, unlike in every other size property of this control, and it is
    ' the point rather than an oversight: the sign is the direction.
    If Round(iValue * 10000) <> Round(mHighlightTabCaptionShift * 10000) Then
        mHighlightTabCaptionShift = iValue
        SetPropertyChanged "HighlightTabCaptionShift"
        DrawDelayed
    End If
End Property


Public Property Get HighlightEffect() As NTAnimationSpeedConstants
Attribute HighlightEffect.VB_Description = "Returns/sets the speed of the progressive effect tabs display when they are highlighted due to hovering over them, or ntAnimationNone for no effect."
Attribute HighlightEffect.VB_ProcData.VB_Invoke_Property = ";Highlight"
    HighlightEffect = mHighlightEffect
End Property

' Was a Boolean until the animation engine got a speed. The type changed rather than a
' second property being added, against keeping the flag and adding HighlightEffectSpeed:
' two properties would have carried a redundant state - effect on, speed none - and the
' shape here now matches TabTransition, which has always named what animates and left the
' speed to the enum. Forms saved by an older build are migrated in ReadProperties
Public Property Let HighlightEffect(ByVal nValue As NTAnimationSpeedConstants)
    If nValue <> mHighlightEffect Then
        If (nValue < ntAnimationNone) Or (nValue > ntAnimationSlower) Then
            RaiseError 380, TypeName(Me) ' invalid property value
            Exit Property
        End If
        mHighlightEffect = nValue
        SetPropertyChanged "HighlightEffect"
    End If
End Property


Public Property Get HighlightEffectOut() As NTAnimationSpeedConstants
Attribute HighlightEffectOut.VB_Description = "Returns/sets the speed at which the highlight fades away when the mouse leaves a tab, or ntAnimationNone for it to disappear at once."
Attribute HighlightEffectOut.VB_ProcData.VB_Invoke_Property = ";Highlight"
    HighlightEffectOut = mHighlightEffectOut
End Property

' Its own property and not the same one as HighlightEffect, because a fade that is right on
' the way in often feels slow on the way out. It defaults to ntAnimationNone, which is what
' the control has always done - the highlight simply stops being drawn
Public Property Let HighlightEffectOut(ByVal nValue As NTAnimationSpeedConstants)
    If nValue <> mHighlightEffectOut Then
        If (nValue < ntAnimationNone) Or (nValue > ntAnimationSlower) Then
            RaiseError 380, TypeName(Me) ' invalid property value
            Exit Property
        End If
        mHighlightEffectOut = nValue
        SetPropertyChanged "HighlightEffectOut"
    End If
End Property


Public Property Get VisualStyles() As Boolean
Attribute VisualStyles.VB_Description = "Returns/sets a value that determines whether the appearance of the control will use Windows visual styles."
Attribute VisualStyles.VB_ProcData.VB_Invoke_Property = ";Appearance"
Attribute VisualStyles.VB_MemberFlags = "40"
    VisualStyles = mVisualStyles
End Property

Public Property Let VisualStyles(ByVal nValue As Boolean)
    Dim iWv As Boolean
    Dim iSavedAutomatic As Boolean
    Dim iSavedFromAmbient As Boolean
    
    If nValue <> mVisualStyles Then
        If nValue Then
            ' The two flags belong to the SAVED colours, not to the vbButtonFace that is about to
            ' take their place, so they are put back after the two assignments below.
            iSavedAutomatic = mBackColorSelectedTab_IsAutomatic
            iSavedFromAmbient = mBackColorTabsIsFromAmbient
            mBackColorTabs_SavedWhileVisualStyles = mBackColorTabs
            mBackColorSelectedTab_SavedWhileVisualStyles = mBackColorSelectedTab
            BackColorTabs = vbButtonFace
            BackColorSelectedTab = vbButtonFace
            mBackColorTabsIsFromAmbient = iSavedFromAmbient
            mBackColorSelectedTab_IsAutomatic = iSavedAutomatic
            mBackColorTabsSavingWhileVisualStyles = True
        Else
            If mBackColorTabsSavingWhileVisualStyles Then
                mBackColorTabsSavingWhileVisualStyles = False
                ' -1 and not the saved number whenever the flag says so: -1 is the marker both
                ' setters read as "from the container" and as "automatic", and coming back in by the
                ' saved colour would restore the same value with the attribute off.
                If mBackColorTabsIsFromAmbient Then
                    BackColorTabs = -1
                Else
                    BackColorTabs = mBackColorTabs_SavedWhileVisualStyles
                End If
                If mBackColorSelectedTab_IsAutomatic Then
                    ' After BackColorTabs, never before: the derivation reads it.
                    BackColorSelectedTab = -1
                Else
                    BackColorSelectedTab = mBackColorSelectedTab_SavedWhileVisualStyles
                End If
            End If
        End If
        mVisualStyles = nValue
        SetPropertyChanged "VisualStyles"
        ' The obsolete property keeps working and now also moves the one that replaced it, so a
        ' developer still calling it ends up with a TabAppearance that says the same thing and that
        ' survives a save.
        If mVisualStyles Then
            If Not ((mTabAppearance = ntTAAuto) And (mStyle = ntStyleWindows)) Then TabAppearance = ntTAWindows
        ElseIf mTabAppearance = ntTAWindows Then
            TabAppearance = ntTAAuto
        End If
        mSetAutoTabHeightPending = True
        mSubclassControlsPaintingPending = True
        mRepaintSubclassedControls = True
        iWv = IsWindowVisible(mUserControlHwnd) <> 0
        If iWv Then SendMessage mUserControlHwnd, WM_SETREDRAW, False, 0&
        Draw
        If iWv Then SendMessage mUserControlHwnd, WM_SETREDRAW, True, 0&
        If iWv Then RedrawWindow mUserControlHwnd, ByVal 0&, 0&, RDW_INVALIDATE Or RDW_ALLCHILDREN
    End If
End Property


Public Property Get BackColorTabs() As OLE_COLOR
Attribute BackColorTabs.VB_Description = "Returns/sets the background color of the tabs."
Attribute BackColorTabs.VB_ProcData.VB_Invoke_Property = ";Colors"
    If mBackColorTabsSavingWhileVisualStyles Then
        BackColorTabs = mBackColorTabs_SavedWhileVisualStyles
    Else
        BackColorTabs = mBackColorTabs
    End If
End Property

Public Property Let BackColorTabs(ByVal nValue As OLE_COLOR)
    Dim iWv As Boolean
    Dim iAutomatic As Long
    Dim iFromAmbient As Boolean
    
    ' See Let BackColor for both halves of this: why an assignment clears the hook
    ' instead of comparing, and why -1 is the way back onto it
    iFromAmbient = mBackColorTabsIsFromAmbient
    If nValue = -1 Then
        iFromAmbient = True
        nValue = Ambient.BackColor
    ElseIf Not mSettingColorFromAmbient Then
        iFromAmbient = False
    End If
    If (nValue <> IIf(mBackColorTabsSavingWhileVisualStyles, mBackColorTabs_SavedWhileVisualStyles, mBackColorTabs)) Or (iFromAmbient <> mBackColorTabsIsFromAmbient) Then
        If Not IsValidOLE_COLOR(nValue) Then RaiseError 380, TypeName(Me): Exit Property
        mBackColorTabsIsFromAmbient = iFromAmbient
        If mBackColorTabsSavingWhileVisualStyles Then
            mBackColorTabs_SavedWhileVisualStyles = nValue
        Else
            mBackColorTabs = nValue
            SetPropertyChanged "BackColorTabs"
            SetColors
            iWv = IsWindowVisible(mUserControlHwnd) <> 0
            If iWv Then SendMessage mUserControlHwnd, WM_SETREDRAW, False, 0&
            ' What travels here is the derivation, not the color of the tabs.
            iAutomatic = GetAutomaticBackColorSelectedTab
            ' The half that used to open this guard, comparing the selected tab against the colour
            ' the tabs had before, is gone.
            If mBackColorSelectedTab_IsAutomatic And (mBackColorSelectedTab <> iAutomatic) And (mBackStyle = ntOpaque) Then
                mSettingBackColorSelectedTabFromBackColorTabs = True
                BackColorSelectedTab = iAutomatic
                mSettingBackColorSelectedTabFromBackColorTabs = False
            Else
                Draw
            End If
            If iWv Then SendMessage mUserControlHwnd, WM_SETREDRAW, True, 0&
            If iWv Then RedrawWindow mUserControlHwnd, ByVal 0&, 0&, RDW_INVALIDATE Or RDW_ALLCHILDREN
        End If
    End If
End Property


Public Property Get BackColorSelectedTab() As OLE_COLOR
Attribute BackColorSelectedTab.VB_Description = "Returns/sets the color of the active tab including the tab body."
Attribute BackColorSelectedTab.VB_ProcData.VB_Invoke_Property = ";Colors"
    If mBackColorTabsSavingWhileVisualStyles Then
        BackColorSelectedTab = mBackColorSelectedTab_SavedWhileVisualStyles
    Else
        BackColorSelectedTab = mBackColorSelectedTab
    End If
End Property

Public Property Let BackColorSelectedTab(ByVal nValue As OLE_COLOR)
    Dim iAutomatic As Boolean
    Dim iPrev As Long
    Dim iWv As Boolean
    
    ' Tested before the validation: IsValidOLE_COLOR rejects -1, the automatic marker
    iAutomatic = (nValue = -1) Or mSettingBackColorSelectedTabFromBackColorTabs
    If iAutomatic Then
        nValue = GetAutomaticBackColorSelectedTab
    End If
    If (nValue <> IIf(mBackColorTabsSavingWhileVisualStyles, mBackColorSelectedTab_SavedWhileVisualStyles, mBackColorSelectedTab)) Or (iAutomatic <> mBackColorSelectedTab_IsAutomatic) Then
        If Not IsValidOLE_COLOR(nValue) Then RaiseError 380, TypeName(Me): Exit Property
        mBackColorSelectedTab_IsAutomatic = iAutomatic
        If mBackColorTabsSavingWhileVisualStyles Then
            mBackColorSelectedTab_SavedWhileVisualStyles = nValue
        Else
            If Enabled Or Not mShowDisabledState Then
                iPrev = mBackColorSelectedTab
            Else
                iPrev = mBackColorSelectedTabDisabled
            End If
            mBackColorSelectedTab = nValue
            SetPropertyChanged "BackColorSelectedTab"
            SetColors
            iWv = IsWindowVisible(mUserControlHwnd) <> 0
            If iWv Then SendMessage mUserControlHwnd, WM_SETREDRAW, False, 0&
            If mChangeControlsBackColor Then
                ' iPrev is captured before mBackColorSelectedTab changes, so it is worth
                ' more than the tracker default here
                SetControlsProperBackColor iPrev
                If mChangeControlsForeColor Then
                    SetControlsProperForeColor
                End If
            End If
            mSubclassControlsPaintingPending = True
            mRepaintSubclassedControls = True
            mBodyReset = True
            SubclassControlsPainting
            Draw
            If iWv Then SendMessage mUserControlHwnd, WM_SETREDRAW, True, 0&
            If iWv Then RedrawWindow mUserControlHwnd, ByVal 0&, 0&, RDW_INVALIDATE Or RDW_ALLCHILDREN
        End If
    End If
End Property


