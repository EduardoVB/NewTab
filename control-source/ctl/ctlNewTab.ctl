    Set mCloseButtonUserFont = nValue
    mCloseButtonUserFontIsSet = Not (nValue Is Nothing)
    mCloseButtonUserFontName = ""
    If mCloseButtonUserFontIsSet Then mCloseButtonUserFontName = nValue.Name
    SetPropertyChanged "CloseButtonFont"
    GlyphFontsChanged
End Property

