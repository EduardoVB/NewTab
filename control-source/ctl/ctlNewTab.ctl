    If nValue <> mTabsPerRow Then
        mTabsPerRow = nValue
        SetPropertyChanged "TabsPerRow"
        DrawDelayed
    End If
End Property


' Returns/sets the number of tabs.
Public Property Get Tabs() As Long
Attribute Tabs.VB_Description = "Returns/sets the number of tabs. At run time it can be 0."
Attribute Tabs.VB_ProcData.VB_Invoke_Property = ";Tabs"
    Tabs = TabsWithoutNewTabButton
End Property

Public Property Let Tabs(ByVal nValue As Long)
    Dim iButton As Long
    Dim iOffender As Long
    
    ' The count the developer sets is his own tabs, without the new tab button, the same count
    ' Property Get Tabs returns.
    iButton = -1
    If TabIsNewTabButton(mTabs - 1) Then iButton = mTabs - 1
    If iButton = -1 Then
        SetTabCount nValue
        Exit Property
    End If
    
    If (nValue < MinimumTabCount) Or (nValue > 1000) Then
        RaiseError 380, TypeName(Me) ' invalid property value
        Exit Property
    End If
    If Not TabCountChangeAllowed Then Exit Property
    If nValue = (mTabs - 1) Then Exit Property
    
    If nValue > (mTabs - 1) Then
        SetTabCount nValue + 1 ' it puts the button back at the end by itself
    Else
        ' checked before the button moves, and not left to SetTabCount: a shrink refused
        ' halfway would leave the button somewhere in the middle and break the invariant
        ' for good, which is worse than the refusal itself
        iOffender = FirstTabWithControls(nValue, iButton - 1)
        If iOffender > -1 Then
            RaiseError_CantRemoveTabsWithControls iOffender
            Exit Property
        End If
        MoveTabInternal iButton, nValue ' park it at the index that is about to be the last
        SetTabCount nValue + 1
    End If
End Property

Private Sub SetTabCount(ByVal nValue As Long)
    Dim c As Long
    Dim iButton As Long
    Dim iGrowing As Boolean
    Dim iCaptionShift As Long
    Dim iNextOriginalIndex As Long
    
    If (nValue < MinimumTabCount) Or (nValue > 1000) Then
        RaiseError 380, TypeName(Me) ' invalid property value
        Exit Sub
    ElseIf Not TabCountChangeAllowed Then
        Exit Sub
    End If
    
    If nValue <> mTabs Then
        DragSettleCancel
        ' new tabs are appended, so they land after the new tab button and it stops being the last
        ' one.
        iGrowing = (nValue > mTabs)
        iButton = -1
        If TabIsNewTabButton(mTabs - 1) Then iButton = mTabs - 1
        SetPropertyChanged "Tabs"
        ' mAccessKeys is a positional string, one character per tab, and UserControl_AccessKeyPress
        ' turns the position of the character into a tab index.
        mAccessKeysSet = False
        mMouseIsOverIcon = False
        mMouseIsOverIcon_Tab = -1
        mMouseIsOverCloseButton_Tab = -1
        If mTabUnderMouse > -1 Then
            tmrTabMouseLeave.Enabled = False
            RaiseEvent_TabMouseLeave (mTabUnderMouse)
        End If
        mTabUnderMouse = -1
        For c = 0 To mTabs - 1
            mTabData(c).Hovered = False
        Next
        If tmrHighlightEffect.Enabled And (Not ButtonHoverAnimRunning) Then
            tmrHighlightEffect.Enabled = False
        End If
        ' No colour to put back: the fade no longer writes over mGlowColor, which stays as
        ' SetColors resolved it. Only the tabs the two slots belonged to have to be forgotten
        FinishHoverFadeOut
        mHoverAnimTab = -1
        If mTabs > nValue Then
            For c = nValue To mTabs - 1
                If mTabData(c).Controls.Count > 0 Then
                    RaiseError_CantRemoveTabsWithControls c
                    Exit Sub
                ElseIf Not mTabData(c).IconFont Is Nothing Then
                    mTabIconFontsEventsHandler.RemoveFont mTabData(c).IconFont, c
                End If
            Next c
        End If
        If UBound(mTabData) = -1 Then
            ReDim mTabData(-1 To nValue - 1)
        Else
            ReDim Preserve mTabData(-1 To nValue - 1)
            If mTabs < nValue Then
                ' one past the highest OriginalIndex in use, and not the position c.
                iNextOriginalIndex = -1
                For c = 0 To mTabs - 1
                    If mTabData(c).OriginalIndex > iNextOriginalIndex Then iNextOriginalIndex = mTabData(c).OriginalIndex
                Next
                For c = mTabs To nValue - 1
                    iNextOriginalIndex = iNextOriginalIndex + 1
                    mTabData(c).OriginalIndex = iNextOriginalIndex
                Next
            End If
        End If
        If mTabs < nValue Then
            ' the caption is numbered with the index the tab ends up at, which is one less than
            ' the one it is created at when the button is about to be moved past it: the button
            ' is at the end, so every appended tab shifts down by one when it goes back there
            iCaptionShift = 0
            If iButton > -1 Then iCaptionShift = 1
            For c = mTabs To nValue - 1
                Set mTabData(c).Controls = New Collection
                mTabData(c).Enabled = True
                mTabData(c).Visible = True
                mTabData(c).Caption = "Tab " & CStr(c - iCaptionShift)
                mTabData(c).CloseButton = ntYNAuto
                mTabData(c).CloseButtonEnabled = True
                mTabData(c).Movable = True
            Next
        End If
        mTabs = nValue
        If iGrowing And (iButton > -1) Then MoveTabInternal iButton, mTabs - 1
        If mTab > (mTabs - 1) Then
            mTab = (mTabs - 1)
        End If
        If TabIsNewTabButton(mTab) And (mTabs > 1) Then
            ' mTab must never name the new tab button.
            mTab = mTabs - 2
            mTabData(mTab).Selected = True
        End If
        If TabIsNewTabButton(mTab) Or ((mTab > -1) And (Not RealTabVisible)) Then
            mTabData(mTab).Selected = False
            mTab = -1
        End If
        ' a tab added while none was visible takes the selection; TDI selects its new tabs itself
        If (mTab = -1) And iGrowing And (Not mTDIChangingTabCount) Then
            For c = 0 To mTabs - 1
                If mTabData(c).Visible And Not TabIsNewTabButton(c) Then
                    TabSel = c
                    Exit For
                End If
            Next
        End If
        ' Added tabs arrive with an empty cache, and after a shrink and a growth the records
        ' are not the ones that were here
        ApplyTabChainColors
        DrawDelayed
    End If
End Sub


' Returns the number of rows of tabs.
Public Property Get Rows() As Long
Attribute Rows.VB_Description = "Returns the number of rows of tabs."
Attribute Rows.VB_ProcData.VB_Invoke_Property = ";Data"
Attribute Rows.VB_UserMemId = 0
Attribute Rows.VB_MemberFlags = "400"
    Rows = mRows
End Property


' included for backward compatibility
Public Property Get TabSel() As Long
Attribute TabSel.VB_Description = "Returns/sets the active tab number."
Attribute TabSel.VB_ProcData.VB_Invoke_Property = ";Tabs"
Attribute TabSel.VB_MemberFlags = "40"
    TabSel = mTab
End Property

Public Property Let TabSel(ByVal nValue As Long)
    Dim iPrev As Long
    Dim iPrev2 As Long
    Dim iCancel As Boolean
    Dim iWv As Boolean
    Dim c As Long
    Dim iDo As Boolean
    Dim iSetColorsRan As Boolean
    
    If (nValue < 0) Or (nValue >= mTabs) Then
        RaiseError 380, TypeName(Me) ' invalid property value
        Exit Property
    End If
    If Not mTabData(nValue).Visible Then
        RaiseError 380, TypeName(Me), "Invalid property value. Non-visible tabs can't be set as active/current."
        Exit Property
    End If
    
    If (nValue <> mTab) Or mReSelTab Then
        iDo = True
        If TabIsNewTabButton(nValue) Then
            If Not (mTDIClosingATab Or mTDIAddingNewTab) Then
                If mAmbientUserMode Then NewTabButtonClicked
                ' the button is a command and is never selected, so this leaves.
                Exit Property
            End If
        End If
        If iDo Then
            RaiseEvent BeforeClick(mTab, nValue, iCancel)
            If (nValue < 0) Or (nValue > (mTabs - 1)) Then nValue = mTab
        End If
        ' Or mReSelTab: a reselection of the current tab still has to run SetVisibleControls and set
        ' the Selected flag
        If (Not iCancel) And ((nValue <> mTab) Or mReSelTab) Then
            mChangingSelectedTab = True
            If Not mMovingATab Then
                If IsWindowVisible(mUserControlHwnd) <> 0 Then
                    If (mTabTransition <> ntAnimationNone) And mAmbientUserMode And SystemAnimationsOn Then ShowPicCover
                End If
            End If
            iPrev = mTab
            mTab = nValue
            If (mTab > -1) And (mTab < mTabs) Then mNoTabVisible = False
            SetPropertyChanged "TabSel"
            If (iPrev >= 0) And (iPrev <= UBound(mTabData)) Then
                mTabData(iPrev).Selected = False
            End If
            If (mTab > -1) And (mTab < mTabs) Then
                mTabData(mTab).Selected = True
            End If
            iPrev2 = iPrev
            RaiseEvent Click(iPrev)
            iWv = IsWindowVisible(mUserControlHwnd) <> 0
            If iWv Then SendMessage mUserControlHwnd, WM_SETREDRAW, False, 0&
            SetVisibleControls iPrev2
            If iWv Then SendMessage mUserControlHwnd, WM_SETREDRAW, True, 0&
            mSubclassControlsPaintingPending = True
            If tmrHighlightEffect.Enabled And (Not ButtonHoverAnimRunning) Then
                tmrHighlightEffect.Enabled = False
            End If
            FinishHoverFadeOut
            mHoverAnimTab = -1
            If (Not IsEmpty(mTabData(mTab).CustomColors.BackColorSelectedTab)) Or (Not IsEmpty(mTabData(mTab).CustomColors.HighlightColorSelectedTab)) Or (Not IsEmpty(mTabData(iPrev2).CustomColors.BackColorSelectedTab)) Or (Not IsEmpty(mTabData(iPrev2).CustomColors.HighlightColorSelectedTab)) Or (Not IsEmpty(mTabData(mTab).CustomColors.HighlightGradientColorSelectedTab)) Or (Not IsEmpty(mTabData(iPrev2).CustomColors.HighlightGradientColorSelectedTab)) Then
                SetColors
                iSetColorsRan = True
            ElseIf mAppearanceIsFlat And ((Not IsEmpty(mTabData(mTab).CustomColors.FlatBarColorSelectedTab)) Or (Not IsEmpty(mTabData(iPrev2).CustomColors.FlatBarColorSelectedTab))) Then
                SetColors
                iSetColorsRan = True
            End If
            ' A comparison of resolved colours and no longer a pair of IsEmpty.
            If iSetColorsRan Or (mTabData(mTab).CustomColors.ResolvedChainColor(ntChainForeColorSelectedTab) <> mTabData(iPrev2).CustomColors.ResolvedChainColor(ntChainForeColorSelectedTab)) Then
                SetControlsProperForeColor
            End If
            ' the outer test is about whether anything has to be redelivered, not about
            ' which color: leaving or entering a tab with a custom color is the only tab
            ' change that moves the children. The gate was missing here
            If mChangeControlsBackColor Then
                If (Not IsEmpty(mTabData(mTab).CustomColors.BackColorSelectedTab)) Or (Not IsEmpty(mTabData(iPrev2).CustomColors.BackColorSelectedTab)) Then
                    SetControlsProperBackColor
                End If
            End If
            Draw
            If iWv Then RedrawWindow mUserControlHwnd, ByVal 0&, 0&, RDW_INVALIDATE Or RDW_ALLCHILDREN
            mChangingSelectedTab = False
            RaiseEvent TabChange
            
            If mTabUnderMouse > -1 Then
                tmrTabMouseLeave.Enabled = False
                RaiseEvent_TabMouseLeave (mTabUnderMouse)
            End If
            mTabUnderMouse = -1
            For c = 0 To mTabs - 1
                mTabData(c).Hovered = False
            Next
        End If
    End If
End Property


' Returns/sets a value that determines which side of the control the tabs will appear.
Public Property Get TabOrientation() As NTTabOrientationConstants
Attribute TabOrientation.VB_Description = "Returns/sets a value that determines on which side of the control the tabs will appear."
Attribute TabOrientation.VB_ProcData.VB_Invoke_Property = ";Strip"
    TabOrientation = mTabOrientation
End Property

Public Property Let TabOrientation(ByVal nValue As NTTabOrientationConstants)
    Dim iBool As Boolean
    
    If nValue < 0 Or nValue > 11 Then
        RaiseError 380, TypeName(Me) ' invalid property value
        Exit Property
    End If
    If nValue <> mTabOrientation Then
        iBool = (nValue = ssTabOrientationBottom) Or (nValue = ntTabOrientationBottomRight)
        If mOrientationIsBottom <> iBool Then
            mOrientationIsBottom = iBool
            SetPropertyChanged "FlatRoundnessBottom"
            SetPropertyChanged "FlatRoundnessTop"
        End If
        mTabOrientation = nValue
        
        mSetAutoTabHeightPending = True
        SetPropertyChanged "TabOrientation"
        ResetCachedThemeImages
        DrawDelayed
    End If
End Property


Public Property Get IconAlignment() As NTIconAlignmentConstants
Attribute IconAlignment.VB_Description = "Returns/sets the alignment of the icon (or picture) with respect of the tab caption."
Attribute IconAlignment.VB_ProcData.VB_Invoke_Property = ";Icon"
    IconAlignment = mIconAlignment
End Property

' The TDI modes used to refuse this property outright. That came from the mechanism that no
' longer exists: the icon font was TDI-only and always went at the start, the far end of the
' tab belonged to the 'x' drawn as another icon font glyph, and the home tab could not have
' its icon anywhere else. None of that is true now - the close button is its own subsystem
' with its own reserved slot, and any tab can carry an icon font glyph in any of the nine
' alignments - so the ban only kept the developer from a setting that works
Public Property Let IconAlignment(ByVal nValue As NTIconAlignmentConstants)
    If nValue < ntIconAlignBeforeCaption Or nValue > ntIconAlignAtBottom Then
        RaiseError 380, TypeName(Me) ' invalid property value
        Exit Property
    End If
    If nValue <> mIconAlignment Then
        mIconAlignment = nValue
        mSetAutoTabHeightPending = True
        SetPropertyChanged "IconAlignment"
        DrawDelayed
    End If
End Property


