Public Property Let TabTransition(ByVal nValue As NTAnimationSpeedConstants)
    If nValue <> mTabTransition Then
        If (nValue < ntAnimationNone) Or (nValue > ntAnimationSlower) Then
            RaiseError 380, TypeName(Me) ' invalid property value
            Exit Property
        End If
        mTabTransition = nValue
        SetPropertyChanged "TabTransition"
    End If
End Property


