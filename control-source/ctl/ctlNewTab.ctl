Public Property Get IconColor() As OLE_COLOR
Attribute IconColor.VB_Description = "Returns/sets the color of the icon."
Attribute IconColor.VB_ProcData.VB_Invoke_Property = ";Colors"
    IconColor = mIconColor
End Property

Public Property Let IconColor(ByVal nValue As OLE_COLOR)
    Dim iAutomatic As Boolean
    
    ' The four icon slots, the 'x' and the '+' hang from here, but nothing is pushed into them
    ' from this procedure any more: ApplyChainColors walks the tree, and the invalidation of
    ' the TDI form icons goes with it
    
    iAutomatic = (nValue = -1)
    If Not iAutomatic Then
        If Not IsValidOLE_COLOR(nValue) Then RaiseError 380, TypeName(Me): Exit Property
    End If
    If (iAutomatic <> mIconColor_IsAutomatic) Or ((Not iAutomatic) And (nValue <> mIconColor)) Then
        mIconColor_IsAutomatic = iAutomatic
        SetPropertyChanged "IconColor"
        ApplyChainColors ntChainIconColor, nValue
    End If
End Property


