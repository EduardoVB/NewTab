' Only applies to the "Horizontal" TabOrientations (LeftHorizontal, RightHorizontal,
' LeftBottomHorizontal, RightBottomHorizontal), where captions are drawn horizontally even though the
' tabs themselves are stacked along a vertical strip.
Public Enum NTTabHeightStyleForHorizontalConstants
    ntTHFill = 0              ' tabs stretch to fill all available strip space
    ntTHTabCaptionHeight = 1  ' each tab gets just the height its own caption (wrapped if needed) + icon needs
    ntTHMaxCaptionHeight = 2  ' all tabs of a column equal: the height of the tallest tab in that column
    ntTHFixed = 3             ' respects the TabHeight property (global)
    ntTHStretchToFill = 4     ' own caption heights, columns balanced and every column stretched to the strip
End Enum

