    Dim iAutomatic As Boolean
    
    ' No redraw, same reason as ForeColorHighlighted, and the difference with
    ' FlatTabBorderColorSelectedTab is not an oversight: that border is on screen the moment
    ' it changes, this one only appears under the pointer
    
    iAutomatic = (nValue = -1)
    If Not iAutomatic Then
        If Not IsValidOLE_COLOR(nValue) Then RaiseError 380, TypeName(Me): Exit Property
    End If
    If (iAutomatic <> mFlatTabBorderColorHighlighted_IsAutomatic) Or ((Not iAutomatic) And (nValue <> mFlatTabBorderColorHighlighted)) Then
        mFlatTabBorderColorHighlighted_IsAutomatic = iAutomatic
        SetPropertyChanged "FlatTabBorderColorHighlighted"
        ApplyChainColors ntChainFlatTabBorderColorHighlighted, nValue
    End If
End Property


