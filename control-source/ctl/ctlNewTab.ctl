' Determines whether text in the caption of each tab will wrap to the next line if it is too long.
Public Property Get WordWrap() As Boolean
Attribute WordWrap.VB_Description = "Determines whether text in the caption of each tab will wrap to the next line if it is too long."
Attribute WordWrap.VB_ProcData.VB_Invoke_Property = ";Strip"
    WordWrap = mWordWrap
End Property

Public Property Let WordWrap(ByVal nValue As Boolean)
    If nValue <> mWordWrap Then
        mWordWrap = nValue
        SetPropertyChanged "WordWrap"
        mSetAutoTabHeightPending = True
        DrawDelayed
    End If
End Property


' Returns/sets the style of the tabs.
Public Property Get Style() As NTStyleConstants
Attribute Style.VB_Description = "Returns/sets the style of the tabs."
Attribute Style.VB_ProcData.VB_Invoke_Property = ";Appearance"
    Style = mStyle
End Property

Public Property Let Style(ByVal nValue As NTStyleConstants)
    Dim iStyle As NTStyleConstants
    Dim iPrevBackColor As Long
    
    If nValue < ssStyleTabbedDialog Or nValue > ntStyleWindows Then
        RaiseError 380, TypeName(Me) ' invalid property value
        Exit Property
    End If
    iStyle = nValue
    If iStyle <> mStyle Then
        mStyle = iStyle
        SetPropertyChanged "Style"
        ' Both of this property's writes to VisualStyles are now guarded by TabAppearance, and the
        ' pair is equivalent to the single expression Let TabAppearance uses: True when the
        ' appearance is ntTAWindows, or when it is ntTAAuto and the style is Windows.
        If (mStyle <> ntStyleWindows) And (mTabAppearance <> ntTAWindows) Then VisualStyles = False
        ' The automatic BackColorSelectedTab depends on the style (Flat derives a shade of the tabs
        ' background), so it is worked out again
        If mBackColorSelectedTab_IsAutomatic Then
            iPrevBackColor = BackColorSelectedTabEffective
            mBackColorSelectedTab = GetAutomaticBackColorSelectedTab
            SetColors
            If mChangeControlsBackColor Then
                SetControlsProperBackColor iPrevBackColor
                If mChangeControlsForeColor Then SetControlsProperForeColor
            End If
        End If
        If mTabAppearance <> ntTAAuto Then
            mAppearanceIsFlat = (mTabAppearance = ntTAFlat)
        Else
            mAppearanceIsFlat = mStyle = ntStyleFlat
        End If
        SetHighlightMode
        mSetAutoTabHeightPending = True
        ' Style does NOT touch ShowFocusRect, and that is a decision, not an omission.
        If (mStyle = ntStyleWindows) And (mTabAppearance = ntTAAuto) Then VisualStyles = True
        DrawDelayed
    End If
End Property


' Returns/sets the height of the tabs.
Public Property Get TabHeight() As Single
Attribute TabHeight.VB_Description = "Returns/sets the height of tabs. Zero or a negative value raises error 380. This value is in units of the container."
Attribute TabHeight.VB_ProcData.VB_Invoke_Property = "pagNewTabStrip;Strip"
    TabHeight = FixRoundingError(ToContainerSizeY(mTabHeight, vbHimetric))
End Property

Public Property Let TabHeight(ByVal nValue As Single)
    Dim iValue As Single
    
    iValue = FromContainerSizeY(nValue, vbHimetric)
    If nValue <= 0 Then RaiseError 380, TypeName(Me): Exit Property
    If pScaleY(iValue, vbHimetric, vbTwips) > UserControl.Height Then
        iValue = pScaleY(UserControl.Height, vbTwips, vbHimetric)
    End If
    If pScaleY(iValue, vbHimetric, vbPixels) < 1 Then iValue = pScaleY(1, vbPixels, vbHimetric)
    If Round(iValue * 10000) <> Round(mTabHeight * 10000) Then
        If Abs(Round(iValue) - Round(mTabHeight)) > 1 Then
            If Round(iValue) <> Round(mDefaultTabHeight) Then
                mAutoTabHeight = False
                SetPropertyChanged "AutoTabHeight"
            End If
        End If
        mTabHeight = iValue
        If mHighlightTabExtraHeight > mTabHeight Then
            HighlightTabExtraHeight = mTabHeight
        End If
        SetPropertyChanged "TabHeight"
        ResetCachedThemeImages
        DrawDelayed
    End If
End Property


' Returns/sets the maximum width of each tab.
Public Property Get TabMaxWidth() As Single
Attribute TabMaxWidth.VB_Description = "Returns/sets the maximum width of each tab. This value is in units of the container."
Attribute TabMaxWidth.VB_ProcData.VB_Invoke_Property = "pagNewTabStrip;Strip"
    TabMaxWidth = FixRoundingError(ToContainerSizeX(mTabMaxWidth, vbHimetric))
End Property

Public Property Let TabMaxWidth(ByVal nValue As Single)
    Dim iValue As Single
    
    iValue = FromContainerSizeX(nValue, vbHimetric)
    If ((iValue < pScaleX(150, vbTwips, vbHimetric)) And Not iValue = 0) Or (pScaleX(iValue, vbHimetric, vbTwips) > IIf(UserControl.Width > 3000, UserControl.Width, 3000)) Then
        RaiseError 380, TypeName(Me) ' invalid property value
        Exit Property
    End If
    ' Refused instead of silently ignored: with ntTWEqualWidth the tabs take the control's width
    ' divided by TabsPerRow and a cap has nothing to act on.
    If (iValue <> 0) And (mTabWidthStyle = ntTWEqualWidth) And (Not mAmbientUserMode) And (Round(iValue * 10000) <> Round(mTabMaxWidth * 10000)) Then
        RaiseError 380, TypeName(Me), "TabMaxWidth does not apply when TabWidthStyle is ntTWEqualWidth: the tabs take the width of the control divided by TabsPerRow."
        Exit Property
    End If
    If Round(iValue * 10000) <> Round(mTabMaxWidth * 10000) Then
        mTabMaxWidth = iValue
        If mTabMaxWidth <> 0 Then
            If mTabMaxWidth < mTabMinWidth Then
                TabMinWidth = ToContainerSizeY(mTabMaxWidth, vbHimetric)
            End If
        End If
        SetPropertyChanged "TabMaxWidth"
        mSetAutoTabHeightPending = True
        DrawDelayed
    End If
End Property


' Returns/sets the minimum width of each tab.
Public Property Get TabMinWidth() As Single
Attribute TabMinWidth.VB_Description = "Returns/sets the minimum width of each tab. This value is in units of the container."
Attribute TabMinWidth.VB_ProcData.VB_Invoke_Property = "pagNewTabStrip;Strip"
    TabMinWidth = FixRoundingError(ToContainerSizeX(mTabMinWidth, vbHimetric))
End Property

Public Property Let TabMinWidth(ByVal nValue As Single)
    Dim iValue As Single
    
    iValue = FromContainerSizeX(nValue, vbHimetric)
    If (iValue < 0) Or (pScaleX(iValue, vbHimetric, vbTwips) > IIf(UserControl.Width > 3000, UserControl.Width, 3000)) Then
        RaiseError 380, TypeName(Me) ' invalid property value
        Exit Property
    End If
    ' Same refusal as TabMaxWidth, and here the property was not even inert-looking: with
    ' ntTWEqualWidth iTabMinWidth is never read, because its three reading sites are all on the
    ' caption-width paths. See the Property Let of TabMaxWidth for why it is design time only
    If (iValue <> 0) And (mTabWidthStyle = ntTWEqualWidth) And (Not mAmbientUserMode) And (Round(iValue * 10000) <> Round(mTabMinWidth * 10000)) Then
        RaiseError 380, TypeName(Me), "TabMinWidth does not apply when TabWidthStyle is ntTWEqualWidth: the tabs take the width of the control divided by TabsPerRow."
        Exit Property
    End If
    If Round(iValue * 10000) <> Round(mTabMinWidth * 10000) Then
        mTabMinWidth = iValue
        If (mTabMinWidth > mTabMaxWidth) And (mTabMaxWidth <> 0) Then
            TabMaxWidth = ToContainerSizeY(mTabMinWidth, vbHimetric)
        End If
        SetPropertyChanged "TabMinWidth"
        mSetAutoTabHeightPending = True
        DrawDelayed
    End If
End Property


Public Property Get TabWidthStyle() As NTTabWidthStyleConstants
Attribute TabWidthStyle.VB_Description = "Returns/sets a value that determines the justification or width of the tabs."
Attribute TabWidthStyle.VB_ProcData.VB_Invoke_Property = ";Strip"
    TabWidthStyle = mTabWidthStyle
End Property

Public Property Let TabWidthStyle(ByVal nValue As NTTabWidthStyleConstants)
    If nValue < ntTWTabStripEmulation Or nValue > ntTWGeneralFixedWidthFillRows Then
        RaiseError 380, TypeName(Me) ' invalid property value
        Exit Property
    End If
    If mTabWidthStyle <> nValue Then
        mTabWidthStyle = nValue
        SetPropertyChanged "TabWidthStyle"
        mSetAutoTabHeightPending = True
        DrawDelayed
    End If
End Property


Public Property Get TabGeneralFixedWidth() As Single
Attribute TabGeneralFixedWidth.VB_Description = "Returns/sets the width of every tab when TabWidthStyle is ntTWGeneralFixedWidth or ntTWGeneralFixedWidthFillRows. TabFixedWidth still takes precedence for the tabs that have it set. This value is in units of the container."
Attribute TabGeneralFixedWidth.VB_ProcData.VB_Invoke_Property = "pagNewTabStrip;Strip"
    TabGeneralFixedWidth = FixRoundingError(ToContainerSizeX(mTabGeneralFixedWidth, vbHimetric))
End Property

Public Property Let TabGeneralFixedWidth(ByVal nValue As Single)
    Dim iValue As Single
    
    iValue = FromContainerSizeX(nValue, vbHimetric)
    ' Zero is refused: unlike TabMaxWidth, this one has no "no limit" reading
    If (iValue < pScaleX(150, vbTwips, vbHimetric)) Or (pScaleX(iValue, vbHimetric, vbTwips) > IIf(UserControl.Width > 3000, UserControl.Width, 3000)) Then
        RaiseError 380, TypeName(Me) ' invalid property value
        Exit Property
    End If
    If Round(iValue * 10000) <> Round(mTabGeneralFixedWidth * 10000) Then
        mTabGeneralFixedWidth = iValue
        SetPropertyChanged "TabGeneralFixedWidth"
        mSetAutoTabHeightPending = True
        DrawDelayed
    End If
End Property

Friend Function TabGeneralFixedWidthIsDefault() As Boolean
    TabGeneralFixedWidthIsDefault = (Round(mTabGeneralFixedWidth) = cPropDef_TabGeneralFixedWidth)
End Function

' The limits the width clamps work with. The two general fixed styles pin both to
' TabGeneralFixedWidth, so TabMinWidth and TabMaxWidth are ignored while they are in effect
Private Sub GetTabWidthLimitsPixels(ByRef nMinPixels As Long, ByRef nMaxPixels As Long)
    If (mTabWidthStyle = ntTWGeneralFixedWidth) Or (mTabWidthStyle = ntTWGeneralFixedWidthFillRows) Then
        nMaxPixels = pScaleX(mTabGeneralFixedWidth, vbHimetric, vbPixels)
        nMinPixels = nMaxPixels
    Else
        nMaxPixels = pScaleX(mTabMaxWidth, vbHimetric, vbPixels)
        nMinPixels = pScaleX(mTabMinWidth, vbHimetric, vbPixels)
    End If
End Sub

Public Property Get TabHeightStyleForHorizontal() As NTTabHeightStyleForHorizontalConstants
Attribute TabHeightStyleForHorizontal.VB_Description = "Returns/sets a value that determines how much of the strip each tab takes up, for the Horizontal TabOrientations (LeftHorizontal, RightHorizontal, LeftBottomHorizontal, RightBottomHorizontal) only."
Attribute TabHeightStyleForHorizontal.VB_ProcData.VB_Invoke_Property = ";Strip"
    TabHeightStyleForHorizontal = mTabHeightStyleForHorizontal
End Property

Public Property Let TabHeightStyleForHorizontal(ByVal nValue As NTTabHeightStyleForHorizontalConstants)
    If nValue < ntTHFill Or nValue > ntTHStretchToFill Then
        RaiseError 380, TypeName(Me) ' invalid property value
        Exit Property
    End If
    If mTabHeightStyleForHorizontal <> nValue Then
        mTabHeightStyleForHorizontal = nValue
        SetPropertyChanged "TabHeightStyleForHorizontal"
        mSetAutoTabHeightPending = True
        DrawDelayed
    End If
End Property


Public Property Get TabAppearance() As NTTabAppearanceConstants
Attribute TabAppearance.VB_Description = "Returns/sets a value that determines the appearance of the tabs."
Attribute TabAppearance.VB_ProcData.VB_Invoke_Property = ";Appearance"
    TabAppearance = mTabAppearance
End Property

Public Property Let TabAppearance(ByVal nValue As NTTabAppearanceConstants)
    If nValue < 0 Or nValue > ntTAWindows Then
        RaiseError 380, TypeName(Me) ' invalid property value
        Exit Property
    End If
    If mTabAppearance <> nValue Then
        mTabAppearance = nValue
        If mTabAppearance <> ntTAAuto Then
            mAppearanceIsFlat = (mTabAppearance = ntTAFlat)
        Else
            mAppearanceIsFlat = mStyle = ntStyleFlat
        End If
        SetPropertyChanged "TabAppearance"
        mSetAutoTabHeightPending = True
        ResetCachedThemeImages
        ' What mVisualStyles is for, now that it no longer decides anything: the colours.
        VisualStyles = (mTabAppearance = ntTAWindows) Or ((mTabAppearance = ntTAAuto) And (mStyle = ntStyleWindows))
        DrawDelayed
    End If
End Property



' Returns/sets the type of mouse pointer displayed when over the control.
Public Property Get MousePointer() As NTMousePointerConstants
Attribute MousePointer.VB_Description = "Returns/sets the type of mouse pointer displayed when over the control."
Attribute MousePointer.VB_ProcData.VB_Invoke_Property = ";Misc"
    MousePointer = mMousePointer
End Property

Public Property Let MousePointer(ByVal nValue As NTMousePointerConstants)
    Select Case nValue
        Case Is < 0, 16 To 98, Is > 99
            RaiseError 380, TypeName(Me) ' invalid property value
            Exit Property
    End Select
    If nValue <> mMousePointer Then
        mMousePointer = nValue
        UserControl.MousePointer = mMousePointer
        SetPropertyChanged "MousePointer"
    End If
End Property


' Returns/sets the icon used as the mouse pointer when the MousePointer property is set to 99 (custom).
Public Property Get MouseIcon() As Picture
Attribute MouseIcon.VB_Description = "Returns/sets the icon used as the mouse pointer when the MousePointer property is set to 99 (custom)."
Attribute MouseIcon.VB_ProcData.VB_Invoke_Property = ";Misc"
    Set MouseIcon = mMouseIcon
End Property

Public Property Let MouseIcon(ByVal nValue As Picture)
    If Not nValue Is Nothing Then If nValue.Handle = 0 Then Set nValue = Nothing
    If Not nValue Is mMouseIcon Then
        Set mMouseIcon = nValue
        SetPropertyChanged "MouseIcon"
    End If
End Property

Public Property Set MouseIcon(ByVal nValue As Picture)
    If Not nValue Is Nothing Then If nValue.Handle = 0 Then Set nValue = Nothing
    If Not nValue Is mMouseIcon Then
        Set mMouseIcon = nValue
        Set UserControl.MouseIcon = mMouseIcon
        SetPropertyChanged "MouseIcon"
    End If
End Property


' Returns/Sets whether this control can act as an OLE drop target.
Public Property Get OLEDropMode() As NTOLEDropConstants
Attribute OLEDropMode.VB_Description = "Returns/sets how a target component handles drop operations."
Attribute OLEDropMode.VB_ProcData.VB_Invoke_Property = ";Behavior"
    OLEDropMode = mOLEDropMode
End Property

Public Property Let OLEDropMode(ByVal nValue As NTOLEDropConstants)
    Const DRAGDROP_E_ALREADYREGISTERED As Long = &H80040101
    
    If nValue < 0 Or nValue > 1 Then
        RaiseError 380, TypeName(Me) ' invalid property value
        Exit Property
    End If
    If nValue <> mOLEDropMode Then
        mOLEDropMode = nValue
        
        On Error Resume Next
        UserControl.OLEDropMode = mOLEDropMode
        If Err.Number = DRAGDROP_E_ALREADYREGISTERED Then
            RevokeDragDrop UserControl.hWnd
            UserControl.OLEDropMode = mOLEDropMode
        End If
        On Error GoTo 0
        
        SetPropertyChanged "OLEDropMode"
    End If
End Property


' Returns the picture displayed on the specified tab.
Public Property Get TabPicture(ByVal nTab As Variant) As Picture
Attribute TabPicture.VB_Description = "Returns/sets the picture to be displayed on the specified tab."
Attribute TabPicture.VB_ProcData.VB_Invoke_Property = ";Icon"
    Dim iIndex As Long
    
    iIndex = GetTabIndex(nTab)
    If Not IsValidTabIndex(iIndex) Then
        RaiseError 381, TypeName(Me) ' invalid property array index
        Exit Property
    End If
    Set TabPicture = mTabData(iIndex).Picture
End Property

Public Property Let TabPicture(ByVal nTab As Variant, ByVal nValue As Picture)
    Dim iIndex As Long
    
    If Not nValue Is Nothing Then If nValue.Handle = 0 Then Set nValue = Nothing
    iIndex = GetTabIndex(nTab)
    If Not IsValidTabIndex(iIndex) Then
        RaiseError 381, TypeName(Me) ' invalid property array index
        Exit Property
    End If
    Set TabPicture(iIndex) = nValue
End Property

Public Property Set TabPicture(ByVal nTab As Variant, ByVal nValue As Picture)
    Dim iIndex As Long
    
    If Not nValue Is Nothing Then If nValue.Handle = 0 Then Set nValue = Nothing
    iIndex = GetTabIndex(nTab)
    If Not IsValidTabIndex(iIndex) Then
        RaiseError 381, TypeName(Me) ' invalid property array index
        Exit Property
    End If
    If Not nValue Is mTabData(iIndex).Picture Then
        Set mTabData(iIndex).Picture = nValue
        ' a picture the developer set has no size imposed from outside. Clearing
        ' this matters because TDI Forms writes it, and TabPicture is reachable in
        ' that mode too
        mTabData(iIndex).PicTargetWidth = 0
        mTabData(iIndex).PicTargetHeight = 0
        mTabData(iIndex).PicToUseSet = False
        ResetPicDisabled iIndex
        SetPropertyChanged "TabPicture"
        mSetAutoTabHeightPending = True
        DrawDelayed
    End If
End Property


