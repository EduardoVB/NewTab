Public Property Let ShowRowsInPerspective(ByVal nValue As NTAutoYesNoConstants)
    Dim iValue As NTAutoYesNoConstants
    
    iValue = nValue
    If (iValue <> ntNo) And (iValue <> ntYNAuto) Then
        iValue = ntYes
    End If
    If iValue <> mShowRowsInPerspective Then
        mShowRowsInPerspective = iValue
        SetPropertyChanged "ShowRowsInPerspective"
        ResetCachedThemeImages
        DrawDelayed
    End If
End Property


Public Property Get NewTabButton() As NTAutoYesNoConstants
Attribute NewTabButton.VB_Description = "Returns/sets a value that determines if the new tab button (a '+') is shown after the last tab. With ntYNAuto it is shown only in the TDI Controls mode."
Attribute NewTabButton.VB_ProcData.VB_Invoke_Property = "pagNewTabButtons;Buttons"
    NewTabButton = mNewTabButton
End Property

Public Property Let NewTabButton(ByVal nValue As NTAutoYesNoConstants)
    If (nValue <> ntNo) And (nValue <> ntYNAuto) Then
        nValue = ntYes
    End If
    If nValue <> mNewTabButton Then
        mNewTabButton = nValue
        NewTabButtonApply
        SetPropertyChanged "NewTabButton"
        mSetAutoTabHeightPending = True
        DrawDelayed
    End If
End Property


Public Property Get CloseButton() As Boolean
Attribute CloseButton.VB_Description = "Returns/sets a value that determines if a close button (a 'x') is shown by default on the tabs, allowing the user to close them. Can be overridden per tab with the TabCloseButton property."
