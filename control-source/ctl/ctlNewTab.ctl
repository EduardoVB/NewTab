    If nValue <> mMaskColor Then
        If Not IsValidOLE_COLOR(nValue) Then RaiseError 380, TypeName(Me): Exit Property
        mMaskColor = nValue
        ' Both caches: the disabled pictures were built comparing against the old mask colour, and
        ' PicToUse has it baked in as an alpha channel whenever the picture was scaled, because the
        ' mask is resolved at scaling time.
        ResetAllPicsToUse
