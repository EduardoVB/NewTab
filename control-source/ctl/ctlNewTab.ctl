Private Sub TDIConfigureTDIModeOnce()
    Dim iFont As StdFont
    
    CanReorderTabs = True
    
    mTDIChangingTabCount = True
    If mTDIMode = ntTDIModeControls Then
        SetTabCount 2
    ElseIf mTDIMode = ntTDIModeForms Then
        SetTabCount 1
    Else
        SetTabCount 1 ' this one also drops the button, which is what keeps it out of the way below
        TabCaption(0) = "Tab 0"
        SetTabCount cPropDef_Tabs
        MoveTab 0, 2
        SetTabCount 1
        TabCaption(0) = "Tab 0"
        SetTabCount cPropDef_Tabs
        mCanReorderTabs = cPropDef_CanReorderTabs
        ' Automatic and not Ambient.ForeColor: the tab count dance above goes through setters that
        ' can leave these two explicit, and what has to be undone is the decision, not the colour.
        mIconColorMouseHover_IsAutomatic = True
        mIconColorMouseHoverSelectedTab_IsAutomatic = True
        ApplyChainColors nSilent:=True
    End If
    mTDIChangingTabCount = False
End Sub
    
' Resolves whether the close button ('x') should show for a given tab.
' - Outside of TDI mode: the three-state per-tab TabCloseButton property, resolved against
'   the general CloseButton property, combined with TabCloseButtonEnabled.
' - In TDI mode (point 2, ToDo NewTab 2): CloseButton/TabCloseButton/TabCloseButtonEnabled are
'   ignored completely. Instead it's decided by TDICloseButtonShown (set once when the tab was
'   created, via the TDIBeforeNewTab event) and, for TDIModeForms, further gated by
'   mTDIFormWithoutCloseButton (forms without a system close button never get one here either).
' Whether the tab has a close button of its own and keeps the room for it, shown or not. The tab can
' be closed whenever TabCloseButtonAllowed says so; with the button at the end of the strip that is
' the one that closes it
Private Function TabCloseButtonEffective(ByVal nTab As Long) As Boolean
    If mCloseButtonPosition <> ntCBPositionStripEnd Then TabCloseButtonEffective = TabCloseButtonAllowed(nTab)
End Function

' Whether the button is drawn and answers the mouse right now. Read from the Hovered flag and not
' from mTabUnderMouse: the hover base cache is built with that flag put aside, so the base never
' keeps the button of the tab under the mouse
Private Function TabCloseButtonShown(ByVal nTab As Long) As Boolean
    If Not TabCloseButtonEffective(nTab) Then Exit Function
    Select Case mCloseButtonPosition
        Case ntCBPositionOnSelectedTab
            TabCloseButtonShown = (nTab = mTab)
        Case ntCBPositionOnHoveredTab
            TabCloseButtonShown = mTabData(nTab).Hovered
        Case ntCBPositionOnSelectedAndHoveredTabs
            TabCloseButtonShown = (nTab = mTab) Or mTabData(nTab).Hovered
        Case Else
            TabCloseButtonShown = True
    End Select
End Function

' What the close button adds toward the tab edge on top of the TabPaddingWidth already left there:
' the two are not summed, the larger one is the air
Private Function CloseButtonExtraAir() As Long
    If mCloseButtonPaddingDPIScaled > mTabPaddingWidthDPIScaled Then CloseButtonExtraAir = mCloseButtonPaddingDPIScaled - mTabPaddingWidthDPIScaled
End Function

Private Function TabCloseButtonAllowed(ByVal nTab As Long) As Boolean
    Dim iShow As Boolean
    
    ' a close button on the button that adds tabs has no reading, so this is a rule of the control
    ' and not a value someone has to remember to set when the button is built.
    If TabIsNewTabButton(nTab) Then Exit Function
    If mTDIMode <> ntTDIModeNone Then
        iShow = mTabData(nTab).TDICloseButtonShown
        If iShow And mAmbientUserMode And (mTDIMode = ntTDIModeForms) Then
            If (mTabData(nTab).Data >= 0) And (mTabData(nTab).Data <= UBound(mTDIFormWithoutCloseButton)) Then
                iShow = Not mTDIFormWithoutCloseButton(mTabData(nTab).Data)
            End If
        End If
        TabCloseButtonAllowed = iShow
        Exit Function
    End If
    
    Select Case mTabData(nTab).CloseButton
        Case ntYes
            iShow = True
        Case ntNo
            iShow = False
        Case Else ' ntYNAuto
            iShow = mCloseButton
    End Select
    TabCloseButtonAllowed = iShow
End Function

' Sets up (once) the font and char code used to draw the close button 'x',
' with the same font cascade/fallback already used elsewhere in TDI mode
' (Segoe MDL2 Assets -> Marlett -> Arial), so it does not depend on GDI+.
Private Sub SetupCloseButtonFont()
    Dim iTextMetric As TEXTMETRICW
    Dim iGlyphMetric As GLYPHMETRICS
    Dim iIdentity As MAT2
    Dim iTextMetricResult As Long
    Dim iGlyphResult As Long
    Dim iUnused As Long
    Dim iUsable As Boolean
    Dim iCharsApply As Boolean
    Dim iInkHeight As Long
    
    If mCloseButtonFontIsSetUp Then Exit Sub
    
    Set mCloseButtonFont = CloseButtonDefaultFont
    GlyphFontCodes mCloseButtonFont.Name, mCloseButtonCharCode, mScrollBackCharCode, mScrollFwdCharCode, mScrollListDownCharCode, mScrollListUpCharCode
    Set mStripButtonsFont = mCloseButtonFont
    ' A code chosen for a font that is missing here would draw something else in the default one,
    ' so it goes with its font. A code given without a font is for the default one
    iUsable = UserGlyphFontUsable(mCloseButtonUserFont, mCloseButtonUserFontIsSet, mCloseButtonUserFontName)
    If iUsable Then
        Set mCloseButtonFont = CloneFont(mCloseButtonUserFont)
        GlyphFontCodes mCloseButtonFont.Name, mCloseButtonCharCode, iUnused, iUnused, iUnused, iUnused
    End If
    If (mCloseButtonUserChar <> 0) And (iUsable Or (Not mCloseButtonUserFontIsSet)) Then mCloseButtonCharCode = mCloseButtonUserChar
    iUsable = UserGlyphFontUsable(mStripButtonsUserFont, mStripButtonsUserFontIsSet, mStripButtonsUserFontName)
    If iUsable Then
        Set mStripButtonsFont = CloneFont(mStripButtonsUserFont)
        GlyphFontCodes mStripButtonsFont.Name, iUnused, mScrollBackCharCode, mScrollFwdCharCode, mScrollListDownCharCode, mScrollListUpCharCode
    End If
    iCharsApply = iUsable Or (Not mStripButtonsUserFontIsSet)
    mStripButtonBackIsUser = iCharsApply And (mStripButtonBackChar <> 0)
    mStripButtonForwardIsUser = iCharsApply And (mStripButtonForwardChar <> 0)
    mStripButtonListIsUser = iCharsApply And (mStripButtonListChar <> 0)
    If mStripButtonBackIsUser Then mScrollBackCharCode = mStripButtonBackChar
    If mStripButtonForwardIsUser Then mScrollFwdCharCode = mStripButtonForwardChar
    If mStripButtonListIsUser Then mScrollListDownCharCode = mStripButtonListChar
    
    ' Where the ink of this one glyph really is, so the button can be placed without asking DrawText
    ' to centre it.
    mCloseButtonGlyphTopFromCenter = 0
    mCloseButtonGlyphInkHeight = 0
    mCloseButtonGlyphIsMeasured = False
    Set picAuxIconFont.Font = mCloseButtonFont
    iIdentity.eM11.nWhole = 1
    iIdentity.eM22.nWhole = 1
    ' Both are called before anything is tested, so a failure of either one is visible in the
    ' diagnostic instead of hiding behind the other one's guard
    iTextMetricResult = GetTextMetricsW(picAuxIconFont.hDC, iTextMetric)
    iGlyphResult = GetGlyphOutlineW(picAuxIconFont.hDC, mCloseButtonCharCode, GGO_METRICS, iGlyphMetric, 0, 0, iIdentity)
    If (iTextMetricResult <> 0) And (iGlyphResult <> GDI_ERROR) And (iGlyphMetric.gmBlackBoxY > 0) Then
        mCloseButtonGlyphTopFromCenter = iGlyphMetric.gmptGlyphOrigin.Y - iTextMetric.tmAscent - (iGlyphMetric.gmBlackBoxY \ 2)
        ' Kept for SetAutoTabHeight, which has to know how tall this one glyph really is before it
        ' can promise the tab is tall enough to hold it. The ink box and not the line box: the
        ' line box carries leading the 'x' does not use, and claiming it would grow every tab
        mCloseButtonGlyphInkHeight = iGlyphMetric.gmBlackBoxY
        mCloseButtonGlyphIsMeasured = True
    End If
    mStripButtonsGlyphInkHeight = 0
    mStripListGlyphInkHeight = 0
    Set picAuxIconFont.Font = mStripButtonsFont
    mStripButtonsGlyphInkHeight = GlyphInkHeight(picAuxIconFont.hDC, mScrollBackCharCode)
    iInkHeight = GlyphInkHeight(picAuxIconFont.hDC, mScrollFwdCharCode)
    If iInkHeight > mStripButtonsGlyphInkHeight Then mStripButtonsGlyphInkHeight = iInkHeight
    mStripListGlyphInkHeight = GlyphInkHeight(picAuxIconFont.hDC, mScrollListDownCharCode)
    ' the developer's list is flipped, not swapped for the up glyph
    If Not mStripButtonListIsUser Then
        iInkHeight = GlyphInkHeight(picAuxIconFont.hDC, mScrollListUpCharCode)
        If iInkHeight > mStripListGlyphInkHeight Then mStripListGlyphInkHeight = iInkHeight
    End If
    
#If CLOSEBUTTONGLYPHDIAG = 1 Then ' TEMP diagnostic
    Debug.Print "CloseButtonGlyph font="; mCloseButtonFont.Name; " size="; mCloseButtonFont.Size; " char=&H"; Hex$(mCloseButtonCharCode); " hDC="; picAuxIconFont.hDC
    Debug.Print "   tmRet="; iTextMetricResult; " tmHeight="; iTextMetric.tmHeight; " tmAscent="; iTextMetric.tmAscent; " tmDescent="; iTextMetric.tmDescent; " tmIntLeading="; iTextMetric.tmInternalLeading
    Debug.Print "   ggoRet="; iGlyphResult; " blackBoxX="; iGlyphMetric.gmBlackBoxX; " blackBoxY="; iGlyphMetric.gmBlackBoxY; " originX="; iGlyphMetric.gmptGlyphOrigin.X; " originY="; iGlyphMetric.gmptGlyphOrigin.Y; " cellIncX="; iGlyphMetric.gmCellIncX
    Debug.Print "   measured="; mCloseButtonGlyphIsMeasured; " topFromCenter="; mCloseButtonGlyphTopFromCenter
#End If
    
    mCloseButtonFontIsSetUp = True
End Sub

Private Function FontExists(nFontName As String) As Boolean
    Dim iFont As New StdFont
    
    
    If nFontName = "[Auto]" Then Exit Function
    If Trim$(nFontName) = "" Then Exit Function
    
    iFont.Name = nFontName
    FontExists = StrComp(nFontName, iFont.Name, vbTextCompare) = 0
End Function
    
    
' The glyph codes each font of the default cascade draws the buttons with. Any other font gets the
' plain characters of the last resort
Private Sub GlyphFontCodes(ByVal nFontName As String, ByRef nClose As Long, ByRef nBack As Long, ByRef nForward As Long, ByRef nListDown As Long, ByRef nListUp As Long)
    Select Case LCase$(nFontName)
    Case "segoe mdl2 assets"
        nClose = &HE106& ' "Cancel"
        nBack = &HE76B& ' ChevronLeft
        nForward = &HE76C& ' ChevronRight
        nListDown = &HE70D& ' ChevronDown
        nListUp = &HE70E& ' ChevronUp
    Case "marlett"
        nClose = &H72 ' close box
        nBack = &H33 ' left triangle
        nForward = &H34
        nListDown = &H36
        nListUp = &H35
    Case Else
        nClose = &H78 ' "x"
        nBack = &H3C
        nForward = &H3E
        nListDown = &H76
        nListUp = &H5E
    End Select
End Sub

' A font missing on this machine is not reported as such: StdFont swaps the name for one it has, so
' the name the developer chose is compared too
Private Function UserGlyphFontUsable(ByVal nFont As StdFont, ByVal nIsSet As Boolean, ByVal nName As String) As Boolean
    If Not nIsSet Then Exit Function
    If nFont Is Nothing Then Exit Function
    If StrComp(nFont.Name, nName, vbTextCompare) <> 0 Then Exit Function
    UserGlyphFontUsable = FontExists(nName)
End Function

' A form saved where the font was missing carries the substitute in the font and the real name
' apart, so where the font does exist it gets its name back
Private Sub RestoreGlyphFontName(ByVal nFont As StdFont, ByRef nName As String)
    If nFont Is Nothing Then
        nName = ""
        Exit Sub
    End If
    If nName = "" Then
        nName = nFont.Name
    ElseIf StrComp(nFont.Name, nName, vbTextCompare) <> 0 Then
        If FontExists(nName) Then nFont.Name = nName
    End If
End Sub

Private Sub GlyphFontsChanged()
    mCloseButtonFontIsSetUp = False
    mSetAutoTabHeightPending = True
    DrawDelayed
End Sub

' The button is not saved and is dressed only when created, so a change rebuilds it
Private Sub NewTabButtonGlyphChanged()
    If mTabs > 0 Then
        If TabIsNewTabButton(mTabs - 1) Then
            NewTabButtonDestroy
            NewTabButtonApply
        End If
    End If
    mSetAutoTabHeightPending = True
    DrawDelayed
End Sub

' What the 'x' and the strip buttons use when their font is not set or not installed
Private Function CloseButtonDefaultFont() As StdFont
    Set CloseButtonDefaultFont = New StdFont
    If FontExists("Segoe MDL2 Assets") Then
        CloseButtonDefaultFont.Name = "Segoe MDL2 Assets"
        CloseButtonDefaultFont.Bold = True
        CloseButtonDefaultFont.Size = 10
    ElseIf FontExists("Marlett") Then
        CloseButtonDefaultFont.Name = "Marlett"
        CloseButtonDefaultFont.Size = 15
    Else
        CloseButtonDefaultFont.Name = "Arial"
        CloseButtonDefaultFont.Bold = True
        CloseButtonDefaultFont.Size = 15
    End If
End Function

' For the Buttons property page: the glyphs drawn while the font and the codes are left to the control.
' The list code is the one shown with the tabs on top
Friend Sub DefaultCloseButtonGlyph(ByRef nFont As StdFont, ByRef nChar As Long)
    Dim iUnused As Long
    
    Set nFont = CloseButtonDefaultFont
    GlyphFontCodes nFont.Name, nChar, iUnused, iUnused, iUnused, iUnused
    nChar = nChar And &HFFFF&
End Sub

Friend Sub DefaultStripButtonsGlyphs(ByRef nFont As StdFont, ByRef nBackChar As Long, ByRef nForwardChar As Long, ByRef nListChar As Long)
    Dim iUnused As Long
    
    Set nFont = CloseButtonDefaultFont
    GlyphFontCodes nFont.Name, iUnused, nBackChar, nForwardChar, nListChar, iUnused
    nBackChar = nBackChar And &HFFFF&
    nForwardChar = nForwardChar And &HFFFF&
    nListChar = nListChar And &HFFFF&
End Sub

Friend Sub DefaultNewTabButtonGlyph(ByRef nFont As StdFont, ByRef nChar As Long)
    Set nFont = NewTabButtonDefaultFont
    If StrComp(nFont.Name, "Segoe MDL2 Assets", vbTextCompare) = 0 Then
        nChar = &HF8AA&
    Else
        nChar = &H2B
    End If
End Sub

' The codes a font draws when the code is left at 0, for a font the developer chose
Friend Sub GlyphCodesForFont(ByVal nFontName As String, ByRef nClose As Long, ByRef nNewTab As Long, ByRef nBack As Long, ByRef nForward As Long, ByRef nList As Long)
    Dim iUnused As Long
    
    GlyphFontCodes nFontName, nClose, nBack, nForward, nList, iUnused
    nClose = nClose And &HFFFF&
    nBack = nBack And &HFFFF&
    nForward = nForward And &HFFFF&
    nList = nList And &HFFFF&
    If StrComp(nFontName, "Segoe MDL2 Assets", vbTextCompare) = 0 Then
        nNewTab = &HF8AA&
    Else
        nNewTab = &H2B
    End If
End Sub

' What NewTabButtonCreate uses when NewTabButtonFont is not set or not installed
Private Function NewTabButtonDefaultFont() As StdFont
    Set NewTabButtonDefaultFont = New StdFont
    NewTabButtonDefaultFont.Bold = True
    If FontExists("Segoe MDL2 Assets") Then
        NewTabButtonDefaultFont.Name = "Segoe MDL2 Assets"
        NewTabButtonDefaultFont.Size = 10
    Else
        NewTabButtonDefaultFont.Name = "Arial"
        NewTabButtonDefaultFont.Size = 15
    End If
End Function

' Same measure SetupCloseButtonFont takes for the 'x': the offset from the centre the ink has to
' land on to the Top of a DT_TOP rect. False when the font cannot be measured, a raster one say
Private Function GlyphInkTopFromCenter(ByVal nHdc As LongPtr, ByVal nCharCode As Long, ByRef nTopFromCenter As Long) As Boolean
    Dim iTextMetric As TEXTMETRICW
    Dim iGlyphMetric As GLYPHMETRICS
    Dim iIdentity As MAT2
    
    iIdentity.eM11.nWhole = 1
    iIdentity.eM22.nWhole = 1
    If GetTextMetricsW(nHdc, iTextMetric) = 0 Then Exit Function
    If GetGlyphOutlineW(nHdc, nCharCode, GGO_METRICS, iGlyphMetric, 0, 0, iIdentity) = GDI_ERROR Then Exit Function
    If iGlyphMetric.gmBlackBoxY <= 0 Then Exit Function
    nTopFromCenter = iGlyphMetric.gmptGlyphOrigin.Y - iTextMetric.tmAscent - (iGlyphMetric.gmBlackBoxY \ 2)
    GlyphInkTopFromCenter = True
End Function

' Zero when the font cannot be measured, a raster one say
Private Function GlyphInkHeight(ByVal nHdc As LongPtr, ByVal nCharCode As Long) As Long
    Dim iGlyphMetric As GLYPHMETRICS
    Dim iIdentity As MAT2
    
    iIdentity.eM11.nWhole = 1
    iIdentity.eM22.nWhole = 1
    If GetGlyphOutlineW(nHdc, nCharCode, GGO_METRICS, iGlyphMetric, 0, 0, iIdentity) = GDI_ERROR Then Exit Function
    GlyphInkHeight = iGlyphMetric.gmBlackBoxY
End Function

' The rect that puts the glyph's ink, and not its line box, on the centre of nBtnRect. Needs the
' font already in picDraw
Private Sub InkCenteredGlyphRect(ByVal nCharCode As Long, ByRef nBtnRect As RECT, ByRef nCharRect As RECT, ByRef nFlags As Long)
    Dim iTopFromCenter As Long
    
    If Not GlyphInkTopFromCenter(picDraw.hDC, nCharCode, iTopFromCenter) Then Exit Sub
    nCharRect.Top = (nBtnRect.Top + nBtnRect.Bottom) \ 2 + iTopFromCenter
    nCharRect.Bottom = nCharRect.Top + (nBtnRect.Bottom - nBtnRect.Top)
    nFlags = nFlags And (Not DT_VCENTER)
End Sub

' Draws the glyph upside down around the centre of nBtnRect, keeping left and right. For the list
' glyph the developer gave, which is drawn pointing down, where the body is above
Private Sub DrawGlyphFlippedVertically(ByRef nCharacter As String, ByRef nCharRect As RECT, ByRef nBtnRect As RECT, ByVal nFlags As Long)
    Dim iCenterX As Long
    Dim iCenterY As Long
    Dim iLocalRect As RECT
    Dim iTx As XFORM
    Dim iTxPrev As XFORM
    Dim iGMPrev As Long
    Dim iPrevLayoutWnd As Long
    Dim iPrevLayoutDC As Long
    
    iCenterX = nBtnRect.Left + (nBtnRect.Right - nBtnRect.Left) \ 2
    iCenterY = nBtnRect.Top + (nBtnRect.Bottom - nBtnRect.Top) \ 2
    iLocalRect.Left = nCharRect.Left - iCenterX
    iLocalRect.Right = nCharRect.Right - iCenterX
    iLocalRect.Top = nCharRect.Top - iCenterY
    iLocalRect.Bottom = nCharRect.Bottom - iCenterY
    If mRightToLeft Then
        ' the world transform does not compose with the mirrored layout, see DrawTabIconAndCaption
        iPrevLayoutWnd = GetLayout(GetDC(picDraw.hWnd))
        iPrevLayoutDC = GetLayout(picDraw.hDC)
        SetLayout GetDC(picDraw.hWnd), 0
        SetLayout picDraw.hDC, 0
        iCenterX = picDraw.ScaleWidth - iCenterX
    End If
    iGMPrev = SetGraphicsMode(picDraw.hDC, GM_ADVANCED)
    GetWorldTransform picDraw.hDC, iTxPrev
    iTx.eM11 = 1
    iTx.eM22 = -1
    iTx.eDx = iCenterX
    iTx.eDy = iCenterY
    SetWorldTransform picDraw.hDC, iTx
    DrawTextW picDraw.hDC, StrPtr(nCharacter), -1, iLocalRect, nFlags
    SetWorldTransform picDraw.hDC, iTxPrev
    SetGraphicsMode picDraw.hDC, iGMPrev
    If mRightToLeft Then
        SetLayout GetDC(picDraw.hWnd), iPrevLayoutWnd
        SetLayout picDraw.hDC, iPrevLayoutDC
    End If
End Sub

' For the previews of the property pages. The settings and not the properties: the Get of a font
' left to the control would hand over a set one, and a font missing here a present one
Friend Function GlyphSettings() As Variant
    GlyphSettings = Array(mCloseButtonUserFont, mCloseButtonUserFontIsSet, mCloseButtonUserFontName, mCloseButtonUserChar, mNewTabButtonUserFont, mNewTabButtonUserFontIsSet, mNewTabButtonUserFontName, mNewTabButtonUserChar, mStripButtonsUserFont, mStripButtonsUserFontIsSet, mStripButtonsUserFontName, mStripButtonBackChar, mStripButtonForwardChar, mStripButtonListChar)
End Function

Friend Sub CopyGlyphSettingsFrom(ByVal nSource As NewTab)
    Dim iSettings As Variant
    Dim iFont As StdFont
    
    iSettings = nSource.GlyphSettings
    Set iFont = iSettings(0)
    If iFont Is Nothing Then Set mCloseButtonUserFont = Nothing Else Set mCloseButtonUserFont = CloneFont(iFont)
    mCloseButtonUserFontIsSet = iSettings(1)
    mCloseButtonUserFontName = iSettings(2)
    mCloseButtonUserChar = iSettings(3)
    Set iFont = iSettings(4)
    If iFont Is Nothing Then Set mNewTabButtonUserFont = Nothing Else Set mNewTabButtonUserFont = CloneFont(iFont)
    mNewTabButtonUserFontIsSet = iSettings(5)
    mNewTabButtonUserFontName = iSettings(6)
    mNewTabButtonUserChar = iSettings(7)
    Set iFont = iSettings(8)
    If iFont Is Nothing Then Set mStripButtonsUserFont = Nothing Else Set mStripButtonsUserFont = CloneFont(iFont)
    mStripButtonsUserFontIsSet = iSettings(9)
    mStripButtonsUserFontName = iSettings(10)
    mStripButtonBackChar = iSettings(11)
    mStripButtonForwardChar = iSettings(12)
    mStripButtonListChar = iSettings(13)
    mCloseButtonFontIsSetUp = False
    NewTabButtonGlyphChanged
End Sub

Private Sub NewTabButtonClicked()
    ' The one place the click on the new tab button is answered.
    Dim iCancel As Boolean
    
    RaiseEvent NewTabButtonClick(iCancel)
    If iCancel Then Exit Sub
    If mTDIMode = ntTDIModeControls Then TDIAddNewTab
End Sub

' Friend and not Private because CopyControlProperties needs it: a preview is never in a TDI
' mode, so copying ntYNAuto across would read there as "no button" while the developer's
' control may well be showing one. Resolving it at the copy is what keeps the preview honest
Friend Function NewTabButtonEffective() As Boolean
    ' ntYNAuto is what the control did before the property existed: the button belongs to the
    ' TDI Controls mode and to nowhere else. ntYes and ntNo say so in any mode, TDI or not
    Select Case mNewTabButton
    Case ntYes
        NewTabButtonEffective = True
    Case ntNo
        NewTabButtonEffective = False
    Case Else
        NewTabButtonEffective = (mTDIMode = ntTDIModeControls)
    End Select
End Function

Private Sub NewTabButtonApply()
    ' Brings the strip in line with NewTabButtonEffective, and is called wherever anything it
    ' reads may have changed: the property itself, the TDI mode, and the end of ReadProperties.
    ' Idempotent on purpose, so that the callers do not have to know what the others did
    If NewTabButtonEffective Then
        If Not TabIsNewTabButton(mTabs - 1) Then NewTabButtonCreate
    Else
        If TabIsNewTabButton(mTabs - 1) Then NewTabButtonDestroy
    End If
    ' the colors are stamped here and not inside NewTabButtonCreate so that a button that was
    ' already there gets them too: at the end of ReadProperties the button can exist already,
    ' because TDISetTDIMode ran first, and then the create branch above does nothing
    NewTabButtonApplyColors
End Sub

Private Sub NewTabButtonDestroy()
    Dim iChangingTabCount As Boolean
    
    If Not TabIsNewTabButton(mTabs - 1) Then Exit Sub
    ' the flag is cleared before shrinking: from here on it is a plain tab, so SetTabCount
    ' sees an ordinary shrink and TabsWithoutNewTabButton stops discounting a tab that is
    ' about to be gone, which is what keeps the count right in between the two statements
    mTabData(mTabs - 1).IsNewTabButton = False
    iChangingTabCount = mTDIChangingTabCount
    mTDIChangingTabCount = True
    SetTabCount mTabs - 1
    mTDIChangingTabCount = iChangingTabCount
End Sub

Private Sub NewTabButtonCreate()
    ' Builds the new tab button.
    Dim iFont As StdFont
    Dim iBtn As Long
    Dim iChangingTabCount As Boolean
    Dim iUserFont As Boolean
    Dim iUserChar As Boolean
    Dim iCharCode As Long
    
    iChangingTabCount = mTDIChangingTabCount ' this can run inside a tab count change, so the flag is restored and not just cleared
    mTDIChangingTabCount = True ' SetTabCount refuses to change the tab count in TDI mode at design time
    SetTabCount mTabs + 1
    mTDIChangingTabCount = iChangingTabCount
    
    ' it is set up as a plain tab and only flagged at the end: the per tab properties below
    ' validate their index with IsValidTabIndex, which stops counting a tab once it is the
    ' button, so flagging it first would make the control unable to dress its own button
    iBtn = mTabs - 1 ' the button lives at the last index, and TDIPrepareNewTab keeps it there
    TabVisible(iBtn) = True
    TabCaption(iBtn) = ""
    
    Set iFont = New StdFont
    If FontExists("Segoe MDL2 Assets") Then
        iFont.Name = "Segoe MDL2 Assets"
        iFont.Bold = True
        iFont.Size = 10
        Set TabIconFont(iBtn) = CloneFont(iFont)
        TabIconFont(iBtn).Size = 10 ' size of the + to add a new tab
        TabIconFont(iBtn).Bold = True
        TabToolTipText(iBtn) = mNewTabButtonToolTipText
        TabIconCharHex(iBtn) = "&HF8AA&"
    Else
        iFont.Name = "Arial"
        iFont.Size = 15
        iFont.Bold = True
        Set TabIconFont(iBtn) = CloneFont(iFont)
        TabToolTipText(iBtn) = mNewTabButtonToolTipText
        TabIconCharHex(iBtn) = "&H2B&"
    End If
    iUserFont = UserGlyphFontUsable(mNewTabButtonUserFont, mNewTabButtonUserFontIsSet, mNewTabButtonUserFontName)
    ' same rule as in SetupCloseButtonFont: the code goes with its font
    iUserChar = (mNewTabButtonUserChar <> 0) And (iUserFont Or (Not mNewTabButtonUserFontIsSet))
    If iUserFont Or iUserChar Then
        If iUserFont Then Set TabIconFont(iBtn) = CloneFont(mNewTabButtonUserFont)
        If iUserChar Then
            iCharCode = mNewTabButtonUserChar
        ElseIf StrComp(TabIconFont(iBtn).Name, "Segoe MDL2 Assets", vbTextCompare) = 0 Then
            iCharCode = &HF8AA&
        Else
            iCharCode = &H2B
        End If
        TabIconCharHex(iBtn) = "&H" & Hex$(iCharCode) & "&"
    End If
    mTabData(iBtn).IsNewTabButton = True ' from here on it is out of TabsWithoutNewTabButton
End Sub

Private Sub NewTabButtonApplyColors()
    ' The '+' is a font icon on a real tab, so its two colors are seeded into the per tab colors of
    ' that tab instead of adding a branch to the drawing code, which already knows how to resolve
    ' them.
    Dim iBtn As Long

    ' with no button around the last tab is one of the developer's, and these colors would
    ' land in its CustomColors and outlive the setting that put them there
    If Not TabIsNewTabButton(mTabs - 1) Then Exit Sub
    iBtn = mTabs - 1

    mTabData(iBtn).CustomColors.IconColor = mNewTabButtonColor
    ' One visual state, two slots, and the same value in both on purpose: the '+' is small enough
    ' that pointing at its glyph and pointing at the strip of tab around it are the same gesture, so
    ' both have to light it up.
    mTabData(iBtn).CustomColors.IconColorTabHighlighted = mNewTabButtonColorHighlighted
    mTabData(iBtn).CustomColors.IconColorMouseHover = mNewTabButtonColorHighlighted
    ' IconColorSelectedTab and IconColorMouseHoverSelectedTab are left Empty on purpose: the
    ' button can never be the active tab, so seeding them would only hide a breach of that
    
    ' Written straight into the record, around Property Let TabCustomColor and so around the
    ' one place that would otherwise refresh the cache the drawing reads
    ApplyTabChainColorsForTab iBtn
End Sub

Private Sub TDISetTDIMode()
    Dim iTabCaption As String
    Dim iLoadTabControls As Boolean
    Dim iShowTabCloseButton As Boolean
    
    Redraw = False
    
    mSettingTDIMode = True
    mTDIChangingTabCount = True
    SetTabCount 1 ' both TDI modes start from the template tab alone, whatever the property bag left here
    mTDIChangingTabCount = False
    NewTabButtonApply ' after SetTabCount 1, so it is idempotent however many tabs were loaded
    ' mIconAlignment used to be written here, End for Controls and Start for Forms.
    mBackColor = Ambient.BackColor
    
    If Not mAmbientUserMode Then
        TabSel = 0
        If mTDIMode = ntTDIModeControls Then
            TabCaption(0) = "New tab template   "
        ElseIf (TabCaption(0) = "New tab template   ") Or (TabCaption(0) = "Tab 0") Then
            TabCaption(0) = "Home"
        End If
        lblTDILabel.Visible = mTDIMode <> ntTDIModeNone
        lblTDILabel.ZOrder
        TabVisible(0) = True
        lblTDILabel.ForeColor = mForeColorSelectedTab
        DrawDelayed
    Else
        ' the block that re-checked FontExists on the button icon font went away with the
        ' button no longer being persisted: the font is now picked on the machine that runs
        If mTDIMode = ntTDIModeControls Then
            TDIStoreTab0ControlInfo
            mTDILastTabNumber = mTDILastTabNumber + 1
            If mTDIMode = ntTDIModeControls Then
                iTabCaption = mTDIDefaultTabCaption
            End If
            iLoadTabControls = True
            iShowTabCloseButton = True
            RaiseEvent TDIBeforeNewTab(ntDefaultTab, mTDILastTabNumber, iTabCaption, iLoadTabControls, iShowTabCloseButton, False)
            TDIPrepareNewTab iTabCaption, iLoadTabControls, , , iShowTabCloseButton
            TabVisible(0) = False
        End If
    End If
    mSettingTDIMode = False
    If mTDIMode = ntTDIModeForms Then
        If mAmbientUserMode Then
            ReDim mTDIModeFormsFormData_FormHwnd(100)
            ReDim mTDIModeFormsFormData_OldParentHwnd(100)
            ReDim mTDIModeFormsFormData_FormIcon(100)
            ReDim mTDIFormIconLastHwnd(100)
            ReDim mTDIFormWithoutCloseButton(100)
            InstallCBTHook Me
        End If
    End If
    Redraw = True
    
End Sub

Private Sub TDIStoreTab0ControlInfo()
    Dim c As Long
    Dim ub As Long
    Dim i As Long
    Dim iCtl As Object
    
    c = -1
    ub = 100
    ReDim mTDIControlNames(ub)
    For Each iCtl In TabControls(0)
        i = -1
        On Error Resume Next
        i = iCtl.Index
        On Error GoTo 0
        If i = 0 Then ' only controls with Index = 0
            c = c + 1
            If c > ub Then
                ub = ub + 100
                ReDim Preserve mTDIControlNames(ub)
            End If
            mTDIControlNames(c) = iCtl.Name
        End If
    Next
    mTDIControlNames_Count = c + 1
    If mTDIControlNames_Count > 0 Then
        ReDim Preserve mTDIControlNames(c)
    Else
        ReDim mTDIControlNames(c To c)
    End If
End Sub

Private Function TDIAddNewTab(Optional Position As Variant, Optional Focused As Boolean = True, Optional ByVal nTabType As NTTDINewTabTypeConstants = ntNewTabByClickingIcon, Optional nTabCaption As String = "") As Boolean
    Dim iCancel As Boolean
    Dim iLoadTabControls As Boolean
    Dim iShowTabCloseButton As Boolean
    
    If Not mTDIAddingNewTabForForm Then
        If mTDIMode <> ntTDIModeControls Then
            RaiseError 1381, TypeName(Me), "TDIAddNewTab only available for TDIMode = ntTDIModeControls"
            Exit Function
        End If
        If Not IsMissing(Position) Then
            If Position < 0 Then
                RaiseError 5, TypeName(Me) ' Invalid procedure call or argument
                Exit Function
            ElseIf Position > TabsWithoutNewTabButton Then ' the button's index is not a position the caller may ask for
                RaiseError 5, TypeName(Me) ' Invalid procedure call or argument
                Exit Function
            End If
        End If
    End If
    mTDILastTabNumber = mTDILastTabNumber + 1
    
    If (nTabType <> ntTDIForm) And (nTabCaption = "") Then
        nTabCaption = mTDINewTabCaption
    End If
    iLoadTabControls = True
    iShowTabCloseButton = True
    RaiseEvent TDIBeforeNewTab(nTabType, mTDILastTabNumber, nTabCaption, iLoadTabControls, iShowTabCloseButton, iCancel)
    If Not iCancel Then
        TDIPrepareNewTab nTabCaption, iLoadTabControls, IIf(IsMissing(Position), -1, CLng(Position)), Focused, iShowTabCloseButton
        TDIAddNewTab = True
    End If
End Function

Private Sub TDIPrepareNewTab(nTabCaption As String, nLoadTabControls As Boolean, Optional ByVal nPosition As Long = -1, Optional nFocused As Boolean = True, Optional nShowTabCloseButton As Boolean = True)
    Dim iRedraw As Boolean
    Dim iNewTab As Long
    
    iRedraw = mRedraw
    mRedraw = False
    mTDIChangingTabCount = True
    SetTabCount mTabs + 1
    mTDIChangingTabCount = False
    
    mTDIAddingNewTab = True
    ' The tab that was just appended is the last one the developer has, which is mTabs - 2 when the
    ' new tab button is there to take the last index and mTabs - 1 when it is not.
    iNewTab = TabsWithoutNewTabButton - 1
    mTabData(iNewTab).TDITabNumber = mTDILastTabNumber
    
    mTabData(iNewTab).TDICloseButtonShown = nShowTabCloseButton
    TabCaption(iNewTab) = nTabCaption
    
    If nPosition = -1 Then
        nPosition = iNewTab
    End If
    ' MoveTabInternal: this is where a brand new tab is placed, not a reorder of the
    ' developer's, so it raises no events, and the public one would now refuse position 0
    MoveTabInternal iNewTab, CInt(nPosition)
    If nLoadTabControls Then
        TDILoadNewTabControls nPosition
    End If
    
    If nFocused Then
        TabSel = nPosition
    End If
    mTDIAddingNewTab = False
    ' The index is handed over as well as the number: everything else on the control is addressed by
    ' index, so a handler that only got the number had to know about TDIGetTabIndexByTabNumber to do
    ' anything with the tab it was just told about.
    RaiseEvent TDINewTabAdded(mTDILastTabNumber, TDIGetTabIndexByTabNumber(mTDILastTabNumber))
    mTabData(mTabs - 1).Hovered = False
    mRedraw = iRedraw
    DrawDelayed
End Sub

Private Sub TDILoadNewTabControls(ByVal nTabPosition As Long)
    Dim c As Long
    Dim iCtl As Object
    Dim iCtl0 As Object
    Dim iAuxLeft As Long
    Dim iIsLine  As Boolean
    Dim iContainer As Object
    Dim iContainer0 As Object
    
    ' load controls and set position
    For c = 0 To mTDIControlNames_Count - 1
        Set iCtl = UserControl.Parent.Controls(mTDIControlNames(c), mTDILastTabNumber)
        Set iCtl0 = UserControl.Parent.Controls(mTDIControlNames(c), 0) ' same control on first tab
        On Error Resume Next
        Load iCtl
        If Err.Number Then
            MsgBox "Control arrays must have only Index 0! Check " & iCtl.Name & "(" & iCtl.Index & "), vbExclamation"
            Exit Sub
        End If
        Err.Clear
        iAuxLeft = -1.01
        iIsLine = False
        If TypeName(iCtl) = "Line" Then
            iAuxLeft = iCtl.X1
            iIsLine = True
        Else
            iAuxLeft = iCtl.Left
        End If
        On Error GoTo 0
        If iAuxLeft <> -1.01 Then
            On Error Resume Next
            Set iContainer = Nothing
            Set iContainer = iCtl.Container
            On Error GoTo 0
            If iContainer Is UserControl.Extender Then
                If iIsLine Then
                    ControlMove iCtl.Name & "(" & iCtl.Index & ")", ControlLeft(mTDIControlNames(c) & "(0)"), iCtl0.Y1, iCtl0.X2 - iCtl0.X1, iCtl0.Y2 - iCtl0.Y1, CInt(nTabPosition)
                Else
                    ControlMove iCtl.Name & "(" & iCtl.Index & ")", ControlLeft(mTDIControlNames(c) & "(0)"), iCtl0.Top, iCtl0.Width, iCtl0.Height, CInt(nTabPosition)
                End If
            End If
        End If
    Next
    ' set containers
    For c = 0 To mTDIControlNames_Count - 1
        Set iCtl = UserControl.Parent.Controls(mTDIControlNames(c), mTDILastTabNumber)
        Set iCtl0 = UserControl.Parent.Controls(mTDIControlNames(c), 0) ' same control on first tab
        Set iContainer0 = Nothing
        On Error Resume Next
        Set iContainer0 = iCtl0.Container
        On Error GoTo 0
        Set iContainer = Nothing
        If Not iContainer0 Is Nothing Then
            If Not iContainer0 Is UserControl.Extender Then
                Set iContainer = UserControl.Parent.Controls(iContainer0.Name, mTDILastTabNumber)
                Set iCtl.Container = iContainer
            End If
        End If
    Next
    ' set visible
    For c = 0 To mTDIControlNames_Count - 1
        Set iCtl = UserControl.Parent.Controls(mTDIControlNames(c), mTDILastTabNumber)
        Set iCtl0 = UserControl.Parent.Controls(mTDIControlNames(c), 0)
        On Error Resume Next
        iCtl.Visible = iCtl0.Visible
        On Error GoTo 0
    Next
    PropertyChanged False
End Sub

Public Function TDIGetTabIndexByTabNumber(ByVal nTabNumber As Long) As Long
Attribute TDIGetTabIndexByTabNumber.VB_Description = "When in TDI mode, it returns the Index of a tab given its number."
    Dim c As Long
    
    ' mTabData(c) and not mTabData(mTabUnderMouse): the loop walked the tabs but always read
    ' the one under the mouse, so the answer had nothing to do with nTabNumber
    For c = 0 To mTabs - 1
        If mTabData(c).TDITabNumber = nTabNumber Then
            TDIGetTabIndexByTabNumber = c
            Exit Function
        End If
    Next
    ' the missing = made this a recursive call, not an assignment: every number that was not
    ' found called the function again and ran out of stack
    TDIGetTabIndexByTabNumber = -1
End Function

Public Function TDIGetTabNumberByTabIndex(ByVal Index As Long) As Long
Attribute TDIGetTabNumberByTabIndex.VB_Description = "When in TDI mode, it returns the number of a tab given its Index."
    If (Index < 0) Or (Index >= mTabs) Then
        TDIGetTabNumberByTabIndex = -1
        Exit Function
    End If
    TDIGetTabNumberByTabIndex = mTabData(Index).TDITabNumber
End Function

Private Sub TDIUnloadTabControls(ByVal nTabNumber As Long)
    Dim iCtl As Object
    Dim c As Long
    
    For c = 0 To mTDIControlNames_Count - 1
        Set iCtl = UserControl.Parent.Controls(mTDIControlNames(c), nTabNumber)
        On Error Resume Next
        Set iCtl.Container = UserControl.Extender
        On Error GoTo 0
    Next
    For c = 0 To mTDIControlNames_Count - 1
        Set iCtl = UserControl.Parent.Controls(mTDIControlNames(c), nTabNumber)
        Unload iCtl
    Next
End Sub

' In the units of the container and stored in Himetric, like TabHeight, TabMinWidth and TabMaxWidth.
' It used to be twips on both faces, which is DPI-independent too but only lands right when the
' container happens to be in twips: inside a Frame or a PictureBox in pixels the developer wrote a
' number in the container's units and got something else
Public Property Let StripEndFreeSpace(ByVal nValue As Single)
Attribute StripEndFreeSpace.VB_Description = "Returns/sets the size of an optional free space after the last tab (for top-oriented tabs that is the rightmost tab). This value is in units of the container."
Attribute StripEndFreeSpace.VB_ProcData.VB_Invoke_PropertyPut = "pagNewTabStrip;Strip"
    Dim iValue As Single
    
    ' A negative free space made the tab strip wider than the control and cut the last tabs off,
    ' which is not a use of the property, it is the absence of a check.
    If nValue < 0 Then
        RaiseError 380, TypeName(Me) ' invalid property value
        Exit Property
    End If
    iValue = FromContainerSizeX(nValue, vbHimetric)
    If Round(iValue * 10000) <> Round(mStripEndFreeSpace * 10000) Then
        mStripEndFreeSpace = iValue
        SetPropertyChanged "StripEndFreeSpace"
        DrawDelayed
    End If
End Property

Public Property Get StripEndFreeSpace() As Single
    StripEndFreeSpace = FixRoundingError(ToContainerSizeX(mStripEndFreeSpace, vbHimetric))
End Property

Public Property Get MouseTab() As Long
Attribute MouseTab.VB_Description = "Returns the index of the tab under the mouse. If there is no tab under the mouse it returns -1."
    MouseTab = mTabUnderMouse
End Property

Friend Function IsParentEnabled() As Boolean
    On Error Resume Next
    IsParentEnabled = UserControl.Parent.Enabled
    Err.Clear
End Function

Friend Sub TDIPutFormIntoTab(ByVal nHwndForm As LongPtr)
    Const WS_CAPTION As Long = &HC00000
    Const WS_THICKFRAME As Long = &H40000
    Const GWL_STYLE As Long = (-16)
    Const WM_GETICON As Long = &H7F
    Const ICON_BIG As Long = 1
    Const WS_SYSMENU = &H80000
    Dim iIconHandle As LongPtr
    Dim iFormCaption As String
    Dim iContainerLeft As Single
    Dim iNewTab As Long
    
    mTDIAddingNewTabForForm = True
    iFormCaption = GetWindowCaption(nHwndForm)
    ' TabsWithoutNewTabButton and not mTabs: the position asked for is "after everything the
    ' developer has", and with the new tab button present mTabs is the button's own index, so
    ' the new tab was placed on top of it and left it second to last for good
    If TDIAddNewTab(TabsWithoutNewTabButton, , ntTDIForm, iFormCaption) Then
        ' The tab just created is the last one the developer has: mTabs - 2 while the new tab button
        ' holds the last index, mTabs - 1 when there is no button.
        iNewTab = TabsWithoutNewTabButton - 1
        ' the per form arrays and picTDIFormContainer are indexed by mTabData(t).Data, which is
        ' the tab's index at creation time and stays valid because TDI Forms never removes a
        ' tab: closing one hides it, so no index is ever reused
        If UBound(mTDIModeFormsFormData_FormHwnd) < iNewTab Then
            ReDim Preserve mTDIModeFormsFormData_FormHwnd(mTabs + 100)
            ReDim Preserve mTDIModeFormsFormData_OldParentHwnd(mTabs + 100)
            ReDim Preserve mTDIModeFormsFormData_FormIcon(mTabs + 100)
            ReDim Preserve mTDIFormIconLastHwnd(mTabs + 100)
            ReDim Preserve mTDIFormWithoutCloseButton(mTabs + 100)
        End If
        mTDIModeFormsFormData_FormHwnd(iNewTab) = nHwndForm
        mTabData(iNewTab).Data = iNewTab
        
        Load picTDIFormContainer(iNewTab)
        UserControl.ScaleMode = vbTwips
        ' see the note in TDIResizeFormContainers
        iContainerLeft = ClientLeft
            picTDIFormContainer(iNewTab).Move iContainerLeft, ClientTop, ClientWidth, ClientHeight
        SetWindowRgn picTDIFormContainer(iNewTab).hWnd, CloneRegion(mClientRegion), True
        SetScaleMode
        SetWindowLong nHwndForm, GWL_STYLE, GetWindowLong(nHwndForm, GWL_STYLE) And Not (WS_CAPTION Or WS_THICKFRAME)
        MoveWindow nHwndForm, 0, 0, mBodyRect.Right - mBodyRect.Left + 2, mBodyRect.Bottom - mBodyRect.Top + 3, 1
        mTDIFormWithoutCloseButton(iNewTab) = (GetWindowLong(nHwndForm, GWL_STYLE) And WS_SYSMENU) = 0
        
        mTDISubclassedFormsHwnds.Add nHwndForm, CStr(nHwndForm)
        AttachMessage Me, nHwndForm, WM_STYLECHANGING
        AttachMessage Me, nHwndForm, WM_DESTROY
        AttachMessage Me, nHwndForm, WM_SHOWWINDOW
        
        mTDIModeFormsFormData_OldParentHwnd(iNewTab) = SetParent(nHwndForm, picTDIFormContainer(iNewTab).hWnd)
        picTDIFormContainer(iNewTab).Visible = True
        
        iIconHandle = SendMessage(nHwndForm, WM_GETICON, ICON_BIG, 0)
        If iIconHandle <> 0 Then
            Set mTDIModeFormsFormData_FormIcon(iNewTab) = CreatePicture(iIconHandle, vbPicTypeIcon)
        End If
        
        mTabData(iNewTab).Caption = GetUniqueCaption(iFormCaption, iNewTab)
        mTDIAddingNewTabForForm = False
        DrawDelayed
    End If
    mTDIAddingNewTabForForm = False
End Sub

Private Function CreatePicture(ByVal Handle As LongPtr, ByVal PicType As PictureTypeConstants) As IPictureDisp
    Dim PICD As PICTDESC, iid As CLSID, NewPicture As IPicture
    
    If Handle = 0 Then Exit Function
    
    With PICD
        .cbSizeOfStruct = LenB(PICD)
        .PicType = PicType
        .hImage = Handle
    End With
    With iid
        .Data1 = &H7BF80980
        .Data2 = &HBF32
        .Data3 = &H101A
        .Data4(0) = &H8B
        .Data4(1) = &HBB
        .Data4(3) = &HAA
        .Data4(5) = &H30
        .Data4(6) = &HC
        .Data4(7) = &HAB
    End With
    If OleCreatePictureIndirect(PICD, iid, 1, NewPicture) = 0 Then Set CreatePicture = NewPicture
End Function

Private Function GetUniqueCaption(nCaption As String, nTabToIgnore As Long) As String
    Dim c As Long
    Dim iFound As Boolean
    Dim iCaption As String
    Dim n As Long
    Dim n2 As Long
    Dim iStr As String
    Dim iLenStr As String
    Dim iLng As Long
    
    n = 1
    Do
        iFound = False
        If n > 1 Then
            n2 = n
            iStr = nCaption & "("
            iLenStr = Len(iStr)
            For c = 1 To mTabs - 1
                If Left$(mTabData(c).Caption, iLenStr) = iStr Then
                    iLng = Val(Mid$(mTabData(c).Caption, iLenStr + 1)) + 1
                    If iLng > n2 Then
                        n2 = iLng
                    End If
                End If
            Next
            If mRightToLeft Then
                iCaption = "(" & n2 & ") " & nCaption
            Else
                iCaption = nCaption & " (" & n2 & ")"
            End If
        Else
            iCaption = nCaption
        End If
        For c = 1 To mTabs - 1
            If mTabData(c).Visible Then
                If c <> nTabToIgnore Then
                    If mTabData(c).Caption = iCaption Then
                        iFound = True
                        Exit For
                    End If
                End If
            End If
        Next
        If Not iFound Then
            GetUniqueCaption = iCaption
            Exit Function
        End If
        n = n + 1
    Loop
End Function

Private Function GetWindowCaption(ByVal hWnd As LongPtr) As String
    Dim Buffer As String
    Const WM_GETTEXT = &HD
    
    Buffer = String$(GetWindowTextLength(hWnd) + 1, vbNullChar)
    GetWindowCaption = Left$(Buffer, DefWindowProcW(hWnd, WM_GETTEXT, Len(Buffer), StrPtr(Buffer)))
End Function

Friend Sub TDIFormClosing(ByVal nHwndForm As LongPtr)
    Dim c As Long
    Dim i As Long
    Dim iDone As Boolean
    Const WA_ACTIVE As Long = 1
    Dim iHwnd As LongPtr
    
    If mShowingModalForm Then
        PostMessage mFormHwnd, WM_NCACTIVATE, WA_ACTIVE, 0&
        mShowingModalForm = False
    End If
    
    iHwnd = 0
    On Error Resume Next
    iHwnd = mTDISubclassedFormsHwnds(CStr(nHwndForm))
    On Error GoTo 0
    If iHwnd <> 0 Then
        DetachMessage Me, nHwndForm, WM_STYLECHANGING
        DetachMessage Me, nHwndForm, WM_DESTROY
        DetachMessage Me, nHwndForm, WM_SHOWWINDOW
        mTDISubclassedFormsHwnds.Remove CStr(nHwndForm)
    End If
    
    i = TDIGetTabByFormHwnd(nHwndForm)
    If i > -1 Then
        If (mTabData(i).Data >= picTDIFormContainer.LBound) And (mTabData(i).Data <= picTDIFormContainer.UBound) Then
           picTDIFormContainer(mTabData(i).Data).Visible = False
        End If
        mTabData(i).Visible = False
        ' Not TabVisible(i) = False: this runs while the form is being destroyed and does its own
        ' selection hand-over a few lines below, which the property would duplicate.
        mSetAutoTabHeightPending = True
        DrawDelayed
        ' a form the program unloaded closes its tab too; when the close came from the tab,
        ' HandleTabTDIEvents raises the event
        If Not mTDIFormCloseFromControl Then RaiseEvent TDITabClosed(mTabData(i).TDITabNumber, VisibleTabsWithoutNewTabButton = 1)
        If i = mTab Then ' only reassign the active tab if the one closing was the active one
            ' the search stops at 1 and not at 0 on purpose: another form is preferred over the home
            ' tab, which is the last resort a few lines below.
            For c = i - 1 To 1 Step -1
                If mTabData(c).Visible Then
                    TabSel = c
                    iDone = True
                    Exit For
                End If
            Next
            If Not iDone Then
                For c = i + 1 To mTabs - 1
                    If mTabData(c).Visible And Not TabIsNewTabButton(c) Then
                        TabSel = c
                        iDone = True
                        Exit For
                    End If
                Next
            End If
            If Not iDone Then
                If TabVisible(0) = True Then
                    TabSel = 0
                End If
            End If
        End If
    End If
End Sub

Friend Sub TDIFocusForm(ByVal nHwndForm As LongPtr)
    Dim c As Long
    Const WA_ACTIVE As Long = 1
    
    If mAppDeactivated Then
        PostMessage mFormHwnd, WM_NCACTIVATE, WA_ACTIVE, 0&
        mAppDeactivated = False
    End If
    
    For c = mTabs - 1 To 1 Step -1
        If mTDIModeFormsFormData_FormHwnd(mTabData(c).Data) = nHwndForm Then
            If mTabData(c).Visible Then
                TabSel = c
            End If
            Exit For
        End If
    Next
End Sub

Friend Sub ShowsModalForm()
    Const WA_INACTIVE As Long = 0
    
    PostMessage mFormHwnd, WM_NCACTIVATE, WA_INACTIVE, 0&
    mShowingModalForm = True
End Sub
    
Public Function SelectTab(ByVal Find As Variant, Optional ByVal Method As NTFindTabMethodConstants = ntFindCaption, Optional StartingTab As Variant) As Boolean
Attribute SelectTab.VB_Description = "Sets the selected tab by means that are not available in the Tab property."
    Dim t As Long
    
    t = FindTab(Find, Method, StartingTab)
    If t > -1 Then
        TabSel = t
        SelectTab = True
    End If
End Function

Public Function FindTab(ByVal Find As Variant, Optional ByVal Method As NTFindTabMethodConstants = ntFindCaption, Optional StartingTab As Variant) As Long
Attribute FindTab.VB_Description = "Finds a tab based on the values provided in the parameters and returns its index. If the tab is not found, it returns -1."
    Dim c As Long
    Dim iStartingTab As Long
    Dim iCtlName As String
    Dim iCtl As Object
    
    If Not IsMissing(StartingTab) Then
        iStartingTab = Val(StartingTab)
    End If
    FindTab = -1
    If Method = ntFindCaption Then
        Find = LCase$(Find)
        For c = iStartingTab To mTabs - 1
            If LCase$(mTabData(c).Caption) = Find Then
                FindTab = c
                Exit Function
            End If
        Next
    ElseIf Method = ntFindOriginalIndex Then
        For c = iStartingTab To mTabs - 1
            If mTabData(c).OriginalIndex = Find Then
                FindTab = c
                Exit Function
            End If
        Next
    ElseIf Method = ntFindData Then
        For c = iStartingTab To mTabs - 1
            If mTabData(c).Data = Find Then
                FindTab = c
                Exit Function
            End If
        Next
    ElseIf Method = ntFindTag Then
        For c = iStartingTab To mTabs - 1
            If mTabData(c).Tag = Find Then
                FindTab = c
                Exit Function
            End If
        Next
    ElseIf Method = ntFindPartialCaption Then
        For c = iStartingTab To mTabs - 1
            If InStr(1, mTabData(c).Caption, Find, vbTextCompare) > 0 Then
                FindTab = c
                Exit Function
            End If
        Next
    ElseIf Method = ntFindPartialCaptionReverse Then
        If IsMissing(StartingTab) Then
            iStartingTab = mTabs - 1
        End If
        For c = iStartingTab To 0 Step -1
            If InStr(1, mTabData(c).Caption, Find, vbTextCompare) > 0 Then
                FindTab = c
                Exit Function
            End If
        Next
    ElseIf Method = ntFindKey Then
        For c = iStartingTab To mTabs - 1
            Dim iLCFind As String
            
            iLCFind = LCase(Find)
            If LCase$(mTabData(c).Key) = iLCFind Then
                FindTab = c
                Exit Function
            End If
        Next
    ElseIf Method = ntFindContainedControl Then
        If IsObject(Find) Then
            Set iCtl = Find
            iCtlName = ControlName(iCtl)
        ElseIf VarType(Find) = vbString Then
            iCtlName = Find
        End If
        For c = iStartingTab To mTabs - 1
            If ControlIsInTab(iCtlName, c) Then
                FindTab = c
                Exit Function
            End If
        Next
    End If
End Function


Public Function GetTabsOrder() As String
Attribute GetTabsOrder.VB_Description = "Returns a string with data containing the tabs order. CanReorderTabs must be set to True."
    Dim c As Long
    
    If mCanReorderTabs = False Then
        RaiseError 1381, TypeName(Me), "GetTabsOrder/SetTabsOrder need CanReorderTabs property to True."
        Exit Function
    End If
    
    For c = 0 To mTabs - 1
        If c > 0 Then GetTabsOrder = GetTabsOrder & ","
        GetTabsOrder = GetTabsOrder & mTabData(c).OriginalIndex
    Next
End Function


Public Sub SetTabsOrder(ByVal PosData As String)
Attribute SetTabsOrder.VB_Description = "Sets the tabs order using data previously obtained with GetTabsOrder. CanReorderTabs must be set to True."
    Dim iData() As String
    Dim c As Long
    Dim iAuxTabData() As T_TabData
    Dim iSet() As Boolean
    Dim oi As Long
    
    If mCanReorderTabs = False Then
        RaiseError 1381, TypeName(Me), "GetTabsOrder/SetTabsOrder need CanReorderTabs property to True."
        Exit Sub
    End If
    
    ReDim iAuxTabData(mTabs - 1)
    ReDim iSet(mTabs - 1)
    
    iData = Split(PosData, ",")
    
    For c = 0 To UBound(iData)
        If c < mTabs Then
            oi = FindTab(Val(iData(c)), ntFindOriginalIndex)
            If oi > -1 Then
                iAuxTabData(c) = mTabData(oi)
                iSet(c) = True
            End If
        End If
    Next
    
    For c = 0 To mTabs - 1
        If iSet(c) Then
            mTabData(c) = iAuxTabData(c)
        End If
    Next
    
    DrawDelayed
End Sub

Public Function GetThemeData() As String
Attribute GetThemeData.VB_Description = "Returns a string with the current theme data. It can be later applied with SetThemeData."
    GetThemeData = GetThemeStringFromControl(Me)
End Function


Public Sub SetThemeData(ByVal nThemeData As String)
Attribute SetThemeData.VB_Description = "Applies a theme from data contained in a String. That string can be obtained with GetThemeData."
    Dim iTheme As NewTabTheme
    
    Set iTheme = New NewTabTheme
    iTheme.ThemeString = nThemeData
    ApplyThemeToControl iTheme.Data, Me, Ambient.BackColor, Ambient.ForeColor
End Sub


Public Property Get TabFixedWidth(ByVal nTab As Variant) As Single
Attribute TabFixedWidth.VB_Description = "Returns/sets a fixed width for a tab. To set it for its automatic width (according to the TabWidthStyle setting), set it to 0. This value is in units of the container."
Attribute TabFixedWidth.VB_ProcData.VB_Invoke_Property = ";Tabs"
    Dim iIndex As Long
    
    iIndex = GetTabIndex(nTab)
    If Not IsValidTabIndex(iIndex) Then
        RaiseError 381, TypeName(Me) ' invalid property array index
        Exit Property
    End If
    TabFixedWidth = FixRoundingError(ToContainerSizeX(mTabData(iIndex).FixedWidth, vbHimetric))
End Property

Public Property Let TabFixedWidth(ByVal nTab As Variant, ByVal nValue As Single)
    Dim iIndex As Long
    Dim iValue As Single
    
    iIndex = GetTabIndex(nTab)
    If Not IsValidTabIndex(iIndex) Then
        RaiseError 381, TypeName(Me) ' invalid property array index
        Exit Property
    End If
    ' Validated before the equality guard and not inside it: with it inside, assigning the same
    ' negative value a second time passed silently
    If nValue < 0 Then
        RaiseError 380, TypeName(Me) ' invalid property value
        Exit Property
    End If
    ' Compared after converting. The old guard held the twips coming in against the pixels already
    ' stored, so it almost never cut, and every assignment marked the form dirty and asked for a
    ' redraw even when nothing had changed
    iValue = FromContainerSizeX(nValue, vbHimetric)
    If Round(iValue * 10000) <> Round(mTabData(iIndex).FixedWidth * 10000) Then
        mTabData(iIndex).FixedWidth = iValue
        SetPropertyChanged "TabFixedWidth"
        DrawDelayed
    End If
End Property

Private Function ColorsHaveEnoughContrast(ByVal nColor1 As Long, ByVal nColor2 As Long, Optional ByVal Threshold As Long = 120) As Boolean
    Dim c1 As Long
    Dim c2 As Long
    
    TranslateColor nColor1, 0&, c1
    TranslateColor nColor2, 0&, c2
    
    ColorsHaveEnoughContrast = Abs(PerceivedLightness(c1) - PerceivedLightness(c2)) > Threshold
End Function

' Luma on the 0-240 scale of HLS lightness, so that the thresholds keep their meaning: for a
' gray both give the same number. Not HLS lightness itself, which rates pure blue and pure
' yellow the same
Private Function PerceivedLightness(ByVal nRGB As Long) As Long
    PerceivedLightness = ((nRGB And &HFF&) * 299& + ((nRGB \ &H100&) And &HFF&) * 587& + ((nRGB \ &H10000) And &HFF&) * 114&) * 240& \ 255000
End Function


' Always a resolved colour and never a marker, which is its contract and the reason the
' property pages cannot read it alone: for the thirteen slots of the chain what it resolves is
' the tab's own inheritance, so a slot nobody set answers with the nearest ancestor somebody
' did, which is not the general property any more. TabCustomColorIsSet is the honest state
Public Property Get TabCustomColor(ByVal nTab As Variant, Optional ByVal ColorID As NTTabCustomColorIDConstants = ntCCBackColorTab) As OLE_COLOR
Attribute TabCustomColor.VB_Description = "Returns/sets a custom color for a tab. It may be a color when it is inactive or active."
Attribute TabCustomColor.VB_ProcData.VB_Invoke_Property = ";Tabs"
    Dim iIndex As Long
    
    iIndex = GetTabIndex(nTab)
    If Not IsValidTabIndex(iIndex) Then
        RaiseError 381, TypeName(Me) ' invalid property array index
        Exit Property
    End If
    If (ColorID < 0) Or (ColorID > ntCCFlatTabBorderColorInactive) Then
        RaiseError 1382, TypeName(Me), "invalid ColorID."
        Exit Property
    End If
    
    Select Case ColorID
        Case ntCCBackColorTab
            If IsEmpty(mTabData(iIndex).CustomColors.BackColorTab) Then
                TabCustomColor = mBackColorTabs
            Else
                TabCustomColor = mTabData(iIndex).CustomColors.BackColorTab
            End If
        Case ntCCBackColorSelectedTab
            If IsEmpty(mTabData(iIndex).CustomColors.BackColorSelectedTab) Then
                TabCustomColor = mBackColorSelectedTab
            Else
                TabCustomColor = mTabData(iIndex).CustomColors.BackColorSelectedTab
            End If
        Case ntCCHighlightColor
            If IsEmpty(mTabData(iIndex).CustomColors.HighlightColor) Then
                TabCustomColor = mHighlightColor
            Else
                TabCustomColor = mTabData(iIndex).CustomColors.HighlightColor
            End If
        Case ntCCHighlightColorSelectedTab
            If IsEmpty(mTabData(iIndex).CustomColors.HighlightColorSelectedTab) Then
                TabCustomColor = mHighlightColorSelectedTab
            Else
                TabCustomColor = mTabData(iIndex).CustomColors.HighlightColorSelectedTab
            End If
        Case ntCCHighlightGradientColor
            If Not IsEmpty(mTabData(iIndex).CustomColors.HighlightGradientColor) Then
                TabCustomColor = mTabData(iIndex).CustomColors.HighlightGradientColor
            ElseIf (Not mHighlightGradientColor_IsAutomatic) Or IsEmpty(mTabData(iIndex).CustomColors.BackColorTab) Then
                TabCustomColor = mHighlightGradientColor
            Else
                TabCustomColor = mTabData(iIndex).CustomColors.BackColorTab
            End If
        Case ntCCHighlightGradientColorSelectedTab
            If Not IsEmpty(mTabData(iIndex).CustomColors.HighlightGradientColorSelectedTab) Then
                TabCustomColor = mTabData(iIndex).CustomColors.HighlightGradientColorSelectedTab
            ElseIf (Not mHighlightGradientColorSelectedTab_IsAutomatic) Or IsEmpty(mTabData(iIndex).CustomColors.BackColorSelectedTab) Then
                TabCustomColor = mHighlightGradientColorSelectedTab
            Else
                TabCustomColor = mTabData(iIndex).CustomColors.BackColorSelectedTab
            End If
        Case ntCCFlatBarColorInactive
            If IsEmpty(mTabData(iIndex).CustomColors.FlatBarColorInactive) Then
                TabCustomColor = mFlatBarColorInactive
            Else
                TabCustomColor = mTabData(iIndex).CustomColors.FlatBarColorInactive
            End If
        Case ntCCFlatBarColorHighlighted
            TabCustomColor = FlatBarColorHighlightedFor(iIndex)
        Case ntCCFlatBarColorSelectedTab
            If IsEmpty(mTabData(iIndex).CustomColors.FlatBarColorSelectedTab) Then
                TabCustomColor = mFlatBarColorSelectedTab
            Else
                TabCustomColor = mTabData(iIndex).CustomColors.FlatBarColorSelectedTab
            End If
        Case ntCCFlatTabBorderColorHighlighted
            TabCustomColor = mTabData(iIndex).CustomColors.ResolvedChainColor(ntChainFlatTabBorderColorHighlighted)
        Case ntCCFlatTabBorderColorSelectedTab
            TabCustomColor = mTabData(iIndex).CustomColors.ResolvedChainColor(ntChainFlatTabBorderColorSelectedTab)
        Case ntCCFlatTabBorderColorInactive
            TabCustomColor = mTabData(iIndex).CustomColors.ResolvedChainColor(ntChainFlatTabBorderColorInactive)
        Case ntCCForeColor
            TabCustomColor = mTabData(iIndex).CustomColors.ResolvedChainColor(ntChainForeColor)
        Case ntCCForeColorHighlighted
            TabCustomColor = mTabData(iIndex).CustomColors.ResolvedChainColor(ntChainForeColorHighlighted)
        Case ntCCForeColorSelectedTab
            TabCustomColor = mTabData(iIndex).CustomColors.ResolvedChainColor(ntChainForeColorSelectedTab)
        Case ntCCIconColor
            TabCustomColor = mTabData(iIndex).CustomColors.ResolvedChainColor(ntChainIconColor)
        Case ntCCIconColorSelectedTab
            TabCustomColor = mTabData(iIndex).CustomColors.ResolvedChainColor(ntChainIconColorSelectedTab)
        Case ntCCIconColorMouseHover
            TabCustomColor = mTabData(iIndex).CustomColors.ResolvedChainColor(ntChainIconColorMouseHover)
        Case ntCCIconColorMouseHoverSelectedTab
            TabCustomColor = mTabData(iIndex).CustomColors.ResolvedChainColor(ntChainIconColorMouseHoverSelectedTab)
        Case ntCCIconColorTabHighlighted
            TabCustomColor = mTabData(iIndex).CustomColors.ResolvedChainColor(ntChainIconColorTabHighlighted)
        Case ntCCCloseButtonColor
            TabCustomColor = mTabData(iIndex).CustomColors.ResolvedChainColor(ntChainCloseButtonColor)
        Case ntCCCloseButtonColorSelectedTab
            TabCustomColor = mTabData(iIndex).CustomColors.ResolvedChainColor(ntChainCloseButtonColorSelectedTab)
        Case ntCCCloseButtonColorMouseHover
            If IsEmpty(mTabData(iIndex).CustomColors.CloseButtonColorMouseHover) Then
                TabCustomColor = mCloseButtonColorMouseHover
            Else
                TabCustomColor = mTabData(iIndex).CustomColors.CloseButtonColorMouseHover
            End If
        Case ntCCCloseButtonColorMouseHoverSelectedTab
            If IsEmpty(mTabData(iIndex).CustomColors.CloseButtonColorMouseHoverSelectedTab) Then
                TabCustomColor = mCloseButtonColorMouseHoverSelectedTab
            Else
                TabCustomColor = mTabData(iIndex).CustomColors.CloseButtonColorMouseHoverSelectedTab
            End If
        Case ntCCCloseButtonColorTabHighlighted
            TabCustomColor = mTabData(iIndex).CustomColors.ResolvedChainColor(ntChainCloseButtonColorTabHighlighted)
    End Select
End Property

Public Property Let TabCustomColor(ByVal nTab As Variant, Optional ByVal ColorID As NTTabCustomColorIDConstants = ntCCBackColorTab, ByVal nValue As OLE_COLOR)
    Dim c As Long
    Dim iIndex As Long
    
    iIndex = GetTabIndex(nTab)
    If Not IsValidTabIndex(iIndex) Then
        RaiseError 381, TypeName(Me) ' invalid property array index
        Exit Property
    End If
    If (ColorID < 0) Or (ColorID > ntCCFlatTabBorderColorInactive) Then
        RaiseError 1382, TypeName(Me), "invalid ColorID."
        Exit Property
    End If
    If nValue <> -1 Then
        If Not IsValidOLE_COLOR(nValue) Then RaiseError 380, TypeName(Me): Exit Property
    End If
    
    ' Empty means the tab carries no colour of its own, and -1 is the only way to write it.
    Select Case ColorID
        Case ntCCBackColorTab
            If nValue = -1 Then
                mTabData(iIndex).CustomColors.BackColorTab = Empty
            Else
                mTabData(iIndex).CustomColors.BackColorTab = nValue
            End If
        Case ntCCBackColorSelectedTab
            If nValue = -1 Then
                mTabData(iIndex).CustomColors.BackColorSelectedTab = Empty
            Else
                mTabData(iIndex).CustomColors.BackColorSelectedTab = nValue
            End If
            SetColors
            ' the resolver reads the value that was just stored, so nothing has to be
            ' carried across. The gate was missing: a custom color used to recolor the
            ' children even with ChangeControlsBackColor off
            If (iIndex = mTab) And mChangeControlsBackColor Then SetControlsProperBackColor
        Case ntCCHighlightColor
            If nValue = -1 Then
                mTabData(iIndex).CustomColors.HighlightColor = Empty
            Else
                mTabData(iIndex).CustomColors.HighlightColor = nValue
            End If
        Case ntCCHighlightColorSelectedTab
            If nValue = -1 Then
                mTabData(iIndex).CustomColors.HighlightColorSelectedTab = Empty
            Else
                mTabData(iIndex).CustomColors.HighlightColorSelectedTab = nValue
            End If
            SetColors
        Case ntCCHighlightGradientColor
            If nValue = -1 Then
                mTabData(iIndex).CustomColors.HighlightGradientColor = Empty
            Else
                mTabData(iIndex).CustomColors.HighlightGradientColor = nValue
            End If
        Case ntCCHighlightGradientColorSelectedTab
            If nValue = -1 Then
                mTabData(iIndex).CustomColors.HighlightGradientColorSelectedTab = Empty
            Else
                mTabData(iIndex).CustomColors.HighlightGradientColorSelectedTab = nValue
            End If
            SetColors
        Case ntCCFlatBarColorInactive
            If nValue = -1 Then
                mTabData(iIndex).CustomColors.FlatBarColorInactive = Empty
            Else
                mTabData(iIndex).CustomColors.FlatBarColorInactive = nValue
                Dim iFlatBarColorHighlighted As Long
                
                iFlatBarColorHighlighted = FlatBarColorHighlightedFor(iIndex)
                ' The resting value is the far end of the mix, which is the highlight colour
                ' itself. The fade overwrites it while the mouse is on this tab and puts it
                ' back on the way out
                mTabData(iIndex).CustomColors.FlatBarGlowColor = iFlatBarColorHighlighted
            End If
        Case ntCCFlatBarColorHighlighted
            If nValue = -1 Then
                mTabData(iIndex).CustomColors.FlatBarColorHighlighted = Empty
            Else
                mTabData(iIndex).CustomColors.FlatBarColorHighlighted = nValue
                
                Dim iFlatBarColorInactive As Long
                
                If IsEmpty(mTabData(iIndex).CustomColors.FlatBarColorInactive) Then
                    iFlatBarColorInactive = mFlatBarColorInactive
                Else
                    iFlatBarColorInactive = mTabData(iIndex).CustomColors.FlatBarColorInactive
                End If
                mTabData(iIndex).CustomColors.FlatBarGlowColor = mTabData(iIndex).CustomColors.FlatBarColorHighlighted
            End If
        Case ntCCFlatBarColorSelectedTab
            If nValue = -1 Then
                mTabData(iIndex).CustomColors.FlatBarColorSelectedTab = Empty
            Else
                mTabData(iIndex).CustomColors.FlatBarColorSelectedTab = nValue
            End If
            SetColors
        Case ntCCFlatTabBorderColorInactive
            If nValue = -1 Then
                mTabData(iIndex).CustomColors.FlatTabBorderColorInactive = Empty
            Else
                mTabData(iIndex).CustomColors.FlatTabBorderColorInactive = nValue
            End If
        Case ntCCFlatTabBorderColorHighlighted
            If nValue = -1 Then
                mTabData(iIndex).CustomColors.FlatTabBorderColorHighlighted = Empty
            Else
                mTabData(iIndex).CustomColors.FlatTabBorderColorHighlighted = nValue
            End If
        Case ntCCFlatTabBorderColorSelectedTab
            If nValue = -1 Then
                mTabData(iIndex).CustomColors.FlatTabBorderColorSelectedTab = Empty
            Else
                mTabData(iIndex).CustomColors.FlatTabBorderColorSelectedTab = nValue
            End If
        Case ntCCForeColor
            If nValue = -1 Then
                mTabData(iIndex).CustomColors.ForeColor = Empty
            Else
                mTabData(iIndex).CustomColors.ForeColor = nValue
            End If
        Case ntCCForeColorHighlighted
            If nValue = -1 Then
                mTabData(iIndex).CustomColors.ForeColorHighlighted = Empty
            Else
                mTabData(iIndex).CustomColors.ForeColorHighlighted = nValue
            End If
        Case ntCCForeColorSelectedTab
            If nValue = -1 Then
                mTabData(iIndex).CustomColors.ForeColorSelectedTab = Empty
            Else
                mTabData(iIndex).CustomColors.ForeColorSelectedTab = nValue
            End If
        Case ntCCIconColor
            If nValue = -1 Then
                mTabData(iIndex).CustomColors.IconColor = Empty
            Else
                mTabData(iIndex).CustomColors.IconColor = nValue
            End If
        Case ntCCIconColorSelectedTab
            If nValue = -1 Then
                mTabData(iIndex).CustomColors.IconColorSelectedTab = Empty
            Else
                mTabData(iIndex).CustomColors.IconColorSelectedTab = nValue
            End If
        Case ntCCIconColorMouseHover
            If nValue = -1 Then
                mTabData(iIndex).CustomColors.IconColorMouseHover = Empty
            Else
                mTabData(iIndex).CustomColors.IconColorMouseHover = nValue
            End If
        Case ntCCIconColorMouseHoverSelectedTab
            If nValue = -1 Then
                mTabData(iIndex).CustomColors.IconColorMouseHoverSelectedTab = Empty
            Else
                mTabData(iIndex).CustomColors.IconColorMouseHoverSelectedTab = nValue
            End If
        Case ntCCIconColorTabHighlighted
            If nValue = -1 Then
                mTabData(iIndex).CustomColors.IconColorTabHighlighted = Empty
            Else
                mTabData(iIndex).CustomColors.IconColorTabHighlighted = nValue
            End If
        Case ntCCCloseButtonColor
            If nValue = -1 Then
                mTabData(iIndex).CustomColors.CloseButtonColor = Empty
            Else
                mTabData(iIndex).CustomColors.CloseButtonColor = nValue
            End If
        Case ntCCCloseButtonColorSelectedTab
            If nValue = -1 Then
                mTabData(iIndex).CustomColors.CloseButtonColorSelectedTab = Empty
            Else
                mTabData(iIndex).CustomColors.CloseButtonColorSelectedTab = nValue
            End If
        Case ntCCCloseButtonColorMouseHover
            If nValue = -1 Then
                mTabData(iIndex).CustomColors.CloseButtonColorMouseHover = Empty
            Else
                mTabData(iIndex).CustomColors.CloseButtonColorMouseHover = nValue
            End If
        Case ntCCCloseButtonColorMouseHoverSelectedTab
            If nValue = -1 Then
                mTabData(iIndex).CustomColors.CloseButtonColorMouseHoverSelectedTab = Empty
            Else
                mTabData(iIndex).CustomColors.CloseButtonColorMouseHoverSelectedTab = nValue
            End If
        Case ntCCCloseButtonColorTabHighlighted
            If nValue = -1 Then
                mTabData(iIndex).CustomColors.CloseButtonColorTabHighlighted = Empty
            Else
                mTabData(iIndex).CustomColors.CloseButtonColorTabHighlighted = nValue
            End If
    End Select
    ApplyTabChainColorsForTab iIndex
    ' After the resolver: the delivery reads the resolved color, and more than one slot moves it
    If (iIndex = mTab) And mChangeControlsForeColor Then SetControlsProperForeColor
    SetPropertyChanged "TabCustomColor"
    DrawDelayed
End Property

' The honest answer to "did anybody set this slot", which Property Get TabCustomColor cannot
' give: that one resolves and always hands back a colour. The property pages mirror the tabs
' and rewrite every slot on apply, so reading them through the resolving Get would write back
' every inherited slot as an explicit decision, which is the same trap as CopyControlProperties
Friend Property Get TabCustomColorIsSet(ByVal nTab As Variant, ByVal ColorID As NTTabCustomColorIDConstants) As Boolean
    Dim iIndex As Long
    
    ' No error raised on a bad argument, unlike the public pair. This is a question, not an
    ' access: the callers are the property pages of this project, they walk indices they
    ' already own, and a raise from inside their apply loop would abort a page, not a statement
    iIndex = GetTabIndex(nTab)
    If Not IsValidTabIndex(iIndex) Then Exit Property
    
    Select Case ColorID
        Case ntCCBackColorTab: TabCustomColorIsSet = Not IsEmpty(mTabData(iIndex).CustomColors.BackColorTab)
        Case ntCCBackColorSelectedTab: TabCustomColorIsSet = Not IsEmpty(mTabData(iIndex).CustomColors.BackColorSelectedTab)
        Case ntCCHighlightColor: TabCustomColorIsSet = Not IsEmpty(mTabData(iIndex).CustomColors.HighlightColor)
        Case ntCCHighlightColorSelectedTab: TabCustomColorIsSet = Not IsEmpty(mTabData(iIndex).CustomColors.HighlightColorSelectedTab)
        Case ntCCFlatBarColorInactive: TabCustomColorIsSet = Not IsEmpty(mTabData(iIndex).CustomColors.FlatBarColorInactive)
        Case ntCCFlatBarColorHighlighted: TabCustomColorIsSet = Not IsEmpty(mTabData(iIndex).CustomColors.FlatBarColorHighlighted)
        Case ntCCFlatBarColorSelectedTab: TabCustomColorIsSet = Not IsEmpty(mTabData(iIndex).CustomColors.FlatBarColorSelectedTab)
        Case ntCCFlatTabBorderColorHighlighted: TabCustomColorIsSet = Not IsEmpty(mTabData(iIndex).CustomColors.FlatTabBorderColorHighlighted)
        Case ntCCFlatTabBorderColorSelectedTab: TabCustomColorIsSet = Not IsEmpty(mTabData(iIndex).CustomColors.FlatTabBorderColorSelectedTab)
        Case ntCCForeColor: TabCustomColorIsSet = Not IsEmpty(mTabData(iIndex).CustomColors.ForeColor)
        Case ntCCForeColorHighlighted: TabCustomColorIsSet = Not IsEmpty(mTabData(iIndex).CustomColors.ForeColorHighlighted)
        Case ntCCForeColorSelectedTab: TabCustomColorIsSet = Not IsEmpty(mTabData(iIndex).CustomColors.ForeColorSelectedTab)
        Case ntCCIconColor: TabCustomColorIsSet = Not IsEmpty(mTabData(iIndex).CustomColors.IconColor)
        Case ntCCIconColorSelectedTab: TabCustomColorIsSet = Not IsEmpty(mTabData(iIndex).CustomColors.IconColorSelectedTab)
        Case ntCCIconColorMouseHover: TabCustomColorIsSet = Not IsEmpty(mTabData(iIndex).CustomColors.IconColorMouseHover)
        Case ntCCIconColorMouseHoverSelectedTab: TabCustomColorIsSet = Not IsEmpty(mTabData(iIndex).CustomColors.IconColorMouseHoverSelectedTab)
        Case ntCCIconColorTabHighlighted: TabCustomColorIsSet = Not IsEmpty(mTabData(iIndex).CustomColors.IconColorTabHighlighted)
        Case ntCCCloseButtonColor: TabCustomColorIsSet = Not IsEmpty(mTabData(iIndex).CustomColors.CloseButtonColor)
        Case ntCCCloseButtonColorSelectedTab: TabCustomColorIsSet = Not IsEmpty(mTabData(iIndex).CustomColors.CloseButtonColorSelectedTab)
        Case ntCCCloseButtonColorMouseHover: TabCustomColorIsSet = Not IsEmpty(mTabData(iIndex).CustomColors.CloseButtonColorMouseHover)
        Case ntCCCloseButtonColorMouseHoverSelectedTab: TabCustomColorIsSet = Not IsEmpty(mTabData(iIndex).CustomColors.CloseButtonColorMouseHoverSelectedTab)
        Case ntCCCloseButtonColorTabHighlighted: TabCustomColorIsSet = Not IsEmpty(mTabData(iIndex).CustomColors.CloseButtonColorTabHighlighted)
        Case ntCCHighlightGradientColor: TabCustomColorIsSet = Not IsEmpty(mTabData(iIndex).CustomColors.HighlightGradientColor)
        Case ntCCHighlightGradientColorSelectedTab: TabCustomColorIsSet = Not IsEmpty(mTabData(iIndex).CustomColors.HighlightGradientColorSelectedTab)
        Case ntCCFlatTabBorderColorInactive: TabCustomColorIsSet = Not IsEmpty(mTabData(iIndex).CustomColors.FlatTabBorderColorInactive)
    End Select
End Property

' The colour a per tab slot would show if nobody had set it. It is what the swatch of the Tabs
' page displays, and it stopped being the general property the day the tabs started inheriting:
' for the thirteen chain slots the answer is the resolver run over this tab with that one slot
' switched off. A tab whose ntCCForeColor is red gives its icon red without the general
' IconColor entering the answer at all.
'
' The tab's slots arrive by parameter and no tab index is taken, which is the whole point. The
' caller is a property page holding edits nobody applied yet, and neither side of it can answer:
' this control is a whole editing session behind, and the page's preview is only pushed for the
' tab and the slot being edited, so after an insert or a remove its other tabs still carry the
' colours of their old position. Handing the mirror in leaves one answer instead of two wrong
' ones, and is the same reason ResolveChainColors reads no module variable.
'
' nTabSlots is indexed by NTTabCustomColorIDConstants - it is the page's mirror as it stands -
' and Empty means the tab set no colour of its own, the same word cTabColors uses
Friend Function TabAutomaticCustomColor(ByRef nTabSlots() As Variant, ByVal ColorID As NTTabCustomColorIDConstants) As Long
    Dim iIsSet(cChainColorLast) As Boolean
    Dim iColor(cChainColorLast) As Long
    Dim iTabSlot(cChainColorLast) As Variant
    Dim iChainIndex As Long
    Dim iCC As Long
    Dim iCCLast As Long
    Dim c As Long
    
    Debug.Assert (ColorID >= ntCCBackColorTab) And (ColorID <= ntCCFlatTabBorderColorInactive)
    ' An automatic gradient colour is the back colour of that very tab
    If (ColorID = ntCCHighlightGradientColor) And mHighlightGradientColor_IsAutomatic And (Not IsEmpty(nTabSlots(ntCCBackColorTab))) Then
        TabAutomaticCustomColor = nTabSlots(ntCCBackColorTab)
        Exit Function
    End If
    If (ColorID = ntCCHighlightGradientColorSelectedTab) And mHighlightGradientColorSelectedTab_IsAutomatic And (Not IsEmpty(nTabSlots(ntCCBackColorSelectedTab))) Then
        TabAutomaticCustomColor = nTabSlots(ntCCBackColorSelectedTab)
        Exit Function
    End If
    iChainIndex = ChainIndexFromCustomColorID(ColorID)
    If iChainIndex < 0 Then
        TabAutomaticCustomColor = GeneralColorForCustomColorID(ColorID)
        Exit Function
    End If
    
    ' Re-indexed by the chain because that is what the resolver speaks. The slots with no chain
    ' node never get written and stay Empty, which is what they mean
    ' A page built before the last ids were added hands a shorter mirror
    iCCLast = UBound(nTabSlots)
    If iCCLast > ntCCFlatTabBorderColorInactive Then iCCLast = ntCCFlatTabBorderColorInactive
    For iCC = ntCCBackColorTab To iCCLast
        c = ChainIndexFromCustomColorID(iCC)
        If c >= 0 Then iTabSlot(c) = nTabSlots(iCC)
    Next iCC
    ' The one line that makes this "automatic" and not "effective". Falling through to the
    ' general node is right even when that node is set: an explicit general colour sits at
    ' distance 0 of itself and is what this slot would show
    iTabSlot(iChainIndex) = Empty
    
    For c = 0 To cChainColorLast
        If IsEmpty(iTabSlot(c)) Then
            iIsSet(c) = ChainColorIsSet(c)
            iColor(c) = ChainColorValue(c)
        Else
            iIsSet(c) = True
            iColor(c) = CLng(iTabSlot(c))
        End If
    Next c
    SeedTabChainRoots iIsSet, iColor, nTabSlots(ntCCFlatBarColorHighlighted), nTabSlots(ntCCFlatBarColorSelectedTab), nTabSlots(ntCCFlatBarColorInactive)
    ResolveChainColors iIsSet, iColor
    TabAutomaticCustomColor = iColor(iChainIndex)
End Function

' For the colour selector of the property pages: whether a general colour property is automatic,
' and the colour it takes when it is. False for the ones that have no automatic state
Friend Function ColorAutomaticState(ByVal nPropertyName As String, ByRef nIsAutomatic As Boolean, ByRef nAutomaticColor As Long) As Boolean
    Dim iIsSet(cChainColorLast) As Boolean
    Dim iColor(cChainColorLast) As Long
    Dim iChainIndex As Long
    Dim c As Long
    
    ColorAutomaticState = True
    iChainIndex = ChainIndexFromPropertyName(nPropertyName)
    If iChainIndex >= 0 Then
        For c = 0 To cChainColorLast
            iIsSet(c) = ChainColorIsSet(c)
            iColor(c) = ChainColorValue(c)
        Next c
        nIsAutomatic = Not iIsSet(iChainIndex)
        iIsSet(iChainIndex) = False
        SeedChainRoots iIsSet, iColor
        ResolveChainColors iIsSet, iColor
        nAutomaticColor = iColor(iChainIndex)
        Exit Function
    End If
    Select Case nPropertyName
        Case "BackColor": nIsAutomatic = mBackColorIsFromAmbient: nAutomaticColor = Ambient.BackColor
        Case "ForeColor": nIsAutomatic = mForeColorIsFromAmbient: nAutomaticColor = Ambient.ForeColor
        Case "BackColorTabs": nIsAutomatic = mBackColorTabsIsFromAmbient: nAutomaticColor = Ambient.BackColor
        Case "BackColorSelectedTab": nIsAutomatic = mBackColorSelectedTab_IsAutomatic: nAutomaticColor = GetAutomaticBackColorSelectedTab
        Case "HighlightColor": nIsAutomatic = mHighlightColor_IsAutomatic: nAutomaticColor = mHighlightColor_ColorAutomatic
        Case "HighlightColorSelectedTab": nIsAutomatic = mHighlightColorSelectedTab_IsAutomatic: nAutomaticColor = mHighlightColorSelectedTab_ColorAutomatic
        Case "HighlightGradientColor": nIsAutomatic = mHighlightGradientColor_IsAutomatic: nAutomaticColor = mHighlightGradientColor_ColorAutomatic
        Case "HighlightGradientColorSelectedTab": nIsAutomatic = mHighlightGradientColorSelectedTab_IsAutomatic: nAutomaticColor = mHighlightGradientColorSelectedTab_ColorAutomatic
        Case "FlatBarColorHighlighted": nIsAutomatic = mFlatBarColorHighlighted_IsAutomatic: nAutomaticColor = mFlatBarColorHighlighted_ColorAutomatic
        Case "FlatBarColorInactive": nIsAutomatic = mFlatBarColorInactive_IsAutomatic: nAutomaticColor = mFlatBarColorInactive_ColorAutomatic
        Case "FlatTabsSeparationLineColor": nIsAutomatic = mFlatTabsSeparationLineColor_IsAutomatic: nAutomaticColor = mFlatTabsSeparationLineColor_ColorAutomatic
        Case "FlatBodySeparationLineColor": nIsAutomatic = mFlatBodySeparationLineColor_IsAutomatic: nAutomaticColor = mFlatBodySeparationLineColor_ColorAutomatic
        Case "FlatBorderColor": nIsAutomatic = mFlatBorderColor_IsAutomatic: nAutomaticColor = mFlatBorderColor_ColorAutomatic
        Case Else
            ColorAutomaticState = False
    End Select
End Function

Public Property Get CaptionAlignment() As NTAlignmentConstants
Attribute CaptionAlignment.VB_Description = "Returns/sets the alignment of the tab captions."
Attribute CaptionAlignment.VB_ProcData.VB_Invoke_Property = ";Appearance"
    CaptionAlignment = mCaptionAlignment
End Property

Public Property Let CaptionAlignment(ByVal nValue As NTAlignmentConstants)
    If nValue <> mCaptionAlignment Then
        If (nValue < ntAlignmentLeft) Or (nValue > ntAlignmentCenter) Then
            RaiseError 380, TypeName(Me) ' invalid property value
            Exit Property
        End If
        mCaptionAlignment = nValue
        If mCaptionAlignment = ntAlignmentLeft Then
            mAlignmentDTFlag = DT_LEFT
        ElseIf mCaptionAlignment = ntAlignmentRight Then
            mAlignmentDTFlag = DT_RIGHT
        Else
            mAlignmentDTFlag = DT_CENTER
        End If
        DrawDelayed
        mSetAutoTabHeightPending = True
        SetPropertyChanged "CaptionAlignment"
    End If
End Property

Public Function TDIGetFormHwndByTab(ByVal Index As Long) As LongPtr
Attribute TDIGetFormHwndByTab.VB_Description = "When in TDI mode forms, it returns the hWnd of the form that is in that tab index."
    On Error Resume Next
    TDIGetFormHwndByTab = mTDIModeFormsFormData_FormHwnd(mTabData(Index).Data)
    Err.Clear
End Function

Public Function TDIGetTabByFormHwnd(ByVal FormhWnd As LongPtr) As Long
Attribute TDIGetTabByFormHwnd.VB_Description = "When in TDI mode forms, it returns the tab index by supplying the hWnd of the form."
    Dim c As Long
    
    TDIGetTabByFormHwnd = -1
    For c = 0 To mTabs - 1
        If mTDIModeFormsFormData_FormHwnd(mTabData(c).Data) = FormhWnd Then
            TDIGetTabByFormHwnd = c
            Exit For
        End If
    Next
End Function

Public Function GetTabOriginalIndex(ByVal nTab As Variant) As Long
Attribute GetTabOriginalIndex.VB_Description = "It returns the original index of the tab by supplying the current index. If CanReorderTabs is set to True, the tab index can change."
    Dim iIndex As Long
    Dim iFailed As Boolean
    
    iIndex = GetTabIndex(nTab, iFailed)
    If iFailed Then Exit Function
    ' 5 and not the 381 this used to raise: 381 means invalid property array index and this
    ' is a method, so VB itself would never produce it here. The indexed properties do raise
    ' 381, and that is correct for them
    If Not IsValidTabIndex(iIndex) Then
        RaiseError 5, TypeName(Me) ' Invalid procedure call or argument
        Exit Function
    End If
    GetTabOriginalIndex = mTabData(iIndex).OriginalIndex
End Function

Private Function IsNumericInteger(nValue As Variant) As Boolean
    Dim iVal As Variant
    
    IsNumericInteger = IsNumeric(nValue)
    If IsNumericInteger Then
        iVal = Val(nValue)
        IsNumericInteger = (iVal = Int(iVal))
    End If
End Function

Public Sub RefreshContainedControls()
Attribute RefreshContainedControls.VB_Description = "Forces the redraw of some controls that can be problematic because they don't draw correctly after changing tab. Invoke it in the Click event of the control (after changing tab)."
    Dim iCtl As Object
    
    On Error Resume Next
    ' Screen.TwipsPerPixelX stays raw here, and it is not an oversight.
    For Each iCtl In TabControls(mTab)
        iCtl.Width = iCtl.Width + Screen.TwipsPerPixelX
        iCtl.Width = iCtl.Width - Screen.TwipsPerPixelX
        iCtl.Refresh
    Next
    Err.Clear
End Sub

Friend Property Get Subclassed() As Boolean
    Subclassed = mSubclassed
End Property

Private Sub CreateClientRegion()
    Dim iRgnCorner As LongPtr
    Dim iRgnCircle As LongPtr
    Dim iRect As RECT
    Dim iLeftTopRoundness As Long
    Dim iRightTopRoundness As Long
    Dim iLeftBottomRoundness As Long
    Dim iRightBottomRoundness As Long
    
    Const RGN_DIFF As Long = 4
    Const RGN_AND  As Long = 1
    
    ' The roundness is stored for the unmirrored layout
    If mRightToLeft Then
        iLeftTopRoundness = mClientSpaceData.RightTopRoundness
        iRightTopRoundness = mClientSpaceData.LeftTopRoundness
        iLeftBottomRoundness = mClientSpaceData.RightBottomRoundness
        iRightBottomRoundness = mClientSpaceData.LeftBottomRoundness
    Else
        iLeftTopRoundness = mClientSpaceData.LeftTopRoundness
        iRightTopRoundness = mClientSpaceData.RightTopRoundness
        iLeftBottomRoundness = mClientSpaceData.LeftBottomRoundness
        iRightBottomRoundness = mClientSpaceData.RightBottomRoundness
    End If
    If mClientRegion <> 0 Then
        DeleteObject mClientRegion
        mClientRegion = 0
    End If
    If mAppearanceIsFlat Then
        If iLeftTopRoundness <> 0 Or iRightTopRoundness <> 0 Or iLeftBottomRoundness <> 0 Or iRightBottomRoundness <> 0 Then
            iRect.Left = 0
            iRect.Right = mClientSpaceData.RECT.Right - mClientSpaceData.RECT.Left
            iRect.Top = 0
            iRect.Bottom = mClientSpaceData.RECT.Bottom - mClientSpaceData.RECT.Top
            mClientRegion = CreateRectRgn(iRect.Left, iRect.Top, iRect.Right + 1, iRect.Bottom + 1)
            If iLeftTopRoundness <> 0 Then
                iRgnCorner = CreateRectRgn(iRect.Left, iRect.Top, iRect.Left + iLeftTopRoundness + 1, iRect.Top + iLeftTopRoundness + 1)
                iRgnCircle = CreateEllipticRgn(iRect.Left - 1, iRect.Top - 1, iRect.Left + iLeftTopRoundness * 2 + 3, iRect.Top + iLeftTopRoundness * 2 + 3)
                CombineRgn iRgnCorner, iRgnCorner, iRgnCircle, RGN_DIFF
                DeleteObject iRgnCircle
                CombineRgn mClientRegion, mClientRegion, iRgnCorner, RGN_DIFF
                DeleteObject iRgnCorner
            End If
            If iRightTopRoundness <> 0 Then
                iRgnCorner = CreateRectRgn(iRect.Right - iRightTopRoundness, iRect.Top, iRect.Right + 1, iRect.Top + iRightTopRoundness)
                iRgnCircle = CreateEllipticRgn(iRect.Right - iRightTopRoundness * 2 - 2, iRect.Top - 1, iRect.Right + 3, iRect.Top + iRightTopRoundness * 2 + 3)
                CombineRgn iRgnCorner, iRgnCorner, iRgnCircle, RGN_DIFF
                DeleteObject iRgnCircle
                CombineRgn mClientRegion, mClientRegion, iRgnCorner, RGN_DIFF
                DeleteObject iRgnCorner
            End If
            If iLeftBottomRoundness <> 0 Then
                iRgnCorner = CreateRectRgn(iRect.Left - 1, iRect.Bottom - iLeftBottomRoundness - 1, iRect.Left + iLeftBottomRoundness - 1, iRect.Bottom + 1)
                iRgnCircle = CreateEllipticRgn(iRect.Left - 1, iRect.Bottom - iLeftBottomRoundness * 2 - 1, iRect.Left + iLeftBottomRoundness * 2 + 3, iRect.Bottom + 3)
                CombineRgn iRgnCorner, iRgnCorner, iRgnCircle, RGN_DIFF
                DeleteObject iRgnCircle
                CombineRgn mClientRegion, mClientRegion, iRgnCorner, RGN_DIFF
                DeleteObject iRgnCorner
            End If
            If iRightBottomRoundness <> 0 Then
                iRgnCorner = CreateRectRgn(iRect.Right - iRightBottomRoundness, iRect.Bottom - iRightBottomRoundness - 1, iRect.Right + 2, iRect.Bottom + 1)
                iRgnCircle = CreateEllipticRgn(iRect.Right - iRightBottomRoundness * 2 - 1, iRect.Bottom - iRightBottomRoundness * 2 - 2, iRect.Right + 3, iRect.Bottom + 3)
                CombineRgn iRgnCorner, iRgnCorner, iRgnCircle, RGN_DIFF
                DeleteObject iRgnCircle
                CombineRgn mClientRegion, mClientRegion, iRgnCorner, RGN_DIFF
                DeleteObject iRgnCorner
            End If
        End If
    End If
End Sub

Private Function CloneRegion(nRegion As LongPtr) As LongPtr
    Const RGN_COPY As Long = 5
    
    If nRegion = 0 Then Exit Function
    CloneRegion = CreateRectRgn(0, 0, 0, 0)
    CombineRgn CloneRegion, nRegion, 0, RGN_COPY
End Function

' Places a contained control that has a window over the client area, in pixels, and gives it the
' rounded client region when there is one. With AutoRefit it is placed again whenever the client
' area changes
Public Sub FitToClientArea(ByVal nControl As Object, Optional ByVal AutoRefit As Boolean = True)
Attribute FitToClientArea.VB_Description = "Places a contained control so it fills the client area, and clips it to the rounded corners of the body if there are any. With AutoRefit (the default) it is placed again whenever the client area changes. The control must have a hWnd and be a direct child of the tab control."
    Dim iHwnd As LongPtr
    Dim iPos As Long
    
    iHwnd = FitControlHwnd(nControl)
    If iHwnd = 0 Then Exit Sub
    EnsureDrawn
    iPos = FitFindHwnd(iHwnd)
    If AutoRefit And (iPos = -1) Then
        ReDim Preserve mFitHwnds(mFitCount)
        mFitHwnds(mFitCount) = iHwnd
        mFitCount = mFitCount + 1
    ElseIf (Not AutoRefit) And (iPos > -1) Then
        FitRemoveAt iPos
    End If
    FitApply iHwnd
End Sub

' Stops refitting a control and removes the region FitToClientArea gave it. It is not moved
Public Sub ReleaseFromClientArea(ByVal nControl As Object)
Attribute ReleaseFromClientArea.VB_Description = "Stops keeping a control fitted to the client area and removes the clipping that FitToClientArea applied to it."
    Dim iHwnd As LongPtr
    Dim iPos As Long
    
    iHwnd = FitControlHwnd(nControl)
    If iHwnd = 0 Then Exit Sub
    iPos = FitFindHwnd(iHwnd)
    If iPos > -1 Then FitRemoveAt iPos
    SetWindowRgn iHwnd, 0, True
End Sub

Private Function FitControlHwnd(ByVal nControl As Object) As LongPtr
    Dim iHwnd As LongPtr
    
    On Error Resume Next
    iHwnd = nControl.hWnd
    On Error GoTo 0
    If iHwnd <> 0 Then
        If GetParent(iHwnd) <> mUserControlHwnd Then iHwnd = 0
    End If
    If iHwnd = 0 Then
        RaiseError 380, TypeName(Me), "The control must have a window (hWnd) and be contained in this NewTab."
    End If
    FitControlHwnd = iHwnd
End Function

Private Function FitFindHwnd(ByVal nHwnd As LongPtr) As Long
    Dim c As Long
    
    FitFindHwnd = -1
    For c = 0 To mFitCount - 1
        If mFitHwnds(c) = nHwnd Then
            FitFindHwnd = c
            Exit For
        End If
    Next c
End Function

Private Sub FitRemoveAt(ByVal nPos As Long)
    Dim c As Long
    
    For c = nPos To mFitCount - 2
        mFitHwnds(c) = mFitHwnds(c + 1)
    Next c
    mFitCount = mFitCount - 1
End Sub

Private Sub FitRefitAll()
    Dim c As Long
    
    For c = mFitCount - 1 To 0 Step -1
        If IsWindow(mFitHwnds(c)) = 0 Then
            FitRemoveAt c
        Else
            FitApply mFitHwnds(c)
        End If
    Next c
End Sub

Private Sub FitApply(ByVal nHwnd As LongPtr)
    Dim iWindowRect As RECT
    Dim iControlRect As RECT
    Dim iPt As POINTAPI
    Dim iPosX As Long
    
    ' A control of a tab that is not the active one is parked far to the left: it is left there
    ' and gets fitted on the Draw that follows its tab being selected
    GetWindowRect nHwnd, iControlRect
    iPt.X = iControlRect.Left
    iPt.Y = iControlRect.Top
    ScreenToClient mUserControlHwnd, iPt
    If iPt.X < -(pScaleX(mLeftOffsetToHide, vbTwips, vbPixels) / 2) Then Exit Sub
    
    iPosX = mClientSpaceData.RECT.Left
    If mRightToLeft Then
        GetClientRect mUserControlHwnd, iWindowRect
        iPosX = iWindowRect.Right - mClientSpaceData.RECT.Right - 1
    End If
    MoveWindow nHwnd, iPosX, mClientSpaceData.RECT.Top, mClientSpaceData.RECT.Right - mClientSpaceData.RECT.Left + 1, mClientSpaceData.RECT.Bottom - mClientSpaceData.RECT.Top + 1, 1
    CreateClientRegion
    SetWindowRgn nHwnd, CloneRegion(mClientRegion), True
End Sub

Public Function GetClientRgn() As LongPtr
Attribute GetClientRgn.VB_Description = "Returns a new GDI region with the shape of the client area, or 0 if the body has no rounded corners. The caller owns the region: pass it to SetWindowRgn or delete it with DeleteObject."
    Static sClientSpaceDataPrev_Binary() As Byte
    Static sClientSpaceDataPrev_Init As Boolean
    Dim iBytes() As Byte
    
    If mAppearanceIsFlat Then
        If (mFlatRoundnessTop > 0) Or (mFlatRoundnessBottom > 0) Then
            EnsureDrawn
            ReDim iBytes(LenB(mClientSpaceData))
            CopyMemory iBytes(0), mClientSpaceData, LenB(mClientSpaceData)
            If Not sClientSpaceDataPrev_Init Then
                ReDim sClientSpaceDataPrev_Binary(LenB(mClientSpaceData))
                sClientSpaceDataPrev_Init = True
            End If
            If (StrComp(iBytes, sClientSpaceDataPrev_Binary) <> 0) Or (mClientRegion = 0) Then
                CreateClientRegion
                CopyMemory sClientSpaceDataPrev_Binary(0), iBytes(0), UBound(iBytes) + 1
            End If
        End If
    Else
        If mClientRegion <> 0 Then
            DeleteObject mClientRegion
            mClientRegion = 0
        End If
    End If
    If mClientRegion <> 0 Then
        GetClientRgn = CloneRegion(mClientRegion)
    End If
End Function

Private Function GetTabIndex(nValue As Variant, Optional ByRef nFailed As Boolean) As Long
    ' nFailed tells the caller that the error for this value was already raised here, so that it
    ' does not raise a second one for the same mistake.
    If IsNumericInteger(nValue) Then
        ' OK, it is an index. Out of range values are passed through untouched, including -1:
        ' complaining about a number that is not a tab is the caller's job, not this one's
        GetTabIndex = nValue
    ElseIf VarType(nValue) = vbString Then
        GetTabIndex = FindTab(nValue, ntFindKey)
        If GetTabIndex = -1 Then
            GetTabIndex = FindTab(nValue, ntFindCaption)
            If GetTabIndex = -1 Then
                nFailed = True
                RaiseError 5, TypeName(Me), "Invalid procedure call or argument. String not found as TabKey or Caption. Or nValue must be numeric integer if it is a tab index."   ' Invalid procedure call or argument
                Exit Function
            Else
                nValue = GetTabIndex
            End If
        Else
            nValue = GetTabIndex
        End If
    Else
        ' -1 instead of the 0 this used to return by falling out unassigned. A caller that
        ' only checks IsValidTabIndex took that 0 for a good index and went on to work on the
        ' first tab after the error had already been raised
        GetTabIndex = -1
        nFailed = True
        RaiseError 380, TypeName(Me), "Invalid argument. Tabs are identified by its tab index, TabKey or Caption."
        Exit Function
    End If
End Function

Private Function GetShiftState() As Integer
    Dim ShiftState As Integer
    Const VK_SHIFT = &H10
    Const VK_CONTROL = &H11
    Const VK_MENU = &H12 ' Alt key

    ShiftState = 0
    If (GetKeyState(VK_SHIFT) And &H8000) <> 0 Then ShiftState = ShiftState Or 1 ' vbShiftMask
    If (GetKeyState(VK_CONTROL) And &H8000) <> 0 Then ShiftState = ShiftState Or 2 ' vbCtrlMask
    If (GetKeyState(VK_MENU) And &H8000) <> 0 Then ShiftState = ShiftState Or 4 ' vbAltMask
    GetShiftState = ShiftState
End Function

' Tab is a reserved keyword in VB6, but you can remove that restriction.

#Const COMPILE_WITH_TAB_PROPERTY = 0
#If COMPILE_WITH_TAB_PROPERTY Then
Public Property Get Tab() As Variant
Attribute Tab.VB_Description = "Returns/sets the selected tab by its index, TabKey or TabCaption."
Attribute Tab.VB_ProcData.VB_Invoke_Property = ";Tabs"

'Attribute Tab.VB_Description = "Returns or sets the index of the current (""selected"" or ""active"") tab."
    Tab = mTab
End Property

Public Property Let Tab(ByVal nValue As Variant)
    Dim iTabIndex As Long
    Dim iFailed As Boolean
    
    iTabIndex = GetTabIndex(nValue, iFailed)
    ' GetTabIndex already raised the error for anything it could not resolve, so that result
    ' must not reach TabSel, which would raise a second one on top of it. An index it did
    ' resolve goes through even when out of range: that error belongs to TabSel
    If Not iFailed Then
        TabSel = iTabIndex
    End If
End Property
#Else
Public Property Get SelectedTab() As Variant
Attribute SelectedTab.VB_Description = "Returns/sets the selected tab by its index, TabKey or TabCaption."
Attribute SelectedTab.VB_ProcData.VB_Invoke_Property = ";Tabs"

'Attribute Tab.VB_Description = "Returns or sets the index of the current (""selected"" or ""active"") tab."
    SelectedTab = mTab
End Property

Public Property Let SelectedTab(ByVal nValue As Variant)
    Dim iTabIndex As Long
    Dim iFailed As Boolean
    
    iTabIndex = GetTabIndex(nValue, iFailed)
    ' same as Property Let Tab above, which is the branch that actually compiles. Kept in
    ' sync on purpose: whoever flips COMPILE_WITH_TAB_PROPERTY should not inherit the old bug
    If Not iFailed Then
        TabSel = iTabIndex
    End If
End Property
#End If

