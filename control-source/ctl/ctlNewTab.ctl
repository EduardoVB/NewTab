        End If
    End If
End Sub

Private Sub mThemesCollection_ThemeRemoved()
    SetPropertyChanged
End Sub

Private Sub mThemesCollection_ThemeRenamed()
    SetPropertyChanged
End Sub


Private Sub tmrCancelDoubleClick_Timer()
    tmrCancelDoubleClick.Enabled = False
End Sub

Private Sub tmrCheckContainedControlsAdditionDesignTime_Timer()
    If IsMouseButtonPressed(ntMBLeft) Then Exit Sub
    If mBackStyle = ntOpaque Then tmrCheckContainedControlsAdditionDesignTime.Enabled = False
    
    ' The controls that come with the form are not additions.
    If Not mUserControlShown Then
        mLastContainedControlsCount = UserControlContainedControlsCount
        Exit Sub
    End If
    
    If UserControlContainedControlsCount <> mLastContainedControlsCount Then
        mLastContainedControlsCount = UserControlContainedControlsCount
        ' asked here as well: the arming site in WM_LBUTTONDOWN tests the property, this path did not
        If mChangeControlsBackColor Then SetControlsProperBackColor
        If mChangeControlsForeColor Then SetControlsProperForeColor
        If mVisualStylesActive Or (mBackStyle <> ntOpaque) Then
            mSubclassControlsPaintingPending = True
            RedrawWindow mUserControlHwnd, ByVal 0&, 0&, RDW_INVALIDATE Or RDW_ALLCHILDREN
            Draw
        End If
    ElseIf (Not mAmbientUserMode) And (mBackStyle <> ntOpaque) Then
        Dim iStr As String
        
        iStr = GetContainedControlsPositionsStr
        If iStr <> mLastContainedControlsPositionsStr Then
            mLastContainedControlsPositionsStr = iStr
            mSubclassControlsPaintingPending = True
            RedrawWindow mUserControlHwnd, ByVal 0&, 0&, RDW_INVALIDATE Or RDW_ALLCHILDREN
            Draw
        End If
    End If
End Sub

Private Function GetContainedControlsPositionsStr() As String
    Dim iCtl As Object
    Dim iLeft As Long
    Dim iWidth As Long
    
    On Error Resume Next
    For Each iCtl In UserControlContainedControls
        iLeft = -mLeftOffsetToHide
        iLeft = iCtl.Left
        If iLeft > -mLeftOffsetToHide Then
            iWidth = -1
            iWidth = iCtl.Width
            If iWidth <> -1 Then
                GetContainedControlsPositionsStr = GetContainedControlsPositionsStr & CStr(iLeft) & "," & CStr(iCtl.Top) & "," & CStr(iWidth) & "," & CStr(iCtl.Height) & "|"
            End If
        End If
    Next
    'On Error GoTo 0
    
    Err.Clear
End Function
    

Private Function IsMouseButtonPressed(ByVal nButton As NTMouseButtonsConstants) As Boolean
    Dim iButton As Long
    
    iButton = nButton
    If GetSystemMetrics(SM_SWAPBUTTON) <> 0 Then
        If nButton = ntMBLeft Then
            iButton = VK_RBUTTON
        ElseIf nButton = ntMBRight Then
            iButton = VK_LBUTTON
        End If
    End If
    IsMouseButtonPressed = GetAsyncKeyState(iButton) <> 0
End Function

Private Sub tmrCheckDuplicationByIDEPaste_Timer()
    If (Not mAmbientUserMode) Then
        If Not IsMsgBoxShown Then
            tmrCheckDuplicationByIDEPaste.Enabled = False
            CheckContainedControlsConsistency
        End If
    Else
        tmrCheckDuplicationByIDEPaste.Enabled = False
    End If
End Sub

Private Sub tmrDraw_Timer()
    If mRedraw = False Then tmrDraw.Enabled = False
    Draw
End Sub

Private Sub tmrHighlightIcon_Timer()
    If Not mMouseIsOverIcon Then
        tmrHighlightIcon.Enabled = False
        Draw
    End If
End Sub

Private Sub tmrPreHighlightIcon_Timer()
    tmrPreHighlightIcon.Enabled = False
    If mMouseIsOverIcon Then
        Draw
    Else
        tmrHighlightIcon.Enabled = False
    End If
End Sub

Private Sub tmrRestoreDropMode_Timer()
    Dim t As Long
    Dim iPt As POINTAPI
    
    GetCursorPos iPt
    ScreenToClient mUserControlHwnd, iPt
    
    t = GetTabAtXY(iPt.X * Screen_TwipsPerPixelX, iPt.Y * Screen_TwipsPerPixelY)
    If t = mTab Then
        UserControl.OLEDropMode = ssOLEDropManual
        tmrRestoreDropMode.Enabled = False
    End If
End Sub

Private Sub tmrShowTabTTT_Timer()
    Static sFormHwnd As LongPtr
    
    tmrShowTabTTT.Enabled = False
    If mTTTIsForZoneButton Then
        ' The buttons of the zone are not a tab under the mouse, so the guard is their own hover
        If mStripButtonHovered <> mTTTZoneButton Then Exit Sub
    ElseIf tmrShowTabTTT.Tag <> mTabUnderMouse Then
        Exit Sub 'a protection, just in case
    End If
    Set mToolTipEx = New cToolTipEx
    If mTTTIsForZoneButton Then
        mToolTipEx.TipText = StripButtonToolTipText(mTTTZoneButton)
    Else
        mToolTipEx.TipText = mTabData(Val(tmrShowTabTTT.Tag)).ToolTipText
    End If
    mToolTipEx.Style = vxTTStandard
    mToolTipEx.CloseButton = False
    mToolTipEx.DelayTimeSeconds = 0
    mToolTipEx.RightToLeft = mRightToLeft
    If sFormHwnd = 0 Then sFormHwnd = GetAncestor(UserControl.ContainerHwnd, GA_ROOT)
    mToolTipEx.Create sFormHwnd
End Sub

' One tab per tick while the pointer is held past a chevron. The dragged tab keeps its place under
' the pointer by itself: its origin is a point of the as-Top frame, which a scroll does not move, and
' only the snapshot of the slots does. What moved with the strip is worked out again after the step.
Private Sub tmrTabDragging_Timer()
    Dim iFirstBefore As Long
    
    If (mDragState <> cDragStateActive) Or (Not mStripScrolls) Or (mDragAutoScrollDir = 0) Then
        tmrTabDragging.Enabled = False
        Exit Sub
    End If
    If mDragAutoScrollDir < 0 Then
        If Not mScrollBackEnabled Then Exit Sub
    ElseIf Not mScrollFwdEnabled Then
        Exit Sub
    End If
    If Not DragZoneExtendsPastView(mDragAutoScrollDir) Then Exit Sub
    iFirstBefore = mScrollFirstTab
    ScrollStep mDragAutoScrollDir
    If mScrollFirstTab = iFirstBefore Then Exit Sub
    Draw
    DragSetSegment
    DragUpdateFromMouse mDragPointerX, mDragPointerY
    Draw
End Sub

' Whether the stretch the dragged tab may travel over (DragSetZone) still runs past the window on that
' side. It counts up to the tab that closes it, which is scrolled into sight too so the reason the
' scroll stops is on screen; past it there is nothing the dragged tab can reach.
Private Function DragZoneExtendsPastView(ByVal nDirection As Long) As Boolean
    Dim t As Long
    Dim iViewLeft As Long
    Dim iViewRight As Long
    
    If mDragTabRectsCount <> mTabs Then Exit Function
    DragViewBounds iViewLeft, iViewRight
    If nDirection > 0 Then
        For t = mDragZoneLast + 1 To mTabs - 1
            If mTabData(t).Visible And (mTabData(t).RowPos > -1) Then
                DragZoneExtendsPastView = (mDragTabRectAsTop(t).Right > iViewRight)
                Exit Function
            End If
        Next t
        For t = mDragZoneLast To mTab Step -1
            If mTabData(t).Visible And (mTabData(t).RowPos > -1) Then
                DragZoneExtendsPastView = (mDragTabRectAsTop(t).Right > iViewRight)
                Exit Function
            End If
        Next t
    Else
        For t = mDragZoneFirst - 1 To 0 Step -1
            If mTabData(t).Visible And (mTabData(t).RowPos > -1) Then
                DragZoneExtendsPastView = (mDragTabRectAsTop(t).Left < iViewLeft)
                Exit Function
            End If
        Next t
        For t = mDragZoneFirst To mTab
            If mTabData(t).Visible And (mTabData(t).RowPos > -1) Then
                DragZoneExtendsPastView = (mDragTabRectAsTop(t).Left < iViewLeft)
                Exit Function
            End If
        Next t
    End If
End Function

Private Function DragAutoScrollDirection(ByVal nXPixels As Single, ByVal nYPixels As Single) As Long
    If Not mStripScrolls Then Exit Function
    If DragPointerPastChevron(mScrollBackRectScreen, nXPixels, nYPixels) Then
        DragAutoScrollDirection = -1
    ElseIf DragPointerPastChevron(mScrollFwdRectScreen, nXPixels, nYPixels) Then
        DragAutoScrollDirection = 1
    End If
End Function

' Past the chevron's inner edge, on the side away from the window, anywhere across the strip. Read on
' the screen rects, so it needs to know nothing about orientation or order.
Private Function DragPointerPastChevron(ByRef nRect As RECT, ByVal nXPixels As Single, ByVal nYPixels As Single) As Boolean
    If nRect.Right <= nRect.Left Then Exit Function
    If nRect.Right <= mScrollViewRectScreen.Left Then
        DragPointerPastChevron = (nXPixels <= nRect.Right)
    ElseIf nRect.Left >= mScrollViewRectScreen.Right Then
        DragPointerPastChevron = (nXPixels >= nRect.Left)
    ElseIf nRect.Bottom <= mScrollViewRectScreen.Top Then
        DragPointerPastChevron = (nYPixels <= nRect.Bottom)
    ElseIf nRect.Top >= mScrollViewRectScreen.Bottom Then
        DragPointerPastChevron = (nYPixels >= nRect.Top)
    End If
End Function

' The scroll window in the frame of mDragTabRectAsTop, which for the reversed orientations is the
' unreversed strip. See DragSnapshotTabRects
Private Sub DragViewBounds(ByRef nLeft As Long, ByRef nRight As Long)
    If mTabsOrderReversed Then
        nLeft = mRowMirrorAxis(0) - mScrollViewRight
        nRight = mRowMirrorAxis(0) - mScrollViewLeft
    Else
        nLeft = mScrollViewLeft
        nRight = mScrollViewRight
    End If
End Sub

Private Sub tmrTabTransition_Timer()
    Dim iDuration As Single
    Dim iFraction As Single
    Const LWA_ALPHA = &H2&
    
    iDuration = TabTransitionDurationMs
    If iDuration <= 0 Then
        iFraction = 1
    Else
        iFraction = AnimElapsedMs(mTabTransitionStartMark) / iDuration
    End If
    If iFraction >= 1 Then
        HidePicCover
        tmrTabTransition.Enabled = False
    Else
        ' Ease-out: most of the cover goes early, so the new tab reads at once
        SetLayeredWindowAttributes picCover.hWnd, 0, CLng(cTabTransitionStartAlpha * (1 - iFraction) * (1 - iFraction)), LWA_ALPHA
        mTabTransitionFramePainted = True
    End If
End Sub

Private Function TabTransitionDurationMs() As Single
    ' Its own table, not shared with HighlightEffect (see HighlightEffectDurationMs)
    Select Case mTabTransition
        Case ntAnimationFaster
            TabTransitionDurationMs = 90
        Case ntAnimationFast
            TabTransitionDurationMs = 150
        Case ntAnimationSlow
            TabTransitionDurationMs = 400
        Case ntAnimationSlower
            TabTransitionDurationMs = 700
        Case Else
            TabTransitionDurationMs = 250 ' ntAnimationMedium
    End Select
End Function

Private Sub tmrSubclassControls_Timer()
    tmrSubclassControls.Enabled = False
    SubclassControlsPainting
End Sub

Private Sub tmrHighlightEffect_Timer()
    Dim iDuration As Single
    Dim iFraction As Single
    Dim iRunning As Boolean

    ' The interval is a frame rate and nothing else.
    If mHoverAnimTab > -1 Then
        iDuration = HighlightEffectDurationMs
        If iDuration <= 0 Then
            iFraction = 1
        Else
            iFraction = (AnimElapsedMs(mHoverAnimStartMark(cSlotIn)) + mHoverAnimOffsetMs(cSlotIn)) / iDuration
        End If
        If iFraction > 1 Then iFraction = 1
        SetHoverGlow cSlotIn, Int(iFraction * 100 + 0.5)
        If iFraction < 1 Then iRunning = True
    End If
    If mFadeOutTab > -1 Then
        iDuration = HighlightEffectOutDurationMs
        If iDuration <= 0 Then
            iFraction = 1
        Else
            iFraction = (AnimElapsedMs(mHoverAnimStartMark(cSlotOut)) + mHoverAnimOffsetMs(cSlotOut)) / iDuration
        End If
        If iFraction > 1 Then iFraction = 1
        SetHoverGlow cSlotOut, 100 - Int(iFraction * 100 + 0.5)
        If iFraction < 1 Then iRunning = True
    End If
    If ButtonHoverAnimStep Then iRunning = True
    ' Each frame of the fade repaints for a colour change and nothing else, so the base holds
    ' across the whole of it - see the note in RaiseEvent_TabMouseEnter
    mHoverCacheAllowed = True
    ' The way out is closed before the last frame, not after it: that frame still painted the tab
    ' as fading - grip included, which lies outside the tab - and nothing repainted it afterwards
    If Not iRunning Then
        tmrHighlightEffect.Enabled = False
        FinishHoverFadeOut
    End If
    Draw
End Sub

Private Function HighlightEffectDurationMs() As Single
    ' Its own table, deliberately not shared with TabTransition even though the numbers are the same
    ' today.
    Select Case mHighlightEffect
        Case ntAnimationFaster
            HighlightEffectDurationMs = 90
        Case ntAnimationFast
            HighlightEffectDurationMs = 150
        Case ntAnimationSlow
            HighlightEffectDurationMs = 400
        Case ntAnimationSlower
            HighlightEffectDurationMs = 700
        Case Else
            HighlightEffectDurationMs = 250 ' ntAnimationMedium
    End Select
End Function

Private Function HighlightEffectOutDurationMs() As Single
    ' Its own table again, same reason as the other two: sharing one would mean that tuning
    ' the way out by eye moves the way in
    Select Case mHighlightEffectOut
        Case ntAnimationFaster
            HighlightEffectOutDurationMs = 90
        Case ntAnimationFast
            HighlightEffectOutDurationMs = 150
        Case ntAnimationSlow
            HighlightEffectOutDurationMs = 400
        Case ntAnimationSlower
            HighlightEffectOutDurationMs = 700
        Case Else
            HighlightEffectOutDurationMs = 250 ' ntAnimationMedium
    End Select
End Function

Private Function AnimTimeMark() As Currency
    ' Currency and not Double because that is how a 64 bit counter comes back through a VB6
    ' Declare without losing its low bits. The scaling by 10000 that Currency applies cancels
    ' out in AnimElapsedMs, where the counter is divided by a frequency read the same way
    Dim iMark As Currency

    QueryPerformanceCounter iMark
    AnimTimeMark = iMark
End Function

Private Function ButtonHoverIdNow() As Long
    If mStripButtonHovered <> 0 Then
        ButtonHoverIdNow = -mStripButtonHovered
    ElseIf mStripCloseButtonHovered Then
        ButtonHoverIdNow = cBtnStripClose
    ElseIf mMouseIsOverCloseButton And (mMouseIsOverCloseButton_Tab > -1) Then
        ButtonHoverIdNow = mMouseIsOverCloseButton_Tab
    Else
        ButtonHoverIdNow = cBtnNone
    End If
End Function

' Run at the top of every Draw: a button's hover is changed from several places, and the Draw each
' of them asks for is the one they all go through
Private Sub ButtonHoverTrack()
    Dim iNowId As Long
    Dim iResume As Long
    Dim iPercent As Long
    
    iNowId = ButtonHoverIdNow
    If iNowId = mBtnHoverId Then Exit Sub
    ' Back onto the button that was still fading out: the way in starts where the way out had got
    If iNowId <> cBtnNone Then
        If mBtnAnimId(cSlotOut) = iNowId Then
            iResume = mBtnAnimPercent(cSlotOut)
            mBtnAnimId(cSlotOut) = cBtnNone
        End If
    End If
    If mBtnHoverId <> cBtnNone Then
        iPercent = ButtonGlowPercent(mBtnHoverId)
        mBtnAnimId(cSlotOut) = mBtnHoverId
        mBtnAnimPercent(cSlotOut) = iPercent
        mBtnAnimOffsetMs(cSlotOut) = HighlightEffectOutDurationMs * (100 - iPercent) / 100
        mBtnAnimStartMark(cSlotOut) = AnimTimeMark
    End If
    mBtnAnimId(cSlotIn) = iNowId
    mBtnAnimPercent(cSlotIn) = iResume
    mBtnAnimOffsetMs(cSlotIn) = HighlightEffectDurationMs * iResume / 100
    mBtnAnimStartMark(cSlotIn) = AnimTimeMark
    mBtnHoverId = iNowId
    ' Not gated on visual styles as the tabs are: the glyph is ours under a theme too
    If mAmbientUserMode And (mHighlightEffect <> ntAnimationNone) And SystemAnimationsOn Then
        tmrHighlightEffect.Enabled = True
    Else
        mBtnAnimPercent(cSlotIn) = 100
        mBtnAnimId(cSlotOut) = cBtnNone
    End If
End Sub

Private Function ButtonHoverAnimStep() As Boolean
    Dim iDuration As Single
    Dim iFraction As Single
    
    If mBtnAnimId(cSlotIn) <> cBtnNone Then
        iDuration = HighlightEffectDurationMs
        If iDuration <= 0 Then
            iFraction = 1
        Else
            iFraction = (AnimElapsedMs(mBtnAnimStartMark(cSlotIn)) + mBtnAnimOffsetMs(cSlotIn)) / iDuration
        End If
        If iFraction > 1 Then iFraction = 1
        mBtnAnimPercent(cSlotIn) = Int(iFraction * 100 + 0.5)
        If iFraction < 1 Then ButtonHoverAnimStep = True
    End If
    If mBtnAnimId(cSlotOut) <> cBtnNone Then
        iDuration = HighlightEffectOutDurationMs
        If iDuration <= 0 Then
            iFraction = 1
        Else
            iFraction = (AnimElapsedMs(mBtnAnimStartMark(cSlotOut)) + mBtnAnimOffsetMs(cSlotOut)) / iDuration
        End If
        If iFraction > 1 Then iFraction = 1
        mBtnAnimPercent(cSlotOut) = 100 - Int(iFraction * 100 + 0.5)
        If iFraction < 1 Then
            ButtonHoverAnimStep = True
        Else
            mBtnAnimId(cSlotOut) = cBtnNone
        End If
    End If
End Function

' Whether a strip or close button is still fading, which the tab code has to ask before stopping
' the timer the two share
Private Function ButtonHoverAnimRunning() As Boolean
    If mBtnAnimId(cSlotOut) <> cBtnNone Then
        ButtonHoverAnimRunning = True
    ElseIf mBtnAnimId(cSlotIn) <> cBtnNone Then
        ButtonHoverAnimRunning = (mBtnAnimPercent(cSlotIn) < 100)
    End If
End Function

Private Function ButtonGlowPercent(ByVal nId As Long) As Long
    If nId = cBtnNone Then Exit Function
    If mBtnAnimId(cSlotIn) = nId Then
        ButtonGlowPercent = mBtnAnimPercent(cSlotIn)
    ElseIf mBtnAnimId(cSlotOut) = nId Then
        ButtonGlowPercent = mBtnAnimPercent(cSlotOut)
    End If
End Function

' A close button on a tab only shows its fade while the tab itself carries hover: the hover base is
' painted with the hovered tab's flags put aside, and a glow read from the slots would get baked in
Private Function ButtonFadedColor(ByVal nId As Long, ByVal nRestColor As Long, ByVal nHotColor As Long, ByVal nRole As NTColorRoleConstants, ByVal nHoveredNow As Boolean) As Long
    Dim iPercent As Long
    
    ' Only the slots, and not the button's own hover flag: where two hit areas overlap both flags
    ' are up while ButtonHoverIdNow names one, and the other would show at full and then restart
    iPercent = ButtonGlowPercent(nId)
    If (nId >= 0) And (nId < mTabs) Then
        If Not (mTabData(nId).Hovered Or (mFadeOutTab = nId)) Then iPercent = 0
    End If
    If iPercent <= 0 Then
        ButtonFadedColor = TranslatedColor(nRestColor, nRole)
    ElseIf iPercent >= 100 Then
        ButtonFadedColor = TranslatedColor(nHotColor, nRole)
    Else
        ButtonFadedColor = MixColors(TranslatedColor(nRestColor, nRole), TranslatedColor(nHotColor, nRole), iPercent)
    End If
End Function

Private Function AnimElapsedMs(ByVal nMark As Currency) As Single
    Dim iNow As Currency

    If mAnimClockFrequency = 0 Then
        QueryPerformanceFrequency mAnimClockFrequency
    End If
    If mAnimClockFrequency = 0 Then
        ' No counter at all. Reporting a huge elapsed time ends the animation on its first
        ' frame, which is the safe failure: the effect disappears, it does not hang half done
        AnimElapsedMs = 1000000
        Exit Function
    End If
    QueryPerformanceCounter iNow
    AnimElapsedMs = CDbl(iNow - nMark) / CDbl(mAnimClockFrequency) * 1000
End Function

Private Function HoverAnimSlotForTab(ByVal nTab As Long) As Long
    ' -1 when this tab has no animation of its own. A tab cannot be in both slots: entering
    ' one that was on its way out cancels the way out, in RaiseEvent_TabMouseEnter
    If mHoverAnimTab = nTab Then
        HoverAnimSlotForTab = cSlotIn
    ElseIf mFadeOutTab = nTab Then
        HoverAnimSlotForTab = cSlotOut
    Else
        HoverAnimSlotForTab = -1
    End If
End Function

Private Function HoverBorderPercent(ByVal nTab As Long) As Long
    ' 100 for every tab with no animation of its own, so a tab at rest and the active tab's
    ' own border - which has no "entering" to animate - keep taking the colour whole
    Dim iSlot As Long

    iSlot = HoverAnimSlotForTab(nTab)
    If iSlot < 0 Then
        HoverBorderPercent = 100
    Else
        HoverBorderPercent = mHoverPercent(iSlot)
    End If
End Function

Private Function HoverFadedColor(ByVal nTab As Long, ByVal nRestColor As Long, ByVal nHoverColor As Long, ByVal nRole As NTColorRoleConstants) As Long
    ' What the caption, the icon and the close button fade with.
    Dim iRestRGB As Long
    Dim iHoverRGB As Long

    iRestRGB = TranslatedColor(nRestColor, nRole)
    iHoverRGB = TranslatedColor(nHoverColor, nRole)
    HoverFadedColor = MixColors(iRestRGB, iHoverRGB, HoverBorderPercent(nTab))
End Function

Private Function TabShowsDiscreteHighlight(ByVal nTab As Long) As Boolean
    ' The highlight traits that cannot be mixed - the caption's bold and underline, and the extra
    ' height - are on or off, so the only question they raise is when they turn.
    TabShowsDiscreteHighlight = mAmbientUserMode And mTabData(nTab).Hovered
End Function

Private Function FlatBarColorHighlightedFor(ByVal nTab As Long) As Long
    If Not IsEmpty(mTabData(nTab).CustomColors.FlatBarColorHighlighted) Then
        FlatBarColorHighlightedFor = mTabData(nTab).CustomColors.FlatBarColorHighlighted
    ElseIf mFlatBarColorHighlighted_IsAutomatic And (Not IsEmpty(mTabData(nTab).CustomColors.FlatBarColorSelectedTab)) Then
        ' The hover previews the bar this tab takes when selected, not the current selected tab's
        FlatBarColorHighlightedFor = MixColors(mBackColorTabs, mTabData(nTab).CustomColors.FlatBarColorSelectedTab, 60)
    Else
        FlatBarColorHighlightedFor = mFlatBarColorHighlighted
    End If
End Function

Private Function HoverBarColorFor(ByVal nTab As Long) As Long
    ' mFlatBarGlowColor is one variable and there can be two tabs animating, so the tab in a
    ' slot reads its slot's colour. Everything else reads the module one, which slot 0 keeps
    ' writing for the sake of the grip, drawn outside DrawTab
    Dim iSlot As Long

    iSlot = HoverAnimSlotForTab(nTab)
    If iSlot < 0 Then
        HoverBarColorFor = mFlatBarGlowColor
    Else
        HoverBarColorFor = mHoverBarColor(iSlot)
    End If
End Function

Private Sub ResolveHoverAnimation(ByVal nTab As Long, ByVal nSlot As Long)
    Dim iBase As Long
    Dim iTarget As Long

    If nSlot = cSlotIn Then mHoverAnimTab = nTab
    If nTab < 0 Then Exit Sub
    ' nTab and not mTabUnderMouse, which is still a step behind while TabMouseEnter runs.
    ' The far end of the fill travels from the tab's own back colour, not from the control's
    If IsEmpty(mTabData(nTab).CustomColors.BackColorTab) Then
        iBase = TranslatedColor(mBackColorTabs, ntRoleBack)
    Else
        iBase = TranslatedColor(mTabData(nTab).CustomColors.BackColorTab, ntRoleBack)
    End If
    If IsEmpty(mTabData(nTab).CustomColors.HighlightColor) Then
        iTarget = mGlowColor
    Else
        iTarget = TranslatedColor(mTabData(nTab).CustomColors.HighlightColor, ntRoleBack)
    End If
    ' Light is 60 per cent of the way from the tab towards the highlight, which is exactly
    ' what the last cell of the old _Light table held. Folding it into the endpoint keeps the
    ' mix itself free of the mode, and it now applies to a tab's own highlight colour too
    If mHighlightIntensity <> ntHighlightIntensityStrong Then
        iTarget = MixColors(iBase, iTarget, 60)
    End If
    mHoverGlowFrom(nSlot) = iBase
    mHoverGlowTo(nSlot) = iTarget
    ' The gradient's far end travels too, or a colour of its own would jump in at the start
    mHoverGradActive(nSlot) = True
    If Not IsEmpty(mTabData(nTab).CustomColors.HighlightGradientColor) Then
        iTarget = TranslatedColor(mTabData(nTab).CustomColors.HighlightGradientColor, ntRoleBack)
    ElseIf Not mHighlightGradientColor_IsAutomatic Then
        iTarget = TranslatedColor(mHighlightGradientColor, ntRoleBack)
    Else
        mHoverGradActive(nSlot) = False
        iTarget = iBase
    End If
    If mHighlightIntensity <> ntHighlightIntensityStrong Then
        iTarget = MixColors(iBase, iTarget, 60)
    End If
    mHoverGradFrom(nSlot) = iBase
    mHoverGradTo(nSlot) = iTarget
    mHoverBarFrom(nSlot) = TranslatedColor(mFlatBarColorInactive, ntRoleBack)
    mHoverBarTo(nSlot) = TranslatedColor(FlatBarColorHighlightedFor(nTab), ntRoleHighlightBack)
    ' Same split the old code made, kept on purpose: a tab with either flat bar colour of its
    ' own mixes its two raw colours, and the draw path runs the result through the mode
    ' afterwards, so translating them here as well would apply it twice
    mHoverTabBarActive(nSlot) = (Not IsEmpty(mTabData(nTab).CustomColors.FlatBarColorInactive)) Or (Not IsEmpty(mTabData(nTab).CustomColors.FlatBarColorHighlighted))
    If mHoverTabBarActive(nSlot) Then
        If IsEmpty(mTabData(nTab).CustomColors.FlatBarColorInactive) Then
            mHoverTabBarFrom(nSlot) = mFlatBarColorInactive
        Else
            mHoverTabBarFrom(nSlot) = mTabData(nTab).CustomColors.FlatBarColorInactive
        End If
        mHoverTabBarTo(nSlot) = FlatBarColorHighlightedFor(nTab)
    End If
End Sub

Private Sub SetHoverGlow(ByVal nSlot As Long, ByVal nPercent As Long)
    ' Takes the percentage and not a fraction, because the two slots run it in opposite
    ' directions and the timer is the one place that knows which way each of them goes
    Dim iTab As Long

    If nPercent < 0 Then nPercent = 0
    If nPercent > 100 Then nPercent = 100
    mHoverPercent(nSlot) = nPercent
    mHoverGlowColor(nSlot) = MixColors(mHoverGlowFrom(nSlot), mHoverGlowTo(nSlot), nPercent)
    mHoverGradColor(nSlot) = MixColors(mHoverGradFrom(nSlot), mHoverGradTo(nSlot), nPercent)
    mHoverBarColor(nSlot) = MixColors(mHoverBarFrom(nSlot), mHoverBarTo(nSlot), nPercent)
    If nSlot = cSlotIn Then
        iTab = mHoverAnimTab
        mFlatBarGlowColor = mHoverBarColor(nSlot)
    Else
        iTab = mFadeOutTab
    End If
    If mHoverTabBarActive(nSlot) And (iTab > -1) Then
        mTabData(iTab).CustomColors.FlatBarGlowColor = MixColors(mHoverTabBarFrom(nSlot), mHoverTabBarTo(nSlot), nPercent)
    End If
End Sub

Private Sub StartHoverFadeOut(ByVal nTab As Long)
    Dim iStartPercent As Long

    ' Two tabs on their way out at once cannot happen with one mouse, but a second leave
    ' arriving before the first finished would strand the earlier one, so it is closed first
    If (mFadeOutTab > -1) And (mFadeOutTab <> nTab) Then FinishHoverFadeOut
    ' The endpoints are the ones the fade in already resolved for this very tab: the way out
    ' is the same road walked backwards, so nothing has to be worked out again
    mHoverGlowFrom(cSlotOut) = mHoverGlowFrom(cSlotIn)
    mHoverGlowTo(cSlotOut) = mHoverGlowTo(cSlotIn)
    mHoverGradFrom(cSlotOut) = mHoverGradFrom(cSlotIn)
    mHoverGradTo(cSlotOut) = mHoverGradTo(cSlotIn)
    mHoverGradActive(cSlotOut) = mHoverGradActive(cSlotIn)
    mHoverBarFrom(cSlotOut) = mHoverBarFrom(cSlotIn)
    mHoverBarTo(cSlotOut) = mHoverBarTo(cSlotIn)
    mHoverTabBarFrom(cSlotOut) = mHoverTabBarFrom(cSlotIn)
    mHoverTabBarTo(cSlotOut) = mHoverTabBarTo(cSlotIn)
    mHoverTabBarActive(cSlotOut) = mHoverTabBarActive(cSlotIn)
    ' Leaving halfway through the way in starts the way out from where it got to, not from
    ' the full colour. With a step count that would be a special case; off the clock it is
    ' an offset that says how much of the way out is already behind us
    iStartPercent = mHoverPercent(cSlotIn)
    mHoverAnimOffsetMs(cSlotOut) = HighlightEffectOutDurationMs * (100 - iStartPercent) / 100
    mHoverAnimStartMark(cSlotOut) = AnimTimeMark
    mFadeOutTab = nTab
    mHoverAnimTab = -1
    SetHoverGlow cSlotOut, iStartPercent
    tmrHighlightEffect.Enabled = True
End Sub

Private Sub FinishHoverFadeOut()
    If mFadeOutTab < 0 Then Exit Sub
    ' The resting value of a tab's own bar colour is the far end of its mix, and the draw
    ' path reads it for tabs nobody is pointing at, so the way out has to put it back rather
    ' than leave it at the inactive end it just travelled to
    If mHoverTabBarActive(cSlotOut) Then
        mTabData(mFadeOutTab).CustomColors.FlatBarGlowColor = mHoverTabBarTo(cSlotOut)
    End If
    mFadeOutTab = -1
End Sub

Private Sub tmrTabMouseLeave_Timer()
    Dim iPt As POINTAPI
    Dim iHwnd As LongPtr
    
    GetCursorPos iPt
    iHwnd = WindowFromPoint(iPt.X, iPt.Y)
    If iHwnd <> mUserControlHwnd Then
        tmrTabMouseLeave.Enabled = False
        If mTabUnderMouse > -1 Then RaiseEvent_TabMouseLeave (mTabUnderMouse)
        mTabUnderMouse = -1
        SetStripCloseButtonHovered False
        SetStripButtonHovered 0
    End If
End Sub

Private Sub tmrTDIIconColor_Timer()
    ' Obsolete (point 2, ToDo NewTab 2): was used to restore the icon hover color after
    ' temporarily hijacking it to draw the TDI close-X in red. The close button now has its
    ' own independent CloseButtonColorMouseHover, so this is never enabled anymore.
    tmrTDIIconColor.Enabled = False
End Sub

Private Sub UserControl_AccessKeyPress(KeyAscii As Integer)
    Dim iChr As String
    Dim iPos As Long
    
    iChr = LCase$(Chr$(KeyAscii))
    iPos = InStr(mTab + 2, mAccessKeys, iChr)
    If iPos = 0 Then
        iPos = InStr(mAccessKeys, iChr)
    End If
    If iPos > 0 Then
        TabSel = iPos - 1
    End If
End Sub

Private Sub UserControl_AmbientChanged(PropertyName As String)
    If PropertyName = "ScaleUnits" Then
        SetPropertyChanged "TabHeight"
        SetPropertyChanged "TabMaxWidth"
        SetPropertyChanged "TabMinWidth"
        SetPropertyChanged "HighlightTabExtraHeight"
        SetPropertyChanged "HighlightTabCaptionShift"
        SetPropertyChanged "StripEndFreeSpace"
    ElseIf PropertyName = "BackColor" Then
        ' mSettingColorFromAmbient tells the Property Let that this assignment is the
        ' hook firing and not a decision, so it keeps the color following the container
        If mBackColorIsFromAmbient Then
            mSettingColorFromAmbient = True
            BackColor = Ambient.BackColor
            mSettingColorFromAmbient = False
        End If
        If mBackColorTabsIsFromAmbient Then
            mSettingColorFromAmbient = True
            BackColorTabs = Ambient.BackColor
            mSettingColorFromAmbient = False
            If mBackColorSelectedTab_IsAutomatic Then
                ' The derived color goes in and not the tabs color raw: the entry guard of
                ' Let BackColorSelectedTab compares the incoming value against mBackColorSelectedTab
                mSettingBackColorSelectedTabFromBackColorTabs = True
                BackColorSelectedTab = GetAutomaticBackColorSelectedTab
                mSettingBackColorSelectedTabFromBackColorTabs = False
            End If
        End If
    ElseIf PropertyName = "ForeColor" Then
        ' IconColor is not hooked to the Ambient: it hangs off ForeColor, and Let
        ' ForeColor drags it through the chain. Hooking it here as well gave it two
        ' parents, and the second one overrode an IconColor the developer had set
        If mForeColorIsFromAmbient Then
            mSettingColorFromAmbient = True
            ForeColor = Ambient.ForeColor
            mSettingColorFromAmbient = False
        End If
        ApplyChainColors
    End If
End Sub

Private Sub UserControl_DblClick()
    RaiseEvent DblClick
End Sub

Private Sub UserControl_GotFocus()
    If Not mHasFocus Then
        mHasFocus = True
        'PostDrawMessage
        tmrDraw.Enabled = True
    End If
End Sub

Friend Sub StoreVisibleControlsInSelectedTab()
    Dim iCtl As Object
    Dim iCtlName As String
    
    On Error Resume Next
    Set mTabData(mTab).Controls = New Collection
    For Each iCtl In UserControlContainedControls
        If TypeName(iCtl) = "Line" Then
            Err.Clear
            If iCtl.X1 > -mLeftThresholdHidden Then
                If Err.Number = 0 Then
                    iCtlName = ControlName(iCtl)
                    mTabData(mTab).Controls.Add iCtlName, iCtlName
                End If
            End If
        Else
            Err.Clear
            If iCtl.Left > -mLeftThresholdHidden Then
                If Err.Number = 0 Then
                    iCtlName = ControlName(iCtl)
                    mTabData(mTab).Controls.Add iCtlName, iCtlName
                End If
            End If
        End If
    Next
    Err.Clear
End Sub

Private Sub UserControl_Hide()
    Dim c As Long
    Const WM_SYSCOMMAND As Long = &H112
    Const SC_CLOSE As Long = &HF060&
    Const SW_HIDE As Long = 0
    Const WM_CLOSE As Long = &H10&
    Dim iHwnd As LongPtr
    Dim iLng As Long
    
    mBodyReset = True
    If (mTDIMode = ntTDIModeForms) And mAmbientUserMode Then
        iLng = -1
        On Error Resume Next
        iLng = LBound(mTDIModeFormsFormData_FormHwnd)
        On Error GoTo 0
        If iLng > -1 Then
            mTDIFormCloseFromControl = True
            For c = mTabs - 1 To 0 Step -1
                iHwnd = mTDIModeFormsFormData_FormHwnd(mTabData(c).Data)
                If iHwnd <> 0 Then
                    If IsWindow(iHwnd) <> 0 Then
                        ShowWindow iHwnd, SW_HIDE
                        SetParent iHwnd, mTDIModeFormsFormData_OldParentHwnd(mTabData(c).Data)
                        If mTDIFormWithoutCloseButton(mTabData(c).Data) Then
                            PostMessage iHwnd, WM_CLOSE, 0, 0
                        Else
                            SendMessage iHwnd, WM_SYSCOMMAND, SC_CLOSE, 0&
                        End If
                    End If
                End If
            Next
            mTDIFormCloseFromControl = False
        End If
        ' no error trapping here on purpose: one container is loaded per form, in order, and TDI
        ' Forms never removes a tab, so the array has no holes.
        For c = picTDIFormContainer.LBound + 1 To picTDIFormContainer.UBound
            Unload picTDIFormContainer(c)
        Next
        UninstallCBTHook
        mTDIModeFormsUnhooked = True
    End If
End Sub

Private Sub UserControl_Initialize()
    Debug.Assert MakeTrue(mInIDE)
    Debug.Assert ChainTreeIsInLevelOrder
    ColorGlyphsAddUser
    mTabUnderMouse = -1
    mHoverAnimTab = -1
    mFadeOutTab = -1
    mBtnHoverId = cBtnNone
    mBtnAnimId(cSlotIn) = cBtnNone
    mBtnAnimId(cSlotOut) = cBtnNone
    Set mParentControlsTabStop = New Collection
    Set mParentControlsUseMnemonic = New Collection
    Set mContainedControlsThatAreContainers = New Collection
    Set mSubclassedControlsForPaintingHwnds = New Collection
    Set mSubclassedFramesHwnds = New Collection
    Set mSubclassedControlsForMoveHwnds = New Collection
    Set mTDISubclassedFormsHwnds = New Collection
    Set mTabIconFontsEventsHandler = New cFontEventHandlers
    mRedraw = True
    mTabOrientation_Prev = -1
    SetDPI
    mMouseIsOverIcon_Tab = -1
    mMouseIsOverCloseButton_Tab = -1
    mControlsForeColor_PrevColor = -1
    mControlsBackColor_PrevColor = -1
    ReDim mClientSpaceDataPrev_Binary(LenB(mClientSpaceData))
    ' Dimensioned here and not only in InitProperties, which is the branch a control that comes from
    ' a property bag never runs: until ReadProperties reaches its own ReDim the array does not
    ' exist, and everything that reads UBound(mTabData) in between raises error 9.
    ReDim mTabData(-1 To -1)
    mControlsBackColor_Applied = -1
End Sub

' The texts the developer saved from the Texts page, for every control he places from then on
Private Sub ApplySavedTexts()
    Dim iTexts() As String
    
    If Not GetSavedTexts(TypeName(Me), iTexts) Then Exit Sub
    NewTabButtonToolTipText = iTexts(0)
    StripButtonBackToolTipText = iTexts(1)
    StripButtonForwardToolTipText = iTexts(2)
    StripButtonListToolTipText = iTexts(3)
    TDIDefaultTabCaption = iTexts(4)
    TDINewTabCaption = iTexts(5)
End Sub

Private Sub UserControl_InitProperties()
    Dim c As Long
    
    On Error Resume Next
    mUserControlHwnd = UserControl.hWnd
    mAmbientUserMode = Ambient.UserMode
    mDefaultTabHeight = pScaleY(cPropDef_TabHeight, vbTwips, vbHimetric)
    If mDefaultTabHeight = 0 Then
        mDefaultTabHeight = 419.8055
    End If
    If mAmbientUserMode Then
        If TypeOf UserControl.Parent Is Form Then
            If TypeOf UserControl.Parent Is MDIForm Then
                Set mMDIForm = UserControl.Parent
            Else
                Set mForm = UserControl.Parent
            End If
        End If
    End If
    On Error GoTo 0
    
    mTabs = cPropDef_Tabs
    ReDim mTabData(-1 To mTabs - 1)
    mTab = 0
    
    mStripEndFreeSpace = cPropDef_StripEndFreeSpace
    mSubclassingMethod = cPropDef_SubclassingMethod
    mNewTabButton = cPropDef_NewTabButton: PropertyChanged "NewTabButton"
    mTDIDefaultTabCaption = cPropDef_TDIDefaultTabCaption
    mTDINewTabCaption = cPropDef_TDINewTabCaption
    If Not mAmbientUserMode Then ApplySavedTexts
    mCloseButtonPadding = cPropDef_CloseButtonPadding
    mChangeControlsBackColor = cPropDef_ChangeControlsBackColor: PropertyChanged "ChangeControlsBackColor"
    mChangeControlsForeColor = cPropDef_ChangeControlsForeColor: PropertyChanged "ChangeControlsForeColor"
    ' These six used to get their default inside SetDefaultPropertyValuesForThemedProperties, and
    ' they are here because they are no longer themed.
    mBackColor = Ambient.BackColor: PropertyChanged "BackColor"
    mBackColorIsFromAmbient = True
    mStripButtonsColor_IsAutomatic = True: PropertyChanged "StripButtonsColor"
    mStripButtonsColorHighlighted_IsAutomatic = True: PropertyChanged "StripButtonsColorHighlighted"
    mBackStyle = cPropDef_BackStyle: PropertyChanged "BackStyle"
    mWordWrap = cPropDef_WordWrap: PropertyChanged "WordWrap"
    mMaskColor = cPropDef_MaskColor: PropertyChanged "MaskColor"
    mShowDisabledState = cPropDef_ShowDisabledState: PropertyChanged "ShowDisabledState"
    mAutoRelocateControls = cPropDef_AutoRelocateControls: PropertyChanged "AutoRelocateControls"
    Set mFont = Ambient.Font
    
    SetDefaultPropertyValuesForThemedProperties
    
    mTabsPerRow = cPropDef_TabsPerRow
    mRightToLeft = Ambient.RightToLeft
    SetScaleMode
    mEnabled = True
    Set mDefaultIconFont = New StdFont
    mDefaultIconFont.Name = cPropDef_IconFontName
    mDefaultIconFont.Size = cPropDef_IconFontSize
    For c = 0 To mTabs - 1
        Set mTabData(c).Controls = New Collection
        mTabData(c).Enabled = True
        mTabData(c).Visible = True
        mTabData(c).Caption = "Tab " & CStr(c)
        mTabData(c).OriginalIndex = c
        mTabData(c).CloseButton = ntYNAuto
        mTabData(c).CloseButtonEnabled = True
        mTabData(c).Movable = True
    Next c
    mTabData(mTab).Selected = True
    mCloseButton = False
    mCloseButtonPosition = ntCBPositionOnTabs
    mTabsOverflow = ntTOMultiRow
    mNewTabButtonPosition = ntNBAfterLastTab
    mStripButtonsRow = ntSBSelectedTabRow
    ' The three inherited ones are not written here any more.
    mCloseButtonColorMouseHover = cPropDef_CloseButtonColorMouseHover
    mCloseButtonColorMouseHoverSelectedTab = cPropDef_CloseButtonColorMouseHover
    mUseMaskColor = cPropDef_UseMaskColor
    mScalePicturesForDPI = cPropDef_ScalePicturesForDPI
    mTDIFormsIconSize = cPropDef_TDIFormsIconSize
    mTabHeight = mDefaultTabHeight
    mIconAlignment = cPropDef_IconAlignment
    mHandleHighContrastTheme = cPropDef_HandleHighContrastThem
    mAutoTabHeight = cPropDef_AutoTabHeight
    mOLEDropOnOtherTabs = cPropDef_OLEDropOnOtherTabs
    mCanReorderTabs = cPropDef_CanReorderTabs
    mTDIMode = cPropDef_TDIMode
    mTabTransition = cPropDef_TabTransition
    mCaptionAlignment = cPropDef_CaptionAlignment: PropertyChanged "CaptionAlignment"
    If mCaptionAlignment = ntAlignmentLeft Then
        mAlignmentDTFlag = DT_LEFT
    ElseIf mCaptionAlignment = ntAlignmentRight Then
        mAlignmentDTFlag = DT_RIGHT
    Else
        mAlignmentDTFlag = DT_CENTER
    End If

    If mHandleHighContrastTheme Then CheckHighContrastTheme
    mPropertiesReady = True
    
    mSubclassed = mSubclassingMethod <> ntSMDisabled
#If NOSUBCLASSINIDE Then
    If mInIDE Then
        mSubclassed = False
    End If
#End If
    
    If mSubclassed Then
        gSubclassWithSetWindowLong = (mSubclassingMethod = ntSMSetWindowLong) Or (mSubclassingMethod = ntSM_SWLOnlyUserControl)
        mOnlySubclassUserControl = (mSubclassingMethod = ntSM_SWSOnlyUserControl) Or (mSubclassingMethod = ntSM_SWLOnlyUserControl)
        SubclassUserControl
    Else
        mFormIsActive = True
    End If
    UserControl.Size 2500, 1700
    
    If mAmbientUserMode Then
        mHandIconHandle = LoadCursor(ByVal 0&, IDC_HAND)
    End If
    mControlJustAdded = True
End Sub

Private Sub SubclassUserControl()
    If mAmbientUserMode Then
        AttachMessage Me, mUserControlHwnd, WM_MOUSEACTIVATE
        AttachMessage Me, mUserControlHwnd, WM_SETFOCUS
        AttachMessage Me, mUserControlHwnd, WM_DRAW
        AttachMessage Me, mUserControlHwnd, WM_INIT
        AttachMessage Me, mUserControlHwnd, WM_THEMEREPAINT
        AttachMessage Me, mUserControlHwnd, WM_SETCURSOR
        AttachMessage Me, mUserControlHwnd, WM_KEYDOWN
        AttachMessage Me, mUserControlHwnd, WM_CHAR
        AttachMessage Me, mUserControlHwnd, WM_KEYUP
        AttachMessage Me, mUserControlHwnd, WM_MOUSEWHEEL
        AttachMessage Me, mUserControlHwnd, WM_MOUSEHWHEEL
        ' Without the form subclassed, the theme change is taken from the control's own window:
        ' WM_THEMECHANGED is broadcast to every window, child ones included
        If mOnlySubclassUserControl Then AttachMessage Me, mUserControlHwnd, WM_THEMECHANGED
        PostMessage mUserControlHwnd, WM_INIT, 0&, 0&
        mCanPostDrawMessage = True
    Else
        AttachMessage Me, mUserControlHwnd, WM_LBUTTONDOWN
        AttachMessage Me, mUserControlHwnd, WM_LBUTTONUP
        AttachMessage Me, mUserControlHwnd, WM_LBUTTONDBLCLK
        AttachMessage Me, mUserControlHwnd, WM_MOUSEMOVE
        AttachMessage Me, mUserControlHwnd, WM_THEMECHANGED
        AttachMessage Me, mUserControlHwnd, WM_THEMEREPAINT
    End If
End Sub

Private Sub SubclassForm()
    If (mFormHwnd <> 0) And (Not mOnlySubclassUserControl) Then
        AttachMessage Me, mFormHwnd, WM_SYSCOLORCHANGE
        AttachMessage Me, mFormHwnd, WM_THEMECHANGED
        AttachMessage Me, mFormHwnd, WM_NCACTIVATE
        AttachMessage Me, mFormHwnd, WM_GETDPISCALEDSIZE
        If mTDIMode = ntTDIModeForms Then
            AttachMessage Me, mFormHwnd, WM_ACTIVATE
            AttachMessage Me, mFormHwnd, WM_ACTIVATEAPP
        End If
    End If
End Sub

Friend Sub SetDefaultPropertyValuesForThemedProperties(Optional nSetControlsColors As Boolean)
    Dim iBackColor_Prev As Long
    Dim iForeColor_Prev As Long
    
    iBackColor_Prev = IIf(mEnabled Or Not mShowDisabledState, mBackColorSelectedTab, mBackColorSelectedTabDisabled)
    iForeColor_Prev = mForeColorSelectedTab
    
    mForeColor = Ambient.ForeColor: PropertyChanged "ForeColor"
    mBackColorTabs = Ambient.BackColor: PropertyChanged "BackColorTabs"
    ' A theme that says nothing about one of these says nothing, which is what the flag records.
    mForeColorSelectedTab_IsAutomatic = True: PropertyChanged "ForeColorSelectedTab"
    mForeColorHighlighted_IsAutomatic = True: PropertyChanged "ForeColorHighlighted"
    mFlatTabBorderColorHighlighted_IsAutomatic = True: PropertyChanged "FlatTabBorderColorHighlighted"
    mFlatTabBorderColorSelectedTab_IsAutomatic = True: PropertyChanged "FlatTabBorderColorSelectedTab"
    mFlatTabBorderColorInactive_IsAutomatic = True: PropertyChanged "FlatTabBorderColorInactive"
    mIconColorSelectedTab_IsAutomatic = True: PropertyChanged "IconColorSelectedTab"
    mIconColorTabHighlighted_IsAutomatic = True: PropertyChanged "IconColorTabHighlighted"
    mIconColorMouseHover_IsAutomatic = True: PropertyChanged "IconColorMouseHover"
    mIconColorMouseHoverSelectedTab_IsAutomatic = True: PropertyChanged "IconColorMouseHoverSelectedTab"
    ' This one writes the variables directly instead of going through the setters, so the
    ' invalidation the setters do would be missed on every theme apply
    TDIInvalidateFormIcons
    mCloseButtonColor_IsAutomatic = True: PropertyChanged "CloseButtonColor"
    mCloseButtonColorSelectedTab_IsAutomatic = True: PropertyChanged "CloseButtonColorSelectedTab"
    ' The two hover slots of the 'x' keep a value and not a flag: they fall back to the red
    ' and not to a parent
    mCloseButtonColorMouseHover = cPropDef_CloseButtonColorMouseHover: PropertyChanged "CloseButtonColorMouseHover"
    mCloseButtonColorMouseHoverSelectedTab = cPropDef_CloseButtonColorMouseHover: PropertyChanged "CloseButtonColorMouseHoverSelectedTab"
    mCloseButtonColorTabHighlighted_IsAutomatic = True: PropertyChanged "CloseButtonColorTabHighlighted"
    mNewTabButtonColor_IsAutomatic = True: PropertyChanged "NewTabButtonColor"
    mNewTabButtonColorHighlighted_IsAutomatic = True: PropertyChanged "NewTabButtonColorHighlighted"
    
    mForeColorIsFromAmbient = True
    mBackColorTabsIsFromAmbient = True
    mStyle = cPropDef_Style
    If Not nSetControlsColors Then
        If cPropDef_Style = ntStyleWindows Then
            If ((Ambient.BackColor = vbButtonFace) And (Ambient.ForeColor = vbButtonText)) Or (TypeName(Parent) = "MDIForm") Then
                mStyle = cPropDef_Style
            Else
                mStyle = ntStyleFlat
            End If
        Else
            mStyle = cPropDef_Style
        End If
    End If
    PropertyChanged "Style"
    mVisualStyles = (mStyle = ntStyleWindows)
    RefreshSystemVisualStylesAvailable
    mBackColorSelectedTab_IsAutomatic = True: mBackColorSelectedTab = GetAutomaticBackColorSelectedTab: PropertyChanged "BackColorSelectedTab"
    mShowFocusRect = cPropDef_ShowFocusRect: PropertyChanged "ShowFocusRect"
    mHighlightEffect = cPropDef_HighlightEffect: PropertyChanged "HighlightEffect"
    mHighlightEffectOut = cPropDef_HighlightEffectOut: PropertyChanged "HighlightEffectOut"
    mTabWidthStyle = cPropDef_TabWidthStyle: PropertyChanged "TabWidthStyle"
    mTabHeightStyleForHorizontal = cPropDef_TabHeightStyleForHorizontal: PropertyChanged "TabHeightStyleForHorizontal"
    mShowRowsInPerspective = cPropDef_ShowRowsInPerspective: PropertyChanged "ShowRowsInPerspective"
    mTabSeparation = cPropDef_TabSeparation: PropertyChanged "TabSeparation"
    mTabPaddingWidth = cPropDef_TabPaddingWidth: PropertyChanged "TabPaddingWidth"
    mTabPaddingHeight = cPropDef_TabPaddingHeight: PropertyChanged "TabPaddingHeight"
    mTabAppearance = cPropDef_TabAppearance: PropertyChanged "TabAppearance"
    mSoftEdges = cPropDef_SoftEdges: PropertyChanged "SoftEdges"
    mFlatBarColorSelectedTab = cPropDef_FlatBarColorSelectedTab: PropertyChanged "FlatBarColorSelectedTab"
    
    mFlatBarColorHighlighted_IsAutomatic = True: PropertyChanged "FlatBarColorHighlighted"
    mFlatBarColorInactive_IsAutomatic = True: PropertyChanged "FlatBarColorInactive"
    mFlatTabsSeparationLineColor_IsAutomatic = True: PropertyChanged "FlatTabsSeparationLineColor"
    mFlatBodySeparationLineColor_IsAutomatic = True: PropertyChanged "FlatBodySeparationLineColor"
    mFlatBorderColor_IsAutomatic = True: PropertyChanged "FlatBorderColor"
    mHighlightColor_IsAutomatic = True: PropertyChanged "HighlightColor"
    mHighlightColorSelectedTab_IsAutomatic = True: PropertyChanged "HighlightColorSelectedTab"
    mHighlightGradientColor_IsAutomatic = True: PropertyChanged "HighlightGradientColor"
    mHighlightGradientColorSelectedTab_IsAutomatic = True: PropertyChanged "HighlightGradientColorSelectedTab"
    mFlatRoundnessTop = cPropDef_FlatRoundnessTop: PropertyChanged "FlatRoundnessTop"
    mFlatRoundnessBottom = cPropDef_FlatRoundnessBottom: PropertyChanged "FlatRoundnessBottom"
    mFlatRoundnessTabs = cPropDef_FlatRoundnessTabs: PropertyChanged "FlatRoundnessTabs"
    mTabMousePointerHand = cPropDef_TabMousePointerHand: PropertyChanged "TabMousePointerHand"
    mIconColor_IsAutomatic = True: PropertyChanged "IconColor"
    ApplyChainColors nSilent:=True
    mHighlightMode = cPropDef_HighlightMode: PropertyChanged "HighlightMode"
    mHighlightModeSelectedTab = cPropDef_HighlightModeSelectedTab: PropertyChanged "HighlightModeSelectedTab"
    mFlatBorderMode = cPropDef_FlatBorderMode: PropertyChanged "FlatBorderMode"
    mFlatBarHeight = cPropDef_FlatBarHeight: PropertyChanged "FlatBarHeight"
    mFlatBarGripHeight = cPropDef_FlatBarGripHeight: PropertyChanged "FlatBarGripHeight"
    mFlatTabBodyGap = cPropDef_FlatTabBodyGap: PropertyChanged "FlatTabBodyGap"
    mFlatBarPosition = cPropDef_FlatBarPosition: PropertyChanged "FlatBarPosition"
    mHighlightTabExtraHeight = DefaultHighlightTabExtraHeightHimetric: PropertyChanged "HighlightTabExtraHeight"
    mHighlightTabCaptionShift = DefaultHighlightTabCaptionShiftHimetric: PropertyChanged "HighlightTabCaptionShift"
    mFlatBodySeparationLineHeight = cPropDef_FlatBodySeparationLineHeight: PropertyChanged "FlatBodySeparationLineHeight"
    SetDPIScaledValues
    mTabMaxWidth = cPropDef_TabMaxWidth: PropertyChanged "TabMaxWidth"
    mTabMinWidth = cPropDef_TabMinWidth: PropertyChanged "TabMinWidth"
    mTabGeneralFixedWidth = cPropDef_TabGeneralFixedWidth: PropertyChanged "TabGeneralFixedWidth"
    
    SetFont
    If mTabAppearance <> ntTAAuto Then
        mAppearanceIsFlat = (mTabAppearance = ntTAFlat)
    Else
        mAppearanceIsFlat = mStyle = ntStyleFlat
    End If
    SetHighlightMode
    mSetAutoTabHeightPending = True
    SetButtonFaceColor
    SetColors
    UserControl.BackColor = mBackColor
    If nSetControlsColors Then
        SetControlsProperBackColor iBackColor_Prev
        SetControlsProperForeColor iForeColor_Prev
    End If
    ' the two variables above were written directly, so the button still carries the colors of
    ' whatever was applied before. Property Let cannot be relied on to catch this: the theme
    ' applied next assigns through it, and it does nothing when the value already matches
    NewTabButtonApplyColors
    mNeedToDraw = True
End Sub

Friend Property Let ControlJustAdded(nValue As Boolean)
    mControlJustAdded = nValue
End Property

Private Sub UserControl_KeyDown(KeyCode As Integer, Shift As Integer)
    Dim t As Long
    Dim iAgain As Boolean
    Dim iRow As Long
    Dim iHandled As Boolean
    Dim iVerticalKey As Integer
    
    RaiseEvent KeyDown(KeyCode, Shift)
    ' Down and up walk the index the other way where tab 0 is at the other end of the strip
    iVerticalKey = KeyCode
    If (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationRightBottomHorizontal) Then
        If KeyCode = vbKeyDown Then
            iVerticalKey = vbKeyUp
        ElseIf KeyCode = vbKeyUp Then
            iVerticalKey = vbKeyDown
        End If
    End If
    If KeyCode = vbKeyRight Then
        If (mTabOrientation = ssTabOrientationTop) Or (mTabOrientation = ntTabOrientationTopRight) Or (mTabOrientation = ssTabOrientationBottom) Or (mTabOrientation = ntTabOrientationBottomRight) Then
            t = mTab + 1
            If t = mTabs Then t = 0
            Do Until TabIsSelectableEffective(t)
                t = t + 1
                If t = mTabs Then
                    If iAgain Then Exit Sub
                    t = 0
                    iAgain = True
                End If
            Loop
            TabSel = t
            iHandled = True
        ElseIf (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Or (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationLeftBottomHorizontal) Or (mTabOrientation = ssTabOrientationRight) Or (mTabOrientation = ntTabOrientationRightBottom) Or (mTabOrientation = ntTabOrientationRightHorizontal) Or (mTabOrientation = ntTabOrientationRightBottomHorizontal) Then
            If (mRows > 1) And ((mTabWidthStyle2 = ntTWEqualWidth) Or (mTabWidthStyle2 = ntTWTabCaptionWidth)) Then
                If (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Or (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationLeftBottomHorizontal) Then
                    iRow = 0
                Else
                    iRow = mTabData(mTab).RowPos - 1
                End If
                Do Until TabIsSelectableEffective(t) And (mTabData(t).PosH = mTabData(mTab).PosH) And (mTabData(t).RowPos = iRow)
                    t = t - 1
                    If t = -1 Then t = mTabs - 1
                    Do Until TabIsSelectableEffective(t)
                        t = t - 1
                        If t = -1 Then
                            If iAgain Then Exit Sub
                            t = mTabs - 1
                            iAgain = True
                        End If
                    Loop
                Loop
                TabSel = t
                iHandled = True
            End If
        End If
        If Not iHandled Then
            SetFocusToNextControlInSameContainer True
        End If
    ElseIf KeyCode = vbKeyLeft Then
        If (mTabOrientation = ssTabOrientationTop) Or (mTabOrientation = ntTabOrientationTopRight) Or (mTabOrientation = ssTabOrientationBottom) Or (mTabOrientation = ntTabOrientationBottomRight) Then
            t = mTab - 1
            If t = -1 Then t = mTabs - 1
            Do Until TabIsSelectableEffective(t)
                t = t - 1
                If t = -1 Then
                    If iAgain Then Exit Sub
                    t = mTabs - 1
                    iAgain = True
                End If
            Loop
            TabSel = t
            iHandled = True
        ElseIf (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Or (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationLeftBottomHorizontal) Or (mTabOrientation = ssTabOrientationRight) Or (mTabOrientation = ntTabOrientationRightBottom) Or (mTabOrientation = ntTabOrientationRightHorizontal) Or (mTabOrientation = ntTabOrientationRightBottomHorizontal) Then
            If (mRows > 1) And ((mTabWidthStyle2 = ntTWEqualWidth) Or (mTabWidthStyle2 = ntTWTabCaptionWidth)) Then
                If (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Or (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationLeftBottomHorizontal) Then
                    iRow = mTabData(mTab).RowPos - 1
                Else
                    iRow = 0
                End If
                Do Until TabIsSelectableEffective(t) And (mTabData(t).PosH = mTabData(mTab).PosH) And (mTabData(t).RowPos = iRow)
                    t = t - 1
                    If t = -1 Then t = mTabs - 1
                    Do Until TabIsSelectableEffective(t)
                        t = t - 1
                        If t = -1 Then
                            If iAgain Then Exit Sub
                            t = mTabs - 1
                            iAgain = True
                        End If
                    Loop
                Loop
                TabSel = t
                iHandled = True
            End If
        End If
        If Not iHandled Then
            SetFocusToNextControlInSameContainer False
        End If
    ElseIf (iVerticalKey = vbKeyDown And ((Shift And vbCtrlMask) = 0)) Then
        If (mTabOrientation = ssTabOrientationTop) Or (mTabOrientation = ntTabOrientationTopRight) Or (mTabOrientation = ssTabOrientationBottom) Or (mTabOrientation = ntTabOrientationBottomRight) Then
            If (mRows > 1) And ((mTabWidthStyle2 = ntTWEqualWidth) Or (mTabWidthStyle2 = ntTWTabCaptionWidth)) Then
                t = mTab - 1
                If t = -1 Then t = mTabs - 1
                If (mTabOrientation = ssTabOrientationTop) Or (mTabOrientation = ntTabOrientationTopRight) Then
                    iRow = 0
                Else
                    iRow = mTabData(mTab).RowPos - 1
                End If
                Do Until TabIsSelectableEffective(t) And (mTabData(t).PosH = mTabData(mTab).PosH) And (mTabData(t).RowPos = iRow)
                    t = t - 1
                    If t = -1 Then t = mTabs - 1
                    Do Until TabIsSelectableEffective(t)
                        t = t - 1
                        If t = -1 Then
                            If iAgain Then Exit Sub
                            t = mTabs - 1
                            iAgain = True
                        End If
                    Loop
                Loop
                TabSel = t
                iHandled = True
            End If
        End If
        If Not iHandled Then
            If (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Or (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationLeftBottomHorizontal) Then
                t = mTab - 1
                If t = -1 Then t = mTabs - 1
                Do Until TabIsSelectableEffective(t)
                    t = t - 1
                    If t = -1 Then
                        If iAgain Then Exit Sub
                        t = mTabs - 1
                        iAgain = True
                    End If
                Loop
                TabSel = t
                iHandled = True
            ElseIf (mTabOrientation = ssTabOrientationRight) Or (mTabOrientation = ntTabOrientationRightBottom) Or (mTabOrientation = ntTabOrientationRightHorizontal) Or (mTabOrientation = ntTabOrientationRightBottomHorizontal) Then
                t = mTab + 1
                If t = mTabs Then t = 0
                Do Until TabIsSelectableEffective(t)
                    t = t + 1
                    If t = mTabs Then
                        If iAgain Then Exit Sub
                        t = 0
                        iAgain = True
                    End If
                Loop
                TabSel = t
                iHandled = True
            End If
        End If
        If Not iHandled Then
            SetFocusToNextControlInSameContainer True
        End If
    ElseIf (iVerticalKey = vbKeyUp And ((Shift And vbCtrlMask) = 0)) Then
        If (mTabOrientation = ssTabOrientationTop) Or (mTabOrientation = ntTabOrientationTopRight) Or (mTabOrientation = ssTabOrientationBottom) Or (mTabOrientation = ntTabOrientationBottomRight) Then
            If (mRows > 1) And ((mTabWidthStyle2 = ntTWEqualWidth) Or (mTabWidthStyle2 = ntTWTabCaptionWidth)) Then
                t = mTab - 1
                If t = -1 Then t = mTabs - 1
                If (mTabOrientation = ssTabOrientationTop) Or (mTabOrientation = ntTabOrientationTopRight) Then
                    iRow = mTabData(mTab).RowPos - 1
                Else
                    iRow = 0
                End If
                Do Until TabIsSelectableEffective(t) And (mTabData(t).PosH = mTabData(mTab).PosH) And (mTabData(t).RowPos = iRow)
                    t = t - 1
                    If t = -1 Then t = mTabs - 1
                    Do Until TabIsSelectableEffective(t)
                        t = t - 1
                        If t = -1 Then
                            If iAgain Then Exit Sub
                            t = mTabs - 1
                            iAgain = True
                        End If
                    Loop
                Loop
                TabSel = t
                iHandled = True
            End If
        End If
        If Not iHandled Then
            If (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Or (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationLeftBottomHorizontal) Then
                t = mTab + 1
                If t = mTabs Then t = 0
                Do Until TabIsSelectableEffective(t)
                    t = t + 1
                    If t = mTabs Then
                        If iAgain Then Exit Sub
                        t = 0
                        iAgain = True
                    End If
                Loop
                TabSel = t
                iHandled = True
            ElseIf (mTabOrientation = ssTabOrientationRight) Or (mTabOrientation = ntTabOrientationRightBottom) Or (mTabOrientation = ntTabOrientationRightHorizontal) Or (mTabOrientation = ntTabOrientationRightBottomHorizontal) Then
                t = mTab - 1
                If t = -1 Then t = mTabs - 1
                Do Until TabIsSelectableEffective(t)
                    t = t - 1
                    If t = -1 Then
                        If iAgain Then Exit Sub
                        t = mTabs - 1
                        iAgain = True
                    End If
                Loop
                TabSel = t
                iHandled = True
            End If
        End If
        If Not iHandled Then
            SetFocusToNextControlInSameContainer False
        End If
    ElseIf KeyCode = vbKeyTab And ((Shift And vbCtrlMask) > 0) And ((Shift And vbShiftMask) = 0) Then
        t = mTab + 1
        If t = mTabs Then t = 0
        Do Until TabIsSelectableEffective(t)
            t = t + 1
            If t = mTabs Then
                If iAgain Then Exit Sub
                t = 0
                iAgain = True
            End If
        Loop
        TabSel = t
    ElseIf KeyCode = vbKeyTab And ((Shift And vbCtrlMask) > 0) And ((Shift And vbShiftMask) > 0) Then
        t = mTab - 1
        If t = -1 Then t = mTabs - 1
        Do Until TabIsSelectableEffective(t)
            t = t - 1
            If t = -1 Then
                If iAgain Then Exit Sub
                t = mTabs - 1
                iAgain = True
            End If
        Loop
        TabSel = t
    ElseIf (KeyCode = vbKeyPageDown And ((Shift And vbCtrlMask) > 0)) Then
        If (mTabOrientation = ssTabOrientationTop) Or (mTabOrientation = ntTabOrientationTopRight) Or (mTabOrientation = ssTabOrientationBottom) Or (mTabOrientation = ntTabOrientationBottomRight) Or (mTabOrientation = ssTabOrientationRight) Or (mTabOrientation = ntTabOrientationRightBottom) Or (mTabOrientation = ntTabOrientationRightHorizontal) Or (mTabOrientation = ntTabOrientationRightBottomHorizontal) Then
            t = mTab + 1
            If t = mTabs Then t = 0
            Do Until TabIsSelectableEffective(t)
                t = t + 1
                If t = mTabs Then
                    If iAgain Then Exit Sub
                    t = 0
                    iAgain = True
                End If
            Loop
            TabSel = t
        Else
            t = mTab - 1
            If t = -1 Then t = mTabs - 1
            Do Until TabIsSelectableEffective(t)
                t = t - 1
                If t = -1 Then
                    If iAgain Then Exit Sub
                    t = mTabs - 1
                    iAgain = True
                End If
            Loop
            TabSel = t
        End If
    ElseIf KeyCode = vbKeyPageUp And ((Shift And vbCtrlMask) > 0) Then
        If (mTabOrientation = ssTabOrientationTop) Or (mTabOrientation = ntTabOrientationTopRight) Or (mTabOrientation = ssTabOrientationBottom) Or (mTabOrientation = ntTabOrientationBottomRight) Or (mTabOrientation = ssTabOrientationRight) Or (mTabOrientation = ntTabOrientationRightBottom) Or (mTabOrientation = ntTabOrientationRightHorizontal) Or (mTabOrientation = ntTabOrientationRightBottomHorizontal) Then
            t = mTab - 1
            If t = -1 Then t = mTabs - 1
            Do Until TabIsSelectableEffective(t)
                t = t - 1
                If t = -1 Then
                    If iAgain Then Exit Sub
                    t = mTabs - 1
                    iAgain = True
                End If
            Loop
            TabSel = t
        Else
            t = mTab + 1
            If t = mTabs Then t = 0
            Do Until TabIsSelectableEffective(t)
                t = t + 1
                If t = mTabs Then
                    If iAgain Then Exit Sub
                    t = 0
                    iAgain = True
                End If
            Loop
            TabSel = t
        End If
    End If
End Sub

Private Sub SetFocusToNextControlInSameContainer(nForward As Boolean)
    Dim iContainerUsr As Object
    Dim iContainerCtl As Object
    Dim iControls As Object
    Dim iHwnds() As LongPtr
    Dim iTabIndexes() As Long
    Dim iCtl As Object
    Dim iTi As Long
    Dim iHwnd As LongPtr
    Dim iEnabled As Boolean
    Dim iVisible As Boolean
    Dim iCount As Long
    Dim iUb As Long
    Dim iTiUsr As Long
    Dim c As Long
    
    On Error Resume Next
    Set iContainerUsr = UserControl.Extender.Container
    If iContainerUsr Is Nothing Then GoTo Exit_Sub
    
    Set iControls = UserControl.Parent.Controls
    If iControls Is Nothing Then GoTo Exit_Sub
    
    iTiUsr = -1
    iTiUsr = UserControl.Extender.TabIndex
    If iTiUsr = -1 Then GoTo Exit_Sub
    
    ReDim iHwnds(100)
    ReDim iTabIndexes(100)
    iUb = 100
    iCount = 0
    
    For Each iCtl In iControls
        Set iContainerCtl = Nothing
        Set iContainerCtl = iCtl.Container
        If iContainerCtl Is iContainerUsr Then
            iTi = -1
            iHwnd = 0
            iEnabled = False
            iVisible = False
            
            iTi = iCtl.TabIndex
            If iTi > -1 Then
                iHwnd = GetControlHwnd(iCtl)
                If iHwnd > 0 Then
                    iEnabled = iCtl.Enabled
                    iVisible = iCtl.Visible
                    If iEnabled And iVisible Then
                        iCount = iCount + 1
                        If (iCount - 1) > iUb Then
                            iUb = iUb + 100
                            ReDim Preserve iHwnds(iUb)
                            ReDim Preserve iTabIndexes(iUb)
                        End If
                        iHwnds(iCount - 1) = iHwnd
                        iTabIndexes(iCount - 1) = iTi
                    End If
                End If
            End If
        End If
    Next
    
    If iCount > 1 Then ' 1 means that the UserControl is the only control in the container, so there is no other control to focus
        ReDim Preserve iHwnds(iCount - 1)
        ReDim Preserve iTabIndexes(iCount - 1)
        
        ' Bubble sort
        Dim s As Long
        Dim iChanged As Boolean

        s = UBound(iTabIndexes)
        Do
            iChanged = False
            For c = 0 To s - 1
                If iTabIndexes(c) > iTabIndexes(c + 1) Then
                    iTi = iTabIndexes(c)
                    iHwnd = iHwnds(c)
                    iTabIndexes(c) = iTabIndexes(c + 1)
                    iHwnds(c) = iHwnds(c + 1)
                    iTabIndexes(c + 1) = iTi
                    iHwnds(c + 1) = iHwnd
                    iChanged = True
                End If
            Next c
            s = s - 1
        Loop While iChanged
        
        For c = 0 To UBound(iTabIndexes)
            If iTabIndexes(c) = iTiUsr Then
                If nForward Then
                    If c = UBound(iTabIndexes) Then
                        iHwnd = iHwnds(0)
                    Else
                        iHwnd = iHwnds(c + 1)
                    End If
                Else
                    If c = 0 Then
                        iHwnd = iHwnds(UBound(iTabIndexes))
                    Else
                        iHwnd = iHwnds(c - 1)
                    End If
                End If
                SetFocusAPI iHwnd
            End If
        Next c
    End If
    
Exit_Sub:
    Err.Clear
End Sub

Private Sub UserControl_KeyPress(KeyAscii As Integer)
    If mDragState = cDragStateActive Then
        If KeyAscii = vbKeyEscape Then
            ' Nothing has been committed yet, so cancelling is just putting the array
            ' back the way it was. No event was raised and none has to be undone
            MoveTabInternal mTab, mDragStartIndex
            DragEnd
            Draw
        End If
    End If
    RaiseEvent KeyPress(KeyAscii)
End Sub

Private Sub UserControl_KeyUp(KeyCode As Integer, Shift As Integer)
    RaiseEvent KeyUp(KeyCode, Shift)
End Sub

Private Sub UserControl_LostFocus()
    mHasFocus = False
    PostDrawMessage
End Sub

Private Sub UserControl_MouseDown(Button As Integer, Shift As Integer, X As Single, Y As Single)
    Dim iX As Single
    Dim iY As Single
    Dim iXp As Single
    Dim iYp As Single
    Dim iTabIconClicked As Boolean
    Dim iForwardClickToTab As Boolean
    Dim iTabCloseButtonClicked As Boolean
    Dim iCancelClose As Boolean
    Dim iTabClicked As Long
    
    DragSettleCancel
    iX = X * mXCorrection
    iY = Y * mYCorrection
    mPressTab = mTabUnderMouse
    mPressStripButton = mStripButtonHovered
    mPressStripClose = mStripCloseButtonHovered
    mPressIconTab = -1
    If mMouseIsOverIcon Then mPressIconTab = mMouseIsOverIcon_Tab
    mPressCloseButtonTab = -1
    If mMouseIsOverCloseButton Then mPressCloseButtonTab = mMouseIsOverCloseButton_Tab
    
    ' X and Y untouched here, and iX and iY for everything internal below.
    RaiseEvent MouseDown(Button, Shift, X, Y)
    
    If Button = 1 Then
        ' Which tab was clicked has to be remembered here, before anything below can change
        ' it: setting TabSel raises TabMouseLeave and leaves mTabUnderMouse at -1, so from
        ' that point on it no longer tells what the click landed on
        iTabClicked = mTabUnderMouse
        If mTabUnderMouse = -1 Then
            StripButtonClick pScaleX(iX, vbTwips, vbPixels), pScaleY(iY, vbTwips, vbPixels)
            If StripCloseButtonHitTest(pScaleX(iX, vbTwips, vbPixels), pScaleY(iY, vbTwips, vbPixels)) Then
                If mAmbientUserMode Then StripCloseButtonClick
            End If
        End If
        If mTabUnderMouse > -1 Then
            iXp = pScaleX(iX, vbTwips, vbPixels)
            iYp = pScaleY(iY, vbTwips, vbPixels)
            If TabCloseButtonShown(mTabUnderMouse) Then
                If (iXp + mIconClickExtendDPIScaled) >= mTabData(mTabUnderMouse).CloseButtonRect.Left Then
                    If (iXp - mIconClickExtendDPIScaled) <= mTabData(mTabUnderMouse).CloseButtonRect.Right Then
                        If (iYp + mIconClickExtendDPIScaled) >= mTabData(mTabUnderMouse).CloseButtonRect.Top Then
                            If (iYp - mIconClickExtendDPIScaled) <= mTabData(mTabUnderMouse).CloseButtonRect.Bottom Then
                                ' Run time only: at design time a click on the close button must
                                ' behave as a plain click on the tab.
                                If mAmbientUserMode Then
                                    iTabCloseButtonClicked = True
                                    If mTDIMode <> ntTDIModeNone Then
                                        HandleTabTDIEvents mTabUnderMouse
                                    ElseIf mTabData(mTabUnderMouse).CloseButtonEnabled Then
                                        RaiseEvent CloseButtonClick(mTabUnderMouse, iCancelClose)
                                        If Not iCancelClose Then
                                            TabVisible(iTabClicked) = False
                                        End If
                                    End If
                                End If
                            End If
                        End If
                    End If
                End If
            End If
            If Not iTabCloseButtonClicked Then
                If (iXp + mIconClickExtendDPIScaled) >= mTabData(mTabUnderMouse).IconRect.Left Then
                    If (iXp - mIconClickExtendDPIScaled) <= mTabData(mTabUnderMouse).IconRect.Right Then
                        If (iYp + mIconClickExtendDPIScaled) >= mTabData(mTabUnderMouse).IconRect.Top Then
                            If (iYp - mIconClickExtendDPIScaled) <= mTabData(mTabUnderMouse).IconRect.Bottom Then
                                iForwardClickToTab = True
                                RaiseEvent IconClick(mTabUnderMouse, iForwardClickToTab)
                                iTabIconClicked = True
                            End If
                        End If
                    End If
                End If
            End If
            If (Not iTabCloseButtonClicked) And ((Not iTabIconClicked) Or iForwardClickToTab) Then
                If mTabData(mTabUnderMouse).Enabled Then
                    If mTab <> mTabUnderMouse Then
                        mHasFocus = True
                        mTabChangedFromAnotherRow = (mTabData(mTabUnderMouse).RowPos <> (mRows - 1))
                        mProcessingTabChange = True
                        TabSel = mTabUnderMouse
                        mProcessingTabChange = False
                    End If
                End If
            End If
        End If
        If mCanReorderTabs Then
            ' Only arm a drag, do not start one: the drag starts in MouseMove once the pointer has
            ' actually travelled far enough.
            mDragState = cDragStateNone
            ' mTabChangedFromAnotherRow is deliberately not checked here any more.
            If (iTabClicked > -1) And (iTabClicked = mTab) Then
                If Not (mProcessingTabChange Or (IIf(mTDIMode, VisibleTabsWithoutNewTabButton < 3, VisibleTabsWithoutNewTabButton < 2))) Then
                    ' A disabled tab is not dragged either. It cannot normally be the selected one,
                    ' because clicking it does not select it, but it can have been left selected at
                    ' design time.
                    If TabIsMovableEffective(mTab) And mTabData(mTab).Enabled Then
                        mDragState = cDragStateArmed
                        mDragAnchorX = pScaleX(iX, vbTwips, vbPixels)
                        mDragAnchorY = pScaleY(iY, vbTwips, vbPixels)
                    End If
                End If
            End If
        End If
    ElseIf (Button = vbMiddleButton) And (mTDIMode <> ntTDIModeNone) Then
        HandleTabTDIEvents mTabUnderMouse
    ElseIf mCanReorderTabs Then
        mDragState = cDragStateNone
    End If
End Sub

Private Sub HandleTabTDIEvents(ByVal nTab As Long)
    Dim iOpenAnother As Boolean
    Dim iIsLastTab As Boolean
    Dim iTabCaption As String
    Dim iTabNumber As Long
    Dim iCancel As Boolean
    Dim iLoadTabControls As Boolean
    Dim iUnloadTabControls As Boolean
    Const WM_SYSCOMMAND As Long = &H112
    Const SC_CLOSE As Long = &HF060&
    Const SW_HIDE As Long = 0
    Const WM_CLOSE As Long = &H10&
    Dim iHwnd As LongPtr
    Dim iTabUnderMouse As Long
    Dim iShowTabCloseButton As Boolean
    Dim iDo As Boolean
    Dim iTabVisible As Boolean
    
    If nTab > -1 Then
        iDo = TabCloseButtonAllowed(nTab)
        If iDo Then
            iDo = Not ((mTDIMode = ntTDIModeForms) And (nTab = FindTab(0, ntFindOriginalIndex)))
        End If
    End If
    If Not iDo Then Exit Sub
    
    iTabUnderMouse = nTab
    ' the branch that added a tab from here is gone: TabCloseButtonEffective refuses the close
    ' button on the new tab button, so whatever is under the mouse here is a real tab
    If Not TabIsNewTabButton(iTabUnderMouse) Then
        iOpenAnother = (mTDIMode = ntTDIModeControls)
        ' In TDI Forms the home tab stays visible and cannot be closed, so two are left; in TDI Controls
        ' the template tab is hidden at run time, so one
        iIsLastTab = (VisibleTabsWithoutNewTabButton = IIf(mTDIMode = ntTDIModeForms, 2, 1))
        iTabNumber = mTabData(iTabUnderMouse).TDITabNumber
        iUnloadTabControls = True
        RaiseEvent TDIBeforeClosingTab(iTabNumber, iTabUnderMouse, iIsLastTab, iOpenAnother, iUnloadTabControls, iCancel)
        If iOpenAnother Then If (mTDIMode = ntTDIModeForms) Then iOpenAnother = False
        If mAmbientUserMode And (Not iCancel) Then
            If Not iIsLastTab Then
                iOpenAnother = False
            End If
            Redraw = False
            If mTDIMode = ntTDIModeControls Then
                mTDIClosingATab = True
                TabVisible(iTabUnderMouse) = False
                mTDIClosingATab = False
                If iUnloadTabControls Then
                    TDIUnloadTabControls iTabNumber
                End If
            ElseIf mTDIMode = ntTDIModeForms Then
                iHwnd = mTDIModeFormsFormData_FormHwnd(mTabData(iTabUnderMouse).Data)
                If IsWindow(iHwnd) <> 0 Then
                    mTDIFormCloseFromControl = True
                    If mTDIFormWithoutCloseButton(mTabData(iTabUnderMouse).Data) Then
                        PostMessage iHwnd, WM_CLOSE, 0, 0
                    Else
                        SendMessage iHwnd, WM_SYSCOMMAND, SC_CLOSE, 0&
                    End If
                    mTDIFormCloseFromControl = False
                End If
                If IsWindow(iHwnd) <> 0 Then
                    iCancel = True
                Else
                    ShowWindow iHwnd, SW_HIDE
                    SetParent iHwnd, mTDIModeFormsFormData_OldParentHwnd(mTabData(iTabUnderMouse).Data)
                    mTDIClosingATab = True
                    TabVisible(iTabUnderMouse) = False
                    mTDIClosingATab = False
                End If
            End If
            If Not iCancel Then
                RaiseEvent TDITabClosed(iTabNumber, iIsLastTab)
                If iOpenAnother Then
                    mTDILastTabNumber = mTDILastTabNumber + 1
                    iTabCaption = mTDIDefaultTabCaption
                    iLoadTabControls = True
                    iShowTabCloseButton = True
                    RaiseEvent TDIBeforeNewTab(ntLastTabClosed, mTDILastTabNumber, iTabCaption, iLoadTabControls, iShowTabCloseButton, False)
                    TDIPrepareNewTab iTabCaption, iLoadTabControls, , , iShowTabCloseButton
                End If
            End If
            Redraw = True
        End If
    End If
End Sub

Private Sub UserControl_MouseMove(Button As Integer, Shift As Integer, X As Single, Y As Single)
    Dim iX As Single
    Dim iY As Single
    Dim iXp As Single
    Dim iYp As Single
    Dim iCol As Long
    Dim iMouseOverIcon_Tab_Prev As Long
    Dim iBool As Boolean
    Dim i As Long
    Dim iHeld As Boolean
    
    If mTDIAddingNewTab Then Exit Sub
    
    iX = X * mXCorrection
    iY = Y * mYCorrection
    iHeld = (Button <> 0) And (mDragState <> cDragStateActive)
    
    ProcessMouseMove Button, Shift, iX, iY, iHeld
    ' Uncorrected - see UserControl_MouseDown
    If Not mReevaluatingHover Then RaiseEvent MouseMove(Button, Shift, X, Y)
    
    ' Resolved and not IsEmpty. What is being asked here is "does the hover colour differ from
    ' the resting one, is there anything to repaint on the way in", and an unset slot no longer
    ' means "the general one" - it means whatever the tab's own chain hands down
    If mTabUnderMouse = mTab Then
        iCol = mTabData(mTabUnderMouse).CustomColors.ResolvedChainColor(ntChainIconColorSelectedTab)
        iBool = (mTabData(mTabUnderMouse).CustomColors.ResolvedChainColor(ntChainIconColorMouseHoverSelectedTab) <> iCol)
    Else
        iCol = mTabData(mTabUnderMouse).CustomColors.ResolvedChainColor(ntChainIconColor)
        iBool = (mTabData(mTabUnderMouse).CustomColors.ResolvedChainColor(ntChainIconColorMouseHover) <> iCol)
    End If
    If iBool Then
        Static sTabOverIcon_Last As Long
        Dim iImo As Boolean
        Dim iTum As Long
        
        If mTabUnderMouse > -1 Then
            iImo = mMouseIsOverIcon_Tab = mTabUnderMouse
            If mTabMousePointerHand Then
                If iImo Then
                    mCurrentMousePointerIsHand = True
                Else
                    mCurrentMousePointerIsHand = (mTabUnderMouse <> mTab)
                End If
                If mCurrentMousePointerIsHand Then
                    If GetCursor <> IDC_HAND Then
                        SetCursor mHandIconHandle
                    End If
                End If
            End If
            If iImo Then
                iTum = mTabUnderMouse
            Else
                iTum = -1
            End If
            If iTum <> sTabOverIcon_Last Then
                Draw
                sTabOverIcon_Last = iTum
            End If
        Else
            If mTabMousePointerHand Then mCurrentMousePointerIsHand = False
            sTabOverIcon_Last = -1
        End If
    End If

    If mCanReorderTabs And (Not mReevaluatingHover) Then
        If mDragState <> cDragStateNone Then
            If (Button <> 1) Or mProcessingTabChange Or mChangingSelectedTab Then
                DragEnd
            Else
                If mDragState = cDragStateArmed Then
                    ' Start the drag on distance, the way Windows does everywhere else,
                    ' instead of after a fixed delay: with a delay the tab sits still and
                    ' then jumps by everything the pointer already travelled
                    If (Abs(pScaleX(iX, vbTwips, vbPixels) - mDragAnchorX) >= GetSystemMetrics(SM_CXDRAG)) Or (Abs(pScaleY(iY, vbTwips, vbPixels) - mDragAnchorY) >= GetSystemMetrics(SM_CYDRAG)) Then
                        DragBegin
                    End If
                End If
                If mDragState = cDragStateActive Then
                    ' Windows synthesizes a WM_MOUSEMOVE every time a window is moved, sized, shown
                    ' or hidden under the cursor, and the drag repaint does exactly that (picDraw
                    ' gets resized, the UserControl Picture gets replaced).
                    If (iX <> mDragLastMoveX) Or (iY <> mDragLastMoveY) Then
                        mDragLastMoveX = iX
                        mDragLastMoveY = iY
                        DragUpdateFromMouse pScaleX(iX, vbTwips, vbPixels), pScaleY(iY, vbTwips, vbPixels)
                        ' The one place the strip cache may be taken from. DragUpdateFromMouse
                        ' has just refreshed the gap offsets, so by the time Draw runs they
                        ' are the ones it compares the cache against
                        mDragStripCacheAllowed = True
                        DrawDelayed
                        ' The drag repaint only invalidates: Draw ends by handing picDraw over to
                        ' UserControl.Picture.
                        UserControl.Refresh
                    End If
                End If
            End If
        End If
    End If
    
    If mDragState = cDragStateActive Then
        ' see DragClearHoverStates
    ElseIf Not mMouseIsOverIcon Then
        If (mTabUnderMouse > -1) And ((Not iHeld) Or (mTabUnderMouse = mPressIconTab)) Then
            If mTabData(mTabUnderMouse).IconChar <> 0 Then
                iXp = pScaleX(iX, vbTwips, vbPixels)
                iYp = pScaleY(iY, vbTwips, vbPixels)
                If (iXp + mIconClickExtendDPIScaled) >= mTabData(mTabUnderMouse).IconRect.Left Then
                    If (iXp - mIconClickExtendDPIScaled) <= mTabData(mTabUnderMouse).IconRect.Right Then
                        If (iYp + mIconClickExtendDPIScaled) >= mTabData(mTabUnderMouse).IconRect.Top Then
                            If (iYp - mIconClickExtendDPIScaled) <= mTabData(mTabUnderMouse).IconRect.Bottom Then
                                ' The home tab of TDI Forms used to be excluded here, from back when
                                ' its icon slot was where the close 'x' was drawn.
                                mMouseIsOverIcon = True
                                mMouseIsOverIcon_Tab = mTabUnderMouse
                                RaiseEvent IconMouseEnter(mTabUnderMouse)
                                tmrHighlightIcon.Enabled = False
                                tmrHighlightIcon.Enabled = True
                                tmrPreHighlightIcon.Enabled = False
                                tmrPreHighlightIcon.Enabled = True
                                tmrHighlightIcon.Tag = mMouseIsOverIcon_Tab
                            End If
                        End If
                    End If
                End If
            End If
        End If
    Else
        mMouseIsOverIcon = False
        iMouseOverIcon_Tab_Prev = mMouseIsOverIcon_Tab
        mMouseIsOverIcon_Tab = -1
        If mTabUnderMouse > -1 Then
            If mTabData(mTabUnderMouse).IconChar <> 0 Then
                iXp = pScaleX(iX, vbTwips, vbPixels)
                iYp = pScaleY(iY, vbTwips, vbPixels)
                If (iXp + mIconClickExtendDPIScaled) >= mTabData(mTabUnderMouse).IconRect.Left Then
                    If (iXp - mIconClickExtendDPIScaled) <= mTabData(mTabUnderMouse).IconRect.Right Then
                        If (iYp + mIconClickExtendDPIScaled) >= mTabData(mTabUnderMouse).IconRect.Top Then
                            If (iYp - mIconClickExtendDPIScaled) <= mTabData(mTabUnderMouse).IconRect.Bottom Then
                                mMouseIsOverIcon = True
                                mMouseIsOverIcon_Tab = mTabUnderMouse
                            End If
                        End If
                    End If
                End If
            End If
        End If
        If Not mMouseIsOverIcon Then
            RaiseEvent IconMouseLeave(iMouseOverIcon_Tab_Prev)
        End If
    End If
    
    ' Close button hover (point 1, ToDo NewTab 2), same enter/leave debounce pattern used above for the Icon
    If mDragState = cDragStateActive Then
        ' see DragClearHoverStates
    ElseIf Not mMouseIsOverCloseButton Then
        If (mTabUnderMouse > -1) And ((Not iHeld) Or (mTabUnderMouse = mPressCloseButtonTab)) Then
            If TabCloseButtonShown(mTabUnderMouse) Then
                iXp = pScaleX(iX, vbTwips, vbPixels)
                iYp = pScaleY(iY, vbTwips, vbPixels)
                If (iXp + mIconClickExtendDPIScaled) >= mTabData(mTabUnderMouse).CloseButtonRect.Left Then
                    If (iXp - mIconClickExtendDPIScaled) <= mTabData(mTabUnderMouse).CloseButtonRect.Right Then
                        If (iYp + mIconClickExtendDPIScaled) >= mTabData(mTabUnderMouse).CloseButtonRect.Top Then
                            If (iYp - mIconClickExtendDPIScaled) <= mTabData(mTabUnderMouse).CloseButtonRect.Bottom Then
                                mMouseIsOverCloseButton = True
                                mMouseIsOverCloseButton_Tab = mTabUnderMouse
                                mTabData(mTabUnderMouse).CloseButtonHovered = True
                                RaiseEvent CloseButtonMouseEnter(mTabUnderMouse)
                                DrawDelayed
                            End If
                        End If
                    End If
                End If
            End If
        End If
    Else
        Dim iMouseOverCloseButton_Tab_Prev As Long
        
        mMouseIsOverCloseButton = False
        iMouseOverCloseButton_Tab_Prev = mMouseIsOverCloseButton_Tab
        mMouseIsOverCloseButton_Tab = -1
        If iMouseOverCloseButton_Tab_Prev > -1 Then
            If iMouseOverCloseButton_Tab_Prev < mTabs Then mTabData(iMouseOverCloseButton_Tab_Prev).CloseButtonHovered = False
        End If
        If mTabUnderMouse > -1 Then
            If TabCloseButtonShown(mTabUnderMouse) Then
                iXp = pScaleX(iX, vbTwips, vbPixels)
                iYp = pScaleY(iY, vbTwips, vbPixels)
                If (iXp + mIconClickExtendDPIScaled) >= mTabData(mTabUnderMouse).CloseButtonRect.Left Then
                    If (iXp - mIconClickExtendDPIScaled) <= mTabData(mTabUnderMouse).CloseButtonRect.Right Then
                        If (iYp + mIconClickExtendDPIScaled) >= mTabData(mTabUnderMouse).CloseButtonRect.Top Then
                            If (iYp - mIconClickExtendDPIScaled) <= mTabData(mTabUnderMouse).CloseButtonRect.Bottom Then
                                mMouseIsOverCloseButton = True
                                mMouseIsOverCloseButton_Tab = mTabUnderMouse
                                mTabData(mTabUnderMouse).CloseButtonHovered = True
                            End If
                        End If
                    End If
                End If
            End If
        End If
        If Not mMouseIsOverCloseButton Then
            RaiseEvent CloseButtonMouseLeave(iMouseOverCloseButton_Tab_Prev)
            DrawDelayed
        End If
    End If
End Sub

' Takes twips already multiplied by mXCorrection / mYCorrection. The three callers are the
' two OLE drag handlers and tmrRestoreDropMode_Timer, and the correction is applied at each
' of them and not here, because the timer arrives through Screen_TwipsPerPixelX, which
' carries it already - doing it here would correct that one twice
Private Function GetTabAtXY(X As Single, Y As Single) As Long
    Dim t As Long
    Dim iX As Long
    Dim iY As Long
    
    iX = pScaleX(X, vbTwips, vbPixels)
    iY = pScaleY(Y, vbTwips, vbPixels)
    
    GetTabAtXY = mTab
    For t = 0 To mTabs - 1
        With mTabData(t).TabRect
            If iX >= .Left Then
                If iX <= .Right Then
                    If iY >= TabHitTop(t) Then
                        If iY <= .Bottom Then
                            GetTabAtXY = t
                            Exit For
                        End If
                    End If
                End If
            End If
        End With
    Next
End Function

' In Bottom the stored TabRect starts two rows inside the body, because its conversion to the
' screen is shaped for placing the caption. The tab itself starts where the mirror of Top puts it.
Private Function TabHitTop(ByVal nTab As Long) As Long
    TabHitTop = mTabData(nTab).TabRect.Top
    If mOrientationIsBottom Then TabHitTop = TabHitTop + 2
End Function

Private Sub ProcessMouseMove(Button As Integer, Shift As Integer, X As Single, Y As Single, Optional ByVal nHeld As Boolean)
    Dim t As Long
    Dim iX As Long
    Dim iY As Long
    Dim iOverStripClose As Boolean
    Dim iOverScroll As Long
    Dim iTabsHittable As Boolean
    
    iX = pScaleX(X, vbTwips, vbPixels)
    iY = pScaleY(Y, vbTwips, vbPixels)
    If (Not mAmbientUserMode) And mRightToLeft Then iX = mScaleWidth - iX
    iOverStripClose = StripCloseButtonHitTest(iX, iY)
    If nHeld And (Not mPressStripClose) Then iOverStripClose = False
    If mStripCloseButtonHovered And (Not iOverStripClose) Then SetStripCloseButtonHovered False
    iOverScroll = StripButtonHitTest(iX, iY)
    If nHeld And (iOverScroll <> mPressStripButton) Then iOverScroll = 0
    If iOverScroll <> mStripButtonHovered Then
        If (iOverScroll = 0) Or mAmbientUserMode Then SetStripButtonHovered iOverScroll
        If iOverScroll <> 0 Then
            ' the timer is what notices the pointer leaving the control
            tmrTabMouseLeave.Enabled = False
            tmrTabMouseLeave.Enabled = True
        End If
    End If
    iTabsHittable = ScrollViewContains(iX, iY)
    
    ' first check for the active tab, because in some cases it is bigger and can overlap surrounding tabs
    If (mTab > -1) And (mTab < mTabs) And iTabsHittable And ((Not nHeld) Or (mTab = mPressTab)) Then
        With mTabData(mTab).TabRect
            If iX >= .Left Then
                If iX <= .Right Then
                    If iY >= TabHitTop(mTab) Then
                        If iY <= .Bottom Then
                            If mTab <> mTabUnderMouse Then
                                If mTabUnderMouse > -1 Then
                                    RaiseEvent_TabMouseLeave (mTabUnderMouse)
                                End If
                                RaiseEvent_TabMouseEnter (mTab)
                                mTabUnderMouse = mTab
                                tmrTabMouseLeave.Enabled = False
                                tmrTabMouseLeave.Enabled = True
                            End If
                            Exit Sub
                        End If
                    End If
                End If
            End If
        End With
    End If
    
    For t = 0 To mTabs - 1
        If (t <> mTab) And iTabsHittable And ((Not nHeld) Or (t = mPressTab)) Then
            If mTabData(t).Visible And mTabData(t).Enabled Then
                With mTabData(t).TabRect
                    If iX >= .Left Then
                        If iX <= .Right Then
                            If iY >= TabHitTop(t) Then
                                If iY <= .Bottom Then
                                    If t <> mTabUnderMouse Then
                                        If mTabUnderMouse > -1 Then
                                            RaiseEvent_TabMouseLeave (mTabUnderMouse)
                                        End If
                                        RaiseEvent_TabMouseEnter (t)
                                        mTabUnderMouse = t
                                        tmrTabMouseLeave.Enabled = False
                                        tmrTabMouseLeave.Enabled = True
                                    End If
                                    Exit Sub
                                End If
                            End If
                        End If
                    End If
                End With
            End If
        End If
    Next t
    If mTabUnderMouse > -1 Then
        tmrTabMouseLeave.Enabled = False
        RaiseEvent_TabMouseLeave (mTabUnderMouse)
        ' a strip button reached straight from the tab was set watching above, and the pointer can
        ' still leave the control from it
        If (mStripButtonHovered <> 0) Or mStripCloseButtonHovered Then tmrTabMouseLeave.Enabled = True
    End If
    mTabUnderMouse = -1
    If iOverStripClose And (Not mStripCloseButtonHovered) And mAmbientUserMode Then
        SetStripCloseButtonHovered True
        ' the timer is what notices the pointer leaving the control
        tmrTabMouseLeave.Enabled = False
        tmrTabMouseLeave.Enabled = True
    End If
End Sub

Private Sub UserControl_MouseUp(Button As Integer, Shift As Integer, X As Single, Y As Single)
    Dim iFinalIndex As Long
    
    ' Uncorrected, and the two locals that held the corrected pair went with them: nothing
    ' else in this routine reads a coordinate - see UserControl_MouseDown
    If mScrollRepeatDir <> 0 Then ScrollRepeatStop
    ' Hover was held back while the button was down, and it is also what MouseDown reads to
    ' know which tab a click lands on, so it is brought up to date here without waiting for a move
    If mDragState <> cDragStateActive Then
        mReevaluatingHover = True
        UserControl_MouseMove 0, Shift, X, Y
        mReevaluatingHover = False
    End If
    RaiseEvent MouseUp(Button, Shift, X, Y)
    If mTabUnderMouse > -1 Then
        If Button = 2 Then
            RaiseEvent TabRightClick(mTabUnderMouse, Shift, X, Y)
        End If
    End If
    
    If mCanReorderTabs Then
        If mDragState = cDragStateActive Then
            ' Nothing was reordered while the tab was being dragged, whatever the number of rows:
            ' what the other tabs did was open a gap where it would go.
            iFinalIndex = GetTabAtDropPoint
            DragSettleCapture
            
            ' Put the array back the way it was and let the public MoveTab do the real move,
            ' so a whole drag raises a single BeforeTabReorder/TabReordered pair and the
            ' handler can still cancel it or redirect it
            MoveTabInternal mTab, mDragStartIndex
            DragEnd
            If iFinalIndex > -1 Then
                If iFinalIndex <> mDragStartIndex Then MoveTab mDragStartIndex, iFinalIndex
            End If
            DragSettleBegin
            Draw
        End If
        mDragState = cDragStateNone
    End If
    mTabChangedFromAnotherRow = False
End Sub

Private Sub DragResolveInsertion(ByRef nCandidate As Long, ByRef nRow As Long)
    ' Where the dragged tab would go if it were dropped right now, as a row and a position inside
    ' it.
    Dim t As Long
    Dim iVirtualLeft As Single
    Dim iVirtualCenterY As Single
    Dim iAnchor As Long
    Dim iAdvance As Long
    Dim iBeforeFirst As Long
    Dim iLanding As Long
    Dim iDistance As Single
    Dim iBestDistance As Single
    Dim iViewLeft As Long
    Dim iViewRight As Long
    
    nCandidate = -2
    nRow = -1
    If mDragTabRectsCount <> mTabs Then Exit Sub
    If (mTab < 0) Or (mTab > (mTabs - 1)) Then Exit Sub
    
    ' Where the tab would be if nothing held it back. The drawn one is clamped to the strip
    ' and to the stretch it may travel over, and a tab as wide as its row hardly moves at
    ' all, so the clamped position cannot point at everything the tab can be dropped on
    iVirtualLeft = mDragOriginLeft + mDragRawDX
    ' Aimed only inside the scroll window, so no slot out of sight takes the gap
    If mStripScrolls Then
        DragViewBounds iViewLeft, iViewRight
        If iVirtualLeft > iViewRight - (mDragTabRectAsTop(mTab).Right - mDragTabRectAsTop(mTab).Left) Then iVirtualLeft = iViewRight - (mDragTabRectAsTop(mTab).Right - mDragTabRectAsTop(mTab).Left)
        If iVirtualLeft < iViewLeft Then iVirtualLeft = iViewLeft
    End If
    iVirtualCenterY = mDragOriginTop + mDragRawDY + (mDragTabRectAsTop(mTab).Bottom - mDragTabRectAsTop(mTab).Top) / 2
    
    ' The row is the one the tab's centre falls on, and rows are told apart by RowPos and
    ' not by the band the centre is in, because the dragged tab is drawn taller than the
    ' rest and its band can reach into the row above it
    iAnchor = -1
    For t = 0 To mTabs - 1
        If mTabData(t).Visible Then
            If (mDragTabRectAsTop(t).Top <= iVirtualCenterY) And (mDragTabRectAsTop(t).Bottom >= iVirtualCenterY) Then
                iAnchor = t
                Exit For
            End If
        End If
    Next
    If iAnchor < 0 Then
        ' The centre can sit between two rows, or short of the far one, because a tab may
        ' be taller than the row it is being taken to (see DragUpdateFromMouse). When it
        ' does, it goes to the nearest row rather than to no row at all
        iBestDistance = -1
        For t = 0 To mTabs - 1
            If mTabData(t).Visible Then
                If iVirtualCenterY < mDragTabRectAsTop(t).Top Then
                    iDistance = mDragTabRectAsTop(t).Top - iVirtualCenterY
                Else
                    iDistance = iVirtualCenterY - mDragTabRectAsTop(t).Bottom
                End If
                If (iBestDistance < 0) Or (iDistance < iBestDistance) Then
                    iBestDistance = iDistance
                    iAnchor = t
                End If
            End If
        Next
    End If
    If iAnchor < 0 Then Exit Sub
    nRow = mTabData(iAnchor).RowPos
    
    ' The position before the row's first tab, and then one for every tab of the row. The
    ' tab before the row's first one is the previous *visible* one, not the one an index
    ' back: hidden tabs stay in the array (TDI Forms closes tabs that way)
    iAdvance = DragTabAdvance
    nCandidate = -2
    iBestDistance = -1
    iBeforeFirst = PreviousVisibleTab(FirstVisibleTabInRow(nRow))
    If DragCandidateIsInZone(iBeforeFirst) Then
        nCandidate = iBeforeFirst
        iBestDistance = Abs(DragGapLanding(iBeforeFirst, nRow, iAdvance) - iVirtualLeft)
    End If
    For t = 0 To mTabs - 1
        If mTabData(t).Visible Then
            If mTabData(t).RowPos = nRow Then
                If DragCandidateIsInZone(t) Then
                    iLanding = DragGapLanding(t, nRow, iAdvance)
                    iDistance = Abs(iLanding - iVirtualLeft)
                    If (iBestDistance < 0) Or (iDistance < iBestDistance) Then
                        iBestDistance = iDistance
                        nCandidate = t
                    End If
                End If
            End If
        End If
    Next
End Sub

Private Function DragIndexForCandidate(ByVal nCandidate As Long) As Long
    ' The index the dragged tab ends up at when the gap is opened after nCandidate.
    If nCandidate < 0 Then
        ' Before every visible tab.
        DragIndexForCandidate = FirstVisibleTab
        Exit Function
    End If
    If mTab > nCandidate Then
        DragIndexForCandidate = nCandidate + 1
    Else
        DragIndexForCandidate = nCandidate
    End If
End Function

Private Function DragCandidateIsInZone(ByVal nCandidate As Long) As Boolean
    ' Whether dropping the tab at that insertion point would keep it inside the zone the fixed tabs
    ' around it delimit (see DragSetZone).
    Dim iIndex As Long
    
    iIndex = DragIndexForCandidate(nCandidate)
    DragCandidateIsInZone = (iIndex >= mDragZoneFirst) And (iIndex <= mDragZoneLast)
End Function

Private Function DragGapBoundary(ByVal nCandidate As Long, ByVal nRow As Long) As Long
    ' The point of the row the gap is hinged on, on the snapshot: where the tab that
    ' follows nCandidate starts, and the far end of the row when nothing follows it
    Dim iNext As Long
    Dim iFirst As Long
    
    If nCandidate < 0 Then
        iFirst = -1
    ElseIf mTabData(nCandidate).RowPos <> nRow Then
        iFirst = -1 ' a tab of an earlier row: the insertion point is before the row's first tab
    Else
        iFirst = nCandidate
    End If
    If iFirst < 0 Then
        iFirst = FirstVisibleTabInRow(nRow)
        If iFirst < 0 Then Exit Function
        DragGapBoundary = mDragTabRectAsTop(iFirst).Left
        Exit Function
    End If
    iNext = NextVisibleTabInRow(nCandidate)
    If iNext > -1 Then
        DragGapBoundary = mDragTabRectAsTop(iNext).Left
    Else
        DragGapBoundary = mDragTabRectAsTop(nCandidate).Right
    End If
End Function

Private Function DragGapLeftShift(ByVal nCandidate As Long, ByVal nRow As Long, ByVal nAdvance As Long) As Long
    ' How much of the gap opens on the near side of the point it is hinged on.
    If mTabData(mTab).RowPos = nRow Then
        If nCandidate >= mTab Then DragGapLeftShift = nAdvance
    End If
End Function

Private Function DragGapSlide(ByVal nCandidate As Long, ByVal nRow As Long, ByVal nAdvance As Long) As Long
    ' How far back the whole row is drawn when the gap is opened at nCandidate.
    Dim t As Long
    Dim iRowLeft As Long
    Dim iRowRight As Long
    Dim iExcess As Long
    Dim iRowStart As Long
    Dim iBack As Long
    
    If mTabData(mTab).RowPos = nRow Then Exit Function ' its own row keeps its extent
    If mBodyWidth < 1 Then Exit Function
    iRowLeft = mDragTabRectAsTop(FirstVisibleTabInRow(nRow)).Left
    iRowRight = iRowLeft
    For t = 0 To mTabs - 1
        If mTabData(t).Visible Then
            If mTabData(t).RowPos = nRow Then
                If mDragTabRectAsTop(t).Right > iRowRight Then iRowRight = mDragTabRectAsTop(t).Right
            End If
        End If
    Next
    iExcess = iRowRight + nAdvance - mBodyWidth
    If iExcess < 1 Then Exit Function
    If iRowRight <= iRowLeft Then Exit Function
    ' A short row anchored at the far end (the last column of RightBottomHorizontal) has free room
    ' before it: that is taken first, whole, so nothing gets clipped at the end
    iRowStart = RowStartX()
    If mShowsRowsPerspective2 Then iRowStart = iRowStart + pScaleX(cRowPerspectiveSpace, vbTwips, vbPixels) * (mRows - nRow - 1)
    iBack = iRowLeft - iRowStart
    ' capped against where the row may end, not against the body: short of that the last tab moves
    If iBack > (iRowRight + nAdvance - (mBodyWidth - RowEndMargin())) Then iBack = iRowRight + nAdvance - (mBodyWidth - RowEndMargin())
    If iBack < 0 Then iBack = 0
    iExcess = iExcess - iBack
    If iExcess < 0 Then iExcess = 0
    DragGapSlide = iBack + CLng(iExcess * (DragGapBoundary(nCandidate, nRow) - iRowLeft) / (iRowRight - iRowLeft))
End Function

Private Function DragGapLanding(ByVal nCandidate As Long, ByVal nRow As Long, ByVal nAdvance As Long) As Long
    ' Where the dragged tab's left edge ends up, on screen, when the gap is opened at nCandidate.
    DragGapLanding = DragGapBoundary(nCandidate, nRow) - DragGapLeftShift(nCandidate, nRow, nAdvance) - DragGapSlide(nCandidate, nRow, nAdvance)
End Function

Private Function DragTabAdvance() As Long
    ' How much room the dragged tab takes along the strip, whatever spacing the style puts
    ' between two tabs included: it is how far back the tab that follows it would come if
    ' it were gone, which is exactly what a row has to close up or open up by
    Dim iNeighbor As Long
    
    DragTabAdvance = mDragTabRectAsTop(mTab).Right - mDragTabRectAsTop(mTab).Left
    iNeighbor = NextVisibleTabInRow(mTab)
    If iNeighbor > -1 Then
        DragTabAdvance = mDragTabRectAsTop(iNeighbor).Left - mDragTabRectAsTop(mTab).Left
    Else
        iNeighbor = PreviousVisibleTabInRow(mTab)
        If iNeighbor > -1 Then DragTabAdvance = mDragTabRectAsTop(mTab).Right - mDragTabRectAsTop(iNeighbor).Right
    End If
    If DragTabAdvance < 1 Then DragTabAdvance = mDragTabRectAsTop(mTab).Right - mDragTabRectAsTop(mTab).Left
End Function

Private Function FirstVisibleTabInRow(ByVal nRow As Long) As Long
    Dim t As Long
    
    FirstVisibleTabInRow = -1
    For t = 0 To mTabs - 1
        If mTabData(t).Visible Then
            If mTabData(t).RowPos = nRow Then
                FirstVisibleTabInRow = t
                Exit For
            End If
        End If
    Next
End Function

Private Function GetTabAtDropPoint() As Long
    Dim iCandidate As Long
    Dim iRow As Long
    
    DragResolveInsertion iCandidate, iRow
    If iCandidate = -2 Then
        ' No insertion point at all: either nothing could be laid out, or every position
        ' of the row the tab is being held over falls outside the zone it may be moved
        ' inside. The gap the user was shown is the same answer, which is none
        GetTabAtDropPoint = -1
    Else
        GetTabAtDropPoint = DragIndexForCandidate(iCandidate)
    End If
End Function

Private Sub UserControl_OLECompleteDrag(Effect As Long)
    RaiseEvent OLECompleteDrag(Effect)
End Sub

Private Sub UserControl_OLEDragDrop(Data As DataObject, Effect As Long, Button As Integer, Shift As Integer, X As Single, Y As Single)
    Dim t As Long
    Dim iX As Single
    Dim iY As Single
    
    ' VB6 event twips come from the rounded Screen.TwipsPerPixel: corrected as in the mouse handlers
    iX = X * mXCorrection
    iY = Y * mYCorrection
    
    UserControl.OLEDropMode = ssOLEDropManual
    tmrRestoreDropMode.Enabled = False
    
    If Not mOLEDropOnOtherTabs Then
        t = GetTabAtXY(iX, iY)
        If t = mTab Then
            RaiseEvent OLEDragDrop(Data, Effect, Button, Shift, X, Y)
        End If
    Else
        RaiseEvent OLEDragDrop(Data, Effect, Button, Shift, X, Y)
    End If
End Sub

Private Sub UserControl_OLEDragOver(Data As DataObject, Effect As Long, Button As Integer, Shift As Integer, X As Single, Y As Single, State As Integer)
    Dim t As Long
    Dim iX As Single
    Dim iY As Single
    
    ' See UserControl_OLEDragDrop
    iX = X * mXCorrection
    iY = Y * mYCorrection
    
    If Not mOLEDropOnOtherTabs Then
        t = GetTabAtXY(iX, iY)
        If t <> mTab Then
            UserControl.OLEDropMode = ssOLEDropNone
            tmrRestoreDropMode.Enabled = True
        Else
            UserControl.OLEDropMode = ssOLEDropManual
            RaiseEvent OLEDragOver(Data, Effect, Button, Shift, X, Y, State)
        End If
    End If
End Sub

Private Sub UserControl_OLEGiveFeedback(Effect As Long, DefaultCursors As Boolean)
    RaiseEvent OLEGiveFeedback(Effect, DefaultCursors)
End Sub

Private Sub UserControl_OLESetData(Data As DataObject, DataFormat As Integer)
    RaiseEvent OLESetData(Data, DataFormat)
End Sub

Private Sub UserControl_OLEStartDrag(Data As DataObject, AllowedEffects As Long)
    RaiseEvent OLEStartDrag(Data, AllowedEffects)
End Sub

Private Sub UserControl_ReadProperties(PropBag As PropertyBag)
    Dim c As Long
    Dim c2 As Long
    Dim iStr As String
    Dim iStr2 As String
    Dim iAllCtlNames As Collection
    Dim iLeftOffsetToHideWhenSaved As Long
    Dim iUpgradingFromSSTab As Boolean
    Dim iBytes() As Byte
    Dim iGlyphFont As StdFont
    Dim iTheme As NewTabTheme
    Dim iControlVersion As Long
    
    mReadingProperties = True ' see SetPropertyChanged: loading a form must not mark it as modified
    On Error Resume Next
    mUserControlHwnd = UserControl.hWnd
    mAmbientUserMode = Ambient.UserMode
    mDefaultTabHeight = pScaleY(cPropDef_TabHeight, vbTwips, vbHimetric)
    If mDefaultTabHeight = 0 Then
        mDefaultTabHeight = 419.8055
    End If
    If mAmbientUserMode Then
        If TypeOf UserControl.Parent Is Form Then
            If TypeOf UserControl.Parent Is MDIForm Then
                Set mMDIForm = UserControl.Parent
            Else
                Set mForm = UserControl.Parent
            End If
        End If
    End If
    On Error GoTo 0
    
    ' Read before anything else it could govern. It used to be read three hundred lines down, which
    ' was enough while the only migration it drove was a per-tab one, and stopped being enough the
    ' moment a property read at the top needed it
    iControlVersion = Val(PropBag.ReadProperty("ControlVersion", 0))
    
    ' Himetric from format 16 on; before that, twips. The conversion is exact and carries no DPI,
    ' so nothing is lost and no value can be misread
    ' TabsEndFreeSpace is its name in the forms saved before the rename
    mStripEndFreeSpace = PropBag.ReadProperty("StripEndFreeSpace", PropBag.ReadProperty("TabsEndFreeSpace", cPropDef_StripEndFreeSpace))
    If iControlVersion < 16 Then
        mStripEndFreeSpace = pScaleX(mStripEndFreeSpace, vbTwips, vbHimetric)
    End If
    mSubclassingMethod = PropBag.ReadProperty("SubclassingMethod", cPropDef_SubclassingMethod)
    iLeftOffsetToHideWhenSaved = PropBag.ReadProperty("LeftOffsetToHideWhenSaved", 75000)
    If iLeftOffsetToHideWhenSaved <> mLeftOffsetToHide Then
        mPendingLeftOffset = iLeftOffsetToHideWhenSaved - mLeftOffsetToHide
    End If
    mTabs = PropBag.ReadProperty("Tabs", cPropDef_Tabs)
    ' WriteProperties passes Ambient.BackColor as the default, so VB6 leaves the property out of the
    ' bag when the color was following the container.
    mBackColor = PropBag.ReadProperty("BackColor", -1)
    If mBackColor = -1 Then
        mBackColor = Ambient.BackColor
        mBackColorIsFromAmbient = True
    End If
    ' Resolved here and not further down because the reads below default to mForeColor
    mForeColor = PropBag.ReadProperty("ForeColor", -1)
    If mForeColor = -1 Then
        mForeColor = Ambient.ForeColor
        mForeColorIsFromAmbient = True
    End If
    ' Every inherited foreground colour is read the same way, with -1 as the default.
    mForeColorSelectedTab = PropBag.ReadProperty("ForeColorSelectedTab", -1)
    If mForeColorSelectedTab = -1 Then
        mForeColorSelectedTab = PropBag.ReadProperty("ForeColorTabSel", -1)
    End If
    mForeColorSelectedTab_IsAutomatic = (mForeColorSelectedTab = -1)
    mForeColorHighlighted = PropBag.ReadProperty("ForeColorHighlighted", -1)
    mForeColorHighlighted_IsAutomatic = (mForeColorHighlighted = -1)
    mFlatTabBorderColorHighlighted = PropBag.ReadProperty("FlatTabBorderColorHighlighted", -1)
    If mFlatTabBorderColorHighlighted = -1 Then
        mFlatTabBorderColorHighlighted = PropBag.ReadProperty("FlatTabBorderColorHighlight", -1)
    End If
    mFlatTabBorderColorHighlighted_IsAutomatic = (mFlatTabBorderColorHighlighted = -1)
    mFlatTabBorderColorSelectedTab = PropBag.ReadProperty("FlatTabBorderColorSelectedTab", -1)
    If mFlatTabBorderColorSelectedTab = -1 Then
        mFlatTabBorderColorSelectedTab = PropBag.ReadProperty("FlatTabBorderColorTabSel", -1)
    End If
    mFlatTabBorderColorSelectedTab_IsAutomatic = (mFlatTabBorderColorSelectedTab = -1)
    mFlatTabBorderColorInactive = PropBag.ReadProperty("FlatTabBorderColorInactive", -1)
    mFlatTabBorderColorInactive_IsAutomatic = (mFlatTabBorderColorInactive = -1)
    Set mFont = PropBag.ReadProperty("Font", Ambient.Font)
    mEnabled = PropBag.ReadProperty("Enabled", True)
    mTabsPerRow = PropBag.ReadProperty("TabsPerRow", cPropDef_TabsPerRow)
    If mTabsPerRow < 1 Then mTabsPerRow = cPropDef_TabsPerRow
    mTab = PropBag.ReadProperty("Tab", 0)
    mTabOrientation = PropBag.ReadProperty("TabOrientation", ssTabOrientationTop)
    ' Format 18 swapped the looks of LeftHorizontal and LeftBottomHorizontal (formerly LeftTopHorizontal)
    If iControlVersion < 18 Then
        If mTabOrientation = ntTabOrientationLeftHorizontal Then
            mTabOrientation = ntTabOrientationLeftBottomHorizontal
        ElseIf mTabOrientation = ntTabOrientationLeftBottomHorizontal Then
            mTabOrientation = ntTabOrientationLeftHorizontal
        End If
    End If
    mShowFocusRect = PropBag.ReadProperty("ShowFocusRect", cPropDef_ShowFocusRect)
    mWordWrap = PropBag.ReadProperty("WordWrap", cPropDef_WordWrap)
    mStyle = PropBag.ReadProperty("Style", cPropDef_Style)
    mTabHeight = PropBag.ReadProperty("TabHeight", mDefaultTabHeight)    ' in Himetric, for compatibility with the original SSTab
    If pScaleY(mTabHeight, vbHimetric, vbPixels) < 1 Then mTabHeight = pScaleY(1, vbPixels, vbHimetric)
    mTabMaxWidth = PropBag.ReadProperty("TabMaxWidth", cPropDef_TabMaxWidth)  ' in Himetric, for compatibility with the original SSTab
    mTabGeneralFixedWidth = PropBag.ReadProperty("TabGeneralFixedWidth", cPropDef_TabGeneralFixedWidth) ' in Himetric
    mTabMinWidth = PropBag.ReadProperty("TabMinWidth", cPropDef_TabMinWidth)  ' in Himetric
    mMousePointer = PropBag.ReadProperty("MousePointer", ssDefault)
    Set mMouseIcon = PropBag.ReadProperty("MouseIcon", Nothing)
    mOLEDropMode = PropBag.ReadProperty("OLEDropMode", ssOLEDropNone)
    mMaskColor = PropBag.ReadProperty("MaskColor", cPropDef_MaskColor)
    mUseMaskColor = PropBag.ReadProperty("UseMaskColor", cPropDef_UseMaskColor)
    mScalePicturesForDPI = PropBag.ReadProperty("ScalePicturesForDPI", cPropDef_ScalePicturesForDPI)
    mTDIFormsIconSize = PropBag.ReadProperty("TDIFormsIconSize", cPropDef_TDIFormsIconSize)
    mHighlightTabExtraHeight = PropBag.ReadProperty("HighlightTabExtraHeight", DefaultHighlightTabExtraHeightHimetric)
    If mHighlightTabExtraHeight < 0 Then mHighlightTabExtraHeight = 0
    ' No migration: the property is new, so a form that predates it has no key and gets the default.
    mHighlightTabCaptionShift = PropBag.ReadProperty("HighlightTabCaptionShift", DefaultHighlightTabCaptionShiftHimetric)
    mHighlightEffect = AnimationSpeedFromStoredValue(PropBag.ReadProperty("HighlightEffect", cPropDef_HighlightEffect))
    ' No migration here: the property is new, so a form that predates it has no key and
    ' gets the default, which is the behaviour it had
    mHighlightEffectOut = PropBag.ReadProperty("HighlightEffectOut", cPropDef_HighlightEffectOut)
    mShowRowsInPerspective = PropBag.ReadProperty("ShowRowsInPerspective", cPropDef_ShowRowsInPerspective)
    mNewTabButton = PropBag.ReadProperty("NewTabButton", cPropDef_NewTabButton)
    mCloseButton = PropBag.ReadProperty("CloseButton", False)
    mCloseButtonPosition = PropBag.ReadProperty("CloseButtonPosition", ntCBPositionOnTabs)
    ' The names are put back before the fonts reach their WithEvents variables, whose change events
    ' would mark the form as modified
    Set iGlyphFont = PropBag.ReadProperty("CloseButtonFont", Nothing)
    mCloseButtonUserFontName = PropBag.ReadProperty("CloseButtonFontName", "")
    RestoreGlyphFontName iGlyphFont, mCloseButtonUserFontName
    Set mCloseButtonUserFont = iGlyphFont
    mCloseButtonUserFontIsSet = Not (iGlyphFont Is Nothing)
    mCloseButtonUserChar = PropBag.ReadProperty("CloseButtonChar", 0)
    Set iGlyphFont = PropBag.ReadProperty("NewTabButtonFont", Nothing)
    mNewTabButtonUserFontName = PropBag.ReadProperty("NewTabButtonFontName", "")
    RestoreGlyphFontName iGlyphFont, mNewTabButtonUserFontName
    Set mNewTabButtonUserFont = iGlyphFont
    mNewTabButtonUserFontIsSet = Not (iGlyphFont Is Nothing)
    mNewTabButtonUserChar = PropBag.ReadProperty("NewTabButtonChar", 0)
    Set iGlyphFont = PropBag.ReadProperty("StripButtonsFont", Nothing)
    mStripButtonsUserFontName = PropBag.ReadProperty("StripButtonsFontName", "")
    RestoreGlyphFontName iGlyphFont, mStripButtonsUserFontName
    Set mStripButtonsUserFont = iGlyphFont
    mStripButtonsUserFontIsSet = Not (iGlyphFont Is Nothing)
    mStripButtonBackChar = PropBag.ReadProperty("StripButtonBackChar", 0)
    mStripButtonForwardChar = PropBag.ReadProperty("StripButtonForwardChar", 0)
    mStripButtonListChar = PropBag.ReadProperty("StripButtonListChar", 0)
    mNewTabButtonToolTipText = ReadTextProperty(PropBag, "NewTabButtonToolTipText", "")
    mStripButtonBackToolTipText = ReadTextProperty(PropBag, "StripButtonBackToolTipText", "")
    mStripButtonForwardToolTipText = ReadTextProperty(PropBag, "StripButtonForwardToolTipText", "")
    mStripButtonListToolTipText = ReadTextProperty(PropBag, "StripButtonListToolTipText", "")
    mTDIDefaultTabCaption = ReadTextProperty(PropBag, "TDIDefaultTabCaption", cPropDef_TDIDefaultTabCaption)
    mTDINewTabCaption = ReadTextProperty(PropBag, "TDINewTabCaption", cPropDef_TDINewTabCaption)
    mCloseButtonFontIsSetUp = False
    If mCloseButtonPosition > ntCBPositionOnSelectedAndHoveredTabs Then mCloseButtonPosition = ntCBPositionOnSelectedAndHoveredTabs
    mTabsOverflow = PropBag.ReadProperty("TabsOverflow", ntTOMultiRow)
    mNewTabButtonPosition = PropBag.ReadProperty("NewTabButtonPosition", ntNBAfterLastTab)
    mStripButtonsRow = PropBag.ReadProperty("StripButtonsRow", ntSBSelectedTabRow)
    mTabWidthStyle = PropBag.ReadProperty("TabWidthStyle", cPropDef_TabWidthStyle)
    mTabHeightStyleForHorizontal = PropBag.ReadProperty("TabHeightStyleForHorizontal", cPropDef_TabHeightStyleForHorizontal)
    mBackColorTabs = PropBag.ReadProperty("BackColorTabs", -1)
    If mBackColorTabs = -1 Then
        mBackColorTabs = Ambient.BackColor
        mBackColorTabsIsFromAmbient = True
    End If
    mBackColorSelectedTab = PropBag.ReadProperty("BackColorTabSel", -1)
    If mBackColorSelectedTab = -1 Then
        mBackColorSelectedTab = PropBag.ReadProperty("BackColorSelectedTab", -1)
    End If
    If mBackColorSelectedTab = -1 Then mBackColorSelectedTab_IsAutomatic = True
    If mBackColorSelectedTab_IsAutomatic Then mBackColorSelectedTab = GetAutomaticBackColorSelectedTab
    mFlatBarColorHighlighted = PropBag.ReadProperty("FlatBarColorHighlighted", -1)
    If mFlatBarColorHighlighted = -1 Then
        mFlatBarColorHighlighted = PropBag.ReadProperty("FlatBarColorHighlight", -1)
    End If
    If mFlatBarColorHighlighted = -1 Then mFlatBarColorHighlighted_IsAutomatic = True: mFlatBarColorHighlighted = 0
    mFlatBarColorInactive = PropBag.ReadProperty("FlatBarColorInactive", -1)
    If mFlatBarColorInactive = -1 Then mFlatBarColorInactive_IsAutomatic = True: mFlatBarColorInactive = 0
    mFlatTabsSeparationLineColor = PropBag.ReadProperty("FlatTabsSeparationLineColor", -1)
    If mFlatTabsSeparationLineColor = -1 Then mFlatTabsSeparationLineColor_IsAutomatic = True: mFlatTabsSeparationLineColor = 0
    mFlatBodySeparationLineColor = PropBag.ReadProperty("FlatBodySeparationLineColor", -1)
    If mFlatBodySeparationLineColor = -1 Then mFlatBodySeparationLineColor_IsAutomatic = True: mFlatBodySeparationLineColor = 0
    mFlatBorderColor = PropBag.ReadProperty("FlatBorderColor", -1)
    If mFlatBorderColor = -1 Then mFlatBorderColor_IsAutomatic = True: mFlatBorderColor = 0
    mHighlightColor = PropBag.ReadProperty("HighlightColor", -1)
    If mHighlightColor = -1 Then mHighlightColor_IsAutomatic = True: mHighlightColor = 0
    mHighlightColorSelectedTab = PropBag.ReadProperty("HighlightColorTabSel", -1)
    If mHighlightColorSelectedTab = -1 Then
        mHighlightColorSelectedTab = PropBag.ReadProperty("HighlightColorSelectedTab", -1)
    End If
    If mHighlightColorSelectedTab = -1 Then mHighlightColorSelectedTab_IsAutomatic = True: mHighlightColorSelectedTab = 0
    mHighlightGradientColor = PropBag.ReadProperty("HighlightGradientColor", -1)
    If mHighlightGradientColor = -1 Then mHighlightGradientColor_IsAutomatic = True: mHighlightGradientColor = 0
    mHighlightGradientColorSelectedTab = PropBag.ReadProperty("HighlightGradientColorSelectedTab", -1)
    If mHighlightGradientColorSelectedTab = -1 Then mHighlightGradientColorSelectedTab_IsAutomatic = True: mHighlightGradientColorSelectedTab = 0
    mSoftEdges = PropBag.ReadProperty("SoftEdges", cPropDef_SoftEdges)
    mControlsBackColor_Applied = -1
    ' Read unconditionally.
    mChangeControlsBackColor = PropBag.ReadProperty("ChangeControlsBackColor", cPropDef_ChangeControlsBackColor)
    ' Only mChangeControlsBackColor: see the matching condition in WriteProperties for why
    ' mBackColorSelectedTab_IsAutomatic has no business here
    If mChangeControlsBackColor Then
        mControlsBackColor_Applied = PropBag.ReadProperty("ControlsBackColorApplied", -1)
    End If
    mChangeControlsForeColor = PropBag.ReadProperty("ChangeControlsForeColor", cPropDef_ChangeControlsForeColor)
    mTabTransition = PropBag.ReadProperty("TabTransition", cPropDef_TabTransition)
    mHighlightMode = PropBag.ReadProperty("HighlightMode", cPropDef_HighlightMode)
    mHighlightModeSelectedTab = PropBag.ReadProperty("HighlightModeSelectedTab", -1)
    If mHighlightModeSelectedTab = -1 Then
        mHighlightModeSelectedTab = PropBag.ReadProperty("HighlightModeTabSel", cPropDef_HighlightModeSelectedTab)
    End If
    mCaptionAlignment = PropBag.ReadProperty("CaptionAlignment", cPropDef_CaptionAlignment)
    If mCaptionAlignment = ntAlignmentLeft Then
        mAlignmentDTFlag = DT_LEFT
    ElseIf mCaptionAlignment = ntAlignmentRight Then
        mAlignmentDTFlag = DT_RIGHT
    Else
        mAlignmentDTFlag = DT_CENTER
    End If
    If PropBag.ReadProperty("_Version", 0) <> 0 Then
        ' upgrading from SSTab
        If (mStyle <> ssStyleTabbedDialog) And (mStyle <> ssStylePropertyPage) Then
            mStyle = ssStyleTabbedDialog
        End If
        mBackColorTabs = vbButtonFace
        mBackColorTabsIsFromAmbient = False
        mBackColorSelectedTab = vbButtonFace
        ' ForeColor is deliberately NOT forced here.
        mForeColorSelectedTab_IsAutomatic = True
        mForeColorHighlighted_IsAutomatic = True
        mFlatTabBorderColorHighlighted_IsAutomatic = True
        mFlatTabBorderColorSelectedTab_IsAutomatic = True
        mFlatTabBorderColorInactive_IsAutomatic = True
        mSoftEdges = False
        ' Re-read and not forced: SSTab has a ShowFocusRect of its own, defaulting to True, while
        ' cPropDef_ShowFocusRect is False, so the read a few hundred lines above answered with the
        ' wrong default for a converted form.
        mShowFocusRect = PropBag.ReadProperty("ShowFocusRect", True)
        mChangeControlsBackColor = False
        mChangeControlsForeColor = False
        mTabTransition = ntAnimationNone
        mHighlightEffect = ntAnimationNone
        mHighlightEffectOut = ntAnimationNone
        mHighlightMode = ntHLNone
        ' Auto and not ntHLCaptionBold.
        mHighlightModeSelectedTab = ntHLAuto
        iUpgradingFromSSTab = True
    End If
    ' There is no second branch here and there must not be one. SSTabEx is the earlier name of this
    ' very control, and a branch that upgraded from it used to sit at this exact spot.
    mVisualStyles = (mStyle = ntStyleWindows)
    RefreshSystemVisualStylesAvailable
    mShowDisabledState = PropBag.ReadProperty("ShowDisabledState", cPropDef_ShowDisabledState)
    mTabSeparation = PropBag.ReadProperty("TabSeparation", cPropDef_TabSeparation)
    mTabAppearance = PropBag.ReadProperty("TabAppearance", cPropDef_TabAppearance)
    ' VisualStyles is not persisted - there is no WriteProperty for it - so it is rebuilt from the
    ' properties that are, and TabAppearance is only known at this point.
    mVisualStyles = (mTabAppearance = ntTAWindows) Or ((mTabAppearance = ntTAAuto) And (mStyle = ntStyleWindows))
    ' Format 18 folded the property page appearance's own two pixel recess into the general
    ' mechanism - the ntHLExtraHeight flag plus HighlightTabExtraHeight - so that any style can have
    ' it and a theme can carry it.
    If iControlVersion < 18 Then
        If mHighlightModeSelectedTab <> ntHLAuto Then
            If StyleUsesPropertyPageTabs Then
                If (mHighlightModeSelectedTab And ntHLExtraHeight) <> ntHLExtraHeight Then
                    mHighlightTabExtraHeight = 0
                    mHighlightModeSelectedTab = mHighlightModeSelectedTab Or ntHLExtraHeight
                End If
                mHighlightTabExtraHeight = mHighlightTabExtraHeight + DefaultHighlightTabExtraHeightHimetric
                ' The widening came from the appearance too before it became ntHLWidenTab, so it is
                ' handed over the same way.
                mHighlightModeSelectedTab = mHighlightModeSelectedTab Or ntHLWidenTab
            End If
        End If
    End If
    ' Read here and not two hundred lines further down, where it used to be: IconAlignment right
    ' below needs it, and a property that governs the reading of another has to be read first
    mTDIMode = PropBag.ReadProperty("TDIMode", cPropDef_TDIMode)
    If mTDIMode = -1 Then mTDIMode = ntTDIModeControls
    mIconAlignment = PropBag.ReadProperty("IconAlignment", IIf(iUpgradingFromSSTab, ntIconAlignBeforeCaption, cPropDef_IconAlignment))
    ' What a TDI form saved before format 17 holds here is not the developer's choice: it is
    ' whatever TDISetTDIMode wrote on its behalf, every load, for as long as that forcing existed.
    If mTDIMode <> ntTDIModeNone Then
        If iControlVersion < 17 Then
            mIconAlignment = cPropDef_IconAlignment
        End If
    End If
    mAutoRelocateControls = PropBag.ReadProperty("AutoRelocateControls", cPropDef_AutoRelocateControls)
    mRightToLeft = PropBag.ReadProperty("RightToLeft", Ambient.RightToLeft)
    If mRightToLeft Then
        SetLayout GetDC(picDraw.hWnd), LAYOUT_RTL
        SetLayout GetDC(picAux.hWnd), LAYOUT_RTL
    End If
    SetScaleMode
    mHandleHighContrastTheme = PropBag.ReadProperty("HandleHighContrastTheme", cPropDef_HandleHighContrastThem)
    mBackStyle = PropBag.ReadProperty("BackStyle", cPropDef_BackStyle)
    ' Up to format 18 the stored default was False, and a False was not written; SSTab has no such property
    mAutoTabHeight = PropBag.ReadProperty("AutoTabHeight", IIf(iControlVersion < 19, False, cPropDef_AutoTabHeight))
    mOLEDropOnOtherTabs = PropBag.ReadProperty("OLEDropOnOtherTabs", cPropDef_OLEDropOnOtherTabs)
    mFlatBarColorSelectedTab = PropBag.ReadProperty("FlatBarColorSelectedTab", -1)
    If mFlatBarColorSelectedTab = -1 Then
        mFlatBarColorSelectedTab = PropBag.ReadProperty("FlatBarColorTabSel", cPropDef_FlatBarColorSelectedTab)
    End If
    mFlatRoundnessTop = PropBag.ReadProperty("FlatRoundnessTop", cPropDef_FlatRoundnessTop)
    mFlatRoundnessBottom = PropBag.ReadProperty("FlatRoundnessBottom", cPropDef_FlatRoundnessBottom)
    mFlatRoundnessTabs = PropBag.ReadProperty("FlatRoundnessTabs", cPropDef_FlatRoundnessTabs)
    mTabMousePointerHand = PropBag.ReadProperty("TabMousePointerHand", cPropDef_TabMousePointerHand)
    ' Same -1 as the caption family above, and the order among these no longer matters: none
    ' of them is the default of another one any more. The two hover slots of the 'x' are the
    ' exception and keep their constant, because the red is where they fall back to
    mIconColor = PropBag.ReadProperty("IconColor", -1)
    mIconColor_IsAutomatic = (mIconColor = -1)
    mIconColorSelectedTab = PropBag.ReadProperty("IconColorSelectedTab", -1)
    If mIconColorSelectedTab = -1 Then
        mIconColorSelectedTab = PropBag.ReadProperty("IconColorTabSel", -1)
    End If
    mIconColorSelectedTab_IsAutomatic = (mIconColorSelectedTab = -1)
    mIconColorTabHighlighted = PropBag.ReadProperty("IconColorTabHighlighted", -1)
    mIconColorTabHighlighted_IsAutomatic = (mIconColorTabHighlighted = -1)
    mIconColorMouseHover = PropBag.ReadProperty("IconColorMouseHover", -1)
    mIconColorMouseHover_IsAutomatic = (mIconColorMouseHover = -1)
    mIconColorMouseHoverSelectedTab = PropBag.ReadProperty("IconColorMouseHoverSelectedTab", -1)
    If mIconColorMouseHoverSelectedTab = -1 Then
        mIconColorMouseHoverSelectedTab = PropBag.ReadProperty("IconColorMouseHoverTabSel", -1)
    End If
    mIconColorMouseHoverSelectedTab_IsAutomatic = (mIconColorMouseHoverSelectedTab = -1)
    mCloseButtonColor = PropBag.ReadProperty("CloseButtonColor", -1)
    mCloseButtonColor_IsAutomatic = (mCloseButtonColor = -1)
    mCloseButtonColorSelectedTab = PropBag.ReadProperty("CloseButtonColorSelectedTab", -1)
    mCloseButtonColorSelectedTab_IsAutomatic = (mCloseButtonColorSelectedTab = -1)
    mCloseButtonColorMouseHover = PropBag.ReadProperty("CloseButtonColorMouseHover", cPropDef_CloseButtonColorMouseHover)
    mCloseButtonColorMouseHoverSelectedTab = PropBag.ReadProperty("CloseButtonColorMouseHoverSelectedTab", cPropDef_CloseButtonColorMouseHover)
    mCloseButtonColorTabHighlighted = PropBag.ReadProperty("CloseButtonColorTabHighlighted", -1)
    mCloseButtonColorTabHighlighted_IsAutomatic = (mCloseButtonColorTabHighlighted = -1)
    mStripButtonsColor = PropBag.ReadProperty("StripButtonsColor", -1)
    mStripButtonsColor_IsAutomatic = (mStripButtonsColor = -1)
    mStripButtonsColorHighlighted = PropBag.ReadProperty("StripButtonsColorHighlighted", -1)
    mStripButtonsColorHighlighted_IsAutomatic = (mStripButtonsColorHighlighted = -1)
    mNewTabButtonColor = PropBag.ReadProperty("NewTabButtonColor", -1)
    mNewTabButtonColor_IsAutomatic = (mNewTabButtonColor = -1)
    mNewTabButtonColorHighlighted = PropBag.ReadProperty("NewTabButtonColorHighlighted", -1)
    mNewTabButtonColorHighlighted_IsAutomatic = (mNewTabButtonColorHighlighted = -1)
    ' Silent: this is the load path, it has its own Draw at the end and the '+' does not exist
    ' yet. Placed below the last of the chain reads because the tree is resolved in one go
    ApplyChainColors nSilent:=True
    mFlatBorderMode = PropBag.ReadProperty("FlatBorderMode", cPropDef_FlatBorderMode)
    mFlatBarHeight = PropBag.ReadProperty("FlatBarHeight", cPropDef_FlatBarHeight)
    mFlatBarGripHeight = PropBag.ReadProperty("FlatBarGripHeight", cPropDef_FlatBarGripHeight)
    mFlatTabBodyGap = PropBag.ReadProperty("FlatTabBodyGap", cPropDef_FlatTabBodyGap)
    mFlatBarPosition = PropBag.ReadProperty("FlatBarPosition", cPropDef_FlatBarPosition)
    mCanReorderTabs = PropBag.ReadProperty("CanReorderTabs", cPropDef_CanReorderTabs)
    mFlatBodySeparationLineHeight = PropBag.ReadProperty("FlatBodySeparationLineHeight", cPropDef_FlatBodySeparationLineHeight)
    mTabPaddingWidth = PropBag.ReadProperty("TabPaddingWidth", cPropDef_TabPaddingWidth)
    mCloseButtonPadding = PropBag.ReadProperty("CloseButtonPadding", cPropDef_CloseButtonPadding)
    mTabPaddingHeight = PropBag.ReadProperty("TabPaddingHeight", cPropDef_TabPaddingHeight)
    SetDPIScaledValues
    mUserControlSizeCorrectionsCounter_ScaleWidthNotToResize = PropBag.ReadProperty("UserControlSizeCorrectionsCounter_ScaleWidthNotToResize", 0)
    mUserControlSizeCorrectionsCounter_ScaleHeightNotToResize = PropBag.ReadProperty("UserControlSizeCorrectionsCounter_ScaleHeightNotToResize", 0)
    
    Set UserControl.MouseIcon = mMouseIcon
    UserControl.MousePointer = mMousePointer
    
    If mFont Is Nothing Then
        Set mFont = Ambient.Font
    End If
    If mFont Is Nothing Then
        Set mFont = UserControl.Font
    End If
    Set mDefaultIconFont = New StdFont
    mDefaultIconFont.Name = cPropDef_IconFontName
    mDefaultIconFont.Size = cPropDef_IconFontSize
    
    UserControl.Enabled = mEnabled Or (Not mAmbientUserMode)
    
    If mTabs = 0 Then
        ReDim mTabData(-1 To -1)
        mTab = -1
    Else
        ReDim mTabData(-1 To mTabs - 1)
        For c = 0 To mTabs - 1
            mTabData(c).OriginalIndex = c
        Next
    End If
    Set iAllCtlNames = New Collection
    mNoTabVisible = True
    For c = 0 To mTabs - 1
        Set mTabData(c).Controls = New Collection
        Set mTabData(c).Picture = PropBag.ReadProperty("TabPicture(" & CStr(c) & ")", Nothing)
        If Not mTabData(c).Picture Is Nothing Then
            If mTabData(c).Picture.Handle = 0 Then Set mTabData(c).Picture = Nothing
        End If
        Set mTabData(c).Pic16 = PropBag.ReadProperty("TabPic16(" & CStr(c) & ")", Nothing)
        If Not mTabData(c).Pic16 Is Nothing Then
            If mTabData(c).Pic16.Handle = 0 Then Set mTabData(c).Pic16 = Nothing
        End If
        Set mTabData(c).Pic20 = PropBag.ReadProperty("TabPic20(" & CStr(c) & ")", Nothing)
        If Not mTabData(c).Pic20 Is Nothing Then
            If mTabData(c).Pic20.Handle = 0 Then Set mTabData(c).Pic20 = Nothing
        End If
        Set mTabData(c).Pic24 = PropBag.ReadProperty("TabPic24(" & CStr(c) & ")", Nothing)
        If Not mTabData(c).Pic24 Is Nothing Then
            If mTabData(c).Pic24.Handle = 0 Then Set mTabData(c).Pic24 = Nothing
        End If
        mTabData(c).IconChar = PropBag.ReadProperty("TabIconChar(" & CStr(c) & ")", 0)
        mTabData(c).IconLeftOffset = PropBag.ReadProperty("TabIconLeftOffset(" & CStr(c) & ")", 0)
        mTabData(c).IconTopOffset = PropBag.ReadProperty("TabIconTopOffset(" & CStr(c) & ")", 0)
        mTabData(c).IconInColor = PropBag.ReadProperty("TabIconInColor(" & CStr(c) & ")", False)
        If iControlVersion < 9 Then
            mTabData(c).Caption = ReadTextProperty(PropBag, "TabCaption(" & CStr(c) & ")", "")
        Else
            mTabData(c).Caption = ReadTextProperty(PropBag, "TabCaption(" & CStr(c) & ")", "Tab " & CStr(c))
        End If
        mTabData(c).ToolTipText = ReadTextProperty(PropBag, "TabToolTipText(" & CStr(c) & ")", "")
        For c2 = 0 To PropBag.ReadProperty("Tab(" & c & ").ControlCount", 0) - 1
            iStr = PropBag.ReadProperty("Tab(" & c & ").Control(" & c2 & ")", "")
            If iStr <> "" Then
                iStr2 = ""
                On Error Resume Next
                iStr2 = iAllCtlNames(iStr)
                On Error GoTo 0
                If iStr2 = "" Then
                    mTabData(c).Controls.Add iStr, iStr
                    iAllCtlNames.Add iStr, iStr
                End If
            End If
        Next
        mTabData(c).Enabled = PropBag.ReadProperty("TabEnabled(" & CStr(c) & ")", True)
        mTabData(c).CloseButton = PropBag.ReadProperty("TabCloseButton(" & CStr(c) & ")", ntYNAuto)
        mTabData(c).CloseButtonEnabled = PropBag.ReadProperty("TabCloseButtonEnabled(" & CStr(c) & ")", True)
        mTabData(c).Movable = PropBag.ReadProperty("TabMovable(" & CStr(c) & ")", True)
        mTabData(c).Visible = PropBag.ReadProperty("TabVisible(" & CStr(c) & ")", True)
        If mTabData(c).Visible Then mNoTabVisible = False
        Set mTabData(c).IconFont = PropBag.ReadProperty("IconFont(" & CStr(c) & ")", Nothing)
        mTabData(c).IconFontName = PropBag.ReadProperty("IconFontName(" & CStr(c) & ")", "")
        If mTabData(c).IconFontName <> "" Then
            If mTabData(c).IconFontName <> mTabData(c).IconFont.Name Then
                mTabData(c).DoNotUseIconFont = True
            End If
        End If
        If Not mTabData(c).IconFont Is Nothing Then mTabIconFontsEventsHandler.AddFont mTabData(c).IconFont, c
        ' Himetric from format 16 on; before that, raw pixels of whatever machine saved the form.
        mTabData(c).FixedWidth = PropBag.ReadProperty("TabFixedWidth(" & CStr(c) & ")", 0)
        If iControlVersion < 16 Then
            mTabData(c).FixedWidth = pScaleX(mTabData(c).FixedWidth, vbPixels, vbHimetric)
        End If
        mTabData(c).Tag = ReadTextProperty(PropBag, "TabTag(" & CStr(c) & ")", "")
        mTabData(c).Data = PropBag.ReadProperty("TabData(" & CStr(c) & ")", 0)
        mTabData(c).CustomColors.Deserialize PropBag.ReadProperty("TabCustomColors(" & CStr(c) & ")", "")
        mTabData(c).Key = ReadTextProperty(PropBag, "TabKey(" & CStr(c) & ")", "")
    Next c
    ' ApplyChainColors ran up there before mTabData was redimensioned and before these slots
    ' were read, so the pass it fires saw neither. This is the one that counts
    ApplyTabChainColors
    mTabData(mTab).Selected = True
    
    c2 = 1
    iBytes = PropBag.ReadProperty("Theme(" & CStr(c2) & ")", "")
    Do Until UBound(iBytes) = -1
        If mThemesCollection Is Nothing Then Set mThemesCollection = New NewTabThemes
        Set iTheme = New NewTabTheme
        iTheme.Deserialize iBytes
        mThemesCollection.Add iTheme
        c2 = c2 + 1
        iBytes = PropBag.ReadProperty("Theme(" & CStr(c2) & ")", "")
    Loop
    
    If mHandleHighContrastTheme Then CheckHighContrastTheme
    SetFont
    If mTabAppearance <> ntTAAuto Then
        mAppearanceIsFlat = (mTabAppearance = ntTAFlat)
    Else
        mAppearanceIsFlat = mStyle = ntStyleFlat
    End If
    SetHighlightMode
    mSetAutoTabHeightPending = True
    SetButtonFaceColor
    SetColors
    UserControl.BackColor = mBackColor
    CheckIfThereAreTabsToolTipTexts
    UserControl.OLEDropMode = mOLEDropMode
    
    mControlJustAdded = PropBag.ReadProperty("ControlJustAdded", True)
    
    mSubclassed = mSubclassingMethod <> ntSMDisabled
#If NOSUBCLASSINIDE Then
    If mInIDE Then
        mSubclassed = False
    End If
#End If
    
    If mSubclassed Then
        gSubclassWithSetWindowLong = (mSubclassingMethod = ntSMSetWindowLong) Or (mSubclassingMethod = ntSM_SWLOnlyUserControl)
        mOnlySubclassUserControl = (mSubclassingMethod = ntSM_SWSOnlyUserControl) Or (mSubclassingMethod = ntSM_SWLOnlyUserControl)
        SubclassUserControl
    Else
        mFormIsActive = True
    End If
    ' the button is not persisted, so it is built again here on every load. At run time in
    ' TDI Controls mode TDISetTDIMode rebuilds the whole strip later anyway, but at design
    ' time nothing else runs, and this is what puts the "+" in front of the developer
    NewTabButtonApply
    mPropertiesReady = True
    If mTDIMode = ntTDIModeForms Then ReDim mTDIFormWithoutCloseButton(0)
    
    PostDrawMessage
    If tmrDraw.Enabled Then
        Draw
    End If
    mReadingProperties = False ' cleared here and not at the end of the routine: the TDI Forms block below has an Exit Sub
    
    If mAmbientUserMode Then
        mHandIconHandle = LoadCursor(ByVal 0&, IDC_HAND)
    End If
    
    If mAmbientUserMode And (mTDIMode = ntTDIModeForms) Then
        If mSettingTDIMode Then Exit Sub
        If Not mTDIModeAlreadySet Then
            mTDIModeAlreadySet = True
            TDISetTDIMode
        End If
    End If
End Sub

Private Sub UserControl_Resize()
    ResetCachedThemeImages
    If mAmbientUserMode Then
        PostDrawMessage
    Else
        tmrDraw.Enabled = True
    End If
    If mResizeEventPending Then RaiseEvent_Resize
End Sub

Private Sub UserControl_Show()
    If mUserControlTerminated Then Exit Sub
    If mResizeEventPending Then RaiseEvent_Resize
    If mAmbientUserMode And (mTDIMode <> ntTDIModeNone) Then
        If mSettingTDIMode Then Exit Sub
        If IsWindowVisible(mUserControlHwnd) <> 0 Then
            If Not mTDIModeAlreadySet Then
                mTDIModeAlreadySet = True
                TDISetTDIMode
            End If
        End If
    End If
    
    If mUserControlShown Then
        Exit Sub
    End If
    
    If mTDIModeFormsUnhooked Then
        If mTDIMode = ntTDIModeForms Then
            If mAmbientUserMode Then
                InstallCBTHook Me
            End If
        End If
        mTDIModeFormsUnhooked = False
    End If
    
    If mPendingLeftOffset <> 0 Then
        DoPendingLeftOffset
    End If
    
    If mAmbientUserMode And mSubclassed Then
        If (mFormHwnd = 0) Then
            mFormHwnd = GetAncestor(UserControl.ContainerHwnd, GA_ROOT)
            mFormIsActive = GetForegroundWindow = mFormHwnd
            SubclassForm
        End If
        
        Dim iAuxLeft As Long
        Dim iHwnd As LongPtr
        Dim c As Long
        Dim iCtlName As String
        Dim iCtl As Object
        Dim iIsLine As Boolean
        
        On Error Resume Next
        If mSubclassedControlsForMoveHwnds.Count > 0 Then
            For c = 1 To mSubclassedControlsForMoveHwnds.Count
                iHwnd = mSubclassedControlsForMoveHwnds(c)
                DetachMessage Me, iHwnd, WM_WINDOWPOSCHANGING
            Next c
            Set mSubclassedControlsForMoveHwnds = New Collection
        End If
    
        For Each iCtl In UserControlContainedControls
            iAuxLeft = 0
            iIsLine = False
            If TypeName(iCtl) = "Line" Then
                iAuxLeft = iCtl.X1
                iIsLine = True
            Else
                iAuxLeft = iCtl.Left
            End If
            If iAuxLeft >= -mLeftThresholdHidden Then
                iCtlName = ControlName(iCtl)
                If Not ControlIsInTab(iCtlName, mTab) Then
                    If iIsLine Then
                        iCtl.X1 = iCtl.X1 - mLeftOffsetToHide
                        iCtl.X2 = iCtl.X2 - mLeftOffsetToHide
                    Else
                        iCtl.Left = iCtl.Left - mLeftOffsetToHide
                    End If
                    iAuxLeft = iAuxLeft - mLeftOffsetToHide
                End If
            End If
            If Not mOnlySubclassUserControl Then
                If iAuxLeft < -mLeftThresholdHidden Then
                    iHwnd = 0
                    iHwnd = GetControlHwnd(iCtl)
                    If iHwnd <> 0 Then
                        mSubclassedControlsForMoveHwnds.Add iHwnd
                        AttachMessage Me, iHwnd, WM_WINDOWPOSCHANGING
                    End If
                End If
            End If
        Next
        On Error GoTo 0
    End If
    
    If mChangeControlsBackColor Then
        If Not mChangedControlsBackColor Then
            SetControlsProperBackColor
            mChangedControlsBackColor = True
        End If
    End If
    If mChangeControlsForeColor Then
        If Not mChangedControlsForeColor Then
            SetControlsProperForeColor
            mChangedControlsForeColor = True
        End If
    End If
    
    If mAmbientUserMode Then
        If Not mTabStopsInitialized Then
            StoreControlsTabStop True
            mTabStopsInitialized = True
        End If
        If mForm Is Nothing And mMDIForm Is Nothing Then SubclassControlsPainting
    Else
        HideAllContainedControls
        MakeContainedControlsInSelTabVisible
        If Not IsMsgBoxShown Then CheckContainedControlsConsistency
    End If
    mUserControlShown = True
    SubclassControlsPainting
    If (Not mFirstDraw) Or mDrawMessagePosted Then
        Draw
        mFirstDraw = True
    End If
    If Not mFromFromLoad Then RaiseEvent TabChange
End Sub

Private Sub DoPendingLeftOffset()
    Dim iCtl As Object
    Dim iIsLine As Boolean
    Dim iAuxLeft As Long
    
    If mPendingLeftOffset <> 0 Then
        For Each iCtl In UserControlContainedControls
            iAuxLeft = 0
            iIsLine = False
            On Error Resume Next
            If TypeName(iCtl) = "Line" Then
                iAuxLeft = iCtl.X1
                iIsLine = True
            Else
                iAuxLeft = iCtl.Left
            End If
            On Error GoTo 0
            If iAuxLeft < -mLeftThresholdHidden Then
                If iIsLine Then
                    iCtl.X1 = iCtl.X1 + mPendingLeftOffset
                    iCtl.X2 = iCtl.X2 + mPendingLeftOffset
                Else
                    iCtl.Left = iCtl.Left + mPendingLeftOffset
                End If
            End If
        Next
        mPendingLeftOffset = 0
    End If

End Sub

Private Function ControlIsInTab(nCtlName As String, ByVal nTab As Variant) As Boolean
    Dim c As Long
    Dim iIndex As Long
    
    iIndex = GetTabIndex(nTab)
    For c = 1 To mTabData(iIndex).Controls.Count
        If mTabData(iIndex).Controls(c) = nCtlName Then
            ControlIsInTab = True
            Exit Function
        End If
    Next c
End Function

' the same as ControlIsInTab but it expects nCtlName LCase
Private Function ControlIsInTab2(nCtlName As String, ByVal nTab As Long) As Boolean
    Dim c As Long
    
    For c = 1 To mTabData(nTab).Controls.Count
        If LCase$(mTabData(nTab).Controls(c)) = nCtlName Then
            ControlIsInTab2 = True
            Exit Function
        End If
    Next c
End Function
    
Private Sub UserControl_Terminate()
    DoTerminate
End Sub

Private Sub DoTerminate()
    
    If mUserControlTerminated Then Exit Sub
    mUserControlTerminated = True
    ColorGlyphsRemoveUser
    
    If mTDIMode = ntTDIModeForms Then
        If mAmbientUserMode Then
            UninstallCBTHook
            mTDIModeFormsUnhooked = False
        End If
    End If
    
    tmrShowTabTTT.Enabled = False
    Set mToolTipEx = Nothing
    
    tmrTabMouseLeave.Enabled = False
    tmrDraw.Enabled = False
    tmrCancelDoubleClick.Enabled = False
    tmrCheckContainedControlsAdditionDesignTime.Enabled = False
    tmrHighlightEffect.Enabled = False
    tmrDragAnim.Enabled = False
    
    Set mParentControlsTabStop = Nothing
    Set mParentControlsUseMnemonic = Nothing
    Set mContainedControlsThatAreContainers = Nothing
    Set mForm = Nothing
    Set mMDIForm = Nothing
    
    Unsubclass
    
    If Not mTabIconFontsEventsHandler Is Nothing Then
        mTabIconFontsEventsHandler.Release
        Set mTabIconFontsEventsHandler = Nothing
    End If
    If mHandIconHandle <> 0 Then
        DestroyCursor mHandIconHandle
        mHandIconHandle = 0
    End If
#If ROTATECACHE = 1 Then ' TEMP diagnostic
    RotCacheRelease
#End If
    AARelease
    DragStripCacheRelease
    HoverCacheRelease
    If mClientRegion <> 0 Then
        DeleteObject mClientRegion
        mClientRegion = 0
    End If
End Sub

Private Sub Unsubclass()
    Dim c As Long
    Dim iHwnd As LongPtr
    
    If mSubclassed Then
        If (mFormHwnd <> 0) And mAmbientUserMode Then
            On Error Resume Next
            DetachMessage Me, mFormHwnd, WM_SYSCOLORCHANGE
            DetachMessage Me, mFormHwnd, WM_THEMECHANGED
            DetachMessage Me, mFormHwnd, WM_NCACTIVATE
            DetachMessage Me, mFormHwnd, WM_GETDPISCALEDSIZE
            If mTDIMode = ntTDIModeForms Then
                DetachMessage Me, mFormHwnd, WM_ACTIVATE
                DetachMessage Me, mFormHwnd, WM_ACTIVATEAPP
            End If
            On Error GoTo 0
        End If
        If mSubclassed Then
            If mAmbientUserMode Then
                On Error Resume Next
                DetachMessage Me, mUserControlHwnd, WM_MOUSEACTIVATE
                DetachMessage Me, mUserControlHwnd, WM_SETFOCUS
                DetachMessage Me, mUserControlHwnd, WM_DRAW
                DetachMessage Me, mUserControlHwnd, WM_INIT
                DetachMessage Me, mUserControlHwnd, WM_THEMEREPAINT
                DetachMessage Me, mUserControlHwnd, WM_SETCURSOR
                DetachMessage Me, mUserControlHwnd, WM_KEYDOWN
                DetachMessage Me, mUserControlHwnd, WM_CHAR
                DetachMessage Me, mUserControlHwnd, WM_KEYUP
                DetachMessage Me, mUserControlHwnd, WM_MOUSEWHEEL
                DetachMessage Me, mUserControlHwnd, WM_MOUSEHWHEEL
                If mOnlySubclassUserControl Then DetachMessage Me, mUserControlHwnd, WM_THEMECHANGED
                On Error GoTo 0
                mCanPostDrawMessage = False
            Else
                On Error Resume Next
                DetachMessage Me, mUserControlHwnd, WM_LBUTTONDOWN
                DetachMessage Me, mUserControlHwnd, WM_LBUTTONUP
                DetachMessage Me, mUserControlHwnd, WM_LBUTTONDBLCLK
                DetachMessage Me, mUserControlHwnd, WM_MOUSEMOVE
                DetachMessage Me, mUserControlHwnd, WM_THEMECHANGED
                DetachMessage Me, mUserControlHwnd, WM_THEMEREPAINT
                On Error GoTo 0
            End If
        End If
        mSubclassed = False
    End If

    If Not mSubclassedControlsForPaintingHwnds Is Nothing Then
        For c = 1 To mSubclassedControlsForPaintingHwnds.Count
            iHwnd = mSubclassedControlsForPaintingHwnds(c)
            On Error Resume Next
            DetachMessage Me, iHwnd, WM_PAINT
            DetachMessage Me, iHwnd, WM_MOVE
            On Error GoTo 0
        Next c
        Set mSubclassedControlsForPaintingHwnds = Nothing
    End If
    
    If Not mSubclassedFramesHwnds Is Nothing Then
        For c = 1 To mSubclassedFramesHwnds.Count
            iHwnd = mSubclassedFramesHwnds(c)
            On Error Resume Next
            DetachMessage Me, iHwnd, WM_PRINTCLIENT
            DetachMessage Me, iHwnd, WM_MOUSELEAVE
            On Error GoTo 0
        Next c
        Set mSubclassedFramesHwnds = Nothing
    End If
    
    If Not mSubclassedControlsForMoveHwnds Is Nothing Then
        For c = 1 To mSubclassedControlsForMoveHwnds.Count
            iHwnd = mSubclassedControlsForMoveHwnds(c)
            On Error Resume Next
            DetachMessage Me, iHwnd, WM_WINDOWPOSCHANGING
            On Error GoTo 0
        Next c
        Set mSubclassedControlsForMoveHwnds = Nothing
    End If
    
    If Not mTDISubclassedFormsHwnds Is Nothing Then
        For c = 1 To mTDISubclassedFormsHwnds.Count
            iHwnd = mTDISubclassedFormsHwnds(c)
            On Error Resume Next
            DetachMessage Me, iHwnd, WM_STYLECHANGING
            DetachMessage Me, iHwnd, WM_DESTROY
            DetachMessage Me, iHwnd, WM_SHOWWINDOW
            On Error GoTo 0
        Next
        Set mTDISubclassedFormsHwnds = Nothing
    End If
End Sub

' The default argument is what makes VB6 leave a property out of the bag, and it
' decides by comparing values. Passing Ambient.* there - the obvious option - dropped
' any color deliberately set to the container's color, and ReadProperties then read
' that absence as "this one is inherited", so the color was lost on the next load.
' Omission has to follow the flag instead: passing nColor itself omits the property
' when the color really is following the container, and passing -1 forces it to be
' written otherwise, because IsValidOLE_COLOR rejects -1 and so it can never match a
' real color
Private Sub WriteColorFromAmbient(PropBag As PropertyBag, ByVal nName As String, ByVal nColor As Long, ByVal nIsFromAmbient As Boolean)
    If nIsFromAmbient Then
        PropBag.WriteProperty nName, nColor, nColor
    Else
        PropBag.WriteProperty nName, nColor, -1
    End If
End Sub

' The .frm stores strings in the ANSI code page of the machine that saves it. A text with anything
' outside ASCII is also saved escaped to plain ASCII under a second name, and that one wins when
' reading. Forms saved before this have no second name and are read as they always were.
Private Sub WriteTextProperty(PropBag As PropertyBag, ByVal nName As String, nValue As Variant, ByVal nDefault As String)
    PropBag.WriteProperty nName, nValue, nDefault
    If VarType(nValue) = vbString Then
        If HasNonASCII(CStr(nValue)) Then
            PropBag.WriteProperty UnicodePropertyName(nName), EscapeNonASCII(CStr(nValue)), ""
        End If
    End If
End Sub

Private Function ReadTextProperty(PropBag As PropertyBag, ByVal nName As String, ByVal nDefault As String) As Variant
    Dim iEscaped As String
    
    iEscaped = PropBag.ReadProperty(UnicodePropertyName(nName), "")
    If iEscaped <> "" Then
        ReadTextProperty = UnescapeNonASCII(iEscaped)
    Else
        ReadTextProperty = PropBag.ReadProperty(nName, nDefault)
    End If
End Function

' "TabCaption(0)" -> "TabCaptionU(0)"
Private Function UnicodePropertyName(ByVal nName As String) As String
    Dim iPos As Long
    
    iPos = InStr(nName, "(")
    If iPos = 0 Then
        UnicodePropertyName = nName & "U"
    Else
        UnicodePropertyName = Left$(nName, iPos - 1) & "U" & Mid$(nName, iPos)
    End If
End Function

Private Function HasNonASCII(ByVal nText As String) As Boolean
    Dim iPos As Long
    
    For iPos = 1 To Len(nText)
        If (AscW(Mid$(nText, iPos, 1)) And &HFFFF&) > 126 Then
            HasNonASCII = True
            Exit Function
        End If
    Next
End Function

Private Function EscapeNonASCII(ByVal nText As String) As String
    Dim iPos As Long
    Dim iCode As Long
    
    For iPos = 1 To Len(nText)
        iCode = AscW(Mid$(nText, iPos, 1)) And &HFFFF&
        If (iCode < 32) Or (iCode > 126) Or (iCode = 92) Then
            EscapeNonASCII = EscapeNonASCII & "\u" & Right$("000" & Hex$(iCode), 4)
        Else
            EscapeNonASCII = EscapeNonASCII & ChrW$(iCode)
        End If
    Next
End Function

Private Function UnescapeNonASCII(ByVal nText As String) As String
    Dim iPos As Long
    Dim iHex As String
    
    iPos = 1
    Do While iPos <= Len(nText)
        iHex = ""
        If Mid$(nText, iPos, 2) = "\u" Then iHex = Mid$(nText, iPos + 2, 4)
        If (Len(iHex) = 4) And (Not iHex Like "*[!0-9A-Fa-f]*") Then
            UnescapeNonASCII = UnescapeNonASCII & ChrW$(Val("&H" & iHex & "&"))
            iPos = iPos + 6
        Else
            UnescapeNonASCII = UnescapeNonASCII & Mid$(nText, iPos, 1)
            iPos = iPos + 1
        End If
    Loop
End Function

Private Sub UserControl_WriteProperties(PropBag As PropertyBag)
    Dim c As Long
    Dim c2 As Long
    Dim iTabsToSave As Long
    Dim iAmbientFont As StdFont
    Dim iTheme As NewTabTheme
    Dim iBytes() As Byte
    
    StoreVisibleControlsInSelectedTab
    
    PropBag.WriteProperty "ControlJustAdded", mControlJustAdded, True
    
    PropBag.WriteProperty "StripEndFreeSpace", Round(mStripEndFreeSpace), cPropDef_StripEndFreeSpace ' in Himetric
    PropBag.WriteProperty "SubclassingMethod", mSubclassingMethod, cPropDef_SubclassingMethod
    ' the new tab button is a runtime artifact and is never saved: NewTabButtonCreate
    ' builds it again on loading. Saving it would leave one more behind on every save
    iTabsToSave = mTabs
    If TabIsNewTabButton(mTabs - 1) Then iTabsToSave = mTabs - 1
    PropBag.WriteProperty "Tabs", iTabsToSave, cPropDef_Tabs
    WriteColorFromAmbient PropBag, "BackColor", mBackColor, mBackColorIsFromAmbient
    WriteColorFromAmbient PropBag, "ForeColor", mForeColor, mForeColorIsFromAmbient
    ' An automatic colour is not written at all, and its absence is what ReadProperties reads
    ' back as automatic. Nothing has to be written to erase a key: the PropertyBag is built
    ' from scratch on every save
    If Not mForeColorSelectedTab_IsAutomatic Then PropBag.WriteProperty "ForeColorSelectedTab", mForeColorSelectedTab
    If Not mForeColorHighlighted_IsAutomatic Then PropBag.WriteProperty "ForeColorHighlighted", mForeColorHighlighted
    If Not mFlatTabBorderColorHighlighted_IsAutomatic Then PropBag.WriteProperty "FlatTabBorderColorHighlighted", mFlatTabBorderColorHighlighted
    If Not mFlatTabBorderColorSelectedTab_IsAutomatic Then PropBag.WriteProperty "FlatTabBorderColorSelectedTab", mFlatTabBorderColorSelectedTab
    If Not mFlatTabBorderColorInactive_IsAutomatic Then PropBag.WriteProperty "FlatTabBorderColorInactive", mFlatTabBorderColorInactive
    ' PropBag compares the value against the default to decide whether to write it, and two StdFont
    ' objects are never the same object, so the font ended up in every form even when it was the
    ' container's own.
    Set iAmbientFont = Ambient.Font
    If Not FontsAreEqual(mFont, iAmbientFont) Then
        PropBag.WriteProperty "Font", mFont, iAmbientFont
    End If
    PropBag.WriteProperty "Enabled", mEnabled, True
    PropBag.WriteProperty "TabsPerRow", mTabsPerRow, cPropDef_TabsPerRow
    PropBag.WriteProperty "Tab", mTab, 0
    PropBag.WriteProperty "TabOrientation", mTabOrientation, ssTabOrientationTop
    PropBag.WriteProperty "ShowFocusRect", mShowFocusRect, cPropDef_ShowFocusRect
    PropBag.WriteProperty "WordWrap", mWordWrap, cPropDef_WordWrap
    PropBag.WriteProperty "Style", mStyle, cPropDef_Style
    ' with AutoTabHeight on, the height is derived from the font on the first Draw, so it is not saved
    If Not mAutoTabHeight Then
        PropBag.WriteProperty "TabHeight", Round(mTabHeight), Round(mDefaultTabHeight)  ' in Himetric, for compatibility with the original SSTab
    End If
    PropBag.WriteProperty "TabMaxWidth", Round(mTabMaxWidth), cPropDef_TabMaxWidth  ' in Himetric, for compatibility with the original SSTab
    PropBag.WriteProperty "TabGeneralFixedWidth", Round(mTabGeneralFixedWidth), cPropDef_TabGeneralFixedWidth ' in Himetric
    PropBag.WriteProperty "TabMinWidth", Round(mTabMinWidth), cPropDef_TabMinWidth ' in Himetric
    PropBag.WriteProperty "MousePointer", mMousePointer, ssDefault
    PropBag.WriteProperty "MouseIcon", mMouseIcon, Nothing
    PropBag.WriteProperty "OLEDropMode", mOLEDropMode, ssOLEDropNone
    PropBag.WriteProperty "MaskColor", mMaskColor, cPropDef_MaskColor
    PropBag.WriteProperty "UseMaskColor", mUseMaskColor, cPropDef_UseMaskColor
    PropBag.WriteProperty "ScalePicturesForDPI", mScalePicturesForDPI, cPropDef_ScalePicturesForDPI
    PropBag.WriteProperty "TDIFormsIconSize", mTDIFormsIconSize, cPropDef_TDIFormsIconSize
    PropBag.WriteProperty "HighlightTabExtraHeight", Round(mHighlightTabExtraHeight), DefaultHighlightTabExtraHeightHimetric
    PropBag.WriteProperty "HighlightTabCaptionShift", Round(mHighlightTabCaptionShift), DefaultHighlightTabCaptionShiftHimetric
    PropBag.WriteProperty "HighlightEffect", mHighlightEffect, cPropDef_HighlightEffect
    PropBag.WriteProperty "HighlightEffectOut", mHighlightEffectOut, cPropDef_HighlightEffectOut
'    PropBag.WriteProperty "Themed", False
    WriteColorFromAmbient PropBag, "BackColorTabs", mBackColorTabs, mBackColorTabsIsFromAmbient
    ' The blocks below have no Else branch writing a dummy value to erase, and they do not need one:
    ' VB6 builds a fresh PropertyBag on every save, so a property that is never written simply is
    ' not in it and the read side gets its default.
    If Not mBackColorSelectedTab_IsAutomatic Then
        PropBag.WriteProperty "BackColorSelectedTab", mBackColorSelectedTab, -1
    End If
    ' Not tied to mBackColorSelectedTab_IsAutomatic, although the name says so.
    If mChangeControlsBackColor Then
        If mControlsBackColor_Applied = -1 Then mControlsBackColor_Applied = BackColorSelectedTabEffective
        PropBag.WriteProperty "ControlsBackColorApplied", mControlsBackColor_Applied, -1
    End If
    If Not mFlatBarColorHighlighted_IsAutomatic Then
        PropBag.WriteProperty "FlatBarColorHighlighted", mFlatBarColorHighlighted, -1
    End If
    If Not mFlatBarColorInactive_IsAutomatic Then
        PropBag.WriteProperty "FlatBarColorInactive", mFlatBarColorInactive, -1
    End If
    If Not mFlatTabsSeparationLineColor_IsAutomatic Then
        PropBag.WriteProperty "FlatTabsSeparationLineColor", mFlatTabsSeparationLineColor, -1
    End If
    If Not mFlatBodySeparationLineColor_IsAutomatic Then
        PropBag.WriteProperty "FlatBodySeparationLineColor", mFlatBodySeparationLineColor, -1
    End If
    If Not mFlatBorderColor_IsAutomatic Then
        PropBag.WriteProperty "FlatBorderColor", mFlatBorderColor, -1
    End If
    If Not mHighlightColor_IsAutomatic Then
        PropBag.WriteProperty "HighlightColor", mHighlightColor, -1
    End If
    If Not mHighlightColorSelectedTab_IsAutomatic Then
        PropBag.WriteProperty "HighlightColorSelectedTab", mHighlightColorSelectedTab, -1
    End If
    If Not mHighlightGradientColor_IsAutomatic Then
        PropBag.WriteProperty "HighlightGradientColor", mHighlightGradientColor, -1
    End If
    If Not mHighlightGradientColorSelectedTab_IsAutomatic Then
        PropBag.WriteProperty "HighlightGradientColorSelectedTab", mHighlightGradientColorSelectedTab, -1
    End If
    PropBag.WriteProperty "ShowDisabledState", mShowDisabledState, cPropDef_ShowDisabledState
    PropBag.WriteProperty "ChangeControlsBackColor", mChangeControlsBackColor, cPropDef_ChangeControlsBackColor
    PropBag.WriteProperty "ChangeControlsForeColor", mChangeControlsForeColor, cPropDef_ChangeControlsForeColor
    PropBag.WriteProperty "TabWidthStyle", mTabWidthStyle, cPropDef_TabWidthStyle
    PropBag.WriteProperty "TabHeightStyleForHorizontal", mTabHeightStyleForHorizontal, cPropDef_TabHeightStyleForHorizontal
    PropBag.WriteProperty "ShowRowsInPerspective", mShowRowsInPerspective, cPropDef_ShowRowsInPerspective
    PropBag.WriteProperty "NewTabButton", mNewTabButton, cPropDef_NewTabButton
    PropBag.WriteProperty "CloseButton", mCloseButton, False
    PropBag.WriteProperty "CloseButtonPosition", mCloseButtonPosition, ntCBPositionOnTabs
    If mCloseButtonUserFontIsSet Then
        PropBag.WriteProperty "CloseButtonFont", mCloseButtonUserFont
        PropBag.WriteProperty "CloseButtonFontName", mCloseButtonUserFontName
    End If
    PropBag.WriteProperty "CloseButtonChar", mCloseButtonUserChar, 0
    If mNewTabButtonUserFontIsSet Then
        PropBag.WriteProperty "NewTabButtonFont", mNewTabButtonUserFont
        PropBag.WriteProperty "NewTabButtonFontName", mNewTabButtonUserFontName
    End If
    PropBag.WriteProperty "NewTabButtonChar", mNewTabButtonUserChar, 0
    If mStripButtonsUserFontIsSet Then
        PropBag.WriteProperty "StripButtonsFont", mStripButtonsUserFont
        PropBag.WriteProperty "StripButtonsFontName", mStripButtonsUserFontName
    End If
    PropBag.WriteProperty "StripButtonBackChar", mStripButtonBackChar, 0
    PropBag.WriteProperty "StripButtonForwardChar", mStripButtonForwardChar, 0
    PropBag.WriteProperty "StripButtonListChar", mStripButtonListChar, 0
    WriteTextProperty PropBag, "NewTabButtonToolTipText", mNewTabButtonToolTipText, ""
    WriteTextProperty PropBag, "StripButtonBackToolTipText", mStripButtonBackToolTipText, ""
    WriteTextProperty PropBag, "StripButtonForwardToolTipText", mStripButtonForwardToolTipText, ""
    WriteTextProperty PropBag, "StripButtonListToolTipText", mStripButtonListToolTipText, ""
    WriteTextProperty PropBag, "TDIDefaultTabCaption", mTDIDefaultTabCaption, cPropDef_TDIDefaultTabCaption
    WriteTextProperty PropBag, "TDINewTabCaption", mTDINewTabCaption, cPropDef_TDINewTabCaption
    PropBag.WriteProperty "TabsOverflow", mTabsOverflow, ntTOMultiRow
    PropBag.WriteProperty "NewTabButtonPosition", mNewTabButtonPosition, ntNBAfterLastTab
    PropBag.WriteProperty "StripButtonsRow", mStripButtonsRow, ntSBSelectedTabRow
    PropBag.WriteProperty "TabSeparation", mTabSeparation, cPropDef_TabSeparation
    PropBag.WriteProperty "TabPaddingWidth", mTabPaddingWidth, cPropDef_TabPaddingWidth
    PropBag.WriteProperty "CloseButtonPadding", mCloseButtonPadding, cPropDef_CloseButtonPadding
    PropBag.WriteProperty "TabPaddingHeight", mTabPaddingHeight, cPropDef_TabPaddingHeight
    PropBag.WriteProperty "TabAppearance", mTabAppearance, cPropDef_TabAppearance
    PropBag.WriteProperty "IconAlignment", mIconAlignment, cPropDef_IconAlignment
    PropBag.WriteProperty "AutoRelocateControls", mAutoRelocateControls, cPropDef_AutoRelocateControls
    PropBag.WriteProperty "SoftEdges", mSoftEdges, cPropDef_SoftEdges
    PropBag.WriteProperty "RightToLeft", mRightToLeft, Ambient.RightToLeft
    PropBag.WriteProperty "HandleHighContrastTheme", mHandleHighContrastTheme, cPropDef_HandleHighContrastThem
    PropBag.WriteProperty "LeftOffsetToHideWhenSaved", mLeftOffsetToHide + mPendingLeftOffset, 75000
    PropBag.WriteProperty "BackStyle", mBackStyle, cPropDef_BackStyle
    PropBag.WriteProperty "AutoTabHeight", mAutoTabHeight, cPropDef_AutoTabHeight
    PropBag.WriteProperty "OLEDropOnOtherTabs", mOLEDropOnOtherTabs, cPropDef_OLEDropOnOtherTabs
    PropBag.WriteProperty "FlatBarColorSelectedTab", mFlatBarColorSelectedTab, cPropDef_FlatBarColorSelectedTab
    PropBag.WriteProperty "TabTransition", mTabTransition, cPropDef_TabTransition
    PropBag.WriteProperty "FlatRoundnessTop", mFlatRoundnessTop, cPropDef_FlatRoundnessTop
    PropBag.WriteProperty "FlatRoundnessBottom", mFlatRoundnessBottom, cPropDef_FlatRoundnessBottom
    PropBag.WriteProperty "FlatRoundnessTabs", mFlatRoundnessTabs, cPropDef_FlatRoundnessTabs
    PropBag.WriteProperty "TabMousePointerHand", mTabMousePointerHand, cPropDef_TabMousePointerHand
    If Not mIconColor_IsAutomatic Then PropBag.WriteProperty "IconColor", mIconColor
    If Not mIconColorSelectedTab_IsAutomatic Then PropBag.WriteProperty "IconColorSelectedTab", mIconColorSelectedTab
    If Not mIconColorTabHighlighted_IsAutomatic Then PropBag.WriteProperty "IconColorTabHighlighted", mIconColorTabHighlighted
    If Not mIconColorMouseHover_IsAutomatic Then PropBag.WriteProperty "IconColorMouseHover", mIconColorMouseHover
    If Not mIconColorMouseHoverSelectedTab_IsAutomatic Then PropBag.WriteProperty "IconColorMouseHoverSelectedTab", mIconColorMouseHoverSelectedTab
    If Not mCloseButtonColor_IsAutomatic Then PropBag.WriteProperty "CloseButtonColor", mCloseButtonColor
    If Not mCloseButtonColorSelectedTab_IsAutomatic Then PropBag.WriteProperty "CloseButtonColorSelectedTab", mCloseButtonColorSelectedTab
    ' the two hover slots of the 'x' still compare against the constant they fall back to,
    ' which is the same one ReadProperties uses. They are the only two of the family without a
    ' flag, and the reason is in their Property Let
    PropBag.WriteProperty "CloseButtonColorMouseHover", mCloseButtonColorMouseHover, cPropDef_CloseButtonColorMouseHover
    PropBag.WriteProperty "CloseButtonColorMouseHoverSelectedTab", mCloseButtonColorMouseHoverSelectedTab, cPropDef_CloseButtonColorMouseHover
    If Not mCloseButtonColorTabHighlighted_IsAutomatic Then PropBag.WriteProperty "CloseButtonColorTabHighlighted", mCloseButtonColorTabHighlighted
    If Not mStripButtonsColor_IsAutomatic Then PropBag.WriteProperty "StripButtonsColor", mStripButtonsColor
    If Not mStripButtonsColorHighlighted_IsAutomatic Then PropBag.WriteProperty "StripButtonsColorHighlighted", mStripButtonsColorHighlighted
    If Not mNewTabButtonColor_IsAutomatic Then PropBag.WriteProperty "NewTabButtonColor", mNewTabButtonColor
    If Not mNewTabButtonColorHighlighted_IsAutomatic Then PropBag.WriteProperty "NewTabButtonColorHighlighted", mNewTabButtonColorHighlighted
    PropBag.WriteProperty "HighlightMode", mHighlightMode, cPropDef_HighlightMode
    PropBag.WriteProperty "HighlightModeSelectedTab", mHighlightModeSelectedTab, cPropDef_HighlightModeSelectedTab
    PropBag.WriteProperty "CaptionAlignment", mCaptionAlignment, cPropDef_CaptionAlignment
    PropBag.WriteProperty "FlatBorderMode", mFlatBorderMode, cPropDef_FlatBorderMode
    PropBag.WriteProperty "FlatBarHeight", mFlatBarHeight, cPropDef_FlatBarHeight
    PropBag.WriteProperty "FlatBarGripHeight", mFlatBarGripHeight, cPropDef_FlatBarGripHeight
    PropBag.WriteProperty "FlatTabBodyGap", mFlatTabBodyGap, cPropDef_FlatTabBodyGap
    PropBag.WriteProperty "FlatBarPosition", mFlatBarPosition, cPropDef_FlatBarPosition
    PropBag.WriteProperty "CanReorderTabs", mCanReorderTabs, cPropDef_CanReorderTabs
    PropBag.WriteProperty "TDIMode", mTDIMode, cPropDef_TDIMode
    PropBag.WriteProperty "FlatBodySeparationLineHeight", mFlatBodySeparationLineHeight, cPropDef_FlatBodySeparationLineHeight
    PropBag.WriteProperty "UserControlSizeCorrectionsCounter_ScaleWidthNotToResize", mUserControlSizeCorrectionsCounter_ScaleWidthNotToResize, 0
    PropBag.WriteProperty "UserControlSizeCorrectionsCounter_ScaleHeightNotToResize", mUserControlSizeCorrectionsCounter_ScaleHeightNotToResize, 0
    ' The format version and not App.Major any more: what a saved form needs to declare is how to
    ' read it back, and that has no reason to move every time the OCX is rebuilt
    PropBag.WriteProperty "ControlVersion", cDataFormatVersion, 0
    
    For c = 0 To iTabsToSave - 1
        PropBag.WriteProperty "TabPicture(" & CStr(c) & ")", mTabData(c).Picture, Nothing
        PropBag.WriteProperty "TabPic16(" & CStr(c) & ")", mTabData(c).Pic16, Nothing
        PropBag.WriteProperty "TabPic20(" & CStr(c) & ")", mTabData(c).Pic20, Nothing
        PropBag.WriteProperty "TabPic24(" & CStr(c) & ")", mTabData(c).Pic24, Nothing
        PropBag.WriteProperty "TabIconChar(" & CStr(c) & ")", mTabData(c).IconChar, 0
        PropBag.WriteProperty "TabIconLeftOffset(" & CStr(c) & ")", mTabData(c).IconLeftOffset, 0
        PropBag.WriteProperty "TabIconTopOffset(" & CStr(c) & ")", mTabData(c).IconTopOffset, 0
        PropBag.WriteProperty "TabIconInColor(" & CStr(c) & ")", mTabData(c).IconInColor, False
        WriteTextProperty PropBag, "TabCaption(" & CStr(c) & ")", mTabData(c).Caption, "Tab " & CStr(c)
        WriteTextProperty PropBag, "TabToolTipText(" & CStr(c) & ")", mTabData(c).ToolTipText, ""
        PropBag.WriteProperty "TabEnabled(" & CStr(c) & ")", mTabData(c).Enabled, True
        PropBag.WriteProperty "TabCloseButton(" & CStr(c) & ")", mTabData(c).CloseButton, ntYNAuto
        PropBag.WriteProperty "TabCloseButtonEnabled(" & CStr(c) & ")", mTabData(c).CloseButtonEnabled, True
        PropBag.WriteProperty "TabMovable(" & CStr(c) & ")", mTabData(c).Movable, True
        PropBag.WriteProperty "TabVisible(" & CStr(c) & ")", mTabData(c).Visible, True
        PropBag.WriteProperty "Tab(" & c & ").ControlCount", mTabData(c).Controls.Count, 0
        For c2 = 1 To mTabData(c).Controls.Count
            PropBag.WriteProperty "Tab(" & c & ").Control(" & c2 - 1 & ")", mTabData(c).Controls(c2), ""
        Next
    
        If Not FontsAreEqual(mTabData(c).IconFont, mDefaultIconFont) Then
            PropBag.WriteProperty "IconFont(" & CStr(c) & ")", mTabData(c).IconFont, Nothing
            PropBag.WriteProperty "IconFontName(" & CStr(c) & ")", mTabData(c).IconFontName, ""
        End If
        PropBag.WriteProperty "TabFixedWidth(" & CStr(c) & ")", Round(mTabData(c).FixedWidth), 0 ' in Himetric
        WriteTextProperty PropBag, "TabTag(" & CStr(c) & ")", mTabData(c).Tag, ""
        PropBag.WriteProperty "TabData(" & CStr(c) & ")", mTabData(c).Data, 0
        iBytes = mTabData(c).CustomColors.Serialize
        If UBound(iBytes) = -1 Then
            PropBag.WriteProperty "TabCustomColors(" & CStr(c) & ")", "", ""
        Else
            PropBag.WriteProperty "TabCustomColors(" & CStr(c) & ")", iBytes
        End If
        WriteTextProperty PropBag, "TabKey(" & CStr(c) & ")", mTabData(c).Key, ""
    Next c
    
    If Not mThemesCollection Is Nothing Then
        If mThemesCollection.ThereAreCustomThemes Then
            c2 = 0
            For c = 1 To mThemesCollection.Count
                Set iTheme = mThemesCollection(c)
                If iTheme.Custom Then
                    c2 = c2 + 1
                    PropBag.WriteProperty "Theme(" & CStr(c2) & ")", iTheme.Serialize
                End If
            Next
        End If
    End If
End Sub

#If (SOLIDFILLDIAG = 1) Or (ROTATIONDIAG = 1) Or (SHEETDIAG = 1) Then
' These diagnostics act before and after a whole draw, so with any of them on the drawing
' routine becomes DrawCore and this wraps it
Private Sub Draw()
#If SOLIDFILLDIAG = 1 Then ' TEMP diagnostic
    Dim iSFStart As Currency
    Dim iSFEnd As Currency
    Dim iSFFreq As Currency
    Dim iSFMode As String
    Dim iSFReport As String
#End If
#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
    Dim iRDStart As Currency
    Dim iRDEnd As Currency
    Dim iRDFreq As Currency
    Dim iRDSlot As Long
    Dim iRDReport As String
#End If
    
#If SOLIDFILLDIAG = 1 Then ' TEMP diagnostic
    ' Only the outermost Draw resets and reports. A re-entrant Draw that reset the counters
    ' would wipe the ones of the Draw it interrupted
    mSolidFillDiagDepth = mSolidFillDiagDepth + 1
    If mSolidFillDiagDepth = 1 Then
        mSolidFillCalls = 0
        mSolidFillLines = 0
        mGradFillCalls = 0
        mGradFillLines = 0
        mSolidFillTime = 0
        QueryPerformanceCounter iSFStart
    End If
#End If
#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
    ' Same reasoning as the block above: only the outermost Draw resets and reports
    mRotDiagDepth = mRotDiagDepth + 1
    If mRotDiagDepth = 1 Then
        For iRDSlot = 1 To 9
            mRotDiagSlot(iRDSlot) = 0
        Next iRDSlot
        QueryPerformanceCounter iRDStart
    End If
#End If
    DrawCore
#If SHEETDIAG = 1 Then ' TEMP diagnostic
    If mAmbientUserMode Then Debug.Print "SHEET afterDraw R-1/R row0="; picDraw.Point(mSheetDiagX, mSheetDiagY); picDraw.Point(mSheetDiagX + 1, mSheetDiagY)
#End If
#If SOLIDFILLDIAG = 1 Then ' TEMP diagnostic
    If mSolidFillDiagDepth = 1 Then
        QueryPerformanceCounter iSFEnd
        QueryPerformanceFrequency iSFFreq
        If (mSolidFillDiagCount < 200) And (iSFFreq <> 0) Then
            mSolidFillDiagCount = mSolidFillDiagCount + 1
            iSFMode = "fast"
            iSFReport = "SFDIAG " & iSFMode & " orient=" & mTabOrientation
            iSFReport = iSFReport & " tabs=" & mTabs & " rows=" & mRows
            iSFReport = iSFReport & " size=" & mScaleWidth & "x" & mScaleHeight
            iSFReport = iSFReport & " | solid_calls=" & mSolidFillCalls
            iSFReport = iSFReport & " solid_lines=" & mSolidFillLines
            iSFReport = iSFReport & " grad_calls=" & mGradFillCalls
            iSFReport = iSFReport & " grad_lines=" & mGradFillLines
            iSFReport = iSFReport & " | fill_ms=" & Format$(CDbl(mSolidFillTime) / CDbl(iSFFreq) * 1000#, "0.00")
            iSFReport = iSFReport & " draw_ms=" & Format$(CDbl(iSFEnd - iSFStart) / CDbl(iSFFreq) * 1000#, "0.00")
            Debug.Print iSFReport
        End If
    End If
    mSolidFillDiagDepth = mSolidFillDiagDepth - 1
#End If
#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
    If mRotDiagDepth = 1 Then
        QueryPerformanceCounter iRDEnd
        QueryPerformanceFrequency iRDFreq
        If (mRotDiagCount < 200) And (iRDFreq <> 0) Then
            mRotDiagCount = mRotDiagCount + 1
            iRDReport = "ROTDIAG orient=" & mTabOrientation & " rtl=" & IIf(mRightToLeft, 1, 0)
            iRDReport = iRDReport & " size=" & mScaleWidth & "x" & mScaleHeight
            iRDReport = iRDReport & " tabs=" & mTabs & " rows=" & mRows
#If ROTATECACHE = 1 Then ' TEMP diagnostic
            iRDReport = iRDReport & " rotcache=" & IIf(mRotCacheLastHit, "hit", "miss")
#End If
            iRDReport = iRDReport & " | cls1=" & RotDiagMs(6, iRDFreq)
            iRDReport = iRDReport & " fill1=" & RotDiagMs(7, iRDFreq)
            iRDReport = iRDReport & " capture=" & RotDiagMs(1, iRDFreq)
            iRDReport = iRDReport & " detach=" & RotDiagMs(2, iRDFreq)
            iRDReport = iRDReport & " rot=" & RotDiagMs(3, iRDFreq)
            iRDReport = iRDReport & " resize=" & RotDiagMs(4, iRDFreq)
            iRDReport = iRDReport & " paste=" & RotDiagMs(5, iRDFreq)
            iRDReport = iRDReport & " tail_img=" & RotDiagMs(8, iRDFreq)
            iRDReport = iRDReport & " tailcls=" & RotDiagMs(9, iRDFreq)
            iRDReport = iRDReport & " | draw_ms=" & Format$(CDbl(iRDEnd - iRDStart) / CDbl(iRDFreq) * 1000#, "0.00")
            Debug.Print iRDReport
        End If
    End If
    mRotDiagDepth = mRotDiagDepth - 1
#End If
End Sub

Private Sub DrawCore()
#Else
Private Sub Draw()
#End If
    ' stays declared with the cache switched off: the rotation calls pass it either way and
    ' zero is what tells them to rotate the whole bitmap
    Dim iSplitRow As Long
    Dim iOnlyNewTabButton As Boolean
    Dim iTabWidth As Single
    Dim iTabData As T_TabData
    Dim iTabExtraHeight As Long
    Dim iTabSinkHeight As Long
    Dim iTabSinkCeiling As Long
    Dim iTabRowGrowth As Long
    Dim iTabTopReserve As Long
    Dim iLng As Long
    Dim t As Long
    Dim ctv As Long
    Dim iPosH As Long
    Dim iRow As Long ' this variable is reused and not always means the same thing
    Dim iRowPerspectiveSpace As Long
    Dim iSheetClampRight As Long
    Dim iBandStart As Long
    Dim iBandNorm As Long
    Dim iAllRowsPerspectiveSpace As Long
    Dim iTabHeight As Long
    Dim iTmpRect As RECT
    Dim iLastVisibleTab As Long
    Dim iLastVisibleTab_Prev As Long
    Dim iScaleWidth As Long
    Dim iScaleHeight As Long
    Dim iTabMaxWidth As Long
    Dim iTabMinWidth As Long
    Dim iTabLeft As Long
    Dim iRowTabCount As Long
    Dim iRowFreeTabs As Long
    Dim iRowExtra As Long
    Dim iRowExtraLeft As Long
    Dim iAccumulatedTabWith As Long
    Dim iTotalTabWidth As Long
    Dim iTabStretchRatio As Single
    Dim iARPSTmp As Long
    Dim iAvailableSpaceForTabs As Long
    Dim iRowsStretchRatio() As Single
    Dim iRowsStretchRatio_StartingRow As Long
    Dim iRowsStretchRatio_AccumulatedTabWidth As Long
    Dim r As Long
    Dim iAccumulatedAdditionalFixedTabSpace As Long
    Dim iRowsStretchRatio_AccumulatedAdditionalFixedTabWidth As Long
    Dim iSng As Single
    Dim iDecreaseStretchRatio As Boolean
    Dim iIncreaseStretchRatio As Boolean
    Dim iStretchIncreases As Long
    Dim iFitTolerance As Single
    Dim iDoNotDecreaseStretchRatio As Boolean
    Dim iStyle2 As NTStyleConstants
    Dim iMessage As T_MSG
    Dim iAlreadyNeedToBePainted As Boolean
    Dim iDoNotDecreaseStretchRatio2 As Boolean
    Dim iAnyTabHasFixedWidth As Boolean
    Dim iAccumulatedFixedTabWidth As Long
    Dim iRowGridTabWidth As Single
    Dim iRowOwnWidthSum As Single
    Dim iRowGridTabCount As Long
    Dim iRowTabsInRow As Long
    Dim iRowGridPosShift As Long
    Dim iRowRunningEdge As Single
    Dim iSlot As Long
    Dim iRowStartX As Long
    Dim iColOwnWidthHC As Single
    Dim iColFreeCountHC As Long
    Dim iFlatBodyGapTrim As Long
    Dim iColTabsHC As Long
    Dim iColMaxFreeHC As Long
    Dim iColFreeCountPackHC As Long
    Dim iColOwnPackHC As Single
    Dim iOwnExtentHC As Long
    Dim iHCColumnsTry As Long
    Dim iHCFreeSpace As Single
    Dim iColRunningEdgeHC As Single
    Dim iColGivenHC As Long
    Dim iColTabExtentHC As Long
    Dim iRowTargetWidth As Single
    Dim iRowGivenWidth As Long
    Dim iRowTabWidth As Long
#If ROWWIDTHDIAG_RWDIAG = 1 Then ' TEMP diagnostic
    Dim iRWDiagTab As Long
#End If
    Dim iTotalRowWidth As Long
    Dim iAvailableSpaceForTabsPrev As Long
    Dim iRowIsFilled() As Boolean
    Dim iRowNeedsSharing As Boolean
    Dim iRowStretchRatio As Single
    Dim iRowRoom As Long
    Dim iScaleWidthForTabs As Long
    Dim iScaleWidthForTabsReal As Long
    Dim iTabsPerRowLayout As Long
    Dim iMeasureCaptions As Boolean
    Dim iColumnWidthForHorizontalCaptions() As Long
    Dim iColumnLeftForHorizontalCaptions() As Long
    Dim iMaxTabsPerColumn As Long
    Dim iNumberOfColumnsForHorizontalCaptions As Long
    Dim iTabsPerColumn As Long
    Dim iTabHeightForHorizontalCaptions As Long
    Dim iColMaxHC As Long
    Dim iColCountHC As Long
    Dim iColSumHC As Long
    Dim iAccumHC As Long
    Dim iShareHC As Long
    Dim iStretchToFillHC As Boolean
    Dim iBalLoHC As Long
    Dim iBalHiHC As Long
    Dim iBalMidHC As Long
    Dim iPrevVisibleTabHC As Long
    Dim iPrevVisibleTabFillRows As Long
    Dim iRowPosBase As Long
    Dim iLogicalRowHC As Long
    Dim iTabLeftHC As Long
    Dim iColumnTabCount As Long
    Dim iSnapTargetHC As Long
    Dim iSnapTargetRow As Long
    Dim iSnapStretchBudget As Long
    Dim iRightBorder As Long
    Dim c As Long
    Dim p As StdPicture
    Dim iDragSaveRect As RECT
    Dim iDragSaveDC As LongPtr
    Dim iDragSaveBmp As LongPtr
    Dim iDragSaveOldBmp As LongPtr
    Dim iGrownTab As Long
    Dim iGrownSaveRect As RECT
    Dim iGrownSaveDC As LongPtr
    Dim iGrownSaveBmp As LongPtr
    Dim iGrownSaveOldBmp As LongPtr
    Dim iUseStripCache As Boolean
    Dim iUseHoverCache As Boolean
    Dim iHoverTab As Long
    Dim iHoverWasHovered As Boolean
    Dim iHoverWasCloseHovered As Boolean
    Dim iHoverSuppressed As Boolean
    Dim iHoverWasFadingOut As Boolean
    Dim iHoverSimple As Boolean
    Dim iHoverBaseOnCanvas As Boolean
    Dim iHoverBandLeft As Long
    Dim iHoverBandRight As Long
    Dim iHoverReplayRow As Long
    Dim iHoverReplayTab As Long
    ' A tab drawn wider than its rect is painted LATE: it is held back until just after the tab on
    ' its right, the only one that could take its columns away.
    Dim iDeferredWidenTab As Long
    Dim iRowSheetTab As Long
    Dim iBalRow As Long
    Dim iBalTab As Long
    Dim iBalCountThis As Long
    Dim iBalCountNext As Long
    Dim iBalFirstNext As Long
    Dim iBalLast As Long
    Dim iBalPosH As Long
    Dim iBalMoved As Boolean
    Dim iBalWidth As Single
#If HOVERCLIPDIAG = 1 Then ' TEMP diagnostic
    Dim iHCProbe0 As Long
    Dim iHCProbe1 As Long
    Dim iHCProbe2 As Long
    Dim iHCProbe3 As Long
    Dim iHCRowX As Long
    Dim iHCRowY As Long
#End If
#If BODYEDGEDIAG = 1 Then ' TEMP diagnostic
    Dim iBEDiagY As Long
    Dim iBEDiagStr As String
#End If
    
    iUseHoverCache = mHoverCacheAllowed
    mHoverCacheAllowed = False
    ButtonHoverTrack
    
    ' The strip cache is only taken by the Draw the drag's own MouseMove asked for, and the
    ' permission is consumed here, at the very top: any other Draw - a property write, a resize, a
    ' theme change - finds it False, paints the strip and rebuilds the cache.
    iUseStripCache = mDragStripCacheAllowed
    mDragStripCacheAllowed = False
    
    If mUserControlTerminated Or mTDIAddingNewTabForForm Then Exit Sub
    
    If Not mRedraw Then
        mNeedToDraw = True
        If Not mEnsuringDrawn Then
            Exit Sub
        End If
    End If
    If Not mPropertiesReady Then
        PostDrawMessage
        Exit Sub
    End If
    
    Debug.Assert NewTabButtonInvariantHolds
    If mSetAutoTabHeightPending Then SetAutoTabHeight
    tmrDraw.Enabled = False
    PeekMessage iMessage, mUserControlHwnd, WM_DRAW, WM_DRAW, PM_REMOVE ' remove posted message, if any
    mDrawMessagePosted = False
    If Not mAccessKeysSet Then
        If mAmbientUserMode Then SetAccessKeys
    End If
    UserControl.ScaleMode = vbPixels
    mScaleWidth = UserControl.ScaleWidth
    mScaleHeight = UserControl.ScaleHeight
    If Not ((mScaleWidth > 0) And (mScaleHeight > 0)) Then
        SetScaleMode
        Exit Sub
    End If
    If Not mFirstDraw Then mFirstDraw = True
    
    mDrawing = True
    For t = 0 To mTabs - 1
        mTabData(t).Selected = (t = mTab)
    Next
    ' The appearance is resolved FIRST, and what it resolves to is what decides whether the tabs are
    ' painted by uxtheme.
    iLng = mTabAppearance2
    mTabAppearance2 = ResolvedTabAppearance
    
    ' ntTAWindows is the only appearance that needs something from outside the control, and the only
    ' one that can be refused: high contrast, a classic theme, BackStyle transparent, the obsolete
    ' VisualStyles property turned off by hand, or OpenThemeData saying no.
    mVisualStylesActive = (mTabAppearance2 = ntTAWindows) And VisualStylesEffective And (mBackStyle <> ntTransparent)
    If mVisualStylesActive Then
        If mTheme <> 0 Then
            CloseThemeData mTheme
            mTheme = 0
        End If
        mTheme = OpenThemeData(mUserControlHwnd, StrPtr("Tab"))
        If mTheme = 0 Then
            mVisualStylesActive = False
        End If
        If mVisualStylesActive Then
            SetThemeExtraData
        End If
    End If
    If (mTabAppearance2 = ntTAWindows) And (Not mVisualStylesActive) Then mTabAppearance2 = ntTATabStrip
    
    If mVisualStylesActive Then
        iStyle2 = ssStylePropertyPage
    ElseIf mStyle = ntStyleTabStrip Then
        iStyle2 = ssStylePropertyPage
    Else
        iStyle2 = mStyle
    End If
    ' ntTAWindows and not mVisualStylesActive, which is now the same fact said the long way round:
    ' after the degradation above, the appearance holds 7 only when the theme really opened
    mAppearanceIsPP = (mTabAppearance2 = ntTAPropertyPage) Or (mTabAppearance2 = ntTAPropertyPageRounded) Or (mTabAppearance2 = ntTATabStrip) Or (mTabAppearance2 = ntTAWindows)
    ' Everything the TabStrip appearance draws is property page's drawing plus one extra row per
    ' light edge, so it joins mAppearanceIsPP rather than forking it.
    mAppearanceIsTabStrip = (mTabAppearance2 = ntTATabStrip)
    mAppearanceIsFlat = (Not mAppearanceIsPP) And (mTabAppearance2 = ntTAFlat)
    If mTabAppearance2 <> iLng Then ResetCachedThemeImages
    
    ' Cached in a local because the row loop reads it a few thousand times. The rule
    ' and the measurements behind it are on RowStartX, which is also what the end of
    ' the row is measured from - see RowLostToEdges
    iRowStartX = RowStartX()
    
    ' The extra height of a highlighted tab is split in two, and the split is what stops a large
    ' value from making the other tabs unreadable.
    If mHighlightAddExtraHeight Or mHighlightAddExtraHeightSelectedTab Then
        iTabExtraHeight = pScaleY(mHighlightTabExtraHeight, vbHimetric, vbPixels)
        iTabSinkHeight = iTabExtraHeight
        ' The ceiling is the default amount, what SSTab and the TabStrip sink their inactive tabs by
        iTabSinkCeiling = pScaleY(DefaultHighlightTabExtraHeightHimetric, vbHimetric, vbPixels)
        If iTabSinkHeight > iTabSinkCeiling Then iTabSinkHeight = iTabSinkCeiling
        iTabRowGrowth = iTabExtraHeight - iTabSinkHeight
    End If
    ' The row cell is the measured height and nothing else. The growth used to be added here,
    ' which multiplied it by the number of rows - see iTabTopReserve
    iTabHeight = pScaleY(mTabHeight, vbHimetric, vbPixels)
    
    mFlatRoundnessTop2 = mFlatRoundnessTopDPIScaled
    If mFlatRoundnessTop2 > iTabHeight Then
        mFlatRoundnessTop2 = iTabHeight
    End If
    mFlatRoundnessTabs2 = mFlatRoundnessTabsDPIScaled
    If mFlatRoundnessTabs2 > iTabHeight Then
        mFlatRoundnessTabs2 = iTabHeight
    End If
    GetTabWidthLimitsPixels iTabMinWidth, iTabMaxWidth
    If mTabWidthStyle = ntTWAuto Then
        mTabWidthStyle2 = AutoTabWidthStyle
    ElseIf mTabWidthStyle = ntTWGeneralFixedWidth Then
        ' The caption styles with the width pinned by the clamps, see GetTabWidthLimitsPixels. The
        ' clamps already skip the tabs with TabFixedWidth and the new tab button
        mTabWidthStyle2 = ntTWTabCaptionWidth
    ElseIf mTabWidthStyle = ntTWGeneralFixedWidthFillRows Then
        mTabWidthStyle2 = ntTWTabCaptionWidthFillRows
    Else
        mTabWidthStyle2 = mTabWidthStyle
    End If
    
    ' Set here: the tab width formulas and RowLostToEdges read them before the band shift
    mThemedLeftMarginAsTop = 0
    mThemedRightMarginAsTop = 0
    mThemedBottomMarginAsTop = 0
    If mVisualStylesActive Then
        ' The as-Top margins.
        Select Case mTabOrientation
            Case ssTabOrientationLeft, ntTabOrientationLeftTop, ntTabOrientationLeftHorizontal, ntTabOrientationLeftBottomHorizontal
                ' The same with and without RightToLeft: the mirroring of the whole image carries the pane
                mThemedLeftMarginAsTop = mThemedBodyBottomBorderPixels
                mThemedRightMarginAsTop = mThemedBodyTopBorderPixels
                mThemedBottomMarginAsTop = mThemedBodyRightBorderPixels
            Case ssTabOrientationRight, ntTabOrientationRightBottom, ntTabOrientationRightHorizontal, ntTabOrientationRightBottomHorizontal
                mThemedLeftMarginAsTop = mThemedBodyTopBorderPixels
                mThemedRightMarginAsTop = mThemedBodyBottomBorderPixels
                mThemedBottomMarginAsTop = mThemedBodyLeftBorderPixels
            Case ssTabOrientationBottom, ntTabOrientationBottomRight
                mThemedLeftMarginAsTop = mThemedBodyLeftBorderPixels
                mThemedRightMarginAsTop = mThemedBodyRightBorderPixels
                mThemedBottomMarginAsTop = mThemedBodyTopBorderPixels
            Case Else
                mThemedLeftMarginAsTop = mThemedBodyLeftBorderPixels
                mThemedRightMarginAsTop = mThemedBodyRightBorderPixels
                mThemedBottomMarginAsTop = mThemedBodyBottomBorderPixels
        End Select
    End If

    If mShowRowsInPerspective = ntYNAuto Then
        If (mStyle = ntStyleTabStrip) Or (mStyle = ntStyleFlat) Or (mStyle = ntStyleWindows) Then
            mShowsRowsPerspective2 = False
        Else
            mShowsRowsPerspective2 = (mTabWidthStyle2 <> ntTWTabStripEmulation) And (mTabWidthStyle2 <> ntTWTabCaptionWidthFillRows)
        End If
    Else
        mShowsRowsPerspective2 = CBool(mShowRowsInPerspective)
    End If
    If mShowsRowsPerspective2 Then
        iRowPerspectiveSpace = pScaleX(cRowPerspectiveSpace, vbTwips, vbPixels)
    End If
    
    ' TabSeparation counts columns of background left visible between two painted edges. A themed
    ' inactive tab paints its border exactly on rectL and rectR, so there the gap between rects is the air
    mTabSeparation2 = mTabSeparationDPIScaled
    If (Not mAppearanceIsPP) And (Not mAppearanceIsFlat) Then
        If mTabSeparation2 > 0 Then mTabSeparation2 = mTabSeparation2 + 1
    End If
    
    If (mTabOrientation = ssTabOrientationTop) Or (mTabOrientation = ntTabOrientationTopRight) Then
        m3DShadowH = m3DShadow
        m3DShadowV = m3DShadow
        m3DHighlightH = m3DHighlight
        m3DHighlightV = m3DHighlight
        m3DShadowH_Sel = m3DShadow_Sel
        m3DShadowV_Sel = m3DShadow_Sel
        m3DHighlightH_Sel = m3DHighlight_Sel
        m3DHighlightV_Sel = m3DHighlight_Sel
    ElseIf (mTabOrientation = ssTabOrientationBottom) Or (mTabOrientation = ntTabOrientationBottomRight) Then
        m3DShadowH = m3DHighlight
        m3DShadowV = m3DShadow
        m3DHighlightH = m3DShadow
        m3DHighlightV = m3DHighlight
        m3DShadowH_Sel = m3DHighlight_Sel
        m3DShadowV_Sel = m3DShadow_Sel
        m3DHighlightH_Sel = m3DShadow_Sel
        m3DHighlightV_Sel = m3DHighlight_Sel
    ElseIf (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Or (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationLeftBottomHorizontal) Then
        m3DShadowH = m3DShadow
        m3DShadowV = m3DHighlight
        m3DHighlightH = m3DHighlight
        m3DHighlightV = m3DShadow
        m3DShadowH_Sel = m3DShadow_Sel
        m3DShadowV_Sel = m3DHighlight_Sel
        m3DHighlightH_Sel = m3DHighlight_Sel
        m3DHighlightV_Sel = m3DShadow_Sel
    ElseIf (mTabOrientation = ssTabOrientationRight) Or (mTabOrientation = ntTabOrientationRightBottom) Or (mTabOrientation = ntTabOrientationRightHorizontal) Or (mTabOrientation = ntTabOrientationRightBottomHorizontal) Then
        m3DShadowH = m3DHighlight
        m3DShadowV = m3DShadow
        m3DHighlightH = m3DShadow
        m3DHighlightV = m3DHighlight
        m3DShadowH_Sel = m3DHighlight_Sel
        m3DShadowV_Sel = m3DShadow_Sel
        m3DHighlightH_Sel = m3DShadow_Sel
        m3DHighlightV_Sel = m3DHighlight_Sel
    End If
    mTabsAreRotatedButCaptionsAreHorizontal = (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationLeftBottomHorizontal) Or (mTabOrientation = ntTabOrientationRightHorizontal) Or (mTabOrientation = ntTabOrientationRightBottomHorizontal)
    mTabsAlignedAtTheEnd = (mTabOrientation = ntTabOrientationTopRight) Or (mTabOrientation = ntTabOrientationBottomRight) Or (mTabOrientation = ntTabOrientationLeftTop) Or (mTabOrientation = ntTabOrientationRightBottom) Or (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationRightBottomHorizontal)
    mTabsOrderReversed = (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationRightBottomHorizontal)
    mOrientationIsBottomOrRight = (mTabOrientation = ssTabOrientationBottom) Or (mTabOrientation = ntTabOrientationBottomRight) Or (mTabOrientation = ssTabOrientationRight) Or (mTabOrientation = ntTabOrientationRightBottom) Or (mTabOrientation = ntTabOrientationRightHorizontal) Or (mTabOrientation = ntTabOrientationRightBottomHorizontal) ' [BOTTOMRIGHTGROUP]
    
    If mBackStyle = ntOpaque Then
        If mEnabled Or (Not mAmbientUserMode) Or (Not mShowDisabledState) Then
            mBackColorTabs2 = TranslatedColor(mBackColorTabs, ntRoleBack)
            If IsEmpty(mTabData(mTab).CustomColors.BackColorSelectedTab) Or (mHandleHighContrastTheme And mHighContrastThemeOn) Then
                mBackColorSelectedTab2 = TranslatedColor(mBackColorSelectedTab, ntRoleBack)
            Else
                mBackColorSelectedTab2 = TranslatedColor(mTabData(mTab).CustomColors.BackColorSelectedTab, ntRoleBack)
            End If
        Else
            mBackColorTabs2 = TranslatedColor(mBackColorTabsDisabled, ntRoleBack)
            mBackColorSelectedTab2 = TranslatedColor(mBackColorSelectedTabDisabled, ntRoleBack)
        End If
    Else
        mBackColorTabs2 = TranslatedColor(mBackColorTabs, ntRoleBack)
        TranslateColor mBackColorSelectedTab, 0, iLng
        If mBackColorTabs2 = iLng Then
            mBackColorTabs2 = mBackColorTabs2 Xor &H1
        End If
        mBackColorSelectedTab2 = TranslatedColor(mBackColorSelectedTab, ntRoleBack)
        UserControl.MaskColor = mBackColorSelectedTab
    End If
    UserControl.BackStyle = IIf(mBackStyle = ntOpaque, ntOpaque, ntTransparent)
    
    If (mTabOrientation = ssTabOrientationTop) Or (mTabOrientation = ntTabOrientationTopRight) Or (mTabOrientation = ssTabOrientationBottom) Or (mTabOrientation = ntTabOrientationBottomRight) Then
        iScaleWidth = mScaleWidth
        iScaleHeight = mScaleHeight
    Else
        iScaleWidth = mScaleHeight
        iScaleHeight = mScaleWidth
    End If
    
    mOrientationIsBottom = (mTabOrientation = ssTabOrientationBottom) Or (mTabOrientation = ntTabOrientationBottomRight)

    ' A Draw cut short by an error leaves the '+' hidden and ZoneEnter would not find it
    If mNewTabButtonInZone Then NewTabButtonZoneRestore
    mNewTabButtonInZone = False
    mZoneNewTabWidth = 0
    mZoneListWidth = 0
    If mNewTabButtonPosition = ntNBStripEnd Then NewTabButtonZoneEnter
    mStripCloseButtonWidth = StripCloseButtonWidth
    iScaleWidthForTabs = iScaleWidth - pScaleX(mStripEndFreeSpace, vbHimetric, vbPixels) - StripButtonsReserve
    If iScaleWidthForTabs < 1 Then iScaleWidthForTabs = 1
    iScaleWidthForTabsReal = iScaleWidthForTabs
    ' measure tab captions and pic width
    ctv = -1
    If (mTabWidthStyle2 = ntTWTabStripEmulation) Or (mTabWidthStyle2 = ntTWStretchToFill) Then
        iTotalTabWidth = 0
        mRows = 1
    End If
    mVisibleTabs = 0
    iMeasureCaptions = (mTabWidthStyle2 = ntTWTabCaptionWidth) Or (mTabWidthStyle2 = ntTWTabCaptionWidthFillRows) Or (mTabWidthStyle2 = ntTWTabStripEmulation) Or (mTabWidthStyle2 = ntTWStretchToFill) Or mTabsAreRotatedButCaptionsAreHorizontal Or (mTDIMode = ntTDIModeForms)
    For t = 0 To mTabs - 1
        If mTabData(t).Visible Then
            mVisibleTabs = mVisibleTabs + 1
            ctv = ctv + 1
            ' Raised outside the measuring If below on purpose: ntTWEqualWidth does not measure
            ' captions at all and it is one of the branches that has to know about this
            If mTabData(t).FixedWidth <> 0 Then iAnyTabHasFixedWidth = True
            ' This cannot be skipped, not even while dragging, however expensive it is.
            If iMeasureCaptions Then
                iLng = MeasureTabIconAndCaption(t)
                ' TabMinWidth and TabMaxWidth are about the tabs the developer put there.
                ' The new tab button is furniture, it holds a single glyph and it has to
                ' measure by that glyph and nothing else, so both clamps skip it
                If (mTabData(t).FixedWidth <> 0) And (Not mTabsAreRotatedButCaptionsAreHorizontal) Then
                    ' Fixed is fixed, and it enters the layout HERE - same units and same point as
                    ' the two clamps - so that the row break, the accumulated widths and the stretch
                    ' ratios downstream all count the width this tab is really going to have.
                    iLng = pScaleX(mTabData(t).FixedWidth, vbHimetric, vbPixels) - 2 * mTabPaddingWidthDPIScaled
                    If iLng < 0 Then iLng = 0
                ElseIf Not mTabData(t).IsNewTabButton Then
                    If iTabMinWidth > 0 Then
                        If (iLng + 2 * mTabPaddingWidthDPIScaled) < iTabMinWidth Then
                            iLng = iTabMinWidth - 2 * mTabPaddingWidthDPIScaled
                        End If
                    End If
                    If iTabMaxWidth > 0 Then
                        If (iLng + 2 * mTabPaddingWidthDPIScaled) > iTabMaxWidth Then
                            iLng = iTabMaxWidth - 2 * mTabPaddingWidthDPIScaled
                        End If
                    End If
                End If
                mTabData(t).IconAndCaptionWidth = iLng
            Else
                ' the width of the tab does not come from what is inside it here, but the
                ' close button still has to know how big it is going to be drawn
                MeasureTabCloseButton t
            End If
        Else
            ' the layout below only writes these for visible tabs
            mTabData(t).LeftTab = False
            mTabData(t).RightTab = False
            mTabData(t).TopTab = False
        End If
    Next t
    
    ' TDI Forms: TDISyncFormTabIcon (called from MeasureTabIconAndCaption above) may have just
    ' loaded a new form icon and set mSetAutoTabHeightPending.
    If mSetAutoTabHeightPending And mAutoTabHeight Then
        SetAutoTabHeight
        iTabHeight = pScaleY(mTabHeight, vbHimetric, vbPixels)
        mFlatRoundnessTop2 = mFlatRoundnessTopDPIScaled
        If mFlatRoundnessTop2 > iTabHeight Then mFlatRoundnessTop2 = iTabHeight
        mFlatRoundnessTabs2 = mFlatRoundnessTabsDPIScaled
        If mFlatRoundnessTabs2 > iTabHeight Then mFlatRoundnessTabs2 = iTabHeight
    End If
    
    ' With every tab hidden and the new tab button there, the strip is drawn with the button alone
    ' and an empty body, so that a tab can still be added. Without the button there is nothing to lay out
    iOnlyNewTabButton = (VisibleTabsWithoutNewTabButton = 0) And TabIsNewTabButton(mTabs - 1)
    If iOnlyNewTabButton Then mTab = -1
    If ((VisibleTabsWithoutNewTabButton = 0) Or (mTab = -1)) And (Not iOnlyNewTabButton) Then
        Set UserControl.Picture = Nothing
        UpdateMaskPicture True
        mBodyReset = True
        GoTo TheExit:
    End If
    
    If mTabsAreRotatedButCaptionsAreHorizontal Then
        If (mTabHeightStyleForHorizontal = ntTHTabCaptionHeight) Or (mTabHeightStyleForHorizontal = ntTHMaxCaptionHeight) Or (mTabHeightStyleForHorizontal = ntTHStretchToFill) Then
            ' Measure every visible tab's needed height BEFORE deciding how many fit per column,
            ' and before ScrollDecide, which decides the overflow with them.
            For t = 0 To mTabs - 1
                If mTabData(t).Visible Then
                    ' Flat, + 1: the last column's rect stops two short of the body and the others lose
                    ' one under their neighbour, so one more keeps the caption band whole in all of them.
                    If mAppearanceIsFlat Then
                        iLng = mTabData(t).IconAndCaptionWidth + IIf(mFlatBarGripHeightDPIScaled > 0, mFlatBarGripHeightDPIScaled, 0) + mFlatBarHeightDPIScaled + mFlatTabBodyGapDPIScaled + 1
                    Else
                        iLng = mTabData(t).IconAndCaptionWidth
                    End If
                    iLng = iLng + 2 * mTabPaddingWidthDPIScaled
                    ' see the new tab button note in the caption measuring loop above
                    If Not mTabData(t).IsNewTabButton Then
                        If iTabMaxWidth > 0 Then
                            If iLng > iTabMaxWidth Then iLng = iTabMaxWidth
                        End If
                        If iTabMinWidth > 0 Then
                            If iLng < iTabMinWidth Then iLng = iTabMinWidth
                        End If
                    End If
                    If mTabData(t).FixedWidth <> 0 Then
                        ' In this family TabFixedWidth is the extent ALONG the strip, which is what
                        ' Width holds, so it enters here - before the packing - and the column
                        ' count below is worked out with the room this tab is really going to take
                        mTabData(t).Width = pScaleX(mTabData(t).FixedWidth, vbHimetric, vbPixels)
                    Else
                        mTabData(t).Width = MeasureTabHeightForHorizontalCaptions(t, iLng)
                    End If
                End If
            Next
        End If
    End If
    iTabsPerRowLayout = mTabsPerRow
    ScrollDecide iScaleWidthForTabs, iScaleWidthForTabsReal, iTabMaxWidth, iTabHeight
    If mStripScrolls Then iTabsPerRowLayout = mVisibleTabs
    ' A scrolling strip has nothing left over to stretch into, so it lays out as ntTHTabCaptionHeight
    iStretchToFillHC = (mTabHeightStyleForHorizontal = ntTHStretchToFill) And (Not mStripScrolls)
    
    ' set data about tabs placement on rows
    iLastVisibleTab = 0
    If mTabsAreRotatedButCaptionsAreHorizontal Then
        iAvailableSpaceForTabs = (iScaleWidthForTabs - RowLostToEdges())
        If (mTabHeightStyleForHorizontal = ntTHTabCaptionHeight) Or (mTabHeightStyleForHorizontal = ntTHMaxCaptionHeight) Or (mTabHeightStyleForHorizontal = ntTHStretchToFill) Then
            ' Pack incrementally, one tab at a time: a column closes (and is then "full") only when
            ' the next tab no longer fits in the available space.
            Do
                iRow = 0
                iPosH = 0
                ctv = 0
                iAccumHC = 0
                iColMaxHC = 0
                iPrevVisibleTabHC = -1
                For t = 0 To mTabs - 1
                    If mTabData(t).Visible Then
                        ctv = ctv + 1
                        iLastVisibleTab = t
                        mTabData(t).LeftTab = False
                        mTabData(t).RightTab = False
                        If iPosH > 0 Then
                            If mTabHeightStyleForHorizontal = ntTHMaxCaptionHeight Then
                                ' A tab carrying its own width is added at that width and is not
                                ' multiplied by the tallest of the column, because it is not going
                                ' to be evened out with the rest.
                                If mTabData(t).FixedWidth <> 0 Then
                                    iLng = iColFreeCountPackHC * iColMaxFreeHC + iColOwnPackHC + mTabData(t).Width + iPosH * mTabSeparation2
                                Else
                                    iLng = iColMaxFreeHC
                                    If mTabData(t).Width > iLng Then iLng = mTabData(t).Width
                                    iLng = (iColFreeCountPackHC + 1) * iLng + iColOwnPackHC + iPosH * mTabSeparation2
                                End If
                            Else
                                iLng = iAccumHC + mTabSeparation2 + mTabData(t).Width
                            End If
                            ' The room a column really has, asked to the single place that works it
                            ' out, and not a flat - 2.
                            If iLng > iAvailableSpaceForTabs Then
                                mTabData(iPrevVisibleTabHC).RightTab = True
                                iRow = iRow + 1
                                iPosH = 0
                            End If
                        End If
                        If iPosH = 0 Then
                            mTabData(t).LeftTab = True
                            iAccumHC = mTabData(t).Width
                            iColMaxHC = mTabData(t).Width
                            iColMaxFreeHC = 0
                            iColFreeCountPackHC = 0
                            iColOwnPackHC = 0
                        Else
                            iAccumHC = iAccumHC + mTabSeparation2 + mTabData(t).Width
                            If mTabData(t).Width > iColMaxHC Then iColMaxHC = mTabData(t).Width
                        End If
                        If mTabData(t).FixedWidth <> 0 Then
                            iColOwnPackHC = iColOwnPackHC + mTabData(t).Width
                        Else
                            iColFreeCountPackHC = iColFreeCountPackHC + 1
                            If mTabData(t).Width > iColMaxFreeHC Then iColMaxFreeHC = mTabData(t).Width
                        End If
                        iPosH = iPosH + 1
                        mTabData(t).PosH = iPosH
                        mTabData(t).Row = iRow
                        If ctv = mVisibleTabs Then
                            mTabData(t).RightTab = True
                        End If
                        iPrevVisibleTabHC = t
                    Else
                        mTabData(t).Row = -1
                    End If
                Next
                iNumberOfColumnsForHorizontalCaptions = iRow + 1
                iAvailableSpaceForTabsPrev = iAvailableSpaceForTabs
                iAvailableSpaceForTabs = (iScaleWidthForTabs - RowLostToEdges()) - iRowPerspectiveSpace * (iNumberOfColumnsForHorizontalCaptions - 1)
                If iAvailableSpaceForTabs >= iAvailableSpaceForTabsPrev Then
                    iAvailableSpaceForTabs = iAvailableSpaceForTabsPrev
                    Exit Do
                End If
            Loop
            mRows = iNumberOfColumnsForHorizontalCaptions
            If iStretchToFillHC And (mRows > 1) Then
                ' Balanced as ntTWStretchToFill balances its rows: repacked into the narrowest room that
                ' still takes the same number of columns, so the spare goes to the front ones and the
                ' last one is not left nearly empty to be stretched
                iBalLoHC = 1
                iBalHiHC = iAvailableSpaceForTabs
                Do While iBalLoHC < iBalHiHC
                    iBalMidHC = (iBalLoHC + iBalHiHC) \ 2
                    If HCPackColumns(iBalMidHC, False, 0) <= mRows Then
                        iBalHiHC = iBalMidHC
                    Else
                        iBalLoHC = iBalMidHC + 1
                    End If
                Loop
                HCPackColumns iBalLoHC, True, 0
            End If
        Else
        If iAnyTabHasFixedWidth Then
            ' Fill and Fixed work in two steps that a tab carrying its own width breaks: they get
            ' the capacity of a column from a SINGLE uniform tab height, and then split the tabs
            ' into equal COUNTS.
            Do
                iRow = 0
                iAccumHC = 0
                For t = 0 To mTabs - 1
                    If mTabData(t).Visible Then
                        If mTabData(t).FixedWidth <> 0 Then
                            iOwnExtentHC = pScaleX(mTabData(t).FixedWidth, vbHimetric, vbPixels)
                        Else
                            iOwnExtentHC = iTabHeight
                        End If
                        If iAccumHC > 0 Then
                            ' Same room as everywhere else in this family. See RowLostToEdges
                            If (iAccumHC + mTabSeparation2 + iOwnExtentHC) > iAvailableSpaceForTabs Then
                                iRow = iRow + 1
                                iAccumHC = 0
                            End If
                        End If
                        If iAccumHC > 0 Then iAccumHC = iAccumHC + mTabSeparation2
                        iAccumHC = iAccumHC + iOwnExtentHC
                    End If
                Next t
                iHCColumnsTry = iRow + 1
                iNumberOfColumnsForHorizontalCaptions = iHCColumnsTry
                iAvailableSpaceForTabsPrev = iAvailableSpaceForTabs
                iAvailableSpaceForTabs = (iScaleWidthForTabs - RowLostToEdges()) - iRowPerspectiveSpace * (iNumberOfColumnsForHorizontalCaptions - 1)
                If iAvailableSpaceForTabs >= iAvailableSpaceForTabsPrev Then
                    iAvailableSpaceForTabs = iAvailableSpaceForTabsPrev
                    Exit Do
                End If
            Loop
            If iHCColumnsTry < 1 Then iHCColumnsTry = 1
            ' The columns are evened out by extent: the narrowest room that still packs into the
            ' columns pass one counted. Chosen against closing a column once it reached the average
            ' extent, which let the first ones overfill and left the last with one tab or none
            iBalLoHC = 1
            iBalHiHC = iAvailableSpaceForTabs
            Do While iBalLoHC < iBalHiHC
                iBalMidHC = (iBalLoHC + iBalHiHC) \ 2
                If HCPackColumns(iBalMidHC, False, iTabHeight) <= iHCColumnsTry Then
                    iBalHiHC = iBalMidHC
                Else
                    iBalLoHC = iBalMidHC + 1
                End If
            Loop
            mRows = HCPackColumns(iBalLoHC, True, iTabHeight)
            If mRows < 1 Then mRows = 1
            iNumberOfColumnsForHorizontalCaptions = mRows
            For t = 0 To mTabs - 1
                If mTabData(t).Visible Then iLastVisibleTab = t
            Next t
        Else
        Do
            iMaxTabsPerColumn = Int((iAvailableSpaceForTabs + mTabSeparation2) / (iTabHeight + mTabSeparation2))
            If iMaxTabsPerColumn = 0 Then
                ' Not even one tab fits along the whole strip.
                iMaxTabsPerColumn = 1
                iNumberOfColumnsForHorizontalCaptions = mVisibleTabs
                Exit Do
            End If
            ' Count only visible tabs: hidden entries (e.g. closed TDI forms) must not
            ' inflate the column count / tabs-per-column math
            iNumberOfColumnsForHorizontalCaptions = Int(mVisibleTabs / iMaxTabsPerColumn) + IIf(Int(mVisibleTabs / iMaxTabsPerColumn) < (mVisibleTabs / iMaxTabsPerColumn), 1, 0)
            
            iAvailableSpaceForTabsPrev = iAvailableSpaceForTabs
            iAvailableSpaceForTabs = (iScaleWidthForTabs - RowLostToEdges()) - iRowPerspectiveSpace * (iNumberOfColumnsForHorizontalCaptions - 1) ' - mTabSeparation2 * iMaxTabsPerColumn
            If iAvailableSpaceForTabs >= iAvailableSpaceForTabsPrev Then
                iAvailableSpaceForTabs = iAvailableSpaceForTabsPrev
                Exit Do
            End If
        Loop
        If iNumberOfColumnsForHorizontalCaptions = 0 Then iNumberOfColumnsForHorizontalCaptions = 1
        iTabsPerColumn = Int(mVisibleTabs / iNumberOfColumnsForHorizontalCaptions) + IIf(mVisibleTabs / iNumberOfColumnsForHorizontalCaptions > Int(mVisibleTabs / iNumberOfColumnsForHorizontalCaptions), 1, 0)
        mRows = iNumberOfColumnsForHorizontalCaptions
        
        iRow = 0
        iPosH = 0
        ctv = 0
        iPrevVisibleTabHC = -1
        For t = 0 To mTabs - 1
            If mTabData(t).Visible Then
                ctv = ctv + 1
                iLastVisibleTab = t
                mTabData(t).LeftTab = False
                mTabData(t).RightTab = False
                iPosH = iPosH + 1
                If iPosH > iTabsPerColumn Then
                    iPosH = 1
                    iRow = iRow + 1
                    ' Previous VISIBLE tab, not previous array index (hidden tabs in between)
                    mTabData(iPrevVisibleTabHC).RightTab = True
                End If
                mTabData(t).PosH = iPosH
                mTabData(t).Row = iRow
                If iPosH = 1 Then
                    mTabData(t).LeftTab = True
                End If
                If (ctv = mVisibleTabs) Then
                    mTabData(t).RightTab = True
                End If
                iPrevVisibleTabHC = t
            Else
                mTabData(t).Row = -1
            End If
        Next
        End If
        End If
    ElseIf (mTabWidthStyle2 <> ntTWTabStripEmulation) And (mTabWidthStyle2 <> ntTWStretchToFill) Then
        If (mTabWidthStyle2 = ntTWTabCaptionWidthFillRows) Then
            iTotalTabWidth = 0
            For t = 0 To mTabs - 1
                If mTabData(t).Visible Then
                    iTotalTabWidth = iTotalTabWidth + mTabData(t).IconAndCaptionWidth + 2 * mTabPaddingWidthDPIScaled + mTabSeparation2
                End If
            Next
            iAvailableSpaceForTabs = (iScaleWidthForTabs - RowLostToEdges())
            ReDim iRowIsFilled(0)
            Do
                ' The same room the width sharing hands out, and not iAvailableSpaceForTabs raw.
                iRowRoom = iAvailableSpaceForTabs
                iRow = 0
                iPosH = 0
                ctv = 0
                iAccumulatedTabWith = 0
                iAccumulatedAdditionalFixedTabSpace = 0
                iPrevVisibleTabFillRows = -1
                For t = 0 To mTabs - 1
                    If mTabData(t).Visible Then
                        mTabData(t).TopTab = False
                        ctv = ctv + 1
                        iLastVisibleTab = t
                        mTabData(t).LeftTab = False
                        mTabData(t).RightTab = False
                        iPosH = iPosH + 1
                        If Not iPosH = 1 Then ' if not the first tab already exceeds the available width
                            If (iAccumulatedTabWith + iAccumulatedAdditionalFixedTabSpace + mTabData(t).IconAndCaptionWidth + 2 * mTabPaddingWidthDPIScaled) > iRowRoom Then
                                iPosH = 1
                                If iRow > UBound(iRowIsFilled) Then
                                    ReDim Preserve iRowIsFilled(iRow)
                                End If
                                iRowIsFilled(iRow) = True
                                iRow = iRow + 1
                                iAccumulatedTabWith = 0
                                iAccumulatedAdditionalFixedTabSpace = 0
                                ' The tab that closes the previous row is the previous VISIBLE tab,
                                ' not the previous array index: with hidden tabs in between (e.g.
                                mTabData(iPrevVisibleTabFillRows).RightTab = True
                            End If
                        End If
                        iAccumulatedTabWith = iAccumulatedTabWith + mTabData(t).IconAndCaptionWidth
                        iAccumulatedAdditionalFixedTabSpace = iAccumulatedAdditionalFixedTabSpace + 2 * mTabPaddingWidthDPIScaled + mTabSeparation2
                        mTabData(t).PosH = iPosH
                        If iPosH = 1 Then
                            mTabData(t).LeftTab = True
                        End If
                        If (ctv = mVisibleTabs) Then
                            mTabData(t).RightTab = True
                        End If
                        mTabData(t).Row = iRow
                        iPrevVisibleTabFillRows = t
                    Else
                        mTabData(t).Row = -1
                    End If
                Next t
                mRows = iRow + 1
                
                iAvailableSpaceForTabsPrev = iAvailableSpaceForTabs
                iAvailableSpaceForTabs = (iScaleWidthForTabs - RowLostToEdges()) - iRowPerspectiveSpace * (mRows - 1)
                If iAvailableSpaceForTabs = iAvailableSpaceForTabsPrev Then Exit Do
                ReDim iRowIsFilled(mRows - 1)
            Loop
            If UBound(iRowIsFilled) <> mRows - 1 Then
                ReDim Preserve iRowIsFilled(mRows - 1)
            End If
            
            For r = 0 To mRows - 1
                If iRowIsFilled(r) Then
                    iTotalRowWidth = 0
                    For t = 0 To mTabs - 1
                        If mTabData(t).Row = r Then
                            iTotalRowWidth = iTotalRowWidth + mTabData(t).IconAndCaptionWidth '+ 10 + mTabSeparation2
                        End If
                    Next
                    iTotalRowWidth = iTotalRowWidth + 2 * mTabPaddingWidthDPIScaled + mTabSeparation2
#If ROWWIDTHDIAG_RWDIAG = 1 Then ' TEMP diagnostic
                    If (mRowWidthDiagCount < 200) And mAmbientUserMode Then
                        mRowWidthDiagCount = mRowWidthDiagCount + 1
                        Debug.Print "RWDIAG ratio fillrows row="; r;
                        Debug.Print " ratio="; RowStretchRatio(iAvailableSpaceForTabs, iTotalRowWidth);
                        Debug.Print " avail="; iAvailableSpaceForTabs;
                        Debug.Print " totalRowWidth="; iTotalRowWidth
                    End If
#End If
                    For t = 0 To mTabs - 1
                        iRowStretchRatio = RowStretchRatio(iAvailableSpaceForTabs, iTotalRowWidth)
                        If mTabData(t).Row = r Then
                            ' A tab with TabFixedWidth is out of the sharing: it keeps its width and
                            ' the rest stretch. Same rule at the other three sites that scale this field
                            If mTabData(t).FixedWidth = 0 Then
                                'mTabData(t).Width = mTabData(t).IconAndCaptionWidth * iRowStretchRatio   '- 10 - mTabSeparation2
                                mTabData(t).IconAndCaptionWidth = mTabData(t).IconAndCaptionWidth * iRowStretchRatio - 1 '+ 10 + mTabSeparation2
                            End If
                        End If
                    Next
                End If
            Next
        Else
            iRow = 0
            iPosH = 0
            ctv = 0
            For t = 0 To mTabs - 1
                If mTabData(t).Visible Then
                    mTabData(t).TopTab = False
                    ctv = ctv + 1
                    iLastVisibleTab = t
                    mTabData(t).LeftTab = False
                    mTabData(t).RightTab = False
                    iPosH = iPosH + 1
                    If iPosH > iTabsPerRowLayout Then
                        iPosH = 1
                        iRow = iRow + 1
                    End If
                    mTabData(t).PosH = iPosH
                    If iPosH = 1 Then
                        mTabData(t).LeftTab = True
                    End If
                    If (iPosH = iTabsPerRowLayout) Or (ctv = mVisibleTabs) Then
                        mTabData(t).RightTab = True
                    End If
                    mTabData(t).Row = iRow
                Else
                    mTabData(t).Row = -1
                End If
            Next t
            mRows = iRow + 1
        End If
    Else
        ' define what tabs to place on each row when tabs are justified
        ' step 1: calculate the number of rows that will be needed and the iRowsStretchRatio for each row (that will be needed in the step 2)
        iARPSTmp = 0
        Do
            iAllRowsPerspectiveSpace = iARPSTmp
            iAvailableSpaceForTabs = (iScaleWidthForTabs - iAllRowsPerspectiveSpace - RowLostToEdges())
            iAccumulatedTabWith = 0
            iAccumulatedAdditionalFixedTabSpace = 0
            iRow = 0
            ReDim iRowsStretchRatio(0)
            iRowsStretchRatio_StartingRow = 0
            iRowsStretchRatio_AccumulatedTabWidth = 0
            iRowsStretchRatio_AccumulatedAdditionalFixedTabWidth = 0
            iRowTabCount = 0
            For t = 0 To mTabs - 1
                If mTabData(t).Visible Then
                    If (iAccumulatedTabWith + iAccumulatedAdditionalFixedTabSpace + mTabData(t).IconAndCaptionWidth + 2 * mTabPaddingWidthDPIScaled) > iAvailableSpaceForTabs Then
                        If iRowTabCount = 0 Then ' this only tab alone passes the available space in the row (and it is the first one or all the previous tabs also entered here)
                            If t < (mTabs - 1) Then
                                iRowsStretchRatio(iRow) = 1
                                iRow = iRow + 1
                                iRowsStretchRatio_StartingRow = iRow
                                iRowsStretchRatio_AccumulatedTabWidth = 0
                                iRowsStretchRatio_AccumulatedAdditionalFixedTabWidth = 0
                                ReDim Preserve iRowsStretchRatio(iRow)
                            End If
                            iRowTabCount = 0
                            iAccumulatedTabWith = 0
                            iAccumulatedAdditionalFixedTabSpace = 0
                        ElseIf iRowTabCount = 1 Then ' this only tab alone passes the available space in the row (and it comes from a previus attempt to put it in the previous row)
                            iSng = RowStretchRatio((iRow - iRowsStretchRatio_StartingRow) * iAvailableSpaceForTabs - iRowsStretchRatio_AccumulatedAdditionalFixedTabWidth, iRowsStretchRatio_AccumulatedTabWidth)
                            If iSng < 1 Then
                                iDoNotDecreaseStretchRatio = True
                                iSng = 1
                            End If
                            For r = iRowsStretchRatio_StartingRow To iRow - 1
                                iRowsStretchRatio(r) = iSng
                            Next r
                            iRowsStretchRatio(iRow) = 1
                            iRow = iRow + 1
                            iRowsStretchRatio_StartingRow = iRow
                            ReDim Preserve iRowsStretchRatio(iRow)
                            iRowTabCount = 1
                            iAccumulatedTabWith = mTabData(t).IconAndCaptionWidth
                            iAccumulatedAdditionalFixedTabSpace = 2 * mTabPaddingWidthDPIScaled + mTabSeparation2
                            iRowsStretchRatio_AccumulatedTabWidth = iAccumulatedTabWith
                            iRowsStretchRatio_AccumulatedAdditionalFixedTabWidth = iAccumulatedAdditionalFixedTabSpace
                        Else
                            iRow = iRow + 1
                            ReDim Preserve iRowsStretchRatio(iRow)
                            iRowTabCount = 1
                            iAccumulatedTabWith = mTabData(t).IconAndCaptionWidth
                            iAccumulatedAdditionalFixedTabSpace = 2 * mTabPaddingWidthDPIScaled + mTabSeparation2
                            iRowsStretchRatio_AccumulatedTabWidth = iRowsStretchRatio_AccumulatedTabWidth + iAccumulatedTabWith
                            iRowsStretchRatio_AccumulatedAdditionalFixedTabWidth = iRowsStretchRatio_AccumulatedAdditionalFixedTabWidth + iAccumulatedAdditionalFixedTabSpace
                        End If
                    Else
                        iAccumulatedTabWith = iAccumulatedTabWith + mTabData(t).IconAndCaptionWidth
                        iAccumulatedAdditionalFixedTabSpace = iAccumulatedAdditionalFixedTabSpace + 2 * mTabPaddingWidthDPIScaled + mTabSeparation2
                        iRowsStretchRatio_AccumulatedTabWidth = iRowsStretchRatio_AccumulatedTabWidth + mTabData(t).IconAndCaptionWidth
                        iRowsStretchRatio_AccumulatedAdditionalFixedTabWidth = iRowsStretchRatio_AccumulatedAdditionalFixedTabWidth + 2 * mTabPaddingWidthDPIScaled + mTabSeparation2
                        iRowTabCount = iRowTabCount + 1
                    End If
                End If
            Next t
            If iRowsStretchRatio_AccumulatedTabWidth > 0 Then
                iSng = RowStretchRatio((iRow - iRowsStretchRatio_StartingRow + 1) * iAvailableSpaceForTabs - iRowsStretchRatio_AccumulatedAdditionalFixedTabWidth, iRowsStretchRatio_AccumulatedTabWidth)
                If iSng < 1 Then
                    iDoNotDecreaseStretchRatio = True
                    iSng = 1
                End If
                For r = iRowsStretchRatio_StartingRow To iRow
                    iRowsStretchRatio(r) = iSng
                Next r
            End If
            mRows = iRow + 1
            iARPSTmp = (mRows - 1) * iRowPerspectiveSpace
            If Not mShowsRowsPerspective2 Then
                iAllRowsPerspectiveSpace = iARPSTmp
                Exit Do
            End If
        Loop Until iARPSTmp = iAllRowsPerspectiveSpace ' until it did not add another row
        
        ' step 2: set in what row goes each tab
        iDecreaseStretchRatio = False
        iIncreaseStretchRatio = False
        iDoNotDecreaseStretchRatio2 = False
        iStretchIncreases = 0
        Do
            iRowTabCount = 0
            iAccumulatedTabWith = 0
            iRow = 0
            ctv = 0
            If iDecreaseStretchRatio Then
                For r = 0 To mRows - 1
                    iRowsStretchRatio(r) = iRowsStretchRatio(r) * 0.95
                    If iRowsStretchRatio(r) < 1 Then
                        iRowsStretchRatio(r) = 1
                        iDoNotDecreaseStretchRatio2 = True
                    End If
                Next r
                iDecreaseStretchRatio = False
            ElseIf iIncreaseStretchRatio Then
                For r = 0 To mRows - 1
                    iRowsStretchRatio(r) = iRowsStretchRatio(r) * 1.05
                Next r
                iStretchIncreases = iStretchIncreases + 1
                iIncreaseStretchRatio = False
            End If
            iLastVisibleTab_Prev = -1
            For t = 0 To mTabs - 1
                If mTabData(t).Visible Then
                    mTabData(t).TopTab = False
                    ctv = ctv + 1
                    iLastVisibleTab_Prev = iLastVisibleTab
                    iLastVisibleTab = t
                    mTabData(t).LeftTab = False
                    mTabData(t).RightTab = False
                    If ctv = mVisibleTabs Then
                        mTabData(t).RightTab = True
                    End If
                    If mTabData(t).FixedWidth = 0 Then
                        iLng = mTabData(t).IconAndCaptionWidth * iRowsStretchRatio(iRow) + 2 * mTabPaddingWidthDPIScaled
                    Else
                        iLng = mTabData(t).IconAndCaptionWidth + 2 * mTabPaddingWidthDPIScaled
                    End If
                    If mTabData(t).FixedWidth = 0 Then
                        iFitTolerance = mTabData(t).IconAndCaptionWidth * 0.38
                    Else
                        ' a fixed width is not shrunk by step 3, so it gets no tolerance
                        iFitTolerance = 0
                    End If
                    If iAccumulatedTabWith + iLng > (iAvailableSpaceForTabs + iFitTolerance) Then ' 0.38 is an add-hoc value, the right thing to do would be to make another step and recalculate everything several times changing the stretch ratio until an equilibrium point is found (or something like that). But with a couple of examples it seems too work acceptable with this value of 0.38. If there are too many tabs or too few tabs in the top row, here is the problem (probably).
                        If iRowTabCount = 0 Then ' this only tab alone passes the available space in the row (and it is the first one or all the previous tabs also entered here)
                            mTabData(t).Row = iRow
                            mTabData(t).PosH = 1
                            mTabData(t).LeftTab = True
                            mTabData(t).RightTab = True
                            If (iRow + 1) < mRows Then
                                iRow = iRow + 1
                            End If
                            iRowTabCount = 0
                            iAccumulatedTabWith = 0
                        Else
                            If (iRow + 1) < mRows Then
                                If iLastVisibleTab_Prev <> t Then
                                    mTabData(iLastVisibleTab_Prev).RightTab = True
                                End If
                                iRow = iRow + 1
                                iRowTabCount = 1
                                iAccumulatedTabWith = iLng + mTabSeparation2
                            Else
                                iRowTabCount = iRowTabCount + 1
                            End If
                            mTabData(t).PosH = iRowTabCount
                            If iRowTabCount = 1 Then
                                mTabData(t).LeftTab = True
                            End If
                            mTabData(t).Row = iRow
                        End If
                    Else
                        iAccumulatedTabWith = iAccumulatedTabWith + iLng + mTabSeparation2
                        iRowTabCount = iRowTabCount + 1
                        mTabData(t).PosH = iRowTabCount
                        If iRowTabCount = 1 Then
                            mTabData(t).LeftTab = True
                        End If
                        mTabData(t).Row = iRow
                    End If
                Else
                    mTabData(t).Row = -1
                End If
            Next t
            mTabData(iLastVisibleTab).PosH = iRowTabCount
            If iRowTabCount = 1 Then
                mTabData(iLastVisibleTab).LeftTab = True
            End If
            mTabData(iLastVisibleTab).RightTab = True
            
            ' step 2-bis: the spare tab goes to the FRONT row, not to the back one.
            If (mTabWidthStyle2 = ntTWTabStripEmulation) Or (mTabWidthStyle2 = ntTWStretchToFill) Then
                ' The sweep repeats until nothing moves.
                Do
                    iBalMoved = False
                    For iBalRow = 0 To mRows - 2
                        Do
                            iBalCountThis = 0
                            iBalCountNext = 0
                            iBalWidth = 0
                            iBalFirstNext = -1
                            For iBalTab = 0 To mTabs - 1
                                If mTabData(iBalTab).Row = iBalRow Then
                                    iBalCountThis = iBalCountThis + 1
                                    iBalWidth = iBalWidth + mTabData(iBalTab).IconAndCaptionWidth + 2 * mTabPaddingWidthDPIScaled + mTabSeparation2
                                ElseIf mTabData(iBalTab).Row = (iBalRow + 1) Then
                                    iBalCountNext = iBalCountNext + 1
                                    If iBalFirstNext = -1 Then iBalFirstNext = iBalTab
                                End If
                            Next iBalTab
                            If iBalCountNext <= iBalCountThis Then Exit Do
                            If iBalFirstNext = -1 Then Exit Do
                            iBalWidth = iBalWidth + mTabData(iBalFirstNext).IconAndCaptionWidth + 2 * mTabPaddingWidthDPIScaled
                            If iBalWidth > iAvailableSpaceForTabs Then Exit Do
                            mTabData(iBalFirstNext).Row = iBalRow
                            iBalMoved = True
                        Loop
                    Next iBalRow
                Loop While iBalMoved
                ' PosH, LeftTab and RightTab were written by step 2 against the old rows, so
                ' they are rebuilt from .Row rather than patched at the two ends that moved
                For iBalRow = 0 To mRows - 1
                    iBalPosH = 0
                    iBalLast = -1
                    For iBalTab = 0 To mTabs - 1
                        If mTabData(iBalTab).Row = iBalRow Then
                            iBalPosH = iBalPosH + 1
                            mTabData(iBalTab).PosH = iBalPosH
                            mTabData(iBalTab).LeftTab = (iBalPosH = 1)
                            mTabData(iBalTab).RightTab = False
                            iBalLast = iBalTab
                        End If
                    Next iBalTab
                    If iBalLast >= 0 Then mTabData(iBalLast).RightTab = True
                Next iBalRow
            End If
            
            If (mRows = 1) And (mTabWidthStyle2 <> ntTWStretchToFill) Then
                mTabWidthStyle2 = ntTWTabCaptionWidth
            End If
            If (mTabWidthStyle2 = ntTWTabStripEmulation) Or (mTabWidthStyle2 = ntTWStretchToFill) Then
                ' step 3: set the widths of the tabs for each row
                For iRow = 0 To mRows - 1
                    iAccumulatedTabWith = 0
                    iAccumulatedAdditionalFixedTabSpace = 0
                    iRowTabCount = 0
                    For t = 0 To mTabs - 1
                        If mTabData(t).Row = iRow Then
                            ' a fixed width is not stretched, so it counts as fixed space and the ratio is over the free tabs only
                            If mTabData(t).FixedWidth = 0 Then
                                iAccumulatedTabWith = iAccumulatedTabWith + mTabData(t).IconAndCaptionWidth
                            Else
                                iAccumulatedAdditionalFixedTabSpace = iAccumulatedAdditionalFixedTabSpace + mTabData(t).IconAndCaptionWidth
                            End If
                            iAccumulatedAdditionalFixedTabSpace = iAccumulatedAdditionalFixedTabSpace + 2 * mTabPaddingWidthDPIScaled + mTabSeparation2
                            iRowTabCount = iRowTabCount + 1
                        End If
                    Next t
                    If iRowTabCount > 1 Then
                        iAccumulatedAdditionalFixedTabSpace = iAccumulatedAdditionalFixedTabSpace - mTabSeparation2
                        ' This is the one that raised error 11: a row with more than one tab and no
                        ' accumulated caption width at all.
                        iSng = RowStretchRatio(iAvailableSpaceForTabs - iAccumulatedAdditionalFixedTabSpace, iAccumulatedTabWith)
                        If iSng < 1 Then
                            If Not (iDoNotDecreaseStretchRatio Or iDoNotDecreaseStretchRatio2) Then
                                iDecreaseStretchRatio = True
                                Exit For
                            End If
                        End If
                    Else
                        iSng = RowStretchRatio(iAvailableSpaceForTabs - iAccumulatedAdditionalFixedTabSpace, iAccumulatedTabWith)
                    End If
#If ROWWIDTHDIAG_RWDIAG = 1 Then ' TEMP diagnostic
                    If (mRowWidthDiagCount < 200) And mAmbientUserMode Then
                        mRowWidthDiagCount = mRowWidthDiagCount + 1
                        Debug.Print "RWDIAG ratio step3 row="; iRow;
                        Debug.Print " ratio="; iSng;
                        Debug.Print " avail="; iAvailableSpaceForTabs;
                        Debug.Print " accumW="; iAccumulatedTabWith;
                        Debug.Print " accumFixedSpace="; iAccumulatedAdditionalFixedTabSpace;
                        Debug.Print " tabsInRow="; iRowTabCount
                    End If
#End If
                    ' The native TabStrip does not scale the captions: it hands every tab of the row the
                    ' same extra and the leftover pixels go one each to the first tabs
                    iRowFreeTabs = 0
                    If (mTabWidthStyle2 = ntTWTabStripEmulation) And (iSng >= 1) Then
                        For t = 0 To mTabs - 1
                            If mTabData(t).Row = iRow Then
                                If mTabData(t).FixedWidth = 0 Then iRowFreeTabs = iRowFreeTabs + 1
                            End If
                        Next t
                    End If
                    If iRowFreeTabs > 0 Then
                        iRowExtra = iAvailableSpaceForTabs - iAccumulatedAdditionalFixedTabSpace - iAccumulatedTabWith
                        If iRowExtra < 0 Then iRowExtra = 0
                        iRowExtraLeft = iRowExtra Mod iRowFreeTabs
                        iRowExtra = iRowExtra \ iRowFreeTabs
                    End If
                    For t = 0 To mTabs - 1
                        If mTabData(t).Row = iRow Then
                            If mTabData(t).FixedWidth <> 0 Then
                                mTabData(t).Width = mTabData(t).IconAndCaptionWidth
                            ElseIf iRowFreeTabs > 0 Then
                                mTabData(t).Width = mTabData(t).IconAndCaptionWidth + iRowExtra
                                If iRowExtraLeft > 0 Then
                                    mTabData(t).Width = mTabData(t).Width + 1
                                    iRowExtraLeft = iRowExtraLeft - 1
                                End If
                            Else
                                mTabData(t).Width = mTabData(t).IconAndCaptionWidth * iSng
                            End If
                        End If
                    Next t
                Next iRow
            End If
            
            For iRow = mRows - 1 To 1 Step -1
                iLng = 0
                For t = 0 To mTabs - 1
                    If mTabData(t).Row = iRow Then
                        iLng = iLng + 1
                        Exit For
                    End If
                Next t
                ' the ratio has no effect on fixed-width tabs, so it is capped instead of growing until overflow
                If (iLng = 0) And (iStretchIncreases < 100) Then
                    iIncreaseStretchRatio = True
                End If
            Next iRow
        Loop While (iDecreaseStretchRatio Or iIncreaseStretchRatio) And ((mTabWidthStyle2 = ntTWTabStripEmulation) Or (mTabWidthStyle2 = ntTWStretchToFill))
    End If
    
    ' Nothing is taken off the top of the strip here, and that is a tested decision rather than an
    ' omission.

    ' Rows positions (RowPos = the DISPLAY row, rows rotate so that the selected tab's row ends up
    ' next to the body).
    If mTabData(mTab).Visible Then
        iRowPosBase = mTabData(mTab).Row
    Else
        iRowPosBase = 0
    End If
    If iRowPosBase < 0 Then iRowPosBase = 0
    If iRowPosBase > (mRows - 1) Then iRowPosBase = mRows - 1
    ' Tried on 2026-09-13 and reverted, do not propose again: making ntTWTabStripEmulation ROTATE
    ' instead of inverting, to follow the native CC6 TabStrip.
    For t = 0 To mTabs - 1
        mTabData(t).RowPos = (mRows - mTabData(t).Row - 1) + iRowPosBase
        If mTabData(t).RowPos > (mRows - 1) Then mTabData(t).RowPos = mTabData(t).RowPos - mRows
    Next t
    
    ' The room a tab that shows the extra height highlight needs ABOVE the top row, added once to
    ' the strip instead of to every row cell.
    If iTabRowGrowth > 0 Then
        If mHighlightAddExtraHeight Then
            iTabTopReserve = iTabRowGrowth
        ElseIf mHighlightAddExtraHeightSelectedTab And (mRows = 1) Then
            iTabTopReserve = iTabRowGrowth
        End If
    End If
    
    If mTabsAreRotatedButCaptionsAreHorizontal Then
        ReDim iColumnWidthForHorizontalCaptions(mRows - 1)
        ReDim iColumnLeftForHorizontalCaptions(mRows - 1)
        For iRow = 0 To mRows - 1
            iColumnWidthForHorizontalCaptions(iRow) = 0
            If iRow = 0 Then
                iColumnLeftForHorizontalCaptions(iRow) = iTabTopReserve
            Else
                iColumnLeftForHorizontalCaptions(iRow) = iColumnLeftForHorizontalCaptions(iRow - 1) + iColumnWidthForHorizontalCaptions(iRow - 1)
            End If
            iColumnTabCount = 0
            iLogicalRowHC = -1
            For t = 0 To mTabs - 1
                ' iRow here is the DISPLAY column (RowPos), because iColumnLeft/iColumnWidth are
                ' consumed by the positioning code indexed by RowPos.
                If mTabData(t).Visible And (mTabData(t).RowPos = iRow) Then
                    iLogicalRowHC = mTabData(t).Row
                    iColumnTabCount = iColumnTabCount + 1
                    ' Flat, + 1: the last column's rect stops two short of the body and the others lose
                    ' one under their neighbour, so one more keeps the caption band whole in all of them.
                    If mAppearanceIsFlat Then
                        iLng = mTabData(t).IconAndCaptionWidth + IIf(mFlatBarGripHeightDPIScaled > 0, mFlatBarGripHeightDPIScaled, 0) + mFlatBarHeightDPIScaled + mFlatTabBodyGapDPIScaled + 1
                    Else
                        iLng = mTabData(t).IconAndCaptionWidth
                    End If
                    iLng = iLng + 2 * mTabPaddingWidthDPIScaled
                    ' Plus the extra height, which every tab that is NOT showing that highlight is
                    ' sunk by where the rects are set.
                    iLng = iLng + iTabSinkHeight
                    If iLng > iColumnWidthForHorizontalCaptions(iRow) Then
                        iColumnWidthForHorizontalCaptions(iRow) = iLng
                    End If
                End If
                mTabData(t).TopTab = (iRow = (mRows - 1))
            Next
            If iColumnWidthForHorizontalCaptions(iRow) = 0 Then iColumnWidthForHorizontalCaptions(iRow) = 1600
            If iTabMaxWidth > 0 Then
                If iColumnWidthForHorizontalCaptions(iRow) > iTabMaxWidth Then
                    iColumnWidthForHorizontalCaptions(iRow) = iTabMaxWidth
                End If
            End If
            If iTabMinWidth > 0 Then
                If iColumnWidthForHorizontalCaptions(iRow) < iTabMinWidth Then
                    iColumnWidthForHorizontalCaptions(iRow) = iTabMinWidth
                End If
            End If
#If HORIZCAPTIONDIAG >= 1 Then ' TEMP diagnostic
            If mHorizCaptionDiagCount < 200 Then
                mHorizCaptionDiagCount = mHorizCaptionDiagCount + 1
                Debug.Print "HCDIAG col padW="; mTabPaddingWidth; " padH="; mTabPaddingHeight; " capAlign="; mCaptionAlignment; " isPP="; mAppearanceIsPP; " isFlat="; mAppearanceIsFlat; " themed="; mVisualStylesActive
                Debug.Print "   row="; iRow; " columnWidth="; iColumnWidthForHorizontalCaptions(iRow); " padWScaled="; mTabPaddingWidthDPIScaled; " tabMin="; iTabMinWidth; " tabMax="; iTabMaxWidth; " scaleWidthForTabs="; iScaleWidthForTabs
                Dim iHCDiagTab As Long
                For iHCDiagTab = 0 To mTabs - 1
                    If mTabData(iHCDiagTab).Visible And (mTabData(iHCDiagTab).RowPos = iRow) Then
                        Debug.Print "   tab="; iHCDiagTab; " caption="; mTabData(iHCDiagTab).Caption; " iconAndCaptionWidth="; mTabData(iHCDiagTab).IconAndCaptionWidth; " closeBtnWidth="; mTabData(iHCDiagTab).CloseButtonWidth; " selected="; mTabData(iHCDiagTab).Selected
                    End If
                Next iHCDiagTab
            End If
#End If
            ' The tabs carrying a TabFixedWidth are counted apart and taken out of every calculation
            ' below: they get the extent the developer asked for and the style shares out what is
            ' left among the rest.
            iColOwnWidthHC = 0
            iColFreeCountHC = 0
            iColTabsHC = 0
            For t = 0 To mTabs - 1
                If mTabData(t).Visible And (mTabData(t).RowPos = iRow) Then
                    iColTabsHC = iColTabsHC + 1
                    If mTabData(t).FixedWidth <> 0 Then
                        iOwnExtentHC = pScaleX(mTabData(t).FixedWidth, vbHimetric, vbPixels)
                        iColOwnWidthHC = iColOwnWidthHC + iOwnExtentHC
                        mTabData(t).Width = iOwnExtentHC
                    Else
                        iColFreeCountHC = iColFreeCountHC + 1
                    End If
                End If
            Next t
            If mTabHeightStyleForHorizontal = ntTHFixed Then
                ' Respects TabHeight as-is: each tab gets exactly that extent, no stretching
                iTabHeightForHorizontalCaptions = iTabHeight
                For t = 0 To mTabs - 1
                    If mTabData(t).Visible And (mTabData(t).RowPos = iRow) Then
                        If mTabData(t).FixedWidth = 0 Then
                            mTabData(t).Width = iTabHeightForHorizontalCaptions
                        End If
                    End If
                Next
            ElseIf (mTabHeightStyleForHorizontal = ntTHTabCaptionHeight) Or (mTabHeightStyleForHorizontal = ntTHMaxCaptionHeight) Or (mTabHeightStyleForHorizontal = ntTHStretchToFill) Then
                ' Heights were already measured and packed into columns before this point.
                iColCountHC = 0
                iColSumHC = 0
                iColMaxHC = 0
                For t = 0 To mTabs - 1
                    If mTabData(t).Visible Then
                        If mTabData(t).RowPos = iRow Then
                            If mTabData(t).FixedWidth = 0 Then
                                iColCountHC = iColCountHC + 1
                                iColSumHC = iColSumHC + mTabData(t).Width
                                If mTabData(t).Width > iColMaxHC Then iColMaxHC = mTabData(t).Width
                            End If
                        End If
                    End If
                Next
                If iColCountHC > 0 Then
                    ' Whether the column is FULL depends on its LOGICAL position (only the
                    ' last packed column, Row = mRows - 1, never overflowed), not on where
                    ' it's displayed (RowPos rotates with the selected tab)
                    If mTabHeightStyleForHorizontal = ntTHMaxCaptionHeight Then
                        If iLogicalRowHC < (mRows - 1) Then
                            ' Full column: evening out and stretching in one shot, over the same
                            ' room the packing admitted. See RowLostToEdges
                            iTabHeightForHorizontalCaptions = (iAvailableSpaceForTabs - (iColTabsHC - 1) * mTabSeparation2 - iColOwnWidthHC) / iColCountHC
                        Else
                            iTabHeightForHorizontalCaptions = iColMaxHC
                        End If
                        If iTabHeightForHorizontalCaptions < 1 Then iTabHeightForHorizontalCaptions = 1
                        For t = 0 To mTabs - 1
                            If mTabData(t).Visible And (mTabData(t).RowPos = iRow) Then
                                If mTabData(t).FixedWidth = 0 Then
                                    mTabData(t).Width = iTabHeightForHorizontalCaptions
                                End If
                            End If
                        Next
                    Else
                        If (iLogicalRowHC < (mRows - 1)) Or iStretchToFillHC Then
                            ' Full column: split the leftover evenly among its tabs, over the same
                            ' room the packing admitted. See RowLostToEdges.
                            iShareHC = ((iAvailableSpaceForTabs - (iColTabsHC - 1) * mTabSeparation2 - iColOwnWidthHC) - iColSumHC) \ iColCountHC
                            For t = 0 To mTabs - 1
                                If mTabData(t).Visible Then
                                    If mTabData(t).RowPos = iRow Then
                                        If mTabData(t).FixedWidth = 0 Then
                                            mTabData(t).Width = mTabData(t).Width + iShareHC
                                            If mTabData(t).Width < 1 Then mTabData(t).Width = 1
                                        End If
                                    End If
                                End If
                            Next
                        End If
                    End If
                End If
            Else ' ntTHFill: stretch to fill all available space
                If iColFreeCountHC > 0 Then
                    ' Handed out against a running total instead of giving every tab the same
                    ' rounded number, so the column ends exactly where the strip does.
                    iHCFreeSpace = iAvailableSpaceForTabs - (iColumnTabCount - 1) * mTabSeparation2 - iColOwnWidthHC
                    If iHCFreeSpace < iColFreeCountHC Then iHCFreeSpace = iColFreeCountHC
                    iColRunningEdgeHC = 0
                    iColGivenHC = 0
                    For t = 0 To mTabs - 1
                        If mTabData(t).Visible And (mTabData(t).RowPos = iRow) Then
                            If mTabData(t).FixedWidth = 0 Then
                                iColRunningEdgeHC = iColRunningEdgeHC + iHCFreeSpace / iColFreeCountHC
                                iColTabExtentHC = Int(iColRunningEdgeHC + 0.5) - iColGivenHC
                                If iColTabExtentHC < 1 Then iColTabExtentHC = 1
                                mTabData(t).Width = iColTabExtentHC
                                iColGivenHC = iColGivenHC + iColTabExtentHC
                            End If
                        End If
                    Next
                End If
            End If
        Next
    End If
    
    ' Body position
    ' Nothing is added for the extra height: the row keeps its height and the tabs that are not
    ' showing the highlight are sunk into it
    ' The two rows below the last tab row are where the 3D styles draw the body's top edge. Flat
    ' draws its edge on mBodyStart itself, so there they come off the body start and off the
    ' last row's rects, and the body also starts right where those rects end.
    If mAppearanceIsFlat Then iFlatBodyGapTrim = 2 Else iFlatBodyGapTrim = 0
    If mTabsAreRotatedButCaptionsAreHorizontal Then
        mBodyStart = 2 + iTabTopReserve
        For iRow = 0 To mRows - 1
            mBodyStart = mBodyStart + iColumnWidthForHorizontalCaptions(iRow)
        Next
    Else
        ' The strip is iTabExtraHeight taller with Style TabStrip, and that extra is what makes the
        ' LAST row the same height as the others.
        If mStyle = ntStyleTabStrip Then
            mBodyStart = mRows * iTabHeight + 2 + iTabSinkHeight + iTabTopReserve
        Else
            mBodyStart = mRows * iTabHeight + 2 + iTabTopReserve
        End If
    End If
    If mAppearanceIsFlat And (mHighlightFlatBarWithGrip Or mHighlightFlatBarWithGripSelectedTab) Then
        If mOrientationIsBottom Then
            If (mFlatBarPosition = ntBarPositionBottom) And (mFlatBarGripHeightDPIScaled > 0) Then
                mBodyStart = mBodyStart + mFlatBarGripHeightDPIScaled
            End If
        Else
            If (mFlatBarPosition = ntBarPositionTop) And (mFlatBarGripHeightDPIScaled > 0) Then
                mBodyStart = mBodyStart + mFlatBarGripHeightDPIScaled
            End If
        End If
    End If
    mBodyStart = mBodyStart - 2 * iFlatBodyGapTrim
    mBodyHeight = iScaleHeight - mBodyStart + 2 '+ 1
    
    If mRows > 1 Then
        iAllRowsPerspectiveSpace = iRowPerspectiveSpace * (mRows - 1)
    End If
    ' mBodyWidth is the full width the body occupies, border included.
    mBodyWidth = iScaleWidth - iAllRowsPerspectiveSpace '- 1
    
    Select Case mTabOrientation
        Case ssTabOrientationTop, ntTabOrientationTopRight
            mBodyRect.Top = mBodyStart
            mBodyRect.Left = 2
            mBodyRect.Bottom = mScaleHeight - 4
            mBodyRect.Right = mBodyWidth - 4
        Case ssTabOrientationBottom, ntTabOrientationBottomRight
            mBodyRect.Top = 0 '2
            mBodyRect.Left = 2
            mBodyRect.Bottom = mBodyHeight - 6 '4
            mBodyRect.Right = mBodyWidth - 4
        Case ssTabOrientationLeft, ntTabOrientationLeftTop, ntTabOrientationLeftHorizontal, ntTabOrientationLeftBottomHorizontal
            mBodyRect.Top = mScaleHeight - mBodyWidth '+ 2
            mBodyRect.Left = mBodyStart + 2
            mBodyRect.Bottom = mScaleHeight - 4
            mBodyRect.Right = mScaleWidth - 4
        Case Else ' ssTabOrientationRight, ntTabOrientationRightBottom, ntTabOrientationRightHorizontal, ntTabOrientationRightBottomHorizontal
            mBodyRect.Top = 0 '2
            mBodyRect.Left = 2
            mBodyRect.Bottom = mBodyWidth - 4
            mBodyRect.Right = mBodyHeight - 6 '4
    End Select
    If mAppearanceIsFlat Then
        mBodyRect.Left = mBodyRect.Left - 1
        mBodyRect.Top = mBodyRect.Top + 1
        mBodyRect.Right = mBodyRect.Right + 2
        mBodyRect.Bottom = mBodyRect.Bottom + 2
    End If
    
    If (mTabWidthStyle2 = ntTWTabCaptionWidth) Or (mTabWidthStyle2 = ntTWTabCaptionWidthFillRows) Then
        iAvailableSpaceForTabs = (iScaleWidthForTabs - iAllRowsPerspectiveSpace - RowLostToEdges())
        For iRow = 0 To mRows - 1
            iAccumulatedTabWith = 0
            iAccumulatedAdditionalFixedTabSpace = 0
            iAccumulatedFixedTabWidth = 0
            For t = 0 To mTabs - 1
                If mTabData(t).Row = iRow Then
                    iAccumulatedTabWith = iAccumulatedTabWith + mTabData(t).IconAndCaptionWidth
                    ' What the tabs with a TabFixedWidth hold is counted apart, because it comes
                    ' out of BOTH ends of the ratio below: they are not shrunk, so their width is
                    ' room the others do not have, and it must not sit in the denominator either
                    If mTabData(t).FixedWidth <> 0 Then
                        iAccumulatedFixedTabWidth = iAccumulatedFixedTabWidth + mTabData(t).IconAndCaptionWidth
                    End If
                    iAccumulatedAdditionalFixedTabSpace = iAccumulatedAdditionalFixedTabSpace + 2 * mTabPaddingWidthDPIScaled
                    If Not mTabData(t).RightTab Then
                        iAccumulatedAdditionalFixedTabSpace = iAccumulatedAdditionalFixedTabSpace + mTabSeparation2
                    End If
                End If
            Next t
            ' The room the row really has. Sharing out more makes the right edge snap narrow the last tab;
            ' sharing out less declares a row that fits as overflowing. See RowLostToEdges
            iRowRoom = iAvailableSpaceForTabs
            iRowNeedsSharing = (iAccumulatedTabWith + iAccumulatedAdditionalFixedTabSpace > iRowRoom)
            ' A filled row of FillRows is shared out here even when the stretch above left it short:
            ' that stretch only approximates, and this is the pass that makes the row end on the edge.
            If (Not iRowNeedsSharing) And (mTabWidthStyle2 = ntTWTabCaptionWidthFillRows) And (Not mTabsAreRotatedButCaptionsAreHorizontal) Then
                If iRow <= UBound(iRowIsFilled) Then iRowNeedsSharing = iRowIsFilled(iRow)
            End If
            If iRowNeedsSharing Then
                ' Reachable with a zero denominator by the same route as the one in step 3, and by
                ' one more of its own: the condition is satisfied by the fixed space alone, so a
                ' row whose captions measure nothing still walks in here
                iSng = RowStretchRatio(iRowRoom - iAccumulatedAdditionalFixedTabSpace - iAccumulatedFixedTabWidth, iAccumulatedTabWith - iAccumulatedFixedTabWidth)
                ' Not for the four *Horizontal.
#If ROWWIDTHDIAG_RWDIAG = 1 Then ' TEMP diagnostic
                If (mRowWidthDiagCount < 200) And mAmbientUserMode Then
                    mRowWidthDiagCount = mRowWidthDiagCount + 1
                    Debug.Print "RWDIAG ratio shrink row="; iRow;
                    Debug.Print " ratio="; iSng;
                    Debug.Print " avail="; iAvailableSpaceForTabs;
                    Debug.Print " room="; iRowRoom;
                    Debug.Print " lostEdges="; RowLostToEdges();
                    Debug.Print " accumW="; iAccumulatedTabWith;
                    Debug.Print " accumFixedSpace="; iAccumulatedAdditionalFixedTabSpace;
                    Debug.Print " rotatedHoriz="; mTabsAreRotatedButCaptionsAreHorizontal
                End If
#End If
                If Not mTabsAreRotatedButCaptionsAreHorizontal Then
                    ' Handed out against a running total instead of rounding each width on its own.
                    iRowTargetWidth = 0
                    iRowGivenWidth = 0
                    For t = 0 To mTabs - 1
                        If mTabData(t).Row = iRow Then
                            If mTabData(t).FixedWidth = 0 Then
                                iRowTargetWidth = iRowTargetWidth + mTabData(t).IconAndCaptionWidth * iSng
                            Else
                                ' Fixed is fixed: it walks through the sharing carrying its own width
                                iRowTargetWidth = iRowTargetWidth + mTabData(t).IconAndCaptionWidth
                            End If
                            iRowTabWidth = Int(iRowTargetWidth + 0.5) - iRowGivenWidth
                            If iRowTabWidth < 0 Then iRowTabWidth = 0
                            mTabData(t).IconAndCaptionWidth = iRowTabWidth
                            iRowGivenWidth = iRowGivenWidth + iRowTabWidth
                        End If
                    Next t
                End If
            End If
        Next iRow
    End If
    
    ' minimum size
    If (mUserControlSizeCorrectionsCounter < 3) And (Not mAmbientUserMode) Then
        If (mUserControlSizeCorrectionsCounter_ScaleWidthNotToResize <> mScaleWidth) Or (mUserControlSizeCorrectionsCounter_ScaleHeightNotToResize <> mScaleHeight) Then
            If (mTabOrientation = ssTabOrientationTop) Or (mTabOrientation = ntTabOrientationTopRight) Or (mTabOrientation = ssTabOrientationBottom) Or (mTabOrientation = ntTabOrientationBottomRight) Then
                If mBodyHeight < 3 Then
                    UserControl.Height = UserControl.Height + pScaleY(3 - mBodyHeight, vbPixels, vbTwips)
                    mUserControlSizeCorrectionsCounter = mUserControlSizeCorrectionsCounter + 1
                    GoTo TheExit:
                End If
            Else
                If mBodyHeight < 3 Then
                    iLng = UserControl.Width + pScaleX(3 - mBodyHeight, vbPixels, vbTwips)
                    UserControl.Width = iLng
                    mUserControlSizeCorrectionsCounter = mUserControlSizeCorrectionsCounter + 1
                    GoTo TheExit:
                End If
            End If
        End If
    ElseIf Not mAmbientUserMode Then
        mUserControlSizeCorrectionsCounter_ScaleWidthNotToResize = mScaleWidth
        mUserControlSizeCorrectionsCounter_ScaleHeightNotToResize = mScaleHeight
    End If
    ' One formula for every width style.
    iTabWidth = (iScaleWidthForTabs - iAllRowsPerspectiveSpace - RowLostToEdges() - mTabSeparation2 * (mTabsPerRow - 1)) / mTabsPerRow
    
    mUserControlSizeCorrectionsCounter = 0
    
    If (mBodyWidth_Prev <> mBodyWidth) And (mBodyWidth_Prev <> 0) Or (mBodyHeight_Prev <> mBodyHeight) And (mBodyHeight_Prev <> 0) Then
        ResetCachedThemeImages
    End If
    mBodyWidth_Prev = mBodyWidth
    mBodyHeight_Prev = mBodyHeight
    
    If (mTabWidthStyle2 <> ntTWTabStripEmulation) And (mTabWidthStyle2 <> ntTWStretchToFill) Then
        iTabStretchRatio = 1
    End If
    
    ReDim mRightMostTabsRightPos(mRows - 1)
    ReDim mLeftMostTabsLeftPos(mRows - 1)
    For iRow = 0 To mRows - 1
        mLeftMostTabsLeftPos(iRow) = iScaleWidth
    Next
    
    ' set the tab rects
    If mTabsAreRotatedButCaptionsAreHorizontal Then
        For iRow = 0 To mRows - 1
            For t = 0 To mTabs - 1
                If mTabData(t).Visible Then
                    If mTabData(t).RowPos = iRow Then
                        iTabData = mTabData(t)
                        iTabData.ColumnWidthHC = iColumnWidthForHorizontalCaptions(iRow)
                        With iTabData.TabRect
                            If t = mTab Then
                                ' The column already holds room for the extra height: the highlighted tab takes it
                                ' whole and the others start iTabExtraHeight further in
                                .Top = iColumnLeftForHorizontalCaptions(iRow)
                                If Not mHighlightAddExtraHeightSelectedTab Then
                                    .Top = .Top + iTabSinkHeight
                                Else
                                    .Top = .Top - iTabRowGrowth
                                End If
                                .Bottom = iColumnLeftForHorizontalCaptions(iRow) + iColumnWidthForHorizontalCaptions(iRow)
                                If iRow = (mRows - 1) Then .Bottom = .Bottom - iFlatBodyGapTrim
                                If mAppearanceIsFlat And (mHighlightFlatBarWithGrip Or mHighlightFlatBarWithGripSelectedTab) Then
                                    If mOrientationIsBottom Then
                                        If (mFlatBarPosition = ntBarPositionBottom) And (mFlatBarGripHeightDPIScaled > 0) Then
                                            .Top = .Top + mFlatBarGripHeightDPIScaled
                                            .Bottom = .Bottom + mFlatBarGripHeightDPIScaled
                                        End If
                                    Else
                                        If (mFlatBarPosition = ntBarPositionTop) And (mFlatBarGripHeightDPIScaled > 0) Then
                                            .Top = .Top + mFlatBarGripHeightDPIScaled
                                            .Bottom = .Bottom + mFlatBarGripHeightDPIScaled
                                        End If
                                    End If
                                End If
                            Else
                                .Top = iColumnLeftForHorizontalCaptions(iRow)
                                If Not (TabShowsDiscreteHighlight(t) And mHighlightAddExtraHeight) Then
                                    .Top = .Top + iTabSinkHeight
                                Else
                                    .Top = .Top - iTabRowGrowth
                                End If
                                .Bottom = iColumnLeftForHorizontalCaptions(iRow) + iColumnWidthForHorizontalCaptions(iRow)
                                If iRow = (mRows - 1) Then .Bottom = .Bottom - iFlatBodyGapTrim
                                If mAppearanceIsFlat And (mHighlightFlatBarWithGrip Or mHighlightFlatBarWithGripSelectedTab) Then
                                    If (mFlatBarPosition = ntBarPositionTop) And (mFlatBarGripHeightDPIScaled > 0) Then
                                        .Top = .Top + mFlatBarGripHeightDPIScaled
                                        .Bottom = .Bottom + mFlatBarGripHeightDPIScaled
                                    End If
                                End If
                            End If
                            
                            ' Positions accumulate, for every *Horizontal style.
                            If iTabData.PosH = 1 Then
                                .Left = iRowPerspectiveSpace * (mRows - mTabData(t).RowPos - 1) + iRowStartX
                            Else
                                .Left = iTabLeftHC + mTabSeparation2 + 1
                            End If
                            .Right = .Left + iTabData.Width - 1
                            iTabLeftHC = .Right
                            
                            If iTabData.RightTab And (iTabData.FixedWidth = 0) And (((mTabHeightStyleForHorizontal <> ntTHTabCaptionHeight) And (mTabHeightStyleForHorizontal <> ntTHMaxCaptionHeight) And (mTabHeightStyleForHorizontal <> ntTHStretchToFill)) Or (iTabData.Row < mRows - 1) Or iStretchToFillHC) Then
                                ' The fixed test is not new behaviour: the old TabFixedWidth
                                ' override ran after this snap and overwrote whatever it had
                                ' decided.
                                iSnapTargetHC = iScaleWidthForTabs - iRowPerspectiveSpace * mTabData(t).RowPos - RowEndMargin() - ThemedBandShift()
                                ' The tolerance is asked about THIS column, so it is counted from
                                ' the tab being measured.
                                If Abs(.Right - iSnapTargetHC) < (6 + iTabData.PosH / 2) Then
                                    ' ntTHFixed hands every tab exactly TabHeight and leaves
                                    ' whatever is over as free space at the end of the strip.
                                    If (mTabHeightStyleForHorizontal <> ntTHFixed) Or (.Right > iSnapTargetHC) Then
                                        .Right = iSnapTargetHC
                                    End If
                                End If
                            End If
                        End With
                        mTabData(t) = iTabData
                    End If
                End If
            Next t
        Next iRow
    Else
        For iRow = 0 To mRows - 1
            If (mTabWidthStyle2 = ntTWEqualWidth) Then
                ' Fixed shares out per row.
                iRowOwnWidthSum = 0
                iRowGridTabCount = 0
                iRowTabsInRow = 0
                For t = 0 To mTabs - 1
                    If mTabData(t).Visible Then
                        If mTabData(t).RowPos = iRow Then
                            iRowTabsInRow = iRowTabsInRow + 1
                            If mTabData(t).FixedWidth <> 0 Then
                                iRowOwnWidthSum = iRowOwnWidthSum + pScaleX(mTabData(t).FixedWidth, vbHimetric, vbPixels)
                            Else
                                iRowGridTabCount = iRowGridTabCount + 1
                            End If
                        End If
                    End If
                Next t
                If iRowGridTabCount > 0 Then
                    iRowGridTabWidth = (iRowTabsInRow * iTabWidth - iRowOwnWidthSum) / iRowGridTabCount
                    ' A pixel is the floor. The fixed widths can add up to more than the row had,
                    ' and then the honest answer is that the row overflows - but every tab in it
                    ' still has to be a tab, not an inverted rectangle
                    If iRowGridTabWidth < 1 Then iRowGridTabWidth = 1
                Else
                    iRowGridTabWidth = iTabWidth
                End If
            End If
            ' Which grid column a row starts on.
            iRowGridPosShift = 0
            If mTabsAlignedAtTheEnd And (mTabWidthStyle2 = ntTWEqualWidth) Then
                If (iRowTabsInRow > 0) And (iRowTabsInRow < mTabsPerRow) Then
                    iRowGridPosShift = mTabsPerRow - iRowTabsInRow
                End If
            End If
            For t = 0 To mTabs - 1
                If mTabData(t).Visible Then
                    If mTabData(t).RowPos = iRow Then
                        iTabData = mTabData(t)
                        With iTabData.TabRect
                            If t = mTab Then
                                ' The selected tab's row is always the last one, the rows having
                                ' been rotated for that a few hundred lines above.
                                .Top = (mRows - 1) * iTabHeight + iTabTopReserve
                                If Not mHighlightAddExtraHeightSelectedTab Then
                                    .Top = .Top + iTabSinkHeight
                                Else
                                    .Top = .Top - iTabRowGrowth
                                End If
                                .Bottom = mRows * iTabHeight + iTabTopReserve - iFlatBodyGapTrim
                                ' Same term the Else branch gives the last row: the selected tab is in the last row
                                If mStyle = ntStyleTabStrip Then
                                    .Bottom = .Bottom + iTabSinkHeight
                                End If
                                If mAppearanceIsFlat And (mHighlightFlatBarWithGrip Or mHighlightFlatBarWithGripSelectedTab) Then
                                    If mOrientationIsBottom Then
                                        If (mFlatBarPosition = ntBarPositionBottom) And (mFlatBarGripHeightDPIScaled > 0) Then
                                            .Top = .Top + mFlatBarGripHeightDPIScaled
                                            .Bottom = .Bottom + mFlatBarGripHeightDPIScaled
                                        End If
                                    Else
                                        If (mFlatBarPosition = ntBarPositionTop) And (mFlatBarGripHeightDPIScaled > 0) Then
                                            .Top = .Top + mFlatBarGripHeightDPIScaled
                                            .Bottom = .Bottom + mFlatBarGripHeightDPIScaled
                                        End If
                                    End If
                                End If
                            Else
                                .Top = mTabData(t).RowPos * iTabHeight + iTabTopReserve
                                If Not (TabShowsDiscreteHighlight(t) And mHighlightAddExtraHeight) Then
                                    .Top = .Top + iTabSinkHeight
                                Else
                                    .Top = .Top - iTabRowGrowth
                                End If
                                .Bottom = mTabData(t).RowPos * iTabHeight + iTabHeight + iTabTopReserve
                                If mTabData(t).RowPos = (mRows - 1) Then .Bottom = .Bottom - iFlatBodyGapTrim
                                ' The last row gets back the pixels the sink took from it, the same
                                ' ones every other row recovers by painting down into the cell
                                ' below.
                                If (mStyle = ntStyleTabStrip) And (mTabData(t).RowPos = (mRows - 1)) Then
                                    .Bottom = .Bottom + iTabSinkHeight
                                End If
                                If mOrientationIsBottom Then
                                    If mAppearanceIsFlat And (mHighlightFlatBarWithGrip Or mHighlightFlatBarWithGripSelectedTab) Then
                                        If (mFlatBarPosition = ntBarPositionBottom) And (mFlatBarGripHeightDPIScaled > 0) Then
                                            .Top = .Top + mFlatBarGripHeightDPIScaled
                                            .Bottom = .Bottom + mFlatBarGripHeightDPIScaled
                                        End If
                                    End If
                                Else
                                    If mAppearanceIsFlat And (mHighlightFlatBarWithGrip Or mHighlightFlatBarWithGripSelectedTab) Then
                                        If (mFlatBarPosition = ntBarPositionTop) And (mFlatBarGripHeightDPIScaled > 0) Then
                                            .Top = .Top + mFlatBarGripHeightDPIScaled
                                            .Bottom = .Bottom + mFlatBarGripHeightDPIScaled
                                        End If
                                    End If
                                End If
                            End If
                            If (mTabWidthStyle2 = ntTWEqualWidth) Then
                                ' One chain for the whole style, tabs with their own width and tabs
                                ' sharing the grid alike.
                                If iTabData.LeftTab Then
                                    iRowRunningEdge = iRowPerspectiveSpace * (mRows - mTabData(t).RowPos - 1) + iRowStartX
                                    ' A row aligned at the end takes the LAST iRowTabsInRow columns
                                    ' of the grid, so its first tab starts where the tab occupying
                                    ' that column starts in a full row.
                                    For iSlot = 1 To iRowGridPosShift
                                        iRowRunningEdge = CLng(iRowRunningEdge + iTabWidth - 1) + 1 + mTabSeparation2
                                    Next iSlot
                                Else
                                    iRowRunningEdge = iRowRunningEdge + mTabSeparation2
                                End If
                                .Left = iRowRunningEdge
                                If iTabData.FixedWidth <> 0 Then
                                    .Right = CLng(iRowRunningEdge + pScaleX(iTabData.FixedWidth, vbHimetric, vbPixels) - 1)
                                Else
                                    .Right = CLng(iRowRunningEdge + iRowGridTabWidth - 1)
                                End If
                                iRowRunningEdge = .Right + 1
                                iTabLeft = .Right + 1
                            Else
                                If iTabData.LeftTab Then
                                    ' A row always starts on iRowStartX, whatever the width style.
                                    iTabLeft = iRowPerspectiveSpace * (mRows - mTabData(t).RowPos - 1) + iRowStartX
                                Else
                                    iTabLeft = iTabLeft + mTabSeparation2
                                End If
                                .Left = iTabLeft
                                ' 2 * padding - 1 because the rect is inclusive. The stretched branch needs it:
                                ' iSng above discounts 2 * padding per tab from the space the row shares out
                                If (mTabWidthStyle2 = ntTWTabStripEmulation) Or (mTabWidthStyle2 = ntTWStretchToFill) Then
                                    .Right = .Left + iTabData.Width + (2 * mTabPaddingWidthDPIScaled - 1)
                                Else
                                    .Right = .Left + iTabData.IconAndCaptionWidth + (2 * mTabPaddingWidthDPIScaled - 1)
                                End If
                                iTabLeft = .Right + 1
                            End If
                            If iTabData.RightTab And (iTabData.FixedWidth = 0) Then
                                ' Where the row's last tab is parked - see RowEndMargin.
                                iSnapTargetRow = iScaleWidthForTabs - iRowPerspectiveSpace * mTabData(t).RowPos - RowEndMargin() - ThemedBandShift()
                                ' The rounding residue accumulates along the row, so the tolerance grows with the
                                ' number of tabs in it (PosH of the RightTab tab)
                                If Abs(.Right - iSnapTargetRow) < (6 + iTabData.PosH / 2) Then
                                    ' In these two styles a row can end well short of this column with every tab at its
                                    ' measured width. Pulling the last one out to the frame is a look and not a correction,
                                    ' so it gets a fixed budget instead of the tolerance above, which grows with the tab count
                                    If (mTabWidthStyle2 = ntTWTabCaptionWidth) Or (mTabWidthStyle2 = ntTWTabCaptionWidthFillRows) Then
                                        iSnapStretchBudget = CLng(cRowSnapStretchBudget * mDPIScale)
                                        If (iSnapTargetRow - .Right) > iSnapStretchBudget Then
                                            iSnapTargetRow = .Right
                                        End If
                                    End If
                                    .Right = iSnapTargetRow
                                End If
                            End If
                        End With
                        mTabData(t) = iTabData
                    End If
                End If
            Next t
        Next iRow
    End If
    
    If mTabsAlignedAtTheEnd And (Not mTabsOrderReversed) Then
        For t = 0 To mTabs - 1
            If mTabData(t).Visible Then
                If mTabData(t).TabRect.Right > mRightMostTabsRightPos(mTabData(t).RowPos) Then
                    mRightMostTabsRightPos(mTabData(t).RowPos) = mTabData(t).TabRect.Right
                End If
            End If
        Next
        If mVisualStylesActive Then
            ' RowEndMargin and not a literal 3, which is only that margin's value in Top and
            ' Bottom: it is 1 in Left and 2 in Right, and using 3 there pulled the row left
            ' of where the same row sits in the orientation that is not aligned at the end.
            iRightBorder = RowEndMargin() + ThemedBandShift()
        ElseIf (iStyle2 = ntStyleWindows) Or mAppearanceIsPP Then
            ' RowEndMargin and not a literal 3, for the reason the themed branch above
            ' gives: this has to be the column the snap parked the row on.
            iRightBorder = RowEndMargin()
        Else
            iRightBorder = 1
        End If
        For iRow = 0 To mRows - 1
            If mRightMostTabsRightPos(iRow) > 0 Then
                iLng = mBodyWidth - mRightMostTabsRightPos(iRow) - iRightBorder - StripButtonsReserve + iRowPerspectiveSpace * (mRows - iRow - 1)
                For t = 0 To mTabs - 1
                    If mTabData(t).Visible And (mTabData(t).RowPos = iRow) Then
                        mTabData(t).TabRect.Left = mTabData(t).TabRect.Left + iLng
                        mTabData(t).TabRect.Right = mTabData(t).TabRect.Right + iLng
                    End If
                Next t
                ' The reference moves with its row, also when the row is pulled back
                mRightMostTabsRightPos(iRow) = mRightMostTabsRightPos(iRow) + iLng
            End If
        Next iRow
    End If
    For t = 0 To mTabs - 1
        If mTabData(t).Visible Then
            If mTabData(t).PosH > 1 Then
                If mTabData(t).TabRect.Left <= mTabData(t - 1).TabRect.Right Then
                    iLng = t - 1
                    Do Until mTabData(iLng).Visible = True
                        iLng = iLng - 1
                        If iLng < 0 Then Exit Do
                    Loop
                    If iLng >= 0 Then
                        mTabData(t).TabRect.Left = mTabData(iLng).TabRect.Right + mTabSeparation2 + 1
                    End If
                End If
            End If
            If mTabData(t).RightTab Then
                If mTabData(t).RowPos > -1 Then
                    If mTabData(t).TabRect.Right > mRightMostTabsRightPos(mTabData(t).RowPos) Then
                        mRightMostTabsRightPos(mTabData(t).RowPos) = mTabData(t).TabRect.Right
                    End If
                End If
            End If
            If mTabData(t).LeftTab Then
                If mTabData(t).RowPos > -1 Then
                    If mTabData(t).TabRect.Left < mLeftMostTabsLeftPos(mTabData(t).RowPos) Then
                        mLeftMostTabsLeftPos(mTabData(t).RowPos) = mTabData(t).TabRect.Left
                    End If
                End If
            End If
        End If
    Next t
    
    iLng = 0
    For iRow = 0 To mRows - 1
        For t = 0 To mTabs - 1
            If mTabData(t).RowPos = iRow Then
                If mTabData(t).TabRect.Left > (iLng - 2) Then
                    mTabData(t).TopTab = True
                End If
                If mTabData(t).RightTab Then
                    iLng = mTabData(t).TabRect.Right
                End If
            End If
        Next t
    Next iRow
    
    ' gap between tabs correction
    iLng = 0
    For iRow = 0 To mRows - 1
        For t = 0 To mTabs - 1
            If mTabData(t).Visible Then
                If mTabData(t).RowPos = iRow Then
                    ' mTabSeparation2 and not the raw scaled property.
                    If mTabData(t).TabRect.Left > (iLng + 1 + mTabSeparation2) Then
                        If Not mTabData(t).LeftTab Then
                            mTabData(t).TabRect.Left = iLng + 1 + mTabSeparation2
                        End If
                    End If
                    If mTabData(t).RightTab Then
                        iLng = 0
                    Else
                        iLng = mTabData(t).TabRect.Right
                    End If
                End If
            End If
        Next t
    Next iRow
    
#If ROWWIDTHDIAG_RWDIAG = 1 Then ' TEMP diagnostic
    ' Here and not earlier: the two post-passes above (the overlap one and the gap one) still
    ' move Left after the branches have written the rects, so anything printed before this
    ' point is not what gets drawn
    If (mRowWidthDiagCount < 200) And mAmbientUserMode Then
        mRowWidthDiagCount = mRowWidthDiagCount + 1
        Debug.Print "RWDIAG head orient="; mTabOrientation;
        Debug.Print " style2="; mTabWidthStyle2;
        Debug.Print " hstyle="; mTabHeightStyleForHorizontal;
        Debug.Print " rows="; mRows;
        Debug.Print " avail="; iAvailableSpaceForTabs;
        Debug.Print " scaleWForTabs="; iScaleWidthForTabs;
        Debug.Print " padW="; mTabPaddingWidthDPIScaled;
        Debug.Print " sep2="; mTabSeparation2;
        Debug.Print " perRow="; mTabsPerRow;
        Debug.Print " iTabWidth="; iTabWidth;
        Debug.Print " bodyW="; mBodyWidth;
        Debug.Print " app2="; mTabAppearance2;
        Debug.Print " isPP="; Abs(mAppearanceIsPP);
        Debug.Print " themed="; Abs(mVisualStylesActive);
        Debug.Print " tbrb="; mThemedBodyRightBorderPixels; " lMarg="; mThemedLeftMarginAsTop; " rMarg="; mThemedRightMarginAsTop;
        ' Added 2026-09-09: the right end clamp of the active last tab reads the margin and not the
        ' band shift, while the left end clamp reads the shift.
        Debug.Print " tblb="; mThemedBodyLeftBorderPixels; " bandShift="; ThemedBandShift();
        Debug.Print " lostEdges="; RowLostToEdges();
        Debug.Print " perspTotal="; iAllRowsPerspectiveSpace;
        Debug.Print " perspRow="; iRowPerspectiveSpace;
        Debug.Print " dpiScale="; mDPIScale
        For iRWDiagTab = 0 To mTabs - 1
            If mTabData(iRWDiagTab).Visible Then
                If mRowWidthDiagCount < 200 Then
                    mRowWidthDiagCount = mRowWidthDiagCount + 1
                    Debug.Print "RWDIAG  t="; iRWDiagTab;
                    Debug.Print " row="; mTabData(iRWDiagTab).RowPos;
                    Debug.Print " posH="; mTabData(iRWDiagTab).PosH;
                    Debug.Print " leftTab="; Abs(mTabData(iRWDiagTab).LeftTab);
                    Debug.Print " rightTab="; Abs(mTabData(iRWDiagTab).RightTab);
                    Debug.Print " fixPx="; pScaleX(mTabData(iRWDiagTab).FixedWidth, vbHimetric, vbPixels);
                    Debug.Print " icw="; mTabData(iRWDiagTab).IconAndCaptionWidth;
                    Debug.Print " w="; mTabData(iRWDiagTab).Width;
                    Debug.Print " rectL="; mTabData(iRWDiagTab).TabRect.Left;
                    Debug.Print " rectR="; mTabData(iRWDiagTab).TabRect.Right;
                    Debug.Print " ext="; mTabData(iRWDiagTab).TabRect.Right - mTabData(iRWDiagTab).TabRect.Left + 1
                End If
            End If
        Next iRWDiagTab
    End If
#End If
    
    ReDim mRightMostTabsRightPos2(UBound(mRightMostTabsRightPos))
    ReDim mLeftMostTabsLeftPos2(UBound(mLeftMostTabsLeftPos))
    For c = 0 To UBound(mRightMostTabsRightPos)
        mRightMostTabsRightPos2(c) = mRightMostTabsRightPos(c)
        mLeftMostTabsLeftPos2(c) = mLeftMostTabsLeftPos(c)
    Next
    
    If mStripScrolls Then ScrollApply iScaleWidthForTabsReal
    If mTabsOrderReversed Then StripOrderMirror iRowStartX + iScaleWidth - RowEndMargin() - ThemedBandShift(), iRowPerspectiveSpace
    mStripLayoutKey = StripLayoutKey()
    mStackedIconSlotHeight = StackedIconSlotHeight()
    FlatRowEndsSquaredUpdate
    
    If Not mRedraw Then
        NewTabButtonZoneRestore
        Exit Sub
    End If
    mNeedToDraw = False

    ' Do the draw
    
    ' How the "light" need to come according to TabOrientation (because the image later will be
    ' rotated). Note: in Windows the llight comes from top-left, and shadows are in bottom right.

    ' Do the draw
    picDraw.Width = iScaleWidth
    picDraw.Height = iScaleHeight
    
    If picDraw.BackColor <> mBackColorTabs Then
        picDraw.BackColor = mBackColorTabs ' the pic backcolor determines the focusrect color
    End If
#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
    RotDiagMark 0
#End If
    If iUseStripCache Then iUseStripCache = DragStripCacheUsable(iScaleWidth, iScaleHeight)
    If iUseStripCache Then iUseHoverCache = False ' a drag freezes the hover, the two never meet
    If iUseHoverCache Then iUseHoverCache = HoverCacheUsable(iScaleWidth, iScaleHeight)
    
    ' Which tab, if any, is drawn differently from the way the base holds it.
    iHoverTab = -1
    iHoverSimple = False
    If (Not DragOffsetsShown) And (Not iUseStripCache) Then
        iHoverSimple = HoverStateIsSimple(iHoverTab)
    End If
    If Not iHoverSimple Then
        ' More than one tab carries hover state, or the icon hover names another tab: the base
        ' would bake a highlight into itself, so this frame paints the strip and keeps nothing
        iUseHoverCache = False
        iHoverTab = -1
    End If
    
    ' Building the base while a tab is hovered means painting the strip at rest, so the tab's own
    ' flags are put aside for the length of the loop and the tab is painted again, on its own, once
    ' the base has been kept.
    If (iHoverTab > -1) And (Not iUseHoverCache) And (Not iUseStripCache) Then
        iHoverWasHovered = mTabData(iHoverTab).Hovered
        iHoverWasCloseHovered = mTabData(iHoverTab).CloseButtonHovered
        mTabData(iHoverTab).Hovered = False
        mTabData(iHoverTab).CloseButtonHovered = False
        ' A tab on its way out is drawn from mFadeOutTab and not from its flags. A base built halfway
        ' through a fade (a strip button's hover asks for a full Draw) would keep the tab at that
        ' step, and the frame that ends the fade paints nothing over it.
        iHoverWasFadingOut = (mFadeOutTab = iHoverTab)
        If iHoverWasFadingOut Then mFadeOutTab = -1
        iHoverSuppressed = True
    End If
    
    ' On a cache hit the restore below covers the whole canvas, so clearing it first and
    ' painting a background that is about to be overwritten is pure cost
    If Not iUseStripCache Then
        picDraw.Cls
#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
        RotDiagMark 6
#End If
        
        ' BackColor
        picDraw.Line (0, 0)-(iScaleWidth, iScaleHeight), IIf(mBackStyle = ntOpaque, mBackColor, mBackColorSelectedTab2), BF
#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
        RotDiagMark 7
#End If
    End If
    
    ' The pane of these orientations is mirrored so that the shadow comes out at the bottom after
    ' the rotation, and mirroring moves the body's usable band: unmirrored it runs from column 0 to
    ' mBodyWidth - tbrb, mirrored it runs from tbrb - 1 to mBodyWidth - 1.
    mThemedBandShift = 0
    If mVisualStylesActive Then
        ' How far the usable band starts in from column 0, against what it would be with the pane
        ' untouched.
        mThemedBandShift = ThemedBandShift()
        If mThemedBandShift > 0 Then
            For t = 0 To mTabs - 1
                mTabData(t).TabRect.Left = mTabData(t).TabRect.Left + mThemedBandShift
                mTabData(t).TabRect.Right = mTabData(t).TabRect.Right + mThemedBandShift
            Next t
        End If

        ' The last tab of a row that carries a sheet has to meet that sheet: its drawn right border
        ' lands on the sheet's own border line, so the two read as one piece.
        If mShowsRowsPerspective2 Then
            For t = 0 To mTabs - 1
                If mTabData(t).Visible And mTabData(t).RightTab And (mTabData(t).RowPos < mRows - 1) Then
                    iSheetClampRight = iRowPerspectiveSpace * (mRows - mTabData(t).RowPos - 1) + mBodyWidth - 1
                    ' The sheet's border line and nothing else. There used to be a plus two here,
                    ' for the theme supposedly painting a tab's right border two columns before the
                    ' end of its rect.
                    iSheetClampRight = iSheetClampRight - (mThemedRightMarginAsTop - 1)
                    ' Keeps the room the packing left for a hovered last tab to widen into
                    If HighlightedTabIsWidened Then iSheetClampRight = iSheetClampRight - SelectedTabWideningPixels
                    If Abs(iSheetClampRight - mTabData(t).TabRect.Right) < 5 Then
                        mTabData(t).TabRect.Right = iSheetClampRight
                    End If
                End If
            Next t
        End If
    End If
    
    ' Which tabs open the band. LeftTab says a tab starts its ROW, which is not the same question: a
    ' row aligned at the end starts on a column somewhere in the middle of the band.
    iBandStart = -1
    For t = 0 To mTabs - 1
        If mTabData(t).Visible And mTabData(t).LeftTab Then
            iBandNorm = mTabData(t).TabRect.Left - iRowPerspectiveSpace * (mRows - mTabData(t).RowPos - 1)
            If (iBandStart = -1) Or (iBandNorm < iBandStart) Then
                iBandStart = iBandNorm
            End If
        End If
    Next t
    For t = 0 To mTabs - 1
        mTabData(t).LeftTabBeginning = False
        If mTabData(t).Visible And mTabData(t).LeftTab Then
            iBandNorm = mTabData(t).TabRect.Left - iRowPerspectiveSpace * (mRows - mTabData(t).RowPos - 1)
            If iBandNorm = iBandStart Then
                mTabData(t).LeftTabBeginning = True
            End If
        End If
        ' Assigned on every pass instead of only switched on, and here instead of inside the drawing
        ' loop below.
        mTabData(t).RightTabEnding = mTabData(t).RightTab And (Abs(mTabData(t).TabRect.Right - (mBodyWidth + iRowPerspectiveSpace * (mRows - mTabData(t).RowPos - 1))) < 4)
    Next t

    ' draw inactive tabs
    ScrollClipBegin False
    iDeferredWidenTab = -1
    For iRow = 0 To mRows - 1
        iRowSheetTab = -1
        For t = 0 To mTabs - 1
            If mTabData(t).Visible Then
                If mTabData(t).RowPos = iRow Then
                    If t <> mTab Then
                        If Not iUseStripCache And Not iUseHoverCache Then
                            If mTabData(t).RightTab And Not (mTabData(t).RowPos = mRows - 1) Then
                                ' Only noted here, drawn when the row is finished.
                                iRowSheetTab = t
                            End If
                        End If
                        ' The recess that used to be applied right here is gone.
                        If Not iUseStripCache And Not iUseHoverCache Then
                            ' See the note on iDeferredWidenTab where it is declared
                            If TabIsDrawnWidened(t) And (Not mTabData(t).RightTab) Then
                                iDeferredWidenTab = t
                            Else
                                DrawTab t
                                If Not mOrientationIsBottom And Not mTabsAreRotatedButCaptionsAreHorizontal Then
                                    DrawTabIconAndCaption t
                                    DrawTabCloseButton t
                                End If
                                If iDeferredWidenTab > -1 Then
                                    DrawTab iDeferredWidenTab
                                    If Not mOrientationIsBottom And Not mTabsAreRotatedButCaptionsAreHorizontal Then
                                        DrawTabIconAndCaption iDeferredWidenTab
                                        DrawTabCloseButton iDeferredWidenTab
                                    End If
                                    iDeferredWidenTab = -1
                                End If
                            End If
                        End If
                    End If
                End If
            End If
        Next t
        ' A tab held back must be down before its row's sheet goes on, or the sheet covers exactly
        ' the columns it was held back to keep.
        If iDeferredWidenTab > -1 Then
            DrawTab iDeferredWidenTab
            If Not mOrientationIsBottom And Not mTabsAreRotatedButCaptionsAreHorizontal Then
                DrawTabIconAndCaption iDeferredWidenTab
                DrawTabCloseButton iDeferredWidenTab
            End If
            iDeferredWidenTab = -1
        End If
        If iRowSheetTab > -1 Then
            DrawBacksheet iRowPerspectiveSpace * (mRows - mTabData(iRowSheetTab).RowPos - 1), mTabData(iRowSheetTab).TabRect.Bottom + mBacksheetTopInsetDPIScaled, mBodyWidth - 1, CLng(mBodyHeight) - mBacksheetTopInsetDPIScaled, mTabData(iRowSheetTab).RowPos, iRowSheetTab
            iRowSheetTab = -1
        End If
    Next iRow
    
    ' The cut point of the hover base cache, and it is before the body and not after it on
    ' purpose: the body is painted over the inactive tabs where they meet it, so a tab put
    ' back after the body would cover pixels the body owns
    If iUseHoverCache Then
        HoverCacheRestore iScaleWidth, iScaleHeight
        iHoverBaseOnCanvas = True
    ElseIf (Not iUseStripCache) And (Not DragOffsetsShown) And iHoverSimple Then
        ' Not while a tab is dragged: the strip is painted with the gap open, and a base kept
        ' from it would hold tabs away from their slots and be taken as good once the drag ended
        HoverCacheStore iScaleWidth, iScaleHeight
        iHoverBaseOnCanvas = (mHoverCacheDC <> 0)
    End If
    If iHoverSuppressed Then
        ' Only the frame that built the base put them aside; on a hit nothing was suppressed
        ' and the flags were never touched
        mTabData(iHoverTab).Hovered = iHoverWasHovered
        mTabData(iHoverTab).CloseButtonHovered = iHoverWasCloseHovered
        If iHoverWasFadingOut Then mFadeOutTab = iHoverTab
    End If
#If HOVERCLIPDIAG = 1 Then ' TEMP diagnostic
    ' Probe on the hovered tab's outer side, a few rows below its bottom
    If iHoverTab > -1 Then
        mHoverClipDiagProbeX = mTabData(iHoverTab).TabRect.Left - 2
        mHoverClipDiagProbeY = mTabData(iHoverTab).TabRect.Bottom + 3
    End If
    iHCProbe0 = picDraw.Point(mHoverClipDiagProbeX, mHoverClipDiagProbeY)
#End If
    If iHoverTab > -1 Then
        ' A tab is not painted inside its own rectangle: it runs a little past its bottom edge so
        ' that no gap shows between one row and the next, and the strip hides that overhang by
        ' painting the rows in order, each one over the one above.
        iHoverBandLeft = mTabData(iHoverTab).TabRect.Left
        iHoverBandRight = mTabData(iHoverTab).TabRect.Right
        ' Tried and reverted the same day, 2026-09-12: the replay was clipped above the top of the
        ' row below and the loop bounded to the hovered tab's own row, on the premise that what the
        ' clip cut away was covered in the base by that row.
        If TabIsDrawnWidened(iHoverTab) And (Not mTabData(iHoverTab).RightTab) Then
            iDeferredWidenTab = iHoverTab
        Else
            DrawTab iHoverTab
            If Not mOrientationIsBottom And Not mTabsAreRotatedButCaptionsAreHorizontal Then
                DrawTabIconAndCaption iHoverTab
                DrawTabCloseButton iHoverTab
            End If
        End If
        ' The tabs put back from here on are already in the base with their antialiased pixels
        ' blended: blending them again over themselves would darken them. See AAFlushPixels
        mAAKeepHoverBase = iHoverBaseOnCanvas
        For iHoverReplayRow = mTabData(iHoverTab).RowPos To mRows - 1
            For iHoverReplayTab = 0 To mTabs - 1
                If mTabData(iHoverReplayTab).Visible And (iHoverReplayTab <> mTab) And (iHoverReplayTab <> iHoverTab) Then
                    If mTabData(iHoverReplayTab).RowPos = iHoverReplayRow Then
                        If (iHoverReplayRow > mTabData(iHoverTab).RowPos) Or (iHoverReplayTab > iHoverTab) Then
                            ' The sheet has to come back with the tabs, at the point of the loop it
                            ' had.
                            If mTabData(iHoverReplayTab).RightTab And Not (mTabData(iHoverReplayTab).RowPos = mRows - 1) Then
                                DrawBacksheet iRowPerspectiveSpace * (mRows - mTabData(iHoverReplayTab).RowPos - 1), mTabData(iHoverReplayTab).TabRect.Bottom + mBacksheetTopInsetDPIScaled, mBodyWidth - 1, CLng(mBodyHeight) - mBacksheetTopInsetDPIScaled, mTabData(iHoverReplayTab).RowPos, iHoverReplayTab
                                iHoverBandLeft = 0
                                iHoverBandRight = mBodyWidth - 1
                            End If
                            If (mTabData(iHoverReplayTab).TabRect.Left <= iHoverBandRight) And (mTabData(iHoverReplayTab).TabRect.Right >= iHoverBandLeft) Then
                                DrawTab iHoverReplayTab
                                If Not mOrientationIsBottom And Not mTabsAreRotatedButCaptionsAreHorizontal Then
                                    DrawTabIconAndCaption iHoverReplayTab
                                    DrawTabCloseButton iHoverReplayTab
                                End If
                                If iDeferredWidenTab > -1 Then
                                    mAAKeepHoverBase = False
                                    DrawTab iDeferredWidenTab
                                    If Not mOrientationIsBottom And Not mTabsAreRotatedButCaptionsAreHorizontal Then
                                        DrawTabIconAndCaption iDeferredWidenTab
                                        DrawTabCloseButton iDeferredWidenTab
                                    End If
                                    iDeferredWidenTab = -1
                                    mAAKeepHoverBase = iHoverBaseOnCanvas
                                End If
                                If mTabData(iHoverReplayTab).TabRect.Left < iHoverBandLeft Then iHoverBandLeft = mTabData(iHoverReplayTab).TabRect.Left
                                If mTabData(iHoverReplayTab).TabRect.Right > iHoverBandRight Then iHoverBandRight = mTabData(iHoverReplayTab).TabRect.Right
                            End If
                        End If
                    End If
                End If
            Next iHoverReplayTab
        Next iHoverReplayRow
        mAAKeepHoverBase = False
        If iDeferredWidenTab > -1 Then
            DrawTab iDeferredWidenTab
            If Not mOrientationIsBottom And Not mTabsAreRotatedButCaptionsAreHorizontal Then
                DrawTabIconAndCaption iDeferredWidenTab
                DrawTabCloseButton iDeferredWidenTab
            End If
            iDeferredWidenTab = -1
        End If
    End If
#If HOVERCLIPDIAG = 1 Then ' TEMP diagnostic
    iHCProbe1 = picDraw.Point(mHoverClipDiagProbeX, mHoverClipDiagProbeY)
#End If
    
    ScrollClipEnd
    
    ' Draw body (body: client area). This is also the cut point of the strip cache: with the body
    ' painted the image holds everything except the dragged tab, which is exactly what gets kept.
    If iUseStripCache Then
        DragStripCacheRestore iScaleWidth, iScaleHeight
    Else
        DrawBody iScaleHeight
        If DraggingATab Then
            DragStripCacheStore iScaleWidth, iScaleHeight
        End If
    End If
#If BODYEDGEDIAG = 1 Then ' TEMP diagnostic
    If mAmbientUserMode Then
        iBEDiagStr = ""
        For iBEDiagY = mBodyStart - 2 To mBodyStart + 9
            iBEDiagStr = iBEDiagStr & " " & Hex$(picDraw.Point(mBodyWidth - 1, iBEDiagY))
        Next
        Debug.Print "BEDIAG orient="; mTabOrientation; " tabs="; mVisibleTabs; " bodyStart="; mBodyStart; " bodyW="; mBodyWidth; " rowEndMargin="; RowEndMargin; " TRrounded="; Abs(CLng(mFlatBodyTopRightRounded)); " roundTop="; mFlatRoundnessTopDPIScaled
        If mTab > -1 Then Debug.Print "BEDIAG sel="; mTab; " rect="; mTabData(mTab).TabRect.Left; ","; mTabData(mTab).TabRect.Top; "-"; mTabData(mTab).TabRect.Right; ","; mTabData(mTab).TabRect.Bottom; " rightMost="; mRightMostTabsRightPos(mRows - 1)
        Debug.Print "BEDIAG afterBody y="; mBodyStart - 2; ".."; iBEDiagStr
    End If
#End If
    ' A hovered front-row tab with a flat border puts its bottom border on the body's first row,
    ' which DrawBody has just painted over: the whole tab is drawn again so its corners come back too.
    ' With ntHLFlatShapeInactive every front-row tab has that border.
    ' Not when ntHLRoundBottom closes the shape over a gap, which then stops short of the body
    If mAppearanceIsFlat And mHighlightFlatDrawBorder And Not (mHighlightRoundBottom And (Not mFlatRowEndsSquared) And ((mFlatRoundnessTop2 > 0) Or (mFlatRoundnessTabs2 > 0)) And (mFlatTabBodyGapDPIScaled > 0)) Then
        ScrollClipBegin False
        mDrawingTabsOverBody = True
        For t = 0 To mTabs - 1
            If (mTabData(t).Hovered Or (mFadeOutTab = t) Or mHighlightFlatShapeInactive) And (t <> mTab) And mTabData(t).Visible Then
                If mTabData(t).RowPos = (mRows - 1) Then
                    DrawTab t
                    If Not mOrientationIsBottom And Not mTabsAreRotatedButCaptionsAreHorizontal Then
                        DrawTabIconAndCaption t
                        DrawTabCloseButton t
                    End If
                End If
            End If
        Next
        mDrawingTabsOverBody = False
        ScrollClipEnd
    End If
#If HOVERCLIPDIAG = 1 Then ' TEMP diagnostic
    iHCProbe2 = picDraw.Point(mHoverClipDiagProbeX, mHoverClipDiagProbeY)
#End If
    
    ' Draw active tab
    If SelectedTabIsWidened And (mTab > -1) Then
        mTabData(mTab).TabRect.Left = mTabData(mTab).TabRect.Left - SelectedTabWideningPixels
        mTabData(mTab).TabRect.Right = mTabData(mTab).TabRect.Right + SelectedTabWideningPixels
    End If
    ' The tabbed dialog branch that used to sit here moved the active tab's Left one pixel out and
    ' left its Right alone, so the active tab came out a pixel wider than the same tab when
    ' inactive.
    
    ' The layout has just been rebuilt, so this is the point where the dragged tab's drawing offset
    ' can be worked out against its current slot.
    DragSnapshotTabRects
    DragUpdateDrawOffset
    
    StripCloseButtonPlace iScaleWidthForTabsReal, iRowPerspectiveSpace
    NewTabZonePlace iScaleWidthForTabsReal, iRowPerspectiveSpace
    If mTabsOrderReversed Then StripZoneMirror iRowStartX + iScaleWidth - RowEndMargin() - ThemedBandShift(), iRowPerspectiveSpace
    ScrollClipBegin False
    If mTab > -1 Then
        DrawTab CLng(mTab)
        If Not mOrientationIsBottom And Not mTabsAreRotatedButCaptionsAreHorizontal Then
            DrawTabIconAndCaption CLng(mTab)
            DrawTabCloseButton CLng(mTab)
        End If
    End If
    ScrollClipEnd
#If BODYEDGEDIAG = 1 Then ' TEMP diagnostic
    If mAmbientUserMode Then
        iBEDiagStr = ""
        For iBEDiagY = mBodyStart - 2 To mBodyStart + 9
            iBEDiagStr = iBEDiagStr & " " & Hex$(picDraw.Point(mBodyWidth - 1, iBEDiagY))
        Next
        Debug.Print "BEDIAG afterSel  y="; mBodyStart - 2; ".."; iBEDiagStr
    End If
#End If
    If Not mOrientationIsBottom And Not mTabsAreRotatedButCaptionsAreHorizontal Then
        DrawStripCloseButton mStripCloseRect
        DrawScrollButtons False
        DrawZoneNewTabButton mZoneNewTabRect
        DrawZoneListButton mZoneListRect, False
    End If
#If HOVERCLIPDIAG = 1 Then ' TEMP diagnostic
    If (mHoverClipDiagCount < 200) And mAmbientUserMode Then
        mHoverClipDiagCount = mHoverClipDiagCount + 1
        iHCProbe3 = picDraw.Point(mHoverClipDiagProbeX, mHoverClipDiagProbeY)
        Debug.Print "HCDIAG n="; mHoverClipDiagCount; " hover="; iHoverTab; " hit="; Abs(CLng(iUseHoverCache)); " kept="; Abs(CLng(iHoverSuppressed));
        If iHoverTab > -1 Then
            Debug.Print " rect="; mTabData(iHoverTab).TabRect.Left; ","; mTabData(iHoverTab).TabRect.Top; "-"; mTabData(iHoverTab).TabRect.Right; ","; mTabData(iHoverTab).TabRect.Bottom;
        End If
        Debug.Print " p0="; iHCProbe0; " p1="; iHCProbe1; " p2="; iHCProbe2; " p3="; iHCProbe3
        For iHCRowY = mHoverClipDiagProbeY - 3 To mHoverClipDiagProbeY + 4
            Debug.Print "HCROW y="; iHCRowY; " x="; mHoverClipDiagProbeX - 3; "..";
            For iHCRowX = mHoverClipDiagProbeX - 3 To mHoverClipDiagProbeX + 3
                Debug.Print " "; picDraw.Point(iHCRowX, iHCRowY) And &HFF&;
            Next
            Debug.Print
        Next
    End If
#End If
    
    ' The hovered tab's grip over the body, painted again because the body covers it. Only when the
    ' bar is on the body side of the as-Top frame; the active tab keeps the one DrawTab gives it
    If (mFlatBarPosition = ntBarPositionBottom) <> mOrientationIsBottom Then
        If mAppearanceIsFlat And mHighlightFlatBarWithGrip And (mFlatBarGripHeightDPIScaled > 0) Then
            For t = 0 To mTabs - 1
                If (mTabData(t).Hovered Or (mFadeOutTab = t)) And mAmbientUserMode And (t <> mTab) Then
                    Const cEpsilon As Single = 0.499
                    Dim iTriangle(2) As POINTAPI
                    
                    With mTabData(t).TabRect
                        ' top point
                        iTriangle(0).X = (.Left + .Right) / 2 + cEpsilon
                        iTriangle(0).Y = .Bottom - 1 + mFlatBarGripHeightDPIScaled
                        ' left point
                        iTriangle(1).X = (.Left + .Right) / 2 - mFlatBarGripHeightDPIScaled + cEpsilon
                        iTriangle(1).Y = .Bottom - 1
                        ' right point
                        iTriangle(2).X = (.Left + .Right) / 2 + mFlatBarGripHeightDPIScaled + cEpsilon
                        iTriangle(2).Y = .Bottom - 1
                        If (Not IsEmpty(mTabData(t).CustomColors.FlatBarColorInactive)) Or (Not IsEmpty(mTabData(t).CustomColors.FlatBarColorHighlighted)) Then
                            DrawTriangle iTriangle, mTabData(t).CustomColors.FlatBarGlowColor
                        Else
                            DrawTriangle iTriangle, HoverBarColorFor(t)
                        End If
                    End With
                    Exit For
                End If
            Next
        End If
    End If
    
    mEndOfTabs = 0
    For t = 0 To mTabs - 1
        If mTabData(t).Visible Then
            If mTabData(t).TabRect.Right > mEndOfTabs Then
                mEndOfTabs = mTabData(t).TabRect.Right
            End If
        End If
    Next t
    mEndOfTabs = mEndOfTabs + 1
#If ROTATECACHE = 1 Then ' TEMP diagnostic
    ' The first row of the as-Top image that holds body and nothing else.
    iSplitRow = mBodyStart + mFlatBarGripHeightDPIScaled + CLng(8 * mDPIScale)
    If (iSplitRow < 1) Or (iSplitRow >= iScaleHeight) Then iSplitRow = 0
#End If
#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
    RotDiagMark 0
#End If
    
    Select Case mTabOrientation
        Case ssTabOrientationTop, ntTabOrientationTopRight
            'BitBlt UserControl.hDC, 0, 0, iScaleWidth, iScaleHeight, picDraw.hDC, 0, 0, vbSrcCopy
            Set UserControl.Picture = picDraw.Image
#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
            ' Top captures and assigns in one statement, so it is all charged to paste
            RotDiagMark 5
#End If
        Case ssTabOrientationBottom, ntTabOrientationBottomRight
            Set p = picDraw.Image
#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
            RotDiagMark 1
#End If
            picDraw.Cls
#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
            RotDiagMark 2
#End If
            If mRightToLeft Then
                ' the captured image is already physically mirrored (rendered through the RTL-layout DC),
                ' and pasting it back through that same DC would mirror it once more
                Set p = RotatePic(p, nt180Degrees, iSplitRow)
            Else
                Set p = RotatePic(p, ntFlipVertical, iSplitRow)
            End If
#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
            RotDiagMark 3
#End If
            picDraw.PaintPicture p, 0, 0
#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
            RotDiagMark 5
#End If
        Case ssTabOrientationLeft, ntTabOrientationLeftTop, ntTabOrientationLeftHorizontal, ntTabOrientationLeftBottomHorizontal
            Set p = picDraw.Image
#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
            RotDiagMark 1
#End If
            picDraw.Cls
#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
            RotDiagMark 2
#End If
            If mRightToLeft Then
                ' the as-Top image was rendered mirrored (RTL layout), so rotating it the opposite way
                ' lands the tab strip on the opposite side -the standard mirrored-UI behavior- while
                ' keeping the tabs' order along the strip and the captions readable
                If mTabsAreRotatedButCaptionsAreHorizontal Then
                    ' same double mirroring as in the Bottom orientations above
                    Set p = RotatePic(p, nt90DegreesClockWiseFlipped, iSplitRow)
                Else
                    Set p = RotatePic(p, nt90DegreesClockWise, iSplitRow)
                End If
            Else
                Set p = RotatePic(p, nt90DegreesCounterClockWise, iSplitRow)
            End If
#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
            RotDiagMark 3
#End If
            If mTabsAreRotatedButCaptionsAreHorizontal Then
                iLng = picDraw.Height
                picDraw.Height = picDraw.Width
                picDraw.Width = iLng
#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
                RotDiagMark 4
#End If
                picDraw.PaintPicture p, 0, 0
#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
                RotDiagMark 5
#End If
            Else
                Set UserControl.Picture = p
#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
                RotDiagMark 5
#End If
            End If
        Case Else ' ssTabOrientationRight, ntTabOrientationRightBottom, ntTabOrientationRightHorizontal, ntTabOrientationRightBottomHorizontal
            Set p = picDraw.Image
#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
            RotDiagMark 1
#End If
            picDraw.Cls
#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
            RotDiagMark 2
#End If
            If mRightToLeft Then
                ' see the note in the Left case above: under RTL the rotation direction is swapped
                If mTabsAreRotatedButCaptionsAreHorizontal Then
                    ' see the note in the Left case above: the rotation and the pre-unmirroring flip
                    ' compose into a single reflection, done in one pass over the bitmap
                    Set p = RotatePic(p, nt90DegreesCounterClockWiseFlipped, iSplitRow)
                Else
                    Set p = RotatePic(p, nt90DegreesCounterClockWise, iSplitRow)
                End If
            Else
                Set p = RotatePic(p, nt90DegreesClockWise, iSplitRow)
            End If
#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
            RotDiagMark 3
#End If
            If mTabsAreRotatedButCaptionsAreHorizontal Then
                iLng = picDraw.Height
                picDraw.Height = picDraw.Width
                picDraw.Width = iLng
#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
                RotDiagMark 4
#End If
                picDraw.PaintPicture p, 0, 0
#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
                RotDiagMark 5
#End If
            Else
                Set UserControl.Picture = p
#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
                RotDiagMark 5
#End If
            End If
    End Select
    iAlreadyNeedToBePainted = GetUpdateRect(mUserControlHwnd, iTmpRect, 0&) <> 0&
    
    ' to avoid flickering on windowless contained controls, if not changed, validate the tab body area
    If (Not mBodyReset) Then
        If Not iAlreadyNeedToBePainted Then
            GetClientRect mUserControlHwnd, iTmpRect
            If (mTabOrientation = ssTabOrientationTop) Or (mTabOrientation = ntTabOrientationTopRight) Then
                iTmpRect.Top = mBodyStart + 3
            ElseIf (mTabOrientation = ssTabOrientationBottom) Or (mTabOrientation = ntTabOrientationBottomRight) Then
                iTmpRect.Bottom = iTmpRect.Bottom - mBodyStart - 3
            ElseIf (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Or (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationLeftBottomHorizontal) Then
                If mRightToLeft Then
                    ' under RTL the tab strip is visually on the opposite (right) side
                    iTmpRect.Right = iTmpRect.Right - mBodyStart - 3
                Else
                    iTmpRect.Left = mBodyStart + 3
                End If
            ElseIf (mTabOrientation = ssTabOrientationRight) Or (mTabOrientation = ntTabOrientationRightBottom) Or (mTabOrientation = ntTabOrientationRightHorizontal) Or (mTabOrientation = ntTabOrientationRightBottomHorizontal) Then
                If mRightToLeft Then
                    ' under RTL the tab strip is visually on the opposite (left) side
                    iTmpRect.Left = mBodyStart + 3
                Else
                    iTmpRect.Right = iTmpRect.Right - mBodyStart - 3
                End If
            End If
            ValidateRect mUserControlHwnd, iTmpRect
        End If
    End If
    mBodyReset = False
    
    ' rotate caption RECTs according to TabOrientation
    If mOrientationIsBottom Then
        For t = 0 To mTabs - 1
            iTabData = mTabData(t)
            If iTabData.Visible Then
                With iTabData.TabRect
                    iLng = .Top - 2
                    .Top = iScaleHeight - 3 - .Bottom
                    .Bottom = iScaleHeight - 3 - iLng
                End With
                With iTabData.IconRect
                    iLng = .Top - 2
                    .Top = iScaleHeight - 3 - .Bottom
                    .Bottom = iScaleHeight - 3 - iLng
                End With
                If iTabData.CloseButtonRect.Right > iTabData.CloseButtonRect.Left Then
                    With iTabData.CloseButtonRect
                        iLng = .Top - 2
                        .Top = iScaleHeight - 3 - .Bottom
                        .Bottom = iScaleHeight - 3 - iLng
                    End With
                End If
            End If
            mTabData(t) = iTabData
        Next t
    ElseIf (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Or (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationLeftBottomHorizontal) Then
        For t = 0 To mTabs - 1
            iTabData = mTabData(t)
            If iTabData.Visible Then
                With iTabData.TabRect
                    iTmpRect.Top = .Top
                    iTmpRect.Bottom = .Bottom
                    iTmpRect.Left = .Left
                    iTmpRect.Right = .Right
                    .Top = iScaleWidth - iTmpRect.Right
                    .Bottom = .Top + iTmpRect.Right - iTmpRect.Left
                    .Left = iTmpRect.Top
                    .Right = .Left + iTmpRect.Bottom - iTmpRect.Top
                End With
                With iTabData.IconRect
                    iTmpRect.Top = .Top
                    iTmpRect.Bottom = .Bottom
                    iTmpRect.Left = .Left
                    iTmpRect.Right = .Right
                    .Top = iScaleWidth - iTmpRect.Right
                    .Bottom = .Top + iTmpRect.Right - iTmpRect.Left
                    .Left = iTmpRect.Top
                    .Right = .Left + iTmpRect.Bottom - iTmpRect.Top
                End With
                If iTabData.CloseButtonRect.Right > iTabData.CloseButtonRect.Left Then
                    With iTabData.CloseButtonRect
                        iTmpRect.Top = .Top
                        iTmpRect.Bottom = .Bottom
                        iTmpRect.Left = .Left
                        iTmpRect.Right = .Right
                        .Top = iScaleWidth - iTmpRect.Right
                        .Bottom = .Top + iTmpRect.Right - iTmpRect.Left
                        .Left = iTmpRect.Top
                        .Right = .Left + iTmpRect.Bottom - iTmpRect.Top
                    End With
                End If
            End If
            mTabData(t) = iTabData
        Next t
    ElseIf (mTabOrientation = ssTabOrientationRight) Or (mTabOrientation = ntTabOrientationRightBottom) Or (mTabOrientation = ntTabOrientationRightHorizontal) Or (mTabOrientation = ntTabOrientationRightBottomHorizontal) Then
        For t = 0 To mTabs - 1
            iTabData = mTabData(t)
            If iTabData.Visible Then
                With iTabData.TabRect
                    iTmpRect.Top = .Top
                    iTmpRect.Bottom = .Bottom
                    iTmpRect.Left = .Left
                    iTmpRect.Right = .Right
                    .Top = iTmpRect.Left
                    .Bottom = .Top + iTmpRect.Right - iTmpRect.Left
                    .Left = iScaleHeight - iTmpRect.Bottom
                    .Right = .Left + iTmpRect.Bottom - iTmpRect.Top
                End With
                With iTabData.IconRect
                    iTmpRect.Top = .Top
                    iTmpRect.Bottom = .Bottom
                    iTmpRect.Left = .Left
                    iTmpRect.Right = .Right
                    .Top = iTmpRect.Left
                    .Bottom = .Top + iTmpRect.Right - iTmpRect.Left
                    .Left = iScaleHeight - iTmpRect.Bottom
                    .Right = .Left + iTmpRect.Bottom - iTmpRect.Top
                End With
                If iTabData.CloseButtonRect.Right > iTabData.CloseButtonRect.Left Then
                    With iTabData.CloseButtonRect
                        iTmpRect.Top = .Top
                        iTmpRect.Bottom = .Bottom
                        iTmpRect.Left = .Left
                        iTmpRect.Right = .Right
                        .Top = iTmpRect.Left
                        .Bottom = .Top + iTmpRect.Right - iTmpRect.Left
                        .Left = iScaleHeight - iTmpRect.Bottom
                        .Right = .Left + iTmpRect.Bottom - iTmpRect.Top
                    End With
                End If
            End If
            mTabData(t) = iTabData
        Next t
    End If
    StripCloseRectToScreen iScaleWidth, iScaleHeight
    ScrollRectsToScreen iScaleWidth, iScaleHeight
    mZoneNewTabRectScreen = ScrollRectToScreen(mZoneNewTabRect, iScaleWidth, iScaleHeight)
    mZoneListRectScreen = ScrollRectToScreen(mZoneListRect, iScaleWidth, iScaleHeight)
    
    ' draw captions for bottom orientations
    If mOrientationIsBottom Or mTabsAreRotatedButCaptionsAreHorizontal Then
        ' While a tab is dragged its shape overlaps its neighbours', and those neighbours' captions
        ' are painted in this pass, after the shape was painted in the previous one - so they would
        ' show through it.
        If DragOffsetsShown Then
            iDragSaveRect = mTabData(mTab).TabRect
            DragOffsetTabRect iDragSaveRect, CLng(mTab)
            iDragSaveDC = DragSaveTabPixels(iDragSaveRect, iDragSaveBmp, iDragSaveOldBmp)
        ElseIf (iTabRowGrowth > 0) And mHighlightAddExtraHeightSelectedTab And (mTab > -1) Then
            iDragSaveRect = mTabData(mTab).TabRect
            iDragSaveDC = DragSaveTabPixels(iDragSaveRect, iDragSaveBmp, iDragSaveOldBmp)
        End If
        ' The same predicate the rects are built with, split in two so the flag is asked
        ' about once instead of once per tab. Only one tab can be hovered, so the search
        ' stops at the first one it finds
        iGrownTab = -1
        If (iTabRowGrowth > 0) And mHighlightAddExtraHeight Then
            For t = 0 To mTabs - 1
                If mTabData(t).Visible And (t <> mTab) Then
                    If TabShowsDiscreteHighlight(t) Then
                        iGrownTab = t
                        Exit For
                    End If
                End If
            Next t
        End If
        If iGrownTab >= 0 Then
            iGrownSaveRect = mTabData(iGrownTab).TabRect
            iGrownSaveDC = DragSaveTabPixels(iGrownSaveRect, iGrownSaveBmp, iGrownSaveOldBmp)
        End If
        ScrollClipBegin True
        For iRow = 0 To mRows - 1
            For t = 0 To mTabs - 1
                If mTabData(t).Visible Then
                    If mTabData(t).RowPos = iRow Then
                        If (t <> mTab) And (t <> iGrownTab) Then
                            DrawTabIconAndCaption t
                            DrawTabCloseButton t
                        End If
                    End If
                End If
            Next t
        Next iRow
        If iGrownSaveDC <> 0 Then
            DragRestoreTabPixels iGrownSaveRect, iGrownSaveDC, iGrownSaveBmp, iGrownSaveOldBmp
        End If
        If iDragSaveDC <> 0 Then
            DragRestoreTabPixels iDragSaveRect, iDragSaveDC, iDragSaveBmp, iDragSaveOldBmp
        End If
        ' The grown tab's caption goes on after its pixels are back, and before the
        ' selected tab's: the selected one always sits in the last row, so it is in front
        ' of anything else that grew and it keeps the last word
        If iGrownTab >= 0 Then
            DrawTabIconAndCaption iGrownTab
            DrawTabCloseButton iGrownTab
        End If
        If mTab > -1 Then
            DrawTabIconAndCaption CLng(mTab)
            DrawTabCloseButton CLng(mTab)
        End If
        ScrollClipEnd
        DrawStripCloseButton mStripCloseRectScreen
        DrawScrollButtons True
        DrawZoneNewTabButton mZoneNewTabRectScreen
        DrawZoneListButton mZoneListRectScreen, True
#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
        RotDiagMark 0
#End If
        Set UserControl.Picture = picDraw.Image
#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
        RotDiagMark 8
#End If
    End If
#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
    ' The Cls that detaches whatever StdPicture the Image property handed out above, or in
    ' the Top branch of the rotation stage: it is where the copy-on-write copy is actually
    ' paid, so it is measured apart from the rest of the tail
    RotDiagMark 0
#End If
    picDraw.Cls
#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
    RotDiagMark 9
#End If
    
    If ((mBodyStart <> mBodyStart_Prev) And (mAutoRelocateControls = ntRelocateAlways) Or (mTabOrientation <> mTabOrientation_Prev) And (mAutoRelocateControls > 0)) And (mTabOrientation_Prev <> -1) Then
        RearrangeContainedControlsPositions
    End If
    mBodyStart_Prev = mBodyStart
    mTabOrientation_Prev = mTabOrientation
    
    UpdateMaskPicture False
    
    ' set the client space data
    mClientSpaceData.RECT.Left = mBodyRect.Left
    mClientSpaceData.RECT.Top = mBodyRect.Top
    mClientSpaceData.RECT.Right = mBodyRect.Right
    mClientSpaceData.RECT.Bottom = mBodyRect.Bottom
    If mVisualStylesActive Then
        If mOrientationIsBottom Then
            mClientSpaceData.RECT.Left = mClientSpaceData.RECT.Left - 2 + mThemedBodyLeftBorderPixels
            mClientSpaceData.RECT.Top = mClientSpaceData.RECT.Top + mThemedBodyTopBorderPixels
            mClientSpaceData.RECT.Right = mClientSpaceData.RECT.Right + 3 - mThemedRightMarginAsTop
            mClientSpaceData.RECT.Bottom = mClientSpaceData.RECT.Bottom + 5 - mThemedBodyTopBorderPixels
        ElseIf (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Or (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationLeftBottomHorizontal) Then
            mClientSpaceData.RECT.Left = mClientSpaceData.RECT.Left - 4 + mThemedBodyTopBorderPixels
            mClientSpaceData.RECT.Top = mClientSpaceData.RECT.Top + mThemedRightMarginAsTop
            mClientSpaceData.RECT.Right = mClientSpaceData.RECT.Right + 3 - mThemedBottomMarginAsTop
            mClientSpaceData.RECT.Bottom = mClientSpaceData.RECT.Bottom + 3 - mThemedLeftMarginAsTop
        ElseIf (mTabOrientation = ssTabOrientationRight) Or (mTabOrientation = ntTabOrientationRightBottom) Or (mTabOrientation = ntTabOrientationRightHorizontal) Or (mTabOrientation = ntTabOrientationRightBottomHorizontal) Then
            mClientSpaceData.RECT.Left = mClientSpaceData.RECT.Left - 2 + mThemedBottomMarginAsTop
            mClientSpaceData.RECT.Top = mClientSpaceData.RECT.Top + mThemedLeftMarginAsTop
            mClientSpaceData.RECT.Right = mClientSpaceData.RECT.Right + 5 - mThemedBodyTopBorderPixels
            mClientSpaceData.RECT.Bottom = mClientSpaceData.RECT.Bottom + 3 - mThemedRightMarginAsTop
        Else
            mClientSpaceData.RECT.Left = mClientSpaceData.RECT.Left - 2 + mThemedBodyLeftBorderPixels
            mClientSpaceData.RECT.Top = mClientSpaceData.RECT.Top - 2 + mThemedBodyTopBorderPixels
            mClientSpaceData.RECT.Right = mClientSpaceData.RECT.Right + 3 - mThemedRightMarginAsTop
            mClientSpaceData.RECT.Bottom = mClientSpaceData.RECT.Bottom + 3 - mThemedBodyBottomBorderPixels
        End If
    ElseIf mAppearanceIsPP Then
        If mOrientationIsBottom Then
            mClientSpaceData.RECT.Left = mClientSpaceData.RECT.Left - 1
            mClientSpaceData.RECT.Top = mClientSpaceData.RECT.Top + 1
            mClientSpaceData.RECT.Right = mClientSpaceData.RECT.Right + 1
            mClientSpaceData.RECT.Bottom = mClientSpaceData.RECT.Bottom + 3
        ElseIf (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Or (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationLeftBottomHorizontal) Then
            mClientSpaceData.RECT.Left = mClientSpaceData.RECT.Left - 3
            mClientSpaceData.RECT.Top = mClientSpaceData.RECT.Top + 1
            mClientSpaceData.RECT.Right = mClientSpaceData.RECT.Right + 1
            mClientSpaceData.RECT.Bottom = mClientSpaceData.RECT.Bottom + 1
        ElseIf (mTabOrientation = ssTabOrientationRight) Or (mTabOrientation = ntTabOrientationRightBottom) Or (mTabOrientation = ntTabOrientationRightHorizontal) Or (mTabOrientation = ntTabOrientationRightBottomHorizontal) Then
            mClientSpaceData.RECT.Left = mClientSpaceData.RECT.Left - 1
            mClientSpaceData.RECT.Top = mClientSpaceData.RECT.Top + 1
            mClientSpaceData.RECT.Right = mClientSpaceData.RECT.Right + 3
            mClientSpaceData.RECT.Bottom = mClientSpaceData.RECT.Bottom + 1
        Else
            mClientSpaceData.RECT.Left = mClientSpaceData.RECT.Left - 1
            mClientSpaceData.RECT.Top = mClientSpaceData.RECT.Top - 1
            mClientSpaceData.RECT.Right = mClientSpaceData.RECT.Right + 1
            mClientSpaceData.RECT.Bottom = mClientSpaceData.RECT.Bottom + 1
        End If
    ElseIf mAppearanceIsFlat Then
        ' it is already OK
    Else ' tabbed dialog
        If mOrientationIsBottom Then
            mClientSpaceData.RECT.Left = mClientSpaceData.RECT.Left + 1
            mClientSpaceData.RECT.Top = mClientSpaceData.RECT.Top + 3
            mClientSpaceData.RECT.Bottom = mClientSpaceData.RECT.Bottom + 2
        ElseIf (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Or (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationLeftBottomHorizontal) Then
            mClientSpaceData.RECT.Left = mClientSpaceData.RECT.Left - 1
            mClientSpaceData.RECT.Top = mClientSpaceData.RECT.Top + 3
        ElseIf (mTabOrientation = ssTabOrientationRight) Or (mTabOrientation = ntTabOrientationRightBottom) Or (mTabOrientation = ntTabOrientationRightHorizontal) Or (mTabOrientation = ntTabOrientationRightBottomHorizontal) Then
            mClientSpaceData.RECT.Left = mClientSpaceData.RECT.Left + 1
            mClientSpaceData.RECT.Top = mClientSpaceData.RECT.Top + 3
            mClientSpaceData.RECT.Right = mClientSpaceData.RECT.Right + 2
        Else
            mClientSpaceData.RECT.Left = mClientSpaceData.RECT.Left + 1
            mClientSpaceData.RECT.Top = mClientSpaceData.RECT.Top + 1
        End If
    End If
    ' The TabStrip appearance draws a second, inner light line on the left and top edges
    If mAppearanceIsTabStrip And (Not mVisualStylesActive) Then
        mClientSpaceData.RECT.Left = mClientSpaceData.RECT.Left + 1
        mClientSpaceData.RECT.Top = mClientSpaceData.RECT.Top + 1
    End If
    ' rotate info set on DrawBody procedure
    Select Case mTabOrientation
        Case ssTabOrientationTop, ntTabOrientationTopRight
            mClientSpaceData.RECT.Top = mClientSpaceData.RECT.Top + FlatBodySeparationClientInset
            ' It is already OK
        Case ssTabOrientationBottom, ntTabOrientationBottomRight
            mClientSpaceData.RECT.Bottom = mClientSpaceData.RECT.Bottom - FlatBodySeparationClientInset
            ' flip vertical
            iLng = mClientSpaceData.LeftBottomRoundness
            mClientSpaceData.LeftBottomRoundness = mClientSpaceData.LeftTopRoundness
            mClientSpaceData.LeftTopRoundness = iLng
            iLng = mClientSpaceData.RightBottomRoundness
            mClientSpaceData.RightBottomRoundness = mClientSpaceData.RightTopRoundness
            mClientSpaceData.RightTopRoundness = iLng
        Case ssTabOrientationLeft, ntTabOrientationLeftTop, ntTabOrientationLeftHorizontal, ntTabOrientationLeftBottomHorizontal
            mClientSpaceData.RECT.Left = mClientSpaceData.RECT.Left + FlatBodySeparationClientInset
            ' rotate 90 degrees counter clock wise
            iLng = mClientSpaceData.LeftBottomRoundness
            mClientSpaceData.LeftBottomRoundness = mClientSpaceData.LeftTopRoundness
            mClientSpaceData.LeftTopRoundness = mClientSpaceData.RightTopRoundness
            mClientSpaceData.RightTopRoundness = mClientSpaceData.RightBottomRoundness
            mClientSpaceData.RightBottomRoundness = iLng
        Case Else ' ssTabOrientationRight, ntTabOrientationRightBottom, ntTabOrientationRightHorizontal, ntTabOrientationRightBottomHorizontal
            mClientSpaceData.RECT.Right = mClientSpaceData.RECT.Right - FlatBodySeparationClientInset
            ' rotate 90 degrees clock wise
            iLng = mClientSpaceData.LeftBottomRoundness
            mClientSpaceData.LeftBottomRoundness = mClientSpaceData.RightBottomRoundness
            mClientSpaceData.RightBottomRoundness = mClientSpaceData.RightTopRoundness
            mClientSpaceData.RightTopRoundness = mClientSpaceData.LeftTopRoundness
            mClientSpaceData.LeftTopRoundness = iLng
    End Select
    
    If mSubclassControlsPaintingPending Then SubclassControlsPainting
    
    If lblTDILabel.Visible Then
        lblTDILabel.Move pScaleX(mBodyRect.Left, vbPixels, UserControl.ScaleMode), pScaleY(mBodyRect.Top, vbPixels, UserControl.ScaleMode), pScaleX(mBodyRect.Right - mBodyRect.Left, vbPixels, UserControl.ScaleMode), pScaleY(mBodyRect.Bottom - mBodyRect.Top, vbPixels, UserControl.ScaleMode)
    End If

    If mRows <> mRows_Prev Then
        RaiseEvent RowsChange
    End If
    mRows_Prev = mRows
    
    FitRefitAll
    RaiseEvent_Resize

    
TheExit:
    NewTabButtonZoneRestore
    SetScaleMode
    If mTheme <> 0 Then
        CloseThemeData mTheme
        mTheme = 0
    End If
    mDrawing = False
End Sub

Private Sub UpdateMaskPicture(ByVal nBlank As Boolean)
    Dim iCtl As Object
    Dim iLeft As Long
    Dim iWidth As Long
    
    If mBackStyle = ntOpaque Then
        Set UserControl.MaskPicture = Nothing
        tmrCheckContainedControlsAdditionDesignTime.Enabled = False
        tmrCheckContainedControlsAdditionDesignTime.Interval = 1
    Else
        tmrCheckContainedControlsAdditionDesignTime.Interval = 50
        If Not mAmbientUserMode Then tmrCheckContainedControlsAdditionDesignTime.Enabled = True
        picAux.Move 0, 0, UserControl.ScaleWidth, UserControl.ScaleHeight
        If nBlank Then
            ' nothing drawn: all mask color, so only the contained controls stay visible
            picAux.Line (0, 0)-(picAux.ScaleWidth, picAux.ScaleHeight), mBackColorSelectedTab2, BF
        ElseIf mRightToLeft Then
            ' the Picture gets rendered into picAux through its RTL-layout DC, which mirrors it.
            Set picAux.Picture = RotatePic(UserControl.Picture, ntFlipHorizontal)
        Else
            Set picAux.Picture = UserControl.Picture
        End If
        
        On Error Resume Next
        For Each iCtl In UserControlContainedControls
            iLeft = -mLeftOffsetToHide
            iLeft = iCtl.Left
            If iLeft > -mLeftOffsetToHide Then
                iWidth = -1
                iWidth = iCtl.Width
                If iWidth <> -1 Then
                    picAux.Line (pScaleX(iLeft, vbTwips, vbPixels), pScaleY(iCtl.Top, vbTwips, vbPixels))-(pScaleX(iLeft + iWidth, vbTwips, vbPixels), pScaleY(iCtl.Top + iCtl.Height, vbTwips, vbPixels)), mBackColorSelectedTab2 Xor &H1, BF
                End If
            End If
        Next
        On Error GoTo 0
        If Not mAmbientUserMode Then mLastContainedControlsPositionsStr = GetContainedControlsPositionsStr
        Set UserControl.MaskPicture = picAux.Image
        Set picAux.Picture = Nothing
        picAux.Cls
    End If
End Sub

Private Sub SetScaleMode()
    Dim iSW As Long
    
    UserControl.ScaleMode = vbTwips
    If mRightToLeft Then
        iSW = UserControl.ScaleWidth
        UserControl.Scale (iSW, 0)-(0, UserControl.ScaleHeight)
    End If
End Sub

Private Sub RaiseEvent_Resize()
    Static sInside As Boolean
    Dim iBytes() As Byte
    
    If UserControl.EventsFrozen Then
        mResizeEventPending = True
    Else
        If mDrawMessagePosted Or tmrDraw.Enabled Then
            Draw
        ElseIf Not sInside Then
            sInside = True
            mResizeEventPending = False
            ReDim iBytes(LenB(mClientSpaceData))
            CopyMemory iBytes(0), mClientSpaceData, LenB(mClientSpaceData)
            If StrComp(iBytes, mClientSpaceDataPrev_Binary) <> 0 Then
                RaiseEvent Resize
                CopyMemory mClientSpaceDataPrev_Binary(0), iBytes(0), UBound(iBytes) + 1
                If mTDIMode = ntTDIModeForms Then
                    TDIResizeFormContainers
                End If
            End If
            sInside = False
        End If
    End If
End Sub

Private Sub TDIResizeFormContainers()
    Dim c As Long
    Dim iSM As Long
    Dim iContainerLeft As Single
    
    CreateClientRegion
    iSM = UserControl.ScaleMode
    UserControl.ScaleMode = vbTwips
    ' SetScaleMode carries the RTL mirroring in the UserControl's inverted Scale, and the ScaleMode
    ' = vbTwips above deliberately drops it so the twips returned by the Client* properties are
    ' taken at face value.
    iContainerLeft = ClientLeft
    For c = 1 To mTabs - 1
        If mTabData(c).Visible Then
            If IsIconic(mFormHwnd) = 0 Then
                If (mTabData(c).Data >= picTDIFormContainer.LBound) And (mTabData(c).Data <= picTDIFormContainer.UBound) Then
                    On Error Resume Next
                    picTDIFormContainer(mTabData(c).Data).Move iContainerLeft, ClientTop, ClientWidth, ClientHeight
                    SetWindowRgn picTDIFormContainer(mTabData(c).Data).hWnd, CloneRegion(mClientRegion), True
                    MoveWindow mTDIModeFormsFormData_FormHwnd(mTabData(c).Data), 0, 0, picTDIFormContainer(mTabData(c).Data).ScaleWidth + 2, picTDIFormContainer(mTabData(c).Data).ScaleHeight + 2, 1
                    On Error GoTo 0
                End If
            End If
        End If
    Next
    If iSM = vbUser Then
        SetScaleMode
    Else
        UserControl.ScaleMode = iSM
    End If
End Sub

Private Sub DrawTab(ByVal nTab As Long)
    Dim iCurv As Long
    Dim iBarLeft As Long
    Dim iLeftOffset As Long
    Dim iFillLeftOffset As Long
    Dim iRightOffset As Long
    Dim iTopOffset As Long
    Dim iPPTopLine As Long
    Dim iBottomOffset As Long
    Dim iHLPlainFillBottom As Long
    Dim iBarRight As Long
    Dim iBarRestRight As Long
    Dim iHLRoundBottom As Boolean
    Dim iHLRoundBottomFill As Boolean
    Dim iFillGradient As Long
    Dim iGradientColor As Long
    Dim iGradientColorIsSet As Boolean
    Dim iSkirtColor As Long
    Dim iHLBottomLeftRoundness As Long
    Dim iHLBottomRightRoundness As Long
    Dim iBorderFillBottomLeft As Long
    Dim iEndOpenLeft As Boolean
    Dim iEndOpenRight As Boolean
    Dim iBorderFillBottomRight As Long
    Dim iHLPillCut As Long
    Dim iHLEdgeEndY As Long
    Dim iHLBodyLineColor As Long
    Dim iHLShapeLeft As Long
    Dim iHLShapeRight As Long
    Dim iHLShapeMiddle As Long
    Dim iFlatBarTopIsBar As Boolean
    Dim iBottomOffset2 As Long
    Dim iFlatActiveLeftSkirt As Long
    Dim iHighlighted As Boolean
    Dim iTabData As T_TabData
    Dim iExtI As Long
    Dim iActive As Boolean
    Dim iState As Long
    Dim iTRect As RECT
    Dim iTRect2 As RECT
    Dim iTRect3 As RECT
    Dim iTabDrawnWidened As Boolean
    Dim iPartId As Long
    Dim iLeft As Long
    Dim iTop As Long
    Dim iRoundedTabs As Boolean
    Dim iBackColorTabs2 As Long
    Dim iBackColorTabs3 As Long
    Dim iDragGap As Long
    
    Dim i3DShadow As Long
    Dim i3DDKShadow As Long
    Dim i3DHighlight As Long
    Dim i3DHighlightH As Long
    Dim i3DHighlightV As Long
    Dim i3DShadowV As Long
    Dim i3DLight As Long
    Dim iTwinOpenLeft As Long
    Dim iTwinOpenRight As Long
    Dim iHighlightColor As Long
    Dim iHoverAnimSlot As Long
    Dim iHighlightGradient As NTHighlightGradientConstants
    Dim iLng As Long
    Dim iColor As Long
    Dim iHighlightFillToEdge As Boolean
    Dim iHighlightArcFromFill As Boolean
    Dim iFlatBarTopPaint As Boolean
    Dim iInactiveShape As Boolean
    Dim iInactiveBorderColor As Long
    Dim iSheetRightLineColor As Long
    Dim iHLEdgeX As Long
    Dim iHLBottomFromNow As Long
    Dim iHLBottomOnBody As Boolean
    Dim iHLEdgePad As Long
    Dim iHLFillLeftPad As Long
    Dim iHLFillRightPad As Long
    Dim iHLEdgeRightPad As Long
    Dim iShareRightSeparator As Boolean
    Dim iShareLeftSeparator As Long
    Dim iLineStartY As Long
    Dim iLineEndY As Long
    Dim iDrawSideLine As Boolean
    Dim iPPBodyJoin As Long
    Dim iFillCurv As Long
    Dim iFillRightInactive As Long
#If HOVERCLIPDIAG = 1 Then ' TEMP diagnostic
    Dim iDTProbeR1 As Long
    Dim iDTProbeR2 As Long
    Dim iDTProbeFills As Long
    Dim iDTProbeRight As Long
    Dim iDTProbeEnd As Long
#End If
#If TABCLIPDIAG = 1 Then ' TEMP diagnostic
    Dim iClipSavedDC As Long
#End If
    
    Dim iTabColor_BackColorTab As Long
    Dim iTabColor_BackColorSelectedTab As Long
    Dim iTabColor_FlatBarColorInactive As Long
    Dim iTabColor_FlatBarGlowColor As Long
    Dim iTabColor_FlatBarColorSelectedTab As Long
    
    iTabData = mTabData(nTab)
    ' The opening border of a tab that does not open the band goes one column before the rect, on
    ' the column that belongs to its left hand neighbour in a full row.
    If iTabData.LeftTab And Not iTabData.LeftTabBeginning Then
        iTabData.TabRect.Left = iTabData.TabRect.Left - 1
    End If
    iActive = iTabData.Selected
    iRoundedTabs = (mTabAppearance2 = ntTAPropertyPageRounded) Or (mTabAppearance2 = ntTATabbedDialogRounded) Or ((mTabAppearance2 = ntTAFlat) And ((mFlatRoundnessTopDPIScaled > 0) Or (mFlatRoundnessTabsDPIScaled > 0)))
    
    iTabColor_BackColorTab = InactiveTabBackColorForDrawing(nTab)
    iTabColor_BackColorSelectedTab = mBackColorSelectedTab2
    ' The roles are applied here, where the three colours are chosen: the bottom bar is not their
    ' only consumer, iFlatBarTopColor hands them to FillCurvedGradient2 already as RGB
    If IsEmpty(iTabData.CustomColors.FlatBarColorInactive) Then
        iTabColor_FlatBarColorInactive = mFlatBarColorInactive
    Else
        iTabColor_FlatBarColorInactive = iTabData.CustomColors.FlatBarColorInactive
    End If
    ' ntRoleFore and not ntRoleBack.
    iTabColor_FlatBarColorInactive = TranslatedColor(iTabColor_FlatBarColorInactive, ntRoleFore)
    If (IsEmpty(mTabData(nTab).CustomColors.FlatBarColorInactive)) And (IsEmpty(mTabData(nTab).CustomColors.FlatBarColorHighlighted)) Then
        iTabColor_FlatBarGlowColor = HoverBarColorFor(nTab)
    Else
        iTabColor_FlatBarGlowColor = iTabData.CustomColors.FlatBarGlowColor
    End If
    ' the bar is the one surface in the control that really is filled with the flat colour,
    ' so this is where vbHighlight belongs. Under high contrast the glow stops animating
    ' through its ten steps and simply is the system's selection colour, which is the point
    iTabColor_FlatBarGlowColor = TranslatedColor(iTabColor_FlatBarGlowColor, ntRoleHighlightBack)
    If IsEmpty(iTabData.CustomColors.FlatBarColorSelectedTab) Then
        iTabColor_FlatBarColorSelectedTab = mFlatBarColorSelectedTab
    Else
        iTabColor_FlatBarColorSelectedTab = iTabData.CustomColors.FlatBarColorSelectedTab
    End If
    ' In Flat this bar is what marks the selected tab, since there is no relief to do it, and under
    ' high contrast it takes the system's accent and not its text colour.
    iTabColor_FlatBarColorSelectedTab = TranslatedColor(iTabColor_FlatBarColorSelectedTab, ntRoleHighlightBack)
    
    If iActive Then
        iHighlighted = ((mHighlightGradientSelectedTab <> ntGradientNone) Or mAppearanceIsFlat Or mVisualStylesActive) And iTabData.Enabled
        iBackColorTabs2 = iTabColor_BackColorSelectedTab
        i3DDKShadow = m3DDKShadow_Sel
        i3DHighlightH = m3DHighlightH_Sel
        i3DHighlightV = m3DHighlightV_Sel
        i3DShadowV = m3DShadowV_Sel
        i3DShadow = m3DShadow_Sel
        i3DHighlight = m3DHighlight_Sel
        i3DLight = m3DLight_Sel
        iHighlightColor = mGlowColor_Sel
        ' The highlight is a colour like any other one and gets its disabled shade too, otherwise
        ' the body of the active tab stays at full saturation while everything around it fades.
        If (Not mEnabled) And mShowDisabledState And mAmbientUserMode Then
            ' nothing is derived under high contrast: the palette is the system's and a
            ' shade of our own is not in it
            If Not (mHandleHighContrastTheme And mHighContrastThemeOn) Then
                iHighlightColor = DisabledBackColorForDrawing(iHighlightColor)
            End If
        End If
        If mBackStyle <> ntOpaque Then iHighlightColor = iHighlightColor Xor 65538
        iGradientColorIsSet = mGradColor_Sel_IsSet
        If iGradientColorIsSet Then
            iGradientColor = mGradColor_Sel
            If (Not mEnabled) And mShowDisabledState And mAmbientUserMode Then
                If Not (mHandleHighContrastTheme And mHighContrastThemeOn) Then
                    iGradientColor = DisabledBackColorForDrawing(iGradientColor)
                End If
            End If
            If mBackStyle <> ntOpaque Then iGradientColor = iGradientColor Xor 65538
        End If
        iHighlightGradient = mHighlightGradientSelectedTab
        If DragOffsetsShown Then
            iTabData.TabRect.Left = iTabData.TabRect.Left + mDragDrawOffsetX
            iTabData.TabRect.Right = iTabData.TabRect.Right + mDragDrawOffsetX
            iTabData.TabRect.Top = iTabData.TabRect.Top + mDragDrawOffsetY
            iTabData.TabRect.Bottom = iTabData.TabRect.Bottom + mDragDrawOffsetY
        End If
    Else
        ' Or the fade out: a tab on its way out is no longer hovered and still has to be
        ' painted highlighted, or there would be nothing left to fade
        iHighlighted = mAmbientUserMode And ((mHighlightGradient <> ntGradientNone) Or mAppearanceIsFlat Or mVisualStylesActive) And (iTabData.Hovered Or (mFadeOutTab = nTab)) And (mEnabled Or (Not mAmbientUserMode)) And iTabData.Enabled
        If DragOffsetsShown Then
            iHighlighted = False
            ' Room for the dragged tab is made by drawing the other tabs of the row it
            ' would land on away from their slots, never by reordering anything. Only
            ' along the strip, and in the as-Top frame, which is the one DrawTab paints in
            iDragGap = DragGapOffset(nTab)
            iTabData.TabRect.Left = iTabData.TabRect.Left + iDragGap
            iTabData.TabRect.Right = iTabData.TabRect.Right + iDragGap
        End If
        ' The mouse's widening, on the DRAWING copy of the rect and not on the stored one, which is
        ' where the selected tab's goes.
        iTabDrawnWidened = TabIsDrawnWidened(nTab)
        If iTabDrawnWidened Then
            iTabData.TabRect.Left = iTabData.TabRect.Left - SelectedTabWideningPixels
            iTabData.TabRect.Right = iTabData.TabRect.Right + SelectedTabWideningPixels
        End If
        iBackColorTabs2 = iTabColor_BackColorTab
        i3DDKShadow = m3DDKShadow
        i3DHighlightH = m3DHighlightH
        i3DHighlightV = m3DHighlightV
        i3DShadowV = m3DShadowV
        i3DShadow = m3DShadow
        i3DHighlight = m3DHighlight
        i3DLight = m3DLight
        iHoverAnimSlot = HoverAnimSlotForTab(nTab)
        If (iHoverAnimSlot > -1) And (iTabData.Hovered Or (iHoverAnimSlot = cSlotOut)) Then
            ' Where the fade lands.
            iHighlightColor = mHoverGlowColor(iHoverAnimSlot)
        ElseIf Not IsEmpty(iTabData.CustomColors.HighlightColor) Then
            ' the general one comes from mGlowColor, which SetColors already resolved; this
            ' one is the developer's colour straight from the tab record and had never been
            ' through the mode, so a tab with its own highlight kept it under high contrast
            iHighlightColor = TranslatedColor(iTabData.CustomColors.HighlightColor, ntRoleBack)
        Else
            iHighlightColor = mGlowColor
        End If
        iGradientColorIsSet = True
        If (iHoverAnimSlot > -1) And (iTabData.Hovered Or (iHoverAnimSlot = cSlotOut)) Then
            iGradientColor = mHoverGradColor(iHoverAnimSlot)
            iGradientColorIsSet = mHoverGradActive(iHoverAnimSlot)
        ElseIf Not IsEmpty(iTabData.CustomColors.HighlightGradientColor) Then
            iGradientColor = TranslatedColor(iTabData.CustomColors.HighlightGradientColor, ntRoleBack)
        ElseIf Not mHighlightGradientColor_IsAutomatic Then
            iGradientColor = TranslatedColor(mHighlightGradientColor, ntRoleBack)
        Else
            iGradientColorIsSet = False
        End If
        iHighlightGradient = mHighlightGradient
    End If
    iBackColorTabs3 = iTabColor_BackColorSelectedTab
    ' Here and not further down: iBackColorTabs2 is nudged by a byte or two later on for the
    ' transparent back styles, and what the three routines downstream need is the colour, not
    ' that trick
    mTabData(nTab).BodyFillColor = TabBodyFillColorEffective(iHighlighted, iHighlightGradient, iHighlightColor, iBackColorTabs2)
    
    If mAppearanceIsFlat Then
        Dim iFlatBarTopColor As Long
        Dim iLineColor As Long
        Dim iFlatTabsSeparationLineColor As Long
        Dim iFlatBorderColor As Long
        Dim iFlatLeftRoundness As Long
        Dim iFlatRightRoundness As Long
        Dim iFlatLeftLineColor As Long
        Dim iFlatRightLineColor As Long
        Dim iFlatBarTopHeight As Long
        Dim iShowFlatBarBottom As Boolean
        Const cEpsilon As Single = 0.499
        Dim iFlatBarTopSet As Boolean
        Dim iFlatBarPosition As NTFlatBarPositionConstants
        Dim iHighlightFlatDrawBorder As Boolean
        Dim iHighlightFlatDrawBorder_Color As Long
        Dim iFlatBarTopVisible As Boolean
        Dim iHLBorderPercent As Long
        Dim iHLBorderBarFrom As Long
        Dim iHLBorderBottomFrom As Long
        Dim iHLBorderSplit As Long
        
        iFlatTabsSeparationLineColor = TranslatedColor(mFlatTabsSeparationLineColor, ntRoleFore)
        iFlatBorderColor = TranslatedColor(mFlatBorderColor, ntRoleFore)
        
        iFlatBarPosition = mFlatBarPosition
        If mOrientationIsBottom Then
            If iFlatBarPosition = ntBarPositionTop Then
                iFlatBarPosition = ntBarPositionBottom
            Else
                iFlatBarPosition = ntBarPositionTop
            End If
        End If
        
        iFlatBarTopVisible = (mHighlightFlatBar Or mHighlightFlatBarSelectedTab) And (iFlatBarPosition = ntBarPositionTop) And (mFlatBarHeightDPIScaled > 0)
        
        If iHighlighted And (Not iActive) Then
            If mHighlightFlatBar Or mHighlightFlatBarSelectedTab Then
                If mHighlightFlatBar Or ((iHighlightGradient <> ntGradientNone) And (iTabColor_FlatBarGlowColor = iTabColor_BackColorTab)) Then
                    iFlatBarTopColor = iTabColor_FlatBarGlowColor
                Else
                    iFlatBarTopColor = iTabColor_FlatBarColorInactive
                End If
            Else
                iFlatBarTopHeight = 1
                ' This branch runs with no flat bar, so the top row IS a line: the tab's own border
                ' when FlatBorderMode draws one round every tab, and the separation line otherwise.
                If mFlatBorderMode = ntBorderTabs Then
                    iFlatBarTopColor = iFlatBorderColor
                Else
                    iFlatBarTopColor = iFlatTabsSeparationLineColor
                End If
                iFlatBarTopSet = True
            End If
        Else
            If iActive Then
                If mHighlightFlatBarSelectedTab Then
                    iFlatBarTopColor = iTabColor_FlatBarColorSelectedTab
                Else
                    If mHighlightGradient <> ntGradientNone Then
                        iFlatBarTopHeight = 1
                        iFlatBarTopColor = iFlatBorderColor '  iHighlightColor
                        iFlatBarTopSet = True
                    Else
                        If mHighlightFlatBar Then
                            iFlatBarTopColor = iTabColor_FlatBarColorInactive
                        Else
                            iFlatBarTopHeight = 1
                            iFlatBarTopColor = iFlatBorderColor
                            iFlatBarTopSet = True
                        End If
                    End If
                End If
            Else
                If mHighlightFlatBar Or mHighlightFlatBarSelectedTab Then
                    iFlatBarTopColor = iTabColor_FlatBarColorInactive
                Else
                    iFlatBarTopHeight = 1
                    If mFlatBorderMode = ntBorderTabs Then
                        iFlatBarTopColor = iFlatBorderColor ' iFlatTabsSeparationLineColor
                    Else
                        iFlatBarTopColor = iFlatTabsSeparationLineColor
                    End If
                    iFlatBarTopSet = True
                End If
            End If
        End If
        If Not iFlatBarTopSet Then
            If iFlatBarPosition = ntBarPositionTop Then
                iFlatBarTopHeight = mFlatBarHeightDPIScaled
                If (iFlatBarTopHeight = 0) Then
                    iFlatBarTopHeight = 1
                    If (mFlatBorderMode = ntBorderTabs) Or iActive Then
                        iFlatBarTopColor = iFlatBorderColor
                    Else
                        iFlatBarTopColor = iFlatTabsSeparationLineColor
                    End If
                End If
            Else
                iFlatBarTopHeight = 1
                If mFlatBorderMode = ntBorderSelectedTab And (Not iActive) Then
                    iFlatBarTopColor = iBackColorTabs2 'iTabColor_FlatBarColorSelectedTab
                Else
                    iFlatBarTopColor = iFlatBorderColor '  iHighlightColor ' iTabColor_FlatBarColorInactive
                End If
            End If
        End If
        iFlatBarTopIsBar = (Not iFlatBarTopSet) And (iFlatBarPosition = ntBarPositionTop) And (mFlatBarHeightDPIScaled > 0)
        
        ' The border fades in with the highlight: each of its four sides mixes from the colour that was
        ' in its place before, which is a different one on each
        iHLBorderPercent = 100
        If iActive Then
            If mHighlightFlatDrawBorderSelectedTab Then
                iHighlightFlatDrawBorder = True
                iHighlightFlatDrawBorder_Color = TranslatedColor(iTabData.CustomColors.ResolvedChainColor(ntChainFlatTabBorderColorSelectedTab), ntRoleFore)
                iFlatBarTopColor = iHighlightFlatDrawBorder_Color
            End If
        Else
            iInactiveShape = mAppearanceIsFlat And mHighlightFlatShapeInactive And (mHighlightFlatDrawBorder Or Not mFlatRowEndsSquared)
            If iInactiveShape Then iInactiveBorderColor = TranslatedColor(iTabData.CustomColors.ResolvedChainColor(ntChainFlatTabBorderColorInactive), ntRoleFore)
            If mHighlightFlatDrawBorder And iHighlighted Then
                iHighlightFlatDrawBorder = True
                iHighlightFlatDrawBorder_Color = TranslatedColor(iTabData.CustomColors.ResolvedChainColor(ntChainFlatTabBorderColorHighlighted), ntRoleFore)
                iHLBorderPercent = HoverBorderPercent(nTab)
                iHLBorderBarFrom = iFlatBarTopColor
                ' before the byte or two the transparent back styles nudge into it further down
                iHLBorderBottomFrom = iBackColorTabs2
                ' At rest the shape already has its border: every side fades from it
                If iInactiveShape Then
                    iHLBorderBarFrom = iInactiveBorderColor
                    iHLBorderBottomFrom = iInactiveBorderColor
                End If
                iFlatBarTopColor = MixColors(iHLBorderBarFrom, iHighlightFlatDrawBorder_Color, iHLBorderPercent)
            ElseIf mHighlightFlatDrawBorder And iInactiveShape Then
                iHighlightFlatDrawBorder = True
                iHighlightFlatDrawBorder_Color = iInactiveBorderColor
                iFlatBarTopColor = iInactiveBorderColor
            End If
        End If
        
        ' Forced off: a highlight fill never keeps a column that carries a line. The mechanism stays,
        ' everything that reads it collapses to its pre-mechanism value
        iHighlightFillToEdge = False
        iHLEdgePad = IIf(iHighlightFillToEdge, 1, 0)
        iHLFillLeftPad = 1 - iHLEdgePad
        ' The row's last tab already had its right column filled, so there it grows by
        ' nothing; iHLEdgePad on its own is what the flat bar needs, which never carried
        ' the RightTab term
        iHLFillRightPad = IIf(iHighlightFillToEdge Or iTabData.RightTab, 1, 0)
        ' The highlight fill must not take a column that carries a border line.
        iHLEdgeRightPad = iHLEdgePad
        iShareRightSeparator = False
        If iHighlightFillToEdge And (mTabSeparation2 = 0) And (Not iTabData.RightTab) Then
            If Not (mHighlightFlatDrawBorder Or mHighlightFlatDrawBorderSelectedTab) Then
                iShareRightSeparator = True
                iHLEdgeRightPad = 0
                iHLFillRightPad = 0
            End If
        End If
        ' One column of separation between two touching tabs instead of two.
        iShareLeftSeparator = 0
        If mAppearanceIsFlat And (mTabSeparation2 = 0) And (Not iTabData.LeftTab) Then
            If Not (mHighlightFlatDrawBorder Or mHighlightFlatDrawBorderSelectedTab) Then
                iShareLeftSeparator = 1
            End If
        End If
        ' Whether the two top corners are left to the fill's own arc instead of being drawn over it.
        iHighlightArcFromFill = iHighlightFillToEdge And (iHighlightGradient <> ntGradientPlain)
        ' Whether the top bar is painted at all.
        iFlatBarTopPaint = Not (iHighlightFillToEdge And (Not mHighlightFlatBar) And (iFlatBarTopHeight > 1))
        
        ' The row's outer corners keep their roundness while the tab is highlighted with a border.
        If iTabData.LeftTab Then
            iFlatLeftRoundness = mFlatRoundnessTop2
            If mFlatRoundnessTabs2 > iFlatLeftRoundness Then
                iFlatLeftRoundness = mFlatRoundnessTabs2
            End If
        Else
            iFlatLeftRoundness = mFlatRoundnessTabs2
        End If
        If iTabData.RightTab Then
            iFlatRightRoundness = mFlatRoundnessTop2
            If mFlatRoundnessTabs2 > iFlatRightRoundness Then
                iFlatRightRoundness = mFlatRoundnessTabs2
            End If
        Else
            iFlatRightRoundness = mFlatRoundnessTabs2
        End If
        If mAppearanceIsFlat Then
            If iRoundedTabs Then
                If (iFlatLeftRoundness > 0) Then
                    If Not ((Not (iTabData.LeftTab And ((mRows > 1) And (iTabData.RowPos <> 0)))) Or mShowsRowsPerspective2 Or (mFlatRoundnessTabsDPIScaled > 0)) Then
                        If (mTabWidthStyle2 = ntTWTabCaptionWidthFillRows) Or (mTabWidthStyle2 = ntTWTabCaptionWidth) Or (mTabWidthStyle2 = ntTWEqualWidth) Or mTabsAreRotatedButCaptionsAreHorizontal Then
                            If mLeftMostTabsLeftPos2(iTabData.RowPos - 1) <= iTabData.TabRect.Left Then
                                iFlatLeftRoundness = 0
                            End If
                        Else
                            iFlatLeftRoundness = 0
                        End If
                    End If
                End If
                If (iFlatRightRoundness > 0) Then
                    If Not ((Not (iTabData.RightTab And ((mRows > 1) And (iTabData.RowPos <> 0)))) Or mShowsRowsPerspective2 Or (mFlatRoundnessTabsDPIScaled > 0)) Then
                        If (mTabWidthStyle2 = ntTWTabCaptionWidthFillRows) Or (mTabWidthStyle2 = ntTWTabCaptionWidth) Or (mTabWidthStyle2 = ntTWEqualWidth) Or mTabsAreRotatedButCaptionsAreHorizontal Then
                            If mRightMostTabsRightPos2(iTabData.RowPos - 1) >= iTabData.TabRect.Right Then
                                iFlatRightRoundness = 0
                            End If
                        Else
                            iFlatRightRoundness = 0
                        End If
                    End If
                End If
            End If
        End If
        iBorderFillBottomLeft = iFlatLeftRoundness
        iBorderFillBottomRight = iFlatRightRoundness
        If mFlatRowEndsSquared Then
            iBorderFillBottomLeft = 0
            iBorderFillBottomRight = 0
        End If
        ' A rounded end takes the highlight fill one column inside its line, as the left end does
        If iTabData.RightTab And (iFlatRightRoundness > 0) And (Not iActive) Then iHLFillRightPad = 0
        If iTabData.LeftTab Then
            iFlatLeftLineColor = IIf((mFlatBorderMode = ntBorderTabs) Or iActive, iFlatBorderColor, iFlatTabsSeparationLineColor) ' IIf(mFlatBorderMode = ntBorderTabs, iFlatBorderColor, iFlatTabsSeparationLineColor)
        Else
            iFlatLeftLineColor = IIf((mFlatBorderMode = ntBorderSelectedTab) And iActive Or (mFlatBorderMode = ntBorderTabs) And (mTabSeparationDPIScaled > 0), iFlatBorderColor, iFlatTabsSeparationLineColor)
        End If
        If iTabData.RightTab Then
            If (iTabData.RowPos = mRows - 1) Then
                iFlatRightLineColor = IIf((mFlatBorderMode = ntBorderTabs) Or iActive Or (mFlatBorderMode = ntBorderTabs) And (mTabSeparationDPIScaled > 0), iFlatBorderColor, iFlatTabsSeparationLineColor)
            Else
                iFlatRightLineColor = IIf(mFlatBorderMode = ntBorderTabs, iFlatBorderColor, iFlatTabsSeparationLineColor)
            End If
        Else
            iFlatRightLineColor = IIf(iActive And (mFlatBorderMode = ntBorderSelectedTab) Or (mFlatBorderMode = ntBorderTabs) And (mTabSeparationDPIScaled > 0), iFlatBorderColor, iFlatTabsSeparationLineColor)
        End If
        iSheetRightLineColor = iFlatRightLineColor
        If iInactiveShape And iHighlightFlatDrawBorder Then
            iFlatLeftLineColor = iInactiveBorderColor
            iFlatRightLineColor = iInactiveBorderColor
        End If
        If IIf(nTab = mTab, mHighlightFlatBarSelectedTab, mHighlightFlatBar) And (iFlatBarPosition = ntBarPositionBottom) Then
            iShowFlatBarBottom = (mFlatBarHeightDPIScaled > 0)
        End If
    End If
    
    With iTabData.TabRect
#If TABCLIPDIAG = 1 Then ' TEMP diagnostic
        ' The rect the drawing works against, which already carries the column a tab that does not
        ' open the band takes from its left hand neighbour.
        iClipSavedDC = SaveDC(picDraw.hDC)
        IntersectClipRect picDraw.hDC, .Left, .Top, .Right + 1, .Bottom + 1
#End If
        If mVisualStylesActive Then
            If iActive Then
                ' A theme's inactive tab paints its border on its right edge only, and the selected
                ' tab paints both.
                If Not SelectedTabIsWidened Then
                    If (Not iTabData.LeftTab) And (mTabSeparation2 = 0) Then
                        .Left = .Left - 1
                    End If
                End If
                If iTabData.RightTabEnding Then
                    ' Against the body's own border line and not against the end of the canvas, and
                    ' not two columns past that line either.
                    If (mBodyWidth - mThemedRightMarginAsTop - .Right) < 2 Then
                        .Right = mBodyWidth - mThemedRightMarginAsTop
                    End If
                End If
                ' Same reasoning at the other end: this pins the active first tab to the start
                ' of the band, which is column 0 only when the pane is not mirrored
                If iTabData.LeftTab Then
                    If .Left < 4 + mThemedBandShift Then
                        .Left = mThemedBandShift
                    End If
                End If
            End If
            If Not iTabData.Enabled Then
                iState = TIS_DISABLED
            ElseIf ((iActive And ControlHasFocus) And (Not mShowFocusRect) And mAmbientUserMode) Or iActive And mOrientationIsBottomOrRight Then ' [BOTTOMRIGHTGROUP]
                iState = TIS_SELECTED ' I had to put TIS_SELECTED instead of TIS_FOCUSED before
            ElseIf iActive Then
                iState = TIS_SELECTED
            ElseIf iHighlighted And (mHighlightGradient <> ntGradientNone) Then
                iState = TIS_HOT
            Else
                iState = TIS_NORMAL
            End If
            
            If mTabSeparation2 = 0 Then
                ' RightTab asked first on purpose, even though a tab alone in its row is both first
                ' and last.
                iPartId = IIf(iTabData.RightTab, TABP_TABITEMRIGHTEDGE, IIf(iTabData.LeftTab, TABP_TABITEMLEFTEDGE, TABP_TABITEM))
            Else
                iPartId = TABP_TABITEMLEFTEDGE
            End If
#If ROWWIDTHDIAG_DTDIAG = 1 Then ' TEMP diagnostic
            If (mDrawTabDiagCount < 400) And mAmbientUserMode Then
                mDrawTabDiagCount = mDrawTabDiagCount + 1
                Debug.Print "DTDIAG  t="; nTab;
                Debug.Print " row="; iTabData.RowPos;
                Debug.Print " active="; Abs(iActive);
                Debug.Print " leftTab="; Abs(iTabData.LeftTab);
                Debug.Print " rightTab="; Abs(iTabData.RightTab);
                Debug.Print " ending="; Abs(iTabData.RightTabEnding);
                Debug.Print " rectL="; .Left;
                Debug.Print " rectR="; .Right;
                Debug.Print " part="; iPartId;
                Debug.Print " state="; iState;
                Debug.Print " btnFace="; Abs(mBackColor = vbButtonFace)
            End If
#End If
            If (mBackColor = vbButtonFace) And (Not (iTabData.RightTab Or (iState = TIS_FOCUSED)) Or (mTabSeparation2 > 0)) Then
                iTRect.Top = .Top
                iTRect.Left = .Left
                iTRect.Right = .Right + 1
                iTRect.Bottom = .Bottom + 1
                If Not iActive Then
                    If (mTabSeparation2 > 0) Then
                        If iTabData.RightTab Then
                            iTRect.Bottom = iTRect.Bottom + 1
                        End If
                    End If
                End If
                If mTabData(nTab).RowPos <> mRows - 1 Then
                    ' reaches the page behind
                    iTRect.Bottom = iTRect.Bottom + mBacksheetTopInsetDPIScaled - 1
                End If
                iTRect2 = iTRect
                iTRect2.Bottom = iTRect.Bottom + 1
                ' A widened tab needs the two side borders here too, and this is the branch a middle
                ' tab actually takes - the picAux one below is only for the last tab of a row, a
                ' focused tab, or a BackColor of its own.
                If iTabDrawnWidened Then
                    iTRect3 = iTRect
                    iTRect3.Right = (iTRect.Left + iTRect.Right) \ 2
                    DrawThemeBackground mTheme, picDraw.hDC, TABP_TABITEMLEFTEDGE, iState, iTRect2, iTRect3
                    iTRect3.Left = iTRect3.Right
                    iTRect3.Right = iTRect.Right
                    iTRect2.Right = iTRect.Right + cThemedRightEdgePartInset
                    DrawThemeBackground mTheme, picDraw.hDC, TABP_TABITEMRIGHTEDGE, iState, iTRect2, iTRect3
                Else
                    DrawThemeBackground mTheme, picDraw.hDC, iPartId, iState, iTRect2, iTRect
                End If
#If ROWWIDTHDIAG_DTDIAG = 1 Then ' TEMP diagnostic
                If (mDrawTabDiagCount < 400) And mAmbientUserMode Then
                    mDrawTabDiagCount = mDrawTabDiagCount + 1
                    Debug.Print "DTDIAG  directa t="; nTab; " L="; iTRect.Left; " R="; iTRect.Right; " T="; iTRect.Top; " B="; iTRect.Bottom
                End If
#End If
            Else
                iTRect.Left = 0
                iTRect.Top = 0
                iTRect.Bottom = .Bottom - .Top
                iTRect.Bottom = iTRect.Bottom + 1
                If Not iActive Then
                    If iTabData.RightTab Then
                        iTRect.Bottom = iTRect.Bottom + 1
                    End If
                End If
                If mTabData(nTab).RowPos <> mRows - 1 Then
                    ' reaches the page behind
                    iTRect.Bottom = iTRect.Bottom + mBacksheetTopInsetDPIScaled - 1
                End If
                iTRect.Right = .Right - .Left + 1
                ' Or widened: its right side is drawn by RIGHTEDGE in the two pass composition
                ' below, so it needs the same compensation. Without it the border of a widened
                ' tab landed two columns inside its own right edge
                If (iPartId = TABP_TABITEMRIGHTEDGE) Or iTabDrawnWidened Then
                    ' Two columns wider than the rect for a row's last tab, always, with no test on
                    ' RightTabEnding: TABITEMRIGHTEDGE lays its border two columns short of the
                    ' rect's end.
                    iTRect.Right = iTRect.Right + cThemedRightEdgePartInset
                End If
                iLeft = .Left
                iTop = .Top
                On Error Resume Next
                picAux.Width = iTRect.Right
                picAux.Height = iTRect.Bottom
                picAux.Cls
                
                iTRect2 = iTRect
                ' One row taller than the clip rect for all twelve orientations.
                iTRect2.Bottom = iTRect.Bottom + 1
                ' Or widened: a tab painted past its own rect needs the two side borders for the
                ' same reason the lone tab of a row does.
                If ((iPartId = TABP_TABITEMRIGHTEDGE) And iTabData.LeftTab) Or iTabDrawnWidened Then
                    ' The only tab in its row needs both side edges and no single part of the theme has
                    ' them: LEFTEDGE paints no right border, RIGHTEDGE no left one and BOTHEDGE neither
                    iTRect3 = iTRect
                    iTRect3.Right = iTRect.Right \ 2
                    DrawThemeBackground mTheme, picAux.hDC, TABP_TABITEMLEFTEDGE, iState, iTRect2, iTRect3
                    iTRect3.Left = iTRect3.Right
                    iTRect3.Right = iTRect.Right
                    DrawThemeBackground mTheme, picAux.hDC, TABP_TABITEMRIGHTEDGE, iState, iTRect2, iTRect3
                Else
                    DrawThemeBackground mTheme, picAux.hDC, iPartId, iState, iTRect2, iTRect
                End If
                ' A widened tab answers yes to both edges here too, or the mask would leave the
                ' corners of the borders just composed above uncut on one side and cut on the
                ' other
                SetThemedTabTransparentPixels iTabData.LeftTab Or iTabDrawnWidened, (iState = TIS_FOCUSED) Or iTabData.RightTab Or iTabDrawnWidened, (iTabData.TopTab Or (mTabSeparation2 > 0)) And Not (iState = TIS_SELECTED)
                Call TransparentBlt(picDraw.hDC, iLeft, iTop, iTRect.Right, iTRect.Bottom, picAux.hDC, 0, 0, iTRect.Right, iTRect.Bottom, cAuxTransparentColor)
#If ROWWIDTHDIAG_DTDIAG = 1 Then ' TEMP diagnostic
                If (mDrawTabDiagCount < 400) And mAmbientUserMode Then
                    mDrawTabDiagCount = mDrawTabDiagCount + 1
                    Debug.Print "DTDIAG  picAux t="; nTab; " x="; iLeft; " y="; iTop; " w="; iTRect.Right; " h="; iTRect.Bottom; " auxW="; picAux.ScaleWidth; " auxH="; picAux.ScaleHeight
                End If
#End If
                picAux.Cls
                On Error GoTo 0
            End If
        Else
            ' Set here and not in the 'top line' block below, where what it means is explained:
            ' the active tab's fill has to stop on the same row the side borders join the body
            ' on, and both read it
            If mAppearanceIsPP Then
                If mOrientationIsBottomOrRight Then ' [BOTTOMRIGHTGROUP]
                    iPPTopLine = 1
                Else
                    iPPTopLine = 0
                End If
            End If
            If iActive Then
                ' active tab background
                If mAppearanceIsPP Then
                    iExtI = 1
                    iLeftOffset = -1
                    ' 0 and not 1: with 1 the fill bled one column past .Right in Bottom and Right
                    iRightOffset = 0
                    ' 1 and not 0: the property page top border is drawn on .Top + 1 with no iActive term
                    iTopOffset = 1
                    ' iPPTopLine and not a flat 1: the same term the side borders take for their
                    ' join further down. The fill has to cover the body's frame row under the tab
                    ' and stop there.
                    iBottomOffset = iPPTopLine
                    If iRoundedTabs Then
                        iCurv = 3
                    Else
                        iCurv = 2
                    End If
                ElseIf mAppearanceIsFlat Then
                    iBottomOffset = 4
                    iExtI = -3
                    If iTabData.LeftTab Then
                        iLeftOffset = -2
                        iFlatActiveLeftSkirt = 3
                        iBottomOffset = iBottomOffset + iFlatActiveLeftSkirt
                        iExtI = iExtI - 3
                    End If
                    iBottomOffset2 = iBottomOffset + mFlatBodySeparationLineHeightDPIScaled - 1
                Else
                    iExtI = 1
                    If iRoundedTabs Then
                        iLeftOffset = -1
                    Else
                        iLeftOffset = 0
                    End If
                    iRightOffset = 0
                    iTopOffset = 0
                    iBottomOffset = 2
                    iCurv = 4
                End If
            Else
                ' inactive tab background
                iExtI = 6
                If mAppearanceIsPP Then
                    iLeftOffset = -1
                    iRightOffset = 0
                    iTopOffset = 1 '2
                    iBottomOffset = 5
                    If iRoundedTabs Then
                        iCurv = 3
                    Else
                        iCurv = 2
                    End If
                ElseIf mAppearanceIsFlat Then
                    iBottomOffset = 6 ' 2
                    If iTabData.LeftTab Then
                        iLeftOffset = -2
                    End If
                    If iTabData.RowPos = (mRows - 1) Then
                        If iFlatLeftRoundness + 4 > iBottomOffset Then iBottomOffset = iFlatLeftRoundness + 4
                        If iFlatRightRoundness + 4 > iBottomOffset Then iBottomOffset = iFlatRightRoundness + 4
                    End If
                    If iTabData.RightTab Then
                        If Abs(mBodyRect.Right - iTabData.TabRect.Right) > 5 Then
                            iBottomOffset = 11
                            If (iTabData.RowPos <> (mRows - 1)) And (iShowFlatBarBottom) Then
                                iBottomOffset = iBottomOffset - 5 ' - 2
                                iExtI = iExtI - 3
                            Else
                                iExtI = 0 ' -5
                            End If
                        End If
                    End If
                    iBottomOffset2 = iBottomOffset
                    If (iTabData.RowPos <> (mRows - 1)) And (iShowFlatBarBottom) Then
                        iExtI = iExtI - 3
                    ElseIf iTabData.RightTab And Not (iTabData.RowPos = mRows - 1) Then
                        iBottomOffset2 = 6
                        iExtI = iExtI - 5
                    End If
                Else
                    ' Same rule as the active tab above: this offset feeds the top line and the top left
                    ' corner diagonal, which sit on the same column whether the tab is selected or not
                    If iRoundedTabs Then
                        iLeftOffset = -1
                    Else
                        iLeftOffset = 0
                    End If
                    iTopOffset = 0
                    iRightOffset = -1
                    iBottomOffset = 6
                    iCurv = 3
                End If
            End If
            If (Not iActive) And (iTabData.RowPos <> mRows - 1) Then
                ' The literals above reach a page behind that starts cBacksheetTopInset below
                iBottomOffset = iBottomOffset + mBacksheetTopInsetDPIScaled - cBacksheetTopInset
                If mAppearanceIsFlat Then
                    iBottomOffset2 = iBottomOffset2 + mBacksheetTopInsetDPIScaled - cBacksheetTopInset
                Else
                    iExtI = iExtI + mBacksheetTopInsetDPIScaled - cBacksheetTopInset
                End If
            End If
            ' Where the fill starts and where the outline starts are two different quantities and
            ' only look like one.
            iFillLeftOffset = iLeftOffset
            If (Not mAppearanceIsPP) And (Not mAppearanceIsFlat) And (Not iActive) Then
                iFillLeftOffset = iLeftOffset - 1
            End If
            ' The curve every fill that starts on .Left + iFillLeftOffset + 1 has to take.
            iFillCurv = iCurv
            If mAppearanceIsPP Then
                iFillCurv = iCurv - 1
            End If
            ' An inactive tab's fills stop on the column the resting fill stops on: a highlight fill
            ' never keeps a column that carries a line (24.83, 24.87). The active tab keeps
            ' its .Right + 2, where the skirt meets the body frame
            iFillRightInactive = .Right + iRightOffset
            ' away from the mask colour, so the selected tab stays opaque
            If iActive And (mBackStyle = ntTransparentBackOnly) Then iBackColorTabs2 = iBackColorTabs2 Xor 257
            ' The skirt and the resting fill stay on iBackColorTabs2: they are body, not gradient
            If Not iGradientColorIsSet Then iGradientColor = iBackColorTabs2
            ' Below .Bottom an inactive tab is still tab, and the active one is already body
            If iActive Then iSkirtColor = iBackColorTabs2 Else iSkirtColor = iGradientColor
            
            ' With ntHLRoundBottom the tab is filled as at rest and the highlight is painted over it further down
            iHLRoundBottom = mAppearanceIsFlat And (iHighlighted Or iInactiveShape) And IIf(iActive, mHighlightRoundBottomSelectedTab, mHighlightRoundBottom) And (Not mFlatRowEndsSquared)
            If iHLRoundBottom Then
                iHLBottomLeftRoundness = iFlatLeftRoundness
                iHLBottomRightRoundness = iFlatRightRoundness
                ' Where the shape stops is the same for every tab; only the corners depend on the tab's own roundness
                iHLRoundBottom = (mFlatRoundnessTop2 > 0) Or (mFlatRoundnessTabs2 > 0)
                If iHLRoundBottom Then
                    ' A shape closed at the bottom stops short of the gap, and of the bar below it. On the
                    ' front row it also stops short of the body's first row
                    iHLPillCut = mFlatTabBodyGapDPIScaled
                    If (iHLPillCut > 0) And iShowFlatBarBottom Then iHLPillCut = iHLPillCut + mFlatBarHeightDPIScaled
                    If iTabData.RowPos = (mRows - 1) Then
                        ' With no gap the shape ends on the body's first row, hovered or active alike
                        If mFlatTabBodyGapDPIScaled = 0 Then
                            iHLPillCut = .Bottom + 1 - mBodyStart
                            If iHLPillCut < 0 Then iHLPillCut = 0
                        Else
                            iHLPillCut = iHLPillCut + 1
                        End If
                    End If
                End If
            End If
            ' A square tab with a border ends on the body's first row too, as the rounded ones do
            If (Not iHLRoundBottom) And mAppearanceIsFlat And (iHighlighted Or iInactiveShape) And iHighlightFlatDrawBorder And (iTabData.RowPos = (mRows - 1)) Then
                iHLRoundBottom = True
                iHLBottomLeftRoundness = 0
                iHLBottomRightRoundness = 0
                iHLPillCut = 1
            End If
            iHLRoundBottomFill = iHLRoundBottom And iHighlighted And (iHighlightGradient <> ntGradientNone)
            ' A front-row end over a rounded body corner is open: around its curve shows what is behind the strip there
            iEndOpenLeft = iHLRoundBottom And (Not iInactiveShape) And iTabData.LeftTab And ((.Left + iLeftOffset - iShareLeftSeparator) <= 0) And (iTabData.RowPos = (mRows - 1)) And mFlatBodyTopLeftRounded And (iHLBottomLeftRoundness > 0)
            iEndOpenRight = iHLRoundBottom And (Not iInactiveShape) And iTabData.RightTab And (.Right >= (mBodyWidth - 1)) And (iTabData.RowPos = (mRows - 1)) And mFlatBodyTopRightRounded And (iHLBottomRightRoundness > 0)
            ' A capsule with no border has no line across its top either
            If iInactiveShape And iHLRoundBottom And (Not iHighlightFlatDrawBorder) And iFlatBarTopSet Then iFlatBarTopPaint = False
            iFillGradient = iHighlightGradient
            If iHLRoundBottomFill Then iFillGradient = ntGradientNone
            If mAppearanceIsFlat Then
                If iInactiveShape And iHLRoundBottom Then
                    ' Past the row in front, the end of a back row keeps its sheet under the capsule
                    If iTabData.RightTab And (iTabData.RowPos < (mRows - 1)) And (Not iActive) Then
                        FillCurvedGradient2 .Right + 1 - iHLBottomRightRoundness, .Bottom + 1 - iHLPillCut - iHLBottomRightRoundness, .Right + 1, .Bottom + 1 - iHLPillCut, iTabColor_BackColorTab, iTabColor_BackColorTab, 0, 0
                        FillCurvedGradient2 .Left + iLeftOffset + 1 - iShareLeftSeparator, .Bottom + 1 - iHLPillCut, .Right + 1, .Bottom + iBottomOffset2, iTabColor_BackColorTab, iTabColor_BackColorTab, 0, 0
                        If iSheetRightLineColor <> iTabColor_BackColorTab Then picDraw.Line (.Right, .Bottom + 1 - iHLPillCut - iHLBottomRightRoundness)-(.Right, .Bottom + iBottomOffset + iExtI), iSheetRightLineColor
                    End If
                    ' No resting rectangle: around the capsule the strip shows through
                    If Not iHLRoundBottomFill Then
                        FillCurvedGradient2 .Left + iLeftOffset + 1 - iShareLeftSeparator, .Top + iTopOffset, IIf(iHighlightFlatDrawBorder, .Right + iRightOffset + IIf(iTabData.RightTab, 1, 0), .Right + iRightOffset + iHLFillRightPad), .Bottom + 1 - iHLPillCut, iBackColorTabs2, iBackColorTabs2, iFlatLeftRoundness, iFlatRightRoundness, iHLBottomLeftRoundness, iHLBottomRightRoundness
                    End If
                ElseIf iHighlighted Then
                    If iFillGradient = ntGradientSimple Then
                        Call FillCurvedGradient2(.Left + iLeftOffset + iHLFillLeftPad - iShareLeftSeparator, .Top + iTopOffset, .Right + iRightOffset + iHLFillRightPad, (.Bottom), iHighlightColor, iGradientColor, iFlatLeftRoundness, iFlatRightRoundness)
                        If iHighlightFlatDrawBorder Then
                            Call FillCurvedGradient2(.Left + iLeftOffset + 1 - iShareLeftSeparator, .Bottom, .Right + iRightOffset + IIf(iTabData.RightTab, 1, 0), (.Bottom + 1), iSkirtColor, iSkirtColor, 0, 0, iBorderFillBottomLeft, iBorderFillBottomRight)
                        Else
                            Call FillCurvedGradient2(.Left + iLeftOffset + iHLFillLeftPad - iShareLeftSeparator, .Bottom, .Right + iRightOffset + iHLFillRightPad, (.Bottom + iBottomOffset2), iSkirtColor, iSkirtColor, 0, 0)
                        End If
                    ElseIf iFillGradient = ntGradientDouble Then
                        ' The two halves meet at the middle row and nowhere else.
                        Call FillCurvedGradient2(.Left + iLeftOffset + iHLFillLeftPad - iShareLeftSeparator, .Top + iTopOffset, .Right + iRightOffset + iHLEdgeRightPad, (.Bottom + .Top + iTopOffset) / 2, iGradientColor, iHighlightColor, iFlatLeftRoundness, iFlatRightRoundness)
                        Call FillCurvedGradient2(.Left + iLeftOffset + iHLFillLeftPad - iShareLeftSeparator, (.Bottom + .Top + iTopOffset) / 2, .Right + iRightOffset + iHLEdgeRightPad, .Bottom, iHighlightColor, iGradientColor, 0, 0)
                        If iHighlightFlatDrawBorder Then
                            Call FillCurvedGradient2(.Left + iLeftOffset + 1 - iShareLeftSeparator, .Bottom, .Right + iRightOffset, .Bottom + 1, iSkirtColor, iSkirtColor, 0, 0, iBorderFillBottomLeft, iBorderFillBottomRight)
                        Else
                            Call FillCurvedGradient2(.Left + iLeftOffset + iHLFillLeftPad - iShareLeftSeparator, .Bottom, .Right + iRightOffset + iHLEdgeRightPad, .Bottom + iBottomOffset2, iSkirtColor, iSkirtColor, 0, 0)
                        End If
                    ElseIf iFillGradient = ntGradientPlain Then
                        If iHighlightFlatDrawBorder Then
                            Call FillCurvedGradient2(.Left + iLeftOffset + 1 - iShareLeftSeparator, .Top + iTopOffset, .Right + iRightOffset + IIf(iTabData.RightTab, 1, 0), (.Bottom + 1), iHighlightColor, iHighlightColor, iFlatLeftRoundness, iFlatRightRoundness, iBorderFillBottomLeft, iBorderFillBottomRight)
                        Else
                            ' The active tab's highlight stops on the last row of the body separation line
                            iHLPlainFillBottom = .Bottom + iBottomOffset2 - iFlatActiveLeftSkirt
                            If iActive Then iHLPlainFillBottom = mBodyStart + mFlatBodySeparationLineHeightDPIScaled
                            Call FillCurvedGradient2(.Left + iLeftOffset + iHLFillLeftPad - iShareLeftSeparator, .Top + iTopOffset, .Right + iRightOffset + iHLFillRightPad, iHLPlainFillBottom, iHighlightColor, iHighlightColor, iFlatLeftRoundness, iFlatRightRoundness)
                            If iFlatActiveLeftSkirt > 0 Then
                                ' The extra rows of the active left tab cover the body corner: they keep the face colour, as ntGradientSimple does
                                Call FillCurvedGradient2(.Left + iLeftOffset + iHLFillLeftPad - iShareLeftSeparator, iHLPlainFillBottom, .Right + iRightOffset + iHLFillRightPad, .Bottom + iBottomOffset2, iBackColorTabs2, iBackColorTabs2, 0, 0)
                            End If
                        End If
                    ElseIf iFillGradient = ntGradientNone Then
                        ' Drawn over the body, a shape closed at the bottom puts nothing below its own bottom. In the
                        ' first pass the resting skirt is kept, as the cached strip has it
                        Call FillCurvedGradient2(.Left + iLeftOffset + 1 - iShareLeftSeparator, .Top + iTopOffset, .Right + iRightOffset + IIf(iTabData.RightTab, 1, 0), IIf(iHLRoundBottom And (iActive Or mDrawingTabsOverBody), .Bottom + 1 - iHLPillCut, .Bottom + iBottomOffset2), iBackColorTabs2, iBackColorTabs2, iFlatLeftRoundness, iFlatRightRoundness)
                    End If
                Else
                    If iHighlightFlatDrawBorder Then
                        Call FillCurvedGradient2(.Left + iLeftOffset + 1 - iShareLeftSeparator, .Top + iTopOffset, .Right + iRightOffset, .Bottom + 1, iBackColorTabs2, iBackColorTabs2, iFlatLeftRoundness, iFlatRightRoundness, iBorderFillBottomLeft, iBorderFillBottomRight)
                    Else
                        Call FillCurvedGradient2(.Left + iLeftOffset + 1 - iShareLeftSeparator, .Top + iTopOffset, .Right + iRightOffset, .Bottom + iBottomOffset2, iBackColorTabs2, iBackColorTabs2, iFlatLeftRoundness, iFlatRightRoundness)
                    End If
                End If
                If (iTabData.RowPos < (mRows - 1)) And iTabData.LeftTab And (Not iActive) And Not (iInactiveShape And iHLRoundBottom) Then
                    Call FillCurvedGradient2(.Left + iLeftOffset + 1 - iShareLeftSeparator, .Bottom + iBottomOffset2, .Right + iRightOffset, .Bottom + iBottomOffset2 + iFlatLeftRoundness / 2, iBackColorTabs2, iBackColorTabs2, 0, 0)
                End If
                If iHLRoundBottomFill And (iEndOpenLeft Or iEndOpenRight) Then
                    ' The selected tab is drawn after the body: it stops above it, not to cover the body's corner
                    iHLEdgeEndY = mBodyStart + mFlatRoundnessTopDPIScaled + 1
                    If mDrawingTabsOverBody Or iActive Then iHLEdgeEndY = mBodyStart
                    If iEndOpenLeft Then
                        iLng = MixColors(iBackColorTabs2, FlatStripEndBehindColor(True), iHLBorderPercent)
                        FillCurvedGradient2 0, .Bottom + 1 - iHLPillCut - iHLBottomLeftRoundness, .Left + iLeftOffset + 1 - iShareLeftSeparator + iHLBottomLeftRoundness, iHLEdgeEndY, iLng, iLng, 0, 0
                    End If
                    If iEndOpenRight Then
                        iLng = MixColors(iBackColorTabs2, FlatStripEndBehindColor(False), iHLBorderPercent)
                        FillCurvedGradient2 .Right + iRightOffset + 1 - iHLBottomRightRoundness, .Bottom + 1 - iHLPillCut - iHLBottomRightRoundness, .Right + 1, iHLEdgeEndY, iLng, iLng, 0, 0
                    End If
                End If
                If iHLRoundBottomFill Then
                    iHLShapeLeft = .Left + iLeftOffset + 1 - iShareLeftSeparator
                    If iHighlightFlatDrawBorder Then
                        iHLShapeRight = .Right + iRightOffset + IIf(iTabData.RightTab, 1, 0)
                    Else
                        iHLShapeRight = .Right + iRightOffset + iHLFillRightPad
                    End If
                    If iHighlightGradient = ntGradientSimple Then
                        FillCurvedGradient2 iHLShapeLeft, .Top + iTopOffset, iHLShapeRight, .Bottom + 1 - iHLPillCut, iHighlightColor, iGradientColor, iFlatLeftRoundness, iFlatRightRoundness, iHLBottomLeftRoundness, iHLBottomRightRoundness
                    ElseIf iHighlightGradient = ntGradientDouble Then
                        iHLShapeMiddle = (.Bottom + 1 - iHLPillCut + .Top + iTopOffset) \ 2
                        FillCurvedGradient2 iHLShapeLeft, .Top + iTopOffset, iHLShapeRight, iHLShapeMiddle, iGradientColor, iHighlightColor, iFlatLeftRoundness, iFlatRightRoundness
                        FillCurvedGradient2 iHLShapeLeft, iHLShapeMiddle, iHLShapeRight, .Bottom + 1 - iHLPillCut, iHighlightColor, iGradientColor, 0, 0, iHLBottomLeftRoundness, iHLBottomRightRoundness
                    Else
                        FillCurvedGradient2 iHLShapeLeft, .Top + iTopOffset, iHLShapeRight, .Bottom + 1 - iHLPillCut, iHighlightColor, iHighlightColor, iFlatLeftRoundness, iFlatRightRoundness, iHLBottomLeftRoundness, iHLBottomRightRoundness
                    End If
                End If
            Else
                If iHighlighted Then
                    If iHighlightGradient = ntGradientSimple Then
                        Call FillCurvedGradient(.Left + iFillLeftOffset, .Top + iTopOffset, .Right + iRightOffset + IIf(iTabData.RightTab, 1, 0), (.Bottom), iHighlightColor, iGradientColor, iCurv, True, True)
                        ' The skirt measures its right end against .Right, the column the tab's own
                        ' dark border is drawn on, and NOT against .Right + iRightOffset.
                        Call FillCurvedGradient(.Left + iFillLeftOffset + 2, .Bottom, IIf(iActive, .Right + 2 + IIf(iTabData.RightTab, 1, 0), iFillRightInactive), (.Bottom + iBottomOffset), iSkirtColor, iSkirtColor, iCurv, False, False)
                    ElseIf iHighlightGradient = ntGradientDouble Then
                        ' FillCurvedGradientR paints a closed range (Top To Bottom) and FillCurvedGradient2 stops one
                        ' short, so ending the first half on the middle row leaves no seam.
                        ' -1 and not iCurv on the second half: False, False with iCurveValue >= 1 falls into the
                        ' 'curve right' branch and comes out short on the right
                        Call FillCurvedGradient(.Left + iFillLeftOffset + 1, .Top + iTopOffset, .Right + iRightOffset, (.Bottom + .Top + iTopOffset) / 2, iGradientColor, iHighlightColor, iFillCurv, True, True)
                        Call FillCurvedGradient(.Left + iFillLeftOffset + 2, (.Bottom + .Top + iTopOffset) / 2, .Right + iRightOffset, .Bottom, iHighlightColor, iGradientColor, -1, False, False)
                        ' Same right end as the simple gradient's skirt, and for the same reason.
                        Call FillCurvedGradient(.Left + iFillLeftOffset + 2, .Bottom, IIf(iActive, .Right + 2, iFillRightInactive), .Bottom + iBottomOffset, iSkirtColor, iSkirtColor, iCurv, False, False)
                    ElseIf iHighlightGradient = ntGradientPlain Then
                        ' The highlight takes the whole visible piece, sheet included: cut on .Bottom, a back
                        ' row tab looks clipped
                        Call FillCurvedGradient(.Left + iFillLeftOffset + 1, .Top + iTopOffset, IIf(iActive, .Right + iRightOffset + IIf(iTabData.RightTab, 1, 0), iFillRightInactive), (.Bottom + iBottomOffset), iHighlightColor, iHighlightColor, iFillCurv, True, True)
                    ElseIf iHighlightGradient = ntGradientNone Then
                        Call FillCurvedGradient(.Left + iFillLeftOffset + 1, .Top + iTopOffset, IIf(iActive, .Right + iRightOffset + IIf(iTabData.RightTab, 1, 0), iFillRightInactive), (.Bottom + iBottomOffset), iBackColorTabs2, iBackColorTabs2, iFillCurv, True, True)
                    End If
                Else
                    ' One step less of curve in property page without rounded corners.
                    Call FillCurvedGradient(.Left + iFillLeftOffset + 1, .Top + iTopOffset, .Right + iRightOffset, .Bottom + iBottomOffset, iBackColorTabs2, iBackColorTabs2, iFillCurv, True, True)
                End If
            End If
            
#If HOVERCLIPDIAG = 1 Then ' TEMP diagnostic
            iDTProbeFills = picDraw.Point(mHoverClipDiagProbeX, mHoverClipDiagProbeY)
            iDTProbeR1 = -1
            iDTProbeR2 = -1
#End If
            'top line
            If mAppearanceIsPP Then
                ' Which row the outer edge of the strip lives on.
                If iRoundedTabs Then
                    picDraw.Line (.Left + iLeftOffset + 4, .Top + iPPTopLine)-(.Right - 2, .Top + iPPTopLine), i3DHighlightH
                Else
                    ' .Left + iLeftOffset + 3 for all twelve: the column before it belongs to the
                    ' corner step.
                    picDraw.Line (.Left + iLeftOffset + 3, .Top + iPPTopLine)-(.Right - 1, .Top + iPPTopLine), i3DHighlightH
                End If
                ' The TabStrip's second light row, one row inside the first and on the same columns.
                If mAppearanceIsTabStrip And (iPPTopLine = 0) Then
                    If iRoundedTabs Then
                        picDraw.Line (.Left + iLeftOffset + 4, .Top + 1)-(.Right - 2, .Top + 1), i3DLight
                    Else
                        picDraw.Line (.Left + iLeftOffset + 3, .Top + 1)-(.Right - 1, .Top + 1), i3DLight
                    End If
                End If
                If iPPTopLine = 1 Then
                    ' Line does not paint its end point, so both rows take .Right - 1 to stop on
                    ' .Right - 2. The rounded one stops on .Right - 3, where its corner starts
                    If iRoundedTabs Then
                        picDraw.Line (.Left + iLeftOffset + 4, .Top)-(.Right - 2, .Top), i3DDKShadow
                    Else
                        picDraw.Line (.Left + iLeftOffset + 3, .Top)-(.Right - 1, .Top), i3DDKShadow
                    End If
                End If
            ElseIf mAppearanceIsFlat Then
                If (iFlatBarTopHeight > 0) And iFlatBarTopPaint Then
                    ' The bar goes to the same far edge the fill does.
                    ' Inside a row the shared separator column gets the bar of the tab before it. At the
                    ' start of the scroll window that tab is outside, so the first tab takes the column
                    ' and the one outside paints no bar there.
                    iBarLeft = .Left + iLeftOffset
                    iBarRight = .Right + iRightOffset + 1
                    ' The selected tab's bar caps its side lines when they are border lines, the left one on the
                    ' shared column; over a plain separator it ends where the fill does
                    If iActive And iFlatBarTopIsBar And (Not iTabData.RightTab) And (iFlatRightLineColor = iFlatTabsSeparationLineColor) Then
                        ' The shared column keeps the resting bar, as it does next to a hovered tab
                        iBarRight = iBarRight - 1
                        If Not (mStripScrolls And ((.Right + iRightOffset) < mScrollViewLeft)) Then FillCurvedGradient2 iBarRight, .Top + iTopOffset, iBarRight + 1, .Top + iTopOffset + iFlatBarTopHeight, iTabColor_FlatBarColorInactive, iTabColor_FlatBarColorInactive, 0, 0
                    End If
                    If iActive And iFlatBarTopIsBar And (iShareLeftSeparator = 1) And (iFlatLeftRoundness = 0) And (iFlatLeftLineColor <> iFlatTabsSeparationLineColor) Then
                        iBarLeft = iBarLeft - 1
                    ElseIf mStripScrolls And (iShareLeftSeparator = 1) Then
                        If Not ScrollLeftNeighborShown(nTab) Then iBarLeft = iBarLeft - 1
                    End If
                    If Not (mStripScrolls And ((.Right + iRightOffset) < mScrollViewLeft)) Then
                        If iHighlighted And (Not iActive) And iFlatBarTopIsBar And (mTabSeparation2 = 0) Then
                            If Not (mHighlightFlatDrawBorder Or mHighlightFlatDrawBorderSelectedTab) Then
                                ' The highlighted bar is as wide as the highlight fill and takes the same arc. The
                                ' resting bar goes under it, so a column that carries a side line keeps it - except
                                ' the one shared with the selected tab, which is the selected tab's
                                iBarRestRight = iBarRight
                                If (mTabData(mTab).RowPos = iTabData.RowPos) And (mTabData(mTab).TabRect.Left = .Right + 1) Then iBarRestRight = iBarRestRight - 1
                                FillCurvedGradient2 iBarLeft, .Top + iTopOffset, iBarRestRight, .Top + iTopOffset + iFlatBarTopHeight, iTabColor_FlatBarColorInactive, iTabColor_FlatBarColorInactive, iFlatLeftRoundness, iFlatRightRoundness
                                iBarRight = iBarRight - 1
                                If iTabData.LeftTab Then iBarLeft = iBarLeft + 1
                            End If
                        End If
                        FillCurvedGradient2 iBarLeft, .Top + iTopOffset, iBarRight, .Top + iTopOffset + iFlatBarTopHeight, iFlatBarTopColor, iFlatBarTopColor, iFlatLeftRoundness, iFlatRightRoundness
                    End If
                    If iHighlighted And (iFlatBarTopHeight > 1) Then
                        If IIf(iActive, mHighlightFlatBarWithGripSelectedTab, mHighlightFlatBarWithGrip) Then
                            Dim iTriangle(2) As POINTAPI
                            
                            If mFlatBarGripHeightDPIScaled > 0 Then
                                ' top point
                                iTriangle(0).X = (.Left + .Right) / 2 + cEpsilon
                                iTriangle(0).Y = .Top - mFlatBarGripHeightDPIScaled
                                ' left point
                                iTriangle(1).X = (.Left + .Right) / 2 - mFlatBarGripHeightDPIScaled + cEpsilon
                                iTriangle(1).Y = .Top
                                ' right point
                                iTriangle(2).X = (.Left + .Right) / 2 + mFlatBarGripHeightDPIScaled + cEpsilon
                                iTriangle(2).Y = .Top
                                DrawTriangle iTriangle, iFlatBarTopColor
                            Else
                                ' The base row is part of the cut, so the cut is one row shorter than the grip to show its height
                                iLng = Abs(mFlatBarGripHeightDPIScaled) - 1
                                ' top point
                                If mFlatBarHeightDPIScaled - Abs(mFlatBarGripHeightDPIScaled) < (mFlatBarHeightDPIScaled * 0.33) Then
                                    iTriangle(0).X = (.Left + .Right) / 2 + cEpsilon
                                    iTriangle(0).Y = .Top + (iLng + iFlatBarTopHeight)
                                    ' left point
                                    iTriangle(1).X = (.Left + .Right) / 2 - (iLng + iFlatBarTopHeight) + cEpsilon
                                    iTriangle(1).Y = .Top
                                    ' right point
                                    iTriangle(2).X = (.Left + .Right) / 2 + (iLng + iFlatBarTopHeight) + cEpsilon
                                    iTriangle(2).Y = .Top
                                    DrawTriangle iTriangle, iFlatBarTopColor
                                End If
                                iTriangle(0).X = (.Left + .Right) / 2 + cEpsilon
                                iTriangle(0).Y = .Top + iLng
                                ' left point
                                iTriangle(1).X = (.Left + .Right) / 2 - iLng + cEpsilon
                                iTriangle(1).Y = .Top
                                ' right point
                                iTriangle(2).X = (.Left + .Right) / 2 + iLng + cEpsilon ' + 1
                                iTriangle(2).Y = .Top
                                DrawTriangle iTriangle, IIf(iTabData.RowPos = 0, TranslatedColor(mBackColor, ntRoleBack), iTabColor_BackColorTab)
                            End If
                        End If
                    End If
                End If
                
                If iShowFlatBarBottom Then
                    ' no role here: the three carry theirs from where they were chosen, and
                    ' asking for one again would substitute a colour that is already resolved
                    If iActive Then
                        iColor = iTabColor_FlatBarColorSelectedTab
                    ElseIf (iTabData.Hovered Or (mFadeOutTab = nTab)) And mAmbientUserMode Then
                        ' Or the fade out, like iHighlighted further up. The rule for what has to
                        ' follow the way out is simple and it is the same one for the way in: what
                        ' is painted with a colour the animation moves.
                        iColor = iTabColor_FlatBarGlowColor
                    Else
                        iColor = iTabColor_FlatBarColorInactive
                    End If
                    
                    'FillCurvedGradient2 .Left + iLeftOffset, .Bottom, .Right + iRightOffset, .Bottom + mFlatBarHeightDPIScaled + 1, iColor, iColor, 0, 0
                    '(orig) FillCurvedGradient2 .Left + iLeftOffset, .Bottom - mFlatBarHeightDPIScaled + 3, .Right + iRightOffset, .Bottom + 3, iColor, iColor, 0, 0
                    'FillCurvedGradient2 .Left + iLeftOffset, .Bottom - mFlatBarHeightDPIScaled + 5, .Right + iRightOffset, .Bottom + 5, iColor, iColor, 0, 0
                    If iHLRoundBottom And (iHLPillCut <= 1) And ((iHLBottomLeftRoundness > 0) Or (iHLBottomRightRoundness > 0)) Then
                        ' Inside the rounded shape: cut by the same arcs, which FillCurvedGradient2 measures from the bottom
                        FillCurvedGradient2 .Left + iLeftOffset + 1 - iShareLeftSeparator, .Bottom + 1 - iHLPillCut - mFlatBarHeightDPIScaled, IIf(iHighlightFlatDrawBorder, .Right + iRightOffset + IIf(iTabData.RightTab, 1, 0), .Right + iRightOffset + iHLFillRightPad), .Bottom + 1 - iHLPillCut, iColor, iColor, 0, 0, iHLBottomLeftRoundness, iHLBottomRightRoundness
                    Else
                        FillCurvedGradient2 .Left + iLeftOffset, .Bottom - mFlatBarHeightDPIScaled, .Right + iRightOffset, .Bottom, iColor, iColor, 0, 0
                    End If
                    If IIf(iActive, mHighlightFlatBarWithGripSelectedTab, mHighlightFlatBarWithGrip) Then
                        If (mFlatBarGripHeightDPIScaled > 0) And iHighlighted Then
                            ' top point
                            iTriangle(0).X = (.Left + .Right) / 2 + cEpsilon
                            iTriangle(0).Y = .Bottom - 1 + mFlatBarGripHeightDPIScaled
                            ' left point
                            iTriangle(1).X = (.Left + .Right) / 2 - mFlatBarGripHeightDPIScaled + cEpsilon
                            iTriangle(1).Y = .Bottom - 1
                            ' right point
                            iTriangle(2).X = (.Left + .Right) / 2 + mFlatBarGripHeightDPIScaled + cEpsilon
                            iTriangle(2).Y = .Bottom - 1
                            DrawTriangle iTriangle, iColor
                        ElseIf iHighlighted Then
                            If mFlatBarHeightDPIScaled - Abs(mFlatBarGripHeightDPIScaled) < (mFlatBarHeightDPIScaled * 0.33) Then
                                ' The base row is part of the cut, so the cut is one row shorter than the grip to show its height
                                iLng = Abs(mFlatBarGripHeightDPIScaled) - 1 + mFlatBarHeightDPIScaled
                                ' top point
                                iTriangle(0).X = (.Left + .Right) / 2 + cEpsilon
                                iTriangle(0).Y = .Bottom - 1 - iLng
                                ' left point
                                iTriangle(1).X = (.Left + .Right) / 2 - iLng + cEpsilon
                                iTriangle(1).Y = .Bottom - 1
                                ' right point
                                iTriangle(2).X = (.Left + .Right) / 2 + iLng + cEpsilon
                                iTriangle(2).Y = .Bottom - 1
                                DrawTriangle iTriangle, iColor
                            End If
                            
                            If iHighlightGradient <> ntGradientNone Then
                                If iActive Then
                                    If mFlatBodySeparationLineHeightDPIScaled > 0 Then
                                        iColor = TranslatedColor(mFlatBodySeparationLineColor, ntRoleFore)
                                    Else
                                        ' The role is resolved here and not at the shared
                                        ' TranslatedColor below, because the other two branches
                                        ' already carry translated values.
                                        If IsEmpty(iTabData.CustomColors.HighlightColorSelectedTab) Then
                                            iColor = TranslatedColor(mHighlightColorSelectedTab, ntRoleBack)
                                        Else
                                            iColor = TranslatedColor(iTabData.CustomColors.HighlightColorSelectedTab, ntRoleBack)
                                        End If
                                    End If
                                Else
                                    iColor = iTabColor_BackColorSelectedTab
                                End If
                            Else
                                iColor = iTabColor_BackColorSelectedTab
                            End If
                            iColor = TranslatedColor(iColor)
                            ' top point
                            iTriangle(0).X = (.Left + .Right) / 2 + cEpsilon
                            iTriangle(0).Y = .Bottom + mFlatBarGripHeightDPIScaled
                            ' left point
                            iTriangle(1).X = (.Left + .Right) / 2 + mFlatBarGripHeightDPIScaled + 1 + cEpsilon
                            iTriangle(1).Y = .Bottom - 1
                            ' right point
                            iTriangle(2).X = (.Left + .Right) / 2 - mFlatBarGripHeightDPIScaled - 1 + cEpsilon
                            iTriangle(2).Y = .Bottom - 1
                            DrawTriangle iTriangle, iColor
                        End If
                    End If
                End If
            Else
                If iRoundedTabs Then
                    picDraw.Line (.Left + iLeftOffset + 4, .Top)-(.Right - 3, .Top), i3DDKShadow
                    picDraw.Line (.Left + iLeftOffset + 4, .Top + 1)-(.Right - 4, .Top + 1), i3DHighlightH
                    If iActive Then
                        picDraw.Line (.Left + iLeftOffset + 4, .Top + 2)-(.Right - 4, .Top + 2), i3DHighlightH
                    End If
                Else
                    picDraw.Line (.Left + iLeftOffset + 3, .Top)-(.Right - 3, .Top), i3DDKShadow
                    picDraw.Line (.Left + iLeftOffset + 3, .Top + 1)-(.Right - 3, .Top + 1), i3DHighlightH
                    If iActive Then
                        picDraw.Line (.Left + iLeftOffset + 3, .Top + 2)-(.Right - 3, .Top + 2), i3DHighlightH
                    End If
                End If
            End If
            
            ' One row, on the active tab only, so that the side borders reach the row of the body's frame:
            ' FillCurvedGradientR paints its last row and Line does not paint its end point. iPPTopLine and
            ' not a flat 1: it is already 1 for exactly the Bottom and Right six
            If mAppearanceIsPP And iActive Then iPPBodyJoin = iPPTopLine
            
            'right line
            If mAppearanceIsPP Then
                If (mTabOrientation = ssTabOrientationTop) Or (mTabOrientation = ntTabOrientationTopRight) Then
                    picDraw.Line (.Right, .Top + 3)-(.Right, .Bottom + iExtI + iPPBodyJoin), i3DDKShadow
                    picDraw.Line (.Right - 1, .Top + 3)-(.Right - 1, .Bottom + iExtI + iPPBodyJoin), i3DShadowV
                ElseIf (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Or (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationLeftBottomHorizontal) Then
                    picDraw.Line (.Right, .Top + 3)-(.Right, .Bottom + iExtI + iPPBodyJoin + IIf(iTabData.RightTabEnding, 1, 0)), i3DHighlightH
                    ' This column carries the tab's own background and not a border tone, so under a
                    ' highlight it put the resting colour back over everything the fill had just
                    ' painted.
                    iLineStartY = .Top + 3
                    If iHighlighted Then iLineStartY = .Bottom + iBottomOffset + 1
                    If iLineStartY <= (.Bottom + iExtI + iPPBodyJoin) Then
                        picDraw.Line (.Right - 1, iLineStartY)-(.Right - 1, .Bottom + iExtI + iPPBodyJoin), iBackColorTabs2
                    End If
                    ' In the Left family this edge is the one that comes out on top after the
                    ' rotation, so it is the light one and it is the one that takes the twin.
                    If mAppearanceIsTabStrip Then
                        picDraw.Line (.Right - 1, .Top + 3)-(.Right - 1, .Bottom + iExtI + iPPBodyJoin), i3DLight
                    End If
                Else
                    picDraw.Line (.Right, .Top + 3)-(.Right, .Bottom + iExtI + iPPBodyJoin - 1 + IIf(iTabData.RightTabEnding, 2, 0)), i3DDKShadow
                    picDraw.Line (.Right - 1, .Top + 3)-(.Right - 1, .Bottom + iExtI + iPPBodyJoin + IIf(iTabData.RightTabEnding, 1, 0)), i3DShadowV
                End If
            ElseIf mAppearanceIsFlat Then
                If iHighlightFlatDrawBorder Then
                    ' The roundness is discounted at the top only: see the bottom line of
                    ' this border for why that end stays square
                    If iHLBorderPercent >= 100 Then
                        picDraw.Line (.Right, .Top + iTopOffset + iFlatRightRoundness)-(.Right, .Bottom + 1 - iHLPillCut - iHLBottomRightRoundness), iHighlightFlatDrawBorder_Color
                    Else
                        ' Two pieces while the fade lasts, because the column does not have one
                        ' colour under it: down to where the side line starts it is the bar, and
                        ' from there it is the side line.
                        iHLBorderSplit = iFlatRightRoundness
                        If iFlatBarTopHeight > iHLBorderSplit Then
                            iHLBorderSplit = iFlatBarTopHeight
                        End If
                        picDraw.Line (.Right, .Top + iTopOffset + iFlatRightRoundness)-(.Right, .Top + iTopOffset + iHLBorderSplit), MixColors(iHLBorderBarFrom, iHighlightFlatDrawBorder_Color, iHLBorderPercent)
                        picDraw.Line (.Right, .Top + iTopOffset + iHLBorderSplit)-(.Right, .Bottom + 1 - iHLPillCut - iHLBottomRightRoundness), MixColors(iFlatRightLineColor, iHighlightFlatDrawBorder_Color, iHLBorderPercent)
                    End If
                ElseIf Not (((iFlatRightLineColor = iTabColor_BackColorTab) And iTabData.RightTab And (iFlatRightRoundness > 0)) Or (iInactiveShape And iHLRoundBottom)) Then
                    ' No test on iFlatBarTopVisible: the row above a side line belongs to a line of
                    ' its own (24.98), so both sides skip it
                    iLng = iFlatRightRoundness
                    If iFlatBarTopHeight > iLng Then
                        iLng = iFlatBarTopHeight
                    End If
                    
                    iLineStartY = .Top + iTopOffset + iLng
                    iLineEndY = .Bottom + iBottomOffset + iExtI + IIf(iActive And (iTabData.RightTabEnding Or (SelectedTabIsWidened And iTabData.RightTab And (.Right >= mBodyWidth - 2))), 3 + mFlatBodySeparationLineHeightDPIScaled + iFlatActiveLeftSkirt, 0)
                    iDrawSideLine = True
                    ' Not when this column is the shared separator: there the fill was told
                    ' to stop one short precisely so this line can be drawn in full
                    If iHighlightFillToEdge And (Not iShareRightSeparator) Then
                        ' The fill owns this column now, down to its own bottom. What is left
                        ' for the line is the tail below it, which is what joins the tab to
                        ' the row underneath and is not part of the highlight
                        iLineStartY = .Bottom + iBottomOffset2
                        iDrawSideLine = (iLineStartY <= iLineEndY)
                    End If
                    If iDrawSideLine Then
                        picDraw.Line (.Right, iLineStartY)-(.Right, iLineEndY), iFlatRightLineColor
                    End If
                End If
            Else
                picDraw.Line (.Right, .Top + 4)-(.Right, .Bottom + iExtI), i3DDKShadow
#If HOVERCLIPDIAG = 1 Then ' TEMP diagnostic
                iDTProbeR1 = picDraw.Point(mHoverClipDiagProbeX, mHoverClipDiagProbeY)
#End If
                picDraw.Line (.Right - 1, .Top + 4)-(.Right - 1, .Bottom + iExtI), i3DShadowV
#If HOVERCLIPDIAG = 1 Then ' TEMP diagnostic
                iDTProbeR2 = picDraw.Point(mHoverClipDiagProbeX, mHoverClipDiagProbeY)
#End If
                If iActive Then
                    picDraw.Line (.Right - 2, .Top + 4)-(.Right - 2, .Bottom + 1 + iExtI), i3DShadowV
                    ' RightTabEnding and not RightTab: what decides the tone here is whether the tab
                    ' reaches the body's right edge, not whether it is the last one of its row.
                    If iTabData.RightTabEnding Then
                        picDraw.Line (.Right - 1, .Bottom + iExtI)-(.Right - 1, .Bottom + iExtI + 2), i3DShadowV ' points of top line of body
                        picDraw.Line (.Right - 2, .Bottom + iExtI + 1)-(.Right - 2, .Bottom + iExtI + 2), i3DShadowV ' point of top line of body
                    Else
                        picDraw.Line (.Right - 1, .Bottom + iExtI)-(.Right - 1, .Bottom + iExtI + 2), i3DHighlightH  ' points of top line of body
                        picDraw.Line (.Right - 2, .Bottom + iExtI + 1)-(.Right - 2, .Bottom + iExtI + 2), i3DHighlightH  ' point of top line of body
                    End If
                End If
            End If
            
#If HOVERCLIPDIAG = 1 Then ' TEMP diagnostic
            iDTProbeRight = picDraw.Point(mHoverClipDiagProbeX, mHoverClipDiagProbeY)
#End If
            'left line
            If mAppearanceIsPP Then
                If (mTabOrientation <> ssTabOrientationLeft) And (mTabOrientation <> ntTabOrientationLeftTop) And (mTabOrientation <> ntTabOrientationLeftHorizontal) And (mTabOrientation <> ntTabOrientationLeftBottomHorizontal) Then
                    If iRoundedTabs Then
                        picDraw.Line (.Left, .Top + 3)-(.Left, .Bottom + iExtI), i3DHighlightV
                    Else
                        ' .Top + 2 and not .Top + 1: the row above belongs to the corner step, and
                        ' starting here put a light pixel where the reference leaves background.
                        picDraw.Line (.Left, .Top + 2)-(.Left, .Bottom + iExtI), i3DHighlightV
                    End If
                    ' Same twin on the side border. This branch is the eight orientations
                    ' where i3DHighlightV holds the light tone - the four Left ones take the
                    ' Else below, where this edge is dark and already draws two columns
                    If mAppearanceIsTabStrip Then
                        ' The + 1 on the far end, and only on the row the body hangs from: a Line
                        ' stops one row short of the row named as its end, so the light column and
                        ' this twin both stop one row above the body's first row.
                        picDraw.Line (.Left + 1, .Top + 2 + IIf(iRoundedTabs, 1, 0))-(.Left + 1, .Bottom + iExtI + IIf(iTabData.RowPos = (mRows - 1), 1, 0)), i3DLight
                    End If
                Else
                    picDraw.Line (.Left, .Top + 3 + IIf(iRoundedTabs, 1, 0))-(.Left, .Bottom + iPPBodyJoin), i3DDKShadow
                    picDraw.Line (.Left + 1, .Top + 3)-(.Left + 1, .Bottom + iExtI + iPPBodyJoin), i3DShadow
                    If iRoundedTabs Then
                        picDraw.Line (.Left, .Top + 4)-(.Left, .Bottom + iExtI + iPPBodyJoin + IIf(iTabData.LeftTab, 1, 0)), i3DDKShadow
                        picDraw.Line (.Left + 1, .Top + 3)-(.Left + 1, .Bottom + iExtI + iPPBodyJoin + IIf(iTabData.LeftTab, 1, 0)), i3DShadow
                    Else
                        picDraw.Line (.Left, .Top + 2)-(.Left, .Bottom + iExtI + iPPBodyJoin), i3DDKShadow
                        picDraw.Line (.Left + 1, .Top + 2)-(.Left + 1, .Bottom + iExtI + iPPBodyJoin + IIf(iTabData.LeftTab, 1, 0)), i3DShadow
                    End If
                End If
                ' The twin row of the body's frame stays open across the active tab. It is one past
                ' the fill and the borders, so it is painted back here, after them.
                ' iPPTopLine = 0 only: in the other six orientations there is no twin row
                If mAppearanceIsTabStrip And iActive And (iPPTopLine = 0) Then
                    ' Clipped to the body's interior. The frame is two columns wide on each side and
                    ' it is drawn before any tab, so an active tab sitting at either end would open
                    ' the frame itself.
                    iTwinOpenLeft = .Left
                    If iTwinOpenLeft < 2 Then iTwinOpenLeft = 2
                    iTwinOpenRight = .Right
                    If iTwinOpenRight > (mBodyWidth - 3) Then iTwinOpenRight = mBodyWidth - 3
                    If iTwinOpenRight >= iTwinOpenLeft Then
                        ' iTwinOpenRight + 1 and not iTwinOpenRight, because picDraw.Line does not
                        ' paint its end point (24.138): naming the last column of the span left that
                        ' column with the frame's twin still on it.
                        picDraw.Line (iTwinOpenLeft, mBodyStart - 1)-(iTwinOpenRight + 1, mBodyStart - 1), iBackColorTabs2
                    End If
                End If
                ' The back sheets used to be opened from here, by painting background over the twin
                ' row across the tab.
#If TWINJOINDIAG = 1 Then ' TEMP diagnostic
                If mAppearanceIsTabStrip And mAmbientUserMode Then
                    Debug.Print "TWINJOIN t="; nTab;
                    Debug.Print " act="; Abs(CLng(iActive));
                    Debug.Print " where=afterLeftLine";
                    Debug.Print " px="; picDraw.Point(1, mBodyStart - 1);
                    Debug.Print " r3="; picDraw.Point(mBodyWidth - 3, mBodyStart - 1);
                    Debug.Print " r2="; picDraw.Point(mBodyWidth - 2, mBodyStart - 1);
                    Debug.Print " bodyStart="; mBodyStart;
                    Debug.Print " drawB="; .Bottom;
                    Debug.Print " extI="; iExtI
                End If
#End If
            ElseIf mAppearanceIsFlat Then
                If iHighlightFlatDrawBorder Then
                    ' Top end only, same as the right one: the bottom of a tab is square
                    If iHLBorderPercent >= 100 Then
                        picDraw.Line (.Left + iLeftOffset - iShareLeftSeparator, .Top + iTopOffset + iFlatLeftRoundness)-(.Left + iLeftOffset - iShareLeftSeparator, .Bottom + 1 - iHLPillCut - iHLBottomLeftRoundness), iHighlightFlatDrawBorder_Color
                    Else
                        ' Split in two while fading, same reason as the right one.
                        iHLBorderSplit = iFlatLeftRoundness
                        If iFlatBarTopHeight > iHLBorderSplit Then
                            iHLBorderSplit = iFlatBarTopHeight
                        End If
                        picDraw.Line (.Left + iLeftOffset - iShareLeftSeparator, .Top + iTopOffset + iFlatLeftRoundness)-(.Left + iLeftOffset - iShareLeftSeparator, .Top + iTopOffset + iHLBorderSplit), MixColors(iHLBorderBarFrom, iHighlightFlatDrawBorder_Color, iHLBorderPercent)
                        picDraw.Line (.Left + iLeftOffset - iShareLeftSeparator, .Top + iTopOffset + iHLBorderSplit)-(.Left + iLeftOffset - iShareLeftSeparator, .Bottom + 1 - iHLPillCut - iHLBottomLeftRoundness), MixColors(iFlatLeftLineColor, iHighlightFlatDrawBorder_Color, iHLBorderPercent)
                    End If
                ElseIf (iFlatLeftLineColor <> iTabColor_BackColorTab) And Not (iInactiveShape And iHLRoundBottom) Then
                    iLng = iFlatLeftRoundness
                    If iFlatBarTopHeight > iLng Then
                        iLng = iFlatBarTopHeight
                    End If
                    iLineStartY = .Top + iTopOffset + iLng
                    iLineEndY = .Bottom + iBottomOffset + iExtI + IIf((iTabData.RowPos < (mRows - 1)) And iTabData.LeftTab And (Not iActive), iFlatLeftRoundness / 2, 0)
                    iDrawSideLine = True
                    If iHighlightFillToEdge Then
                        ' Same as the right line: the fill has this column down to its bottom
                        iLineStartY = .Bottom + iBottomOffset2
                        iDrawSideLine = (iLineStartY <= iLineEndY)
                    End If
                    If iDrawSideLine Then
                        picDraw.Line (.Left + iLeftOffset - iShareLeftSeparator, iLineStartY)-(.Left + iLeftOffset - iShareLeftSeparator, iLineEndY), iFlatLeftLineColor
                    End If
                End If
            Else
                If iRoundedTabs Then
                    If iTabData.LeftTab Then
                        picDraw.Line (.Left, .Top + 5)-(.Left, .Bottom + iExtI), i3DDKShadow
                    End If
                    If (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Or (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationLeftBottomHorizontal) Then
                        If iActive Then
                            picDraw.Line (.Left, .Top + 5)-(.Left, .Bottom + iExtI + 1), i3DHighlightV
                            picDraw.Line (.Left + 1, .Top + 5)-(.Left + 1, .Bottom + 2 + iExtI), i3DHighlightV
                        Else
                            picDraw.Line (.Left, .Top + 5)-(.Left, .Bottom + iExtI), i3DHighlightV
                            ' The second column of this rounded left edge carries the tab's background, which
                            ' is wrong under a highlight: the line runs after the fill
                            If Not iHighlighted Then
                                picDraw.Line (.Left + 1, .Top + 5)-(.Left + 1, .Bottom + iExtI), iBackColorTabs2
                            End If
                        End If
                    Else
                        If iActive Then
                            picDraw.Line (.Left, .Top + 5)-(.Left, .Bottom + iExtI + 1), i3DHighlightV
                            picDraw.Line (.Left + 1, .Top + 5)-(.Left + 1, .Bottom + 2 + iExtI), i3DHighlightV
                        Else
                            picDraw.Line (.Left, .Top + 5)-(.Left, .Bottom + iExtI), i3DHighlightV ' iBackColorTabs2
                        End If
                    End If
                Else
                    picDraw.Line (.Left, .Top + 4)-(.Left, .Bottom + iExtI), i3DHighlightV
                    If iActive Then
                        picDraw.Line (.Left + 1, .Top + 4)-(.Left + 1, .Bottom + 1 + iExtI), i3DHighlightV
                        picDraw.Line (.Left, .Top + 4)-(.Left, .Bottom + 1 + iExtI), i3DHighlightV
                        ' The V role, in all twelve.
                        picDraw.Line (.Left, .Bottom + iExtI)-(.Left, .Bottom + iExtI + 1), i3DHighlightV   ' points of top line of body
                        picDraw.Line (.Left + 1, .Bottom + iExtI + 1)-(.Left + 1, .Bottom + iExtI + 2), i3DHighlightV ' point of top line of body
                    End If
                End If
                ' The 5 is a bet on the neighbour, and it only holds while the tabs touch: then
                ' .Left - 1 IS the previous tab's own right border column, which already carries the
                ' dark from row 4 down, so starting here at 4 would only repaint it.
                picDraw.Line (.Left - 1, .Top + IIf(iTabData.LeftTab Or (mTabSeparation2 > 0), 4, 5))-(.Left - 1, .Bottom + iExtI), i3DDKShadow
            End If
            
            'top-right corner
            If mAppearanceIsPP Then
                If (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Or (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationLeftBottomHorizontal) Then
                    If iRoundedTabs Then
                        picDraw.Line (.Right - 3, .Top + 1)-(.Right - 3, .Top + 2), i3DHighlight
                        picDraw.Line (.Right - 2, .Top + 1)-(.Right - 2, .Top + 2), i3DHighlight
                        picDraw.Line (.Right - 1, .Top + 2)-(.Right - 1, .Top + 3), i3DHighlight
                    Else
                        ' The middle of these three lines duplicated (.Right - 1, .Top + 2), which
                        ' the first line already paints, and widened the corner's step to two
                        ' columns instead of one.
                        picDraw.Line (.Right - 1, .Top + 1)-(.Right - 1, .Top + 2), i3DHighlight
                        picDraw.Line (.Right, .Top + 2)-(.Right, .Top + 3), i3DHighlight
                    End If
                ElseIf (mTabOrientation = ssTabOrientationTop) Or (mTabOrientation = ntTabOrientationTopRight) Then
                    If iRoundedTabs Then
                        picDraw.Line (.Right - 3, .Top + 1)-(.Right - 3, .Top + 2), i3DShadow
                        picDraw.Line (.Right - 2, .Top + 1)-(.Right - 2, .Top + 2), i3DDKShadow
                        picDraw.Line (.Right - 1, .Top + 2)-(.Right - 1, .Top + 3), i3DDKShadow
                        picDraw.Line (.Right - 2, .Top + 2)-(.Right - 2, .Top + 3), i3DShadowV
                    Else
                        picDraw.Line (.Right - 1, .Top + 1)-(.Right - 1, .Top + 2), i3DDKShadow
                        picDraw.Line (.Right - 1, .Top + 2)-(.Right - 1, .Top + 3), i3DShadowV
                        picDraw.Line (.Right, .Top + 2)-(.Right, .Top + 3), i3DDKShadow
                    End If
                Else
                    If iRoundedTabs Then
                        picDraw.Line (.Right - 2, .Top + 1)-(.Right - 2, .Top + 2), i3DDKShadow
                        picDraw.Line (.Right - 1, .Top + 2)-(.Right - 1, .Top + 3), i3DDKShadow
                        picDraw.Line (.Right - 2, .Top + 2)-(.Right - 2, .Top + 3), i3DShadowV
                    Else
                        picDraw.Line (.Right - 1, .Top + 1)-(.Right - 1, .Top + 2), i3DDKShadow
                        picDraw.Line (.Right - 1, .Top + 2)-(.Right - 1, .Top + 3), i3DShadowV
                        picDraw.Line (.Right, .Top + 2)-(.Right, .Top + 3), i3DDKShadow
                    End If
                End If
            ElseIf mAppearanceIsFlat Then
                If iFlatRightRoundness > 0 Then
                    ' draw rounded top-right corner
                    If iHighlightFlatDrawBorder Then
                        ' the corner is inside the bar band, so that is what it comes in over
                        iLineColor = MixColors(iHLBorderBarFrom, iHighlightFlatDrawBorder_Color, iHLBorderPercent)
                    ElseIf iHighlightFillToEdge Then
                        iLineColor = IIf((mFlatBorderMode = ntBorderTabs) Or iActive, iFlatBorderColor, iHighlightColor)
                    Else
                        iLineColor = IIf((mFlatBorderMode = ntBorderTabs) Or iActive, iFlatBorderColor, iFlatTabsSeparationLineColor)
                    End If
                    If (iLineColor <> iTabColor_BackColorTab) And (Not iHighlightArcFromFill) And Not (iInactiveShape And iHLRoundBottom And (Not iHighlightFlatDrawBorder)) Then
                        DrawRoundedCorner ntCornerTopRight, .Right + iRightOffset, .Top + iTopOffset, iFlatRightRoundness, iLineColor, iFlatBarTopHeight
                    End If
                End If
            Else
                If iRoundedTabs Then
                    picDraw.Line (.Right - 1, .Top + 3)-(.Right - 1, .Top + 1), i3DDKShadow
                    picDraw.Line (.Right - 2, .Top + 1)-(.Right - 4, .Top + 1), i3DDKShadow
                    picDraw.Line (.Right - 2, .Top + 2)-(.Right - 3, .Top + 2), i3DShadowV
                    picDraw.Line (.Right - 4, .Top + 1)-(.Right - 3, .Top + 1), i3DShadowV
                    picDraw.Line (.Right - 2, .Top + 3)-(.Right - 2, .Top + 4), i3DShadowV
                    If iActive Then
                        picDraw.Line (.Right - 3, .Top + 2)-(.Right, .Top + 5), i3DShadowV
                        picDraw.Line (.Right - 4, .Top + 2)-(.Right - 1, .Top + 5), i3DShadowV
                        picDraw.Line (.Right - 3, .Top + 4)-(.Right - 1, .Top + 6), i3DShadowV
                    End If
                Else
                    picDraw.Line (.Right - 4, .Top)-(.Right, .Top + 4), i3DDKShadow
                    If iActive Then
                        picDraw.Line (.Right - 3, .Top + 2)-(.Right, .Top + 5), i3DShadowV
                        picDraw.Line (.Right - 4, .Top + 2)-(.Right - 1, .Top + 5), i3DShadowV
                        picDraw.Line (.Right - 4, .Top + 3)-(.Right - 1, .Top + 6), i3DShadowV
                    Else
                        picDraw.Line (.Right - 4, .Top + 1)-(.Right - 1, .Top + 4), i3DShadowV
                    End If
                End If
            End If
            
            'top-left corner
            If mAppearanceIsPP Then
                If (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Or (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationLeftBottomHorizontal) Then
                    If iRoundedTabs Then
                        picDraw.Line (.Left + 2, .Top + 2)-(.Left + 2, .Top + 3), i3DHighlightV
                        ' Outer dark diagonal, as in the square corner but one step longer
                        picDraw.Line (.Left, .Top + 3)-(.Left + 3, .Top), i3DDKShadow
                    Else
                        ' Same diagonal the Top branch uses, copied wholesale, but in this group
                        ' i3DHighlightV is the shadow tone and not a light one - same issue as the
                        ' Bottom top-left corner fixed 2026-08-27.
                        picDraw.Line (.Left, .Top + 2)-(.Left + 2, .Top), i3DDKShadow
                    End If
                ElseIf (mTabOrientation = ssTabOrientationTop) Or (mTabOrientation = ntTabOrientationTopRight) Then
                    If iRoundedTabs Then
                        picDraw.Line (.Left + 1, .Top + 2)-(.Left + 1, .Top + 3), i3DHighlightH
                        picDraw.Line (.Left, .Top + 3)-(.Left, .Top + 4), i3DHighlightH
                        picDraw.Line (.Left + 2, .Top + 1)-(.Left + 3, .Top + 1), i3DHighlightH
                    Else
                        ' Two pixels and not three: the third one, (.Left + 2, .Top + 1), widened
                        ' the corner step to two columns. Same shape as the Bottom and Left corners
                        ' fixed on 2026-08-27/28.
                        picDraw.Line (.Left, .Top + 2)-(.Left + 2, .Top), i3DHighlightH
                    End If
                Else
                    If iRoundedTabs Then
                        picDraw.Line (.Left + 2, .Top + 2)-(.Left + 2, .Top + 3), i3DShadowV
                        picDraw.Line (.Left + 1, .Top + 2)-(.Left + 1, .Top + 3), i3DDKShadow
                        picDraw.Line (.Left + 2, .Top + 1)-(.Left + 3, .Top + 1), i3DDKShadow
                    Else
                        ' The diagonal copied from the Top branch painted shadow at (.Left, .Top +
                        ' 2) and dark at (.Left + 1, .Top + 1).
                        picDraw.PSet (.Left + 1, .Top + 1), i3DDKShadow
                    End If
                End If
            ElseIf mAppearanceIsFlat Then
                If iFlatLeftRoundness > 0 Then
                    If iHighlightFlatDrawBorder Then
                        ' same as the top right corner: it is drawn over the bar
                        iLineColor = MixColors(iHLBorderBarFrom, iHighlightFlatDrawBorder_Color, iHLBorderPercent)
                    ElseIf iHighlightFillToEdge Then
                        iLineColor = IIf((mFlatBorderMode = ntBorderTabs) Or iActive, iFlatBorderColor, iHighlightColor)
                    Else
                        iLineColor = IIf((mFlatBorderMode = ntBorderTabs) Or (iActive And (mFlatBorderMode = ntBorderSelectedTab)), iFlatBorderColor, iFlatTabsSeparationLineColor)
                    End If
                    If (iLineColor <> iTabColor_BackColorTab) And (Not iHighlightArcFromFill) And Not (iInactiveShape And iHLRoundBottom And (Not iHighlightFlatDrawBorder)) Then
                        ' Carries iShareLeftSeparator because the left line carries it: the two have
                        ' to sit on the same column or the arc comes to rest one column inside the
                        ' line it is supposed to close.
                        DrawRoundedCorner ntCornerTopleft, .Left + iLeftOffset - iShareLeftSeparator, .Top + iTopOffset, iFlatLeftRoundness, iLineColor, iFlatBarTopHeight
                    End If
                End If
            Else
                If iRoundedTabs Then
                    picDraw.Line (.Left + iLeftOffset + 1, .Top + 4)-(.Left + iLeftOffset + 1, .Top + 1), i3DDKShadow
                    picDraw.Line (.Left + iLeftOffset + 2, .Top + 1)-(.Left + iLeftOffset + 4, .Top + 1), i3DDKShadow
                    picDraw.Line (.Left + iLeftOffset + 2, .Top + 3)-(.Left + iLeftOffset + 2, .Top + 2), i3DHighlightH
                    picDraw.Line (.Left + iLeftOffset + 2, .Top + 2)-(.Left + iLeftOffset + 4, .Top + 2), i3DHighlightH
                    picDraw.Line (.Left + iLeftOffset, .Top + 4)-(.Left + iLeftOffset, .Top + 3), i3DDKShadow
                    picDraw.Line (.Left + iLeftOffset + 1, .Top + 4)-(.Left + iLeftOffset + 1, .Top + 5), i3DHighlightH
                    If iActive Then
                        picDraw.Line (.Left + iLeftOffset + 2, .Top + 3)-(.Left + iLeftOffset + 4, .Top + 1), i3DHighlightH
                        picDraw.Line (.Left + iLeftOffset + 2, .Top + 4)-(.Left + iLeftOffset + 5, .Top + 1), i3DHighlightH
                        picDraw.Line (.Left + iLeftOffset + 2, .Top + 5)-(.Left + iLeftOffset + 5, .Top + 2), i3DHighlightH
                    End If
                Else
                    picDraw.Line (.Left + iLeftOffset, .Top + 3)-(.Left + iLeftOffset + 3, .Top), i3DDKShadow
                    If iActive Then
                        picDraw.Line (.Left + iLeftOffset + 1, .Top + 3)-(.Left + iLeftOffset + 3, .Top + 1), i3DHighlightH
                        picDraw.Line (.Left + iLeftOffset + 1, .Top + 4)-(.Left + iLeftOffset + 4, .Top + 1), i3DHighlightH
                        picDraw.Line (.Left + iLeftOffset + 2, .Top + 4)-(.Left + iLeftOffset + 4, .Top + 2), i3DHighlightH
                    Else
                        If iTabData.LeftTab Then
                            picDraw.Line (.Left + iLeftOffset + 1, .Top + 3)-(.Left + iLeftOffset + 3, .Top + 1), i3DHighlightH
                        Else
                            picDraw.Line (.Left + iLeftOffset + 1, .Top + 3)-(.Left + iLeftOffset + 3, .Top + 1), i3DHighlightH
                        End If
                    End If
                End If
            End If
            
            ' Bottom line
            If mAppearanceIsFlat Then
                If iHighlightFlatDrawBorder Then
                    ' A tab closed at the bottom on the strip's outer edge still has to meet the body: below it the edge
                    ' column runs on as the resting side line, and when the pill sits on the body's first row
                    ' (the active one) that row is put back under the corner. The arc is drawn after, over them.
                    ' Over a rounded body corner the selected tab leaves it open; a hovered front-row tab fades it out
                    If iHLRoundBottom Then
                        iHLBodyLineColor = iFlatBorderColor
                        If (mFlatBorderMode = ntBorderTabs) Or (mFlatBodySeparationLineHeight > 1) Then iHLBodyLineColor = TranslatedColor(mFlatBodySeparationLineColor, ntRoleFore)
                        ' A row end away from the control's edge keeps its resting side line below the shape too
                        If (Not iInactiveShape) And iTabData.LeftTab And (((.Left + iLeftOffset - iShareLeftSeparator) <= 0) Or (Not iActive)) And (iFlatLeftLineColor <> iTabColor_BackColorTab) And Not (iActive And mFlatBodyTopLeftRounded And (iHLBottomLeftRoundness > 0)) Then
                            iHLEdgeX = .Left + iLeftOffset - iShareLeftSeparator
                            iHLEdgeEndY = .Bottom + iBottomOffset + iExtI
                            If iHLEdgeX <= 0 Then
                                iHLEdgeX = 0
                                If iHLEdgeEndY < mBodyStart Then iHLEdgeEndY = mBodyStart
                            ElseIf (iTabData.RowPos < (mRows - 1)) And (Not iActive) Then
                                iHLEdgeEndY = iHLEdgeEndY + iFlatLeftRoundness / 2
                            End If
                            ' Over the body, the part below its top belongs to the body's own side and corner
                            If mDrawingTabsOverBody And (Not iActive) Then iHLEdgeEndY = mBodyStart
                            picDraw.Line (iHLEdgeX, .Bottom + 1 - iHLPillCut - iHLBottomLeftRoundness)-(iHLEdgeX, iHLEdgeEndY), IIf(iEndOpenLeft, MixColors(iFlatLeftLineColor, FlatStripEndBehindColor(True), iHLBorderPercent), iFlatLeftLineColor)
                            If iActive And ((.Bottom + 1 - iHLPillCut) = mBodyStart) And (mFlatBodySeparationLineHeight > 0) And (iHLBodyLineColor <> mBackColorTabs2) Then
                                picDraw.Line (1, mBodyStart)-(.Left + iLeftOffset + iHLBottomLeftRoundness, mBodyStart), iHLBodyLineColor
                            End If
                        End If
                        If (Not iInactiveShape) And iTabData.RightTab And ((.Right >= (mBodyWidth - 1)) Or (Not iActive)) And (iFlatRightLineColor <> iTabColor_BackColorTab) And Not (iActive And mFlatBodyTopRightRounded And (iHLBottomRightRoundness > 0)) Then
                            iHLEdgeEndY = .Bottom + iBottomOffset + iExtI + IIf(iActive And (iTabData.RightTabEnding Or (SelectedTabIsWidened And iTabData.RightTab And (.Right >= mBodyWidth - 2))), 3 + mFlatBodySeparationLineHeightDPIScaled + iFlatActiveLeftSkirt, 0)
                            If (.Right >= (mBodyWidth - 1)) And (iHLEdgeEndY < mBodyStart) Then iHLEdgeEndY = mBodyStart
                            If mDrawingTabsOverBody And (Not iActive) Then iHLEdgeEndY = mBodyStart
                            picDraw.Line (.Right, .Bottom + 1 - iHLPillCut - iHLBottomRightRoundness)-(.Right, iHLEdgeEndY), IIf(iEndOpenRight, MixColors(iFlatRightLineColor, FlatStripEndBehindColor(False), iHLBorderPercent), iFlatRightLineColor)
                            If iActive And ((.Bottom + 1 - iHLPillCut) = mBodyStart) And (mFlatBodySeparationLineHeight > 0) And (iHLBodyLineColor <> mBackColorTabs2) Then
                                picDraw.Line (.Right + iRightOffset + 1 - iHLBottomRightRoundness, mBodyStart)-(.Right, mBodyStart), iHLBodyLineColor
                            End If
                        End If
                        ' With the border on the selected tab only, its inner sides are the body's border too
                        If iActive And (mFlatBorderMode = ntBorderSelectedTab) Then
                            iHLEdgeEndY = .Bottom + iBottomOffset + iExtI
                            If iHLEdgeEndY < mBodyStart Then iHLEdgeEndY = mBodyStart
                            If Not (iTabData.LeftTab And ((.Left + iLeftOffset - iShareLeftSeparator) <= 0)) Then
                                picDraw.Line (.Left + iLeftOffset - iShareLeftSeparator, .Bottom + 1 - iHLPillCut - iHLBottomLeftRoundness + IIf(iHLBottomLeftRoundness = 0, 1, 0))-(.Left + iLeftOffset - iShareLeftSeparator, iHLEdgeEndY), iFlatLeftLineColor
                            End If
                            If Not (iTabData.RightTab And (.Right >= (mBodyWidth - 1))) Then
                                picDraw.Line (.Right, .Bottom + 1 - iHLPillCut - iHLBottomRightRoundness + IIf(iHLBottomRightRoundness = 0, 1, 0))-(.Right, iHLEdgeEndY), iFlatRightLineColor
                            End If
                        End If
                    End If
                    ' + 1 on the far end: Line excludes it, and the right border line above also
                    ' excludes its own, so the corner pixel (.Right, .Bottom + 1) fell outside both
                    ' and stayed background.
                    ' Lying on the body's top row, the border fades from what the body paints there at rest
                    iHLBottomFromNow = iHLBorderBottomFrom
                    iHLBottomOnBody = (Not iInactiveShape) And ((.Bottom + 1 - iHLPillCut) = mBodyStart)
                    If iHLBottomOnBody Then
                        iHLBottomFromNow = iFlatBorderColor
                        If (mFlatBorderMode = ntBorderTabs) Or (mFlatBodySeparationLineHeight > 1) Then iHLBottomFromNow = TranslatedColor(mFlatBodySeparationLineColor, ntRoleFore)
                        If (iHLBottomFromNow = mBackColorTabs2) Or (mFlatBodySeparationLineHeight = 0) Then iHLBottomFromNow = mBackColorSelectedTab2
                    End If
                    picDraw.Line (.Left + iLeftOffset + iHLBottomLeftRoundness, .Bottom + 1 - iHLPillCut)-(.Right + iRightOffset + 1 - iHLBottomRightRoundness, .Bottom + 1 - iHLPillCut), MixColors(iHLBottomFromNow, iHighlightFlatDrawBorder_Color, iHLBorderPercent)
                    If iHLBottomLeftRoundness > 0 Then
                        DrawRoundedCorner ntCornerBottomLeft, .Left + iLeftOffset - iShareLeftSeparator, .Bottom + 1 - iHLPillCut, iHLBottomLeftRoundness, MixColors(iHLBorderBottomFrom, iHighlightFlatDrawBorder_Color, iHLBorderPercent), nColorOnRowY:=MixColors(iHLBottomFromNow, iHighlightFlatDrawBorder_Color, iHLBorderPercent)
                    ElseIf iHLBorderPercent < 100 Then
                        ' This line runs after the two side ones and takes their last pixel with it.
                        picDraw.PSet (.Left + iLeftOffset - iShareLeftSeparator, .Bottom + 1 - iHLPillCut), MixColors(IIf(iHLBottomOnBody, iHLBottomFromNow, iFlatLeftLineColor), iHighlightFlatDrawBorder_Color, iHLBorderPercent)
                    End If
                    If iHLBottomRightRoundness > 0 Then
                        DrawRoundedCorner ntCornerBottomRight, .Right, .Bottom + 1 - iHLPillCut, iHLBottomRightRoundness, MixColors(iHLBorderBottomFrom, iHighlightFlatDrawBorder_Color, iHLBorderPercent), nColorOnRowY:=MixColors(iHLBottomFromNow, iHighlightFlatDrawBorder_Color, iHLBorderPercent)
                    ElseIf iHLBorderPercent < 100 Then
                        picDraw.PSet (.Right, .Bottom + 1 - iHLPillCut), MixColors(IIf(iHLBottomOnBody, iHLBottomFromNow, iFlatRightLineColor), iHighlightFlatDrawBorder_Color, iHLBorderPercent)
                    End If
                End If
            End If
        End If
#If TABCLIPDIAG = 1 Then ' TEMP diagnostic
        If iClipSavedDC <> 0 Then RestoreDC picDraw.hDC, iClipSavedDC
#End If
#If LASTROWBOTTOMDIAG = 1 Then ' TEMP diagnostic
        If (mLastRowBottomDiagCount < 200) And mAmbientUserMode Then
            If iTabData.RowPos = (mRows - 1) Then
                mLastRowBottomDiagCount = mLastRowBottomDiagCount + 1
                Debug.Print "LRBDIAG t="; nTab;
                Debug.Print " act="; Abs(CLng(iActive));
                Debug.Print " storedT="; mTabData(nTab).TabRect.Top;
                Debug.Print " storedB="; mTabData(nTab).TabRect.Bottom;
                Debug.Print " drawT="; .Top;
                Debug.Print " drawB="; .Bottom;
                Debug.Print " drawL="; .Left;
                Debug.Print " drawR="; .Right;
                Debug.Print " ppJoin="; iPPBodyJoin;
                Debug.Print " botOff="; iBottomOffset;
                Debug.Print " extI="; iExtI;
                Debug.Print " ppTopLine="; iPPTopLine;
                Debug.Print " bodyStart="; mBodyStart;
                Debug.Print " rows="; mRows;
                Debug.Print " style="; mStyle
            End If
        End If
#End If
#If HOVERCLIPDIAG = 1 Then ' TEMP diagnostic
        If (mHoverClipDiagCount < 200) And mAmbientUserMode Then
            mHoverClipDiagCount = mHoverClipDiagCount + 1
            iDTProbeEnd = picDraw.Point(mHoverClipDiagProbeX, mHoverClipDiagProbeY)
            Debug.Print "DTPROBE t="; nTab; " act="; Abs(CLng(iActive)); " hl="; Abs(CLng(iHighlighted)); " grad="; iHighlightGradient; " bottom="; .Bottom; " extI="; iExtI; " botOff="; iBottomOffset; " right="; .Right; " isPP="; Abs(CLng(mAppearanceIsPP)); " isFlat="; Abs(CLng(mAppearanceIsFlat)); " fills="; iDTProbeFills; " r1="; iDTProbeR1; " r2="; iDTProbeR2; " afterRight="; iDTProbeRight; " end="; iDTProbeEnd
        End If
#End If
#If TWINJOINDIAG = 1 Then ' TEMP diagnostic
        If mAppearanceIsTabStrip And mAmbientUserMode Then
            Debug.Print "TWINJOIN t="; nTab;
            Debug.Print " act="; Abs(CLng(iActive));
            Debug.Print " where=endOfTab";
            Debug.Print " px="; picDraw.Point(1, mBodyStart - 1);
            Debug.Print " r3="; picDraw.Point(mBodyWidth - 3, mBodyStart - 1);
            Debug.Print " r2="; picDraw.Point(mBodyWidth - 2, mBodyStart - 1)
        End If
#End If
    End With
End Sub

Private Sub DrawBacksheet(ByVal nLeft As Long, ByVal nTop As Long, ByVal nWidth As Long, ByVal nHeight As Long, ByVal nRowPos As Long, ByVal nTab As Long)
    Dim iDoBottomLine As Boolean
    Dim iBackColorTabs As Long
    Dim iLineColor As Long
    Dim iFlatBorderColor As Long
    Dim iLinePos As Long
    Dim iAuxFlatRoundnessTopLeft As Long
    Dim iAuxFlatRoundnessTopRight As Long
    Dim iLng As Long
    Dim iFlatBarPosition As NTFlatBarPositionConstants
    Dim iSheetLeft As Long
    Dim iSheetRight As Long
    Dim iSheetLeftPulledIn As Boolean
    Dim iSheetTopLineLeft As Long
    Dim iSheetEdgeLeftColor As Long
    Dim iSheetEdgeRightColor As Long
    Dim iSheetEdgesAsLeft As Boolean
    Dim iSheetRightCap As Long
    Dim iRowScan As Long
    Dim iSheetLeftTarget As Long
    Dim iSheetWidenedTab As Long
    Dim iSheetOwnerRight As Long
    Dim iSheetGapLeft As Long
    Dim iSheetSavedDC As Long
    Dim iSheetFollowsWidened As Boolean
    
    If (nWidth < 1) Or (nHeight < 1) Then Exit Sub
    iSheetOwnerRight = mTabData(nTab).TabRect.Right
    If TabIsDrawnWidened(nTab) Then iSheetOwnerRight = iSheetOwnerRight + SelectedTabWideningPixels
     
    ' nRowPos = 0 is the row at the top
    
    ' The themed half of this clamp used to live here and wrote into mTabData: it pulled the last
    ' tab of the row IN FRONT out to where the sheet ends.
    If Not mVisualStylesActive Then
        If Abs(nLeft + nWidth - mTabData(nTab).TabRect.Right) < 5 Then
            nWidth = mTabData(nTab).TabRect.Right - nLeft
            If TabIsDrawnWidened(nTab) Then nWidth = nWidth + SelectedTabWideningPixels
        End If
        ' Left twin of the clamp above, and it only matters without the perspective, where the
        ' caller's nLeft term collapses to zero and the sheet starts on the control's own first
        ' column while the inactive tabs of every row start on the widening inset.
        If Not mShowsRowsPerspective2 Then
            ' RowStartX and not this row's first tab: a short row of the *Horizontal can start far
            ' from the row start
            iSheetLeftTarget = RowStartX()
            ' The mirror of what the far end does with nTab: if the tab being widened is the
            ' first of THIS row, the sheet has to start where it starts. nTab is no use here -
            ' it names the last tab of the row - so the widened one is looked up by index
            iSheetWidenedTab = WidenedTabIndex()
            If iSheetWidenedTab > -1 Then
                If (mTabData(iSheetWidenedTab).RowPos = nRowPos) And mTabData(iSheetWidenedTab).LeftTab Then
                    iSheetLeftTarget = iSheetLeftTarget - SelectedTabWideningPixels
                    ' Flat draws a row's first tab on iLeftOffset = -2, and the sheet takes its side
                    If mAppearanceIsFlat Then iSheetLeftTarget = iSheetLeftTarget - 2
                    iSheetFollowsWidened = True
                End If
            End If
            If iSheetLeftTarget > nLeft Then
                nWidth = nWidth - (iSheetLeftTarget - nLeft)
                nLeft = iSheetLeftTarget
                iSheetLeftPulledIn = True
            End If
            ' The cap at the far end for the non themed branch; the themed one caps itself through
            ' InactiveSheetRightLimit further down
            If Not mVisualStylesActive Then
                iSheetRightCap = 0
                For iRowScan = 0 To mRows - 1
                    If mRightMostTabsRightPos(iRowScan) > iSheetRightCap Then
                        iSheetRightCap = mRightMostTabsRightPos(iRowScan)
                    End If
                Next iRowScan
                ' nTab is this sheet's own row's last tab, so if it is the one being widened the
                ' sheet has to reach where it reaches or it comes away from it.
                If TabIsDrawnWidened(nTab) Then
                    If (mRightMostTabsRightPos(nRowPos) + SelectedTabWideningPixels) > iSheetRightCap Then
                        iSheetRightCap = mRightMostTabsRightPos(nRowPos) + SelectedTabWideningPixels
                    End If
                End If
                ' Inwards only, never outwards, like the clamp above
                If iSheetRightCap > 0 Then
                    If (nLeft + nWidth) > iSheetRightCap Then
                        nWidth = iSheetRightCap - nLeft
                    End If
                End If
            End If
        End If
    End If
    If mRows > 1 Then
        If nRowPos = mRows - 2 Then ' the row over the one that is the first over the body
            ' The sheet is skipped only when neither of its ends sticks out past the row in front of
            ' it, because then every pixel of it would be painted over anyway.
            If ((mLeftMostTabsLeftPos(nRowPos + 1) - nLeft) <= 0) And (((nLeft + nWidth) - mRightMostTabsRightPos(nRowPos + 1)) <= 0) Then
                If Not mRightMostTabsRightPos(nRowPos + 1) < mTabData(nTab).TabRect.Right Then
                    If Not mLeftMostTabsLeftPos(nRowPos + 1) > mTabData(nTab).TabRect.Left Then
                        Exit Sub
                    End If
                End If
            End If
        End If
    End If
    
    iFlatBarPosition = mFlatBarPosition
    If mOrientationIsBottom Then
        If iFlatBarPosition = ntBarPositionTop Then
            iFlatBarPosition = ntBarPositionBottom
        Else
            iFlatBarPosition = ntBarPositionTop
        End If
    End If
    
    iBackColorTabs = InactiveTabBackColorForDrawing(nTab)
    
    If mVisualStylesActive Then
        If (nWidth > mThemedRightMarginAsTop) Then
            EnsureBacksheetThemedReady
            ' nWidth is an offset and not a count: the non themed branch below hands it to Line ...
            ' BF, which includes both corners, so the sheet ends on nLeft + nWidth.
            iSheetLeft = nLeft
            iSheetRight = nLeft + nWidth
            If mShowsRowsPerspective2 And HighlightedTabIsWidened Then
                If Not TabIsDrawnWidened(nTab) Then iSheetRight = iSheetRight - SelectedTabWideningPixels
            End If
            ' With the perspective on the sheet runs to the end of the control, the way SSTab draws
            ' it: it is a stack of pages and the far edge is what makes it read as one.
            If Not mShowsRowsPerspective2 Then
                If iSheetLeft < 2 Then
                    iSheetLeft = 2
                End If
                ' The pane's border is drawn on its first column, so it starts where the tabs start,
                ' or where this row's first tab starts when it is the widened one
                iSheetLeftTarget = RowStartX()
                iSheetWidenedTab = WidenedTabIndex()
                If iSheetWidenedTab > -1 Then
                    If (mTabData(iSheetWidenedTab).RowPos = nRowPos) And mTabData(iSheetWidenedTab).LeftTab Then
                        iSheetLeftTarget = iSheetLeftTarget - SelectedTabWideningPixels
                        iSheetFollowsWidened = True
                    End If
                End If
                If iSheetFollowsWidened Then
                    iSheetLeft = iSheetLeftTarget
                ElseIf iSheetLeft < iSheetLeftTarget Then
                    iSheetLeft = iSheetLeftTarget
                End If
                ' The same column the row of tabs ends on, read from the same function so the two
                ' cannot drift apart again.
                iSheetRightCap = InactiveSheetRightLimit()
                If TabIsDrawnWidened(nTab) Then iSheetRightCap = iSheetRightCap + SelectedTabWideningPixels
                If iSheetRight > iSheetRightCap Then
                    iSheetRight = iSheetRightCap
                End If
            End If
            If iSheetRight >= iSheetLeft Then
                ' The themed twin of DrawSheetTopLine's gap (24.149): the owner already painted
                ' this row as its own continuation, so the pane's top border must not cross it
                iSheetGapLeft = mTabData(nTab).TabRect.Left
                If TabIsDrawnWidened(nTab) Then iSheetGapLeft = iSheetGapLeft - SelectedTabWideningPixels
                iSheetSavedDC = SaveDC(picDraw.hDC)
                ExcludeClipRect picDraw.hDC, iSheetGapLeft, nTop, iSheetOwnerRight + 1, nTop + 1
                BlitBacksheetThemed iSheetLeft, nTop, iSheetRight - iSheetLeft + 1, nHeight
#If SHEETDIAG = 1 Then ' TEMP diagnostic
                If mAmbientUserMode Then
                    Debug.Print "SHEETTH t="; nTab; " rowPos="; nRowPos; " nLeft="; nLeft; " sheetL="; iSheetLeft; " sheetR="; iSheetRight; " nTop="; nTop;
                    Debug.Print " rowStartX="; RowStartX(); " widen="; SelectedTabWideningSpace(); " bandShift="; ThemedBandShift(); " thLeftMargin="; mThemedLeftMarginAsTop; " thBodyLeftBorder="; mThemedBodyLeftBorderPixels;
                    Debug.Print " leftMost(own)="; mLeftMostTabsLeftPos(nRowPos); " leftMost(front)="; mLeftMostTabsLeftPos(mRows - 1); " persp="; Abs(CLng(mShowsRowsPerspective2))
                End If
#End If
                RestoreDC picDraw.hDC, iSheetSavedDC
            End If
        End If
    Else
        ' The page behind is mBacksheetTopInsetDPIScaled shorter than the body on purpose. nHeight
        ' has three readers - the blit, the line position and this test - that change together
        iDoBottomLine = mBodyHeight - nHeight <= mBacksheetTopInsetDPIScaled
        
        If mAppearanceIsFlat Then
            iAuxFlatRoundnessTopLeft = mFlatRoundnessTopDPIScaled
            iAuxFlatRoundnessTopRight = mFlatRoundnessTopDPIScaled
            If nRowPos < mRows - 1 Then
                If mTabsAlignedAtTheEnd Then
                    ' Not over the widening inset the sheet was already pulled in to
                    If (nLeft <= mFlatRoundnessTopDPIScaled) And (Not iSheetLeftPulledIn) Then
                        nLeft = 1
                    End If
                    If nLeft = 1 Then
                        If mLeftMostTabsLeftPos(nRowPos) <= mFlatRoundnessTopDPIScaled - 3 Then
                            iAuxFlatRoundnessTopLeft = 0
                        End If
                    End If
                    If mTabData(nTab).TabRect.Left <= (nLeft + 1) Then
                        iAuxFlatRoundnessTopLeft = 0
                    End If
                End If
                If iSheetFollowsWidened Then iAuxFlatRoundnessTopLeft = 0
                If iSheetOwnerRight >= (nLeft + nWidth - 1) Then
                    iAuxFlatRoundnessTopRight = 0
                End If
                If nWidth = mScaleWidth - nLeft Then
                    If mRightMostTabsRightPos(nRowPos) >= (mScaleWidth - (mFlatRoundnessTopDPIScaled - 3)) Then
                        iAuxFlatRoundnessTopRight = 0
                    End If
                End If
            End If
            iLng = 0
            FillCurvedGradient2 nLeft, nTop, nLeft + nWidth, nTop + nHeight, iBackColorTabs, iBackColorTabs, iAuxFlatRoundnessTopLeft, iAuxFlatRoundnessTopRight, mFlatRoundnessBottomDPIScaled, mFlatRoundnessBottomDPIScaled
        Else
            picDraw.Line (nLeft, nTop)-(nLeft + nWidth, nTop + nHeight), iBackColorTabs, BF
        End If
#If SHEETDIAG = 1 Then ' TEMP diagnostic
        If mAmbientUserMode Then
            Debug.Print "SHEET t="; nTab;
            Debug.Print " rowPos="; nRowPos;
            Debug.Print " nLeft="; nLeft;
            Debug.Print " nTop="; nTop;
            Debug.Print " nWidth="; nWidth;
            Debug.Print " nHeight="; nHeight;
            Debug.Print " rectL="; mTabData(nTab).TabRect.Left;
            Debug.Print " rectR="; mTabData(nTab).TabRect.Right;
            Debug.Print " rectB="; mTabData(nTab).TabRect.Bottom;
            Debug.Print " wide="; Abs(CLng(TabIsDrawnWidened(nTab)));
            Debug.Print " pull="; Abs(CLng(iSheetLeftPulledIn))
            Debug.Print "SHEET afterFill L-1/L/L+1 row0="; picDraw.Point(mTabData(nTab).TabRect.Left - 1, nTop); picDraw.Point(mTabData(nTab).TabRect.Left, nTop); picDraw.Point(mTabData(nTab).TabRect.Left + 1, nTop);
            Debug.Print " row1="; picDraw.Point(mTabData(nTab).TabRect.Left - 1, nTop + 1); picDraw.Point(mTabData(nTab).TabRect.Left, nTop + 1); picDraw.Point(mTabData(nTab).TabRect.Left + 1, nTop + 1);
            Debug.Print " R row0="; picDraw.Point(mTabData(nTab).TabRect.Right, nTop); picDraw.Point(mTabData(nTab).TabRect.Right + 1, nTop)
        End If
#End If
        
        ' The top line starts one column before the fill everywhere else, so that it meets the
        ' border of the tab on its left. With nLeft at 0 that column falls outside the canvas and
        ' nothing shows.
        iSheetTopLineLeft = nLeft - 1
        If iSheetLeftPulledIn Then iSheetTopLineLeft = nLeft
        ' The two border columns the sheet has to put back on its own first row, in the tones
        ' DrawTab uses for the tab's own sides.
        iSheetEdgeLeftColor = -1
        iSheetEdgeRightColor = -1
        If Not mAppearanceIsFlat Then
            If ((mTabOrientation <> ssTabOrientationLeft) And (mTabOrientation <> ntTabOrientationLeftTop) And (mTabOrientation <> ntTabOrientationLeftHorizontal) And (mTabOrientation <> ntTabOrientationLeftBottomHorizontal)) Or (Not mAppearanceIsPP) Then
                iSheetEdgeLeftColor = m3DHighlightV
                iSheetEdgeRightColor = m3DShadowV
            Else
                iSheetEdgesAsLeft = True
            End If
        End If
        If mAppearanceIsPP Then
            If Not mOrientationIsBottomOrRight Then ' [BOTTOMRIGHTGROUP]
                DrawSheetTopLine iSheetTopLineLeft, nLeft + nWidth, nTop, nTab, m3DHighlight, 0, iSheetEdgeLeftColor, iSheetEdgeRightColor, iSheetEdgesAsLeft
                ' Same twin as the body's own frame: this branch is the six orientations where the
                ' sheet's top edge is the lit one, and the Else below is the other six, which
                ' already close it with a dark pair.
                If mAppearanceIsTabStrip Then
                    DrawSheetTopLine iSheetTopLineLeft, nLeft + nWidth - 1, nTop + 1, nTab, m3DLight, 1
                End If
            Else
                DrawSheetTopLine iSheetTopLineLeft, nLeft + nWidth, nTop, nTab, m3DDKShadow, 0, iSheetEdgeLeftColor, iSheetEdgeRightColor
                ' Same gap as the light branch above.
                DrawSheetTopLine iSheetTopLineLeft, nLeft + nWidth - 1, nTop + 1, nTab, m3DShadow, 1
                ' The owner's right border ends one row later here (24.154's twin)
                If ((iSheetOwnerRight - 1) > mTabData(nTab).TabRect.Left) And (iSheetOwnerRight < (nLeft + nWidth)) Then
                    picDraw.Line (iSheetOwnerRight - 1, nTop + 1)-(iSheetOwnerRight + 1, nTop + 1), m3DShadow
                End If
            End If
        ElseIf mAppearanceIsFlat Then
            If mFlatBorderMode = ntBorderTabs Then
                iFlatBorderColor = TranslatedColor(mFlatBorderColor, ntRoleFore)
            Else
                iFlatBorderColor = TranslatedColor(mFlatTabsSeparationLineColor, ntRoleFore)
            End If
            DrawSheetTopLine iSheetTopLineLeft + IIf(mTabsAlignedAtTheEnd, iAuxFlatRoundnessTopLeft, 0), nLeft + nWidth - iAuxFlatRoundnessTopRight, nTop, nTab, iFlatBorderColor
        Else
            DrawSheetTopLine iSheetTopLineLeft, nLeft + nWidth, nTop, nTab, m3DDKShadow, 0, iSheetEdgeLeftColor, iSheetEdgeRightColor
            ' The white twin is the one that showed the defect: it crossed the owner tab from side
            ' to side and cut it away from its own sheet.
            DrawSheetTopLine iSheetTopLineLeft, nLeft + 1 + nWidth, nTop + 1, nTab, m3DHighlightH, 1
        End If
        
        ' left line
        If mTabsAlignedAtTheEnd Then
            iLinePos = nLeft
            ' Drawn one column before the fill, which is the control's edge when the sheet starts at 1.
            ' Pulled in to the widening inset it has to land on the fill's first column instead,
            ' where the inactive tabs start.
            If iSheetLeftPulledIn And mAppearanceIsPP Then iLinePos = nLeft + 1
        Else
            iLinePos = nLeft + nWidth '- 1
        End If
        If mAppearanceIsFlat Then
            'Right Line
            If mTabsAlignedAtTheEnd Then
                picDraw.Line (iLinePos - 1, nTop + iAuxFlatRoundnessTopLeft)-(iLinePos - 1, nTop + nHeight - mFlatRoundnessBottomDPIScaled), iFlatBorderColor
            Else
                If ((iLinePos) - mRightMostTabsRightPos(nRowPos)) > mFlatRoundnessTopDPIScaled Then
                    picDraw.Line (iLinePos, nTop + iAuxFlatRoundnessTopRight)-(iLinePos, nTop + nHeight - mFlatRoundnessBottomDPIScaled), iFlatBorderColor
                Else
                    picDraw.Line (iLinePos, nTop + iAuxFlatRoundnessTopRight)-(iLinePos, nTop + nHeight - mFlatRoundnessBottomDPIScaled), iFlatBorderColor
                End If
            End If
        Else
            If mTabsAlignedAtTheEnd Then
                If mAppearanceIsPP Then
                    picDraw.Line (iLinePos - 1, nTop + 1)-(iLinePos - 1, nTop + nHeight), m3DHighlightV
                    If mAppearanceIsTabStrip Then
                        If (mTabOrientation <> ssTabOrientationLeft) And (mTabOrientation <> ntTabOrientationLeftTop) And (mTabOrientation <> ntTabOrientationLeftHorizontal) And (mTabOrientation <> ntTabOrientationLeftBottomHorizontal) Then
                            picDraw.Line (iLinePos, nTop + 1)-(iLinePos, nTop + nHeight), m3DLight
                        End If
                    End If
                Else
                    picDraw.Line (iLinePos, nTop + 1)-(iLinePos, nTop + nHeight), m3DHighlightV
                    picDraw.Line (iLinePos - 1, nTop + 1)-(iLinePos - 1, nTop + nHeight), m3DDKShadow
                End If
            Else
                If ((mTabOrientation <> ssTabOrientationLeft) And (mTabOrientation <> ntTabOrientationLeftTop) And (mTabOrientation <> ntTabOrientationLeftHorizontal) And (mTabOrientation <> ntTabOrientationLeftBottomHorizontal)) Or (Not mAppearanceIsPP) Then
                    picDraw.Line (iLinePos, nTop)-(iLinePos, nTop + nHeight), m3DDKShadow
                    picDraw.Line (iLinePos - 1, nTop + 1)-(iLinePos - 1, nTop + nHeight), m3DShadowV
                Else
                    picDraw.Line (iLinePos, nTop)-(iLinePos, nTop + nHeight), m3DHighlightH
                    ' m3DHighlightH is the light tone in the four Left orientations, which are
                    ' the only ones that reach this arm, so the sheet's side edge is lit here
                    ' and takes the twin on its inner column
                    If mAppearanceIsTabStrip Then
                        picDraw.Line (iLinePos - 1, nTop + 1)-(iLinePos - 1, nTop + nHeight), m3DLight
                    End If
                End If
            End If
        End If
        ' The near end only shows when it follows a widened first tab out past the row in front
        If iSheetFollowsWidened And (Not mTabsAlignedAtTheEnd) Then
            If mAppearanceIsFlat Then
                picDraw.Line (nLeft, nTop)-(nLeft, nTop + nHeight - mFlatRoundnessBottomDPIScaled), iFlatBorderColor
            ElseIf iSheetEdgeLeftColor <> -1 Then
                If mAppearanceIsPP Then
                    picDraw.Line (nLeft, nTop)-(nLeft, nTop + nHeight), iSheetEdgeLeftColor
                Else
                    ' Tabbed dialog: the tab's side is a dark column on Left - 1 and the light one on Left
                    picDraw.Line (nLeft - 1, nTop)-(nLeft - 1, nTop + nHeight), m3DDKShadow
                    picDraw.Line (nLeft, nTop + 1)-(nLeft, nTop + nHeight), iSheetEdgeLeftColor
                End If
            Else
                picDraw.Line (nLeft, nTop)-(nLeft, nTop + nHeight), m3DDKShadow
            End If
        End If
        If mTabsAlignedAtTheEnd Then
            'do TabsAlignedAtTheEnd right line
            iLinePos = nLeft + nWidth
            ' The two tests further down single out ntTabOrientationBottomRight among the six
            ' members of mTabsAlignedAtTheEnd.
            If mAppearanceIsFlat Then
                If ((iLinePos) - mRightMostTabsRightPos(nRowPos)) > mFlatRoundnessTopDPIScaled Then
                    picDraw.Line (iLinePos, nTop + IIf(mTabOrientation = ntTabOrientationBottomRight, 0, mFlatRoundnessTopDPIScaled))-(iLinePos, nTop + nHeight - mFlatRoundnessBottomDPIScaled), iFlatBorderColor
                Else
                    picDraw.Line (iLinePos, nTop)-(iLinePos, nTop + nHeight - mFlatRoundnessBottomDPIScaled), iFlatBorderColor
                End If
                If (mFlatRoundnessTopDPIScaled > 0) Then
                    ' top-right corner
                    If (((iLinePos) - mRightMostTabsRightPos(nRowPos)) > mFlatRoundnessTopDPIScaled) And (Not (mTabOrientation = ntTabOrientationBottomRight)) Then
                        iLineColor = iFlatBorderColor
                        If iLineColor <> iBackColorTabs Then
                            DrawRoundedCorner ntCornerTopRight, iLinePos, nTop, mFlatRoundnessTopDPIScaled, iLineColor, , iSheetOwnerRight
                        End If
                    End If
                End If
            Else
                If ((mTabOrientation <> ssTabOrientationLeft) And (mTabOrientation <> ntTabOrientationLeftTop) And (mTabOrientation <> ntTabOrientationLeftHorizontal) And (mTabOrientation <> ntTabOrientationLeftBottomHorizontal)) Or (Not mAppearanceIsPP) Then
                    picDraw.Line (iLinePos, nTop)-(iLinePos, nTop + nHeight), m3DDKShadow
                    picDraw.Line (iLinePos - 1, nTop + 1)-(iLinePos - 1, nTop + nHeight), m3DShadowV
                Else
                    picDraw.Line (iLinePos, nTop)-(iLinePos, nTop + nHeight), m3DHighlightH
                    ' m3DHighlightH is the light tone in the four Left orientations, which are
                    ' the only ones that reach this arm, so the sheet's side edge is lit here
                    ' and takes the twin on its inner column
                    If mAppearanceIsTabStrip Then
                        picDraw.Line (iLinePos - 1, nTop + 1)-(iLinePos - 1, nTop + nHeight), m3DLight
                    End If
                End If
            End If
        End If
        If mAppearanceIsFlat Then
            ' top-left corner
            If (iAuxFlatRoundnessTopLeft > 0) Then
                iLineColor = iFlatBorderColor
                DrawRoundedCorner ntCornerTopleft, nLeft - 1, nTop, iAuxFlatRoundnessTopLeft, iFlatBorderColor, , mTabData(nTab).TabRect.Left
            End If
            ' top-right corner
            If (mFlatRoundnessTopDPIScaled > 0) Then
                iLineColor = iFlatBorderColor
                If iLineColor <> iBackColorTabs Then
                    DrawRoundedCorner ntCornerTopRight, iLinePos, nTop, mFlatRoundnessTopDPIScaled, iLineColor, , iSheetOwnerRight
                End If
            End If
        End If
        
        'bottom line
        If iDoBottomLine Then
            If mAppearanceIsFlat Then
                picDraw.Line (nLeft - 1, nTop + nHeight)-(nLeft + nWidth + 1 - mFlatRoundnessBottomDPIScaled, nTop + nHeight), iFlatBorderColor
            Else
                If mAppearanceIsPP And mOrientationIsBottomOrRight Then ' [BOTTOMRIGHTGROUP]
                    ' Property page closes the sheet with a single light line - its far
                    ' edge is a lit edge and nothing else. Only Bottom and Right ask for
                    ' this; Top and Left never did, in property page or tabbed dialog.
                    picDraw.Line (nLeft - 1, nTop - 1 + nHeight)-(nLeft + nWidth, nTop - 1 + nHeight), m3DHighlight
                    If mAppearanceIsTabStrip Then
                        picDraw.Line (nLeft - 1, nTop - 2 + nHeight)-(nLeft + nWidth, nTop - 2 + nHeight), m3DLight
                    End If
                Else
                    ' Tabbed dialog and Windows close the sheet with a pair of lines, a light row
                    ' and a dark one, and since 24.29 put the Bottom/Right row on the same as-Top
                    ' row as Top/Left the pair is identical in all twelve.
                    picDraw.Line (nLeft - 1, nTop - 2 + nHeight)-(nLeft + nWidth, nTop - 2 + nHeight), m3DShadowH
                    picDraw.Line (nLeft - 1, nTop - 1 + nHeight)-(nLeft + nWidth + IIf(iSheetEdgeRightColor = -1, 1, 0), nTop - 1 + nHeight), m3DDKShadow
                End If
            End If
        End If
        
        If mAppearanceIsFlat Then
            If mFlatRoundnessBottomDPIScaled > 0 Then
                iLineColor = iFlatBorderColor
                ' botom-right corner
                DrawRoundedCorner ntCornerBottomRight, nLeft + nWidth, nTop + nHeight, mFlatRoundnessBottomDPIScaled, iLineColor
            End If
        End If
    End If
#If SHEETDIAG = 1 Then ' TEMP diagnostic
    If mAmbientUserMode Then
        Debug.Print "SHEET atEnd  t="; nTab;
        Debug.Print " L-1/L/L+1 row0="; picDraw.Point(mTabData(nTab).TabRect.Left - 1, nTop); picDraw.Point(mTabData(nTab).TabRect.Left, nTop); picDraw.Point(mTabData(nTab).TabRect.Left + 1, nTop);
        Debug.Print " row1="; picDraw.Point(mTabData(nTab).TabRect.Left - 1, nTop + 1); picDraw.Point(mTabData(nTab).TabRect.Left, nTop + 1); picDraw.Point(mTabData(nTab).TabRect.Left + 1, nTop + 1);
        Debug.Print " R row0="; picDraw.Point(mTabData(nTab).TabRect.Right, nTop); picDraw.Point(mTabData(nTab).TabRect.Right + 1, nTop);
        Debug.Print " R-1 row0="; picDraw.Point(mTabData(nTab).TabRect.Right - 1, nTop); " edgeR="; iSheetEdgeRightColor
        mSheetDiagX = mTabData(nTab).TabRect.Right - 1
        mSheetDiagY = nTop
    End If
#End If
End Sub


Private Sub BlitBacksheetThemed(ByVal nLeft As Long, ByVal nTop As Long, ByVal nWidth As Long, ByVal nHeight As Long)
    ' Copies the darkened pane into picDraw keeping its four border bands and shrinking only what
    ' lies between them, the way a nine slice does.
    Dim iSrcX(0 To 2) As Long
    Dim iSrcW(0 To 2) As Long
    Dim iSrcY(0 To 2) As Long
    Dim iSrcH(0 To 2) As Long
    Dim iDstX(0 To 2) As Long
    Dim iDstW(0 To 2) As Long
    Dim iDstY(0 To 2) As Long
    Dim iDstH(0 To 2) As Long
    Dim iSrcWidth As Long
    Dim iSrcHeight As Long
    Dim iLeftBand As Long
    Dim iRightBand As Long
    Dim iTopBand As Long
    Dim iBottomBand As Long
    Dim iPrevMode As Long
    Dim iCol As Long
    Dim iRow As Long
    
    If (nWidth < 1) Or (nHeight < 1) Then Exit Sub
    iSrcWidth = picBacksheetThemed.ScaleWidth
    iSrcHeight = picBacksheetThemed.ScaleHeight
    If (iSrcWidth < 1) Or (iSrcHeight < 1) Then Exit Sub
    
    iLeftBand = mThemedLeftMarginAsTop
    iRightBand = mThemedRightMarginAsTop
    iTopBand = 1
    iBottomBand = mThemedBottomMarginAsTop
    
    ' Degenerate sheet - narrower or shorter than its own borders. Nothing to preserve,
    ' and splitting it would ask for negative middles
    If (iLeftBand + iRightBand >= iSrcWidth) Or (iLeftBand + iRightBand >= nWidth) Or (iTopBand + iBottomBand >= iSrcHeight) Or (iTopBand + iBottomBand >= nHeight) Then
        iPrevMode = SetStretchBltMode(picDraw.hDC, COLORONCOLOR)
        StretchBlt picDraw.hDC, nLeft, nTop, nWidth, nHeight, picBacksheetThemed.hDC, 0, 0, iSrcWidth, iSrcHeight, vbSrcCopy
        If iPrevMode <> 0 Then
            SetStretchBltMode picDraw.hDC, iPrevMode
        End If
        Exit Sub
    End If
    
    iSrcX(0) = 0
    iSrcW(0) = iLeftBand
    iSrcX(1) = iLeftBand
    iSrcW(1) = iSrcWidth - iLeftBand - iRightBand
    iSrcX(2) = iSrcWidth - iRightBand
    iSrcW(2) = iRightBand
    iDstX(0) = 0
    iDstW(0) = iLeftBand
    iDstX(1) = iLeftBand
    iDstW(1) = nWidth - iLeftBand - iRightBand
    iDstX(2) = nWidth - iRightBand
    iDstW(2) = iRightBand
    
    iSrcY(0) = 0
    iSrcH(0) = iTopBand
    iSrcY(1) = iTopBand
    iSrcH(1) = iSrcHeight - iTopBand - iBottomBand
    iSrcY(2) = iSrcHeight - iBottomBand
    iSrcH(2) = iBottomBand
    iDstY(0) = 0
    iDstH(0) = iTopBand
    iDstY(1) = iTopBand
    iDstH(1) = nHeight - iTopBand - iBottomBand
    iDstY(2) = nHeight - iBottomBand
    iDstH(2) = iBottomBand
    
    iPrevMode = SetStretchBltMode(picDraw.hDC, COLORONCOLOR)
    For iCol = 0 To 2
        For iRow = 0 To 2
            If (iSrcW(iCol) > 0) And (iSrcH(iRow) > 0) And (iDstW(iCol) > 0) And (iDstH(iRow) > 0) Then
                StretchBlt picDraw.hDC, nLeft + iDstX(iCol), nTop + iDstY(iRow), iDstW(iCol), iDstH(iRow), picBacksheetThemed.hDC, iSrcX(iCol), iSrcY(iRow), iSrcW(iCol), iSrcH(iRow), vbSrcCopy
            End If
        Next iRow
    Next iCol
    If iPrevMode <> 0 Then
        SetStretchBltMode picDraw.hDC, iPrevMode
    End If
End Sub

Private Sub DrawBody(ByVal nScaleHeight As Long)
    Dim iClientStartShift As Long
    Dim iLineColor As Long
    Dim iFlatBorderColor As Long
    Dim iFlatBodySeparationLineColor As Long
    Dim iColor As Long
    Dim iActiveTabIsLeft As Boolean
    Dim iTopLeftCornerRoundness As Long
    Dim iTopRightCornerRoundness As Long
    Dim iLeftCornerUnderTabs As Boolean
    Dim iSelectedRoundsRightEnd As Boolean
    Dim iBodyRightSquare As Boolean
    Dim iBodyRightRounded As Boolean
    Dim iLng As Long
    Dim iEdgeSlack As Long
    
    ' A row that reaches the far end stops RowEndMargin short of it, widening room included
    iEdgeSlack = RowEndMargin + 2
    If mVisualStylesActive Then
        EnsureBodyThemedReady
        BitBlt picDraw.hDC, 0, mBodyStart - 2, picBodyThemed.ScaleWidth, picBodyThemed.ScaleHeight, picBodyThemed.hDC, 0, 0, vbSrcCopy
    Else
        ' background
        If mAppearanceIsPP Then
            iClientStartShift = -1
        Else
            iClientStartShift = 0
        End If
        
        iColor = mBackColorSelectedTab2
        
        If mBackStyle = ntTransparentBackOnly Then
            iColor = iColor Xor 1
        End If
        If mAppearanceIsFlat Then
            If mTab > -1 Then
                iActiveTabIsLeft = mTabData(mTab).LeftTab
            End If
            If (mFlatRoundnessTopDPIScaled > 0) And (mFlatBodySeparationLineHeight = 1) Then
                ' With the strip scrolled the back chevron sits where the row would start, so that end
                ' gets the corner and the line of the end without tabs too
                If mTabsAlignedAtTheEnd Or mStripScrolls Then
                    If mLeftMostTabsLeftPos(mRows - 1) > (mFlatRoundnessTopDPIScaled - 3) And (mFlatBodySeparationLineHeight = 1) Then
                        iTopLeftCornerRoundness = mFlatRoundnessTopDPIScaled
                    End If
                End If
                If ((mBodyWidth - mTabData(mTab).TabRect.Right) > iEdgeSlack) And ((mFlatBorderMode = ntBorderSelectedTab) Or ((mBodyWidth - mRightMostTabsRightPos(mRows - 1)) > iEdgeSlack)) Then
                    If (mFlatRoundnessTopDPIScaled > 0) And (mFlatBodySeparationLineHeight = 1) Then
                        iTopRightCornerRoundness = mFlatRoundnessTopDPIScaled
                    End If
                End If
                ' A selected tab closed and rounded at the bottom does not join the body: the body keeps its corners
                If (mFlatBorderMode = ntBorderSelectedTab) And mHighlightRoundBottomSelectedTab And (Not mFlatRowEndsSquared) Then
                    iTopLeftCornerRoundness = mFlatRoundnessTopDPIScaled
                    iSelectedRoundsRightEnd = (mFlatBodySeparationLineHeight = 1)
                End If
                ' With the border on the selected tab only, the body rounds under the tabs at both ends
                ' unless the selected tab is the one sitting on that corner
                iLeftCornerUnderTabs = (mFlatBorderMode = ntBorderSelectedTab) And (mTabData(mTab).TabRect.Left > iEdgeSlack)
                If iLeftCornerUnderTabs Then iTopLeftCornerRoundness = mFlatRoundnessTopDPIScaled
            End If
            If mTabData(mTab).TabRect.Right >= (mBodyWidth - iEdgeSlack) Then
                iTopRightCornerRoundness = 0
                If iSelectedRoundsRightEnd Then iTopRightCornerRoundness = mFlatRoundnessTopDPIScaled
            End If
            ' Under a square front-row end the body corner stays square too
            If mFlatFrontRowLeftEndSquared And (mLeftMostTabsLeftPos(mRows - 1) <= iEdgeSlack) Then iTopLeftCornerRoundness = 0
            If mFlatFrontRowRightEndSquared And (mRightMostTabsRightPos(mRows - 1) >= (mBodyWidth - iEdgeSlack)) Then
                iTopRightCornerRoundness = 0
                iSelectedRoundsRightEnd = False
                iBodyRightSquare = True
            End If
            ' Without a one-row separation line the body has no top edge to round
            If mFlatBodySeparationLineHeight <> 1 Then
                iTopLeftCornerRoundness = 0
                iTopRightCornerRoundness = 0
                iBodyRightSquare = True
                ' With no line at all, a corner under a tab closed at the bottom is still rounded, or its side ends in the air
                If (mFlatBodySeparationLineHeight = 0) And (mFlatRoundnessTopDPIScaled > 0) Then
                    If FlatFrontRowEndClosedAtBottom(True, iEdgeSlack) Then iTopLeftCornerRoundness = mFlatRoundnessTopDPIScaled
                    If FlatFrontRowEndClosedAtBottom(False, iEdgeSlack) Then
                        iTopRightCornerRoundness = mFlatRoundnessTopDPIScaled
                        iBodyRightRounded = True
                    End If
                End If
            End If
            FillCurvedGradient2 0, mBodyStart + iClientStartShift, mBodyWidth - 1, nScaleHeight - 1, iColor, iColor, iTopLeftCornerRoundness, IIf(iBodyRightRounded, mFlatRoundnessTopDPIScaled, IIf(iBodyRightSquare, 0, IIf(((mBodyWidth - mTabData(mTab).TabRect.Right) > iEdgeSlack) And ((mFlatBorderMode = ntBorderSelectedTab) Or ((mBodyWidth - mRightMostTabsRightPos(mRows - 1)) > iEdgeSlack)), IIf(mTabsAlignedAtTheEnd And (mFlatBorderMode <> ntBorderSelectedTab), 0, mFlatRoundnessTopDPIScaled), IIf(iSelectedRoundsRightEnd, mFlatRoundnessTopDPIScaled, 0)))), mFlatRoundnessBottomDPIScaled, mFlatRoundnessBottomDPIScaled
        Else
            picDraw.Line (0, mBodyStart + iClientStartShift)-(mBodyWidth - 1, nScaleHeight - 1), iColor, BF
        End If
        
        If mAppearanceIsPP Then
            ' top line The outer edge of the body sits on mBodyStart - 2, not on mBodyStart - 1.
            If Not mOrientationIsBottomOrRight Then ' [BOTTOMRIGHTGROUP]
                picDraw.Line (0, mBodyStart - 2)-(mBodyWidth - 1, mBodyStart - 2), m3DHighlightH_Sel
                ' Lands on the fill's first row, which iClientStartShift put at
                ' mBodyStart - 1, and the active tab is drawn after the body and takes its
                ' own span back - the same order the frame row above already relies on
                If mAppearanceIsTabStrip Then
                    picDraw.Line (0, mBodyStart - 1)-(mBodyWidth - 1, mBodyStart - 1), m3DLight_Sel
                End If
            Else
                picDraw.Line (0, mBodyStart - 2)-(mBodyWidth - 1, mBodyStart - 2), m3DDKShadow_Sel
                picDraw.Line (1, mBodyStart - 1)-(mBodyWidth - 1, mBodyStart - 1), m3DShadow_Sel
            End If
            
            If (mTabOrientation = ssTabOrientationTop) Or (mTabOrientation = ntTabOrientationTopRight) Then
                'left line
                picDraw.Line (0, mBodyStart - 1)-(0, nScaleHeight - 1), m3DHighlightV_Sel
                If mAppearanceIsTabStrip Then
                    picDraw.Line (1, mBodyStart - 1)-(1, nScaleHeight - 1), m3DLight_Sel
                End If
                
                'right line
                picDraw.Line (mBodyWidth - 1, mBodyStart - 2)-(mBodyWidth - 1, nScaleHeight - 1), m3DDKShadow_Sel
                picDraw.Line (mBodyWidth - 2, mBodyStart - 1)-(mBodyWidth - 2, nScaleHeight - 2), m3DShadowV_Sel
#If TWINJOINDIAG = 1 Then ' TEMP diagnostic
                If mAppearanceIsTabStrip And mAmbientUserMode Then
                    Debug.Print "TWINJOIN where=afterBodyRightPair";
                    Debug.Print " r3="; picDraw.Point(mBodyWidth - 3, mBodyStart - 1);
                    Debug.Print " r2="; picDraw.Point(mBodyWidth - 2, mBodyStart - 1);
                    Debug.Print " shadowV_Sel="; m3DShadowV_Sel;
                    Debug.Print " light_Sel="; m3DLight_Sel;
                    Debug.Print " shadowV="; m3DShadowV;
                    Debug.Print " light="; m3DLight
                End If
#End If
                
                'bottom line
                picDraw.Line (0, nScaleHeight - 1)-(mBodyWidth, nScaleHeight - 1), m3DDKShadow_Sel
                If mBodyHeight > 3 Then
                    picDraw.Line (1, nScaleHeight - 2)-(mBodyWidth - 1, nScaleHeight - 2), m3DShadowH_Sel
                End If
            ElseIf (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Or (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationLeftBottomHorizontal) Then
                ' left line Starts on mBodyStart - 2 and not mBodyStart - 1, unlike its shadow twin
                ' below: the body's light row a few lines above starts on x = 0, so with - 1 that
                ' one corner pixel stayed light where the dark edge belongs.
                picDraw.Line (0, mBodyStart - 2)-(0, nScaleHeight - 1), m3DDKShadow_Sel
                picDraw.Line (1, mBodyStart - 1)-(1, nScaleHeight - 1), m3DShadow_Sel
            
                'right line
                picDraw.Line (mBodyWidth - 1, mBodyStart - 2)-(mBodyWidth - 1, nScaleHeight - 1), m3DHighlight_Sel
                If mAppearanceIsTabStrip Then
                    picDraw.Line (mBodyWidth - 2, mBodyStart - 1)-(mBodyWidth - 2, nScaleHeight - 1), m3DLight_Sel
                End If
            
                'bottom line
                picDraw.Line (0, nScaleHeight - 1)-(mBodyWidth, nScaleHeight - 1), m3DDKShadow_Sel
                If mBodyHeight > 3 Then
                    picDraw.Line (1, nScaleHeight - 2)-(mBodyWidth - 1, nScaleHeight - 2), m3DShadowH_Sel
                End If
            Else 'Bottom or Right
                'left line
                picDraw.Line (0, mBodyStart - 1)-(0, nScaleHeight - 1), m3DHighlightV_Sel
                If mAppearanceIsTabStrip Then
                    picDraw.Line (1, mBodyStart - 1)-(1, nScaleHeight - 1), m3DLight_Sel
                End If
#If TWINJOINDIAG = 1 Then ' TEMP diagnostic
                If mAppearanceIsTabStrip And mAmbientUserMode Then
                    Debug.Print "TWINJOIN where=afterBodyLeftTwin";
                    Debug.Print " px="; picDraw.Point(1, mBodyStart - 1);
                    Debug.Print " r3="; picDraw.Point(mBodyWidth - 3, mBodyStart - 1);
                    Debug.Print " r2="; picDraw.Point(mBodyWidth - 2, mBodyStart - 1);
                    Debug.Print " bodyStart="; mBodyStart;
                    Debug.Print " bodyWidth="; mBodyWidth
                End If
#End If
                
                'right line
                picDraw.Line (mBodyWidth - 1, mBodyStart - 2)-(mBodyWidth - 1, nScaleHeight), m3DDKShadow_Sel
                picDraw.Line (mBodyWidth - 2, mBodyStart - 1)-(mBodyWidth - 2, nScaleHeight - 1), m3DShadowV_Sel
                
                ' bottom line
                ' m3DShadowH is the light tone in the Bottom and Right families, so this
                ' single row is the light edge of the frame there and it takes the twin
                picDraw.Line (0, nScaleHeight - 1)-(mBodyWidth - 1, nScaleHeight - 1), m3DShadowH_Sel
                If mAppearanceIsTabStrip Then
                    picDraw.Line (1, nScaleHeight - 2)-(mBodyWidth - 1, nScaleHeight - 2), m3DLight_Sel
                End If
            End If
        ElseIf mAppearanceIsFlat Then
            iFlatBorderColor = TranslatedColor(mFlatBorderColor, ntRoleFore)
            If (mFlatBorderMode = ntBorderTabs) Or (mFlatBodySeparationLineHeight > 1) Then
                iFlatBodySeparationLineColor = TranslatedColor(mFlatBodySeparationLineColor, ntRoleFore)
            Else
                iFlatBodySeparationLineColor = iFlatBorderColor
            End If
            
            mFlatBodyTopLeftRounded = (iTopLeftCornerRoundness > 0)
            mFlatBodyTopRightRounded = (iTopRightCornerRoundness > 0)
            ' top line
            If (iFlatBodySeparationLineColor <> mBackColorTabs2) Then
                If mFlatBodySeparationLineHeight = 1 Then
                    picDraw.Line (iTopLeftCornerRoundness, mBodyStart)-(mBodyWidth - 1 - iTopRightCornerRoundness, mBodyStart), iFlatBodySeparationLineColor
                ElseIf mFlatBodySeparationLineHeight > 1 Then
                    picDraw.Line (0, mBodyStart)-(mBodyWidth - 2, mBodyStart + mFlatBodySeparationLineHeightDPIScaled - 1), iFlatBodySeparationLineColor, BF
                End If
            End If
            
            ' left line
            picDraw.Line (0, mBodyStart + iTopLeftCornerRoundness)-(0, nScaleHeight - 1 - mFlatRoundnessBottomDPIScaled), iFlatBorderColor
            
            ' top-right corner round
            If iTopRightCornerRoundness > 0 Then
                If ((mBodyWidth - mTabData(mTab).TabRect.Right) > iEdgeSlack) And mFlatBorderMode = ntBorderSelectedTab Then
                    iLineColor = iFlatBodySeparationLineColor
                Else
                    iLineColor = iFlatBorderColor
                End If
                DrawRoundedCorner ntCornerTopRight, mBodyWidth - 1, mBodyStart, iTopRightCornerRoundness, iLineColor
            End If
            
            ' right line
            picDraw.Line (mBodyWidth - 1, mBodyStart + iTopRightCornerRoundness)-(mBodyWidth - 1, nScaleHeight - 1 - mFlatRoundnessBottomDPIScaled), iFlatBorderColor
            ' bottom line
            picDraw.Line (mFlatRoundnessBottomDPIScaled, nScaleHeight - 1)-(mBodyWidth - mFlatRoundnessBottomDPIScaled, nScaleHeight - 1), iFlatBorderColor
            
            ' top-left corner
            If iTopLeftCornerRoundness > 0 Then
                If iLeftCornerUnderTabs Then
                    iLineColor = iFlatBodySeparationLineColor
                Else
                    iLineColor = iFlatBorderColor
                End If
                DrawRoundedCorner ntCornerTopleft, 0, mBodyStart, iTopLeftCornerRoundness, iLineColor
            End If
            
            If mTabsAlignedAtTheEnd Or mStripScrolls Then
                If mLeftMostTabsLeftPos(mRows - 1) > iTopLeftCornerRoundness Then
                    picDraw.Line (iTopLeftCornerRoundness, mBodyStart)-(mLeftMostTabsLeftPos(mRows - 1) - 1, mBodyStart), iFlatBorderColor
                End If
            End If
            If (Not mTabsAlignedAtTheEnd) Or mStripScrolls Then
                If (mBodyWidth - mRightMostTabsRightPos(mRows - 1)) > iEdgeSlack Then
                    picDraw.Line (mRightMostTabsRightPos(mRows - 1), mBodyStart)-(mBodyWidth - 1 - IIf(mFlatBodySeparationLineHeight = 1, mFlatRoundnessTopDPIScaled, 0), mBodyStart), iFlatBorderColor ' iFlatBodySeparationLineColor
                End If
            End If
            
            If mFlatRoundnessBottomDPIScaled > 0 Then
                iLineColor = iFlatBorderColor
                ' botom-left corner
                DrawRoundedCorner ntCornerBottomLeft, 0, nScaleHeight - 1, mFlatRoundnessBottomDPIScaled, iLineColor
                
                ' botom-right corner
                DrawRoundedCorner ntCornerBottomRight, mBodyWidth - 1, nScaleHeight - 1, mFlatRoundnessBottomDPIScaled, iLineColor
            End If
        Else
            ' top line
            picDraw.Line (0, mBodyStart - 2)-(mBodyWidth - 1, mBodyStart - 2), m3DDKShadow_Sel
            picDraw.Line (2, mBodyStart - 1)-(mBodyWidth - 1, mBodyStart - 1), m3DHighlightH_Sel
            picDraw.Line (3, mBodyStart)-(mBodyWidth - 2, mBodyStart), m3DHighlightH_Sel
            
            ' left line
            ' Line leaves its far endpoint unpainted, so the two light columns run one row further down
            picDraw.Line (0, mBodyStart - 2)-(0, nScaleHeight - 1), m3DDKShadow_Sel
            picDraw.Line (1, mBodyStart - 1)-(1, nScaleHeight - 1), m3DHighlightV_Sel
            picDraw.Line (2, mBodyStart)-(2, nScaleHeight - 2), m3DHighlightV_Sel

            ' right line Not touched: on this side shadow meets shadow and then the dark column, so
            ' there is no staircase to get wrong.
            picDraw.Line (mBodyWidth - 1, mBodyStart - 2)-(mBodyWidth - 1, nScaleHeight - 1), m3DDKShadow_Sel
            picDraw.Line (mBodyWidth - 2, mBodyStart - 1)-(mBodyWidth - 2, nScaleHeight - 2), m3DShadowV_Sel
            picDraw.Line (mBodyWidth - 3, mBodyStart)-(mBodyWidth - 3, nScaleHeight - 3), m3DShadowV_Sel
            
            ' bottom line The two shadow rows start on 2 and 3 and not on 1 and 2: the columns they
            ' used to start on belong to the light left edge, which turns the corner there.
            picDraw.Line (0, nScaleHeight - 1)-(mBodyWidth, nScaleHeight - 1), m3DDKShadow_Sel
            If mBodyHeight > 3 Then
                picDraw.Line (2, nScaleHeight - 2)-(mBodyWidth - 1, nScaleHeight - 2), m3DShadowH_Sel
            End If
            If mBodyHeight > 4 Then
                picDraw.Line (3, nScaleHeight - 3)-(mBodyWidth - 2, nScaleHeight - 3), m3DShadowH_Sel
            End If
        End If
    End If
    If mAppearanceIsFlat Then
        mClientSpaceData.LeftTopRoundness = iTopLeftCornerRoundness
        mClientSpaceData.RightTopRoundness = iTopRightCornerRoundness
        mClientSpaceData.LeftBottomRoundness = mFlatRoundnessBottomDPIScaled
        mClientSpaceData.RightBottomRoundness = mFlatRoundnessBottomDPIScaled
    Else
        mClientSpaceData.LeftTopRoundness = 0
        mClientSpaceData.RightTopRoundness = 0
        mClientSpaceData.LeftBottomRoundness = 0
        mClientSpaceData.RightBottomRoundness = 0
    End If
End Sub

Private Function CloseButtonColorEffective(ByVal nTab As Long, ByVal nColorID As NTTabCustomColorIDConstants) As Long
    ' Three of these five come out of the tab's resolved cache: Empty in the slot no longer means
    ' "use the general one", it means "inherit", and the answer was already worked out by
    ' ApplyTabChainColorsForTab.
    Select Case nColorID
    Case ntCCCloseButtonColorSelectedTab
        CloseButtonColorEffective = mTabData(nTab).CustomColors.ResolvedChainColor(ntChainCloseButtonColorSelectedTab)
    Case ntCCCloseButtonColorMouseHover
        If IsEmpty(mTabData(nTab).CustomColors.CloseButtonColorMouseHover) Then
            CloseButtonColorEffective = mCloseButtonColorMouseHover
        Else
            CloseButtonColorEffective = mTabData(nTab).CustomColors.CloseButtonColorMouseHover
        End If
    Case ntCCCloseButtonColorMouseHoverSelectedTab
        If IsEmpty(mTabData(nTab).CustomColors.CloseButtonColorMouseHoverSelectedTab) Then
            CloseButtonColorEffective = mCloseButtonColorMouseHoverSelectedTab
        Else
            CloseButtonColorEffective = mTabData(nTab).CustomColors.CloseButtonColorMouseHoverSelectedTab
        End If
    Case ntCCCloseButtonColorTabHighlighted
        CloseButtonColorEffective = mTabData(nTab).CustomColors.ResolvedChainColor(ntChainCloseButtonColorTabHighlighted)
    Case Else
        CloseButtonColorEffective = mTabData(nTab).CustomColors.ResolvedChainColor(ntChainCloseButtonColor)
    End Select
End Function

' The flat bar eats a strip off one end of the tab, so whatever is drawn inside has to be
' centred in what is left and not in the whole tab. Both consumers ask the same question
' and the answer depends on the orientation remap, so it lives in one place: the close
' button used to centre on the raw TabRect and ended up half a bar height away from the
' caption and the icon, which only shows with a tall bar
' The test is "either flag is on" and not "this tab has a bar", on purpose: that keeps the
' captions of the tabs without one aligned with the captions of the tabs that have one
' Left and Right come back filled only for the orientations that rotate the strip but keep
' the captions horizontal, where the bar lands on a side instead of on an end
Private Function FlatBodySeparationClientInset() As Long
    ' A height of 1 is drawn as a single row at any DPI
    If mAppearanceIsFlat And (mFlatBodySeparationLineHeight <> 1) Then FlatBodySeparationClientInset = mFlatBodySeparationLineHeightDPIScaled - 1
End Function

Private Sub GetFlatBarInsets(ByRef nTop As Long, ByRef nBottom As Long, ByRef nLeft As Long, ByRef nRight As Long)
    nTop = 0
    nBottom = 0
    nLeft = 0
    nRight = 0
    If Not mAppearanceIsFlat Then Exit Sub
    If mHighlightFlatBar Or mHighlightFlatBarSelectedTab Then
        If mFlatBarPosition = ntBarPositionTop Then
            nTop = mFlatBarHeightDPIScaled
        Else
            nBottom = mFlatBarHeightDPIScaled
        End If
    End If
    ' The gap is on the body side, which here is the top with the strip at the bottom, like the bar
    If mOrientationIsBottom Then
        nTop = nTop + mFlatTabBodyGapDPIScaled
    Else
        nBottom = nBottom + mFlatTabBodyGapDPIScaled
    End If
    If mTabsAreRotatedButCaptionsAreHorizontal Then
        If (mTabOrientation = ntTabOrientationRightHorizontal) Or (mTabOrientation = ntTabOrientationRightBottomHorizontal) Then
            nLeft = nBottom
            nRight = nTop
        Else
            nLeft = nTop
            nRight = nBottom
        End If
        nBottom = 0
        nTop = 0
    End If
End Sub

' Centres nSize inside a band nSpan wide (or high) and gives back the offset from the start
' of the band, in whole pixels. Everything that centres caption, icon or close button goes
' through here.
' Why a function and not nStart + (nSpan - nSize) / 2 at each site: that form is a floating
' point expression stored in a Long, so VB6 rounds the whole sum, nStart included. With an
' odd leftover the half is exactly .5, VB6 rounds a tie to even, and the result follows the
' parity of an absolute screen coordinate - so while a tab was dragged its caption and icon
' jumped a pixel every other pixel of travel. Rounding the difference makes the position
' relative to the tab a constant.
' The .49 and not integer division: \ truncates towards zero, which moves the even case by a
' pixel when the leftover is negative - a caption wider than its band. This form is right in
' the four cases. The leftover pixel of an odd band goes to the right / to the bottom
Private Function CenterOffset(ByVal nSpan As Long, ByVal nSize As Long) As Long
    CenterOffset = (nSpan - nSize) / 2 + 0.49
End Function

' The rect the painted tab really occupies, inside the TabRect Draw hands out. TabRect is
' taller than the painted tab - it carries the room reserved for the selected tab being higher -
' and this is what takes that room back out. Both the caption and the close button are centred
' in this band, so it is worked out in one place: the 'x' used to centre in the raw TabRect while
' the caption centred here, which left them one pixel apart in every non-flat appearance and one
' and a half on the selected property-page tab. It is why the flat appearance was the one that
' looked right - there the two bands coincide, because Bottom is not brought in
Private Sub GetTabSpaceRect(ByRef nTabRect As RECT, ByVal nSelected As Boolean, ByRef nTabSpaceRect As RECT)
    nTabSpaceRect.Left = nTabRect.Left + 2
    If mAppearanceIsFlat Then nTabSpaceRect.Left = nTabSpaceRect.Left + 1
    nTabSpaceRect.Top = nTabRect.Top
    If mAppearanceIsFlat Then
        nTabSpaceRect.Bottom = nTabRect.Bottom
    Else
        nTabSpaceRect.Bottom = nTabRect.Bottom - 2
    End If
    nTabSpaceRect.Right = nTabRect.Right - 2
    
    If mAppearanceIsPP And nSelected Then
        nTabSpaceRect.Top = nTabSpaceRect.Top - 1
    End If
End Sub

' The vertical band the caption, the icon and the close button are centred in: the tab
' rect as it stands, without the two insets GetTabSpaceRect applies. Those insets keep a
' measuring rect and a focus frame off the tab's drawn border, but taking two rows off the
' bottom and none off the top moves the centre up by one. Only the centred placements use
' this; icon-at-top and icon-at-bottom stay on GetTabSpaceRect, where the inset is exactly
' the clearance they are asking for. ApplyCaptionShift then moves the whole content rect -
' not the caption alone, so icon and close button travel with it - by
' HighlightTabCaptionShift, asked for separately from the extra height because a centred
' caption moves by half of it in one original and by all of it in the other
Private Sub ApplyCaptionShift(ByVal nTab As Long, ByRef nTabRect As RECT)
    Dim iShift As Long
    
    If mHighlightTabCaptionShift = 0 Then Exit Sub
    If nTab = mTab Then
        If Not mHighlightShiftCaptionSelectedTab Then Exit Sub
    Else
        If Not mHighlightShiftCaption Then Exit Sub
        If Not TabShowsDiscreteHighlight(nTab) Then Exit Sub
    End If
    iShift = pScaleY(mHighlightTabCaptionShift, vbHimetric, vbPixels)
    If iShift = 0 Then Exit Sub
    ' Bottom and the *Horizontal place their content in a second pass, on rects already turned to
    ' their final position, so "away from the body" has to be spelled out for each of them
    If mOrientationIsBottom Then
        nTabRect.Top = nTabRect.Top + iShift
        nTabRect.Bottom = nTabRect.Bottom + iShift
    ElseIf mTabsAreRotatedButCaptionsAreHorizontal Then
        If (mTabOrientation = ntTabOrientationRightHorizontal) Or (mTabOrientation = ntTabOrientationRightBottomHorizontal) Then
            nTabRect.Left = nTabRect.Left + iShift
            nTabRect.Right = nTabRect.Right + iShift
        Else
            nTabRect.Left = nTabRect.Left - iShift
            nTabRect.Right = nTabRect.Right - iShift
        End If
    Else
        nTabRect.Top = nTabRect.Top - iShift
        nTabRect.Bottom = nTabRect.Bottom - iShift
    End If
End Sub

Private Sub GetTabCenteringBand(ByRef nTabRect As RECT, ByRef nTop As Long, ByRef nHeight As Long)
    nTop = nTabRect.Top
    nHeight = nTabRect.Bottom - nTabRect.Top + 1
End Sub

' The horizontal band the tab's content lives in: the tab rect brought in by the padding
' and by the flat bar. Caption, icon and close button are all placed inside it, so it
' lives in one place. TabPaddingWidth is the only authority over the horizontal air here -
' the old floor of two or three pixels made small paddings lie, and was never DPI scaled.
' The flat bar is not air but a drawn strip, so that one does subtract. The bar insets come
' in as parameters because both callers already have them and asking twice lets the two
' answers drift apart. nAreaRight comes out exclusive - one past the last usable column -
' because that is what every consumer wants, while TabRect is inclusive, so the + 1 is the
' conversion between the two and not a fudge
Private Sub GetTabContentEdges(ByRef nTabRect As RECT, ByVal nBarLeft As Long, ByVal nBarRight As Long, ByRef nAreaLeft As Long, ByRef nAreaRight As Long)
    nAreaLeft = nTabRect.Left + mTabPaddingWidthDPIScaled + nBarLeft
    nAreaRight = nTabRect.Right + 1 - mTabPaddingWidthDPIScaled - nBarRight
    ' A band narrower than its own padding can be asked for (fixed width 20, padding 20) and nothing
    ' downstream is prepared for an inverted rect
    If nAreaRight < nAreaLeft Then nAreaRight = nAreaLeft
End Sub

' The stretch ratio of a row, with the degenerate denominator resolved in one place. The
' accumulated caption width of a row can come out zero - every tab in it measuring nothing,
' which happens on a control too narrow to hold two paddings - and of the five divisions that
' used it, two guarded for that and three divided anyway and raised error 11. A rule spelled
' out per call site is a rule that gets forgotten at the next call site, so it lives here
' A ratio of 1 - no stretching at all - is the neutral answer, and it is the one the guard
' that already existed had picked, so the two sites that were right keep behaving as before
' The numerator is passed already worked out because each caller subtracts a different fixed
' space from a different span: what they share is the denominator and what to do when it is
' not usable, and that is exactly what is shared here
Private Function RowStretchRatio(ByVal nSpaceForCaptions As Long, ByVal nAccumulatedCaptionWidth As Long) As Single
    If nAccumulatedCaptionWidth > 0 Then
        RowStretchRatio = nSpaceForCaptions / nAccumulatedCaptionWidth
    Else
        RowStretchRatio = 1
    End If
End Function

' Where a row starts, in as-Top columns. One in tabbed dialog, two everywhere else. The
' reason is where each appearance puts its outer border: property page and flat paint their
' leftmost column on .Left itself, while tabbed dialog paints its dark border one column
' further out, on .Left - 1. With the same .Left for both, tabbed dialog ends up drawing one
' pixel inside the control's edge and the whole row with it. Measured at 96 DPI against
' SSTab, Top, 3 tabs, 2026-08-28, for the three width styles tabbed dialog can reach -
' ntTWTabCaptionWidth, ntTWEqualWidth and ntTWStretchToFill - and the three start on the same X,
' so this is not conditioned on the width style. That was worth checking: the IIf that used
' to live at four sites did vary by width style, and that was the defect fixed on 2026-08-12
Private Function RowStartX() As Long
    ' Every branch keeps the widening's room since 2026-09-15.
    If (mTabAppearance2 = ntTATabbedDialog) Or (mTabAppearance2 = ntTATabbedDialogRounded) Then
        RowStartX = 1 + SelectedTabWideningSpace
    ElseIf mAppearanceIsPP Then
        ' Nothing of its own: the 2 this returned was the widening's room, see SelectedTabWideningSpace
        RowStartX = SelectedTabWideningSpace
    Else
        RowStartX = 2 + SelectedTabWideningSpace
    End If
End Function

' How many columns the frame keeps at the far end of a row, so the last column a row may
' occupy is iScaleWidthForTabs less the row's perspective offset less this. The native
' TabStrip - the control Style Windows imitates - parks the last tab of a justified row two
' columns short of the body's border line, and the selected tab, which grows two columns
' outwards, lands ON the line. That is the same relation the near end already had: the
' first inactive tab starts two columns inside the left border and the selected one reaches
' it. The themed branch used to return the as-Top right margin alone, on the reasoning that
' the theme paints its border two columns before the end of the rect and the two offsets
' cancelled. They do not: measured 96 DPI 2026-09-05 on a themed TabStrip, two rows, front
' row of two tabs, the body's border line falls on column 151, the last tab of the row ends
' on 149 while inactive and on 151 while selected. NewTab was ending on the line while
' inactive and two columns past it while selected, which is the whole row sitting two out.
' Only the themed branch is corrected: the other two answer to SSTab, whose property page
' rows are not justified, so the same case has no reference there yet
Private Function RowEndMargin() As Long
    If mVisualStylesActive Then
        RowEndMargin = mThemedRightMarginAsTop + SelectedTabWideningSpace
    ElseIf mAppearanceIsPP Then
        ' 1 of its own plus the widening's room
        RowEndMargin = 1 + SelectedTabWideningSpace
    Else
        ' Tabbed dialog and flat: same reason as the far end, see RowStartX
        RowEndMargin = 1 + SelectedTabWideningSpace
    End If
End Function

' What a row cannot use of iScaleWidthForTabs, counting both ends. This is THE number: the
' packing, the sharing and the two end snaps all read this one expression, so there is
' nothing left to reconcile between them. It replaces RowEndRoomLoss, RowShareEndLoss and
' the four column literal, three readings of this same distance taken from different ends,
' which disagreed by up to three columns.
' InactiveSheetRightLimit is the last column the sheet behind the tabs may be blitted to with
' the perspective off, so that its border LINE lands on the very column the row of tabs ends
' on. The line is not the last column of the blit: a right border of n pixels is one border
' and n - 1 of light, and the border proper is the innermost, so it sits
' mThemedRightMarginAsTop - 1 inside the edge - 1 in Left, 2 in Right, 3 in Top, which is why
' a limit written as a single distance from mBodyWidth lands right in one orientation only
Private Function InactiveSheetRightLimit() As Long
    InactiveSheetRightLimit = mBodyWidth - RowEndMargin() + mThemedRightMarginAsTop - 1
End Function

Private Function RowLostToEdges() As Long
    RowLostToEdges = RowStartX() - 1 + RowEndMargin() + ThemedBandShift()
End Function

' How far the whole strip is pushed in from column 0 after the row has been laid out.
' The themed pane keeps its own orientation on screen, so a quarter turn sends the
' theme's 2 px bottom border to the as-Top left in Left and its 1 px left border stays
' there in Top, Bottom and Right: one column in the Left family, zero everywhere else,
' and the two swap under RightToLeft along with the margins they are made of.
' It is read from two places that used to disagree. The block that applies the shift
' translates rects that are already placed, and RowLostToEdges has to reserve room for
' that translation or the last tab of every row is drawn one column past the canvas and
' loses its right border. Measured 96 DPI 2026-09-05 with RWDIAG and DTDIAG on Left and
' Right side by side, with TabSeparation at 0 and at 5: Left shared its row against 137
' columns and then drew it against 136.
' The module variable is NOT usable here: it is assigned further down in the same Draw,
' well after the packing, so reading it would carry the previous pass's value. Same trap
' the as-Top margins fell into once and the reason they are now set before the packing
Private Function ThemedBandShift() As Long
    If mVisualStylesActive Then
        ThemedBandShift = mThemedLeftMarginAsTop - mThemedBodyLeftBorderPixels
        If ThemedBandShift < 0 Then
            ThemedBandShift = 0
        End If
    End If
End Function

' Width of the single close button at the end of the strip, in the same units as the tab's own
' CloseButtonWidth. Zero when the button goes on the tabs or no visible tab can be closed
Private Function StripCloseButtonWidth() As Long
    Dim t As Long
    Dim iFound As Boolean
    Dim iCharacter As String
    Dim iCharRect As RECT
    
    If mCloseButtonPosition <> ntCBPositionStripEnd Then Exit Function
    For t = 0 To mTabs - 1
        If mTabData(t).Visible Then
            If TabCloseButtonAllowed(t) Then
                iFound = True
                Exit For
            End If
        End If
    Next t
    If Not iFound Then Exit Function
    SetupCloseButtonFont
    iCharacter = ChrU(mCloseButtonCharCode)
    Set picAuxIconFont.Font = mCloseButtonFont
    DrawTextW picAuxIconFont.hDC, StrPtr(iCharacter), -1, iCharRect, DT_CALCRECT Or DT_SINGLELINE Or DT_CENTER
    StripCloseButtonWidth = (iCharRect.Right - iCharRect.Left) + mCloseButtonMarginDPIScaled * 2
End Function

' What the rows give up at their far end for the buttons of the strip, gap from the last tab included.
' Taken from the room of the rows the same way StripEndFreeSpace is, so every row loses it, not only
' the one the button is drawn on: a row's room must not depend on where the row is standing
Private Function StripButtonsReserve() As Long
    StripButtonsReserve = mStripCloseButtonWidth + mZoneNewTabWidth + mZoneListWidth
    If StripButtonsReserve > 0 Then StripButtonsReserve = StripButtonsReserve + mCloseButtonMarginDPIScaled
End Function

' As-Top rect of the strip's close button: across, the band of the row it goes on, taken from a tab
' of that row that is not the selected one (the selected one can be grown or sunk); along, the end
' that row would have without the reserve, with the same expression the rows are snapped to
Private Sub StripCloseButtonPlace(ByVal nScaleWidthForTabs As Long, ByVal nRowPerspectiveSpace As Long)
    Dim t As Long
    Dim iRow As Long
    Dim iRefTab As Long
    Dim iRefTabFallback As Long
    Dim iBtnSide As Long
    Dim iRowEnd As Long
    
    mStripCloseRect.Left = 0
    mStripCloseRect.Top = 0
    mStripCloseRect.Right = 0
    mStripCloseRect.Bottom = 0
    If mStripCloseButtonWidth = 0 Then Exit Sub
    If mStripButtonsRow = ntSBOuterRow Then
        iRow = 0
    Else
        iRow = mRows - 1
    End If
    iRefTab = -1
    iRefTabFallback = -1
    For t = 0 To mTabs - 1
        If mTabData(t).Visible Then
            If mTabData(t).RowPos = iRow Then
                If (t <> mTab) And Not TabIsDrawnWithExtraHeight(t) Then
                    iRefTab = t
                    Exit For
                ElseIf t = mTab Then
                    ' The selected tab's own height does not follow the pointer, so it is the
                    ' second choice when every other tab of the row is the highlighted one
                    iRefTabFallback = t
                ElseIf iRefTabFallback = -1 Then
                    iRefTabFallback = t
                End If
            End If
        End If
    Next t
    If iRefTab = -1 Then iRefTab = iRefTabFallback
    If iRefTab = -1 Then Exit Sub
    
    iRowEnd = nScaleWidthForTabs + StripButtonsReserve - nRowPerspectiveSpace * iRow - RowEndMargin() - ThemedBandShift()
    ' Rows aligned at the end leave StripEndFreeSpace at their start, so the button goes to the edge
    If mTabsAlignedAtTheEnd And (Not mTabsOrderReversed) Then iRowEnd = iRowEnd + pScaleX(mStripEndFreeSpace, vbHimetric, vbPixels)
    iBtnSide = mStripCloseButtonWidth - mCloseButtonMarginDPIScaled
    If iBtnSide < 1 Then iBtnSide = 1
    ' Placed like a tab's own button against its content edge, see DrawTabCloseButton
    mStripCloseRect.Right = iRowEnd - mCloseButtonMarginDPIScaled \ 2
    mStripCloseRect.Left = mStripCloseRect.Right - iBtnSide
    mStripCloseRect.Top = (mTabData(iRefTab).TabRect.Top + mTabData(iRefTab).TabRect.Bottom - iBtnSide) \ 2
    mStripCloseRect.Bottom = mStripCloseRect.Top + iBtnSide
End Sub

' The '+' in the zone stays in mTabData as the last tab, as the rest of the control expects, and is
' only hidden for the length of Draw so the layout and the painting skip it. It is shown again
' at every way out of Draw, with an empty rect so the tab hit test cannot find it
Private Sub NewTabButtonZoneEnter()
    If Not TabIsNewTabButton(mTabs - 1) Then Exit Sub
    If Not mTabData(mTabs - 1).Visible Then Exit Sub
    mTabData(mTabs - 1).Visible = False
    mNewTabButtonInZone = True
    mZoneNewTabWidth = NewTabZoneWidth
End Sub

Private Sub NewTabButtonZoneRestore()
    If Not mNewTabButtonInZone Then
        mZoneNewTabRect.Left = 0
        mZoneNewTabRect.Right = 0
        mZoneNewTabRectScreen = mZoneNewTabRect
        Exit Sub
    End If
    If Not TabIsNewTabButton(mTabs - 1) Then Exit Sub
    If mTabData(mTabs - 1).Visible Then Exit Sub
    mTabData(mTabs - 1).Visible = True
    ' back in the count, as the layout counts it while it is a tab
    mVisibleTabs = mVisibleTabs + 1
    mTabData(mTabs - 1).TabRect.Left = 0
    mTabData(mTabs - 1).TabRect.Top = 0
    mTabData(mTabs - 1).TabRect.Right = -1
    mTabData(mTabs - 1).TabRect.Bottom = -1
    ' Visible again but in no row: left with the row it last had, it was the next tab of the strip's
    ' last one, and the drag measured the gap after that one against its empty rect
    mTabData(mTabs - 1).Row = -1
    mTabData(mTabs - 1).RowPos = -1
End Sub

Private Function NewTabZoneFont() As StdFont
    If mTabData(mTabs - 1).IconFont Is Nothing Then
        Set NewTabZoneFont = mDefaultIconFont
    Else
        Set NewTabZoneFont = mTabData(mTabs - 1).IconFont
    End If
End Function

Private Function NewTabZoneWidth() As Long
    Dim iCharacter As String
    Dim iCharRect As RECT
    
    iCharacter = ChrU(mTabData(mTabs - 1).IconChar)
    Set picAuxIconFont.Font = NewTabZoneFont
    DrawTextW picAuxIconFont.hDC, StrPtr(iCharacter), -1, iCharRect, DT_CALCRECT Or DT_SINGLELINE Or DT_CENTER
    NewTabZoneWidth = (iCharRect.Right - iCharRect.Left) + mCloseButtonMarginDPIScaled * 2
End Function

Private Sub NewTabZonePlace(ByVal nScaleWidthForTabs As Long, ByVal nRowPerspectiveSpace As Long)
    If mNewTabButtonInZone Then
        ZoneButtonPlace mZoneNewTabRect, mZoneNewTabWidth, mStripCloseButtonWidth + mZoneListWidth, nScaleWidthForTabs, nRowPerspectiveSpace
    Else
        ZoneButtonPlace mZoneNewTabRect, 0, 0, nScaleWidthForTabs, nRowPerspectiveSpace
    End If
    ZoneButtonPlace mZoneListRect, mZoneListWidth, mStripCloseButtonWidth, nScaleWidthForTabs, nRowPerspectiveSpace
End Sub

' A button of the zone, nOuterWidth in from the edge, in the row and band StripCloseButtonPlace
' uses. Zero width leaves the rect empty
Private Sub ZoneButtonPlace(ByRef nRect As RECT, ByVal nWidth As Long, ByVal nOuterWidth As Long, ByVal nScaleWidthForTabs As Long, ByVal nRowPerspectiveSpace As Long)
    Dim t As Long
    Dim iRow As Long
    Dim iRefTab As Long
    Dim iRefTabFallback As Long
    Dim iBtnSide As Long
    Dim iRowEnd As Long
    
    nRect.Left = 0
    nRect.Top = 0
    nRect.Right = 0
    nRect.Bottom = 0
    If nWidth = 0 Then Exit Sub
    If mStripButtonsRow = ntSBOuterRow Then
        iRow = 0
    Else
        iRow = mRows - 1
    End If
    iRefTab = -1
    iRefTabFallback = -1
    For t = 0 To mTabs - 1
        If mTabData(t).Visible Then
            If mTabData(t).RowPos = iRow Then
                If (t <> mTab) And Not TabIsDrawnWithExtraHeight(t) Then
                    iRefTab = t
                    Exit For
                ElseIf t = mTab Then
                    ' The selected tab's own height does not follow the pointer, so it is the
                    ' second choice when every other tab of the row is the highlighted one
                    iRefTabFallback = t
                ElseIf iRefTabFallback = -1 Then
                    iRefTabFallback = t
                End If
            End If
        End If
    Next t
    If iRefTab = -1 Then iRefTab = iRefTabFallback
    If iRefTab = -1 Then Exit Sub
    
    iRowEnd = nScaleWidthForTabs + StripButtonsReserve - nRowPerspectiveSpace * iRow - RowEndMargin() - ThemedBandShift()
    If mTabsAlignedAtTheEnd And (Not mTabsOrderReversed) Then iRowEnd = iRowEnd + pScaleX(mStripEndFreeSpace, vbHimetric, vbPixels)
    iRowEnd = iRowEnd - nOuterWidth
    iBtnSide = nWidth - mCloseButtonMarginDPIScaled
    If iBtnSide < 1 Then iBtnSide = 1
    nRect.Right = iRowEnd - mCloseButtonMarginDPIScaled \ 2
    nRect.Left = nRect.Right - iBtnSide
    nRect.Top = (mTabData(iRefTab).TabRect.Top + mTabData(iRefTab).TabRect.Bottom - iBtnSide) \ 2
    nRect.Bottom = nRect.Top + iBtnSide
End Sub

' nRect is mZoneNewTabRect when drawn before the rotation and mZoneNewTabRectScreen after it
Private Sub DrawZoneNewTabButton(ByRef nRect As RECT)
    Dim iCharacter As String
    Dim iCharRect As RECT
    Dim iFlags As Long
    Dim iColor As Long
    Dim iFontPrev As StdFont
    Dim iForeColorPrev As Long
    
    If Not mNewTabButtonInZone Then Exit Sub
    If nRect.Right <= nRect.Left Then Exit Sub
    If Not TabIsNewTabButton(mTabs - 1) Then Exit Sub
    If TabForeIsDrawnDisabled(mTabs - 1) Then
        iColor = DisabledForeColorVariant(mStripButtonsColor, TranslatedColor(mBackColor, ntRoleBack), mGrayText)
    Else
        iColor = ButtonFadedColor(-3, mStripButtonsColor, mStripButtonsColorHighlighted, ntRoleFore, mStripButtonHovered = 3)
    End If
    iCharacter = ChrU(mTabData(mTabs - 1).IconChar)
    Set iFontPrev = picDraw.Font
    Set picDraw.Font = NewTabZoneFont
    iForeColorPrev = picDraw.ForeColor
    picDraw.ForeColor = iColor
    iCharRect = nRect
    iFlags = DT_SINGLELINE Or DT_CENTER Or DT_VCENTER Or DT_NOCLIP
    InkCenteredGlyphRect mTabData(mTabs - 1).IconChar, nRect, iCharRect, iFlags
    DrawUprightGlyph iCharacter, iCharRect, nRect, iFlags
    Set picDraw.Font = iFontPrev
    picDraw.ForeColor = iForeColorPrev
End Sub

' Points toward the body, the way the menu opens. Drawn before the rotation it turns with the strip;
' drawn after it, which is Bottom only, the body is above and the glyph is the upward one
Private Sub DrawZoneListButton(ByRef nRect As RECT, ByVal nScreen As Boolean)
    Dim iCharacter As String
    Dim iCharCode As Long
    Dim iCharRect As RECT
    Dim iFlags As Long
    Dim iFlip As Boolean
    Dim iColor As Long
    Dim iFontPrev As StdFont
    Dim iForeColorPrev As Long
    
    If mZoneListWidth = 0 Then Exit Sub
    If nRect.Right <= nRect.Left Then Exit Sub
    iCharCode = mScrollListDownCharCode
    If nScreen And mOrientationIsBottom Then
        ' the developer gives only the downward glyph
        If mStripButtonListIsUser Then
            iFlip = True
        Else
            iCharCode = mScrollListUpCharCode
        End If
    End If
    iCharacter = ChrU(iCharCode)
    If Not mEnabled Then
        iColor = DisabledForeColorVariant(mStripButtonsColor, TranslatedColor(mBackColor, ntRoleBack), mGrayText)
    Else
        iColor = ButtonFadedColor(-4, mStripButtonsColor, mStripButtonsColorHighlighted, ntRoleFore, mStripButtonHovered = 4)
    End If
    Set iFontPrev = picDraw.Font
    Set picDraw.Font = mStripButtonsFont
    iForeColorPrev = picDraw.ForeColor
    picDraw.ForeColor = iColor
    iCharRect = nRect
    iFlags = DT_SINGLELINE Or DT_CENTER Or DT_VCENTER Or DT_NOCLIP
    InkCenteredGlyphRect iCharCode, nRect, iCharRect, iFlags
    If nScreen And mTabsAreRotatedButCaptionsAreHorizontal Then
        ' turned toward the body, which is across the band; the turn is in device coordinates,
        ' and the mirrored layout puts the band on the other side of the logical one
        DrawGlyphQuarterTurn iCharacter, iCharRect, nRect, iFlags, ((mScrollViewRectScreen.Left + mScrollViewRectScreen.Right) > picDraw.ScaleWidth) Xor mRightToLeft
    ElseIf iFlip Then
        DrawGlyphFlippedVertically iCharacter, iCharRect, nRect, iFlags
    Else
        DrawTextW picDraw.hDC, StrPtr(iCharacter), -1, iCharRect, iFlags
    End If
    Set picDraw.Font = iFontPrev
    picDraw.ForeColor = iForeColorPrev
End Sub

' A native menu: it brings the keyboard, its own scrolling for long lists and the RTL layout.
' Hidden tabs and the '+' are left out, the selected tab is checked and the disabled ones greyed.
' It opens toward the body. The rects are in the mirrored frame under RightToLeft and the window
' is not, so the edges are mirrored back before going to the screen
Private Sub ShowTabListMenu()
    Dim t As Long
    Dim iMenu As LongPtr
    Dim iFlags As Long
    Dim iItemCaption As String
    Dim iPt As POINTAPI
    Dim iLeft As Long
    Dim iRight As Long
    Dim iOpensRight As Boolean
    Dim iCmd As Long
    Dim iIconFont As StdFont
    Dim iItemBitmaps() As LongPtr
    Dim iCheckWidth As Long
    Dim iCheckHeight As Long
    Dim iGlyphEmHeight As Long
    Dim utMenuItem As MENUITEMINFOW
    
    If mZoneListWidth = 0 Then Exit Sub
    iMenu = CreatePopupMenu
    If iMenu = 0 Then Exit Sub
    ' The size the system reserves for the check mark is the size it expects hbmpItem in
    iCheckWidth = GetSystemMetrics(SM_CXMENUCHECK)
    iCheckHeight = GetSystemMetrics(SM_CYMENUCHECK)
    If iCheckWidth < 8 Then iCheckWidth = 16
    If iCheckHeight < 8 Then iCheckHeight = 16
    iGlyphEmHeight = MenuGlyphEmHeight
    ReDim iItemBitmaps(0 To mTabs)
    For t = 0 To mTabs - 1
        If mTabData(t).Visible And (Not TabIsNewTabButton(t)) Then
            iFlags = MF_STRING
            If t = mTab Then iFlags = iFlags Or MF_CHECKED
            If Not mTabData(t).Enabled Then iFlags = iFlags Or MF_GRAYED
            iItemCaption = mTabData(t).Caption
            If Len(iItemCaption) = 0 Then iItemCaption = CStr(t)
            AppendMenuW iMenu, iFlags, t + 1, StrPtr(iItemCaption)
            If (Not mTabData(t).DoNotUseIconFont) And (mTabData(t).IconChar <> 0) Then
                If mTabData(t).IconFont Is Nothing Then
                    Set iIconFont = mDefaultIconFont
                Else
                    Set iIconFont = mTabData(t).IconFont
                End If
                iItemBitmaps(t) = MenuIconBitmap(mTabData(t).IconChar, iIconFont, MenuIconColor(t), iCheckWidth, iCheckHeight, iGlyphEmHeight, mTabData(t).IconInColor And mTabData(t).Enabled)
            Else
                If Not mTabData(t).PicToUseSet Then SetPicToUse t
                iItemBitmaps(t) = MenuPictureBitmap(t, iCheckWidth, iCheckHeight)
            End If
            If iItemBitmaps(t) <> 0 Then
                utMenuItem.cbSize = LenB(utMenuItem)
                utMenuItem.fMask = MIIM_BITMAP
                utMenuItem.hbmpItem = iItemBitmaps(t)
                SetMenuItemInfoW iMenu, t + 1, 0, utMenuItem
            End If
        End If
    Next t
    ' With a bitmap in hbmpItem the system draws no check mark, so the current tab is marked
    ' as the default item, which is drawn in bold and owes nothing to the icon column
    SetMenuDefaultItem iMenu, mTab + 1, 0
    
    iLeft = mZoneListRectScreen.Left
    iRight = mZoneListRectScreen.Right
    iFlags = TPM_RETURNCMD Or TPM_NONOTIFY
    If mRightToLeft Then
        iLeft = mScaleWidth - mZoneListRectScreen.Right
        iRight = mScaleWidth - mZoneListRectScreen.Left
        iFlags = iFlags Or TPM_LAYOUTRTL
    End If
    If (mTabOrientation = ssTabOrientationTop) Or (mTabOrientation = ntTabOrientationTopRight) Or mOrientationIsBottom Then
        If mRightToLeft Then
            iPt.X = iRight
            iFlags = iFlags Or TPM_RIGHTALIGN
        Else
            iPt.X = iLeft
            iFlags = iFlags Or TPM_LEFTALIGN
        End If
        If mOrientationIsBottom Then
            iPt.Y = mZoneListRectScreen.Top
            iFlags = iFlags Or TPM_BOTTOMALIGN
        Else
            iPt.Y = mZoneListRectScreen.Bottom
            iFlags = iFlags Or TPM_TOPALIGN
        End If
    Else
        iOpensRight = (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Or (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationLeftBottomHorizontal)
        If mRightToLeft Then iOpensRight = Not iOpensRight
        If iOpensRight Then
            iPt.X = iRight
            iFlags = iFlags Or TPM_LEFTALIGN
        Else
            iPt.X = iLeft
            iFlags = iFlags Or TPM_RIGHTALIGN
        End If
        iPt.Y = mZoneListRectScreen.Top
        iFlags = iFlags Or TPM_TOPALIGN
    End If
    ClientToScreen mUserControlHwnd, iPt
    MenuWheelHookInstall mUserControlHwnd
    iCmd = TrackPopupMenuEx(iMenu, iFlags, iPt.X, iPt.Y, mUserControlHwnd, 0)
    MenuWheelHookUninstall
    DestroyMenu iMenu
    ' The menu owns them only while it lives, and it does not free them
    For t = 0 To mTabs - 1
        If iItemBitmaps(t) <> 0 Then DeleteObject iItemBitmaps(t)
    Next t
    If iCmd > 0 Then TabSel = iCmd - 1
End Sub

' The strip's icon colour is chosen against the strip, and the menu is painted by the system over
' its own background: a colour that would disappear there gives way to the system's menu text
Private Function MenuIconColor(ByVal nTab As Long) As Long
    Dim iColor As Long
    
    If (Not mTabData(nTab).Enabled) Or (Not mEnabled) Then
        MenuIconColor = GetSysColor(COLOR_GRAYTEXT)
        Exit Function
    End If
    If nTab = mTab Then
        iColor = mTabData(nTab).CustomColors.ResolvedChainColor(ntChainIconColorSelectedTab)
    Else
        iColor = mTabData(nTab).CustomColors.ResolvedChainColor(ntChainIconColor)
    End If
    iColor = TranslatedColor(iColor, ntRoleFore)
    If Not ColorsHaveEnoughContrast(iColor, GetSysColor(COLOR_MENU), cMenuIconContrast) Then
        iColor = GetSysColor(COLOR_MENUTEXT)
    End If
    MenuIconColor = iColor
End Function

' The tab's icon font resized to the menu cell. The quality is the one the strip draws with, and
' what it answers in three channels MenuIconBitmap averages into the one alpha it can carry
Private Function CreateMenuIconFont(ByVal nFont As StdFont, ByVal nEmHeight As Long) As LongPtr
    Dim utLogFont As LOGFONTW
    Dim iFaceName As String
    
    utLogFont.LFHeight = -nEmHeight
    If nFont.Bold Then utLogFont.LFWeight = 700 Else utLogFont.LFWeight = 400
    If nFont.Italic Then utLogFont.LFItalic = 1
    utLogFont.LFCharset = CByte(nFont.Charset And &HFF&)
    utLogFont.LFQuality = CLEARTYPE_QUALITY
    iFaceName = Left$(nFont.Name, 31)
    If Len(iFaceName) > 0 Then CopyMemory utLogFont.LFFaceName(0), ByVal StrPtr(iFaceName), LenB(iFaceName)
    CreateMenuIconFont = CreateFontIndirectW(utLogFont)
End Function

' One glyph as the 32 bit premultiplied bitmap a menu item takes in hbmpItem. GDI leaves the alpha
' channel at zero when it draws text, which over a menu means an invisible icon, so the glyph goes
' down white on black and its coverage becomes the alpha, while the colour is written already
' multiplied by it. Decided against MF_OWNERDRAW, which hands over the whole item and with it the
' system's dark mode, its rounded corners and its highlight
Private Function MenuIconBitmap(ByVal nCharCode As Long, ByVal nFont As StdFont, ByVal nColor As Long, ByVal nWidth As Long, ByVal nHeight As Long, ByVal nEmHeight As Long, Optional ByVal nInColor As Boolean) As LongPtr
    Dim utGlyph As GLYPHMETRICS
    Dim utTextMetric As TEXTMETRICW
    Dim utIdentity As MAT2
    Dim iBmp As LongPtr
    Dim iBits As LongPtr
    Dim iDCRef As LongPtr
    Dim iDC As LongPtr
    Dim iGlyphFont As LongPtr
    Dim iOldBmp As LongPtr
    Dim iOldFont As LongPtr
    Dim iRect As RECT
    Dim iBuf() As Byte
    Dim iBufSize As Long
    Dim iPos As Long
    Dim iCoverage As Long
    Dim iColorRGB As Long
    Dim iRed As Long
    Dim iGreen As Long
    Dim iBlue As Long
    Dim iEmHeight As Long
    Dim iFitEmHeight As Long
    Dim iFitRatio As Double
    Dim iMeasured As Boolean
    Dim iShiftX As Long
    Dim iShiftY As Long
    Dim iCharacter As String
    Dim iDrawnInColor As Boolean
    
    If (nCharCode = 0) Or (nWidth <= 0) Or (nHeight <= 0) Then Exit Function
    If nFont Is Nothing Then Exit Function
    iBmp = MenuCellBitmap(nWidth, nHeight, iBits)
    iDCRef = GetDC(0)
    If iDCRef <> 0 Then
        iDC = CreateCompatibleDC(iDCRef)
        ReleaseDC 0, iDCRef
    End If
    If (iBmp = 0) Or (iDC = 0) Then
        If iBmp <> 0 Then DeleteObject iBmp
        If iDC <> 0 Then DeleteDC iDC
        Exit Function
    End If
    ' CreateCompatibleDC inherits the reference DC's layout, and a mirrored scratch surface would
    ' put the glyph against the far edge of the bytes that are read back
    SetLayout iDC, 0
    iOldBmp = SelectObject(iDC, iBmp)
    
    utIdentity.eM11.nWhole = 1
    utIdentity.eM22.nWhole = 1
    iEmHeight = nEmHeight
    ' three quarters of the cell when the menu font could not be read, because the whole cell is
    ' what looked oversized beside the caption
    If iEmHeight < 4 Then iEmHeight = (nHeight * 3) \ 4
    iGlyphFont = CreateMenuIconFont(nFont, iEmHeight)
    If iGlyphFont <> 0 Then
        iOldFont = SelectObject(iDC, iGlyphFont)
        iMeasured = MeasureMenuGlyph(iDC, nCharCode, utGlyph, utTextMetric, utIdentity)
        ' The ink still has to fit the cell: shrink it by the worse
        ' of the two ratios and measure it once more
        If iMeasured Then
            If (utGlyph.gmBlackBoxX > nWidth) Or (utGlyph.gmBlackBoxY > nHeight) Then
                iFitRatio = 1
                If utGlyph.gmBlackBoxX > nWidth Then iFitRatio = nWidth / utGlyph.gmBlackBoxX
                If utGlyph.gmBlackBoxY > nHeight Then
                    If (nHeight / utGlyph.gmBlackBoxY) < iFitRatio Then iFitRatio = nHeight / utGlyph.gmBlackBoxY
                End If
                iFitEmHeight = Int(iEmHeight * iFitRatio)
                If iFitEmHeight < 1 Then iFitEmHeight = 1
                If iFitEmHeight < iEmHeight Then
                    SelectObject iDC, iOldFont
                    DeleteObject iGlyphFont
                    iGlyphFont = CreateMenuIconFont(nFont, iFitEmHeight)
                    If iGlyphFont = 0 Then
                        iOldFont = 0
                        iMeasured = False
                    Else
                        iOldFont = SelectObject(iDC, iGlyphFont)
                        iMeasured = MeasureMenuGlyph(iDC, nCharCode, utGlyph, utTextMetric, utIdentity)
                    End If
                End If
            End If
        End If
    End If
    
    iRect.Left = 0
    iRect.Top = 0
    iRect.Right = nWidth
    iRect.Bottom = nHeight
    ' The ink box and not the line box, which carries leading the glyph does not use: the rect is
    ' moved by the difference so that what DrawText centres lands centred as ink
    If iMeasured Then
        iShiftX = (utGlyph.gmptGlyphOrigin.X + utGlyph.gmBlackBoxX \ 2) - (utGlyph.gmCellIncX \ 2)
        iShiftY = (utTextMetric.tmAscent - utGlyph.gmptGlyphOrigin.Y + utGlyph.gmBlackBoxY \ 2) - (utTextMetric.tmHeight \ 2)
        iRect.Left = iRect.Left - iShiftX
        iRect.Right = iRect.Right - iShiftX
        iRect.Top = iRect.Top - iShiftY
        iRect.Bottom = iRect.Bottom - iShiftY
    End If
    SetBkMode iDC, BKMODE_TRANSPARENT
    SetTextColorAPI iDC, &HFFFFFF
    ' DirectWrite writes premultiplied color straight into the cell, so the tinting below is skipped;
    ' it centres the line box and not the ink, which is close enough for an emoji
    If nInColor Then iDrawnInColor = DrawColorGlyph(iDC, nCharCode, nColor, -1, 0, 0, nWidth, nHeight)
    If iDrawnInColor Then
        GdiFlush
    Else
        iCharacter = ChrU(nCharCode)
        DrawTextW iDC, StrPtr(iCharacter), -1, iRect, DT_SINGLELINE Or DT_CENTER Or DT_VCENTER Or DT_NOCLIP
        ' The bits are read straight after, and GDI is free to still be holding the drawing
        GdiFlush
        
        TranslateColor nColor, 0&, iColorRGB
        iRed = iColorRGB And &HFF&
        iGreen = (iColorRGB \ &H100&) And &HFF&
        iBlue = (iColorRGB \ &H10000) And &HFF&
        iBufSize = nWidth * nHeight * 4
        ReDim iBuf(0 To iBufSize - 1)
        CopyMemory iBuf(0), ByVal iBits, iBufSize
        For iPos = 0 To iBufSize - 4 Step 4
            ' Under ClearType the three channels are three horizontal samples of the same glyph, so
            ' their mean is the downsample to the one alpha a bitmap carries. The largest of them
            ' would be a dilation instead, and it closed the thin gaps inside a glyph
            iCoverage = (CLng(iBuf(iPos)) + iBuf(iPos + 1) + iBuf(iPos + 2)) \ 3
            iBuf(iPos) = (iBlue * iCoverage) \ 255
            iBuf(iPos + 1) = (iGreen * iCoverage) \ 255
            iBuf(iPos + 2) = (iRed * iCoverage) \ 255
            iBuf(iPos + 3) = iCoverage
        Next iPos
        CopyMemory ByVal iBits, iBuf(0), iBufSize
    End If
    
    If iOldFont <> 0 Then SelectObject iDC, iOldFont
    If iGlyphFont <> 0 Then DeleteObject iGlyphFont
    SelectObject iDC, iOldBmp
    DeleteDC iDC
    MenuIconBitmap = iBmp
End Function

' The empty cell every menu item's bitmap is built in: 32 bits, top down, and zeroed, which in a
' premultiplied bitmap is transparent
Private Function MenuCellBitmap(ByVal nWidth As Long, ByVal nHeight As Long, ByRef nBits As LongPtr) As LongPtr
    Dim utBIMenu As BITMAPINFO
    Dim iDCRef As LongPtr
    
    nBits = 0
    If (nWidth <= 0) Or (nHeight <= 0) Then Exit Function
    iDCRef = GetDC(0)
    If iDCRef = 0 Then Exit Function
    utBIMenu.bmiHeader.biSize = Len(utBIMenu.bmiHeader)
    utBIMenu.bmiHeader.biWidth = nWidth
    ' negative, so the rows run the same way round as the coordinates do
    utBIMenu.bmiHeader.biHeight = -nHeight
    utBIMenu.bmiHeader.biPlanes = 1
    utBIMenu.bmiHeader.biBitCount = 32
    MenuCellBitmap = CreateDIBSection(iDCRef, utBIMenu, 0, nBits, 0, 0)
    ReleaseDC 0, iDCRef
End Function

' A tab that draws a picture instead of a font glyph gets that picture in the menu, scaled into
' the same cell. It goes through the strip's own scaler and not through PictureScaledToSize,
' which hands a picture back untouched when it is already about the right size - and untouched
' means no alpha channel to read. The scaler is what turns a mask colour, or an old icon's mask,
' into the alpha a menu bitmap needs, and what it answers is already premultiplied
Private Function MenuPictureBitmap(ByVal nTab As Long, ByVal nWidth As Long, ByVal nHeight As Long) As LongPtr
    Dim iPic As StdPicture
    Dim iScaledPic As StdPicture
    Dim utIconInfo As ICONINFO
    Dim utBIPic As BITMAPINFO
    Dim iSrcBits() As Long
    Dim iSrcWidth As Long
    Dim iSrcHeight As Long
    Dim iTargetWidth As Long
    Dim iTargetHeight As Long
    Dim iRatio As Double
    Dim iMaskColor As Long
    Dim iHIcon As LongPtr
    Dim iDCRef As LongPtr
    Dim iBmp As LongPtr
    Dim iBits As LongPtr
    Dim iLeft As Long
    Dim iTop As Long
    Dim iRow As Long
    Dim iGotBits As Boolean
    
    Set iPic = mTabData(nTab).PicToUse
    If iPic Is Nothing Then Exit Function
    If iPic.Handle = 0 Then Exit Function
    If (Not mTabData(nTab).Enabled) Or (Not mEnabled) Then
        ' not through TabPicDisabled: its cache is keyed by the colour the grey was derived
        ' against, and asking it for the menu's would evict the one the strip is using
        Set iPic = GrayScaledPicture(iPic, GetSysColor(COLOR_MENU))
        If iPic Is Nothing Then Exit Function
        If iPic.Handle = 0 Then Exit Function
    End If
    PictureSizeInPixels iPic, iSrcWidth, iSrcHeight
    If (iSrcWidth <= 0) Or (iSrcHeight <= 0) Then Exit Function
    ' inside the cell, keeping its proportions
    iRatio = nWidth / iSrcWidth
    If (nHeight / iSrcHeight) < iRatio Then iRatio = nHeight / iSrcHeight
    iTargetWidth = Int(iSrcWidth * iRatio)
    iTargetHeight = Int(iSrcHeight * iRatio)
    If iTargetWidth < 1 Then iTargetWidth = 1
    If iTargetHeight < 1 Then iTargetHeight = 1
    ' resolved here for the same reason PictureScaledToSize resolves it: the scaler stays free
    ' of the control's colour machinery
    If mUseMaskColor Then
        iMaskColor = TranslatedColor(mMaskColor)
    Else
        iMaskColor = -1
    End If
    iHIcon = ScalePictureToIcon(iPic, iMaskColor, iSrcWidth, iSrcHeight, iTargetWidth, iTargetHeight, PicScaleMode)
    If iHIcon = 0 Then Exit Function
    ' the picture takes ownership of the handle and frees it when this one goes out of scope
    Set iScaledPic = CreatePicture(iHIcon, vbPicTypeIcon)
    If iScaledPic Is Nothing Then Exit Function
    If GetIconInfo(iScaledPic.Handle, utIconInfo) = 0 Then Exit Function
    ReDim iSrcBits(0 To iTargetWidth * iTargetHeight - 1)
    utBIPic.bmiHeader.biSize = Len(utBIPic.bmiHeader)
    utBIPic.bmiHeader.biWidth = iTargetWidth
    utBIPic.bmiHeader.biHeight = -iTargetHeight
    utBIPic.bmiHeader.biPlanes = 1
    utBIPic.bmiHeader.biBitCount = 32
    iDCRef = GetDC(0)
    If iDCRef <> 0 Then
        iGotBits = (GetDIBits(iDCRef, utIconInfo.hbmColor, 0, iTargetHeight, iSrcBits(0), utBIPic, 0) <> 0)
        ReleaseDC 0, iDCRef
    End If
    ' GetIconInfo hands out copies of both bitmaps
    If utIconInfo.hbmColor <> 0 Then DeleteObject utIconInfo.hbmColor
    If utIconInfo.hbmMask <> 0 Then DeleteObject utIconInfo.hbmMask
    If Not iGotBits Then Exit Function
    iBmp = MenuCellBitmap(nWidth, nHeight, iBits)
    If iBmp = 0 Then Exit Function
    iLeft = (nWidth - iTargetWidth) \ 2
    iTop = (nHeight - iTargetHeight) \ 2
    For iRow = 0 To iTargetHeight - 1
        CopyMemory ByVal (iBits + ((iTop + iRow) * nWidth + iLeft) * 4), iSrcBits(iRow * iTargetWidth), iTargetWidth * 4
    Next iRow
    MenuPictureBitmap = iBmp
End Function

' The icon has to read beside the caption the way it does on a tab, so its em box is the menu
' font's and not the check cell, which is drawn bigger than the menu text
Private Function MenuGlyphEmHeight() As Long
    Dim utNCM As NONCLIENTMETRICSW
    
    utNCM.cbSize = LenB(utNCM)
    If SystemParametersInfoNCM(SPI_GETNONCLIENTMETRICS, utNCM.cbSize, utNCM, 0) = 0 Then
        ' without a Vista manifest the call only answers to the size that stops before
        ' iPaddedBorderWidth
        utNCM.cbSize = LenB(utNCM) - 4
        If SystemParametersInfoNCM(SPI_GETNONCLIENTMETRICS, utNCM.cbSize, utNCM, 0) = 0 Then Exit Function
    End If
    If utNCM.lfMenuFont.LFHeight < 0 Then
        MenuGlyphEmHeight = -utNCM.lfMenuFont.LFHeight
    Else
        MenuGlyphEmHeight = utNCM.lfMenuFont.LFHeight
    End If
End Function

Private Function MeasureMenuGlyph(ByVal nDC As LongPtr, ByVal nCharCode As Long, ByRef nGlyph As GLYPHMETRICS, ByRef nTextMetric As TEXTMETRICW, ByRef nIdentity As MAT2) As Boolean
    If GetGlyphOutlineW(nDC, nCharCode, GGO_METRICS, nGlyph, 0, 0, nIdentity) = GDI_ERROR Then Exit Function
    If GetTextMetricsW(nDC, nTextMetric) = 0 Then Exit Function
    If nGlyph.gmBlackBoxY <= 0 Then Exit Function
    MeasureMenuGlyph = True
End Function

' Only with the pointer over the strip; anywhere else the message goes on to the container.
' Rolling the wheel toward the user brings in what lies further down the screen, or toward the last
' tab in a horizontal strip; tilting it right moves toward the last one
Private Function ScrollByWheel(ByVal nHorizontal As Boolean, ByVal nWParam As LongPtr, ByVal nLParam As LongPtr) As Boolean
    Dim iDelta As Long
    Dim iSteps As Long
    Dim iPt As POINTAPI
    Dim iX As Long
    
    If Not mStripScrolls Then Exit Function
    iPt.X = SignedLowWord(nLParam)
    iPt.Y = SignedHighWord(nLParam)
    ScreenToClient mUserControlHwnd, iPt
    iX = iPt.X
    If mRightToLeft Then iX = mScaleWidth - iX
    If Not ScrollViewContains(iX, iPt.Y) Then
        Select Case StripButtonHitTest(iX, iPt.Y)
            Case 1, 2
            Case Else
                Exit Function
        End Select
    End If
    ScrollByWheel = True
    iDelta = SignedHighWord(nWParam)
    If Not nHorizontal Then
        iDelta = -iDelta
        If mScrollFwdRectScreen.Top < mScrollBackRectScreen.Top Then iDelta = -iDelta
    End If
    mScrollWheelRemainder = mScrollWheelRemainder + iDelta
    iSteps = mScrollWheelRemainder \ 120
    mScrollWheelRemainder = mScrollWheelRemainder - iSteps * 120
    Do While iSteps > 0
        ScrollStep 1
        iSteps = iSteps - 1
    Loop
    Do While iSteps < 0
        ScrollStep -1
        iSteps = iSteps + 1
    Loop
End Function

Private Function SignedLowWord(ByVal nValue As LongPtr) As Long
    SignedLowWord = CLng(nValue And &HFFFF&)
    If SignedLowWord >= &H8000& Then SignedLowWord = SignedLowWord - &H10000
End Function

' Masked before dividing, so a negative value does not round toward zero
Private Function SignedHighWord(ByVal nValue As LongPtr) As Long
    SignedHighWord = SignedLowWord((nValue And &HFFFF0000) \ &H10000)
End Function

' Scrolled strip (TabsOverflow). When the single row does not fit, the layout is handed a virtual
' room as wide as the row itself, so the packing, the sharing and the snap neither wrap nor shrink
' it, and ScrollApply then slides the finished row under a window between the two scroll buttons.
' Every style is laid out as caption width there; EqualWidth first pins every tab to the width
' TabsPerRow tabs would have in the window
' In the rotated families with horizontal captions the row is one column, and its virtual width is
' the exact sum of the extents the packing uses, so ntTHFill stretches by zero and nothing is forced
Private Sub ScrollDecide(ByRef nScaleWidthForTabs As Long, ByRef nScaleWidthForTabsReal As Long, ByVal nTabMaxWidth As Long, ByVal nTabHeight As Long)
    Dim t As Long
    Dim iEqualWidth As Long
    Dim iReserveGrowth As Long
    
    mStripScrolls = False
    If mTabsOverflow = ntTOMultiRow Then Exit Sub
    If Not ScrollRowOverflows(nScaleWidthForTabs, nTabHeight) Then Exit Sub
    ' A '+' after the last tab would scroll out of sight, so it moves to the zone. The row may fit
    ' without it, and then it is left in the zone and nothing scrolls
    If Not mNewTabButtonInZone Then
        If TabIsNewTabButton(mTabs - 1) Then
            If mTabData(mTabs - 1).Visible Then
                iReserveGrowth = StripButtonsReserve
                NewTabButtonZoneEnter
                mVisibleTabs = mVisibleTabs - 1
                iReserveGrowth = StripButtonsReserve - iReserveGrowth
                nScaleWidthForTabs = nScaleWidthForTabs - iReserveGrowth
                nScaleWidthForTabsReal = nScaleWidthForTabsReal - iReserveGrowth
                If Not ScrollRowOverflows(nScaleWidthForTabs, nTabHeight) Then Exit Sub
            End If
        End If
    End If
    mStripScrolls = True
    SetupCloseButtonFont
    mScrollButtonWidth = ScrollButtonWidth
    If mTabsOverflow = ntTOScrollWithList Then
        iReserveGrowth = StripButtonsReserve
        mZoneListWidth = mScrollButtonWidth
        iReserveGrowth = StripButtonsReserve - iReserveGrowth
        nScaleWidthForTabs = nScaleWidthForTabs - iReserveGrowth
        nScaleWidthForTabsReal = nScaleWidthForTabsReal - iReserveGrowth
    End If
    If (mTabWidthStyle2 = ntTWEqualWidth) And (Not mTabsAreRotatedButCaptionsAreHorizontal) Then
        iEqualWidth = (nScaleWidthForTabs + ScrollZoneGapTaken - 2 * mScrollButtonWidth - RowLostToEdges() - mTabSeparation2 * (mTabsPerRow - 1)) \ mTabsPerRow
        If nTabMaxWidth > 0 Then
            If iEqualWidth > nTabMaxWidth Then iEqualWidth = nTabMaxWidth
        End If
        For t = 0 To mTabs - 1
            If mTabData(t).Visible Then
                If mTabData(t).FixedWidth <> 0 Then
                    mTabData(t).IconAndCaptionWidth = pScaleX(mTabData(t).FixedWidth, vbHimetric, vbPixels) - 2 * mTabPaddingWidthDPIScaled
                Else
                    mTabData(t).IconAndCaptionWidth = iEqualWidth - 2 * mTabPaddingWidthDPIScaled
                End If
                If mTabData(t).IconAndCaptionWidth < 0 Then mTabData(t).IconAndCaptionWidth = 0
            End If
        Next t
    End If
    If Not mTabsAreRotatedButCaptionsAreHorizontal Then mTabWidthStyle2 = ntTWTabCaptionWidth
    nScaleWidthForTabs = ScrollRowExtent(nTabHeight) + RowLostToEdges()
End Sub

' StripButtonsReserve keeps a margin between the last tab and the zone. With the forward button
' in between, the button's own margins already separate them, so it takes that one over
Private Function ScrollZoneGapTaken() As Long
    If StripButtonsReserve > 0 Then ScrollZoneGapTaken = mCloseButtonMarginDPIScaled
End Function

Private Function ScrollRowOverflows(ByVal nScaleWidthForTabs As Long, ByVal nTabHeight As Long) As Boolean
    If (mTabWidthStyle2 = ntTWEqualWidth) And (Not mTabsAreRotatedButCaptionsAreHorizontal) Then
        ScrollRowOverflows = (mVisibleTabs > mTabsPerRow)
    Else
        ScrollRowOverflows = (ScrollRowExtent(nTabHeight) > (nScaleWidthForTabs - RowLostToEdges()))
    End If
End Function

Private Function ScrollRowExtent(ByVal nTabHeight As Long) As Long
    Dim t As Long
    Dim iCount As Long
    Dim iExtent As Long
    
    If mTabsAreRotatedButCaptionsAreHorizontal Then
        ScrollRowExtent = ScrollColumnExtentHC(nTabHeight)
        Exit Function
    End If
    For t = 0 To mTabs - 1
        If mTabData(t).Visible Then
            iExtent = iExtent + mTabData(t).IconAndCaptionWidth + 2 * mTabPaddingWidthDPIScaled
            iCount = iCount + 1
        End If
    Next t
    If iCount > 1 Then iExtent = iExtent + (iCount - 1) * mTabSeparation2
    ScrollRowExtent = iExtent
End Function

' The extent of a single column, worked out the way the packing of each ntTH style counts it
Private Function ScrollColumnExtentHC(ByVal nTabHeight As Long) As Long
    Dim t As Long
    Dim iCount As Long
    Dim iFreeCount As Long
    Dim iFreeMax As Long
    Dim iExtent As Long
    
    For t = 0 To mTabs - 1
        If mTabData(t).Visible Then
            iCount = iCount + 1
            If mTabData(t).FixedWidth <> 0 Then
                iExtent = iExtent + CLng(pScaleX(mTabData(t).FixedWidth, vbHimetric, vbPixels))
            ElseIf (mTabHeightStyleForHorizontal = ntTHTabCaptionHeight) Or (mTabHeightStyleForHorizontal = ntTHStretchToFill) Then
                iExtent = iExtent + mTabData(t).Width
            ElseIf mTabHeightStyleForHorizontal = ntTHMaxCaptionHeight Then
                iFreeCount = iFreeCount + 1
                If mTabData(t).Width > iFreeMax Then iFreeMax = mTabData(t).Width
            Else
                iExtent = iExtent + nTabHeight
            End If
        End If
    Next t
    iExtent = iExtent + iFreeCount * iFreeMax
    If iCount > 1 Then iExtent = iExtent + (iCount - 1) * mTabSeparation2
    ScrollColumnExtentHC = iExtent
End Function

Private Function ScrollButtonWidth() As Long
    Dim iCharacter As String
    Dim iCharRect As RECT
    Dim iWidth As Long
    
    SetupCloseButtonFont
    iCharacter = ChrU(mScrollFwdCharCode)
    Set picAuxIconFont.Font = mStripButtonsFont
    DrawTextW picAuxIconFont.hDC, StrPtr(iCharacter), -1, iCharRect, DT_CALCRECT Or DT_SINGLELINE Or DT_CENTER
    iWidth = iCharRect.Right - iCharRect.Left
    ' the three buttons share one width; the default glyphs are measured by the forward one only
    If mStripButtonBackIsUser Then iWidth = MaxGlyphWidth(mScrollBackCharCode, iWidth)
    If mStripButtonListIsUser Then iWidth = MaxGlyphWidth(mScrollListDownCharCode, iWidth)
    ScrollButtonWidth = iWidth + mCloseButtonMarginDPIScaled * 2
End Function

' The same test DrawTab applies to drop FlatRoundnessTop from a row end. ntHLRoundBottom is ignored
' when any end is dropped, and the body does not round under a dropped front-row end.
Private Sub FlatRowEndsSquaredUpdate()
    Dim t As Long
    Dim iRowListed As Boolean
    Dim iSquared As Boolean
    
    mFlatRowEndsSquared = False
    mFlatFrontRowLeftEndSquared = False
    mFlatFrontRowRightEndSquared = False
    If Not mAppearanceIsFlat Then Exit Sub
    If (mRows < 2) Or mShowsRowsPerspective2 Or (mFlatRoundnessTabsDPIScaled > 0) Or (mFlatRoundnessTop2 <= 0) Then Exit Sub
    iRowListed = (mTabWidthStyle2 = ntTWTabCaptionWidthFillRows) Or (mTabWidthStyle2 = ntTWTabCaptionWidth) Or (mTabWidthStyle2 = ntTWEqualWidth) Or mTabsAreRotatedButCaptionsAreHorizontal
    For t = 0 To mTabs - 1
        If mTabData(t).Visible And (mTabData(t).RowPos > 0) Then
            If mTabData(t).LeftTab Then
                iSquared = True
                If iRowListed Then iSquared = (mLeftMostTabsLeftPos2(mTabData(t).RowPos - 1) <= mTabData(t).TabRect.Left)
                If iSquared Then
                    mFlatRowEndsSquared = True
                    If mTabData(t).RowPos = (mRows - 1) Then mFlatFrontRowLeftEndSquared = True
                End If
            End If
            If mTabData(t).RightTab Then
                iSquared = True
                If iRowListed Then iSquared = (mRightMostTabsRightPos2(mTabData(t).RowPos - 1) >= mTabData(t).TabRect.Right)
                If iSquared Then
                    mFlatRowEndsSquared = True
                    If mTabData(t).RowPos = (mRows - 1) Then mFlatFrontRowRightEndSquared = True
                End If
            End If
        End If
    Next t
End Sub

' Needs mStripButtonsFont already in picAuxIconFont
Private Function MaxGlyphWidth(ByVal nCharCode As Long, ByVal nWidth As Long) As Long
    Dim iCharacter As String
    Dim iCharRect As RECT
    
    iCharacter = ChrU(nCharCode)
    DrawTextW picAuxIconFont.hDC, StrPtr(iCharacter), -1, iCharRect, DT_CALCRECT Or DT_SINGLELINE Or DT_CENTER
    MaxGlyphWidth = nWidth
    If (iCharRect.Right - iCharRect.Left) > nWidth Then MaxGlyphWidth = iCharRect.Right - iCharRect.Left
End Function

' Runs on the finished layout, before the band shift, the widening and everything that reads the
' row's ends. The scroll position is a tab and not a pixel offset, so it survives resizes and
' caption changes; the selected tab is brought into view only when it changes, so the scroll
' buttons can move away from it. Stored rects and the window are in the band-shifted frame
' LeftHorizontal and RightBottomHorizontal are laid out as the sibling on their side that is not
' reversed and then turned end for end along the strip, so every layout pass keeps reading the index
' as growing to the right. The axis puts a row's start on its end and back, per row because of the
' perspective. LeftTab and RightTab name the ends of a row by position, so they swap.
' Chosen against reversing the placement loop, which would have meant reworking the overlap and gap
' passes, ScrollApply and the zone placement, all of which walk the index as the position.
Private Sub StripOrderMirror(ByVal nAxisBase As Long, ByVal nRowPerspectiveSpace As Long)
    Dim t As Long
    Dim iRow As Long
    Dim iAxis As Long
    Dim iLng As Long
    Dim iFlag As Boolean
    
    ReDim mRowMirrorAxis(0 To mRows - 1)
    For iRow = 0 To mRows - 1
        mRowMirrorAxis(iRow) = nAxisBase + nRowPerspectiveSpace * (mRows - 1 - 2 * iRow) + 2 * ThemedBandShift()
    Next iRow
    For t = 0 To mTabs - 1
        If mTabData(t).Visible Then
            If mTabData(t).RowPos > -1 Then
                iAxis = nAxisBase + nRowPerspectiveSpace * (mRows - 1 - 2 * mTabData(t).RowPos)
                iLng = mTabData(t).TabRect.Left
                mTabData(t).TabRect.Left = iAxis - mTabData(t).TabRect.Right
                mTabData(t).TabRect.Right = iAxis - iLng
                iFlag = mTabData(t).LeftTab
                mTabData(t).LeftTab = mTabData(t).RightTab
                mTabData(t).RightTab = iFlag
            End If
        End If
    Next t
    For iRow = 0 To UBound(mRightMostTabsRightPos)
        iAxis = nAxisBase + nRowPerspectiveSpace * (mRows - 1 - 2 * iRow)
        iLng = mLeftMostTabsLeftPos(iRow)
        mLeftMostTabsLeftPos(iRow) = iAxis - mRightMostTabsRightPos(iRow)
        mRightMostTabsRightPos(iRow) = iAxis - iLng
        iLng = mLeftMostTabsLeftPos2(iRow)
        mLeftMostTabsLeftPos2(iRow) = iAxis - mRightMostTabsRightPos2(iRow)
        mRightMostTabsRightPos2(iRow) = iAxis - iLng
    Next iRow
    If mStripScrolls Then
        ' ScrollApply leaves these with the themed band shift already in, which the tab rects only
        ' get later: their axis is the same one moved by twice that shift
        iAxis = nAxisBase + nRowPerspectiveSpace * (mRows - 1) + 2 * ThemedBandShift()
        RectMirrorAlong mScrollBackRect, iAxis
        RectMirrorAlong mScrollFwdRect, iAxis
        iLng = mScrollViewLeft
        mScrollViewLeft = iAxis - mScrollViewRight
        mScrollViewRight = iAxis - iLng
    End If
End Sub

' The zone rects are placed after StripOrderMirror and are never moved by the themed band shift, so
' they take the axis the tabs have once that shift is in.
Private Sub StripZoneMirror(ByVal nAxisBase As Long, ByVal nRowPerspectiveSpace As Long)
    Dim iRow As Long
    Dim iAxis As Long
    
    If mStripButtonsRow = ntSBOuterRow Then
        iRow = 0
    Else
        iRow = mRows - 1
    End If
    iAxis = nAxisBase + nRowPerspectiveSpace * (mRows - 1 - 2 * iRow) + 2 * ThemedBandShift()
    RectMirrorAlong mStripCloseRect, iAxis
    RectMirrorAlong mZoneNewTabRect, iAxis
    RectMirrorAlong mZoneListRect, iAxis
End Sub

Private Sub RectMirrorAlong(ByRef nRect As RECT, ByVal nAxis As Long)
    Dim iLng As Long
    
    If nRect.Right <= nRect.Left Then Exit Sub
    iLng = nRect.Left
    nRect.Left = nAxis - nRect.Right
    nRect.Right = nAxis - iLng
End Sub

Private Sub ScrollApply(ByVal nScaleWidthForTabsReal As Long)
    Dim t As Long
    Dim iFirstVisible As Long
    Dim iLastVisible As Long
    Dim iOffset As Long
    Dim iLimit As Long
    Dim iRowEnd As Long
    Dim iViewWidth As Long
    Dim iBandShift As Long
    Dim iRefTab As Long
    Dim iSide As Long
    Dim iWidenRoom As Long
    Dim iFreeAtStart As Long
    
    iFirstVisible = -1
    iLastVisible = -1
    For t = 0 To mTabs - 1
        If mTabData(t).Visible Then
            If iFirstVisible = -1 Then iFirstVisible = t
            iLastVisible = t
        End If
    Next t
    If iFirstVisible = -1 Then
        mStripScrolls = False
        Exit Sub
    End If
    
    ' Rows aligned at the end keep StripEndFreeSpace at their start, as NewTabZonePlace does
    If mTabsAlignedAtTheEnd And (Not mTabsOrderReversed) Then iFreeAtStart = pScaleX(mStripEndFreeSpace, vbHimetric, vbPixels)
    mScrollViewLeft = RowStartX() + iFreeAtStart + mScrollButtonWidth
    iRowEnd = nScaleWidthForTabsReal - RowEndMargin() - ThemedBandShift() + ScrollZoneGapTaken + iFreeAtStart
    mScrollViewRight = iRowEnd - mScrollButtonWidth
    iViewWidth = mScrollViewRight - mScrollViewLeft
    ' A row that is not scrolled keeps this room at its two ends, in RowStartX and RowEndMargin, so
    ' that a widened tab at either end still fits. The window has to keep it too, or the widened tab
    ' at the end of the travel is drawn under the chevrons and the clip cuts it
    iWidenRoom = SelectedTabWideningSpace()
    
    If (mScrollFirstTab < iFirstVisible) Or (mScrollFirstTab > iLastVisible) Then mScrollFirstTab = iFirstVisible
    Do Until mTabData(mScrollFirstTab).Visible
        mScrollFirstTab = mScrollFirstTab + 1
    Loop
    If (mTab <> mScrollEnsuredTab) And (mTab >= 0) And (mTab < mTabs) Then
        If mTabData(mTab).Visible Then
            iOffset = mTabData(mScrollFirstTab).TabRect.Left - (mScrollViewLeft + iWidenRoom)
            If (mTabData(mTab).TabRect.Left - iOffset) < (mScrollViewLeft + iWidenRoom) Then
                mScrollFirstTab = mTab
            ElseIf (mTabData(mTab).TabRect.Right - iOffset) > (mScrollViewRight - iWidenRoom) Then
                For t = mScrollFirstTab To mTab
                    If mTabData(t).Visible Then
                        If (mTabData(mTab).TabRect.Right - mTabData(t).TabRect.Left) <= iViewWidth Then
                            mScrollFirstTab = t
                            Exit For
                        End If
                    End If
                    If t = mTab Then mScrollFirstTab = mTab
                Next t
            End If
            mScrollEnsuredTab = mTab
        End If
    End If
    
    iOffset = mTabData(mScrollFirstTab).TabRect.Left - (mScrollViewLeft + iWidenRoom)
    iLimit = mTabData(iLastVisible).TabRect.Right - (mScrollViewRight - iWidenRoom)
    If iOffset > iLimit Then iOffset = iLimit
    iLimit = mTabData(iFirstVisible).TabRect.Left - (mScrollViewLeft + iWidenRoom)
    If iOffset < iLimit Then iOffset = iLimit
    For t = 0 To mTabs - 1
        If mTabData(t).Visible Then
            mTabData(t).TabRect.Left = mTabData(t).TabRect.Left - iOffset
            mTabData(t).TabRect.Right = mTabData(t).TabRect.Right - iOffset
            ' The chevrons take both ends of the row, so no tab meets a side edge of the body
            mTabData(t).LeftTab = False
            mTabData(t).RightTab = False
        End If
    Next t
    ' the first tab that starts inside the window, so the back button reveals the one it cuts
    For t = iFirstVisible To iLastVisible
        If mTabData(t).Visible Then
            If mTabData(t).TabRect.Left >= mScrollViewLeft Then
                mScrollFirstTab = t
                Exit For
            End If
        End If
    Next t
    mScrollBackEnabled = (mTabData(iFirstVisible).TabRect.Left < mScrollViewLeft + iWidenRoom)
    mScrollFwdEnabled = (mTabData(iLastVisible).TabRect.Right > mScrollViewRight - iWidenRoom)
    
    ' what the body reads as the ends of the row is what can be seen of it
    mLeftMostTabsLeftPos(0) = mTabData(iFirstVisible).TabRect.Left
    If mLeftMostTabsLeftPos(0) < mScrollViewLeft Then mLeftMostTabsLeftPos(0) = mScrollViewLeft
    mRightMostTabsRightPos(0) = mTabData(iLastVisible).TabRect.Right
    If mRightMostTabsRightPos(0) > mScrollViewRight Then mRightMostTabsRightPos(0) = mScrollViewRight
    mLeftMostTabsLeftPos2(0) = mLeftMostTabsLeftPos(0)
    mRightMostTabsRightPos2(0) = mRightMostTabsRightPos(0)
    
    iBandShift = ThemedBandShift()
    iRefTab = mTab
    For t = iFirstVisible To iLastVisible
        If mTabData(t).Visible And (t <> mTab) Then
            If Not TabIsDrawnWithExtraHeight(t) Then
                iRefTab = t
                Exit For
            End If
        End If
    Next t
    iSide = mScrollButtonWidth - mCloseButtonMarginDPIScaled
    If iSide < 1 Then iSide = 1
    mScrollBackRect.Left = RowStartX() + iFreeAtStart + mCloseButtonMarginDPIScaled \ 2 + iBandShift
    mScrollBackRect.Right = mScrollBackRect.Left + iSide
    mScrollFwdRect.Right = iRowEnd - mCloseButtonMarginDPIScaled \ 2 + iBandShift
    mScrollFwdRect.Left = mScrollFwdRect.Right - iSide
    mScrollBackRect.Top = (mTabData(iRefTab).TabRect.Top + mTabData(iRefTab).TabRect.Bottom - iSide) \ 2
    mScrollBackRect.Bottom = mScrollBackRect.Top + iSide
    mScrollFwdRect.Top = mScrollBackRect.Top
    mScrollFwdRect.Bottom = mScrollBackRect.Bottom
    mScrollViewLeft = mScrollViewLeft + iBandShift
    mScrollViewRight = mScrollViewRight + iBandShift
    mScrollBandBottom = mBodyStart + 2
End Sub

' From the as-Top frame the buttons are placed in to the screen frame the mouse is read in
Private Function ScrollRectToScreen(ByRef nAsTop As RECT, ByVal nScaleWidth As Long, ByVal nScaleHeight As Long) As RECT
    ScrollRectToScreen = nAsTop
    If mOrientationIsBottom Then
        ScrollRectToScreen.Top = nScaleHeight - 3 - nAsTop.Bottom
        ScrollRectToScreen.Bottom = nScaleHeight - 3 - (nAsTop.Top - 2)
    ElseIf (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Or (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationLeftBottomHorizontal) Then
        ScrollRectToScreen.Top = nScaleWidth - nAsTop.Right
        ScrollRectToScreen.Bottom = ScrollRectToScreen.Top + nAsTop.Right - nAsTop.Left
        ScrollRectToScreen.Left = nAsTop.Top
        ScrollRectToScreen.Right = ScrollRectToScreen.Left + nAsTop.Bottom - nAsTop.Top
    ElseIf (mTabOrientation = ssTabOrientationRight) Or (mTabOrientation = ntTabOrientationRightBottom) Or (mTabOrientation = ntTabOrientationRightHorizontal) Or (mTabOrientation = ntTabOrientationRightBottomHorizontal) Then
        ScrollRectToScreen.Top = nAsTop.Left
        ScrollRectToScreen.Bottom = ScrollRectToScreen.Top + nAsTop.Right - nAsTop.Left
        ScrollRectToScreen.Left = nScaleHeight - nAsTop.Bottom
        ScrollRectToScreen.Right = ScrollRectToScreen.Left + nAsTop.Bottom - nAsTop.Top
    End If
End Function

Private Sub ScrollRectsToScreen(ByVal nScaleWidth As Long, ByVal nScaleHeight As Long)
    Dim iView As RECT
    
    If Not mStripScrolls Then Exit Sub
    mScrollBackRectScreen = ScrollRectToScreen(mScrollBackRect, nScaleWidth, nScaleHeight)
    mScrollFwdRectScreen = ScrollRectToScreen(mScrollFwdRect, nScaleWidth, nScaleHeight)
    iView.Left = mScrollViewLeft
    ' Exclusive, as ScrollRectToScreen maps a RECT: mScrollViewRight is the last column kept, and
    ' mapping it as the end left the Left frames one row off the as-Top clip
    iView.Right = mScrollViewRight + 1
    iView.Top = 0
    iView.Bottom = mScrollBandBottom
    mScrollViewRectScreen = ScrollRectToScreen(iView, nScaleWidth, nScaleHeight)
End Sub

' Keeps the tabs off the two ends of the band, where the scroll buttons go. nScreen is the pass
' drawn after the rotation: Bottom, and the rotated families with horizontal captions, whose strip
' runs vertically on screen
' Whether a tab before this one in the row reaches into the scroll window, and so paints the bar
' over the separator column this tab shares with it
Private Function ScrollLeftNeighborShown(ByVal nTab As Long) As Boolean
    Dim t As Long
    
    For t = 0 To mTabs - 1
        If (t <> nTab) And mTabData(t).Visible Then
            If mTabData(t).RowPos = mTabData(nTab).RowPos Then
                If (mTabData(t).TabRect.Left < mTabData(nTab).TabRect.Left) And (mTabData(t).TabRect.Right >= mScrollViewLeft) Then
                    ScrollLeftNeighborShown = True
                    Exit Function
                End If
            End If
        End If
    Next t
End Function

Private Sub ScrollClipBegin(ByVal nScreen As Boolean)
    Dim iTop As Long
    Dim iBottom As Long
    Dim iViewLeft As Long
    
    If Not mStripScrolls Then Exit Sub
    If mScrollClipSavedDC <> 0 Then Exit Sub
    If nScreen And mTabsAreRotatedButCaptionsAreHorizontal Then
        mScrollClipSavedDC = SaveDC(picDraw.hDC)
        ExcludeClipRect picDraw.hDC, 0, 0, picDraw.ScaleWidth, mScrollViewRectScreen.Top
        ExcludeClipRect picDraw.hDC, 0, mScrollViewRectScreen.Bottom, picDraw.ScaleWidth, picDraw.ScaleHeight
        Exit Sub
    End If
    If nScreen Then
        iTop = mScrollViewRectScreen.Top - 2
        iBottom = picDraw.ScaleHeight
    Else
        iTop = 0
        ' Down to the bottom, not to the band: below it the body's rounded corners leave the tabs showing
        iBottom = picDraw.ScaleHeight
    End If
    ' A flat tab that shares its separator draws it on the column before its own, so the first
    ' tab of the window needs that column too (same condition as iShareLeftSeparator in DrawTab)
    iViewLeft = mScrollViewLeft
    If mAppearanceIsFlat And (mTabSeparation2 = 0) Then
        If Not (mHighlightFlatDrawBorder Or mHighlightFlatDrawBorderSelectedTab) Then iViewLeft = iViewLeft - 1
    End If
    mScrollClipSavedDC = SaveDC(picDraw.hDC)
    ExcludeClipRect picDraw.hDC, 0, iTop, iViewLeft, iBottom
    ExcludeClipRect picDraw.hDC, mScrollViewRight + 1, iTop, picDraw.ScaleWidth, iBottom
End Sub

Private Sub ScrollClipEnd()
    If mScrollClipSavedDC = 0 Then Exit Sub
    RestoreDC picDraw.hDC, mScrollClipSavedDC
    mScrollClipSavedDC = 0
End Sub

Private Sub DrawScrollButtons(ByVal nScreen As Boolean)
    If Not mStripScrolls Then Exit Sub
    If nScreen Then
        DrawScrollButton mScrollBackRectScreen, 1
        DrawScrollButton mScrollFwdRectScreen, 2
    Else
        DrawScrollButton mScrollBackRect, 1
        DrawScrollButton mScrollFwdRect, 2
    End If
End Sub

' Drawn pointing along the as-Top strip: in Left and Right the canvas rotation turns it with the
' strip, which for a direction glyph is what is wanted. The mirrored layout moves it but does not
' flip it, so under RightToLeft the two glyphs swap
Private Sub DrawScrollButton(ByRef nRect As RECT, ByVal nButton As Long)
    Dim iCharacter As String
    Dim iCharCode As Long
    Dim iCharRect As RECT
    Dim iFlags As Long
    Dim iClockWise As Boolean
    Dim iColorBase As Long
    Dim iColor As Long
    Dim iEnabled As Boolean
    Dim iFontPrev As StdFont
    Dim iForeColorPrev As Long
    
    If nRect.Right <= nRect.Left Then Exit Sub
    If (mTab < 0) Or (mTab >= mTabs) Then Exit Sub
    If (nButton = 1) Xor mRightToLeft Then
        iCharCode = mScrollBackCharCode
    Else
        iCharCode = mScrollFwdCharCode
    End If
    If nButton = 1 Then
        iEnabled = mScrollBackEnabled
    Else
        iEnabled = mScrollFwdEnabled
    End If
    iColorBase = mStripButtonsColor
    If Not iEnabled Then
        iColor = DisabledForeColorVariant(iColorBase, TranslatedColor(mBackColor, ntRoleBack), mGrayText)
    Else
        iColor = ButtonFadedColor(-nButton, iColorBase, mStripButtonsColorHighlighted, ntRoleFore, mStripButtonHovered = nButton)
    End If
    Set iFontPrev = picDraw.Font
    Set picDraw.Font = mStripButtonsFont
    iForeColorPrev = picDraw.ForeColor
    picDraw.ForeColor = iColor
    If mTabsAreRotatedButCaptionsAreHorizontal Then
        ' drawn on screen with the strip vertical: the forward glyph turned toward this button's end,
        ' or, for the upper end, the developer's backward glyph turned the other way, which also
        ' points up without being the forward one upside down
        iClockWise = (nRect.Top + nRect.Bottom) > (mScrollViewRectScreen.Top + mScrollViewRectScreen.Bottom)
        If mStripButtonBackIsUser And (Not iClockWise) Then
            iCharCode = mScrollBackCharCode
            iClockWise = True
        Else
            iCharCode = mScrollFwdCharCode
        End If
    End If
    iCharacter = ChrU(iCharCode)
    iCharRect = nRect
    iFlags = DT_SINGLELINE Or DT_CENTER Or DT_VCENTER Or DT_NOCLIP
    InkCenteredGlyphRect iCharCode, nRect, iCharRect, iFlags
    If mTabsAreRotatedButCaptionsAreHorizontal Then
        DrawGlyphQuarterTurn iCharacter, iCharRect, nRect, iFlags, iClockWise
    Else
        DrawTextW picDraw.hDC, StrPtr(iCharacter), -1, iCharRect, iFlags
    End If
    Set picDraw.Font = iFontPrev
    picDraw.ForeColor = iForeColorPrev
End Sub

Private Function StripButtonHitTest(ByVal nXPixels As Single, ByVal nYPixels As Single) As Long
    If mStripScrolls Then
        If PointNearRect(mScrollBackRectScreen, nXPixels, nYPixels) Then
            StripButtonHitTest = 1
            Exit Function
        ElseIf PointNearRect(mScrollFwdRectScreen, nXPixels, nYPixels) Then
            StripButtonHitTest = 2
            Exit Function
        End If
    End If
    If mNewTabButtonInZone Then
        If PointNearRect(mZoneNewTabRectScreen, nXPixels, nYPixels) Then
            StripButtonHitTest = 3
            Exit Function
        End If
    End If
    If mZoneListWidth > 0 Then
        If PointNearRect(mZoneListRectScreen, nXPixels, nYPixels) Then StripButtonHitTest = 4
    End If
End Function

Private Function PointNearRect(ByRef nRect As RECT, ByVal nXPixels As Single, ByVal nYPixels As Single) As Boolean
    With nRect
        If .Right <= .Left Then Exit Function
        If (nXPixels + mIconClickExtendDPIScaled) < .Left Then Exit Function
        If (nXPixels - mIconClickExtendDPIScaled) > .Right Then Exit Function
        If (nYPixels + mIconClickExtendDPIScaled) < .Top Then Exit Function
        If (nYPixels - mIconClickExtendDPIScaled) > .Bottom Then Exit Function
    End With
    PointNearRect = True
End Function

' A tab cut by the window only answers inside it
Private Function ScrollViewContains(ByVal nXPixels As Single, ByVal nYPixels As Single) As Boolean
    If Not mStripScrolls Then
        ScrollViewContains = True
        Exit Function
    End If
    With mScrollViewRectScreen
        If nXPixels < .Left Then Exit Function
        If nXPixels > .Right Then Exit Function
        If nYPixels < .Top Then Exit Function
        If nYPixels > .Bottom Then Exit Function
    End With
    ScrollViewContains = True
End Function

Private Sub SetStripButtonHovered(ByVal nButton As Long)
    If nButton = mStripButtonHovered Then Exit Sub
    mStripButtonHovered = nButton
    ' whatever tip is up belongs to what the pointer just left: the button next door, or the tab
    If mTTTIsForZoneButton Or (nButton <> 0) Then
        tmrShowTabTTT.Enabled = False
        Set mToolTipEx = Nothing
        mTTTIsForZoneButton = False
    End If
    If nButton = 3 Then
        ZoneNewTabButtonTTT
    ElseIf nButton <> 0 Then
        ZoneStripButtonTTT nButton
    End If
    DrawDelayed
End Sub

' Works at design time too, so the developer can reach every tab to place controls on it
' A held chevron repeats the way a held key does, with the delay and the rate set for the keyboard
Private Sub ScrollRepeatStart(ByVal nDirection As Long)
    Dim iDelay As Long
    
    mScrollRepeatDir = nDirection
    If SystemParametersInfoLong(SPI_GETKEYBOARDDELAY, 0, iDelay, 0) = 0 Then iDelay = 1
    If (iDelay < 0) Or (iDelay > 3) Then iDelay = 1
    tmrStripRepeat.Enabled = False
    tmrStripRepeat.Interval = (iDelay + 1) * 250
    tmrStripRepeat.Enabled = True
End Sub

Private Sub ScrollRepeatStop()
    mScrollRepeatDir = 0
    tmrStripRepeat.Enabled = False
End Sub

Private Function ScrollRepeatIntervalMs() As Long
    Dim iSpeed As Long
    
    ' 0 is about 2.5 repeats a second and 31 about 30
    If SystemParametersInfoLong(SPI_GETKEYBOARDSPEED, 0, iSpeed, 0) = 0 Then iSpeed = 31
    If (iSpeed < 0) Or (iSpeed > 31) Then iSpeed = 31
    ScrollRepeatIntervalMs = 1000 / (2.5 + iSpeed * 27.5 / 31)
End Function

' Paused, not stopped, while the pointer is off the chevron, as a scroll bar's arrow does
Private Sub tmrStripRepeat_Timer()
    If (mScrollRepeatDir = 0) Or (Not mStripScrolls) Or ((GetKeyState(VK_LBUTTON) And &H8000) = 0) Then
        ScrollRepeatStop
        Exit Sub
    End If
    tmrStripRepeat.Interval = ScrollRepeatIntervalMs
    If mAmbientUserMode Then
        If mStripButtonHovered <> IIf(mScrollRepeatDir < 0, 1, 2) Then Exit Sub
    End If
    If mScrollRepeatDir < 0 Then
        If Not mScrollBackEnabled Then
            ScrollRepeatStop
            Exit Sub
        End If
    ElseIf Not mScrollFwdEnabled Then
        ScrollRepeatStop
        Exit Sub
    End If
    ScrollStep mScrollRepeatDir
End Sub

Private Sub StripButtonClick(ByVal nXPixels As Single, ByVal nYPixels As Single)
    If Not (mStripScrolls Or mNewTabButtonInZone) Then Exit Sub
    If mTTTIsForZoneButton Then
        tmrShowTabTTT.Enabled = False
        Set mToolTipEx = Nothing
    End If
    If (Not mAmbientUserMode) And mRightToLeft Then nXPixels = mScaleWidth - nXPixels
    Select Case StripButtonHitTest(nXPixels, nYPixels)
        Case 1
            If mScrollBackEnabled Then
                ScrollStep -1
                ScrollRepeatStart -1
            End If
        Case 2
            If mScrollFwdEnabled Then
                ScrollStep 1
                ScrollRepeatStart 1
            End If
        Case 3
            If mAmbientUserMode Then
                If Not TabForeIsDrawnDisabled(mTabs - 1) Then NewTabButtonClicked
            End If
        Case 4
            ShowTabListMenu
    End Select
End Sub

Private Sub ScrollStep(ByVal nDirection As Long)
    Dim t As Long
    
    t = mScrollFirstTab + nDirection
    Do While (t >= 0) And (t < mTabs)
        If mTabData(t).Visible Then
            mScrollFirstTab = t
            DrawDelayed
            Exit Sub
        End If
        t = t + nDirection
    Loop
End Sub

' The same transforms Draw applies to TabRect, so the hit test reads the button in the frame
' the mouse and the tab rects are in
Private Sub StripCloseRectToScreen(ByVal nScaleWidth As Long, ByVal nScaleHeight As Long)
    mStripCloseRectScreen = mStripCloseRect
    If mStripCloseRect.Right <= mStripCloseRect.Left Then Exit Sub
    mStripCloseRectScreen = ScrollRectToScreen(mStripCloseRect, nScaleWidth, nScaleHeight)
End Sub

Private Function StripCloseButtonHitTest(ByVal nXPixels As Single, ByVal nYPixels As Single) As Boolean
    With mStripCloseRectScreen
        If .Right <= .Left Then Exit Function
        If (nXPixels + mIconClickExtendDPIScaled) < .Left Then Exit Function
        If (nXPixels - mIconClickExtendDPIScaled) > .Right Then Exit Function
        If (nYPixels + mIconClickExtendDPIScaled) < .Top Then Exit Function
        If (nYPixels - mIconClickExtendDPIScaled) > .Bottom Then Exit Function
    End With
    StripCloseButtonHitTest = True
End Function

' The events carry the tab the button would close, and the leave reports the same tab the enter did
Private Sub SetStripCloseButtonHovered(ByVal nHovered As Boolean)
    If nHovered = mStripCloseButtonHovered Then Exit Sub
    mStripCloseButtonHovered = nHovered
    If nHovered Then
        mStripCloseButtonHoverTab = mTab
        RaiseEvent CloseButtonMouseEnter(mStripCloseButtonHoverTab)
    Else
        RaiseEvent CloseButtonMouseLeave(mStripCloseButtonHoverTab)
    End If
    DrawDelayed
End Sub

Private Function StripCloseButtonCanClose() As Boolean
    If (mTab < 0) Or (mTab >= mTabs) Then Exit Function
    If Not mTabData(mTab).Visible Then Exit Function
    If Not TabCloseButtonAllowed(mTab) Then Exit Function
    If mTDIMode = ntTDIModeNone Then
        If Not mTabData(mTab).CloseButtonEnabled Then Exit Function
    End If
    If TabForeIsDrawnDisabled(mTab) Then Exit Function
    StripCloseButtonCanClose = True
End Function

Private Sub StripCloseButtonClick()
    Dim iCancelClose As Boolean
    Dim iTab As Long
    
    If Not StripCloseButtonCanClose Then Exit Sub
    iTab = mTab
    If mTDIMode <> ntTDIModeNone Then
        HandleTabTDIEvents iTab
    Else
        RaiseEvent CloseButtonClick(iTab, iCancelClose)
        If Not iCancelClose Then
            TabVisible(iTab) = False
        End If
    End If
End Sub

' nRect is mStripCloseRect when drawn before the rotation and mStripCloseRectScreen after it
Private Sub DrawStripCloseButton(ByRef nRect As RECT)
    Dim iCharacter As String
    Dim iCharRect As RECT
    Dim iColorBase As Long
    Dim iColor As Long
    Dim iFlags As Long
    Dim iCenter As Long
    Dim iFontPrev As StdFont
    Dim iForeColorPrev As Long
    
    If nRect.Right <= nRect.Left Then Exit Sub
    If (mTab < 0) Or (mTab >= mTabs) Then Exit Sub
    SetupCloseButtonFont
    ' On BackColor like the other buttons of the strip end, so at rest it takes their colour
    iColorBase = mStripButtonsColor
    If Not StripCloseButtonCanClose Then
        iColor = DisabledForeColorVariant(iColorBase, TranslatedColor(mBackColor, ntRoleBack), mGrayText)
    Else
        iColor = ButtonFadedColor(cBtnStripClose, iColorBase, CloseButtonColorEffective(mTab, ntCCCloseButtonColorMouseHover), ntRoleFore, mStripCloseButtonHovered)
    End If
    iCharacter = ChrU(mCloseButtonCharCode)
    iCharRect = nRect
    If mCloseButtonGlyphIsMeasured Then
        iCenter = (nRect.Top + nRect.Bottom) \ 2
        iCharRect.Top = iCenter + mCloseButtonGlyphTopFromCenter
        iCharRect.Bottom = iCharRect.Top + (nRect.Bottom - nRect.Top)
        iFlags = DT_SINGLELINE Or DT_CENTER Or DT_TOP Or DT_NOCLIP
    Else
        iFlags = DT_SINGLELINE Or DT_CENTER Or DT_VCENTER Or DT_NOCLIP
    End If
    Set iFontPrev = picDraw.Font
    Set picDraw.Font = mCloseButtonFont
    iForeColorPrev = picDraw.ForeColor
    picDraw.ForeColor = iColor
    DrawUprightGlyph iCharacter, iCharRect, nRect, iFlags
    Set picDraw.Font = iFontPrev
    picDraw.ForeColor = iForeColorPrev
End Sub

' Left and Right rotate the whole canvas afterwards, so there the glyph is pre-rotated to end up
' upright, with the same two matrices DrawTabIconAndCaption uses for icon fonts. nCharRect keeps
' its offsets from the centre of nBtnRect, read in the upright frame
Private Sub DrawUprightGlyph(ByRef nCharacter As String, ByRef nCharRect As RECT, ByRef nBtnRect As RECT, ByVal nFlags As Long)
    Dim iIsLeft As Boolean
    
    iIsLeft = (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop)
    If Not (iIsLeft Or (mTabOrientation = ssTabOrientationRight) Or (mTabOrientation = ntTabOrientationRightBottom)) Then
        DrawTextW picDraw.hDC, StrPtr(nCharacter), -1, nCharRect, nFlags
        Exit Sub
    End If
    ' under RTL the final rotation is the opposite one, so the compensating turn swaps too
    DrawGlyphQuarterTurn nCharacter, nCharRect, nBtnRect, nFlags, iIsLeft Xor mRightToLeft
End Sub

' Draws the glyph turned a quarter around the centre of nBtnRect, clockwise on the device when
' nClockwise. nCharRect keeps its offsets from that centre, read in the unturned frame
Private Sub DrawGlyphQuarterTurn(ByRef nCharacter As String, ByRef nCharRect As RECT, ByRef nBtnRect As RECT, ByVal nFlags As Long, ByVal nClockwise As Boolean)
    Dim iCenterX As Long
    Dim iCenterY As Long
    Dim iLocalRect As RECT
    Dim iTx As XFORM
    Dim iTxPrev As XFORM
    Dim iGMPrev As Long
    Dim iPrevLayoutWnd As Long
    Dim iPrevLayoutDC As Long
    
    iCenterX = nBtnRect.Left + (nBtnRect.Right - nBtnRect.Left) \ 2
    iCenterY = nBtnRect.Top + (nBtnRect.Bottom - nBtnRect.Top) \ 2
    iLocalRect.Left = nCharRect.Left - iCenterX
    iLocalRect.Right = nCharRect.Right - iCenterX
    iLocalRect.Top = nCharRect.Top - iCenterY
    iLocalRect.Bottom = nCharRect.Bottom - iCenterY
    If mRightToLeft Then
        ' the world transform does not compose with the mirrored layout, see DrawTabIconAndCaption
        iPrevLayoutWnd = GetLayout(GetDC(picDraw.hWnd))
        iPrevLayoutDC = GetLayout(picDraw.hDC)
        SetLayout GetDC(picDraw.hWnd), 0
        SetLayout picDraw.hDC, 0
        iCenterX = picDraw.ScaleWidth - iCenterX
    End If
    iGMPrev = SetGraphicsMode(picDraw.hDC, GM_ADVANCED)
    GetWorldTransform picDraw.hDC, iTxPrev
    If nClockwise Then
        iTx.eM12 = 1
        iTx.eM21 = -1
    Else
        iTx.eM12 = -1
        iTx.eM21 = 1
    End If
    iTx.eDx = iCenterX
    iTx.eDy = iCenterY
    SetWorldTransform picDraw.hDC, iTx
    DrawTextW picDraw.hDC, StrPtr(nCharacter), -1, iLocalRect, nFlags
    SetWorldTransform picDraw.hDC, iTxPrev
    SetGraphicsMode picDraw.hDC, iGMPrev
    If mRightToLeft Then
        SetLayout GetDC(picDraw.hWnd), iPrevLayoutWnd
        SetLayout picDraw.hDC, iPrevLayoutDC
    End If
End Sub

' Draws the close button (the 'x') of a tab, point 1 of ToDo NewTab 2. Independent from
' the regular Icon (which stays free for the developer to use even when the close button
' is shown). Unlike the Icon, the 'x' is always drawn upright (not rotated) regardless of
' TabOrientation, positioned near the edge of the tab that corresponds to "the right" for
' horizontal orientations (Top/Bottom families) or the analogous far edge for the rotated
' Left/Right orientations.
Private Sub DrawTabCloseButton(ByVal nTab As Long)
    Dim iTabRect As RECT
    Dim iBtnRect As RECT
    Dim iBtnSide As Long
    Dim iCenterOther As Long
    Dim iCenterBandTop As Long
    Dim iCenterBandHeight As Long
    Dim iCharacter As String
    Dim iCharRect As RECT
    Dim iColor As Long
    Dim iColorBase As Long
    Dim iColorHighlighted As Long
    Dim iColorBaseHover As Long
    Dim iColorRole As NTColorRoleConstants
    Dim iActive As Boolean
    Dim iFontPrev As StdFont
    Dim iForeColorPrev As Long
    Dim iFlags As Long
    Dim iBarTop As Long
    Dim iBarBottom As Long
    Dim iBarLeft As Long
    Dim iBarRight As Long
    Dim iAreaLeft As Long
    Dim iAreaRight As Long
    Dim iTabSpaceRect As RECT
    Dim iExtraAir As Long
    Dim iHoverAir As Long
    
    If Not mTabData(nTab).Visible Then Exit Sub
    If Not TabCloseButtonShown(nTab) Then
        mTabData(nTab).CloseButtonRect.Left = 0
        mTabData(nTab).CloseButtonRect.Top = 0
        mTabData(nTab).CloseButtonRect.Right = 0
        mTabData(nTab).CloseButtonRect.Bottom = 0
        Exit Sub
    End If
    
    SetupCloseButtonFont
    iTabRect = mTabData(nTab).TabRect
    ' The widening the property page appearance gives the selected tab is taken back out before the
    ' button is placed.
    If SelectedTabIsWidened Then
        If nTab = mTab Then
            iTabRect.Left = iTabRect.Left + SelectedTabWideningPixels
            iTabRect.Right = iTabRect.Right - SelectedTabWideningPixels
        End If
    End If
    ApplyCaptionShift nTab, iTabRect
    
    If DragOffsetsShown Then DragOffsetTabRect iTabRect, nTab
    
    ' The hover square is the glyph plus the fixed margin, but never wider than the air the padding
    ' gives it, so a small CloseButtonPadding does not let it spill over the caption
    iExtraAir = CloseButtonExtraAir
    iHoverAir = mCloseButtonPaddingDPIScaled
    If iHoverAir > mCloseButtonMarginDPIScaled Then iHoverAir = mCloseButtonMarginDPIScaled
    iBtnSide = mTabData(nTab).CloseButtonWidth - mCloseButtonPaddingDPIScaled - iExtraAir + iHoverAir
    If iBtnSide < 1 Then iBtnSide = 1
    
    ' Everything here is drawn in the same virtual "along-strip = Left/Right" space regardless of
    ' the final screen orientation - Draw() rotates the whole canvas as a single bitmap at the end
    ' for Bottom/Left/Right (see the RotatePic calls), so the close button's far end is always
    ' iTabRect.Right, the same as the horizontal orientations - never Bottom/Top.
    GetFlatBarInsets iBarTop, iBarBottom, iBarLeft, iBarRight
    ' The band is the one DrawTabIconAndCaption centres the caption in, written the same way: the
    ' tab height counted inclusively, minus the strips the flat bar takes.
    GetTabSpaceRect iTabRect, mTabData(nTab).Selected, iTabSpaceRect
    GetTabCenteringBand iTabRect, iCenterBandTop, iCenterBandHeight
    iCenterOther = iCenterBandTop + iBarTop + CenterOffset(iCenterBandHeight - iBarTop - iBarBottom, 0)
    ' The same content edge the caption and the icon are placed against, so the button sits
    ' exactly in the slot MeasureTabIconAndCaption reserved for it: its Left lands on
    ' iAreaRight - CloseButtonWidth, which is where the caption's area ends
    GetTabContentEdges iTabRect, iBarLeft, iBarRight, iAreaLeft, iAreaRight
    ' The glyph ends iExtraAir short of the area, and the square overhangs it by half its air
    iBtnRect.Right = iAreaRight - iExtraAir + (iHoverAir - iHoverAir \ 2)
    iBtnRect.Left = iBtnRect.Right - iBtnSide
    iBtnRect.Top = iCenterOther - iBtnSide \ 2
    iBtnRect.Bottom = iBtnRect.Top + iBtnSide
    ' The rect that is clicked never leaves its tab, whatever the drawing does.
    mTabData(nTab).CloseButtonRect = iBtnRect
    If mTabData(nTab).CloseButtonRect.Top < iTabRect.Top Then mTabData(nTab).CloseButtonRect.Top = iTabRect.Top
    If mTabData(nTab).CloseButtonRect.Bottom > iTabRect.Bottom Then mTabData(nTab).CloseButtonRect.Bottom = iTabRect.Bottom
    If mTabData(nTab).CloseButtonRect.Left < iTabRect.Left Then mTabData(nTab).CloseButtonRect.Left = iTabRect.Left
    If mTabData(nTab).CloseButtonRect.Right > iTabRect.Right Then mTabData(nTab).CloseButtonRect.Right = iTabRect.Right
    
    ' The same three situations the icon distinguishes, resolved the same way: the selected tab has
    ' its own pair, a highlighted tab that is not the selected one has its own base color, and
    ' everything else uses the plain one.
    iActive = (nTab = mTab)
    If iActive Then
        iColorBase = CloseButtonColorEffective(nTab, ntCCCloseButtonColorSelectedTab)
        iColorHighlighted = CloseButtonColorEffective(nTab, ntCCCloseButtonColorMouseHoverSelectedTab)
        iColorRole = ntRoleFore
    Else
        ' Same shape as the caption: the resting colour is the near end of the mix now, and
        ' mFadeOutTab is in the test because Hovered is already False on the way out
        iColorBase = CloseButtonColorEffective(nTab, ntCCCloseButtonColor)
        If (mTabData(nTab).Hovered Or (mFadeOutTab = nTab)) And mAmbientUserMode Then
            iColorBaseHover = CloseButtonColorEffective(nTab, ntCCCloseButtonColorTabHighlighted)
            iColorBase = HoverFadedColor(nTab, iColorBase, iColorBaseHover, ntRoleFore)
        End If
        iColorRole = ntRoleFore
        iColorHighlighted = CloseButtonColorEffective(nTab, ntCCCloseButtonColorMouseHover)
    End If
    ' Disabled by any of the three things that can disable it - the button's own flag, its tab, or
    ' the whole control - the same three the caption and the icon already answer to.
    If (Not mTabData(nTab).CloseButtonEnabled) Or TabForeIsDrawnDisabled(nTab) Then
        If iActive Then
            iColor = DisabledForeColorVariant(iColorBase, mTabData(nTab).BodyFillColor, mGrayText_Sel)
        Else
            iColor = DisabledForeColorVariant(iColorBase, mTabData(nTab).BodyFillColor, mGrayText)
        End If
    Else
        iColor = ButtonFadedColor(nTab, iColorBase, iColorHighlighted, iColorRole, mTabData(nTab).CloseButtonHovered)
    End If
    
    iCharacter = ChrU(mCloseButtonCharCode)
    ' DT_TOP and not DT_VCENTER: the vertical placement is ours, computed once from the glyph's own
    ' ink box, so it does not depend on how DrawText splits the slack between the rect and the line
    ' box.
    iCharRect = iBtnRect
    If mCloseButtonGlyphIsMeasured Then
        iCharRect.Top = iCenterOther + mCloseButtonGlyphTopFromCenter
        iCharRect.Bottom = iCharRect.Top + iBtnSide
        iFlags = DT_SINGLELINE Or DT_CENTER Or DT_TOP Or DT_NOCLIP
    Else
        iFlags = DT_SINGLELINE Or DT_CENTER Or DT_VCENTER Or DT_NOCLIP
    End If
#If CLOSEBUTTONGLYPHDIAG = 1 Then ' TEMP diagnostic
    If Not mCloseButtonGeomDiagDone Then
        mCloseButtonGeomDiagDone = True
        Debug.Print "CloseButtonGeom orientation="; mTabOrientation; " tab="; nTab; " tabRect.Top="; iTabRect.Top; " tabRect.Bottom="; iTabRect.Bottom; " tabRect.Left="; iTabRect.Left; " tabRect.Right="; iTabRect.Right
        Debug.Print "   barTop="; iBarTop; " barBottom="; iBarBottom; " barRight="; iBarRight; " flatBarHeightDPIScaled="; mFlatBarHeightDPIScaled; " gripDPIScaled="; mFlatBarGripHeightDPIScaled
        Debug.Print "   centerOther="; iCenterOther; " btnSide="; iBtnSide; " closeButtonWidth="; mTabData(nTab).CloseButtonWidth; " margin="; mCloseButtonMarginDPIScaled
        Debug.Print "   btnRect.Top="; iBtnRect.Top; " btnRect.Bottom="; iBtnRect.Bottom; " charRect.Top="; iCharRect.Top; " topFromCenter="; mCloseButtonGlyphTopFromCenter
    End If
#End If
    Set iFontPrev = picDraw.Font
    Set picDraw.Font = mCloseButtonFont
    iForeColorPrev = picDraw.ForeColor
    picDraw.ForeColor = iColor
    DrawUprightGlyph iCharacter, iCharRect, iBtnRect, iFlags
    Set picDraw.Font = iFontPrev
    picDraw.ForeColor = iForeColorPrev
End Sub

Private Sub DrawTabIconAndCaption(ByVal nTab As Long)
    Dim iColorRole As NTColorRoleConstants
    Dim iInkShift As Long
    Dim iInkTopFromCenter As Long
    Dim iPrevLayoutWnd As Long
    Dim iPrevLayoutDC As Long
    Dim iTabData As T_TabData
    Dim iTabRect As RECT
    Dim iTabSpaceRect As RECT
    Dim iCaptionRect As RECT
    Dim iMeasureRect As RECT
    Dim iFocusRect As RECT
    Dim iAuxPicture As StdPicture
    Dim iIconWidth As Long
    Dim iIconHeight As Long
    Dim iCaption As String
    Dim iFontBoldPrev As Boolean
    Dim iFlags As Long
    Dim iIconLeft As Long
    Dim iIconTop As Long
    Dim iStackTop As Long
    Dim iStackGap As Long
    Dim iStackFree As Long
    Dim iStackSlot As Long
    Dim iStacked As Boolean
    Dim iLng As Long
    Dim iCapReserve As Long
    Dim iCapLeft As Long
    Dim iCapRight As Long
    Dim iGap As Long
    Dim iPairTotal As Long
    Dim iAreaLeft As Long
    Dim iAreaRight As Long
    Dim iIconSourceShiftX As Long
    Dim iIconSourceShiftY As Long
    Dim iTabSpaceWidth As Long
    Dim iTabSpaceHeight As Long
    Dim iCenterBandTop As Long
    Dim iCenterBandHeight As Long
    Dim iMeasureWidth As Long
    Dim iMeasureHeight As Long
    Dim iIconWidthToShow As Long
    Dim iIconHeightToShow As Long
    Dim iIconAlignment As NTIconAlignmentConstants
    Dim iBackColorTabs2 As Long
    Dim iForeColor As Long
    Dim iGrayText As Long
    Dim iForeColor2 As Long
    Dim iDrawIcon As Boolean
    Dim iIconCharacter As String
    Dim iIconCharRect As RECT
    Dim iFontPrev As StdFont
    Dim iIconColor As Long
    Dim iForeColorPrev As Long
    Dim iIconFont As StdFont
    Dim iFlatBarHeightTop As Long
    Dim iFlatBarHeightBottom As Long
    Dim iFlatBarThicknessLeft As Long
    Dim iFlatBarThicknessRight As Long
    
    Dim iAuxRect As RECT
    Dim iGMPrev As Long
    Dim iTx1 As XFORM
    Dim iGMPrev2 As Long
    Dim iTx2 As XFORM
    Dim iTx2Prev As XFORM
    Dim iDrawnInColor As Boolean
    Dim iTabCenterX As Long
    Dim iTabCenterY As Long
    Dim iActive As Boolean
    Dim iPropIconColor As Long
    Dim iIconColorSelectedTab As Long
    Dim iIconColorMouseHover As Long
    Dim iIconColorMouseHoverSelectedTab As Long
    Dim iIconColorTabHighlighted As Long
    Dim iForeColorHover As Long
    Dim iCaptionBoldToDraw As Boolean
    Dim iCaptionBoldForLayout As Boolean
    Dim iTDIFormIcon_Left As Long
    Dim iTDIFormIcon_Top As Long
    Dim iTDIFormIcon_IconCharRect As RECT
    Dim iTDIFormsNoIcons As Boolean
    Dim iDo As Boolean
    Dim iTDIFormsFontPrev As StdFont
    
    If Not mTabData(nTab).Visible Then Exit Sub
    If Not mTabData(nTab).PicToUseSet Then SetPicToUse nTab
    
    iTabData = mTabData(nTab)
    iTabRect = iTabData.TabRect
    ApplyCaptionShift nTab, iTabRect
    
    GetFlatBarInsets iFlatBarHeightTop, iFlatBarHeightBottom, iFlatBarThicknessLeft, iFlatBarThicknessRight
    
    iActive = (nTab = mTab)
    If DragOffsetsShown Then DragOffsetTabRect iTabRect, nTab
    
    ' What DrawTab put on the screen for this tab a moment ago, highlight included
    iBackColorTabs2 = mTabData(nTab).BodyFillColor
    If iActive Then
        iForeColor = iTabData.CustomColors.ResolvedChainColor(ntChainForeColorSelectedTab)
        iIconColorSelectedTab = iTabData.CustomColors.ResolvedChainColor(ntChainIconColorSelectedTab)
        iIconColorMouseHoverSelectedTab = iTabData.CustomColors.ResolvedChainColor(ntChainIconColorMouseHoverSelectedTab)
        If iIconColorMouseHoverSelectedTab <> iIconColorSelectedTab Then
            If (mMouseIsOverIcon_Tab = CInt(nTab) Or (tmrHighlightIcon.Enabled And (Val(tmrHighlightIcon.Tag) = nTab))) And (Not tmrPreHighlightIcon.Enabled) Then
                iIconColor = iIconColorMouseHoverSelectedTab
            Else
                iIconColor = iIconColorSelectedTab
            End If
        Else
            iIconColor = iIconColorSelectedTab
        End If
        iGrayText = mGrayText_Sel
    Else
        ' The resting colour first and unconditionally, because it is now the near end of a
        ' mix and not just the other branch. mFadeOutTab joins the test for the same reason
        ' iHighlighted carries it in DrawTab: Hovered is False for the whole way out
        iForeColor = iTabData.CustomColors.ResolvedChainColor(ntChainForeColor)
        If (iTabData.Hovered Or (mFadeOutTab = nTab)) And mAmbientUserMode And Not DragOffsetsShown Then
            iForeColorHover = iTabData.CustomColors.ResolvedChainColor(ntChainForeColorHighlighted)
            iForeColor = HoverFadedColor(nTab, iForeColor, iForeColorHover, ntRoleFore)
        End If
        iPropIconColor = iTabData.CustomColors.ResolvedChainColor(ntChainIconColor)
        iIconColorMouseHover = iTabData.CustomColors.ResolvedChainColor(ntChainIconColorMouseHover)
        iIconColorTabHighlighted = iTabData.CustomColors.ResolvedChainColor(ntChainIconColorTabHighlighted)
        If iIconColorMouseHover <> iPropIconColor Then
            ' The tmrHighlightIcon half of this condition is what holds the colour on the way out:
            ' mMouseIsOverIcon_Tab is cleared on every mouse move, so without that grace the icon
            ' would drop its hover colour the instant the pointer left it.
            If mAmbientUserMode And (mMouseIsOverIcon_Tab = CInt(nTab) Or (tmrHighlightIcon.Enabled And (Val(tmrHighlightIcon.Tag) = nTab))) And (Not tmrPreHighlightIcon.Enabled) Then
                iIconColor = iIconColorMouseHover
            Else
                If mAmbientUserMode And (iTabData.Hovered Or (mFadeOutTab = nTab)) Then
                    iIconColor = HoverFadedColor(nTab, iPropIconColor, iIconColorTabHighlighted, ntRoleFore)
                Else
                    iIconColor = iPropIconColor
                End If
            End If
        Else
            If (iTabData.Hovered Or (mFadeOutTab = nTab)) And mAmbientUserMode Then
                iIconColor = HoverFadedColor(nTab, iPropIconColor, iIconColorTabHighlighted, ntRoleFore)
            Else
                iIconColor = iPropIconColor
            End If
        End If
        iGrayText = mGrayText
    End If
    If iTabData.IconFont Is Nothing Then
        Set iIconFont = mDefaultIconFont
    Else
        Set iIconFont = iTabData.IconFont
    End If
    ' One role for everything drawn over a tab, hovered or not.
    iColorRole = ntRoleFore
    iForeColor = TranslatedColor(iForeColor, iColorRole)
    iIconColor = TranslatedColor(iIconColor, iColorRole)
    ' The disabled substitution runs after the role and never goes back through it: what comes out
    ' is either the system grey, already a system color, or a variant derived from colors resolved
    ' right above.
    If TabForeIsDrawnDisabled(nTab) Then
        iIconColor = DisabledForeColorVariant(iIconColor, iBackColorTabs2, iGrayText)
        picDraw.ForeColor = DisabledForeColorVariant(iForeColor, iBackColorTabs2, iGrayText)
    Else
        picDraw.ForeColor = iForeColor
    End If
    iForeColor2 = picDraw.ForeColor
    
    iFontBoldPrev = picDraw.FontBold
    If iActive Then
        iCaptionBoldToDraw = mFont.Bold Or mHighlightCaptionBoldSelectedTab
        ' The selected tab never changes weight under the pointer, so the weight it draws in
        ' already IS its worst case and nothing of its layout moves
        iCaptionBoldForLayout = iCaptionBoldToDraw
        picDraw.FontUnderLine = mFont.Underline Or mHighlightCaptionUnderlinedSelectedTab
    Else
        If TabShowsDiscreteHighlight(nTab) And mHighlightCaptionBold Then
            iCaptionBoldToDraw = True
        Else
            iCaptionBoldToDraw = mFont.Bold
        End If
        iCaptionBoldForLayout = mFont.Bold Or mHighlightCaptionBold
        If TabShowsDiscreteHighlight(nTab) And mHighlightCaptionUnderlined Then
            picDraw.FontUnderLine = True
        Else
            picDraw.FontUnderLine = mFont.Underline
        End If
    End If
    ' Everything from here to the drawing call measures, and it measures in the boldest weight this
    ' tab can ever reach and not in the weight it has at this instant.
    picDraw.FontBold = iCaptionBoldForLayout
    
    GetTabSpaceRect iTabRect, iTabData.Selected, iTabSpaceRect
    
    If (Not iTabData.DoNotUseIconFont) And (iTabData.IconChar <> 0) Then
        iIconCharacter = ChrU(iTabData.IconChar)
        iIconCharRect.Left = 0
        iIconCharRect.Top = 0
        iIconCharRect.Right = 0
        iIconCharRect.Bottom = 0 ' iTabSpaceRect.Bottom
        iFlags = DT_CALCRECT Or DT_SINGLELINE Or DT_CENTER
        Set picAuxIconFont.Font = iIconFont
        iDo = True
        If iDo Then
            DrawTextW picAuxIconFont.hDC, StrPtr(iIconCharacter), -1, iIconCharRect, iFlags Or IIf(mRightToLeft, DT_RTLREADING, 0)
            iIconWidth = (iIconCharRect.Right - iIconCharRect.Left)
            iIconHeight = (iIconCharRect.Bottom - iIconCharRect.Top)
            iDrawIcon = True
        End If
    ElseIf Not iTabData.PicToUse Is Nothing Then
        iDrawIcon = True
        ' Same predicate as the caption, the font icon and the close button right above: a picture
        ' icon greys out both when its own tab is disabled and when the whole control is.
        If Not TabForeIsDrawnDisabled(nTab) Then
            Set iAuxPicture = iTabData.PicToUse
        Else
            ' iBackColorTabs2 is the body of this very tab, the same value the caption above
            ' derives against, so a picture and a caption on one tab fade toward one colour
            Set iAuxPicture = TabPicDisabled(nTab, iActive, DisabledPicBackColor(iBackColorTabs2))
        End If
        
        iIconWidth = pScaleX(iAuxPicture.Width, vbHimetric, vbPixels)
        iIconHeight = pScaleY(iAuxPicture.Height, vbHimetric, vbPixels)
        If (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Then
            If mRightToLeft Then
                ' under RTL the final image rotation direction is swapped, so the icon
                ' pre-rotation that compensates it (leaving the icon upright) swaps too
                Set iAuxPicture = RotatePic(iAuxPicture, nt90DegreesCounterClockWise)
            Else
                Set iAuxPicture = RotatePic(iAuxPicture, nt90DegreesClockWise)
            End If
            iIconWidth = pScaleX(iAuxPicture.Width, vbHimetric, vbPixels)
            iIconHeight = pScaleY(iAuxPicture.Height, vbHimetric, vbPixels)
        ElseIf (mTabOrientation = ssTabOrientationRight) Or (mTabOrientation = ntTabOrientationRightBottom) Then
            If mRightToLeft Then
                ' see the note in the Left branch above
                Set iAuxPicture = RotatePic(iAuxPicture, nt90DegreesClockWise)
            Else
                Set iAuxPicture = RotatePic(iAuxPicture, nt90DegreesCounterClockWise)
            End If
            iIconWidth = pScaleX(iAuxPicture.Width, vbHimetric, vbPixels)
            iIconHeight = pScaleY(iAuxPicture.Height, vbHimetric, vbPixels)
        End If
    End If
    
    If iDrawIcon Then
        ' The first tab of TDI Forms used to be pinned to ntIconAlignStart here and to have the
        ' icon-to-caption gap taken away, whatever IconAlignment said.
        iIconAlignment = mIconAlignment
        ' The new tab button holds one glyph and no caption, and every IconAlignment value describes
        ' where the icon goes RELATIVE TO THE CAPTION - so for this one tab the property has nothing
        ' to say and the only answer that always makes sense is the centre of the tab.
        If iTabData.IsNewTabButton Then iIconAlignment = ntIconAlignCenteredOnTab
    End If
    
    iTabSpaceWidth = (iTabSpaceRect.Right - iTabSpaceRect.Left) + 1
    iTabSpaceHeight = (iTabSpaceRect.Bottom - iTabSpaceRect.Top) + 1
    GetTabCenteringBand iTabRect, iCenterBandTop, iCenterBandHeight
    
    ' Calculate iMeasureRect for one liner and without elipsis for both cases, WordWrap or not
    iMeasureRect = iTabSpaceRect
    iMeasureRect.Bottom = iMeasureRect.Top + 5
    
    iFlags = DT_CALCRECT Or DT_SINGLELINE Or mAlignmentDTFlag
    iCaption = iTabData.Caption & IIf(picDraw.Font.Italic, "  ", "")
    DrawTextW picDraw.hDC, StrPtr(iCaption), -1, iMeasureRect, iFlags Or IIf(mRightToLeft, DT_RTLREADING, 0)
    iMeasureWidth = (iMeasureRect.Right - iMeasureRect.Left)
    
    If iDrawIcon Then
        If (iIconAlignment = ntIconAlignAtTop) Or (iIconAlignment = ntIconAlignAtBottom) Then
            ' Stacked: the icon and the caption sit on different rows and never compete for width,
            ' so the arbitration below has nothing to arbitrate.
            iIconWidthToShow = iIconWidth
        ElseIf iMeasureWidth = 0 Then
            ' No caption, so there is no second claimant and nothing to arbitrate - the same reason
            ' the stacked pair above is taken whole, one step earlier: there the two do not share a
            ' row, here the second one does not exist.
            iIconWidthToShow = iIconWidth
        ElseIf iIconWidth + iMeasureWidth + mTabIconDistanceToCaptionDPIScaled > iTabSpaceWidth Then
            If iIconWidth < iTabSpaceWidth / 2 Then
                iIconWidthToShow = iIconWidth
            Else
                If mWordWrap Then
                    If iIconWidth > iTabSpaceWidth * 0.67 Then
                        iIconWidthToShow = iTabSpaceWidth * 0.67
                    Else
                        iIconWidthToShow = iIconWidth
                    End If
                Else
                    If iIconWidth > iTabSpaceWidth * 0.5 Then
                        iIconWidthToShow = iTabSpaceWidth * 0.5
                    Else
                        iIconWidthToShow = iIconWidth
                    End If
                End If
            End If
            If iIconWidthToShow + iMeasureWidth + mTabIconDistanceToCaptionDPIScaled < iTabSpaceWidth Then
                iIconWidthToShow = iTabSpaceWidth - iMeasureWidth - mTabIconDistanceToCaptionDPIScaled
            End If
            If iIconWidthToShow > iIconWidth Then
                iIconWidthToShow = iIconWidth
            End If
        Else
            iIconWidthToShow = iIconWidth
        End If
    End If
    
    If iIconHeight > iTabSpaceHeight Then
        iIconHeightToShow = iTabSpaceHeight
    Else
        iIconHeightToShow = iIconHeight
    End If
    
    ' Where the padding stops being extra tab width and starts meaning something.
    GetTabContentEdges iTabRect, iFlatBarThicknessLeft, iFlatBarThicknessRight, iAreaLeft, iAreaRight
    If TabCloseButtonEffective(nTab) Then
        iAreaRight = iAreaRight - mTabData(nTab).CloseButtonWidth
        ' The band GetTabContentEdges hands out is already non-inverted, but the button's slot
        ' is taken out of it here and can cross the edges again on a tab too narrow to hold it
        If iAreaRight < iAreaLeft Then iAreaRight = iAreaLeft
    End If
    ' The stacked icon's ceiling, now that the band exists.
    If iDrawIcon Then
        If (iIconAlignment = ntIconAlignAtTop) Or (iIconAlignment = ntIconAlignAtBottom) Then
            If iIconWidthToShow > (iAreaRight - iAreaLeft) Then
                iIconWidthToShow = iAreaRight - iAreaLeft
            End If
        End If
    End If
    ' No caption, no gap to it - the same rule MeasureTabIconAndCaption applies to its own iIconGap,
    ' and it has to be the same answer or the reserved width and the drawn layout disagree.
    If iMeasureWidth = 0 Then
        iGap = 0
    Else
        iGap = mTabIconDistanceToCaptionDPIScaled
    End If
    
    ' How much width to take away from the caption's measurement/ellipsis, to leave room for a docked icon.
    ' Only the combinations where the icon is forced right next to the caption need this; in every
    ' other combination the caption is positioned independently of the icon (computed further below).
    iCapReserve = 0
    If iDrawIcon Then
        Select Case iIconAlignment
            Case ntIconAlignBeforeCaption, ntIconAlignAfterCaption
                iCapReserve = iIconWidthToShow + iGap
            Case ntIconAlignStart
                If mCaptionAlignment = ntAlignmentLeft Then iCapReserve = iIconWidthToShow + iGap
            Case ntIconAlignEnd
                If mCaptionAlignment = ntAlignmentRight Then iCapReserve = iIconWidthToShow + iGap
            Case ntIconAlignCenteredBeforeCaption
                If mCaptionAlignment = ntAlignmentLeft Then iCapReserve = iIconWidthToShow + iGap
            Case ntIconAlignCenteredAfterCaption
                If mCaptionAlignment = ntAlignmentRight Then iCapReserve = iIconWidthToShow + iGap
            Case ntIconAlignCenteredOnTab
                If mCaptionAlignment = ntAlignmentCenter Then iCapReserve = iIconWidthToShow + iGap
        End Select
    End If
    
    iMeasureRect.Left = iAreaLeft
    iMeasureRect.Right = iAreaRight - iCapReserve
    ' The docked icon's reserve comes out of an already collapsed band, so this is the one place the
    ' caption's rect can still end up inverted.
    If iMeasureRect.Right - iMeasureRect.Left < 8 Then iMeasureRect.Right = iMeasureRect.Left + 8
    iMeasureRect.Top = 0
    iMeasureRect.Bottom = iMeasureRect.Top + 5
    
    ' Calculate iMeasureRect again, without elipsis for WordWrap and with elipsis for single line, and without both text centering
    If mWordWrap Then
        iFlags = DT_CALCRECT Or DT_WORDBREAK
    Else
        iFlags = DT_CALCRECT Or DT_SINGLELINE Or DT_END_ELLIPSIS Or DT_MODIFYSTRING
    End If
    iCaption = iTabData.Caption & IIf(picDraw.Font.Italic, "  ", "")

    DrawTextW picDraw.hDC, StrPtr(iCaption & IIf(iFlags And DT_MODIFYSTRING, "    ", "")), IIf(iFlags And DT_MODIFYSTRING, Len(iCaption), -1), iMeasureRect, iFlags Or IIf(mRightToLeft, DT_RTLREADING, 0)
    iMeasureWidth = (iMeasureRect.Right - iMeasureRect.Left)
    iMeasureHeight = (iMeasureRect.Bottom - iMeasureRect.Top)
#If HORIZCAPTIONDIAG >= 1 Then ' TEMP diagnostic
    ' After the measurement that decides the wrap, so iMeasureHeight already says whether it
    ' broke: one line or two is the answer, not something to be inferred from the picture.
    ' 1 = horizontal captions on rotated tabs only, 2 = every orientation
#If HORIZCAPTIONDIAG = 2 Then
    If True Then
#Else
    If mTabsAreRotatedButCaptionsAreHorizontal Then
#End If
        If mHorizCaptionDiagCount < 200 Then
            mHorizCaptionDiagCount = mHorizCaptionDiagCount + 1
            Debug.Print "HCDIAG band padW="; mTabPaddingWidth; " padH="; mTabPaddingHeight; " capAlign="; mCaptionAlignment; " tab="; nTab; " caption="; iTabData.Caption; " selected="; iTabData.Selected
            Debug.Print "   tabRect L="; iTabRect.Left; " T="; iTabRect.Top; " R="; iTabRect.Right; " B="; iTabRect.Bottom; " (R-L="; iTabRect.Right - iTabRect.Left; " B-T="; iTabRect.Bottom - iTabRect.Top; ")"
            Debug.Print "   areaLeft="; iAreaLeft; " areaRight="; iAreaRight; " bandWidth="; iAreaRight - iAreaLeft; " capReserve="; iCapReserve; " measureRectWidth="; iAreaRight - iCapReserve - iAreaLeft
            Debug.Print "   iconAndCaptionWidth="; iTabData.IconAndCaptionWidth; " measureWidth="; iMeasureWidth; " measureHeight="; iMeasureHeight; " wordWrap="; mWordWrap
        End If
    End If
#End If
    
    ' With a caption the stacked pair is centred as a block - icon slot, gap and caption box - the
    ' way a caption alone is, so the selected tab lifts it as much as it lifts a caption. The slot
    ' is as tall as the tallest icon of the control, which keeps every caption on one line
    iStacked = ((iIconAlignment = ntIconAlignAtTop) Or (iIconAlignment = ntIconAlignAtBottom)) And (iTabData.Caption <> "")
    If iStacked Then
        iStackSlot = mStackedIconSlotHeight
        If mTabsAreRotatedButCaptionsAreHorizontal Or (iStackSlot < iIconHeight) Then iStackSlot = iIconHeight
        iStackFree = iCenterBandHeight - IIf(mTabsAreRotatedButCaptionsAreHorizontal, 0, iFlatBarHeightTop + iFlatBarHeightBottom)
        iStackGap = 0
        If iStackSlot > 0 Then iStackGap = StackedIconGap(iMeasureHeight)
        If (iStackSlot + iStackGap + iMeasureHeight) > iStackFree Then iStackGap = iStackFree - iStackSlot - iMeasureHeight
        If iStackGap < 0 Then iStackGap = 0
        iStackTop = iCenterBandTop + CenterOffset(iStackFree, iStackSlot + iStackGap + iMeasureHeight) + IIf(mTabsAreRotatedButCaptionsAreHorizontal, 0, iFlatBarHeightTop)
        If iIconAlignment = ntIconAlignAtTop Then
            iCaptionRect.Top = iStackTop + iStackSlot + iStackGap
        Else
            iCaptionRect.Top = iStackTop
        End If
    ElseIf (iIconAlignment = ntIconAlignAtBottom) Then
        iCaptionRect.Top = iTabRect.Top + mTabPaddingHeightDPIScaled
        If iTabSpaceRect.Top > iCaptionRect.Top Then iCaptionRect.Top = iTabSpaceRect.Top
        iCaptionRect.Top = iCaptionRect.Top + iFlatBarHeightTop
    ElseIf (iIconAlignment = ntIconAlignAtTop) Then
        iCaptionRect.Bottom = iTabRect.Bottom - mTabPaddingHeightDPIScaled
        If iTabSpaceRect.Bottom < iCaptionRect.Bottom Then iCaptionRect.Bottom = iTabSpaceRect.Bottom
        iCaptionRect.Bottom = iCaptionRect.Bottom - iFlatBarHeightBottom
        iCaptionRect.Top = iCaptionRect.Bottom - iMeasureHeight
    Else
        iCaptionRect.Top = iCenterBandTop + CenterOffset(iCenterBandHeight - IIf(mTabsAreRotatedButCaptionsAreHorizontal, 0, iFlatBarHeightTop + iFlatBarHeightBottom), iMeasureHeight) + IIf(mTabsAreRotatedButCaptionsAreHorizontal, 0, iFlatBarHeightTop)
    End If
    iCaptionRect.Bottom = iCaptionRect.Top + iMeasureHeight + 1
#If CAPTIONPOSDIAG = 1 Then ' TEMP diagnostic
    If mCaptionPosDiagCount < 200 Then
        mCaptionPosDiagCount = mCaptionPosDiagCount + 1
        Debug.Print "CAPPOS orient="; mTabOrientation; " pp="; mAppearanceIsPP; " flat="; mAppearanceIsFlat; " tab="; nTab; " sel="; iTabData.Selected; " caption="; iTabData.Caption
        Debug.Print "   tabRect T="; iTabRect.Top; " B="; iTabRect.Bottom; " (B-T="; iTabRect.Bottom - iTabRect.Top; ")  spaceRect T="; iTabSpaceRect.Top; " B="; iTabSpaceRect.Bottom; " spaceHeight="; iTabSpaceHeight; " bandTop="; iCenterBandTop; " bandHeight="; iCenterBandHeight
        Debug.Print "   measureHeight="; iMeasureHeight; " centerOffset="; CenterOffset(iCenterBandHeight - IIf(mTabsAreRotatedButCaptionsAreHorizontal, 0, iFlatBarHeightTop + iFlatBarHeightBottom), iMeasureHeight); " barTop="; iFlatBarHeightTop; " barBottom="; iFlatBarHeightBottom; " padH="; mTabPaddingHeightDPIScaled
        Debug.Print "   captionRect T="; iCaptionRect.Top; " B="; iCaptionRect.Bottom
    End If
#End If
    
    ' Default caption position (used as-is when there's no icon at all; overridden below when there is one)
    Select Case mCaptionAlignment
        Case ntAlignmentLeft
            iCapLeft = iAreaLeft
            iCapRight = iCapLeft + iMeasureWidth
        Case ntAlignmentRight
            iCapRight = iAreaRight
            iCapLeft = iCapRight - iMeasureWidth
        Case Else ' Center
            iCapLeft = iAreaLeft + CenterOffset(iAreaRight - iAreaLeft, iMeasureWidth)
            iCapRight = iCapLeft + iMeasureWidth
    End Select
    
    If iDrawIcon Then
        If iIconAlignment = ntIconAlignAtBottom Then
            iIconTop = (iCaptionRect.Bottom - iFlatBarHeightBottom + iTabSpaceRect.Bottom - iIconHeight) / 2
        ElseIf iIconAlignment = ntIconAlignAtTop Then
            iIconTop = (iTabSpaceRect.Top + iCaptionRect.Top - iIconHeight) / 2
        Else
            iIconTop = iCenterBandTop + CenterOffset(iCenterBandHeight - IIf(mTabsAreRotatedButCaptionsAreHorizontal, 0, iFlatBarHeightTop + iFlatBarHeightBottom), iIconHeightToShow) + IIf(mTabsAreRotatedButCaptionsAreHorizontal, 0, iFlatBarHeightTop)
        End If
        If iStacked Then
            If iIconAlignment = ntIconAlignAtTop Then
                iIconTop = iStackTop + (iStackSlot - iIconHeight) \ 2
            Else
                iIconTop = iCaptionRect.Top + iMeasureHeight + iStackGap + (iStackSlot - iIconHeight) \ 2
            End If
        End If
        ' The stacked pair is the only layout that places the icon from a computed position instead
        ' of centring it in the band, so it is the only one that can put the icon outside its own
        ' tab.
        If (iIconAlignment = ntIconAlignAtTop) Or (iIconAlignment = ntIconAlignAtBottom) Then
            If (iIconTop + iIconHeightToShow) > iTabSpaceRect.Bottom Then
                iIconTop = iTabSpaceRect.Bottom - iIconHeightToShow
            End If
            If iIconTop < iTabSpaceRect.Top Then
                iIconTop = iTabSpaceRect.Top
            End If
        End If
        
        ' Horizontal position of the icon AND the caption box, computed together. "Docked"
        ' combinations force the caption box to be exactly text-width and glued next to the icon.
        If iTabData.Caption <> "" Then
            Select Case iIconAlignment
                Case ntIconAlignBeforeCaption
                    Select Case mCaptionAlignment
                        Case ntAlignmentLeft
                            iIconLeft = iAreaLeft
                            iCapLeft = iIconLeft + iIconWidthToShow + iGap
                            iCapRight = iCapLeft + iMeasureWidth
                        Case ntAlignmentRight
                            iCapRight = iAreaRight
                            iCapLeft = iCapRight - iMeasureWidth
                            iIconLeft = iCapLeft - iGap - iIconWidthToShow
                        Case Else ' Center
                            iPairTotal = iIconWidthToShow + iGap + iMeasureWidth
                            iIconLeft = iAreaLeft + CenterOffset(iAreaRight - iAreaLeft, iPairTotal)
                            iCapLeft = iIconLeft + iIconWidthToShow + iGap
                            iCapRight = iCapLeft + iMeasureWidth
                    End Select
                Case ntIconAlignAfterCaption
                    Select Case mCaptionAlignment
                        Case ntAlignmentLeft
                            iCapLeft = iAreaLeft
                            iCapRight = iCapLeft + iMeasureWidth
                            iIconLeft = iCapRight + iGap
                        Case ntAlignmentRight
                            iIconLeft = iAreaRight - iIconWidthToShow
                            iCapRight = iIconLeft - iGap
                            iCapLeft = iCapRight - iMeasureWidth
                        Case Else ' Center
                            iPairTotal = iMeasureWidth + iGap + iIconWidthToShow
                            iCapLeft = iAreaLeft + CenterOffset(iAreaRight - iAreaLeft, iPairTotal)
                            iCapRight = iCapLeft + iMeasureWidth
                            iIconLeft = iCapRight + iGap
                    End Select
                Case ntIconAlignCenteredBeforeCaption
                    Select Case mCaptionAlignment
                        Case ntAlignmentLeft
                            iIconLeft = iAreaLeft
                            iCapLeft = iIconLeft + iIconWidthToShow + iGap
                            iCapRight = iCapLeft + iMeasureWidth
                        Case ntAlignmentRight
                            iCapRight = iAreaRight
                            iCapLeft = iCapRight - iMeasureWidth
                            If (iCapLeft - iAreaLeft) >= (iIconWidthToShow + iGap) * 2 Then
                                iIconLeft = iAreaLeft + CenterOffset(iCapLeft - iAreaLeft, iIconWidthToShow)
                            Else
                                ' Not generous enough to center the icon independently in the gap -
                                ' dock it right next to the caption so it doesn't look stranded.
                                iIconLeft = iCapLeft - iGap - iIconWidthToShow
                            End If
                        Case Else ' Center
                            ' Default: center the icon+caption pair as one block (like BeforeCaption
                            ' does), which is what looks right when the tab is sized to its content.
                            iPairTotal = iIconWidthToShow + iGap + iMeasureWidth
                            iCapLeft = iAreaLeft + CenterOffset(iAreaRight - iAreaLeft, iMeasureWidth)
                            If (iCapLeft - iAreaLeft) >= (iIconWidthToShow + iGap) * 2 Then
                                iCapRight = iCapLeft + iMeasureWidth
                                iIconLeft = iAreaLeft + CenterOffset(iCapLeft - iAreaLeft, iIconWidthToShow)
                            Else
                                iIconLeft = iAreaLeft + CenterOffset(iAreaRight - iAreaLeft, iPairTotal)
                                iCapLeft = iIconLeft + iIconWidthToShow + iGap
                                iCapRight = iCapLeft + iMeasureWidth
                            End If
                    End Select
                Case ntIconAlignCenteredAfterCaption
                    Select Case mCaptionAlignment
                        Case ntAlignmentRight
                            iIconLeft = iAreaRight - iIconWidthToShow
                            iCapRight = iIconLeft - iGap
                            iCapLeft = iCapRight - iMeasureWidth
                        Case ntAlignmentLeft
                            iCapLeft = iAreaLeft
                            iCapRight = iCapLeft + iMeasureWidth
                            If (iAreaRight - iCapRight) >= (iIconWidthToShow + iGap) * 2 Then
                                iIconLeft = iCapRight + CenterOffset(iAreaRight - iCapRight, iIconWidthToShow)
                            Else
                                iIconLeft = iCapRight + iGap
                            End If
                        Case Else ' Center
                            ' Mirror of CenteredBeforeCaption: default to the centered pair, only go
                            ' independent when the leftover on the icon's (right) side is generous.
                            iPairTotal = iMeasureWidth + iGap + iIconWidthToShow
                            iCapLeft = iAreaLeft + CenterOffset(iAreaRight - iAreaLeft, iMeasureWidth)
                            iCapRight = iCapLeft + iMeasureWidth
                            If (iAreaRight - iCapRight) >= (iIconWidthToShow + iGap) * 2 Then
                                iIconLeft = iCapRight + CenterOffset(iAreaRight - iCapRight, iIconWidthToShow)
                            Else
                                iCapLeft = iAreaLeft + CenterOffset(iAreaRight - iAreaLeft, iPairTotal)
                                iCapRight = iCapLeft + iMeasureWidth
                                iIconLeft = iCapRight + iGap
                            End If
                    End Select
                Case ntIconAlignStart
                    ' Straight onto the content edge, with no nudge of its own.
                    iIconLeft = iAreaLeft
                    Select Case mCaptionAlignment
                        Case ntAlignmentLeft
                            iCapLeft = iIconLeft + iIconWidthToShow + iGap
                            iCapRight = iCapLeft + iMeasureWidth
                        Case ntAlignmentRight
                            iCapRight = iAreaRight
                            iCapLeft = iCapRight - iMeasureWidth
                        Case Else ' Center: in the space left over after the icon's fixed slot, not
                                  ' the whole tab - the icon never moves, so there's no overlap risk
                                  ' either way, and no extra width needs to be reserved for it.
                            iLng = iIconLeft + iIconWidthToShow + iGap
                            iCapLeft = iLng + CenterOffset(iAreaRight - iLng, iMeasureWidth)
                            iCapRight = iCapLeft + iMeasureWidth
                    End Select
                Case ntIconAlignEnd
                    iIconLeft = iAreaRight - iIconWidthToShow
                    Select Case mCaptionAlignment
                        Case ntAlignmentRight
                            iCapRight = iIconLeft - iGap
                            iCapLeft = iCapRight - iMeasureWidth
                        Case ntAlignmentLeft
                            iCapLeft = iAreaLeft
                            iCapRight = iCapLeft + iMeasureWidth
                        Case Else ' Center: in the space left over before the icon's fixed slot (mirror
                                  ' of the Start case) - no overlap risk, no extra width to reserve.
                            iLng = iIconLeft - iGap
                            iCapLeft = iAreaLeft + CenterOffset(iLng - iAreaLeft, iMeasureWidth)
                            iCapRight = iCapLeft + iMeasureWidth
                    End Select
                Case ntIconAlignCenteredOnTab, ntIconAlignAtTop, ntIconAlignAtBottom
                    If (iIconAlignment = ntIconAlignCenteredOnTab) And (mCaptionAlignment = ntAlignmentCenter) Then
                        ' Prefer the icon truly centered on the tab, with the caption to its right -
                        ' that's what gives CenteredOnTab a distinct meaning from BeforeCaption.
                        iIconLeft = iAreaLeft + CenterOffset(iAreaRight - iAreaLeft, iIconWidthToShow)
                        iCapLeft = iIconLeft + iIconWidthToShow + iGap
                        iCapRight = iCapLeft + iMeasureWidth
                        If iCapRight > iAreaRight Then
                            iPairTotal = iIconWidthToShow + iGap + iMeasureWidth
                            iIconLeft = iAreaLeft + CenterOffset(iAreaRight - iAreaLeft, iPairTotal)
                            iCapLeft = iIconLeft + iIconWidthToShow + iGap
                            iCapRight = iCapLeft + iMeasureWidth
                        End If
                    Else
                        ' The icon is always centered horizontally regardless of CaptionAlignment; the
                        ' caption is positioned independently and may overlap the icon (left as is for now).
                        iIconLeft = (iAreaRight + iAreaLeft - iIconWidthToShow) / 2
                        Select Case mCaptionAlignment
                            Case ntAlignmentLeft
                                iCapLeft = iAreaLeft
                                iCapRight = iCapLeft + iMeasureWidth
                            Case ntAlignmentRight
                                iCapRight = iAreaRight
                                iCapLeft = iCapRight - iMeasureWidth
                            Case Else ' Center
                                iCapLeft = iAreaLeft + CenterOffset(iAreaRight - iAreaLeft, iMeasureWidth)
                                iCapRight = iCapLeft + iMeasureWidth
                        End Select
                    End If
            End Select
        Else
            ' No caption: just center the icon as before, per its own alignment concept.
            ' (iCapLeft/iCapRight keep the default computed above; it's irrelevant since there's no text.)
            Select Case iIconAlignment
                Case ntIconAlignStart
                    iIconLeft = iAreaLeft
                Case ntIconAlignEnd
                    iIconLeft = iAreaRight - iIconWidthToShow
                Case Else
                    iIconLeft = (iAreaRight + iAreaLeft - iIconWidthToShow) / 2
            End Select
        End If
        ' Clamped to the content band, the same one the caption and the close button are placed in.
        If iIconLeft < iAreaLeft Then
            iIconLeft = iAreaLeft
        End If
        If (iIconLeft + iIconWidthToShow) > iAreaRight Then
            iIconLeft = iAreaRight - iIconWidthToShow
        End If
#If NEWTABBUTTONDIAG = 1 Then ' TEMP diagnostic
        ' After the clamp, so this is where the glyph really goes. picWidthToShow is a CROP,
        ' not a destination width: a font glyph keeps its ink and gets centred in a box of
        ' that width, so picWidthToShow < picWidth is what a '+' losing its arms looks like
        If iTabData.IsNewTabButton Then
            If mNewTabButtonDiagCount < 200 Then
                mNewTabButtonDiagCount = mNewTabButtonDiagCount + 1
                Debug.Print "NTBDIAG draw padW="; mTabPaddingWidth; " capAlign="; mCaptionAlignment; " align="; iIconAlignment
                Debug.Print "   tabRect L="; iTabRect.Left; " R="; iTabRect.Right; " width="; iTabRect.Right - iTabRect.Left + 1; " tabSpaceWidth="; iTabSpaceWidth
                Debug.Print "   areaLeft="; iAreaLeft; " areaRight="; iAreaRight; " band="; iAreaRight - iAreaLeft; " picWidth="; iIconWidth; " picWidthToShow="; iIconWidthToShow; " picLeft="; iIconLeft
                Debug.Print "   measureWidth="; iMeasureWidth; " iconAndCaptionWidth="; iTabData.IconAndCaptionWidth
            End If
        End If
#End If
#If STACKEDICONDIAG = 1 Then ' TEMP diagnostic
        ' After the clamp, so what is printed is where the icon really goes and not where it
        ' would have gone. iIconWidth is what DT_CALCRECT reported; iIconWidthToShow is that after
        ' the shrinking rules; iIconLeft is the left edge finally used
        If (iIconAlignment = ntIconAlignAtTop) Or (iIconAlignment = ntIconAlignAtBottom) Then
            If mStackedIconDiagCount < 200 Then
                mStackedIconDiagCount = mStackedIconDiagCount + 1
                Debug.Print "SIDIAG draw tab="; nTab; " caption="; iTabData.Caption; " tabRect L="; iTabRect.Left; " R="; iTabRect.Right; " width="; iTabRect.Right - iTabRect.Left + 1
                Debug.Print "   areaLeft="; iAreaLeft; " areaRight="; iAreaRight; " band="; iAreaRight - iAreaLeft; " picWidth="; iIconWidth; " picWidthToShow="; iIconWidthToShow; " picLeft="; iIconLeft
                Debug.Print "   measureWidth="; iMeasureWidth; " capLeft="; iCapLeft; " capRight="; iCapRight; " iconAndCaptionWidth="; iTabData.IconAndCaptionWidth
            End If
        End If
#End If
        
        If iIconHeightToShow >= iIconHeight Then
            iIconSourceShiftY = 0
        Else
            iIconSourceShiftY = (iIconHeight - iIconHeightToShow) / 2
        End If
        If iIconWidthToShow >= iIconWidth Then
            iIconSourceShiftX = 0
        Else
            iIconSourceShiftX = (iIconWidth - iIconWidthToShow) / 2
        End If
        
        If iIconWidth < 1 Then iIconWidth = 1
        If iIconHeight < 1 Then iIconHeight = 1
        
        ' draw the icon
        If iIconCharacter <> "" Then
            iFlags = DT_SINGLELINE Or DT_CENTER
            Set iFontPrev = picDraw.Font
            Set picDraw.Font = iIconFont
            iForeColorPrev = picDraw.ForeColor
            picDraw.ForeColor = iIconColor
            iLng = ((iTabRect.Bottom - iTabRect.Top) - (iIconCharRect.Bottom - iIconCharRect.Top)) / 2
            ' The Centered* alignments position the icon precisely via iIconLeft; IconLeftOffset is a
            ' fine-tuning nudge meant for the docked alignments (Before/After/Start/End), so
            ' applying it here too would shove the glyph off its computed spot and into the caption.
            Select Case iIconAlignment
                Case ntIconAlignCenteredBeforeCaption, ntIconAlignCenteredAfterCaption, ntIconAlignCenteredOnTab
                    iIconCharRect.Left = iIconLeft
                    iIconCharRect.Right = iIconLeft + iIconWidth
                Case Else
                    iIconCharRect.Left = iIconLeft + iTabData.IconLeftOffset * mDPIScale
                    iIconCharRect.Right = iIconLeft + iTabData.IconLeftOffset * mDPIScale + iIconWidth
            End Select
            iIconCharRect.Top = iIconTop + iTabData.IconTopOffset * mDPIScale
            iIconCharRect.Bottom = iIconTop + iTabData.IconTopOffset * mDPIScale + iIconHeight + 1
            ' iIconAlignment and not mIconAlignment, the same local the Select Case above reads:
            ' these two branches have to name the edge iIconLeft was actually computed against.
            If (iIconAlignment = ntIconAlignAfterCaption) Or (iIconAlignment = ntIconAlignCenteredAfterCaption) Or (iIconAlignment = ntIconAlignEnd) Then
                ' The 4 and the 5 these two used to carry were the padding written yet again, the 4
                ' being the 5 with the inclusive rect's one less.
                If iIconCharRect.Right > iAreaRight Then
                    iLng = iIconCharRect.Right - iAreaRight
                    iIconCharRect.Left = iIconCharRect.Left - iLng
                    iIconCharRect.Right = iIconCharRect.Right - iLng
                End If
            ElseIf (iIconAlignment = ntIconAlignBeforeCaption) Or (iIconAlignment = ntIconAlignCenteredBeforeCaption) Or (iIconAlignment = ntIconAlignStart) Then
                If iIconCharRect.Left < iAreaLeft Then
                    iLng = iAreaLeft - iIconCharRect.Left
                    iIconCharRect.Left = iIconCharRect.Left + iLng
                    iIconCharRect.Right = iIconCharRect.Right + iLng
                End If
            End If
            If (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Or (mTabOrientation = ssTabOrientationRight) Or (mTabOrientation = ntTabOrientationRightBottom) Then
                If mRightToLeft Then
                    ' the world transform composed with the mirrored DC layout does not render the
                    ' glyph (RTL mirroring is internally a reflection in the world transform, and
                    ' SetWorldTransform under GM_ADVANCED tramples it), so draw the glyph with the
                    ' mirroring temporarily disabled, at an explicitly mirrored position.
                    iPrevLayoutWnd = GetLayout(GetDC(picDraw.hWnd))
                    iPrevLayoutDC = GetLayout(picDraw.hDC)
                    SetLayout GetDC(picDraw.hWnd), 0
                    SetLayout picDraw.hDC, 0
                    iLng = iIconCharRect.Left
                    iIconCharRect.Left = picDraw.ScaleWidth - iIconCharRect.Right
                    iIconCharRect.Right = picDraw.ScaleWidth - iLng
                End If
                iGMPrev2 = SetGraphicsMode(picDraw.hDC, GM_ADVANCED)
                GetWorldTransform picDraw.hDC, iTx2Prev
                ' under RTL the final image rotation direction is swapped, so the glyph
                ' pre-rotation matrix that compensates it swaps between the two branches too
                If (((mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop)) And (Not mRightToLeft)) Or (((mTabOrientation = ssTabOrientationRight) Or (mTabOrientation = ntTabOrientationRightBottom)) And mRightToLeft) Then
                    iTx2.eM11 = 0
                    iTx2.eM12 = 1
                    iTx2.eM21 = -1
                    iTx2.eM22 = 0
                    iTx2.eDx = (iIconCharRect.Left + iIconCharRect.Right) / 2 + iIconWidth / 2
                    iTx2.eDy = (iIconCharRect.Top + iIconCharRect.Bottom) / 2 - iIconHeight / 2
                    iAuxRect = iIconCharRect
                    iIconCharRect.Left = 0
                    iIconCharRect.Top = 0
                    iIconCharRect.Right = iIconHeight
                    iIconCharRect.Bottom = iIconWidth + 1
                Else
                    iTx2.eM11 = 0
                    iTx2.eM12 = -1
                    iTx2.eM21 = 1
                    iTx2.eM22 = 0
                    iTx2.eDx = (iIconCharRect.Left + iIconCharRect.Right) / 2 - iIconWidth / 2
                    iTx2.eDy = (iIconCharRect.Top + iIconCharRect.Bottom) / 2 + iIconHeight / 2
                    iAuxRect = iIconCharRect
                    iIconCharRect.Left = 0
                    iIconCharRect.Top = 0
                    iIconCharRect.Right = iIconHeight
                    iIconCharRect.Bottom = iIconWidth + 1
                End If
                SetWorldTransform picDraw.hDC, iTx2
            End If
            ' the rect is in the glyph's own upright frame here, turned or not
            iInkShift = 0
            If iTabData.IsNewTabButton Then
                Set picAuxIconFont.Font = iIconFont
                If GlyphInkTopFromCenter(picAuxIconFont.hDC, iTabData.IconChar, iInkTopFromCenter) Then iInkShift = (iIconCharRect.Bottom - iIconCharRect.Top - 1) \ 2 + iInkTopFromCenter
            End If
            iIconCharRect.Top = iIconCharRect.Top + iInkShift
            iIconCharRect.Bottom = iIconCharRect.Bottom + iInkShift
            iDrawnInColor = False
            If iTabData.IconInColor Then
                If Not TabForeIsDrawnDisabled(nTab) Then
                    Set picAuxIconFont.Font = iIconFont
                    iDrawnInColor = DrawIconGlyphInColor(iIconCharRect, iTabData.IconChar, iIconColor, (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Or (mTabOrientation = ssTabOrientationRight) Or (mTabOrientation = ntTabOrientationRightBottom), iTx2)
                End If
            End If
            If Not iDrawnInColor Then DrawTextW picDraw.hDC, StrPtr(iIconCharacter), -1, iIconCharRect, iFlags Or IIf(mRightToLeft, DT_RTLREADING, 0)
            iIconCharRect.Top = iIconCharRect.Top - iInkShift
            iIconCharRect.Bottom = iIconCharRect.Bottom - iInkShift
            If (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Or (mTabOrientation = ssTabOrientationRight) Or (mTabOrientation = ntTabOrientationRightBottom) Then
                SetWorldTransform picDraw.hDC, iTx2Prev
                SetGraphicsMode picDraw.hDC, iGMPrev2
                iIconCharRect = iAuxRect
                If mRightToLeft Then
                    SetLayout GetDC(picDraw.hWnd), iPrevLayoutWnd
                    SetLayout picDraw.hDC, iPrevLayoutDC
                    ' undo the rect mirroring done above (iAuxRect captured the mirrored values)
                    iLng = iIconCharRect.Left
                    iIconCharRect.Left = picDraw.ScaleWidth - iIconCharRect.Right
                    iIconCharRect.Right = picDraw.ScaleWidth - iLng
                End If
            End If
            mTabData(nTab).IconRect = iIconCharRect
            Set picDraw.Font = iFontPrev
            picDraw.ForeColor = iForeColorPrev
        Else
            If mRightToLeft Then
                ' On picDraw.hDC and not on GetDC(picDraw.hWnd): with AutoRedraw they are two different
                ' DCs and every drawing call lands on picDraw.hDC. The window DC is where the RTL layout
                ' is established (see SetScaleMode): the buffer VB6 rebuilds on resize inherits it from there
                SetLayout picDraw.hDC, LAYOUT_RTL Or LAYOUT_BITMAPORIENTATIONPRESERVED
            End If
            ' An icon does not go through PaintPicture.
            If iAuxPicture.Type = vbPicTypeIcon Then
                DrawIconClipped picDraw.hDC, iAuxPicture.Handle, iIconLeft, iIconTop, iIconWidthToShow, iIconHeightToShow, iIconWidth, iIconHeight, iIconSourceShiftX, iIconSourceShiftY
            ElseIf iAuxPicture.Type = vbPicTypeBitmap And mUseMaskColor Then
                Call DrawImage(picDraw.hDC, iAuxPicture.Handle, TranslatedColor(mMaskColor), iIconLeft, iIconTop, iIconWidthToShow, iIconHeightToShow, iIconSourceShiftX, iIconSourceShiftY)
            Else
                picDraw.PaintPicture iAuxPicture, iIconLeft, iIconTop, iIconWidthToShow, iIconHeightToShow, iIconSourceShiftX, iIconSourceShiftY, iIconWidthToShow, iIconHeightToShow
            End If
            If mRightToLeft Then
                ' Same DC as above. Bottom and the four Horizontal paste a pre-unmirrored image back and
                ' count on this DC mirroring it again, so LAYOUT_BITMAPORIENTATIONPRESERVED cannot stay set
                SetLayout picDraw.hDC, LAYOUT_RTL
            End If
        End If
    End If
    iCaptionRect.Left = iCapLeft
    iCaptionRect.Right = iCapRight
    'Now draw the text
    If mWordWrap Then
        iFlags = DT_WORDBREAK Or DT_END_ELLIPSIS Or DT_MODIFYSTRING Or mAlignmentDTFlag
    Else
        iFlags = DT_SINGLELINE Or DT_END_ELLIPSIS Or DT_MODIFYSTRING Or mAlignmentDTFlag Or DT_VCENTER
    End If
    
    iCaption = iTabData.Caption
    If iCaptionRect.Bottom > iTabRect.Bottom Then
        iCaptionRect.Bottom = iTabRect.Bottom
    End If
    picDraw.ForeColor = iForeColor2
    ' Back to the weight this tab really shows, now that everything that measures has run
    picDraw.FontBold = iCaptionBoldToDraw
    If iCaptionRect.Right - iCaptionRect.Left < 8 Then iCaptionRect.Right = iCaptionRect.Left + 8 ' protection, because this API crashes the program in this case
    
    DrawTextW picDraw.hDC, StrPtr(iCaption & IIf(iFlags And DT_MODIFYSTRING, "    ", "")), IIf(iFlags And DT_MODIFYSTRING, Len(iCaption), -1), iCaptionRect, iFlags Or IIf(mRightToLeft, DT_RTLREADING, 0)
    
    ' Draw the focus rect
    If mAmbientUserMode Then    'only at run time
        If (iActive) And ControlHasFocus And mShowFocusRect Then
            If mAppearanceIsPP Then
                iFocusRect = iTabRect
                iFocusRect.Left = iFocusRect.Left + 3
                iFocusRect.Top = iFocusRect.Top + 4
                iFocusRect.Right = iFocusRect.Right - 2
                If (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Then
                    iFocusRect.Left = iFocusRect.Left + 1
                    iFocusRect.Right = iFocusRect.Right + 1
                End If
            Else
                iFocusRect.Left = (iCaptionRect.Left + iCaptionRect.Right) / 2 - iMeasureWidth / 2 - 2
                iFocusRect.Right = iFocusRect.Left + iMeasureWidth + 3
                iFocusRect.Top = iCaptionRect.Top - 1
                iFocusRect.Bottom = iFocusRect.Top + iMeasureHeight + 2
            End If
            picDraw.ForeColor = iForeColor
            If mAppearanceIsPP Then
                iFocusRect.Top = iFocusRect.Top - 1
                iFocusRect.Bottom = iFocusRect.Bottom - 1
            End If
            
            If iFocusRect.Right > (iTabSpaceRect.Right) Then
                iFocusRect.Right = iTabSpaceRect.Right
            End If
            If iFocusRect.Left < (iTabSpaceRect.Left + 1) Then
                iFocusRect.Left = iTabSpaceRect.Left + 1
            End If
            If iFocusRect.Bottom > (iTabSpaceRect.Bottom) Then
                iFocusRect.Bottom = iTabSpaceRect.Bottom
            End If
            If iFocusRect.Top < (iTabSpaceRect.Top + 1) Then
                iFocusRect.Top = iTabSpaceRect.Top + 1
            End If
            
            Call DrawFocusRect(picDraw.hDC, iFocusRect)
        End If
    End If

    If picDraw.FontBold <> iFontBoldPrev Then
        picDraw.FontBold = iFontBoldPrev
    End If
End Sub


Private Function RotateRect90Degrees(nRect As RECT, Optional nCCW As Boolean, Optional nCenterX As Variant, Optional nCenterY As Variant) As RECT
    Dim iCenterX As Single
    Dim iCenterY As Single
    Const pi = 3.141592654
    Dim iAngleInRadians As Single
    Dim iCos As Single
    Dim iSin As Single
    
    If nCCW Then
        iAngleInRadians = -90 * pi / 180
    Else
        iAngleInRadians = 90 * pi / 180
    End If
    iCos = Cos(iAngleInRadians)
    iSin = sIn(iAngleInRadians)
    
    If IsMissing(nCenterX) Then nCenterX = (nRect.Left + nRect.Right) / 2
    If IsMissing(nCenterY) Then nCenterY = (nRect.Top + nRect.Bottom) / 2
    iCenterX = CSng(nCenterX)
    iCenterY = CSng(nCenterY)
    
    RotateRect90Degrees.Left = (nRect.Left - iCenterX) * iCos - (nRect.Top - iCenterY) * iSin + iCenterX
    RotateRect90Degrees.Bottom = (nRect.Left - iCenterX) * iSin + (nRect.Top - iCenterY) * iCos + iCenterY
    
    RotateRect90Degrees.Right = (nRect.Right - iCenterX) * iCos - (nRect.Bottom - iCenterY) * iSin + iCenterX
    RotateRect90Degrees.Top = (nRect.Right - iCenterX) * iSin + (nRect.Bottom - iCenterY) * iCos + iCenterY
End Function

' The following procedure was taken from http://www.planet-source-code.com/vb/scripts/ShowCode.asp?txtCodeId=56462&lngWId=1
' Kinda over-riden function for pFillCurvedGradientR, performs same job,
' but takes integers instead of Rect as parameter
Private Sub FillCurvedGradient(ByVal lLeft As Long, ByVal lTop As Long, ByVal lRight As Long, ByVal lBottom As Long, ByVal lStartColor As Long, ByVal lEndColor As Long, Optional ByVal iCurveValue As Long = -1, Optional bCurveLeft As Boolean = False, Optional bCurveRight As Boolean = False)
    Dim utRect As RECT
    
    utRect.Left = lLeft
    utRect.Top = lTop
    utRect.Right = lRight
    utRect.Bottom = lBottom
    
    If utRect.Bottom - utRect.Top > 0 Then Call FillCurvedGradientR(utRect, lStartColor, lEndColor, iCurveValue, bCurveLeft, bCurveRight)
End Sub

' The following procedure was taken from http://www.planet-source-code.com/vb/scripts/ShowCode.asp?txtCodeId=56462&lngWId=1
' function used to Fill a rectangular area by Gradient
' This function can draw using the curve value to generate a rounded rect kinda effect
Private Sub FillCurvedGradientR(utRect As RECT, ByVal lStartColor As Long, ByVal lEndColor As Long, Optional ByVal iCurveValue As Long = -1, Optional bCurveLeft As Boolean = False, Optional bCurveRight As Boolean = False)

    Dim sngRedInc As Single, sngGreenInc As Single, sngBlueInc As Single
    Dim sngRed As Single, sngGreen As Single, sngBlue As Single
    
    lStartColor = TranslatedColor(lStartColor)
    lEndColor = TranslatedColor(lEndColor)

    Dim intCnt As Integer
    
    sngRed = GetRedValue(lStartColor)
    sngGreen = GetGreenValue(lStartColor)
    sngBlue = GetBlueValue(lStartColor)
    
    sngRedInc = (GetRedValue(lEndColor) - sngRed) / (utRect.Bottom - utRect.Top)
    sngGreenInc = (GetGreenValue(lEndColor) - sngGreen) / (utRect.Bottom - utRect.Top)
    sngBlueInc = (GetBlueValue(lEndColor) - sngBlue) / (utRect.Bottom - utRect.Top)

    If sngRed > 255 Then sngRed = 255
    If sngGreen > 255 Then sngGreen = 255
    If sngBlue > 255 Then sngBlue = 255
    If sngRed < 0 Then sngRed = 0
    If sngGreen < 0 Then sngGreen = 0
    If sngBlue < 0 Then sngBlue = 0

    If iCurveValue < 1 Then
        For intCnt = utRect.Top To utRect.Bottom
            picDraw.Line (utRect.Left, intCnt)-(utRect.Right, intCnt), RGB(sngRed, sngGreen, sngBlue)
            sngRed = sngRed + sngRedInc
            sngGreen = sngGreen + sngGreenInc
            sngBlue = sngBlue + sngBlueInc
            
            If sngRed > 255 Then sngRed = 255
            If sngGreen > 255 Then sngGreen = 255
            If sngBlue > 255 Then sngBlue = 255
            If sngRed < 0 Then sngRed = 0
            If sngGreen < 0 Then sngGreen = 0
            If sngBlue < 0 Then sngBlue = 0
        Next
    Else
        If bCurveLeft And bCurveRight Then
            For intCnt = utRect.Top To utRect.Bottom
                picDraw.Line (utRect.Left + iCurveValue + 1, intCnt)-(utRect.Right - iCurveValue, intCnt), RGB(sngRed, sngGreen, sngBlue)
                sngRed = sngRed + sngRedInc
                sngGreen = sngGreen + sngGreenInc
                sngBlue = sngBlue + sngBlueInc

                If sngRed > 255 Then sngRed = 255
                If sngGreen > 255 Then sngGreen = 255
                If sngBlue > 255 Then sngBlue = 255
                If sngRed < 0 Then sngRed = 0
                If sngGreen < 0 Then sngGreen = 0
                If sngBlue < 0 Then sngBlue = 0

                If iCurveValue > 0 Then
                    iCurveValue = iCurveValue - 1
                End If
            Next
        ElseIf bCurveLeft Then
            For intCnt = utRect.Top To utRect.Bottom
                picDraw.Line (utRect.Left + iCurveValue + 1, intCnt)-(utRect.Right, intCnt), RGB(sngRed, sngGreen, sngBlue)

                sngRed = sngRed + sngRedInc
                sngGreen = sngGreen + sngGreenInc
                sngBlue = sngBlue + sngBlueInc

                If sngRed > 255 Then sngRed = 255
                If sngGreen > 255 Then sngGreen = 255
                If sngBlue > 255 Then sngBlue = 255
                If sngRed < 0 Then sngRed = 0
                If sngGreen < 0 Then sngGreen = 0
                If sngBlue < 0 Then sngBlue = 0

                If iCurveValue > 0 Then
                    iCurveValue = iCurveValue - 1
                End If
            Next
        Else    'curve right
            For intCnt = utRect.Top To utRect.Bottom
                picDraw.Line (utRect.Left, intCnt)-(utRect.Right - iCurveValue, intCnt), RGB(sngRed, sngGreen, sngBlue)

                sngRed = sngRed + sngRedInc
                sngGreen = sngGreen + sngGreenInc
                sngBlue = sngBlue + sngBlueInc
                
                If sngRed > 255 Then sngRed = 255
                If sngGreen > 255 Then sngGreen = 255
                If sngBlue > 255 Then sngBlue = 255
                If sngRed < 0 Then sngRed = 0
                If sngGreen < 0 Then sngGreen = 0
                If sngBlue < 0 Then sngBlue = 0
                
                If iCurveValue > 0 Then
                    iCurveValue = iCurveValue - 1
                End If
            Next
        End If
    End If
End Sub

Private Sub FillCurvedGradient2(ByVal nLeft As Long, ByVal nTop As Long, ByVal nRight As Long, ByVal nBottom As Long, ByVal nStartColor As Long, ByVal nEndColor As Long, ByVal nCurveTopLeft As Long, ByVal nCurveTopRight As Long, Optional ByVal nCurveBottomLeft As Long, Optional ByVal nCurveBottomRight As Long)
    Dim sngRedInc As Single, sngGreenInc As Single, sngBlueInc As Single
    Dim sngRed As Single, sngGreen As Single, sngBlue As Single
    Dim iCurvPixelsTopY As Long
    Dim iCurvPixelsBottomY As Long
    Dim iCurvPixelsXLeft As Single
    Dim iCurvPixelsXRight As Single
    Dim iCurvPixelsXLeftInt As Long
    Dim iCurvPixelsXRightInt As Long
    Dim iX As Long
    Dim iY As Long
    Dim iDistance As Single
    Dim iCol As Long
    Dim iIsSolid As Boolean
    Dim iUseFastFill As Boolean
    Dim iDrawDC As LongPtr
#If SOLIDFILLDIAG = 1 Then ' TEMP diagnostic
    Dim iSFCallStart As Currency
    Dim iSFCallEnd As Currency
#End If
    
    If (nBottom - nTop) <= 0 Then Exit Sub
    If (nRight - nLeft) <= 0 Then Exit Sub
#If SOLIDFILLDIAG = 1 Then ' TEMP diagnostic
    ' After the two guards on purpose: an early exit then has nothing to accumulate, and the
    ' routine is left with a single place that closes the stopwatch
    QueryPerformanceCounter iSFCallStart
#End If
    
    ' Once per call. Only the antialiasing of the corners uses it, but that is per pixel,
    ' and picDraw.hDC is a property fetch and not a variable
    iDrawDC = picDraw.hDC
    
    nStartColor = TranslatedColor(nStartColor)
    nEndColor = TranslatedColor(nEndColor)
    
    sngRed = GetRedValue(nStartColor)
    sngGreen = GetGreenValue(nStartColor)
    sngBlue = GetBlueValue(nStartColor)
    
    sngRedInc = (GetRedValue(nEndColor) - sngRed) / (nBottom - nTop)
    sngGreenInc = (GetGreenValue(nEndColor) - sngGreen) / (nBottom - nTop)
    sngBlueInc = (GetBlueValue(nEndColor) - sngBlue) / (nBottom - nTop)
    
    ' A run whose three increments are zero is one flat colour, and that is the only case the box
    ' below is allowed to replace: the accumulators are carried from one loop into the next inside
    ' the curved branch, and with a zero increment a skipped loop leaves them where the loop would
    ' have.
    iIsSolid = (sngRedInc = 0) And (sngGreenInc = 0) And (sngBlueInc = 0)
    iUseFastFill = iIsSolid
#If SOLIDFILLDIAG = 1 Then ' TEMP diagnostic
    If iIsSolid Then
        mSolidFillCalls = mSolidFillCalls + 1
    Else
        mGradFillCalls = mGradFillCalls + 1
    End If
#End If

    If sngRed > 255 Then sngRed = 255
    If sngGreen > 255 Then sngGreen = 255
    If sngBlue > 255 Then sngBlue = 255
    If sngRed < 0 Then sngRed = 0
    If sngGreen < 0 Then sngGreen = 0
    If sngBlue < 0 Then sngBlue = 0
    
    If (nCurveTopLeft < 1) And (nCurveTopRight < 1) And (nCurveBottomLeft < 1) And (nCurveBottomRight < 1) Then
#If SOLIDFILLDIAG = 1 Then ' TEMP diagnostic
        If iIsSolid Then
            mSolidFillLines = mSolidFillLines + (nBottom - nTop)
        Else
            mGradFillLines = mGradFillLines + (nBottom - nTop)
        End If
#End If
        If iUseFastFill Then
            ' nRight - 1: plain Line excludes its end point and Line ... BF includes both corners;
            ' without it the box eats the pixel of separation between neighbouring tabs.
            ' BF and not FillRect: no brush to manage, and it follows the RightToLeft mirroring
            picDraw.Line (nLeft, nTop)-(nRight - 1, nBottom - 1), RGB(sngRed, sngGreen, sngBlue), BF
        Else
            For iY = nTop To nBottom - 1
                picDraw.Line (nLeft, iY)-(nRight, iY), RGB(sngRed, sngGreen, sngBlue)
                sngRed = sngRed + sngRedInc
                sngGreen = sngGreen + sngGreenInc
                sngBlue = sngBlue + sngBlueInc
                
                If sngRed > 255 Then sngRed = 255
                If sngGreen > 255 Then sngGreen = 255
                If sngBlue > 255 Then sngBlue = 255
                If sngRed < 0 Then sngRed = 0
                If sngGreen < 0 Then sngGreen = 0
                If sngBlue < 0 Then sngBlue = 0
            Next
        End If
    Else
        If nCurveTopLeft > nCurveTopRight Then
            iCurvPixelsTopY = nCurveTopLeft
        Else
            iCurvPixelsTopY = nCurveTopRight
        End If
        If iCurvPixelsTopY > (nBottom - nTop) Then
            iCurvPixelsTopY = (nBottom - nTop)
        End If
        For iY = nTop To nTop + iCurvPixelsTopY - 1
            If (iY - nTop) <= nCurveTopLeft Then
                iCurvPixelsXLeft = nCurveTopLeft - Sqr(nCurveTopLeft ^ 2 - (nCurveTopLeft - iY + nTop) ^ 2)
                iCurvPixelsXLeftInt = Round(iCurvPixelsXLeft) + 1
            Else
                iCurvPixelsXLeft = 0
                iCurvPixelsXLeftInt = 0
            End If
            If (iY - nTop) <= nCurveTopRight Then
                iCurvPixelsXRight = nCurveTopRight - Sqr(nCurveTopRight ^ 2 - (nCurveTopRight - iY + nTop) ^ 2)
                iCurvPixelsXRightInt = Round(iCurvPixelsXRight) + 1
            Else
                iCurvPixelsXRight = 0
                iCurvPixelsXRightInt = 0
            End If
            
            iCol = RGB(sngRed, sngGreen, sngBlue)
            If (iCurvPixelsXLeftInt > 0) Or (iCurvPixelsXRightInt > 0) Then
                picDraw.Line (nLeft + iCurvPixelsXLeftInt, iY)-(nRight - iCurvPixelsXRightInt, iY), iCol
                If iCurvPixelsXLeftInt > 0 Then
                    For iX = iCurvPixelsXLeftInt - 1 To iCurvPixelsXLeftInt \ 2 - 1 Step -1
                        If iX < 0 Then Exit For
                        iDistance = nCurveTopLeft - (Sqr((nCurveTopLeft - iX) ^ 2 + (nCurveTopLeft - iY + nTop) ^ 2))
                        If iDistance > 0 Then iDistance = 0
                        If iDistance > -1 Then
                            iDistance = (1 - Abs(iDistance)) * 100
                            AAQueuePixel nLeft + iX, iY, iCol, iDistance
                        End If
                    Next
                End If
                If iCurvPixelsXRightInt > 0 Then
                    For iX = iCurvPixelsXRightInt - 1 To iCurvPixelsXRightInt \ 2 - 1 Step -1
                        If iX < 0 Then Exit For
                        iDistance = nCurveTopRight - (Sqr((nCurveTopRight - iX) ^ 2 + (nCurveTopRight - iY + nTop) ^ 2))
                        If iDistance > 0 Then iDistance = 0
                        If iDistance > -1 Then
                            iDistance = (1 - Abs(iDistance)) * 100
                            AAQueuePixel nRight - iX - 1, iY, iCol, iDistance
                        End If
                    Next
                End If
            Else
                picDraw.Line (nLeft + iCurvPixelsXLeftInt, iY)-(nRight - iCurvPixelsXRightInt, iY), iCol
            End If
            sngRed = sngRed + sngRedInc
            sngGreen = sngGreen + sngGreenInc
            sngBlue = sngBlue + sngBlueInc
            
            If sngRed > 255 Then sngRed = 255
            If sngGreen > 255 Then sngGreen = 255
            If sngBlue > 255 Then sngBlue = 255
            If sngRed < 0 Then sngRed = 0
            If sngGreen < 0 Then sngGreen = 0
            If sngBlue < 0 Then sngBlue = 0
        Next
        
        ' The top strip is finished, so its antialiasing can go to the surface in one block
        AAFlushPixels iDrawDC
        
        If nCurveBottomLeft > nCurveBottomRight Then
            iCurvPixelsBottomY = nCurveBottomLeft
        Else
            iCurvPixelsBottomY = nCurveBottomRight
        End If
        If iCurvPixelsBottomY > (nBottom - (nTop + iCurvPixelsTopY)) Then
            iCurvPixelsBottomY = (nBottom - (nTop + iCurvPixelsTopY))
        End If
        
#If SOLIDFILLDIAG = 1 Then ' TEMP diagnostic
        If (nBottom - iCurvPixelsBottomY) > (nTop + iCurvPixelsTopY) Then
            If iIsSolid Then
                mSolidFillLines = mSolidFillLines + (nBottom - iCurvPixelsBottomY) - (nTop + iCurvPixelsTopY)
            Else
                mGradFillLines = mGradFillLines + (nBottom - iCurvPixelsBottomY) - (nTop + iCurvPixelsTopY)
            End If
        End If
#End If
        If iUseFastFill Then
            ' Same nRight - 1 as the branch above, for the same measured reason
            ' The guard is not decoration: an empty range makes the For below do nothing, while
            ' a box with its corners crossed would still paint something
            If (nBottom - 1 - iCurvPixelsBottomY) >= (nTop + iCurvPixelsTopY) Then
                picDraw.Line (nLeft, nTop + iCurvPixelsTopY)-(nRight - 1, nBottom - 1 - iCurvPixelsBottomY), RGB(sngRed, sngGreen, sngBlue), BF
            End If
        Else
            For iY = nTop + iCurvPixelsTopY To nBottom - 1 - iCurvPixelsBottomY
                picDraw.Line (nLeft, iY)-(nRight, iY), RGB(sngRed, sngGreen, sngBlue)
                sngRed = sngRed + sngRedInc
                sngGreen = sngGreen + sngGreenInc
                sngBlue = sngBlue + sngBlueInc
                
                If sngRed > 255 Then sngRed = 255
                If sngGreen > 255 Then sngGreen = 255
                If sngBlue > 255 Then sngBlue = 255
                If sngRed < 0 Then sngRed = 0
                If sngGreen < 0 Then sngGreen = 0
                If sngBlue < 0 Then sngBlue = 0
            Next
        End If
        
        For iY = nBottom - iCurvPixelsBottomY To nBottom - 1
            If (nBottom - iY) <= nCurveBottomLeft Then
                iCurvPixelsXLeft = nCurveBottomLeft - Sqr(nCurveBottomLeft ^ 2 - (nCurveBottomLeft + iY - nBottom) ^ 2)
                iCurvPixelsXLeftInt = Round(iCurvPixelsXLeft) + 1
            Else
                iCurvPixelsXLeft = 0
                iCurvPixelsXLeftInt = 0
            End If
            If (nBottom - iY) <= nCurveBottomRight Then
                iCurvPixelsXRight = nCurveBottomRight - Sqr(nCurveBottomRight ^ 2 - (nCurveBottomRight + iY - nBottom) ^ 2)
                iCurvPixelsXRightInt = Round(iCurvPixelsXRight) + 1
            Else
                iCurvPixelsXRight = 0
                iCurvPixelsXRightInt = 0
            End If
            
            iCol = RGB(sngRed, sngGreen, sngBlue)
            If (iCurvPixelsXLeftInt > 0) Or (iCurvPixelsXRightInt > 0) Then
                picDraw.Line (nLeft + iCurvPixelsXLeftInt, iY)-(nRight - iCurvPixelsXRightInt, iY), iCol
                If iCurvPixelsXLeftInt > 0 Then
                    For iX = iCurvPixelsXLeftInt - 1 To iCurvPixelsXLeftInt \ 2 - 1 Step -1
                        If iX < 0 Then Exit For
                        iDistance = nCurveBottomLeft - (Sqr((nCurveBottomLeft - iX) ^ 2 + (nCurveBottomLeft + iY - nBottom) ^ 2))
                        If iDistance > 0 Then iDistance = 0
                        If iDistance > -1 Then
                            iDistance = (1 - Abs(iDistance)) * 100
                            AAQueuePixel nLeft + iX, iY, iCol, iDistance
                        End If
                    Next
                End If
                If iCurvPixelsXRightInt > 0 Then
                    For iX = iCurvPixelsXRightInt - 1 To iCurvPixelsXRightInt \ 2 - 1 Step -1
                        If iX < 0 Then Exit For
                        iDistance = nCurveBottomRight - (Sqr((nCurveBottomRight - iX) ^ 2 + (nCurveBottomRight + iY - nBottom) ^ 2))
                        If iDistance > 0 Then iDistance = 0
                        If iDistance > -1 Then
                            iDistance = (1 - Abs(iDistance)) * 100
                            AAQueuePixel nRight - iX - 1, iY, iCol, iDistance
                        End If
                    Next
                End If
            Else
                picDraw.Line (nLeft + iCurvPixelsXLeftInt, iY)-(nRight - iCurvPixelsXRightInt, iY), iCol
            End If
            sngRed = sngRed + sngRedInc
            sngGreen = sngGreen + sngGreenInc
            sngBlue = sngBlue + sngBlueInc
            
            If sngRed > 255 Then sngRed = 255
            If sngGreen > 255 Then sngGreen = 255
            If sngBlue > 255 Then sngBlue = 255
            If sngRed < 0 Then sngRed = 0
            If sngGreen < 0 Then sngGreen = 0
            If sngBlue < 0 Then sngBlue = 0
        Next
        ' and the bottom strip, same reason
        AAFlushPixels iDrawDC
    End If
#If SOLIDFILLDIAG = 1 Then ' TEMP diagnostic
    QueryPerformanceCounter iSFCallEnd
    mSolidFillTime = mSolidFillTime + (iSFCallEnd - iSFCallStart)
#End If
End Sub

Private Sub DrawRoundedCorner(ByVal nCorner As NTCornerPositionConstants, ByVal nX As Long, ByVal nY As Long, ByVal nRoundness As Long, ByVal nColor As Long, Optional ByVal nSkipAtTop As Long, Optional nLimit As Long = -999, Optional ByVal nColorOnRowY As Long = -1)
    Dim iX As Long
    Dim iY As Long
    Dim iDistance As Single
    Dim iDrawDC As LongPtr
    
    ' Both once here and not once per pixel.
    nColor = TranslatedColor(nColor)
    If nColorOnRowY = -1 Then
        nColorOnRowY = nColor
    Else
        nColorOnRowY = TranslatedColor(nColorOnRowY)
    End If
    iDrawDC = picDraw.hDC
    
    If nLimit = -999 Then
        Select Case nCorner
            Case ntCornerTopleft, ntCornerBottomLeft
                nLimit = 1000000
            Case Else
                nLimit = -1000000
        End Select
    End If
    If nCorner = ntCornerTopRight Then
        For iX = nX To nX - nRoundness Step -1
            For iY = nY + nSkipAtTop To nY + nRoundness
                iDistance = Sqr((nRoundness - (iX - nX + nRoundness * 2)) ^ 2 + (nRoundness - (iY - (nY))) ^ 2) - nRoundness
                If (Abs(iDistance) < 1) Then
                    If iX >= nLimit Then
                        AAQueuePixel iX, iY, nColor, (1 - Abs(iDistance)) * 100
                    End If
                End If
            Next
        Next
    ElseIf nCorner = ntCornerTopleft Then
        For iX = nX To nX + nRoundness
            For iY = nY + nSkipAtTop To nY + nRoundness
                iDistance = Sqr((nRoundness - ((nX - iX) + nRoundness * 2)) ^ 2 + (nRoundness - (iY - (nY))) ^ 2) - nRoundness
                If (Abs(iDistance) < 1) Then
                    If iX <= nLimit Then
                        AAQueuePixel iX, iY, nColor, (1 - Abs(iDistance)) * 100
                    End If
                End If
            Next
        Next
    ElseIf nCorner = ntCornerBottomRight Then
        For iX = nX To nX - nRoundness Step -1
            For iY = nY To nY - nRoundness Step -1
                iDistance = Sqr((nX - iX - nRoundness) ^ 2 + (nRoundness - (nY - iY)) ^ 2) - nRoundness
                If (Abs(iDistance) < 1) Then
                    If iX >= nLimit Then
                        AAQueuePixel iX, iY, IIf(iY = nY, nColorOnRowY, nColor), (1 - Abs(iDistance)) * 100
                    End If
                End If
            Next
        Next
    ElseIf nCorner = ntCornerBottomLeft Then
        For iX = nX To nX + nRoundness
            For iY = nY To nY - nRoundness Step -1
                iDistance = Sqr((nRoundness - (nX - iX) - nRoundness * 2) ^ 2 + (nRoundness - (nY - iY)) ^ 2) - nRoundness
                If (Abs(iDistance) < 1) Then
                    If iX <= nLimit Then
                        AAQueuePixel iX, iY, IIf(iY = nY, nColorOnRowY, nColor), (1 - Abs(iDistance)) * 100
                    End If
                End If
            Next
        Next
    End If
    ' One flush for the four branches: only one of them runs on any call
    AAFlushPixels iDrawDC
End Sub

Private Sub DrawTriangle(nTriangle() As POINTAPI, ByVal iColor As Long)
    Dim iBrush As LongPtr
    Dim iPrevObj As LongPtr
    
    iBrush = CreateSolidBrush(iColor)
    picDraw.ForeColor = iColor
    iPrevObj = SelectObject(picDraw.hDC, iBrush)
    Polygon picDraw.hDC, nTriangle(0), 3
    iPrevObj = SelectObject(picDraw.hDC, iPrevObj)
    DeleteObject iBrush
End Sub

' Draws an icon at its natural size, showing only nWidth by nHeight of it starting nShiftX,
' nShiftY in - which is what the PaintPicture call this replaces expressed with a source
' rectangle. DrawIconEx has no source rectangle: it draws the whole icon or scales the whole
' icon, so the crop is expressed the other way round, as a clip over the destination with the
' icon pushed back by the crop. Same pixels, and every number in pixels
'
' The uncropped case is the common one by far and is kept out of the clipping path, so the icon
' that fits - which is all of them until a caption crowds one out - costs one API call
' nGlyphRect is in the glyph's own upright frame. When the glyph is being turned by the world
' transform, the destination box and the direction of the turn are read off that transform, and
' the turn is done on the pixels instead
Private Function DrawIconGlyphInColor(ByRef nGlyphRect As RECT, ByVal nCharCode As Long, ByVal nColor As Long, ByVal nTurned As Boolean, ByRef nTransform As XFORM) As Boolean
    Dim iX1 As Single
    Dim iY1 As Single
    Dim iX2 As Single
    Dim iY2 As Single
    Dim iRotation As Long
    Dim iLeft As Long
    Dim iTop As Long
    
    If nTurned Then
        iX1 = nGlyphRect.Left * nTransform.eM11 + nGlyphRect.Top * nTransform.eM21 + nTransform.eDx
        iY1 = nGlyphRect.Left * nTransform.eM12 + nGlyphRect.Top * nTransform.eM22 + nTransform.eDy
        iX2 = nGlyphRect.Right * nTransform.eM11 + nGlyphRect.Bottom * nTransform.eM21 + nTransform.eDx
        iY2 = nGlyphRect.Right * nTransform.eM12 + nGlyphRect.Bottom * nTransform.eM22 + nTransform.eDy
        If iX1 < iX2 Then iLeft = Round(iX1) Else iLeft = Round(iX2)
        If iY1 < iY2 Then iTop = Round(iY1) Else iTop = Round(iY2)
        If nTransform.eM12 > 0 Then iRotation = 1 Else iRotation = -1
    Else
        iLeft = nGlyphRect.Left
        iTop = nGlyphRect.Top
    End If
    DrawIconGlyphInColor = DrawColorGlyphOnDC(picDraw.hDC, picAuxIconFont.hDC, nCharCode, nColor, iLeft, iTop, nGlyphRect.Right - nGlyphRect.Left, nGlyphRect.Bottom - nGlyphRect.Top, iRotation)
End Function

Private Sub DrawIconClipped(ByVal nDestHDC As LongPtr, ByVal nIcon As LongPtr, ByVal nLeft As Long, ByVal nTop As Long, ByVal nWidth As Long, ByVal nHeight As Long, ByVal nSrcWidth As Long, ByVal nSrcHeight As Long, ByVal nShiftX As Long, ByVal nShiftY As Long)
    Dim iSavedDC As Long
    
    If nIcon = 0 Then Exit Sub
    If (nShiftX = 0) And (nShiftY = 0) And (nWidth >= nSrcWidth) And (nHeight >= nSrcHeight) Then
        DrawIconEx nDestHDC, nLeft, nTop, nIcon, nSrcWidth, nSrcHeight, 0, 0, DI_NORMAL
        Exit Sub
    End If
    
    ' Saved and restored rather than cleared afterwards, because clearing would drop a clipping
    ' region the caller may have set on this DC
    iSavedDC = SaveDC(nDestHDC)
    IntersectClipRect nDestHDC, nLeft, nTop, nLeft + nWidth, nTop + nHeight
    DrawIconEx nDestHDC, nLeft - nShiftX, nTop - nShiftY, nIcon, nSrcWidth, nSrcHeight, 0, 0, DI_NORMAL
    If iSavedDC <> 0 Then RestoreDC nDestHDC, iSavedDC
End Sub

Private Sub DrawImage(ByVal lDestHDC As LongPtr, ByVal lhBmp As LongPtr, ByVal lTransColor As Long, ByVal nLeft As Long, ByVal nTop As Long, ByVal nWidth As Long, ByVal nHeight As Long, Optional ByVal nXOrigin As Long, Optional ByVal nYOrigin As Long)
    Dim lHDC As LongPtr
    Dim lhBmpOld As LongPtr
    Dim utBmp As BITMAP
    
    lHDC = CreateCompatibleDC(lDestHDC)
    lhBmpOld = SelectObject(lHDC, lhBmp)
    ' CreateCompatibleDC inherits the source DC's layout, so under RightToLeft this scratch DC is
    ' born mirrored.
    SetLayout lHDC, 0
    Call GetObjectW(lhBmp, Len(utBmp), utBmp)
    Call TransparentBlt(lDestHDC, nLeft, nTop, nWidth, nHeight, lHDC, nXOrigin, nYOrigin, nWidth, nHeight, lTransColor)
    Call SelectObject(lHDC, lhBmpOld)
    DeleteDC (lHDC)
End Sub

' Callers that pass a role are drawing; callers that do not are computing something else
' (a mask reference, an input to a mix, a color that was already translated) and must not be
' substituted. That is why the role is opt in and not the other way round: a site that gets
' forgotten keeps the developer's color, which is a cosmetic miss under high contrast, while
' a site substituted by mistake corrupts a mask or a derivation
Private Function TranslatedColor(ByVal lOleColor As Long, Optional ByVal nRole As NTColorRoleConstants = ntRoleNone) As Long
    Dim lRGBColor As Long
    
    If nRole <> ntRoleNone Then
        If mHandleHighContrastTheme And mHighContrastThemeOn Then
            Select Case nRole
            Case ntRoleBack
                lOleColor = vbButtonFace
            Case ntRoleFore
                lOleColor = vbButtonText
            Case ntRoleHighlightBack
                lOleColor = vbHighlight
            End Select
        End If
    End If
    Call TranslateColor(lOleColor, 0, lRGBColor)
    TranslatedColor = lRGBColor
End Function

'extract Red component from a color
Private Function GetRedValue(ByVal RGBValue As Long) As Integer
    GetRedValue = RGBValue And &HFF
End Function

'extract Green component from a color
Private Function GetGreenValue(ByVal RGBValue As Long) As Integer
    GetGreenValue = ((RGBValue And &HFF00&) / &H100) And &HFF
End Function

'extract Blue component from a color
Private Function GetBlueValue(ByVal RGBValue As Long) As Integer
    GetBlueValue = ((RGBValue And &HFF0000) / &H10000) And &HFF
End Function

' The only place ColorHLSToRGB is called. It exists because that API refuses a defined hue
' with a saturation of zero and answers black instead of the grey the pair means: measured,
' not assumed, hue 120 with lightness 220 and saturation 0 comes back as &H000000. An
' undefined hue, 160, which is what ColorRGBToHLS reports for a true grey, it builds without
' complaint - vbButtonFace goes through every call site in this file untouched, which is how
' we know the zero saturation alone is not what it objects to.
' The pair that breaks is not exotic. Almost every caller computes the saturation as a
' product at the call site, so any color carrying a trace of tint - a near white, a near
' black, a grey that is not quite neutral - has a hue of its own and a saturation that a
' factor rounds away, and the result was a black shadow or a black selected tab.
' Lightness and saturation arrive as Double because that is what those products are, and the
' narrowing happens here so it happens once and the same way for everyone
Private Function ColorFromHLS(ByVal nHue As Integer, ByVal nLightness As Double, ByVal nSaturation As Double) As Long
    Dim iLightness As Long
    Dim iSaturation As Long
    Dim iGrayLevel As Long
    
    iLightness = CLng(nLightness)
    iSaturation = CLng(nSaturation)
    If iSaturation = 0 Then
        ' The same arithmetic the API uses for an achromatic color: lightness scaled from the
        ' 0-240 range onto 0-255, truncated and not rounded, so a color that does reach here
        ' through both paths lands on the same grey either way
        iGrayLevel = iLightness * 255 \ 240
        ColorFromHLS = RGB(iGrayLevel, iGrayLevel, iGrayLevel)
    Else
        ColorFromHLS = ColorHLSToRGB(nHue, iLightness, iSaturation)
    End If
End Function

' Rebuilds a color at a new lightness with a faded saturation, and it is the only place the
' two arithmetic traps of that operation are handled. The callers decide the new lightness
' and how hard to fade, which are the two things the families of consumers disagree about,
' and both stay visible at the call site.
' nColor has to be a resolved RGB: ColorRGBToHLS reads the bytes, so a system color constant
' would give garbage
Private Function ColorWithLightnessAndFade(ByVal nColor As Long, ByVal nLightness As Long, ByVal nSaturationFactor As Double) As Long
    Dim iColor_H As Integer
    Dim iColor_L As Integer
    Dim iColor_S As Integer
    Dim iLightnessNew As Long
    Dim iChromaWeightPrev As Double
    Dim iChromaWeightNew As Double
    Dim iSaturation As Double
    
    ColorRGBToHLS nColor, iColor_H, iColor_L, iColor_S
    ' Both ends get clamped: ColorHLSToRGB of shlwapi works in 0-240, and a color pushed past
    ' either edge would wrap
    iLightnessNew = nLightness
    If iLightnessNew > 240 Then iLightnessNew = 240
    If iLightnessNew < 0 Then iLightnessNew = 0
    ' S is not colourfulness.
    iChromaWeightPrev = ChromaWeight(iColor_L)
    iChromaWeightNew = ChromaWeight(iLightnessNew)
    If iChromaWeightNew = 0 Then
        ' pure black or pure white: no room for any color at all, so S cannot matter
        iSaturation = 0
    Else
        iSaturation = iColor_S * nSaturationFactor * iChromaWeightPrev / iChromaWeightNew
        If iSaturation > 240 Then iSaturation = 240
    End If
    ColorWithLightnessAndFade = ColorFromHLS(iColor_H, iLightnessNew, iSaturation)
End Function

' The disabled variant of a surface: a step toward the middle of the range, since a
' background has nowhere in particular to go. The step is additive and not a factor because
' a factor cannot move a pure black at all - zero times anything is still zero - and on any
' dark color it collapses to a couple of levels while giving a dozen on a light one, so only
' the light end of the range ever showed a disabled state.
' The direction is the caller's because only the caller knows which way is away from the
' contrast it wants to lose, and so is the role, where one applies: the two callers in
' SetColors disagree on it - the high contrast branches pass ntRoleBack and the others pass
' none - and that difference has to stay visible at the call site
Private Function DisabledColorVariant(ByVal nColor As Long, ByVal nMakeItLighter As Boolean) As Long
    Dim iColor_H As Integer
    Dim iColor_L As Integer
    Dim iColor_S As Integer
    
    ColorRGBToHLS nColor, iColor_H, iColor_L, iColor_S
    If nMakeItLighter Then
        DisabledColorVariant = ColorWithLightnessAndFade(nColor, CLng(iColor_L) + cDisabledStateLightenDelta, cDisabledStateBackSaturationFactor)
    Else
        DisabledColorVariant = ColorWithLightnessAndFade(nColor, CLng(iColor_L) - cDisabledStateDarkenDelta, cDisabledStateBackSaturationFactor)
    End If
End Function

' The disabled variant of something drawn over a tab: caption, icon or close button. It moves
' a fraction of the way toward the lightness of the surface it sits on, so dark text on a
' light tab lightens and light text on a dark one darkens, both of them losing contrast.
' Deciding by the background and not by the color itself is what gets the second case right
' when someone puts a light foreground on a light background
' Two situations keep the flat system grey instead of deriving anything. Under high contrast
' the palette is the system's, and a shade of our own is not in it. And where the body is
' painted by DrawThemeBackground there is no background color to reason from: nBackColor
' holds one of our variables, which is not what is on the screen, so the honest answer is the
' one that does not pretend to know. The grey is the system's own and not a desaturation of
' the color: reducing a color to its luminance leaves a pure white or a pure black exactly
' where it was, which is what vbButtonText is under high contrast, and the disabled 'x' came
' out identical to an enabled one
Private Function DisabledForeColorVariant(ByVal nForeColor As Long, ByVal nBackColor As Long, ByVal nSystemGrayText As Long) As Long
    Dim iBackColor As Long
    Dim iBackColor_H As Integer
    Dim iBackColor_L As Integer
    Dim iBackColor_S As Integer
    Dim iForeColor As Long
    Dim iForeColor_H As Integer
    Dim iForeColor_L As Integer
    Dim iForeColor_S As Integer
    
    If (mHandleHighContrastTheme And mHighContrastThemeOn) Or mVisualStylesActive Then
        DisabledForeColorVariant = TranslatedColor(nSystemGrayText)
        Exit Function
    End If
    ' both get resolved here: ColorRGBToHLS reads the bytes, and either one can still be a
    ' system color constant - a custom tab color is whatever the developer assigned
    iBackColor = TranslatedColor(nBackColor)
    iForeColor = TranslatedColor(nForeColor)
    ColorRGBToHLS iBackColor, iBackColor_H, iBackColor_L, iBackColor_S
    ColorRGBToHLS iForeColor, iForeColor_H, iForeColor_L, iForeColor_S
    DisabledForeColorVariant = ColorWithLightnessAndFade(iForeColor, iForeColor_L + (CDbl(iBackColor_L) - iForeColor_L) * cDisabledStateForeApproachFactor, cDisabledStateForeSaturationFactor)
End Function

' How much of S actually reaches the screen at a given lightness: nil at both ends of the
' 0-240 range and largest at the midpoint. It is the (1 - |2L - 1|) term of the HLS to RGB
' conversion, written once here so the disabled variant can compensate for it
Private Function ChromaWeight(ByVal nLightness As Integer) As Double
    ChromaWeight = 1 - Abs((nLightness / 120) - 1)
End Function

' When the things drawn over a tab - caption, icon, close button - are painted disabled. It
' is deliberately not the same question the body answers. ShowDisabledState is an extra of
' this control that dims the background and it has no say here: a disabled control greys its
' captions the way the original SSTab always did, and so does a tab disabled on its own, at
' design time included.
' The two axes disagreeing - enabled body, grey caption - does not put the derivation out of
' step, because what it reads is iBackColorTabs2, the color the body is actually being
' painted in, whichever of the two states that is
Private Function TabForeIsDrawnDisabled(ByVal nTab As Long) As Boolean
    TabForeIsDrawnDisabled = (Not mTabData(nTab).Enabled) Or (Not mEnabled)
End Function

' The color the body of a tab is painted in when it is not the selected one: its own if it
' has one, the general one otherwise. mBackColorTabs2 already carries the disabled variant
' of the general color, so only the custom branch has to derive one here - without it a tab
' with a color of its own stayed at full strength on a disabled control while every other
' tab faded. The enabled test is the very one that governs mBackColorTabs2 in Draw, so
' the two branches cannot end up disagreeing. Under high contrast the custom color is
' discarded outright, palette of the system
' Named for the backsheet on purpose: DrawTab feeds this same local to six border and
' line sites, and whether every one of them is out of the active branch was never checked.
' A caller that needs the body under the selected tab has mBackColorSelectedTab2 and the
' iActive it already computes
' The disabled shade of a colour that is about to be painted as a background. Resolving a
' system constant first is not optional: DisabledColorVariant reads the bytes of the colour,
' so a system constant would give garbage. The direction comes from the lightness, so a dark
' colour darkens and a light one lightens instead of both drifting the same way
Private Function DisabledBackColorForDrawing(ByVal nColor As Long) As Long
    Dim iColor As Long
    Dim iColor_H As Integer
    Dim iColor_L As Integer
    Dim iColor_S As Integer
    
    iColor = TranslatedColor(nColor)
    ColorRGBToHLS iColor, iColor_H, iColor_L, iColor_S
    DisabledBackColorForDrawing = DisabledColorVariant(iColor, iColor_L <= 150)
End Function

Private Function FlatFrontRowEndClosedAtBottom(ByVal nLeftEnd As Boolean, ByVal nEdgeSlack As Long) As Boolean
    Dim t As Long
    
    If mFlatRowEndsSquared Or mStripScrolls Then Exit Function
    For t = 0 To mTabs - 1
        If mTabData(t).Visible And (mTabData(t).RowPos = (mRows - 1)) And IIf(nLeftEnd, mTabData(t).LeftTab, mTabData(t).RightTab) Then
            If IIf(nLeftEnd, mTabData(t).TabRect.Left <= nEdgeSlack, mTabData(t).TabRect.Right >= (mBodyWidth - nEdgeSlack)) Then
                If t = mTab Then
                    FlatFrontRowEndClosedAtBottom = mHighlightRoundBottomSelectedTab
                Else
                    FlatFrontRowEndClosedAtBottom = mHighlightFlatShapeInactive And mHighlightRoundBottom
                End If
            End If
            Exit Function
        End If
    Next t
End Function

' What shows beside the front row's end: the back sheet of the row behind when that row reaches past it, the control's background otherwise
Private Function FlatStripEndBehindColor(ByVal nLeftEnd As Boolean) As Long
    Dim t As Long
    Dim iFront As Long
    
    FlatStripEndBehindColor = TranslatedColor(IIf(mBackStyle = ntOpaque, mBackColor, mBackColorSelectedTab2), ntRoleBack)
    If mRows < 2 Then Exit Function
    iFront = -1
    For t = 0 To mTabs - 1
        If mTabData(t).Visible And (mTabData(t).RowPos = (mRows - 1)) And IIf(nLeftEnd, mTabData(t).LeftTab, mTabData(t).RightTab) Then iFront = t
    Next t
    If iFront = -1 Then Exit Function
    For t = 0 To mTabs - 1
        If mTabData(t).Visible And (mTabData(t).RowPos = (mRows - 2)) And IIf(nLeftEnd, mTabData(t).LeftTab, mTabData(t).RightTab) Then
            If IIf(nLeftEnd, mLeftMostTabsLeftPos2(mRows - 2) < mTabData(iFront).TabRect.Left, mRightMostTabsRightPos2(mRows - 2) > mTabData(iFront).TabRect.Right) Then
                FlatStripEndBehindColor = TranslatedColor(InactiveTabBackColorForDrawing(t), ntRoleBack)
            End If
            Exit Function
        End If
    Next t
End Function

Private Function InactiveTabBackColorForDrawing(ByVal nTab As Long) As Long
    If IsEmpty(mTabData(nTab).CustomColors.BackColorTab) Or (mHandleHighContrastTheme And mHighContrastThemeOn) Then
        InactiveTabBackColorForDrawing = mBackColorTabs2
    ElseIf mEnabled Or (Not mAmbientUserMode) Or (Not mShowDisabledState) Then
        InactiveTabBackColorForDrawing = mTabData(nTab).CustomColors.BackColorTab
    Else
        ' the enabled path hands the raw value straight to the drawing calls, so the system
        ' constant is only resolved down here, inside DisabledBackColorForDrawing
        InactiveTabBackColorForDrawing = DisabledBackColorForDrawing(mTabData(nTab).CustomColors.BackColorTab)
    End If
End Function

Private Sub SetColors()
    Dim iBCol As Long
    Dim iCol_L As Integer
    Dim iCol_S As Integer
    Dim iCol_H As Integer
    Dim iBackColorTabs_H As Integer
    Dim iBackColorTabs_L As Integer
    Dim iBackColorTabs_S As Integer
    Dim iBackColorSelectedTab_H As Integer
    Dim iBackColorSelectedTab_L As Integer
    Dim iBackColorSelectedTab_S As Integer
    Dim iAmbientBackColor_H As Integer
    Dim iAmbientBackColor_L As Integer
    Dim iAmbientBackColor_S As Integer
    Dim c As Long
    Dim iCol As Long
    Dim iFlatBarColorInactiveTab As Long
    Dim iFlatSeparationColorTabs As Long
    Dim iFlatSeparationColorBody As Long
    Dim iBackColorSelectedTab As Long
    Dim iSystemFaceColor As Long
    Dim iBackColorTabsIsSystemFace As Boolean
    Dim iBackColorSelectedTabIsSystemFace As Boolean
    
    ResetAllPicsDisabled
    mBodyReset = True
    
    If mHandleHighContrastTheme And mHighContrastThemeOn Then
        m3DDKShadow = vb3DDKShadow
        m3DHighlight = vb3DHighlight
        m3DShadow = vb3DShadow
        mGrayText = vbGrayText
        iFlatBarColorInactiveTab = vb3DHighlight
        
        iBCol = TranslatedColor(mBackColorTabs, ntRoleBack)
        ColorRGBToHLS iBCol, iBackColorTabs_H, iBackColorTabs_L, iBackColorTabs_S
        ' Nothing is lightened or darkened under high contrast: the palette is the system's and a
        ' derived shade is not in it.
        mBackColorTabsDisabled = iBCol
    Else
        iBCol = TranslatedColor(mBackColorTabs)
        ColorRGBToHLS iBCol, iBackColorTabs_H, iBackColorTabs_L, iBackColorTabs_S
        ' Asked here and kept in a flag because iBCol is reused for Ambient.BackColor a few lines
        ' below and no longer holds this colour by the time the shades are worked out.
        iSystemFaceColor = TranslatedColor(vbButtonFace)
        iBackColorTabsIsSystemFace = (iBCol = iSystemFaceColor)
        ' A background moves toward the middle, so a light one is darkened and a dark one
        ' is lightened. The 150 threshold is the same one m3DShadow and m3DHighlight use a
        ' few lines below
        mBackColorTabsDisabled = DisabledColorVariant(iBCol, iBackColorTabs_L <= 150)
        
        iBCol = TranslatedColor(Ambient.BackColor)
        ColorRGBToHLS iBCol, iAmbientBackColor_H, iAmbientBackColor_L, iAmbientBackColor_S
        If mSoftEdges Then
            If (iBackColorTabs_L > 150) Then
                m3DDKShadow = ColorFromHLS(iBackColorTabs_H, iBackColorTabs_L * 0.65, iBackColorTabs_S * 0.5)
                m3DShadow = ColorFromHLS(iBackColorTabs_H, iBackColorTabs_L * 0.818, iBackColorTabs_S * 0.6)
            Else
                iCol_L = iBackColorTabs_L * 3
                If iCol_L > 240 Then iCol_L = 240
                m3DDKShadow = ColorFromHLS(iBackColorTabs_H, iCol_L * 0.65, iBackColorTabs_S * 0.5)
                iCol_L = iBackColorTabs_L * 2
                If iCol_L > 240 Then iCol_L = 240
                m3DShadow = ColorFromHLS(iBackColorTabs_H, iCol_L * 0.818, iBackColorTabs_S * 0.6)
            End If
        ElseIf iBackColorTabsIsSystemFace Then
            ' On the system face with hard edges, the frame is the classic Windows one and the
            ' system owns its two shades.
            m3DDKShadow = vb3DDKShadow
            m3DShadow = vb3DShadow
        Else
            If (iBackColorTabs_L > 150) Then
                m3DDKShadow = ColorFromHLS(iBackColorTabs_H, iBackColorTabs_L * 0.47, iBackColorTabs_S * 0.18)
                m3DShadow = ColorFromHLS(iBackColorTabs_H, iBackColorTabs_L * 0.718, iBackColorTabs_S * 0.3)
            Else
                iCol_L = iBackColorTabs_L * 3
                If iCol_L > 240 Then iCol_L = 240
                m3DDKShadow = ColorFromHLS(iBackColorTabs_H, iCol_L, iBackColorTabs_S * 0.18)
                iCol_L = iBackColorTabs_L * 2
                If iCol_L > 240 Then iCol_L = 240
                m3DShadow = ColorFromHLS(iBackColorTabs_H, iCol_L * 0.718, iBackColorTabs_S * 0.3)
            End If
        End If
        mGrayText = vbGrayText
        
        If iBackColorTabs_L > 150 Then
            If (iBackColorTabs_L > 200) Then
                iCol_L = iBackColorTabs_L * 1.2
                If iCol_L > 240 Then iCol_L = 240
                m3DHighlight = ColorFromHLS(iBackColorTabs_H, iCol_L, iBackColorTabs_S * 0.3)
                iFlatBarColorInactiveTab = ColorFromHLS(iBackColorTabs_H, iCol_L * 0.85, iBackColorTabs_S * 0.3)
            Else
                iCol_L = iBackColorTabs_L * 1.1
                If iCol_L > 240 Then iCol_L = 240
                m3DHighlight = ColorFromHLS(iBackColorTabs_H, iCol_L, iBackColorTabs_S * 0.2)
                iFlatBarColorInactiveTab = ColorFromHLS(iBackColorTabs_H, iCol_L, iBackColorTabs_S * 0.2)
            End If
        Else
            iCol_L = iBackColorTabs_L + (240 - iBackColorTabs_L) * 0.7
            If iCol_L > 240 Then iCol_L = 240
            m3DHighlight = ColorFromHLS(iBackColorTabs_H, iCol_L, iBackColorTabs_S * 0.9)
            iCol_L = iBackColorTabs_L + (240 - iBackColorTabs_L) * 0.3
            iFlatBarColorInactiveTab = ColorFromHLS(iBackColorTabs_H, iCol_L, iBackColorTabs_S * 0.6)
        End If
    End If
    mGlowColor = GetGlowColor(iBackColorTabs_H, iBackColorTabs_L, iBackColorTabs_S)
    
    mHighlightColor_ColorAutomatic = mGlowColor
    mHighlightGradientColor_ColorAutomatic = mBackColorTabs
    If mHighlightGradientColor_IsAutomatic Then mHighlightGradientColor = mBackColorTabs
    mHighlightGradientColorSelectedTab_ColorAutomatic = mBackColorSelectedTab
    If mHighlightGradientColorSelectedTab_IsAutomatic Then mHighlightGradientColorSelectedTab = mBackColorSelectedTab
    If mHighlightColor_IsAutomatic Then
        mHighlightColor = mGlowColor
    Else
        mGlowColor = mHighlightColor
    End If
    ' One line for both branches, and it is where the whole idea of a gradient is settled for this
    ' mode.
    mGlowColor = TranslatedColor(mGlowColor, ntRoleBack)
    
    mFlatBarColorInactive_ColorAutomatic = iFlatBarColorInactiveTab
    If mFlatBarColorInactive_IsAutomatic Then
        mFlatBarColorInactive = mFlatBarColorInactive_ColorAutomatic
    End If
    
    ' A lighter tint of the accent over the tab, not a greyed one: hover reads as a softer version
    ' of the selection, the way the common browsers and editors do it
    ' A tab with a selected bar colour of its own gets its tint from FlatBarColorHighlightedFor
    mFlatBarColorHighlighted_ColorAutomatic = MixColors(mBackColorTabs, mFlatBarColorSelectedTab, 60)
    If mFlatBarColorHighlighted_IsAutomatic Then
        mFlatBarColorHighlighted = mFlatBarColorHighlighted_ColorAutomatic
    End If
    ' The bar colours are not in the chain, so a move of theirs has to reach the borders from here
    If (mFlatTabBorderColorHighlighted_IsAutomatic And (mFlatTabBorderColorHighlighted <> mFlatBarColorHighlighted)) Or (mFlatTabBorderColorSelectedTab_IsAutomatic And (mFlatTabBorderColorSelectedTab <> mFlatBarColorSelectedTab)) Or (mFlatTabBorderColorInactive_IsAutomatic And (mFlatTabBorderColorInactive <> mFlatBarColorInactive)) Then
        ApplyChainColors nSilent:=True
    End If
    
    ' The three palettes that used to be built here are gone: ResolveHoverAnimation reads
    ' these same colours as endpoints when the mouse enters a tab and mixes them per frame
    
    ' Active Tab (TabSel) colors
    If mHandleHighContrastTheme And mHighContrastThemeOn Then
        m3DDKShadow_Sel = vb3DDKShadow
        m3DHighlight_Sel = vb3DHighlight
        m3DShadow_Sel = vb3DShadow
        mGrayText_Sel = vbGrayText
        
        iBCol = TranslatedColor(mBackColorTabs, ntRoleBack)
        ColorRGBToHLS iBCol, iBackColorSelectedTab_H, iBackColorSelectedTab_L, iBackColorSelectedTab_S
        ' Same as the backsheet above: under high contrast the disabled variant is the
        ' system color itself, untouched
        mBackColorSelectedTabDisabled = iBCol
    Else
        If IsEmpty(mTabData(mTab).CustomColors.BackColorSelectedTab) Or (mHandleHighContrastTheme And mHighContrastThemeOn) Then
            iBackColorSelectedTab = mBackColorSelectedTab
        Else
            iBackColorSelectedTab = mTabData(mTab).CustomColors.BackColorSelectedTab
        End If
        iBCol = TranslatedColor(iBackColorSelectedTab)
        ColorRGBToHLS iBCol, iBackColorSelectedTab_H, iBackColorSelectedTab_L, iBackColorSelectedTab_S
        ' The counterpart of the flag set for the inactive tabs, and it reads
        ' iBackColorSelectedTab and not mBackColorSelectedTab so a per tab custom colour is
        ' answered on its own merits, the same way the disabled variant below is
        iBackColorSelectedTabIsSystemFace = (iBCol = TranslatedColor(vbButtonFace))
        ' Both branches set it, and only the high contrast one used to: outside high contrast the
        ' variable stayed at zero, so a disabled control with ShowDisabledState painted the active
        ' tab body, the subclassing brush and the contained controls in black.
        mBackColorSelectedTabDisabled = DisabledColorVariant(iBCol, iBackColorSelectedTab_L <= 150)
        
        iBCol = TranslatedColor(Ambient.BackColor)
        ColorRGBToHLS iBCol, iAmbientBackColor_H, iAmbientBackColor_L, iAmbientBackColor_S
        If mSoftEdges Then
            If (iBackColorSelectedTab_L > 150) Then
                m3DDKShadow_Sel = ColorFromHLS(iBackColorSelectedTab_H, iBackColorSelectedTab_L * 0.65, iBackColorSelectedTab_S * 0.5)
                m3DShadow_Sel = ColorFromHLS(iBackColorSelectedTab_H, iBackColorSelectedTab_L * 0.818, iBackColorSelectedTab_S * 0.6)
            Else
                iCol_L = iBackColorSelectedTab_L * 3
                If iCol_L > 240 Then iCol_L = 240
                m3DDKShadow_Sel = ColorFromHLS(iBackColorSelectedTab_H, iCol_L * 0.65, iBackColorSelectedTab_S * 0.5)
                iCol_L = iBackColorSelectedTab_L * 2
                If iCol_L > 240 Then iCol_L = 240
                m3DShadow_Sel = ColorFromHLS(iBackColorSelectedTab_H, iCol_L * 0.818, iBackColorSelectedTab_S * 0.6)
            End If
        ElseIf iBackColorSelectedTabIsSystemFace Then
            ' Same rule as the inactive pair a hundred lines above, and it has to be the same:
            ' half a frame from the system and half derived is what makes a border look wrong
            m3DDKShadow_Sel = vb3DDKShadow
            m3DShadow_Sel = vb3DShadow
        Else
            If (iBackColorSelectedTab_L > 150) Then
                m3DDKShadow_Sel = ColorFromHLS(iBackColorSelectedTab_H, iBackColorSelectedTab_L * 0.47, iBackColorSelectedTab_S * 0.18)
                m3DShadow_Sel = ColorFromHLS(iBackColorSelectedTab_H, iBackColorSelectedTab_L * 0.718, iBackColorSelectedTab_S * 0.3)
            Else
                iCol_L = iBackColorSelectedTab_L * 3
                If iCol_L > 240 Then iCol_L = 240
                m3DDKShadow_Sel = ColorFromHLS(iBackColorSelectedTab_H, iCol_L, iBackColorSelectedTab_S * 0.18)
                iCol_L = iBackColorSelectedTab_L * 2
                If iCol_L > 240 Then iCol_L = 240
                m3DShadow_Sel = ColorFromHLS(iBackColorSelectedTab_H, iCol_L * 0.718, iBackColorSelectedTab_S * 0.3)
            End If
        End If
        mGrayText_Sel = vbGrayText
        
        If iBackColorSelectedTab_L > 150 Then
            If (iBackColorSelectedTab_L > 200) And (iBackColorSelectedTab_S < 150) Then
                iCol_L = iBackColorSelectedTab_L * 1.2
                If iCol_L > 240 Then iCol_L = 240
                m3DHighlight_Sel = ColorFromHLS(iBackColorSelectedTab_H, iCol_L, iBackColorSelectedTab_S * 0.3)
            Else
                iCol_L = iBackColorSelectedTab_L * 1.1
                If iCol_L > 240 Then iCol_L = 240
                m3DHighlight_Sel = ColorFromHLS(iBackColorSelectedTab_H, iCol_L, iBackColorSelectedTab_S * 0.2)
            End If
        Else
            iCol_L = iBackColorSelectedTab_L + (240 - iBackColorSelectedTab_L) * 0.7
            If iCol_L > 240 Then iCol_L = 240
            m3DHighlight_Sel = ColorFromHLS(iBackColorSelectedTab_H, iCol_L, iBackColorSelectedTab_S * 0.9)
        End If
    End If
    
    ' 3DLight is the inner row of a light bevel, the light side's twin of the m3DDKShadow +
    ' m3DShadow pair the dark side has drawn all along.
    If mHandleHighContrastTheme And mHighContrastThemeOn Then
        m3DLight = vb3DLight
        m3DLight_Sel = vb3DLight
    Else
        If iBackColorTabsIsSystemFace And (Not mSoftEdges) Then
            m3DLight = vb3DLight
        ElseIf iBackColorTabs_L > 150 Then
            m3DLight = MixColors(TranslatedColor(mBackColorTabs, ntRoleBack), m3DShadow, 16)
        Else
            m3DLight = MixColors(TranslatedColor(mBackColorTabs, ntRoleBack), m3DHighlight, 16)
        End If
        If iBackColorSelectedTabIsSystemFace And (Not mSoftEdges) Then
            m3DLight_Sel = vb3DLight
        ElseIf iBackColorSelectedTab_L > 150 Then
            m3DLight_Sel = MixColors(TranslatedColor(iBackColorSelectedTab, ntRoleBack), m3DShadow_Sel, 16)
        Else
            m3DLight_Sel = MixColors(TranslatedColor(iBackColorSelectedTab, ntRoleBack), m3DHighlight_Sel, 16)
        End If
    End If
    
    If iBackColorSelectedTab_L > 150 Then
        If (iBackColorSelectedTab_L > 233) Then
            If iBackColorSelectedTab_S = 0 Then
                iCol_L = iBackColorSelectedTab_L * 0.95
                iCol_S = 0
                iCol_H = iBackColorSelectedTab_H
            Else
                iCol_L = iBackColorSelectedTab_L * 0.9
                iCol_S = 80
                iCol_H = iBackColorSelectedTab_H
            End If
            mGlowColor_Sel = ColorFromHLS(iCol_H, iCol_L, iCol_S)
        ElseIf (iBackColorSelectedTab_L > 200) And (iBackColorSelectedTab_S < 150) Then
            iCol_L = iBackColorSelectedTab_L + (240 - iBackColorSelectedTab_L) * 0.1 + iBackColorSelectedTab_L * 0.05 + 5
            If iCol_L > 240 Then iCol_L = 240
            mGlowColor_Sel = ColorFromHLS(iBackColorSelectedTab_H, iCol_L, iBackColorSelectedTab_S)
        Else
            iCol_S = iBackColorSelectedTab_S
            If iBackColorSelectedTab_L > 160 Then
                iCol_L = iBackColorSelectedTab_L * 1.15
            Else
                iCol_L = iBackColorSelectedTab_L + (240 - iBackColorSelectedTab_L) * 0.2 + iBackColorSelectedTab_L * 0.06 + 5
            End If
            If iCol_L > 240 Then iCol_L = 240
            If iCol_L > 200 Then
                If iBackColorSelectedTab_L > 210 Then
                    iCol_S = 1
                Else
                    If iCol_S > 100 Then
                        If ((iBackColorSelectedTab_H > 35) And (iBackColorSelectedTab_H < 45)) Then
                            iCol_S = iCol_S - 100
                            If iCol_S < 1 Then iCol_S = 1
                            iCol_L = iCol_L + 20
                            If iCol_L > 240 Then iCol_L = 240
                        End If
                    End If
                End If
            End If
            mGlowColor_Sel = ColorFromHLS(iBackColorSelectedTab_H, iCol_L, iCol_S)
        End If
    Else
        If iBackColorSelectedTab_S > 60 Then
            Select Case iBackColorSelectedTab_H
                Case 0 To 30, 220 To 240 ' reds
                    If iBackColorSelectedTab_L < 100 Then
                        iCol_L = iBackColorSelectedTab_L + (240 - iBackColorSelectedTab_L) * 0.07
                    Else
                        iCol_L = iBackColorSelectedTab_L
                    End If
                Case 200 To 219 ' violet
                    iCol_L = iBackColorSelectedTab_L + (240 - iBackColorSelectedTab_L) * 0.3
                Case 31 To 120 ' yellows, greenes, cyanes
                    iCol_L = iBackColorSelectedTab_L + (240 - iBackColorSelectedTab_L) * 0.2
                Case Else ' blues
                    If iBackColorSelectedTab_L < 100 Then
                        iCol_L = iBackColorSelectedTab_L + (240 - iBackColorSelectedTab_L) * 0.15
                    Else
                        iCol_L = iBackColorSelectedTab_L '+ (240 - iBackColorSelectedTab_L) * 0.07
                    End If
            End Select
        Else ' gray
            iCol_L = iBackColorSelectedTab_L + (240 - iBackColorSelectedTab_L) * 0.2
        End If
        iCol_L = iCol_L + 15
        If iCol_L > 240 Then iCol_L = 240
        iCol_S = iBackColorSelectedTab_S
        If iCol_S > 200 Then
            iCol_S = iCol_S * 0.65
            If iCol_S < 1 Then iCol_S = 1
            iCol_L = iCol_L * 1.4
            If iCol_L > 240 Then iCol_L = 240
        Else
            iCol_S = iCol_S * 1.1
        End If
        If iCol_S > 240 Then iCol_S = 240

        mGlowColor_Sel = ColorFromHLS(iBackColorSelectedTab_H, iCol_L, iCol_S)
    End If
    
    mHighlightColorSelectedTab_ColorAutomatic = mGlowColor_Sel
    If mHighlightColorSelectedTab_IsAutomatic Then
        mHighlightColorSelectedTab = mGlowColor_Sel
    Else
        mGlowColor_Sel = mHighlightColorSelectedTab
    End If
    If Not IsEmpty(mTabData(mTab).CustomColors.HighlightColorSelectedTab) Then
        mGlowColor_Sel = mTabData(mTab).CustomColors.HighlightColorSelectedTab
    End If
    ' the same collapse as mGlowColor above, and placed after the three branches for the same
    ' reason: a colour of the tab's own is not a way around the mode either
    mGlowColor_Sel = TranslatedColor(mGlowColor_Sel, ntRoleBack)
    mGlowColor_Sel_Bk = mGlowColor_Sel
    mGlowColor_Sel_Light = MixColors(TranslatedColor(iBackColorSelectedTab, ntRoleBack), mGlowColor_Sel, 60)
    mGradColor_Sel_IsSet = True
    If Not IsEmpty(mTabData(mTab).CustomColors.HighlightGradientColorSelectedTab) Then
        mGradColor_Sel_Bk = TranslatedColor(mTabData(mTab).CustomColors.HighlightGradientColorSelectedTab, ntRoleBack)
    ElseIf Not mHighlightGradientColorSelectedTab_IsAutomatic Then
        mGradColor_Sel_Bk = TranslatedColor(mHighlightGradientColorSelectedTab, ntRoleBack)
    Else
        mGradColor_Sel_IsSet = False
    End If
    mGradColor_Sel_Light = MixColors(TranslatedColor(iBackColorSelectedTab, ntRoleBack), mGradColor_Sel_Bk, 60)
    
    If iBackColorTabs_L > 150 Then
        iFlatSeparationColorTabs = MixColors(TranslatedColor(mBackColorTabs, ntRoleBack), m3DDKShadow, 12)
        iFlatSeparationColorBody = MixColors(TranslatedColor(mBackColorTabs, ntRoleBack), m3DDKShadow, 17)
    Else
        iFlatSeparationColorTabs = MixColors(TranslatedColor(mBackColorTabs, ntRoleBack), m3DDKShadow, 15)
        iFlatSeparationColorBody = MixColors(TranslatedColor(mBackColorTabs, ntRoleBack), m3DDKShadow, 15)
    End If
    SetHighlightMode
    
    mFlatTabsSeparationLineColor_ColorAutomatic = iFlatSeparationColorTabs
    If mFlatTabsSeparationLineColor_IsAutomatic Then
        mFlatTabsSeparationLineColor = mFlatTabsSeparationLineColor_ColorAutomatic
    End If
    mFlatBodySeparationLineColor_ColorAutomatic = iFlatSeparationColorBody
    If mFlatBodySeparationLineColor_IsAutomatic Then
        mFlatBodySeparationLineColor = mFlatBodySeparationLineColor_ColorAutomatic
    End If
    mFlatBorderColor_ColorAutomatic = m3DShadow_Sel
    If mFlatBorderColor_IsAutomatic Then
        mFlatBorderColor = mFlatBorderColor_ColorAutomatic
    End If
    
End Sub

Private Function GetGlowColor(nBackColorTabs_H As Integer, nBackColorTabs_L As Integer, nBackColorTabs_S As Integer) As Long
    Dim iBCol As Long
    Dim iCol_L As Integer
    Dim iCol_S As Integer
    Dim iCol_H As Integer
    
    If nBackColorTabs_L > 150 Then
        If (nBackColorTabs_L > 233) Then
            If nBackColorTabs_S = 0 Then
                iCol_L = nBackColorTabs_L * 0.95
                iCol_S = 0
                iCol_H = nBackColorTabs_H
            Else
                iCol_L = nBackColorTabs_L * 0.9
                iCol_S = 80
                iCol_H = nBackColorTabs_H
            End If
            GetGlowColor = ColorFromHLS(iCol_H, iCol_L, iCol_S)
        ElseIf (nBackColorTabs_L > 200) And (nBackColorTabs_S < 150) Then
            iCol_L = nBackColorTabs_L + (240 - nBackColorTabs_L) * 0.1 + nBackColorTabs_L * 0.05 + 5
            If iCol_L > 240 Then iCol_L = 240
            GetGlowColor = ColorFromHLS(nBackColorTabs_H, iCol_L, nBackColorTabs_S)
        Else
            iCol_S = nBackColorTabs_S
            If nBackColorTabs_L > 160 Then
                iCol_L = nBackColorTabs_L * 1.15
            Else
                iCol_L = nBackColorTabs_L + (240 - nBackColorTabs_L) * 0.2 + nBackColorTabs_L * 0.06 + 5
            End If
            If iCol_L > 240 Then iCol_L = 240
            If iCol_L > 200 Then
                If nBackColorTabs_L > 210 Then
                    iCol_S = 1
                Else
                    If iCol_S > 100 Then
                        If ((nBackColorTabs_H > 35) And (nBackColorTabs_H < 45)) Then
                            iCol_S = iCol_S - 100
                            If iCol_S < 1 Then iCol_S = 1
                            iCol_L = iCol_L + 20
                            If iCol_L > 240 Then iCol_L = 240
                        End If
                    End If
                End If
            End If
            GetGlowColor = ColorFromHLS(nBackColorTabs_H, iCol_L, iCol_S)
        End If
    Else
        If nBackColorTabs_S > 60 Then
            Select Case nBackColorTabs_H
                Case 0 To 30, 220 To 240 ' reds
                    If nBackColorTabs_L < 100 Then
                        iCol_L = nBackColorTabs_L + (240 - nBackColorTabs_L) * 0.07
                    Else
                        iCol_L = nBackColorTabs_L
                    End If
                Case 200 To 219 ' violet
                    iCol_L = nBackColorTabs_L + (240 - nBackColorTabs_L) * 0.3
                Case 31 To 120 ' yellows, greenes, cyanes
                    iCol_L = nBackColorTabs_L + (240 - nBackColorTabs_L) * 0.2
                Case Else ' blues
                    If nBackColorTabs_L < 100 Then
                        iCol_L = nBackColorTabs_L + (240 - nBackColorTabs_L) * 0.15
                    Else
                        iCol_L = nBackColorTabs_L '+ (240 - nBackColorTabs_L) * 0.07
                    End If
            End Select
        Else ' gray
            iCol_L = nBackColorTabs_L + (240 - nBackColorTabs_L) * 0.2
        End If
        iCol_L = iCol_L + 15
        If iCol_L > 240 Then iCol_L = 240
        iCol_S = nBackColorTabs_S
        If iCol_S > 200 Then
            iCol_S = iCol_S * 0.65
            If iCol_S < 1 Then iCol_S = 1
            iCol_L = iCol_L * 1.4
            If iCol_L > 240 Then iCol_L = 240
        Else
            iCol_S = iCol_S * 1.1
        End If
        If iCol_S > 240 Then iCol_S = 240
        
        GetGlowColor = ColorFromHLS(nBackColorTabs_H, iCol_L, iCol_S)
    End If
End Function

Private Function MixColors(ByVal nColor1 As Long, ByVal nColor2 As Long, ByVal nPercentColor2 As Long) As Long
    If nPercentColor2 > 100 Then nPercentColor2 = 100
    If nPercentColor2 < 0 Then nPercentColor2 = 0
    nColor1 = TranslatedColor(nColor1)
    nColor2 = TranslatedColor(nColor2)
    If nPercentColor2 = 0 Then
        MixColors = nColor1
        Exit Function
    End If
    If nPercentColor2 = 100 Then
        MixColors = nColor2
        Exit Function
    End If
    
    Dim iB1 As Long, iG1 As Long, iR1 As Long
    Dim iB2 As Long, iG2 As Long, iR2 As Long
    Dim iR As Long, iG As Long, iB As Long
    
    iR1 = nColor1 And 255
    iG1 = (nColor1 \ 256) And 255
    iB1 = (nColor1 \ 65536) And 255
    
    iR2 = nColor2 And 255
    iG2 = (nColor2 \ 256) And 255
    iB2 = (nColor2 \ 65536) And 255
    
    iR = (iR1 * (100 - nPercentColor2) + iR2 * nPercentColor2) \ 100
    iG = (iG1 * (100 - nPercentColor2) + iG2 * nPercentColor2) \ 100
    iB = (iB1 * (100 - nPercentColor2) + iB2 * nPercentColor2) \ 100
    If iR > 255 Then iR = 255
    If iG > 255 Then iG = 255
    If iB > 255 Then iB = 255
    
    MixColors = RGB(iR, iG, iB)
End Function

' MixColors for callers that already hold plain RGB values, which is every caller that
' blends against something read back from the DC. Same arithmetic, same clamps, same
' integer division, so the result is bit for bit what MixColors returns for RGB input.
' It is a separate routine and not a flag on MixColors because the other fifteen call
' sites of that one can and do pass system colours, where the translation is the point
Private Function MixColorsRGB(ByVal nColor1 As Long, ByVal nColor2 As Long, ByVal nPercentColor2 As Long) As Long
    Dim iB1 As Long, iG1 As Long, iR1 As Long
    Dim iB2 As Long, iG2 As Long, iR2 As Long
    Dim iR As Long, iG As Long, iB As Long
    
    If nPercentColor2 > 100 Then nPercentColor2 = 100
    If nPercentColor2 < 0 Then nPercentColor2 = 0
    If nPercentColor2 = 0 Then
        MixColorsRGB = nColor1
        Exit Function
    End If
    If nPercentColor2 = 100 Then
        MixColorsRGB = nColor2
        Exit Function
    End If
    
    iR1 = nColor1 And 255
    iG1 = (nColor1 \ 256) And 255
    iB1 = (nColor1 \ 65536) And 255
    
    iR2 = nColor2 And 255
    iG2 = (nColor2 \ 256) And 255
    iB2 = (nColor2 \ 65536) And 255
    
    iR = (iR1 * (100 - nPercentColor2) + iR2 * nPercentColor2) \ 100
    iG = (iG1 * (100 - nPercentColor2) + iG2 * nPercentColor2) \ 100
    iB = (iB1 * (100 - nPercentColor2) + iB2 * nPercentColor2) \ 100
    If iR > 255 Then iR = 255
    If iG > 255 Then iG = 255
    If iB > 255 Then iB = 255
    
    MixColorsRGB = RGB(iR, iG, iB)
End Function

' The blend of one antialiased corner pixel against what is already on the surface, and
' the only place that reads a pixel back from picDraw. The eight antialiasing loops - four
' in FillCurvedGradient2, four in DrawRoundedCorner - all come through here, so the day the
' per-pixel GetPixel is replaced by one batched read per corner there is a single call site
' to rewrite.
' The DC arrives as an argument and is not read from picDraw here: reading it is a property
' fetch on a VB control, and it used to happen twice for every antialiased pixel.
' nPercent is declared As Long on purpose: the callers hand it a Single, and taking the
' conversion here keeps it identical to the one the old call to MixColors did
Private Function AAMixWithBackground(ByVal nDC As LongPtr, ByVal nX As Long, ByVal nY As Long, ByVal nColor As Long, ByVal nPercent As Long) As Long
    Dim iBack As Long
    
    iBack = GetPixel(nDC, nX, nY)
    ' A failed read is the one input that is not a plain RGB, and MixColors did not treat it
    ' as a colour either: OleTranslateColor rejects it and leaves its output variable at
    ' zero. Black is therefore what the old path blended against, and what this keeps
    If iBack = CLR_INVALID Then iBack = 0
    AAMixWithBackground = MixColorsRGB(iBack, nColor, nPercent)
End Function

' Takes note of one antialiased pixel. Nothing reaches the surface
' until AAFlushPixels runs; deferring is safe because an antialiased pixel always falls
' outside the span its own row fills, and no row of a strip writes over another one, so
' what it has underneath at the end of the strip is what it had when it was worked out
Private Sub AAQueuePixel(ByVal nX As Long, ByVal nY As Long, ByVal nColor As Long, ByVal nPercent As Long)
    If mAAQueueCount >= mAAQueueSize Then
        mAAQueueSize = mAAQueueSize + 256
        ReDim Preserve mAAQueueX(0 To mAAQueueSize - 1)
        ReDim Preserve mAAQueueY(0 To mAAQueueSize - 1)
        ReDim Preserve mAAQueueColor(0 To mAAQueueSize - 1)
        ReDim Preserve mAAQueuePercent(0 To mAAQueueSize - 1)
    End If
    mAAQueueX(mAAQueueCount) = nX
    mAAQueueY(mAAQueueCount) = nY
    mAAQueueColor(mAAQueueCount) = nColor
    mAAQueuePercent(mAAQueueCount) = nPercent
    mAAQueueCount = mAAQueueCount + 1
End Sub

' Applies everything queued so far and empties the queue. One BitBlt brings the block that
' contains the queued pixels into the scratch DIB, the blending happens in that memory, and
' one BitBlt puts it back. Nothing else writes to the block in between, so copying the
' whole thing back is the identity everywhere except on the pixels that were queued.
'
' The bytes of a 32 bit DIB are B, G, R, A, so a Long read out of it carries red where a
' COLORREF carries blue. The two are swapped on the way in and on the way out rather than
' teaching MixColorsRGB about a second channel order
Private Sub AAFlushPixels(ByVal nDC As LongPtr)
    Dim iQ As Long
    Dim iLeft As Long, iTop As Long, iRight As Long, iBottom As Long
    Dim iBlockWidth As Long, iBlockHeight As Long
    Dim iRow As Long
    Dim iStride As Long
    Dim iIndex As Long
    Dim iRaw As Long
    Dim iBack As Long
    Dim iBlend As Long
    Dim iKeepBase As Boolean
    
    If mAAQueueCount = 0 Then Exit Sub
    iLeft = mAAQueueX(0): iRight = iLeft
    iTop = mAAQueueY(0): iBottom = iTop
    For iQ = 1 To mAAQueueCount - 1
        If mAAQueueX(iQ) < iLeft Then iLeft = mAAQueueX(iQ)
        If mAAQueueX(iQ) > iRight Then iRight = mAAQueueX(iQ)
        If mAAQueueY(iQ) < iTop Then iTop = mAAQueueY(iQ)
        If mAAQueueY(iQ) > iBottom Then iBottom = mAAQueueY(iQ)
    Next iQ
    iBlockWidth = iRight - iLeft + 1
    iBlockHeight = iBottom - iTop + 1
    If Not AAEnsureSurface(nDC, iBlockWidth, iBlockHeight) Then
        ' No surface, no block: the pixels still have to be painted, so they go one by one.
        ' Slow and correct beats fast and missing
        For iQ = 0 To mAAQueueCount - 1
            iKeepBase = False
            If mAAKeepHoverBase Then iKeepBase = (GetPixel(mHoverCacheDC, mAAQueueX(iQ), mAAQueueY(iQ)) = GetPixel(nDC, mAAQueueX(iQ), mAAQueueY(iQ)))
            If Not iKeepBase Then SetPixelV nDC, mAAQueueX(iQ), mAAQueueY(iQ), AAMixWithBackground(nDC, mAAQueueX(iQ), mAAQueueY(iQ), mAAQueueColor(iQ), mAAQueuePercent(iQ))
        Next iQ
        mAAQueueCount = 0
        Exit Sub
    End If
    ' The scratch DC is never mirrored - AAEnsureSurface clears its layout - so the block lands at
    ' its top left corner and the bytes are read from offset zero of each row.
    BitBlt mAADC, 0, 0, iBlockWidth, iBlockHeight, nDC, iLeft, iTop, vbSrcCopy
    iStride = mAASurfWidth * 4
    If mAABufSize < iBlockWidth * iBlockHeight Then
        mAABufSize = iBlockWidth * iBlockHeight
        ReDim mAABuf(0 To mAABufSize - 1)
    End If
    For iRow = 0 To iBlockHeight - 1
        CopyMemory mAABuf(iRow * iBlockWidth), ByVal (mAABits + iRow * iStride), iBlockWidth * 4
    Next iRow
    For iQ = 0 To mAAQueueCount - 1
        iIndex = (mAAQueueY(iQ) - iTop) * iBlockWidth + (mAAQueueX(iQ) - iLeft)
        iRaw = mAABuf(iIndex)
        iBack = ((iRaw And &HFF0000) \ &H10000) Or (iRaw And &HFF00&) Or ((iRaw And &HFF&) * &H10000)
        ' In the hover replay a pixel that still is what the base has was not touched by the
        ' hovered tab, and already carries this blend
        iKeepBase = False
        If mAAKeepHoverBase Then iKeepBase = (GetPixel(mHoverCacheDC, mAAQueueX(iQ), mAAQueueY(iQ)) = iBack)
        If Not iKeepBase Then
            iBlend = MixColorsRGB(iBack, mAAQueueColor(iQ), mAAQueuePercent(iQ))
            mAABuf(iIndex) = (iRaw And &HFF000000) Or ((iBlend And &HFF&) * &H10000) Or (iBlend And &HFF00&) Or ((iBlend And &HFF0000) \ &H10000)
        End If
    Next iQ
    For iRow = 0 To iBlockHeight - 1
        CopyMemory ByVal (mAABits + iRow * iStride), mAABuf(iRow * iBlockWidth), iBlockWidth * 4
    Next iRow
    BitBlt nDC, iLeft, iTop, iBlockWidth, iBlockHeight, mAADC, 0, 0, vbSrcCopy
    mAAQueueCount = 0
End Sub

' Makes sure the scratch surface is at least the size asked for. It only ever grows, so a
' run of blocks of different sizes settles on one allocation instead of thrashing
Private Function AAEnsureSurface(ByVal nHdcRef As LongPtr, ByVal nWidth As Long, ByVal nHeight As Long) As Boolean
    Dim utBIAA As BITMAPINFO
    
    If (nWidth <= 0) Or (nHeight <= 0) Then Exit Function
    If (mAABmp <> 0) And (nWidth <= mAASurfWidth) And (nHeight <= mAASurfHeight) Then
        AAEnsureSurface = True
        Exit Function
    End If
    If nWidth < mAASurfWidth Then nWidth = mAASurfWidth
    If nHeight < mAASurfHeight Then nHeight = mAASurfHeight
    AARelease
    utBIAA.bmiHeader.biSize = Len(utBIAA.bmiHeader)
    utBIAA.bmiHeader.biWidth = nWidth
    ' negative, so row y starts at the bits plus y times the stride and the arithmetic below
    ' reads the same way round as the coordinates do
    utBIAA.bmiHeader.biHeight = -nHeight
    utBIAA.bmiHeader.biPlanes = 1
    utBIAA.bmiHeader.biBitCount = 32
    utBIAA.bmiHeader.biCompression = 0
    mAABmp = CreateDIBSection(nHdcRef, utBIAA, 0, mAABits, 0, 0)
    If mAABmp = 0 Then
        AARelease
        Exit Function
    End If
    mAADC = CreateCompatibleDC(nHdcRef)
    If mAADC = 0 Then
        AARelease
        Exit Function
    End If
    mAAOldBmp = SelectObject(mAADC, mAABmp)
    ' CreateCompatibleDC inherits the layout of its source DC, so under RightToLeft this one is born
    ' mirrored and the destination rectangle would not match the bytes read from offset zero
    SetLayout mAADC, 0
    mAASurfWidth = nWidth
    mAASurfHeight = nHeight
    AAEnsureSurface = True
End Function

Private Sub AARelease()
    If mAADC <> 0 Then
        SelectObject mAADC, mAAOldBmp
        DeleteDC mAADC
        mAADC = 0
    End If
    If mAABmp <> 0 Then
        DeleteObject mAABmp
        mAABmp = 0
    End If
    mAABits = 0
    mAASurfWidth = 0
    mAASurfHeight = 0
End Sub

Public Property Get ClientLeft() As Single
Attribute ClientLeft.VB_Description = "Returns the left of the client area (the inside of the tab body), in twips. It is already mirrored under RightToLeft."
Attribute ClientLeft.VB_ProcData.VB_Invoke_Property = ";Position"
    Dim iWindowRect As RECT
    
    EnsureDrawn
    ' Contained controls are positioned in plain twips from the left edge, whatever the Scale of
    ' the UserControl is, so under RTL the mirroring has to be done here
    If mRightToLeft Then
        GetClientRect mUserControlHwnd, iWindowRect
        ClientLeft = FixRoundingError(pScaleX(iWindowRect.Right - mClientSpaceData.RECT.Right - 1, vbPixels, vbTwips))
    Else
        ClientLeft = FixRoundingError(pScaleX(mClientSpaceData.RECT.Left, vbPixels, vbTwips))
    End If
End Property

Public Property Get ClientTop() As Single
Attribute ClientTop.VB_Description = "Returns the top of the client area (the inside of the tab body), in twips."
Attribute ClientTop.VB_ProcData.VB_Invoke_Property = ";Position"
    EnsureDrawn
    ClientTop = FixRoundingError(pScaleY(mClientSpaceData.RECT.Top, vbPixels, vbTwips))
End Property

Public Property Get ClientWidth() As Single
Attribute ClientWidth.VB_Description = "Returns the width of the client area (the inside of the tab body), in twips."
Attribute ClientWidth.VB_ProcData.VB_Invoke_Property = ";Position"
    EnsureDrawn
    ClientWidth = FixRoundingError(pScaleX(mClientSpaceData.RECT.Right - mClientSpaceData.RECT.Left + 1, vbPixels, vbTwips))
End Property

Public Property Get ClientHeight() As Single
Attribute ClientHeight.VB_Description = "Returns the height of the client area (the inside of the tab body), in twips."
Attribute ClientHeight.VB_ProcData.VB_Invoke_Property = ";Position"
    EnsureDrawn
    ClientHeight = FixRoundingError(pScaleY(mClientSpaceData.RECT.Bottom - mClientSpaceData.RECT.Top + 1, vbPixels, vbTwips))
End Property

Private Sub EnsureDrawn()
    Dim c  As Long
    
    If (Not mFirstDraw) Or tmrDraw.Enabled Or mDrawMessagePosted Then
        mEnsuringDrawn = True
        Draw
        Do Until Not (mDrawMessagePosted Or tmrDraw.Enabled)
            Draw
            c = c + 1
            If c > 5 Then Exit Do
        Loop
        mEnsuringDrawn = False
    End If
End Sub


' nSplitRow, when above zero, is the first row of the source that the caller knows does not
' change from one call to the next - the top of the body, in the as-Top frame. It is a hint
' and nothing more: the rotation checks it against the pixels themselves. Zero, which is what
' every caller but the drawing stage passes, rotates the whole bitmap the way it always did
Private Function RotatePic(ByVal srcPic As IPictureDisp, ByVal direction As NTRotatePicDirectionConstants, Optional ByVal nSplitRow As Long = 0) As IPictureDisp
    ' Dispatcher. An icon's Handle is an HICON, which is a USER object and cannot be selected into a
    ' DC, so the bitmap path below produces garbage for icons.
    If srcPic Is Nothing Then Exit Function
    If srcPic.Handle = 0 Then Exit Function

    If srcPic.Type = vbPicTypeIcon Then
        Set RotatePic = RotateIconPic(srcPic, direction)
    Else
        Set RotatePic = RotateBitmapPic(srcPic, direction, nSplitRow)
    End If
End Function

Private Function RotateIconPic(ByVal srcPic As IPictureDisp, ByVal direction As NTRotatePicDirectionConstants) As IPictureDisp
    Dim utIconSrc As ICONINFO
    Dim utIconDest As ICONINFO
    Dim iIconNew As LongPtr

    If GetIconInfo(srcPic.Handle, utIconSrc) = 0 Then Exit Function

    utIconDest.fIcon = 1
    utIconDest.hbmMask = RotateBitmapHandle(utIconSrc.hbmMask, direction)
    If utIconSrc.hbmColor <> 0 Then
        utIconDest.hbmColor = RotateBitmapHandle(utIconSrc.hbmColor, direction)
    End If
    If utIconDest.hbmMask <> 0 Then iIconNew = CreateIconIndirect(utIconDest)

    ' GetIconInfo returns copies of both bitmaps, and CreateIconIndirect copies
    ' them again, so every handle here is ours to release
    If utIconSrc.hbmMask <> 0 Then DeleteObject utIconSrc.hbmMask
    If utIconSrc.hbmColor <> 0 Then DeleteObject utIconSrc.hbmColor
    If utIconDest.hbmMask <> 0 Then DeleteObject utIconDest.hbmMask
    If utIconDest.hbmColor <> 0 Then DeleteObject utIconDest.hbmColor

    Set RotateIconPic = CreatePicture(iIconNew, vbPicTypeIcon)
End Function

Private Function RotateBitmapHandle(ByVal nBmpSrc As LongPtr, ByVal direction As NTRotatePicDirectionConstants) As LongPtr
    ' Rotates a loose HBITMAP.
    Dim pt(0 To 2) As POINTAPI
    Dim utBmp As BITMAP
    Dim iDCScreen As LongPtr
    Dim iDCSrc As LongPtr
    Dim iDCDest As LongPtr
    Dim iBmpDest As LongPtr
    Dim iOldBmpSrc As LongPtr
    Dim iOldBmpDest As LongPtr
    Dim iDestWidth As Long
    Dim iDestHeight As Long

    If nBmpSrc = 0 Then Exit Function
    If GetObjectW(nBmpSrc, Len(utBmp), utBmp) = 0 Then Exit Function
    If utBmp.bmWidth = 0 Or utBmp.bmHeight = 0 Then Exit Function

    Select Case direction
        Case nt90DegreesClockWise, nt90DegreesCounterClockWise, nt90DegreesClockWiseFlipped, nt90DegreesCounterClockWiseFlipped
            iDestWidth = utBmp.bmHeight
            iDestHeight = utBmp.bmWidth
        Case Else
            iDestWidth = utBmp.bmWidth
            iDestHeight = utBmp.bmHeight
    End Select

    ' PlgBlt maps the source rectangle corners onto three destination points:
    ' pt(0) = top-left, pt(1) = top-right, pt(2) = bottom-left
    Select Case direction
        Case nt90DegreesClockWise
            pt(0).X = iDestWidth
            pt(0).Y = 0
            pt(1).X = iDestWidth
            pt(1).Y = iDestHeight
            pt(2).X = 0
            pt(2).Y = 0
        Case nt90DegreesCounterClockWise
            pt(0).X = 0
            pt(0).Y = iDestHeight
            pt(1).X = 0
            pt(1).Y = 0
            pt(2).X = iDestWidth
            pt(2).Y = iDestHeight
        Case ntFlipVertical
            pt(0).X = 0
            pt(0).Y = iDestHeight
            pt(1).X = iDestWidth
            pt(1).Y = iDestHeight
            pt(2).X = 0
            pt(2).Y = 0
        Case ntFlipHorizontal
            pt(0).X = iDestWidth
            pt(0).Y = 0
            pt(1).X = 0
            pt(1).Y = 0
            pt(2).X = iDestWidth
            pt(2).Y = iDestHeight
        Case nt90DegreesClockWiseFlipped
            pt(0).X = 0
            pt(0).Y = 0
            pt(1).X = 0
            pt(1).Y = iDestHeight
            pt(2).X = iDestWidth
            pt(2).Y = 0
        Case nt90DegreesCounterClockWiseFlipped
            pt(0).X = iDestWidth
            pt(0).Y = iDestHeight
            pt(1).X = iDestWidth
            pt(1).Y = 0
            pt(2).X = 0
            pt(2).Y = iDestHeight
        Case nt180Degrees
            pt(0).X = iDestWidth
            pt(0).Y = iDestHeight
            pt(1).X = 0
            pt(1).Y = iDestHeight
            pt(2).X = iDestWidth
            pt(2).Y = 0
    End Select

    iDCScreen = GetDC(0)
    iDCSrc = CreateCompatibleDC(iDCScreen)
    iOldBmpSrc = SelectObject(iDCSrc, nBmpSrc)

    ' An icon mask is a 1bpp bitmap; CreateCompatibleBitmap would return a
    ' colour bitmap here, which is useless as a mask
    If utBmp.bmPlanes = 1 And utBmp.bmBitsPixel = 1 Then
        iBmpDest = CreateBitmap(iDestWidth, iDestHeight, 1, 1, 0)
    Else
        iBmpDest = CreateCompatibleBitmap(iDCScreen, iDestWidth, iDestHeight)
    End If
    iDCDest = CreateCompatibleDC(iDCScreen)
    iOldBmpDest = SelectObject(iDCDest, iBmpDest)

    PlgBlt iDCDest, pt(0), iDCSrc, 0, 0, utBmp.bmWidth, utBmp.bmHeight, ByVal 0&, ByVal 0&, ByVal 0&

    SelectObject iDCDest, iOldBmpDest
    DeleteDC iDCDest
    SelectObject iDCSrc, iOldBmpSrc
    DeleteDC iDCSrc
    ReleaseDC 0, iDCScreen

    RotateBitmapHandle = iBmpDest
End Function

#If ROTATECACHE = 1 Then ' TEMP diagnostic
' Releases every surface the rotation cache holds. Called on a size or direction change and
' from DoTerminate: these are GDI objects and nothing else frees them
Private Sub RotCacheRelease()
    If mRotCacheSrcDC <> 0 Then
        SelectObject mRotCacheSrcDC, mRotCacheSrcOldBmp
        DeleteDC mRotCacheSrcDC
        mRotCacheSrcDC = 0
    End If
    If mRotCacheSrcBmp <> 0 Then
        DeleteObject mRotCacheSrcBmp
        mRotCacheSrcBmp = 0
    End If
    If mRotCacheCmpDC <> 0 Then
        SelectObject mRotCacheCmpDC, mRotCacheCmpOldBmp
        DeleteDC mRotCacheCmpDC
        mRotCacheCmpDC = 0
    End If
    If mRotCacheCmpBmp <> 0 Then
        DeleteObject mRotCacheCmpBmp
        mRotCacheCmpBmp = 0
    End If
    If mRotCacheRotDC <> 0 Then
        SelectObject mRotCacheRotDC, mRotCacheRotOldBmp
        DeleteDC mRotCacheRotDC
        mRotCacheRotDC = 0
    End If
    If mRotCacheRotBmp <> 0 Then
        DeleteObject mRotCacheRotBmp
        mRotCacheRotBmp = 0
    End If
    mRotCacheSrcBits = 0
    mRotCacheCmpBits = 0
    mRotCacheSrcWidth = 0
    mRotCacheSrcHeight = 0
    mRotCacheRotWidth = 0
    mRotCacheRotHeight = 0
    mRotCacheFilled = False
End Sub

' Makes sure the three surfaces exist at the sizes asked for, and returns whether they do.
' The two as-Top ones are top-down DIB sections - negative biHeight - so that row y starts at
' the bits plus y times the stride and the band to compare is one contiguous run. The rotated
' one only ever gets blitted, so it can be a plain compatible bitmap
Private Function RotCacheEnsureSurfaces(ByVal nHdcRef As LongPtr, ByVal nSrcWidth As Long, ByVal nSrcHeight As Long, ByVal nRotWidth As Long, ByVal nRotHeight As Long) As Boolean
    Dim utBICache As BITMAPINFO
    
    If (nSrcWidth <= 0) Or (nSrcHeight <= 0) Or (nRotWidth <= 0) Or (nRotHeight <= 0) Then Exit Function
    If (nSrcWidth = mRotCacheSrcWidth) And (nSrcHeight = mRotCacheSrcHeight) And (nRotWidth = mRotCacheRotWidth) And (nRotHeight = mRotCacheRotHeight) Then
        RotCacheEnsureSurfaces = (mRotCacheSrcBmp <> 0) And (mRotCacheCmpBmp <> 0) And (mRotCacheRotBmp <> 0)
        Exit Function
    End If
    ' any size change makes everything held here meaningless, including the rotated image
    RotCacheRelease
    utBICache.bmiHeader.biSize = Len(utBICache.bmiHeader)
    utBICache.bmiHeader.biWidth = nSrcWidth
    utBICache.bmiHeader.biHeight = -nSrcHeight
    utBICache.bmiHeader.biPlanes = 1
    utBICache.bmiHeader.biBitCount = 32
    utBICache.bmiHeader.biCompression = 0
    mRotCacheSrcBmp = CreateDIBSection(nHdcRef, utBICache, 0, mRotCacheSrcBits, 0, 0)
    mRotCacheCmpBmp = CreateDIBSection(nHdcRef, utBICache, 0, mRotCacheCmpBits, 0, 0)
    mRotCacheRotBmp = CreateCompatibleBitmap(nHdcRef, nRotWidth, nRotHeight)
    If (mRotCacheSrcBmp = 0) Or (mRotCacheCmpBmp = 0) Or (mRotCacheRotBmp = 0) Then
        RotCacheRelease
        Exit Function
    End If
    mRotCacheSrcDC = CreateCompatibleDC(nHdcRef)
    mRotCacheCmpDC = CreateCompatibleDC(nHdcRef)
    mRotCacheRotDC = CreateCompatibleDC(nHdcRef)
    If (mRotCacheSrcDC = 0) Or (mRotCacheCmpDC = 0) Or (mRotCacheRotDC = 0) Then
        RotCacheRelease
        Exit Function
    End If
    mRotCacheSrcOldBmp = SelectObject(mRotCacheSrcDC, mRotCacheSrcBmp)
    mRotCacheCmpOldBmp = SelectObject(mRotCacheCmpDC, mRotCacheCmpBmp)
    mRotCacheRotOldBmp = SelectObject(mRotCacheRotDC, mRotCacheRotBmp)
    mRotCacheSrcWidth = nSrcWidth
    mRotCacheSrcHeight = nSrcHeight
    mRotCacheRotWidth = nRotWidth
    mRotCacheRotHeight = nRotHeight
    mRotCacheFilled = False
    RotCacheEnsureSurfaces = True
End Function
#End If

#If ROTATECACHE = 1 Then ' TEMP diagnostic
' Rotates one horizontal band of the source - rows nBandTop to nBandTop + nBandHeight - 1 - into
' the place that band occupies inside the full rotated image, and leaves the rest of the
' destination alone. Called once per band, it paints exactly what the single whole-bitmap PlgBlt
' painted.
' THE POINT OF THIS ROUTINE, and the reason it takes nPt instead of the direction: the band's
' three destination points are derived from the three the caller already worked out, by walking
' down the source's Y axis. The map is affine, so the image of source row y is the image of row
' 0 displaced y times whatever one row is worth, and that step is nPt(2) minus nPt(0) over the
' source height. Every correction the caller applied - the -1s of the mirroring directions - is
' inside those points already and travels here for free; deriving them from the direction would
' mean writing that table a second time. The division is exact: the step is -1, 0 or 1
Private Function RotateBlitBand(ByVal nHdcDest As LongPtr, ByRef nPt() As POINTAPI, ByVal nHdcSrc As LongPtr, ByVal nSrcWidth As Long, ByVal nSrcHeight As Long, ByVal nBandTop As Long, ByVal nBandHeight As Long) As Long
    Dim iPt(0 To 2) As POINTAPI
    Dim iTabSideTrim As Long
    Dim iSrcX As Long
    Dim iSrcY As Long
    Dim iStepX As Long
    Dim iStepY As Long
    
    If nBandHeight <= 0 Then Exit Function
    If nSrcHeight <= 0 Then Exit Function
    iStepX = (nPt(2).X - nPt(0).X) \ nSrcHeight
    iStepY = (nPt(2).Y - nPt(0).Y) \ nSrcHeight
    ' where the band's top left corner lands, and its top right one
    iPt(0).X = nPt(0).X + nBandTop * iStepX
    iPt(0).Y = nPt(0).Y + nBandTop * iStepY
    iPt(1).X = nPt(1).X + nBandTop * iStepX
    iPt(1).Y = nPt(1).Y + nBandTop * iStepY
    ' and its bottom left one, which is the top one carried down the band's own height
    iPt(2).X = nPt(0).X + (nBandTop + nBandHeight) * iStepX
    iPt(2).Y = nPt(0).Y + (nBandTop + nBandHeight) * iStepY
    RotateBlitBand = PlgBlt(nHdcDest, iPt(0), nHdcSrc, 0, nBandTop, nSrcWidth, nBandHeight, ByVal 0&, ByVal 0&, ByVal 0&)
End Function
#End If

Private Function RotateBitmapPic(ByVal srcPic As IPictureDisp, ByVal direction As NTRotatePicDirectionConstants, Optional ByVal nSplitRow As Long = 0) As IPictureDisp
    Dim pt(0 To 2) As POINTAPI
#If ROTATECACHE = 1 Then ' TEMP diagnostic
    Dim iCacheReady As Boolean
    Dim iCacheHit As Boolean
    Dim iCacheStride As Long
    Dim iCacheOffset As Long
    Dim iCacheBytes As Long
    Dim iSwapPtr As LongPtr
#End If
    Dim hdcDestMem As LongPtr
    Dim hBmpDestMem As LongPtr
    Dim hOldBmpDestMem As LongPtr
    Dim iWidth As Long, iHeight As Long
    Dim bResult As Long
    Dim picWidth As Long, picHeight As Long
    Dim rotatedWidth As Long, rotatedHeight As Long
    Dim hdcScreen As LongPtr
    Dim hdcOriginal As LongPtr
    Dim hBmpSrc As LongPtr
    Dim hOldBmpOriginal As LongPtr

    ' Get original bitmap handle from StdPicture
    hBmpSrc = srcPic.Handle

    ' Get width and height in pixels from StdPicture, which reports himetric
    picWidth = pScaleX(srcPic.Width, vbHimetric, vbPixels)
    picHeight = pScaleY(srcPic.Height, vbHimetric, vbPixels)

    ' THE -1s IN THE POINTS BELOW - read this before changing any of them.

    ' Determine rotated dimensions
    Select Case direction
        Case nt90DegreesClockWise, nt90DegreesCounterClockWise, nt90DegreesClockWiseFlipped, nt90DegreesCounterClockWiseFlipped
            rotatedWidth = picHeight
            rotatedHeight = picWidth
        Case Else
            rotatedWidth = picWidth
            rotatedHeight = picHeight
    End Select

    hdcScreen = GetDC(0)

    ' Get a DC compatible to draw original bitmap into memory DC
    ' Create DC for original bitmap and select original bitmap
    hdcOriginal = CreateCompatibleDC(hdcScreen)
    hOldBmpOriginal = SelectObject(hdcOriginal, hBmpSrc)

#If ROTATECACHE = 1 Then ' TEMP diagnostic
    ' The whole decision is taken here, and it is taken by looking at the pixels.
    mRotCacheLastHit = False
    If (nSplitRow > 0) And (nSplitRow < picHeight) Then
        iCacheReady = RotCacheEnsureSurfaces(hdcScreen, picWidth, picHeight, rotatedWidth, rotatedHeight)
        If iCacheReady Then
            BitBlt mRotCacheCmpDC, 0, 0, picWidth, picHeight, hdcOriginal, 0, 0, vbSrcCopy
            GdiFlush
            If mRotCacheFilled And (mRotCacheDirection = direction) Then
                iCacheStride = picWidth * 4 ' 32 bpp, so the stride is already a multiple of four
                iCacheOffset = nSplitRow * iCacheStride
                iCacheBytes = (picHeight - nSplitRow) * iCacheStride
                If RtlCompareMemory(mRotCacheCmpBits + iCacheOffset, mRotCacheSrcBits + iCacheOffset, iCacheBytes) = iCacheBytes Then
                    iCacheHit = True
                    mRotCacheLastHit = True
                End If
            End If
        End If
    End If
#End If

    ' Create Destination memory DC and bitmap for rotated image
    hdcDestMem = CreateCompatibleDC(hdcScreen)
    hBmpDestMem = CreateCompatibleBitmap(hdcScreen, rotatedWidth, rotatedHeight)
    hOldBmpDestMem = SelectObject(hdcDestMem, hBmpDestMem)

    ' Set points for PlgBlt based on rotation direction
    Select Case direction
        Case nt90DegreesClockWise ' 90 degrees clockwise
            pt(0).X = rotatedWidth
            pt(0).Y = 0
            pt(1).X = rotatedWidth
            pt(1).Y = rotatedHeight
            pt(2).X = 0
            pt(2).Y = 0
        Case nt90DegreesCounterClockWise ' 270 degrees / 90 counter-clockwise
            pt(0).X = 0
            pt(0).Y = rotatedHeight
            pt(1).X = 0
            pt(1).Y = 0
            pt(2).X = rotatedWidth
            pt(2).Y = rotatedHeight
        Case ntFlipVertical ' Vertical flip: (x, y) -> (x, H - 1 - y)
            ' Only the vertical contribution is negative, so all three points go back by one on Y
            ' and none of them moves on X.
            pt(0).X = 0
            pt(0).Y = rotatedHeight - 1
            pt(1).X = rotatedWidth
            pt(1).Y = rotatedHeight - 1
            pt(2).X = 0
            pt(2).Y = -1
        Case ntFlipHorizontal ' Horizontal flip: (x, y) -> (W - 1 - x, y)
            ' The mirror image of the case above: all three points back by one on X, none
            ' of them moving on Y
            pt(0).X = rotatedWidth - 1
            pt(0).Y = 0
            pt(1).X = -1
            pt(1).Y = 0
            pt(2).X = rotatedWidth - 1
            pt(2).Y = rotatedHeight
        Case nt90DegreesClockWiseFlipped ' 90 clockwise then horizontal flip: (x, y) -> (y, x)
            pt(0).X = 0
            pt(0).Y = 0
            pt(1).X = 0
            pt(1).Y = rotatedHeight
            pt(2).X = rotatedWidth
            pt(2).Y = 0
        Case nt90DegreesCounterClockWiseFlipped ' 90 counter-clockwise then horizontal flip: (x, y) -> (H - y, W - x)
            ' The reflection about the anti-diagonal.
            pt(0).X = rotatedWidth
            pt(0).Y = rotatedHeight
            pt(1).X = rotatedWidth
            pt(1).Y = 0
            pt(2).X = 0
            pt(2).Y = rotatedHeight
        Case nt180Degrees ' vertical flip then horizontal flip: (x, y) -> (W - 1 - x, H - 1 - y)
            ' Both axes are reversed, so all three points are back by one on both
            pt(0).X = rotatedWidth - 1
            pt(0).Y = rotatedHeight - 1
            pt(1).X = -1
            pt(1).Y = rotatedHeight - 1
            pt(2).X = rotatedWidth - 1
            pt(2).Y = -1
    End Select

    ' MEASURED AND DISCARDED, so nobody spends a delivery on it again: having both sides of this
    ' PlgBlt be 32 bpp DIB sections instead of device dependent bitmaps.
#If ROTATECACHE = 1 Then ' TEMP diagnostic
    If iCacheHit Then
        ' the cached picture is the whole rotated image, so pasting it means the band that
        ' does change is the only thing left to rotate - and where that band lands is
        ' RotateBlitBand's business, so no direction is looked at twice
        BitBlt hdcDestMem, 0, 0, rotatedWidth, rotatedHeight, mRotCacheRotDC, 0, 0, vbSrcCopy
        bResult = RotateBlitBand(hdcDestMem, pt, hdcOriginal, picWidth, picHeight, 0, nSplitRow)
    Else
        bResult = PlgBlt(hdcDestMem, pt(0), hdcOriginal, 0, 0, picWidth, picHeight, ByVal 0&, ByVal 0&, ByVal 0&)
        If iCacheReady Then
            ' keep this rotation and the image that produced it, as a pair. Cmp already holds
            ' that image, so the two roles are swapped instead of copying one into the other
            BitBlt mRotCacheRotDC, 0, 0, rotatedWidth, rotatedHeight, hdcDestMem, 0, 0, vbSrcCopy
            iSwapPtr = mRotCacheSrcBmp: mRotCacheSrcBmp = mRotCacheCmpBmp: mRotCacheCmpBmp = iSwapPtr
            iSwapPtr = mRotCacheSrcDC: mRotCacheSrcDC = mRotCacheCmpDC: mRotCacheCmpDC = iSwapPtr
            iSwapPtr = mRotCacheSrcOldBmp: mRotCacheSrcOldBmp = mRotCacheCmpOldBmp: mRotCacheCmpOldBmp = iSwapPtr
            iSwapPtr = mRotCacheSrcBits: mRotCacheSrcBits = mRotCacheCmpBits: mRotCacheCmpBits = iSwapPtr
            mRotCacheDirection = direction
            mRotCacheFilled = True
        End If
    End If
#Else
    ' Perform PlgBlt to rotate/flips in memory
    bResult = PlgBlt(hdcDestMem, pt(0), hdcOriginal, 0, 0, picWidth, picHeight, ByVal 0&, ByVal 0&, ByVal 0&)
#End If

    ' Cleanup original DC
    SelectObject hdcOriginal, hOldBmpOriginal
    DeleteDC hdcOriginal
    ' Cleanup source memory DC
    ReleaseDC 0, hdcScreen

    ' Cleanup destination DC, but keep bitmap to create StdPicture
    SelectObject hdcDestMem, hOldBmpDestMem

    ' Create return StdPicture from rotated bitmap handle
    Set RotateBitmapPic = CreatePicture(hBmpDestMem, vbPicTypeBitmap)

    ' Cleanup destination DC (bitmap still selected in DC for IPicture)
    DeleteDC hdcDestMem
    ' Do NOT delete hBmpDestMem here! It is used by created StdPicture

End Function

Private Function ContainerScaleMode() As ScaleModeConstants
    ContainerScaleMode = vbTwips
    On Error Resume Next
    ContainerScaleMode = UserControl.Extender.Container.ScaleMode
    Err.Clear
End Function

Friend Function FromContainerSizeY(nValue As Variant, Optional nToScale As ScaleModeConstants = vbTwips) As Single
    FromContainerSizeY = pScaleY(nValue, ContainerScaleMode, nToScale)
End Function

Private Function ToContainerSizeY(nValue As Variant, Optional nFromScale As ScaleModeConstants = vbTwips) As Single
    ToContainerSizeY = pScaleY(nValue, nFromScale, ContainerScaleMode)
End Function


Friend Function FromContainerSizeX(nValue As Variant, Optional nToScale As ScaleModeConstants = vbTwips) As Single
    FromContainerSizeX = pScaleX(nValue, ContainerScaleMode, nToScale)
End Function

Private Function ToContainerSizeX(nValue As Variant, Optional nFromScale As ScaleModeConstants = vbTwips) As Single
    ToContainerSizeX = pScaleX(nValue, nFromScale, ContainerScaleMode)
End Function

Private Function FixRoundingError(nNumber As Single, Optional ByVal nDecimals As Long = 3) As Single
    Dim iNum As Single
    
    iNum = Round(nNumber * 10 ^ nDecimals) / 10 ^ nDecimals
    If iNum = Int(iNum) Then
        FixRoundingError = iNum
    Else
        If (ContainerScaleMode = vbTwips) Or (ContainerScaleMode = vbPixels) Then
            FixRoundingError = Round(nNumber)
        Else
            FixRoundingError = nNumber
        End If
    End If
End Function
    
Private Sub SetControlsBackColor(ByVal nColor As Long, Optional ByVal nPrevColor As Long = -1)
    Dim iCtl As Object
    Dim iLng As Long
    Dim iCancel As Boolean
    Dim iControls As Object
    Dim iContainer As Object
    Dim iContainer_Prev As Object
    Dim iStr As String
    Dim iCtlIsNewTab As Boolean
    Dim iLngT As Long
    Dim iLngTS As Long
    
    On Error Resume Next
    Set iControls = UserControl.Parent.Controls
    ' Under a high contrast theme the children get the system color, whatever color the caller
    ' resolved (general or per-tab custom): substituting here, at the one point every delivery
    ' passes through, covers all ten callers at once.
    If mAmbientUserMode And mHandleHighContrastTheme And mHighContrastThemeOn Then nColor = vbButtonFace
    If nPrevColor = -1 Then
        If mControlsBackColor_PrevColor = -1 Then
            nPrevColor = mBackColorSelectedTab
        Else
            nPrevColor = mControlsBackColor_PrevColor
        End If
    End If
    
    If iControls Is Nothing Then ' at least let's change the backcolor of the contained controls in the usercontrol
        For Each iCtl In UserControlContainedControls
            iLng = -1
            iLng = iCtl.BackColor
            If iLng <> -1 Then
                ' iLng <> nColor: writing BackColor again with the value it already has is enough for
                ' the IDE to mark the form as modified
                If (iLng = vbButtonFace) And (nColor <> vbButtonFace) Or (((iLng = nPrevColor) Or (iLng = mControlsBackColor_Applied)) And (iLng <> nColor)) Then
                    iCancel = False
                    iStr = iCtl.Name
                    RaiseEvent ChangeControlBackColor(iStr, TypeName(iCtl), iCancel)
                    If Not iCancel Then
                        iCtl.BackColor = nColor
                    End If
                End If
            End If
        Next
    Else 'let's change the backcolor of all the controls inside the tabs
        For Each iCtl In iControls
            Set iContainer_Prev = Nothing
            iCtlIsNewTab = False
            Set iContainer = Nothing
            Set iContainer = iCtl.Container
            Do Until iContainer Is Nothing
                If iContainer Is UserControl.Extender Then
                    iLng = -1
                    iLng = iCtl.BackColor
                    If TypeName(iCtl) = TypeName(Me) Then
                        iLngT = iCtl.BackColorTabs
                        iLngTS = iCtl.BackColorSelectedTab
                        iCtlIsNewTab = True
                    End If
                    If iLng <> -1 Then
                        If (iLng = vbButtonFace) And (nColor <> vbButtonFace) Or (((iLng = nPrevColor) Or (iLng = mControlsBackColor_Applied)) And (iLng <> nColor)) Then
                            iCancel = False
                            If Not iContainer_Prev Is Nothing Then
                                If iContainer_Prev.Container Is UserControl.Extender Then
                                    iStr = iContainer_Prev.Name
                                    RaiseEvent ChangeControlBackColor(iStr, TypeName(iContainer_Prev), iCancel)
                                End If
                            End If
                            If Not iCancel Then
                                iCancel = False
                                iStr = iCtl.Name
                                RaiseEvent ChangeControlBackColor(iStr, TypeName(iCtl), iCancel)
                                If Not iCancel Then
                                    iCtl.BackColor = nColor
                                End If
                            End If
                        End If
                    End If
                    If iCtlIsNewTab Then
                        If (iLngT = vbButtonFace) And (nColor <> vbButtonFace) Or (((iLngT = nPrevColor) Or (iLngT = mControlsBackColor_Applied)) And (iLngT <> nColor)) Then
                            iCancel = False
                            If Not iContainer_Prev Is Nothing Then
                                If iContainer_Prev.Container Is UserControl.Extender Then
                                    iStr = iContainer_Prev.Name
                                    RaiseEvent ChangeControlBackColor(iStr, TypeName(iContainer_Prev), iCancel)
                                End If
                            End If
                            If Not iCancel Then
                                iCancel = False
                                iStr = iCtl.Name
                                RaiseEvent ChangeControlBackColor(iStr, TypeName(iCtl), iCancel)
                                If Not iCancel Then
                                    iCtl.BackColorTabs = nColor
                                End If
                            End If
                        End If
                        If iLngTS <> iLngT Then
                            If (iLngTS = vbButtonFace) And (nColor <> vbButtonFace) Or (((iLngTS = nPrevColor) Or (iLngTS = mControlsBackColor_Applied)) And (iLngTS <> nColor)) Then
                                iCancel = False
                                If Not iContainer_Prev Is Nothing Then
                                    If iContainer_Prev.Container Is UserControl.Extender Then
                                        iStr = iContainer_Prev.Name
                                        RaiseEvent ChangeControlBackColor(iStr, TypeName(iContainer_Prev), iCancel)
                                    End If
                                End If
                                If Not iCancel Then
                                    iCancel = False
                                    iStr = iCtl.Name
                                    RaiseEvent ChangeControlBackColor(iStr, TypeName(iCtl), iCancel)
                                    If Not iCancel Then
                                        iCtl.BackColorSelectedTab = nColor
                                    End If
                                End If
                            End If
                        End If
                    End If
                End If
                Set iContainer_Prev = iContainer
                Set iContainer = Nothing
                Set iContainer = iContainer_Prev.Container
            Loop
        Next
    End If
    Err.Clear
    mControlsBackColor_PrevColor = nColor
    ' Unconditional: the filter lives in WriteProperties
    mControlsBackColor_Applied = nColor
    Err.Clear
End Sub

Private Sub SetControlsForeColor(ByVal nColor As Long, Optional ByVal nPrevColor As Long = -1)
    ' A caller's previous color is only a guess for the first delivery: after that the children
    ' hold what was delivered last, whatever path delivered it.
    If (nPrevColor <> -1) And (mControlsForeColor_PrevColor <> -1) Then nPrevColor = mControlsForeColor_PrevColor
    ' Same substitution as SetControlsBackColor, see the comment there. It sits in this wrapper and
    ' not in SetControlsForeColor2 so that the tracker sees the color that will actually be applied.
    If mAmbientUserMode And mHandleHighContrastTheme And mHighContrastThemeOn Then
        ' The children hold the color the caller resolved, not the system one, so that is the only
        ' value that can find them - and the substitution is about to overwrite it.
        If nPrevColor = -1 Then nPrevColor = nColor
        nColor = vbButtonText
    End If
    SetControlsForeColor2 nColor, nPrevColor
    mControlsForeColor_PrevColor = nColor
End Sub

Private Sub SetControlsForeColor2(ByVal nColor As Long, Optional ByVal nPrevColor As Long = -1)
    Dim iCtl As Object
    Dim iLng As Long
    Dim iCancel As Boolean
    Dim iControls As Object
    Dim iContainer As Object
    Dim iContainer_Prev As Object
    Dim iStr As String
    Dim iCtlIsNewTab As Boolean
    
    On Error Resume Next
    Set iControls = UserControl.Parent.Controls
    If nPrevColor = -1 Then nPrevColor = mControlsForeColor_PrevColor
    
    If iControls Is Nothing Then ' at least let's change the Forecolor of the contained controls in the usercontrol
        For Each iCtl In UserControlContainedControls
            iLng = -1
            iLng = iCtl.ForeColor
            If iLng <> -1 Then
                ' (iLng <> nColor) for the same reason as in SetControlsBackColor: without it,
                ' a delivery of the color the control already holds writes the property again,
                ' and that redundant write is enough for the IDE to mark the form as modified
                If (iLng = vbButtonText) And (nColor <> vbButtonText) Or ((iLng = nPrevColor) And (iLng <> nColor)) Then
                    iCancel = False
                    iStr = iCtl.Name
                    RaiseEvent ChangeControlForeColor(iStr, TypeName(iCtl), iCancel)
                    If Not iCancel Then
                        iCtl.ForeColor = nColor
                    End If
                End If
            End If
        Next
    Else 'let's change the Forecolor of all the controls inside the tabs
        For Each iCtl In iControls
            Set iContainer_Prev = Nothing
            iCtlIsNewTab = False
            Set iContainer = Nothing
            Set iContainer = iCtl.Container
            Do Until iContainer Is Nothing
                If iContainer Is UserControl.Extender Then
                    iLng = -1
                    If TypeName(iCtl) = TypeName(Me) Then
                        iLng = iCtl.ForeColorSelectedTab
                        iCtlIsNewTab = True
                    Else
                        iLng = iCtl.ForeColor
                    End If
                    If iLng <> -1 Then
                        If (iLng = vbButtonText) And (nColor <> vbButtonText) Or ((iLng = nPrevColor) And (iLng <> nColor)) Then
                            iCancel = False
                            If Not iContainer_Prev Is Nothing Then
                                If iContainer_Prev.Container Is UserControl.Extender Then
                                    iStr = iContainer_Prev.Name
                                    RaiseEvent ChangeControlForeColor(iStr, TypeName(iContainer_Prev), iCancel)
                                End If
                            End If
                            If Not iCancel Then
                                iCancel = False
                                iStr = iCtl.Name
                                RaiseEvent ChangeControlForeColor(iStr, TypeName(iCtl), iCancel)
                                If Not iCancel Then
                                    If iCtlIsNewTab Then
                                        iCtl.ForeColorSelectedTab = nColor
                                    Else
                                        iCtl.ForeColor = nColor
                                    End If
                                End If
                            End If
                        End If
                    End If
                End If
                Set iContainer_Prev = iContainer
                Set iContainer = Nothing
                Set iContainer = iContainer_Prev.Container
            Loop
        Next
    End If
    Err.Clear
End Sub

' The single place that forces every TDI Forms tab to ask its icon question again. Refresh
' calls it too, and used to carry its own copy of this loop.
' TDIFormsShowTabIcon is a pull: the handler is handed the control's icon colors and answers
' with the colors for that tab, and the answer is kept until the form's window handle changes.
' So when the colors it was given change, every answer already on file was computed from inputs
' that no longer hold and has to be asked for again. Without this, tabs already open kept the
' icon colors of the theme that was in place when their form was docked. Only the flag is
' cleared here - the re-sync happens by itself on the next measure pass, which is where
' TDISyncFormTabIcon is called from
Private Sub TDIInvalidateFormIcons()
    Dim c As Long
    
    If mTDIMode <> ntTDIModeForms Then Exit Sub
    If Not mAmbientUserMode Then Exit Sub
    For c = 0 To UBound(mTDIFormIconLastHwnd)
        mTDIFormIconLastHwnd(c) = 0
    Next c
End Sub

Public Sub Refresh()
Attribute Refresh.VB_Description = "Redraws the control."
    Dim iWv As Boolean
    
    TDIInvalidateFormIcons
    
    iWv = IsWindowVisible(mUserControlHwnd) <> 0
    If iWv Then SendMessage mUserControlHwnd, WM_SETREDRAW, False, 0&
    mBodyReset = True
    If mChangeControlsBackColor Then
        SetControlsProperBackColor
    End If
    If mChangeControlsForeColor Then
        SetControlsProperForeColor
    End If
    StoreControlsTabStop
    mRedraw = True
    mSubclassControlsPaintingPending = True
    mRepaintSubclassedControls = True
    Draw
    If iWv Then SendMessage mUserControlHwnd, WM_SETREDRAW, True, 0&
    If iWv Then RedrawWindow mUserControlHwnd, ByVal 0&, 0&, RDW_INVALIDATE Or RDW_ALLCHILDREN
    If iWv Then UserControl.Refresh
End Sub

Private Sub RaiseEvent_TabMouseEnter(ByVal nTab As Long)
    Dim iDrewSynchronously As Boolean
    Dim iResumePercent As Long
    
    If DraggingATab Then Exit Sub
    mTabData(nTab).Hovered = True
    ' One of the four places the hover base cache may be taken from. All of them are paths
    ' where the only thing that changed is which tab is under the mouse; any other Draw finds
    ' the permission False, paints the strip and rebuilds the base
    mHoverCacheAllowed = True
    RaiseEvent TabMouseEnter(nTab)
    
    mCurrentMousePointerIsHand = False
    If mTabMousePointerHand Then
        If nTab <> mTab Then
            mCurrentMousePointerIsHand = True
            If GetCursor <> IDC_HAND Then
                SetCursor mHandIconHandle
            End If
        End If
    End If
    If (mHighlightEffect <> ntAnimationNone) And (Not mVisualStylesActive) And SystemAnimationsOn Then
        If mFadeOutTab = nTab Then
            ' the mouse came back before this tab finished leaving, so the way in is picked up
            ' where the way out had got to rather than started from nothing
            iResumePercent = mHoverPercent(cSlotOut)
            mFadeOutTab = -1
        End If
        ResolveHoverAnimation nTab, cSlotIn
        mHoverAnimOffsetMs(cSlotIn) = HighlightEffectDurationMs * iResumePercent / 100
        mHoverAnimStartMark(cSlotIn) = AnimTimeMark
        SetHoverGlow cSlotIn, iResumePercent
        tmrHighlightEffect.Enabled = True
    ElseIf (Not mVisualStylesActive) Then
        ' The intensity has to be read here too.
        If mFadeOutTab = nTab Then mFadeOutTab = -1
        ResolveHoverAnimation nTab, cSlotIn
        mHoverAnimOffsetMs(cSlotIn) = 0
        SetHoverGlow cSlotIn, 100
        Draw
        iDrewSynchronously = True
    End If
    ' The post is what repaints for the highlight, and the branch above has just done it: with no
    ' visual styles and no HighlightEffect this line used to buy a second full Draw for every tab
    ' the mouse touched, with nothing changed in between.
    If Not iDrewSynchronously Then
        mHoverCacheAllowed = True ' see the note at the top of this routine
        If (mHighlightGradient <> ntGradientNone) Or mAppearanceIsFlat Or mVisualStylesActive Then PostDrawMessage
    End If
    
    If mThereAreTabsToolTipTexts Then
        If mTabData(nTab).ToolTipText <> "" Then
            ShowTabTTT nTab
        End If
    End If
End Sub

Private Sub RaiseEvent_TabMouseLeave(ByVal nTab As Long)
    mCurrentMousePointerIsHand = False
    If (mHighlightEffectOut <> ntAnimationNone) And (Not mVisualStylesActive) And (mHoverAnimTab = nTab) And SystemAnimationsOn Then
        StartHoverFadeOut nTab
    Else
        If mHoverAnimTab = nTab Then
            ' A fade can be cut short, and a tab's own FlatBarGlowColor is read for tabs that are
            ' not hovered, so leaving it at the fraction it had reached would tint the bar of a tab
            ' nobody is pointing at.
            SetHoverGlow cSlotIn, 100
            mHoverAnimTab = -1
        End If
        ' not an unconditional stop any more: the other slot may still have a tab to walk out, and
        ' the same timer walks the strip buttons
        If (mHoverAnimTab < 0) And (mFadeOutTab < 0) And (Not ButtonHoverAnimRunning) Then tmrHighlightEffect.Enabled = False
    End If
    mTabData(nTab).Hovered = False
    If mTabData(nTab).CloseButtonHovered Then
        mTabData(nTab).CloseButtonHovered = False
        RaiseEvent CloseButtonMouseLeave(nTab)
    End If
    If mMouseIsOverCloseButton_Tab = nTab Then
        mMouseIsOverCloseButton = False
        mMouseIsOverCloseButton_Tab = -1
    End If
    RaiseEvent TabMouseLeave(nTab)
    If nTab <> mTab Then
        If (mHighlightGradient <> ntGradientNone) Or mAppearanceIsFlat Or mVisualStylesActive Then PostDrawMessage
    End If
    mMouseIsOverIcon = False
    mMouseIsOverIcon_Tab = -1
    ' see the note in RaiseEvent_TabMouseEnter. Leave is reached during a drag as well, and
    ' there the strip cache is the one in charge
    If Not DraggingATab Then mHoverCacheAllowed = True
    DrawDelayed
    ' a tab left straight for a strip button is reported after the button took the tip
    If Not mTTTIsForZoneButton Then
        tmrShowTabTTT.Enabled = False
        Set mToolTipEx = Nothing
    End If
End Sub

Private Sub ShowTabTTT(ByVal nTab As Long)
    mTTTIsForZoneButton = False
    tmrShowTabTTT.Enabled = False
    tmrShowTabTTT.Enabled = True
    tmrShowTabTTT.Tag = nTab
End Sub

' The "+" in the zone shows what the button tab carries as TabToolTipText, which is where its text
' lives whether it sits in the strip or in the zone
Private Sub ZoneNewTabButtonTTT()
    If Not mAmbientUserMode Then Exit Sub
    If Not mNewTabButtonInZone Then Exit Sub
    If Not TabIsNewTabButton(mTabs - 1) Then Exit Sub
    If mTabData(mTabs - 1).ToolTipText = "" Then Exit Sub
    tmrShowTabTTT.Enabled = False
    tmrShowTabTTT.Enabled = True
    tmrShowTabTTT.Tag = mTabs - 1
    mTTTZoneButton = 3
    mTTTIsForZoneButton = True
End Sub

Private Sub ZoneStripButtonTTT(ByVal nButton As Long)
    If Not mAmbientUserMode Then Exit Sub
    If StripButtonToolTipText(nButton) = "" Then Exit Sub
    tmrShowTabTTT.Enabled = False
    tmrShowTabTTT.Enabled = True
    mTTTZoneButton = nButton
    mTTTIsForZoneButton = True
End Sub

Private Function StripButtonToolTipText(ByVal nButton As Long) As String
    Select Case nButton
        Case 1
            StripButtonToolTipText = mStripButtonBackToolTipText
        Case 2
            StripButtonToolTipText = mStripButtonForwardToolTipText
        Case 3
            If TabIsNewTabButton(mTabs - 1) Then StripButtonToolTipText = mTabData(mTabs - 1).ToolTipText
        Case 4
            StripButtonToolTipText = mStripButtonListToolTipText
    End Select
End Function

Private Sub CheckIfThereAreTabsToolTipTexts()
    Dim c As Long
    
    mThereAreTabsToolTipTexts = False
    For c = 0 To mTabs - 1
        If mTabData(c).ToolTipText <> "" Then
            mThereAreTabsToolTipTexts = True
            Exit Sub
        End If
    Next c
End Sub

Private Sub SetButtonFaceColor()
    Dim iCol As Long
    
    iCol = TranslatedColor(vbButtonFace)
    ColorRGBToHLS iCol, mButtonFace_H, mButtonFace_L, mButtonFace_S
    
End Sub

Private Sub SetThemedTabTransparentPixels(nIsLeftTab As Boolean, nIsRightTab As Boolean, nIsTopTab As Boolean)
    Dim X As Long
    Dim X2 As Long
    Dim iYLength As Long
    
    If nIsLeftTab Or nIsTopTab Then
        For X = 0 To 5
            iYLength = mTABITEM_TopLeftCornerTransparencyMask(X)
            If iYLength < 0 Then
                iYLength = picAux.ScaleHeight + iYLength + 1
            End If
            If iYLength > 0 Then
                picAux.Line (X, 0)-(X, iYLength), cAuxTransparentColor
            End If
        Next X
    End If
    If nIsRightTab Then
        For X = 0 To 5
            X2 = picAux.ScaleWidth - 1 - X
            iYLength = mTABITEMRIGHTEDGE_RightSideTransparencyMask(X)
            If iYLength < 0 Then
                iYLength = picAux.ScaleHeight + iYLength + 1
            End If
            If iYLength > 0 Then
                picAux.Line (X2, 0)-(X2, iYLength), cAuxTransparentColor
            End If
        Next X
    ElseIf nIsTopTab Then
        For X = 0 To 5
            X2 = picAux.ScaleWidth - 1 - X
            iYLength = mTABITEM_TopRightCornerTransparencyMask(X)
            If iYLength < 0 Then
                iYLength = picAux.ScaleHeight + iYLength + 1
            End If
            If iYLength > 0 Then
                picAux.Line (X2, 0)-(X2, iYLength), cAuxTransparentColor
            End If
        Next X
    End If
    
End Sub

Private Sub EnsureBodyThemedReady()
    Dim iRect As RECT
    Dim iQuarterTurn As Boolean
    Dim iClockWise As Boolean
    Dim iFlipVertical As Boolean
    Dim iPt(0 To 2) As POINTAPI
    Dim iTabSideTrim As Long
    Dim iSrcX As Long
    Dim iSrcY As Long

    If Not mBodyThemedReady Then
        ' The theme fills the rect it is given edge to edge - it keeps no margin inside it - so the
        ' pane has to be asked for at exactly the size it will occupy on screen.
        iQuarterTurn = False
        iClockWise = False
        iFlipVertical = False
        Select Case mTabOrientation
            Case ssTabOrientationTop, ntTabOrientationTopRight
            Case ssTabOrientationBottom, ntTabOrientationBottomRight
                iFlipVertical = True
            Case ssTabOrientationLeft, ntTabOrientationLeftTop, ntTabOrientationLeftHorizontal, ntTabOrientationLeftBottomHorizontal
                ' Left ends on a counterclockwise turn, so the pane is pre-turned clockwise.
                ' The same under RightToLeft, where the whole image ends up mirrored and the
                ' pane with it, shadow on the left
                iQuarterTurn = True
                iClockWise = True
            Case Else
                iQuarterTurn = True
                iClockWise = False
        End Select

        ' The border on the side the tabs sit against is trimmed down to one pixel.
        Select Case mTabOrientation
            Case ssTabOrientationBottom, ntTabOrientationBottomRight
                iTabSideTrim = mThemedBodyBottomBorderPixels - 1
            Case ssTabOrientationLeft, ntTabOrientationLeftTop, ntTabOrientationLeftHorizontal, ntTabOrientationLeftBottomHorizontal
                iTabSideTrim = mThemedBodyLeftBorderPixels - 1
            Case ssTabOrientationRight, ntTabOrientationRightBottom, ntTabOrientationRightHorizontal, ntTabOrientationRightBottomHorizontal
                iTabSideTrim = mThemedBodyRightBorderPixels - 1
            Case Else
                iTabSideTrim = mThemedBodyTopBorderPixels - 1
        End Select
        If iTabSideTrim < 0 Then
            iTabSideTrim = 0
        End If

        iRect.Left = 0
        iRect.Top = 0
        If iQuarterTurn Then
            ' asked for at its on screen size, which is the as-Top size transposed
            iRect.Right = mBodyHeight + iTabSideTrim
            iRect.Bottom = mBodyWidth
        Else
            iRect.Right = mBodyWidth
            iRect.Bottom = mBodyHeight + iTabSideTrim
        End If
        ' Where the copy starts: the trim comes off the side the tabs are on, which is the
        ' near side in Top and Left and the far side in Bottom and Right
        iSrcX = 0
        iSrcY = 0
        Select Case mTabOrientation
            Case ssTabOrientationTop, ntTabOrientationTopRight
                iSrcY = iTabSideTrim
            Case ssTabOrientationLeft, ntTabOrientationLeftTop, ntTabOrientationLeftHorizontal, ntTabOrientationLeftBottomHorizontal
                iSrcX = iTabSideTrim
        End Select
        ' PlgBlt reads a source with RTL layout one column off
        If iQuarterTurn And mRightToLeft Then iSrcX = iSrcX - 1
        picBodyThemed.Width = mBodyWidth
        If mBodyHeight > 0 Then
            picBodyThemed.Height = mBodyHeight
        End If
        picBodyThemed.BackColor = mBackColor
        picBodyThemed.Cls
        If (iRect.Right > 0) And (iRect.Bottom > 0) Then
            picAux.Cls
            picAux.Width = iRect.Right
            picAux.Height = iRect.Bottom
            DrawThemeBackground mTheme, picAux.hDC, TABP_PANE, 0&, iRect, iRect
            ' All three cases go through PlgBlt with the same three points RotateBitmapPic uses, so
            ' the trim can be taken off with the source offset in every one of them.
            If iQuarterTurn Then
                If iClockWise Then
                    iPt(0).X = picBodyThemed.ScaleWidth
                    iPt(0).Y = 0
                    iPt(1).X = picBodyThemed.ScaleWidth
                    iPt(1).Y = picBodyThemed.ScaleHeight
                    iPt(2).X = 0
                    iPt(2).Y = 0
                Else
                    iPt(0).X = 0
                    iPt(0).Y = picBodyThemed.ScaleHeight
                    iPt(1).X = 0
                    iPt(1).Y = 0
                    iPt(2).X = picBodyThemed.ScaleWidth
                    iPt(2).Y = picBodyThemed.ScaleHeight
                End If
                PlgBlt picBodyThemed.hDC, iPt(0), picAux.hDC, iSrcX, iSrcY, mBodyHeight, mBodyWidth, ByVal 0&, ByVal 0&, ByVal 0&
            ElseIf iFlipVertical Then
                ' StretchBlt with a negative destination height and not PlgBlt.
                StretchBlt picBodyThemed.hDC, 0, mBodyHeight - 1, mBodyWidth, -mBodyHeight, picAux.hDC, iSrcX, iSrcY, mBodyWidth, mBodyHeight, vbSrcCopy
            Else
                BitBlt picBodyThemed.hDC, 0, 0, mBodyWidth, mBodyHeight, picAux.hDC, iSrcX, iSrcY, vbSrcCopy
            End If
        End If
        mThemedBodyReferenceTopBackColor = GetPixel(picBodyThemed.hDC, picBodyThemed.ScaleWidth / 2, picBodyThemed.ScaleHeight * 0.1)
        mBodyThemedReady = True
    End If
End Sub

Private Sub EnsureBacksheetThemedReady()
    If Not mBacksheetThemedReady Then
        Dim iCA As COLORADJUSTMENT
        
        EnsureBodyThemedReady
        picBacksheetThemed.Width = picBodyThemed.Width
        picBacksheetThemed.Height = picBodyThemed.Height
        iCA = GetBacksheetColorAdjustment
        picAux2.Cls
        picAux2.Width = picBodyThemed.Width
        picAux2.Height = picBodyThemed.Height
        
        SetStretchBltMode picAux2.hDC, HALFTONE
        SetColorAdjustment picAux2.hDC, iCA
        
        StretchBlt picAux2.hDC, 0, 0, picBodyThemed.Width, picBodyThemed.Height, picBodyThemed.hDC, 0, 0, picBodyThemed.Width, picBodyThemed.Height, vbSrcCopy
        picBacksheetThemed.Cls
        BitBlt picBacksheetThemed.hDC, 0, 0, picAux2.ScaleWidth, picAux2.ScaleHeight, picAux2.hDC, 0, 0, vbSrcCopy
        mBacksheetThemedReady = True
    End If
End Sub

Private Sub SetThemeExtraData()
    Dim iRect As RECT
    Dim X As Long
    Dim X2 As Long
    Dim Y As Long
    Dim iCol As Long
    Dim iCol_H As Integer
    Dim iCol_L As Integer
    Dim iCol_S As Integer
    Dim iToChange As Boolean
    Const cHTolerance As Integer = 3
    Const cLTolerance As Integer = 5
    Const cSTolerance As Integer = 14
    Dim iColB As Long
    Dim iColB_H As Integer
    Dim iColB_L As Integer
    Dim iColB_S As Integer
    Dim iThreshold As Integer
    
    If mThemeExtraDataAlreadySet Then Exit Sub
    mThemeExtraDataAlreadySet = True
    
    iRect.Left = 0
    iRect.Top = 0
    iRect.Right = 30
    iRect.Bottom = 30
    picAux.Width = 30
    picAux.Height = 30
    
    DrawThemeBackground mTheme, picAux.hDC, TABP_TABITEM, TIS_NORMAL, iRect, iRect
    mThemedInactiveReferenceBackColorTabs = GetPixel(picAux.hDC, 15, 27)
    ColorRGBToHLS mThemedInactiveReferenceBackColorTabs, mThemedInactiveReferenceBackColorTabs_H, mThemedInactiveReferenceBackColorTabs_L, mThemedInactiveReferenceBackColorTabs_S
    
    ' transparency mask for top left corner of TABITEM and TABITEMRIGHTEDGE
    For X = 0 To 5
        mTABITEM_TopLeftCornerTransparencyMask(X) = 0
    Next X
    For X = 0 To 5
        For Y = 0 To picAux.ScaleHeight - 1
            iToChange = False
            iCol = GetPixel(picAux.hDC, X, Y)
            ColorRGBToHLS iCol, iCol_H, iCol_L, iCol_S
            If Abs(iCol_H - mButtonFace_H) <= cHTolerance Then
                If Abs(iCol_L - mButtonFace_L) <= cLTolerance Then
                    If Abs(iCol_S - mButtonFace_S) <= cSTolerance Then
                        iToChange = True
                    End If
                End If
            End If
            If Not iToChange Then
                If Y < (6) Then
                    mTABITEM_TopLeftCornerTransparencyMask(X) = Y
                Else
                    mTABITEM_TopLeftCornerTransparencyMask(X) = Y - picAux.ScaleHeight - 1 ' negative values point to pixels left to reach the bottom
                End If
                Exit For
            End If
        Next Y
        If Y = picAux.ScaleHeight Then
            mTABITEM_TopLeftCornerTransparencyMask(X) = -1
        End If
        If mTABITEM_TopLeftCornerTransparencyMask(X) = 0 Then Exit For
    Next X
    
    ' transparency mask for top right corner of TABITEM
    For X = 0 To 5
        mTABITEM_TopRightCornerTransparencyMask(X) = 0
    Next X
    For X = 0 To 5
        X2 = picAux.ScaleWidth - 1 - X
        For Y = 0 To picAux.ScaleHeight - 1
            iToChange = False
            iCol = GetPixel(picAux.hDC, X2, Y)
            ColorRGBToHLS iCol, iCol_H, iCol_L, iCol_S
            If Abs(iCol_H - mButtonFace_H) <= cHTolerance Then
                If Abs(iCol_L - mButtonFace_L) <= cLTolerance Then
                    If Abs(iCol_S - mButtonFace_S) <= cSTolerance Then
                        iToChange = True
                    End If
                End If
            End If
            If Not iToChange Then
                If Y < (6) Then
                    mTABITEM_TopRightCornerTransparencyMask(X) = Y
                Else
                    mTABITEM_TopRightCornerTransparencyMask(X) = Y - picAux.ScaleHeight - 1 ' negative values point to pixels left to reach the bottom
                End If
                Exit For
            End If
        Next Y
        If Y = picAux.ScaleHeight Then
            mTABITEM_TopRightCornerTransparencyMask(X) = -1
        End If
        If mTABITEM_TopRightCornerTransparencyMask(X) = 0 Then Exit For
    Next X
    
    ' transparency mask for right side of TABITEMRIGHTEDGE
    picAux.Cls
    DrawThemeBackground mTheme, picAux.hDC, TABP_TABITEMRIGHTEDGE, TIS_NORMAL, iRect, iRect
    For X = 0 To 5
        mTABITEMRIGHTEDGE_RightSideTransparencyMask(X) = 0
    Next X
    For X = 0 To 5
        X2 = picAux.ScaleWidth - 1 - X
        For Y = 0 To picAux.ScaleHeight - 1
            iToChange = False
            iCol = GetPixel(picAux.hDC, X2, Y)
            ColorRGBToHLS iCol, iCol_H, iCol_L, iCol_S
            If Abs(iCol_H - mButtonFace_H) <= cHTolerance Then
                If Abs(iCol_L - mButtonFace_L) <= cLTolerance Then
                    If Abs(iCol_S - mButtonFace_S) <= cSTolerance Then
                        iToChange = True
                    End If
                End If
            End If
            If Not iToChange Then
                If Y < (6) Then
                    mTABITEMRIGHTEDGE_RightSideTransparencyMask(X) = Y
                Else
                    mTABITEMRIGHTEDGE_RightSideTransparencyMask(X) = Y - picAux.ScaleHeight - 1 ' negative values point to pixels left to reach the bottom
                End If
                Exit For
            End If
        Next Y
        If Y = picAux.ScaleHeight Then
            mTABITEMRIGHTEDGE_RightSideTransparencyMask(X) = -1 ' all the column of pixels
        End If
        If mTABITEMRIGHTEDGE_RightSideTransparencyMask(X) = 0 Then Exit For
    Next X
    
    DrawThemeBackground mTheme, picAux.hDC, TABP_PANE, 0&, iRect, iRect
    iColB = GetPixel(picAux.hDC, 15, 10)
    ColorRGBToHLS iColB, iColB_H, iColB_L, iColB_S
    
    ' The body colour uxtheme paints, for anything drawn over a tab that has to fade toward
    ' its background - see DisabledPicBackColor. None of our own colours is on the screen here
    mThemedBodyBackColor_R = iColB And 255
    mThemedBodyBackColor_G = (iColB \ 256) And 255
    mThemedBodyBackColor_B = (iColB \ 65536) And 255
    
    iThreshold = 120
    mThemedBodyBottomBorderPixels = 0
    Do
        For Y = picAux.ScaleHeight - 9 To picAux.ScaleHeight - 1
            iCol = GetPixel(picAux.hDC, 15, Y)
            ColorRGBToHLS iCol, iCol_H, iCol_L, iCol_S
            If Abs(iCol_L - iColB_L) > iThreshold Then
                mThemedBodyBottomBorderPixels = picAux.ScaleHeight - Y
                Exit For
            End If
        Next Y
        If mThemedBodyBottomBorderPixels = 0 Then
            iThreshold = iThreshold - 10
            If iThreshold < 1 Then
                iThreshold = 20
                Exit Do
            End If
        End If
    Loop While mThemedBodyBottomBorderPixels = 0
    
    mThemedBodyRightBorderPixels = 0
    For X = picAux.ScaleWidth - 9 To picAux.ScaleWidth - 1
        iCol = GetPixel(picAux.hDC, X, 15)
        ColorRGBToHLS iCol, iCol_H, iCol_L, iCol_S
        If Abs(iCol_L - iColB_L) > iThreshold Then
            mThemedBodyRightBorderPixels = picAux.ScaleWidth - X
            Exit For
        End If
    Next X
    
    mThemedBodyTopBorderPixels = 0
    For Y = 9 To 0 Step -1
        iCol = GetPixel(picAux.hDC, 15, Y)
        ColorRGBToHLS iCol, iCol_H, iCol_L, iCol_S
        If Abs(iCol_L - iColB_L) > iThreshold Then
            mThemedBodyTopBorderPixels = Y + 1
            Exit For
        End If
    Next Y
    
    mThemedBodyLeftBorderPixels = 0
    For X = 9 To 0 Step -1
        iCol = GetPixel(picAux.hDC, X, 15)
        ColorRGBToHLS iCol, iCol_H, iCol_L, iCol_S
        If Abs(iCol_L - iColB_L) > iThreshold Then
            mThemedBodyLeftBorderPixels = X + 1
            Exit For
        End If
    Next X

    
    picAux.Cls
End Sub

Private Function GetBacksheetColorAdjustment() As COLORADJUSTMENT
    Dim iCA As COLORADJUSTMENT
    Dim iCol As Long
    Dim iCol_H As Integer
    Dim iCol_L As Integer
    Dim iCol_S As Integer
    Dim c As Long
    Dim iLng As Long
    
    picAux2.Width = 1
    picAux2.Height = 1
    picAux2.Cls
    SetStretchBltMode picAux2.hDC, HALFTONE
    GetColorAdjustment picAux2.hDC, iCA
    
    picAux.Width = 1
    picAux.Height = 1
    SetPixelV picAux.hDC, 0, 0, mThemedBodyReferenceTopBackColor
    
    ' luminance
    c = 0
    Do
        c = c + 1
        StretchBlt picAux2.hDC, 0, 0, 1, 1, picAux.hDC, 0, 0, 1, 1, vbSrcCopy
        iCol = GetPixel(picAux2.hDC, 0, 0)
        ColorRGBToHLS iCol, iCol_H, iCol_L, iCol_S
        If Abs(mThemedInactiveReferenceBackColorTabs_L - iCol_L) < 3 Then
            Exit Do
        ElseIf c > 5 Then
            Exit Do
        End If
        iLng = mThemedInactiveReferenceBackColorTabs_L - iCol_L
        If iLng > 50 Then iLng = 50
        If iLng < -50 Then iLng = -50
        iCA.caBrightness = iLng
        SetColorAdjustment picAux2.hDC, iCA
    Loop
    
    GetBacksheetColorAdjustment = iCA
End Function

Private Sub ResetCachedThemeImages()
    mBodyThemedReady = False
    mBacksheetThemedReady = False
    mSubclassControlsPaintingPending = True
    mRepaintSubclassedControls = True
    mBodyReset = True
End Sub

' TDI mode forms (point 2, ToDo NewTab 2 - Etapa B): syncs a tab's Icon from the underlying
' form window into the STANDARD per-tab Icon properties (TabPicture/TabIconCharHex/TabIconFont/
' TabIconLeftOffset/TabIconTopOffset, plus per-tab CustomColors for the icon colors), instead of
' the old ad-hoc TDIFormIconCustomData subsystem. This way measurement, drawing, and Caption+Icon
' alignment are exactly the same code path as for any other icon - including reserving room for
' the close button. Only re-syncs (and only re-raises TDIFormsShowTabIcon) when the tab's
' underlying form window handle changes, or after Refresh() resets mTDIFormIconLastHwnd.
Private Sub TDISyncFormTabIcon(ByVal nTab As Long)
    Dim iData As Long
    Dim iHwnd As LongPtr
    Dim iIcon As StdPicture
    Dim iWidth As Long
    Dim iHeight As Long
    Dim iUseIconFont As Boolean
    Dim iIconFont As StdFont
    Dim iIconChar As Variant
    Dim iIconColor As Long
    Dim iIconColorHighlighted As Long
    Dim iIconColorSelected As Long
    Dim iIconColorOnEntry As Long
    Dim iIconColorHighlightedOnEntry As Long
    Dim iIconColorSelectedOnEntry As Long
    Dim iLeftOffset As Long
    Dim iTopOffset As Long
    Dim iNoIcon As Boolean
    Dim iIconInColor As Boolean
    Dim iTabHeight As Long
    Dim iCharRect As RECT
    Dim iFontPrev As StdFont
    Dim iCharCode As Long
    
    iData = mTabData(nTab).Data
    iHwnd = mTDIModeFormsFormData_FormHwnd(iData)
    If mTDIFormIconLastHwnd(iData) = iHwnd Then Exit Sub
    
    If Not mTabData(nTab).Picture Is Nothing Then
        Set iIcon = mTabData(nTab).Picture
    Else
        Set iIcon = mTDIModeFormsFormData_FormIcon(iData)
    End If
    
    ' IconWidth and IconHeight go into the event holding the size the icon is to be SHOWN at, not
    ' the size it happens to be.
    If mTDIFormsIconSize = ntTDIFormsIconNative Then
        If Not iIcon Is Nothing Then
            iWidth = pScaleX(iIcon.Width, vbHimetric, vbPixels)
            iHeight = pScaleY(iIcon.Height, vbHimetric, vbPixels)
        Else
            iWidth = 32
            iHeight = 32
        End If
    Else
        iWidth = Round(CDbl(mTDIFormsIconSize) * mDPIX / cPicScaleSourceDPI)
        iHeight = Round(CDbl(mTDIFormsIconSize) * mDPIY / cPicScaleSourceDPI)
    End If
    
    Set iIconFont = New StdFont
    If Not mTabData(nTab).IconFont Is Nothing Then
        If FontExists(mTabData(nTab).IconFont.Name) Then
            iIconFont.Name = mTabData(nTab).IconFont.Name
            iIconFont.Size = 41
            iIconFont.Bold = True
            iIconChar = "&HE160&"
        Else
            iIconFont.Name = "Arial"
            iIconFont.Size = 41
            iIconFont.Bold = True
            iIconChar = "&H2666&"
        End If
        
        Set iFontPrev = picDraw.Font
        Set picDraw.Font = iIconFont
        iTabHeight = (mTabData(nTab).TabRect.Bottom - mTabData(nTab).TabRect.Top)
        If iTabHeight = 0 Then iTabHeight = pScaleY(mTabHeight, vbHimetric, vbPixels)
        Do
            iIconFont.Size = iIconFont.Size - 1
            iCharRect.Left = 0
            iCharRect.Top = 0
            iCharRect.Right = 0
            iCharRect.Bottom = 0
            DrawTextW picDraw.hDC, StrPtr(iIconChar), -1, iCharRect, DT_CALCRECT Or DT_SINGLELINE Or DT_CENTER Or IIf(mRightToLeft, DT_RTLREADING, 0)
            If iIconFont.Size < 5 Then Exit Do
        Loop While ((iCharRect.Bottom - iCharRect.Top) + 8) > iTabHeight
        Set picDraw.Font = iFontPrev
    End If
    
    ' The three are handed to the event holding the control's current colors so a handler can
    ' read them, and kept here to tell apart afterwards what the handler chose from what it
    ' simply left alone
    iIconColor = mIconColor
    iIconColorHighlighted = mIconColorTabHighlighted
    iIconColorSelected = mIconColorSelectedTab
    iIconColorOnEntry = iIconColor
    iIconColorHighlightedOnEntry = iIconColorHighlighted
    iIconColorSelectedOnEntry = iIconColorSelected
    
    RaiseEvent TDIFormsShowTabIcon(mTabData(nTab).TDITabNumber, nTab, GetWindowCaption(iHwnd), iHwnd, iIcon, iLeftOffset, iTopOffset, iWidth, iHeight, iUseIconFont, iIconFont, iIconChar, iIconColor, iIconColorHighlighted, iIconColorSelected, iIconInColor, iNoIcon)
    
    If iNoIcon Then
        Set mTabData(nTab).Picture = Nothing
        mTabData(nTab).PicTargetWidth = 0
        mTabData(nTab).PicTargetHeight = 0
        mTabData(nTab).PicToUseSet = False
        ResetPicDisabled nTab
        mTabData(nTab).IconChar = 0
    ElseIf iUseIconFont Then
        If IsNumeric(iIconChar) Then
            iCharCode = CLng(iIconChar)
        ElseIf VarType(iIconChar) = vbString Then
            If Left$(iIconChar, 2) = "&H" Then
                iCharCode = Val(iIconChar)
            Else
                iCharCode = AscW(iIconChar)
            End If
        Else
            RaiseError 1385, TypeName(Me), "IconChar format not recognized."
        End If
        Set mTabData(nTab).IconFont = iIconFont
        mTabData(nTab).IconFontName = iIconFont.Name
        mTabData(nTab).DoNotUseIconFont = False
        mTabData(nTab).IconChar = iCharCode
        mTabData(nTab).IconInColor = iIconInColor
        mTabData(nTab).IconLeftOffset = iLeftOffset
        mTabData(nTab).IconTopOffset = iTopOffset
    Else
        ' the raw icon, and the wanted size beside it. Scaling here as well would
        ' put two scalers on the same picture with one cache between them
        Set mTabData(nTab).Picture = iIcon
        mTabData(nTab).PicTargetWidth = iWidth
        mTabData(nTab).PicTargetHeight = iHeight
        mTabData(nTab).PicToUseSet = False
        ResetPicDisabled nTab
        mTabData(nTab).IconChar = 0
        mTabData(nTab).IconLeftOffset = iLeftOffset
        mTabData(nTab).IconTopOffset = iTopOffset
    End If
    
    ' A color the handler did not touch follows the resting one only if it was the same to begin
    ' with, the condition Let IconColor uses: a theme can make the two differ on purpose
    If iIconColor <> iIconColorOnEntry Then
        If iIconColorSelected = iIconColorOnEntry Then iIconColorSelected = iIconColor
        If iIconColorHighlighted = iIconColorOnEntry Then iIconColorHighlighted = iIconColor
    End If
    
    ' A color the handler did not touch leaves the tab with no custom color at all, so the tab
    ' follows the control and with it the theme.
    If (iIconColor = iIconColorOnEntry) Or (Not IsValidOLE_COLOR(iIconColor)) Then
        mTabData(nTab).CustomColors.IconColor = Empty
        mTabData(nTab).CustomColors.IconColorMouseHover = Empty
    Else
        mTabData(nTab).CustomColors.IconColor = iIconColor
        mTabData(nTab).CustomColors.IconColorMouseHover = iIconColor
    End If
    If (iIconColorSelected = iIconColorSelectedOnEntry) Or (Not IsValidOLE_COLOR(iIconColorSelected)) Then
        mTabData(nTab).CustomColors.IconColorSelectedTab = Empty
        mTabData(nTab).CustomColors.IconColorMouseHoverSelectedTab = Empty
    Else
        mTabData(nTab).CustomColors.IconColorSelectedTab = iIconColorSelected
        mTabData(nTab).CustomColors.IconColorMouseHoverSelectedTab = iIconColorSelected
    End If
    If (iIconColorHighlighted = iIconColorHighlightedOnEntry) Or (Not IsValidOLE_COLOR(iIconColorHighlighted)) Then
        mTabData(nTab).CustomColors.IconColorTabHighlighted = Empty
    Else
        mTabData(nTab).CustomColors.IconColorTabHighlighted = iIconColorHighlighted
    End If
    ' Five slots written straight into the record, so the cache has to be refreshed here too.
    ' Third time the same lesson turns up: what breaks first when a flag becomes honest is not
    ' who reads it, it is who was producing it without knowing
    ApplyTabChainColorsForTab nTab
    
    mTDIFormIconLastHwnd(iData) = iHwnd
    mSetAutoTabHeightPending = True
End Sub

Private Function MeasureTabIconAndCaption(ByVal nTab As Long) As Long
    Dim iTabMinWidth As Long
    Dim iIconExtent As Long
    Dim iCaptionWidth As Long
    Dim iCaptionRect As RECT
    Dim iTabMaxWidth As Long
    Dim iFlags As Long
    Dim iFontBoldPrev As Boolean
    Dim iCaption As String
    Dim iTabHeight As Long
    Dim iEffectiveIconAlignment As NTIconAlignmentConstants
    Dim iHasIcon As Boolean
    Dim iIconGap As Long
#If STACKEDICONDIAG = 1 Then ' TEMP diagnostic
    Dim iDiagGlyphMetric As GLYPHMETRICS
    Dim iDiagIdentity As MAT2
    Dim iDiagGlyphResult As Long
#End If
    
    ' Resolve the icon alignment the SAME way DrawTabIconAndCaption does, so the width reserved here
    ' matches how the icon will actually be positioned/drawn.
    iEffectiveIconAlignment = mIconAlignment
    ' See the note in DrawTabIconAndCaption: the new tab button has no caption, so it is centred
    ' whatever IconAlignment says.
    If mTabData(nTab).IsNewTabButton Then iEffectiveIconAlignment = ntIconAlignCenteredOnTab
    
    ' TDI mode forms (point 2, ToDo NewTab 2): sync this tab's Icon from the underlying form
    ' window (and the TDIFormsShowTabIcon event) into the standard per-tab Icon properties,
    ' before measuring, so it's treated exactly like any other icon from here on.
    If mTDIMode = ntTDIModeForms Then
        If mTabData(nTab).Data > 0 Then
            TDISyncFormTabIcon nTab
        End If
    End If
    
    ' pic
    If (Not mTabData(nTab).DoNotUseIconFont) And (mTabData(nTab).IconChar <> 0) Then
        Dim iIconCharacter As String
        Dim iIconCharRect As RECT
        Dim iIconFont As StdFont
        
        If mTabData(nTab).IconFont Is Nothing Then
            Set iIconFont = mDefaultIconFont
        Else
            Set iIconFont = mTabData(nTab).IconFont
        End If
        iIconCharacter = ChrU(mTabData(nTab).IconChar)
        iIconCharRect.Left = 0
        iIconCharRect.Top = 0
        iIconCharRect.Right = 0
        iIconCharRect.Bottom = 0
        iFlags = DT_CALCRECT Or DT_SINGLELINE Or DT_CENTER
        Set picAuxIconFont.Font = iIconFont
        DrawTextW picAuxIconFont.hDC, StrPtr(iIconCharacter), -1, iIconCharRect, iFlags Or IIf(mRightToLeft, DT_RTLREADING, 0)
        If (mTabOrientation = ssTabOrientationTop) Or (mTabOrientation = ntTabOrientationTopRight) Or (mTabOrientation = ssTabOrientationBottom) Or (mTabOrientation = ntTabOrientationBottomRight) Or mTabsAreRotatedButCaptionsAreHorizontal Then
            iIconExtent = (iIconCharRect.Right - iIconCharRect.Left)
        Else
            iIconExtent = (iIconCharRect.Bottom - iIconCharRect.Top)
        End If
        If (iEffectiveIconAlignment = ntIconAlignAfterCaption) Or (iEffectiveIconAlignment = ntIconAlignEnd) Then
            If mTabData(nTab).IconLeftOffset > 0 Then
                iIconExtent = iIconExtent + mTabData(nTab).IconLeftOffset * mDPIScale
            End If
        ElseIf (iEffectiveIconAlignment = ntIconAlignBeforeCaption) Or (iEffectiveIconAlignment = ntIconAlignStart) Then
            If mTabData(nTab).IconLeftOffset < 0 Then
                iIconExtent = iIconExtent - mTabData(nTab).IconLeftOffset * mDPIScale
            End If
        End If
        ' Note: the Centered* alignments deliberately don't get the IconLeftOffset compensation here,
        ' because their drawing code ignores IconLeftOffset (the icon is positioned precisely instead).
        iHasIcon = True
    Else
        iIconExtent = 0
        If Not mTabData(nTab).PicToUseSet Then SetPicToUse nTab
        If Not mTabData(nTab).PicToUse Is Nothing Then
            iHasIcon = True
            If (mTabOrientation = ssTabOrientationTop) Or (mTabOrientation = ntTabOrientationTopRight) Or (mTabOrientation = ssTabOrientationBottom) Or (mTabOrientation = ntTabOrientationBottomRight) Or mTabsAreRotatedButCaptionsAreHorizontal Then
                iIconExtent = pScaleX(mTabData(nTab).PicToUse.Width, vbHimetric, vbPixels)
            Else
                iIconExtent = pScaleX(mTabData(nTab).PicToUse.Height, vbHimetric, vbPixels)
            End If
        End If
    End If
    
    ' The distance from the icon to the caption only exists when there is an icon.
    If iHasIcon Then iIconGap = mTabIconDistanceToCaptionDPIScaled
    
    ' caption
    iFontBoldPrev = picAux.FontBold
    
    picAux.FontBold = mFont.Bold Or mHighlightCaptionBoldSelectedTab Or mHighlightCaptionBold
    picAux.FontUnderLine = mFont.Underline Or mHighlightCaptionUnderlinedSelectedTab Or mHighlightCaptionUnderlined
    
    With mTabData(nTab).TabRect
        iCaptionRect.Left = 0
        iCaptionRect.Top = 0
        iCaptionRect.Bottom = .Bottom - .Top - 4
        iCaptionRect.Right = mScaleWidth
    End With
    
    GetTabWidthLimitsPixels iTabMinWidth, iTabMaxWidth
    If iTabMaxWidth > 0 Then
        iCaptionRect.Right = iTabMaxWidth
    End If
    
    iFlags = DT_CALCRECT Or DT_SINGLELINE Or mAlignmentDTFlag Or DT_VCENTER
    ' The italic space stays - it pays for the overhang of the last slanted glyph, which the
    ' measurement does not see.
    iCaption = mTabData(nTab).Caption & IIf(picAux.Font.Italic, " ", "")
    DrawTextW picAux.hDC, StrPtr(iCaption), -1, iCaptionRect, iFlags
    iCaptionWidth = iCaptionRect.Right
    ' The other half of the predicate a few lines above: a gap is the distance BETWEEN two things,
    ' so it needs both of them.
    If iCaptionWidth = 0 Then iIconGap = 0
    
    If picAux.FontBold <> iFontBoldPrev Then
        picAux.FontBold = iFontBoldPrev
    End If
    
    If iEffectiveIconAlignment = ntIconAlignCenteredOnTab Then
        If mCaptionAlignment = ntAlignmentCenter Then
            ' Docked as a centered pair when drawn (see DrawTabIconAndCaption) - needs the
            ' combined width, not just the wider of the two as if they were overlaid.
            MeasureTabIconAndCaption = iIconExtent + iIconGap + iCaptionWidth
        ElseIf iIconExtent > iCaptionWidth Then
            MeasureTabIconAndCaption = iIconExtent
        Else
            MeasureTabIconAndCaption = iCaptionWidth
        End If
    ElseIf (iEffectiveIconAlignment = ntIconAlignAtTop) Or (iEffectiveIconAlignment = ntIconAlignAtBottom) Then
        If iIconExtent > iCaptionWidth Then
            MeasureTabIconAndCaption = iIconExtent
        Else
            MeasureTabIconAndCaption = iCaptionWidth
        End If
#If STACKEDICONDIAG = 1 Then ' TEMP diagnostic
        If mStackedIconDiagCount < 200 Then
            mStackedIconDiagCount = mStackedIconDiagCount + 1
            Debug.Print "SIDIAG meas tab="; nTab; " caption="; mTabData(nTab).Caption; " align="; iEffectiveIconAlignment; " padW="; mTabPaddingWidth; " capAlign="; mCaptionAlignment
            Debug.Print "   picWidth="; iIconExtent; " captionWidth="; iCaptionWidth; " reserved="; MeasureTabIconAndCaption; " closeBtn="; mTabData(nTab).CloseButtonWidth; " hasIcon="; iHasIcon
            If (Not mTabData(nTab).DoNotUseIconFont) And (mTabData(nTab).IconChar <> 0) Then
                iDiagIdentity.eM11.nWhole = 1
                iDiagIdentity.eM22.nWhole = 1
                iDiagGlyphResult = GetGlyphOutlineW(picAuxIconFont.hDC, mTabData(nTab).IconChar, GGO_METRICS, iDiagGlyphMetric, 0, 0, iDiagIdentity)
                Debug.Print "   glyph char=&H"; Hex$(mTabData(nTab).IconChar); " ggoRet="; iDiagGlyphResult; " inkWidth="; iDiagGlyphMetric.gmBlackBoxX; " originX="; iDiagGlyphMetric.gmptGlyphOrigin.X; " advance="; iDiagGlyphMetric.gmCellIncX
            End If
        End If
#End If
        ' No slack of its own.
    Else
        MeasureTabIconAndCaption = iIconExtent + iIconGap + iCaptionWidth
        ' Start/End/CenteredBefore/CenteredAfter reserve no extra width here: see the positioning code
    End If
    
    
#If NEWTABBUTTONDIAG = 1 Then ' TEMP diagnostic
    ' Before the close button width is added, so what is printed is what the icon and the
    ' caption alone asked for. iIconGap is the interesting one: the button has no caption,
    ' so a gap to it is a gap to nothing
    If mTabData(nTab).IsNewTabButton Then
        If mNewTabButtonDiagCount < 200 Then
            mNewTabButtonDiagCount = mNewTabButtonDiagCount + 1
            Debug.Print "NTBDIAG meas padW="; mTabPaddingWidth; " capAlign="; mCaptionAlignment; " align="; iEffectiveIconAlignment; " widthStyle="; mTabWidthStyle2; " wordWrap="; mWordWrap
            Debug.Print "   picWidth="; iIconExtent; " captionWidth="; iCaptionWidth; " iconGap="; iIconGap; " reserved="; MeasureTabIconAndCaption; " padWScaled="; mTabPaddingWidthDPIScaled
        End If
    End If
#End If
    ' Close button (point 1, ToDo NewTab 2). Reserves its own space, independent of the
    ' regular Icon, so a tab can have both a picture/icon and a close button at the same time
    MeasureTabCloseButton nTab
    MeasureTabIconAndCaption = MeasureTabIconAndCaption + mTabData(nTab).CloseButtonWidth
End Function

Private Sub MeasureTabCloseButton(ByVal nTab As Long)
    ' Apart from MeasureTabIconAndCaption because the close button has to be measured even when the
    ' tab widths do not come from the captions.
    Dim iCloseButtonCharacter As String
    Dim iCloseButtonCharRect As RECT

    If TabCloseButtonEffective(nTab) Then
        SetupCloseButtonFont
        iCloseButtonCharacter = ChrU(mCloseButtonCharCode)
        iCloseButtonCharRect.Left = 0
        iCloseButtonCharRect.Top = 0
        iCloseButtonCharRect.Right = 0
        iCloseButtonCharRect.Bottom = 0
        Set picAuxIconFont.Font = mCloseButtonFont
        DrawTextW picAuxIconFont.hDC, StrPtr(iCloseButtonCharacter), -1, iCloseButtonCharRect, DT_CALCRECT Or DT_SINGLELINE Or DT_CENTER
        mTabData(nTab).CloseButtonWidth = (iCloseButtonCharRect.Right - iCloseButtonCharRect.Left) + mCloseButtonPaddingDPIScaled + CloseButtonExtraAir
    Else
        mTabData(nTab).CloseButtonWidth = 0
    End If
End Sub

' Measures the extent along the strip (the tab's "height") that tab nTab needs to show
' its caption (wrapped, if WordWrap is on and the column width requires it), its icon
' and its close button, for the Horizontal TabOrientations
' (mTabsAreRotatedButCaptionsAreHorizontal). This is the per-tab counterpart of
' SetAutoTabHeight, which computes one global TabHeight from single-line text: here the
' caption can wrap to several lines, and where it wraps depends on nColumnWidth (the
' column's final width in pixels, after TabMinWidth/TabMaxWidth were applied).
' Requires MeasureTabIconAndCaption to have run for this tab (it fills CloseButtonWidth).
' The height of the tallest icon among the visible tabs, in the frame the tabs are drawn in, when
' IconAlignment stacks the icon and the caption; zero otherwise. Worked out once per Draw
Private Function StackedIconSlotHeight() As Long
    Dim iTab As Long
    Dim iIconFont As StdFont
    Dim iIconCharacter As String
    Dim iIconCharRect As RECT
    Dim iIconExtent As Long
    
    If (mIconAlignment <> ntIconAlignAtTop) And (mIconAlignment <> ntIconAlignAtBottom) Then Exit Function
    For iTab = 0 To mTabs - 1
        If mTabData(iTab).Visible And (Not mTabData(iTab).IsNewTabButton) Then
            iIconExtent = 0
            If (Not mTabData(iTab).DoNotUseIconFont) And (mTabData(iTab).IconChar <> 0) Then
                If mTabData(iTab).IconFont Is Nothing Then
                    Set iIconFont = mDefaultIconFont
                Else
                    Set iIconFont = mTabData(iTab).IconFont
                End If
                iIconCharacter = ChrU(mTabData(iTab).IconChar)
                iIconCharRect.Left = 0
                iIconCharRect.Top = 0
                iIconCharRect.Right = 0
                iIconCharRect.Bottom = 0
                Set picAuxIconFont.Font = iIconFont
                DrawTextW picAuxIconFont.hDC, StrPtr(iIconCharacter), -1, iIconCharRect, DT_CALCRECT Or DT_SINGLELINE Or DT_CENTER Or IIf(mRightToLeft, DT_RTLREADING, 0)
                iIconExtent = iIconCharRect.Bottom - iIconCharRect.Top
            Else
                If Not mTabData(iTab).PicToUseSet Then SetPicToUse iTab
                If Not mTabData(iTab).PicToUse Is Nothing Then
                    ' In these four the picture is drawn turned, so that it ends upright
                    If (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Or (mTabOrientation = ssTabOrientationRight) Or (mTabOrientation = ntTabOrientationRightBottom) Then
                        iIconExtent = pScaleY(mTabData(iTab).PicToUse.Width, vbHimetric, vbPixels)
                    Else
                        iIconExtent = pScaleY(mTabData(iTab).PicToUse.Height, vbHimetric, vbPixels)
                    End If
                End If
            End If
            If iIconExtent > StackedIconSlotHeight Then StackedIconSlotHeight = iIconExtent
        End If
    Next iTab
End Function

' The room between the icon and the caption of a stacked pair (IconAlignment at top or at bottom):
' 5% of the caption height with its padding, plus one scaled pixel. One number for the height
' that is reserved and for the drawing
Private Function StackedIconGap(ByVal nCaptionHeight As Long) As Long
    StackedIconGap = CLng((nCaptionHeight + 2 * mTabPaddingHeightDPIScaled) * 0.05 + mDPIScale)
End Function

Private Function MeasureTabHeightForHorizontalCaptions(ByVal nTab As Long, ByVal nColumnWidth As Long) As Long
    Dim iCaptionRect As RECT
    Dim iCaption As String
    Dim iFlags As Long
    Dim iFontBoldPrev As Boolean
    Dim iCaptionAvailableWidth As Long
    Dim iIconWidth As Long
    Dim iIconHeight As Long
    Dim iCaptionHeight As Long
    Dim iIconCharacter As String
    Dim iIconCharRect As RECT
    Dim iIconFont As StdFont
    Dim iStacked As Boolean
    
    ' Icon size: width matters when it sits beside the caption (reduces the caption's
    ' available width), height matters to fit vertically (or to stack for AtTop/AtBottom)
    If (Not mTabData(nTab).DoNotUseIconFont) And (mTabData(nTab).IconChar <> 0) Then
        If mTabData(nTab).IconFont Is Nothing Then
            Set iIconFont = mDefaultIconFont
        Else
            Set iIconFont = mTabData(nTab).IconFont
        End If
        iIconCharacter = ChrU(mTabData(nTab).IconChar)
        iFlags = DT_CALCRECT Or DT_SINGLELINE Or DT_CENTER
        Set picAuxIconFont.Font = iIconFont
        DrawTextW picAuxIconFont.hDC, StrPtr(iIconCharacter), -1, iIconCharRect, iFlags Or IIf(mRightToLeft, DT_RTLREADING, 0)
        iIconWidth = iIconCharRect.Right - iIconCharRect.Left
        iIconHeight = iIconCharRect.Bottom - iIconCharRect.Top
    Else
        If Not mTabData(nTab).PicToUseSet Then SetPicToUse nTab
        If Not mTabData(nTab).PicToUse Is Nothing Then
            iIconWidth = pScaleX(mTabData(nTab).PicToUse.Width, vbHimetric, vbPixels)
            iIconHeight = pScaleY(mTabData(nTab).PicToUse.Height, vbHimetric, vbPixels)
        End If
    End If
    
    iStacked = (mIconAlignment = ntIconAlignAtTop) Or (mIconAlignment = ntIconAlignAtBottom)
    
    ' Caption available width inside the column: start from the column width and subtract
    ' the same general padding/flat extras counted when the column width was computed, plus
    ' the icon beside the caption (when not stacked) and the close button
    iCaptionAvailableWidth = nColumnWidth - 2 * mTabPaddingWidthDPIScaled
    If mAppearanceIsFlat Then
        iCaptionAvailableWidth = iCaptionAvailableWidth - IIf(mFlatBarGripHeightDPIScaled > 0, mFlatBarGripHeightDPIScaled, 0) - mFlatBarHeightDPIScaled - mFlatTabBodyGapDPIScaled
    End If
    If Not iStacked Then
        If iIconWidth > 0 Then
            iCaptionAvailableWidth = iCaptionAvailableWidth - iIconWidth - mTabIconDistanceToCaptionDPIScaled
        End If
    End If
    iCaptionAvailableWidth = iCaptionAvailableWidth - mTabData(nTab).CloseButtonWidth
    If iCaptionAvailableWidth < 10 Then iCaptionAvailableWidth = 10
    
    ' Measure the caption height, wrapping with the same flags the drawing code uses
    iFontBoldPrev = picAux.FontBold
    picAux.FontBold = mFont.Bold Or mHighlightCaptionBoldSelectedTab Or mHighlightCaptionBold
    picAux.FontUnderLine = mFont.Underline Or mHighlightCaptionUnderlinedSelectedTab Or mHighlightCaptionUnderlined
    iCaptionRect.Left = 0
    iCaptionRect.Top = 0
    iCaptionRect.Right = iCaptionAvailableWidth
    iCaptionRect.Bottom = 5
    If mWordWrap Then
        iFlags = DT_CALCRECT Or DT_WORDBREAK
    Else
        iFlags = DT_CALCRECT Or DT_SINGLELINE
    End If
    iCaption = mTabData(nTab).Caption & IIf(picAux.Font.Italic, " ", "")
    DrawTextW picAux.hDC, StrPtr(iCaption), -1, iCaptionRect, iFlags Or IIf(mRightToLeft, DT_RTLREADING, 0)
    iCaptionHeight = iCaptionRect.Bottom - iCaptionRect.Top
    If picAux.FontBold <> iFontBoldPrev Then
        picAux.FontBold = iFontBoldPrev
    End If
    
    ' Combine caption and icon: stacked for AtTop/AtBottom, side by side otherwise
    If iStacked Then
        MeasureTabHeightForHorizontalCaptions = iCaptionHeight + iIconHeight + IIf(iIconHeight > 0, StackedIconGap(iCaptionHeight), 0)
    ElseIf iIconHeight > iCaptionHeight Then
        MeasureTabHeightForHorizontalCaptions = iIconHeight
    Else
        MeasureTabHeightForHorizontalCaptions = iCaptionHeight
    End If
    
    ' The vertical padding, both sides, doubled at the point of use like everywhere else.
    MeasureTabHeightForHorizontalCaptions = MeasureTabHeightForHorizontalCaptions + 2 * mTabPaddingHeightDPIScaled
End Function

Public Function IsThemed() As Boolean
Attribute IsThemed.VB_Description = "Returns a boolean value indicating whether the Windows visual styles are applied to the control or not."
    Dim iTheme As LongPtr
    
    IsThemed = VisualStylesEffective And (mBackStyle <> ntTransparent)
    If IsThemed Then
        iTheme = OpenThemeData(mUserControlHwnd, StrPtr("Tab"))
        If iTheme = 0 Then
            IsThemed = False
        Else
            CloseThemeData iTheme
        End If
    End If
End Function

' Obsolete, hidden , left just for binary compatibility
Public Property Get ForceVisualStyles() As Boolean
Attribute ForceVisualStyles.VB_Description = "Hidden property intended for testing purposes. Allows the control to show visual styles on an un-themed IDE."
Attribute ForceVisualStyles.VB_MemberFlags = "40"
    '
End Property

Public Property Let ForceVisualStyles(ByVal nValue As Boolean)
    '
End Property

Private Sub SetVisibleControls(ByVal iPreviousTab As Long)
    Dim iCtl As Object
    Dim iCtlName As Variant
    Dim iContainedControlsString As String
    Dim iHwnd As LongPtr
    Dim c As Long
    Dim iLeft As Long
    Dim iIsLine As Boolean
    
    If mUserControlTerminated Then Exit Sub
    If Not mAmbientUserMode Then CheckIfContainedControlChangedToArray
    
    If (Not mAmbientUserMode) And mChangeControlsBackColor And (mBackColorSelectedTab <> vbButtonFace) Then
        iContainedControlsString = GetContainedControlsString
        If iContainedControlsString <> mLastContainedControlsString Then
            SetControlsProperBackColor
        End If
    End If
    If (Not mAmbientUserMode) And mChangeControlsForeColor And (mForeColorSelectedTab <> vbButtonText) Then
        iContainedControlsString = GetContainedControlsString
        If iContainedControlsString <> mLastContainedControlsString Then
            SetControlsProperForeColor
        End If
    End If
    
    If mSubclassedControlsForMoveHwnds.Count > 0 Then
        For c = 1 To mSubclassedControlsForMoveHwnds.Count
            iHwnd = mSubclassedControlsForMoveHwnds(c)
            DetachMessage Me, iHwnd, WM_WINDOWPOSCHANGING
        Next c
        Set mSubclassedControlsForMoveHwnds = New Collection
    End If
    
    If mPendingLeftOffset <> 0 Then
        DoPendingLeftOffset
    End If
    
    ' hide controls in previous tab
    If mAmbientUserMode Then StoreControlsTabStop
    If (iPreviousTab >= 0) And (iPreviousTab <= UBound(mTabData)) Then
        Set mTabData(iPreviousTab).Controls = New Collection
    End If
    For Each iCtl In UserControlContainedControls
        iIsLine = TypeName(iCtl) = "Line"
        iLeft = -15001
        On Error Resume Next
        If iIsLine Then
            iLeft = iCtl.X1
        Else
            iLeft = iCtl.Left
        End If
        On Error GoTo 0
        If iLeft > -mLeftThresholdHidden Then
            iCtlName = ControlName(iCtl)
            If (iPreviousTab >= 0) And (iPreviousTab <= UBound(mTabData)) Then
                If Not IsControlInOtherTab(iCtlName, iPreviousTab) Then
                    mTabData(iPreviousTab).Controls.Add iCtlName, iCtlName
                End If
            End If
            If iIsLine Then
                iCtl.X1 = iCtl.X1 - mLeftOffsetToHide
                iCtl.X2 = iCtl.X2 - mLeftOffsetToHide
            Else
                iCtl.Left = iCtl.Left - mLeftOffsetToHide
            End If
        End If
    Next
    
    ' show controls in selected tab
    If (mTab > -1) And (mTab < mTabs) Then
        For Each iCtlName In mTabData(mTab).Controls
            Set iCtl = GetContainedControlByName(iCtlName)
            If Not iCtl Is Nothing Then
                On Error Resume Next
                iIsLine = TypeName(iCtl) = "Line"
                If iIsLine Then
                    iCtl.X1 = iCtl.X1 + mLeftOffsetToHide
                    iCtl.X2 = iCtl.X2 + mLeftOffsetToHide
                Else
                    iCtl.Left = iCtl.Left + mLeftOffsetToHide
                End If
                On Error GoTo 0
                If mAmbientUserMode Then
                    On Error Resume Next
                    iCtl.TabStop = mParentControlsTabStop(iCtlName)
                    iCtl.UseMnemonic = mParentControlsUseMnemonic(iCtlName)
                    If TypeName(iCtl) = "ComboBox" Then
                        ' ComboBox fix
                        If iCtl.Style = vbComboDropdown Then
                            iCtl.SelLength = 0
                        End If
                    End If
                    On Error GoTo 0
                    If ControlIsContainer(iCtlName) Then
                        SetTabStopsToParentControlsContainedInControl iCtl
                    End If
                End If
            End If
        Next
    End If
    
    If (Not mAmbientUserMode) And (mChangeControlsBackColor Or mChangeControlsForeColor) Then
        mLastContainedControlsString = iContainedControlsString
    End If
    
    If mSubclassed And (Not mOnlySubclassUserControl) Then
        On Error Resume Next
        For Each iCtl In UserControlContainedControls
            If iCtl.Left < -mLeftThresholdHidden Then
                iHwnd = 0
                iHwnd = GetControlHwnd(iCtl)
                If iHwnd <> 0 Then
                    mSubclassedControlsForMoveHwnds.Add iHwnd
                    AttachMessage Me, iHwnd, WM_WINDOWPOSCHANGING
                End If
            End If
        Next
        Err.Clear
    End If
    
    If mTDIMode = ntTDIModeForms Then
        If iPreviousTab > -1 Then
            If (mTabData(iPreviousTab).Data >= picTDIFormContainer.LBound) And (mTabData(iPreviousTab).Data <= picTDIFormContainer.UBound) Then
               picTDIFormContainer(mTabData(iPreviousTab).Data).Visible = False
            End If
        End If
        If mTab > -1 Then
            If mTabData(mTab).Data > 0 Then
                If (mTabData(mTab).Data >= picTDIFormContainer.LBound) And (mTabData(mTab).Data <= picTDIFormContainer.UBound) Then
                    picTDIFormContainer(mTabData(mTab).Data).Visible = True
                End If
            End If
        End If
    End If
    Err.Clear
End Sub

Private Function GetControlHwnd(nControl As Object) As LongPtr
    On Error Resume Next
    GetControlHwnd = nControl.hWndUserControl
    If GetControlHwnd = 0 Then
        GetControlHwnd = nControl.hWnd
    End If
    Err.Clear
End Function

Private Function GetControlHwnd2(nControl As Object) As LongPtr
    On Error Resume Next
    GetControlHwnd2 = nControl.hWnd
    Err.Clear
End Function

Private Function IsControlInOtherTab(nCtlName As Variant, ByVal nTab As Long) As Boolean
    Dim t As Long
    Dim iStr As String
    
    On Error Resume Next
    For t = 0 To mTabs - 1
        If t <> nTab Then
            iStr = ""
            iStr = mTabData(t).Controls(nCtlName)
            If iStr <> "" Then
                IsControlInOtherTab = True
                Err.Clear
                Exit Function
            End If
        End If
    Next t
    Err.Clear
End Function

Private Function GetContainedControlsString() As String
    Dim iCtl As Object
    
    For Each iCtl In UserControlContainedControls
        GetContainedControlsString = GetContainedControlsString & iCtl.Name
    Next
End Function

Private Sub StoreControlsTabStop(Optional nInitialize As Boolean)
    Dim iControls As Object
    Dim iCtl As Object
    Dim iContainer As Object
    Dim iContainer_Prev As Object
    Dim iStr As String
    Dim iParent As Object
    Dim iVisible As Boolean
    
    On Error Resume Next
    Set iParent = UserControl.Parent
    Set iControls = iParent.Controls
    If iControls Is Nothing Then ' this parent doesn't have a controls collection
        Set iControls = UserControlContainedControls ' let's do it just with the contained controls then
    End If
    For Each iCtl In iControls
        Set iContainer_Prev = Nothing
        Set iContainer = Nothing
        Set iContainer = iCtl.Container
        Do Until iContainer Is Nothing
            If iContainer Is UserControl.Extender Then
                iVisible = False
                If Not (iContainer_Prev Is Nothing Or iContainer_Prev Is iParent) Then ' the control is contained in another control that is contained in the usercontrol
                    iVisible = iContainer_Prev.Left > -mLeftThresholdHidden
                    If iVisible Or nInitialize Then
                        iStr = ControlName(iCtl)
                        mParentControlsTabStop.Add iCtl.TabStop, iStr
                        mParentControlsUseMnemonic.Add iCtl.UseMnemonic, iStr
                        iStr = ControlName(iContainer_Prev)
                        mContainedControlsThatAreContainers.Add iStr, iStr
                        If nInitialize Then
                            If Not iVisible Then
                                iCtl.TabStop = False
                                iCtl.UseMnemonic = False
                            End If
                        Else
                            iCtl.TabStop = False
                            iCtl.UseMnemonic = False
                        End If
                    End If
                Else ' the control is directly contained in the usercontrol
                    iVisible = iCtl.Left > -mLeftThresholdHidden
                    If iVisible Or nInitialize Then
                        iStr = ControlName(iCtl)
                        mParentControlsTabStop.Add iCtl.TabStop, iStr
                        mParentControlsUseMnemonic.Add iCtl.UseMnemonic, iStr
                        If nInitialize Then
                            If Not iVisible Then
                                iCtl.TabStop = False
                                iCtl.UseMnemonic = False
                            End If
                        Else
                            iCtl.TabStop = False
                            iCtl.UseMnemonic = False
                        End If
                    End If
                End If
                Exit Do
            End If
            Set iContainer_Prev = iContainer
            Set iContainer = Nothing
            Set iContainer = iContainer_Prev.Container
        Loop
    Next
    mTabStopsInitialized = True
    Err.Clear
End Sub

Private Sub SubclassControlsPainting()
    Dim iSubclassTheControls As Boolean
    Dim iHwnd As LongPtr
    Dim c As Long
    Dim iBKColor As Long
    Dim iControls As Object
    Dim iCtl As Object
    Dim iContainer As Object
    Dim iContainer_Prev As Object
    Dim iParent As Object
    Dim iVisible As Boolean
    Dim iBackColorSelectedTab As Long
    Dim iCancel As Boolean
    Dim iCtlNotHandled As Boolean
    Dim iCtlTypeName As String
    Dim iStr As String
    Dim iCanSubclass As Boolean
    Dim iMakeLabelsTransparent As Boolean
    
    iCanSubclass = mSubclassed And (Not mOnlySubclassUserControl)
    ' A label has no window: on a themed body it is made transparent with or without subclassing
    iMakeLabelsTransparent = mChangeControlsBackColor And (mVisualStylesActive Or (iCanSubclass And VisualStylesEffective))
    If Not (iCanSubclass Or iMakeLabelsTransparent) Then Exit Sub
    If Not mUserControlShown Then
        If Val(tmrSubclassControls.Tag) < 200 Then
            tmrSubclassControls.Enabled = True
        End If
        tmrSubclassControls.Tag = Val(tmrSubclassControls.Tag) + 1
        Exit Sub
    End If
    tmrSubclassControls.Tag = ""
    mSubclassControlsPaintingPending = False
    
    ' Through VisualStylesEffective: under high contrast there is nothing to blit behind a child,
    ' because the body and the children are all the same system color, so the painting subclass is
    ' dropped instead of being kept on a matching test that could never find anybody
    iSubclassTheControls = iCanSubclass And VisualStylesEffective And mChangeControlsBackColor
    If mSubclassedControlsForPaintingHwnds.Count > 0 Then
        For c = 1 To mSubclassedControlsForPaintingHwnds.Count
            iHwnd = mSubclassedControlsForPaintingHwnds(c)
            DetachMessage Me, iHwnd, WM_PAINT
            DetachMessage Me, iHwnd, WM_MOVE
            If Not iSubclassTheControls And mRepaintSubclassedControls Then
                ' redraw the control
                RedrawWindow iHwnd, ByVal 0&, 0&, RDW_UPDATENOW Or RDW_INVALIDATE Or RDW_INTERNALPAINT Or RDW_ALLCHILDREN
            End If
        Next c
        Set mSubclassedControlsForPaintingHwnds = New Collection
    End If
    
    If mSubclassedFramesHwnds.Count > 0 Then
        For c = 1 To mSubclassedFramesHwnds.Count
            iHwnd = mSubclassedFramesHwnds(c)
            DetachMessage Me, iHwnd, WM_PRINTCLIENT
            DetachMessage Me, iHwnd, WM_MOUSELEAVE
        Next c
        Set mSubclassedFramesHwnds = New Collection
    End If
    
    If Not iSubclassTheControls Then
        mRepaintSubclassedControls = False
    End If
    
    If mChangeControlsBackColor Then
        If Not mChangedControlsBackColor Then
            SetControlsProperBackColor
            mChangedControlsBackColor = True
        End If
    End If
    If mChangeControlsForeColor Then
        If Not mChangedControlsForeColor Then
            SetControlsProperForeColor
            mChangedControlsForeColor = True
        End If
    End If
    
    ' The same resolver the deliveries use.
    iBackColorSelectedTab = BackColorSelectedTabEffective
    
    On Error Resume Next
    Set iParent = UserControl.Parent
    Set iControls = iParent.Controls
    If iControls Is Nothing Then ' this parent doesn't have a controls collection
        Set iControls = UserControlContainedControls ' let's do it just with the contained controls then
    End If
    For Each iCtl In iControls
        iCtlTypeName = TypeName(iCtl)
        iCtlNotHandled = (iCtlTypeName = "ButtonEx") Or (iCtlTypeName = "ButtonExNoFocus")
        If Not iCtlNotHandled Then
            Set iContainer_Prev = Nothing
            Set iContainer = Nothing
            Set iContainer = iCtl.Container
            If iContainer Is Nothing Then
                iHwnd = 0
                iHwnd = GetControlHwnd2(iCtl)
                If iHwnd <> 0 Then
                    Set iContainer = GetContainerByHwnd(iHwnd)
                End If
            End If
            Do Until iContainer Is Nothing
                If iContainer Is UserControl.Extender Then
                    iVisible = False
                    If Not (iContainer_Prev Is Nothing Or iContainer_Prev Is iParent) Then ' the control is contained in another control that is contained in the usercontrol
                        iVisible = iContainer_Prev.Left > -mLeftThresholdHidden
                        If iVisible Then
                            iHwnd = 0
                            iHwnd = GetControlHwnd2(iCtl)
                            If iHwnd <> 0 Then
                                If iSubclassTheControls Then
                                    iBKColor = -1
                                    iBKColor = iCtl.BackColor
                                    If (iBKColor = iBackColorSelectedTab) Then
                                        iCancel = False
                                        If iContainer_Prev.Container Is UserControl.Extender Then
                                            iStr = iContainer_Prev.Name
                                            RaiseEvent ChangeControlBackColor(iStr, TypeName(iContainer_Prev), iCancel)
                                        End If
                                        If Not iCancel Then
                                            iCancel = False
                                            iStr = iCtl.Name
                                            RaiseEvent ChangeControlBackColor(iStr, TypeName(iCtl), iCancel)
                                            If Not iCancel Then
                                                mSubclassedControlsForPaintingHwnds.Add iHwnd, CStr(iHwnd)
                                            End If
                                        End If
                                    End If
                                End If
                                If iCanSubclass And (iCtlTypeName = "Frame") Then
                                    mSubclassedFramesHwnds.Add iHwnd, CStr(iHwnd)
                                End If
                            ElseIf (iCtlTypeName = "Label") Or (iCtlTypeName = "LabelW") Then
                                If iCtl.BackStyle = 1 Then ' solid
                                    If iMakeLabelsTransparent Then
                                        iBKColor = -1
                                        iBKColor = iCtl.BackColor
                                        If (iBKColor = iBackColorSelectedTab) Then
                                            iCancel = False
                                            If iContainer_Prev.Container Is UserControl.Extender Then
                                                iStr = iContainer_Prev.Name
                                                RaiseEvent ChangeControlBackColor(iStr, TypeName(iContainer_Prev), iCancel)
                                            End If
                                            If Not iCancel Then
                                                iCancel = False
                                                iStr = iCtl.Name
                                                RaiseEvent ChangeControlBackColor(iStr, TypeName(iCtl), iCancel)
                                                If Not iCancel Then
                                                    iCtl.BackStyle = 0 ' transparent
                                                End If
                                            End If
                                        End If
                                    End If
                                End If
                            End If
                        End If
                    Else ' the control is directly contained in the usercontrol
                        iVisible = iCtl.Left > -mLeftThresholdHidden
                        If iVisible Then
                            iHwnd = 0
                            iHwnd = GetControlHwnd2(iCtl)
                            If iHwnd <> 0 Then
                                If iSubclassTheControls Then
                                    iBKColor = -1
                                    iBKColor = iCtl.BackColor
                                    If (iBKColor = iBackColorSelectedTab) Then
                                        iCancel = False
                                        iStr = iCtl.Name
                                        RaiseEvent ChangeControlBackColor(iStr, TypeName(iCtl), iCancel)
                                        If Not iCancel Then
                                            mSubclassedControlsForPaintingHwnds.Add iHwnd, CStr(iHwnd)
                                        End If
                                    End If
                                End If
                                If iCanSubclass And (iCtlTypeName = "Frame") Then
                                    mSubclassedFramesHwnds.Add iHwnd, CStr(iHwnd)
                                End If
                            ElseIf (iCtlTypeName = "Label") Or (iCtlTypeName = "LabelW") Then
                                If iCtl.BackStyle = 1 Then ' solid
                                    If iMakeLabelsTransparent Then
                                        iBKColor = -1
                                        iBKColor = iCtl.BackColor
                                        If (iBKColor = iBackColorSelectedTab) Then
                                            iCancel = False
                                            iStr = iCtl.Name
                                            RaiseEvent ChangeControlBackColor(iStr, TypeName(iCtl), iCancel)
                                            If Not iCancel Then
                                                iCtl.BackStyle = 0 ' transparent
                                            End If
                                        End If
                                    End If
                                End If
                            End If
                        End If
                    End If
                    Exit Do
                End If
                Set iContainer_Prev = iContainer
                Set iContainer = Nothing
                Set iContainer = iContainer_Prev.Container
            Loop
        End If
    Next
    On Error GoTo 0
    
    
    For c = 1 To mSubclassedFramesHwnds.Count
        iHwnd = mSubclassedFramesHwnds(c)
        AttachMessage Me, iHwnd, WM_PRINTCLIENT
        AttachMessage Me, iHwnd, WM_MOUSELEAVE
    Next
    For c = 1 To mSubclassedControlsForPaintingHwnds.Count
        iHwnd = mSubclassedControlsForPaintingHwnds(c)
        AttachMessage Me, iHwnd, WM_PAINT
        AttachMessage Me, iHwnd, WM_MOVE
        If mRepaintSubclassedControls Then
            ' redraw the control
            RedrawWindow iHwnd, ByVal 0&, 0&, RDW_UPDATENOW Or RDW_INVALIDATE Or RDW_INTERNALPAINT Or RDW_ALLCHILDREN
        End If
    Next c
    mRepaintSubclassedControls = False
    
End Sub

Private Function GetContainerByHwnd(ByVal nHwnd As LongPtr) As Object
    Dim iParent As Object
    Dim iControls As Object
    Dim iCtl As Object
    Dim iHwndParent As LongPtr
    Dim iHwnd As LongPtr
    
    On Error Resume Next
    Set iParent = UserControl.Extender.Parent
    If iParent Is Nothing Then GoTo Exit_Function
    Set iControls = iParent.Controls
    If iControls Is Nothing Then GoTo Exit_Function
    
    iHwndParent = GetParent(nHwnd)
    
    For Each iCtl In iControls
        iHwnd = 0
        iHwnd = GetControlHwnd(iCtl)
        If iHwnd = iHwndParent Then
            Set GetContainerByHwnd = iCtl
            GoTo Exit_Function
        End If
    Next
    
Exit_Function:
    Err.Clear
End Function

Private Function ControlIsContainer(nControlName As Variant) As Boolean
    Dim iStr As String
    
    On Error Resume Next
    iStr = mContainedControlsThatAreContainers(nControlName)
    ControlIsContainer = Err.Number = 0
    Err.Clear
End Function

Private Sub SetTabStopsToParentControlsContainedInControl(nContainer As Object)
    Dim iControls As Object
    Dim iCtl As Object
    Dim iContainer As Object
    Dim iStr As String
    Dim iObj As Object
    
    If nContainer Is Nothing Then Exit Sub
    On Error Resume Next
    Set iControls = GetContainedControlsInControlContainer(nContainer)
    If Not iControls Is Nothing Then
        For Each iCtl In iControls
            Set iContainer = Nothing
            Set iContainer = iCtl.Container
            Do Until iContainer Is Nothing
                If iContainer Is nContainer Then
                    iStr = ControlName(iCtl)
                    iCtl.TabStop = mParentControlsTabStop(iStr)
                    iCtl.UseMnemonic = mParentControlsUseMnemonic(iStr)
                    If TypeName(iCtl) = "ComboBox" Then
                        ' ComboBox fix
                        If iCtl.Style = vbComboDropdown Then
                            iCtl.SelLength = 0
                        End If
                    End If
                End If
                Set iObj = iContainer
                Set iContainer = Nothing
                Set iContainer = iObj.Container
            Loop
        Next
    End If
    Err.Clear
End Sub

Private Function GetContainedControlsInControlContainer(nContainer As Object) As Object
    Dim iControls As Object
    Dim iCtl As Object
    Dim iContainer As Object
    Dim iContainer_Prev As Object
    
    Set GetContainedControlsInControlContainer = New Collection
    
    If nContainer Is Nothing Then Exit Function
    On Error Resume Next
    Set iControls = UserControl.Parent.Controls
    If iControls Is Nothing Then GoTo Exit_Function
    
    For Each iCtl In iControls
        Set iContainer_Prev = Nothing
        Set iContainer = Nothing
        Set iContainer = iCtl.Container
        Do Until iContainer Is Nothing
            If iContainer Is nContainer Then
                GetContainedControlsInControlContainer.Add iCtl
            End If
            Set iContainer_Prev = iContainer
            Set iContainer = Nothing
            Set iContainer = iContainer_Prev.Container
        Loop
    Next
    
Exit_Function:
    Err.Clear
End Function

Private Function ControlName(nCtl As Object) As String
    Dim iIndex As Integer
    
    On Error GoTo NoIndex:
    ControlName = nCtl.Name
    iIndex = -1
    iIndex = nCtl.Index
    If iIndex >= 0 Then
        ControlName = ControlName & "(" & iIndex & ")"
    End If

NoIndex:
End Function

Private Function GetContainedControlByName(ByVal nControlName As String) As Object
    Dim iCtl As Object

    On Error GoTo ErrorExit
    For Each iCtl In UserControlContainedControls
        If StrComp(nControlName, ControlName(iCtl), vbTextCompare) = 0 Then
            Set GetContainedControlByName = iCtl
            Exit For
        End If
    Next
    
ErrorExit:
End Function

Private Sub SetAccessKeys()
    Dim c As Long
    Dim iPos As Long
    Dim iChr As String
    Dim iAsc As Long
    Dim iAK As String
    
    mAccessKeys = ""
    iAK = ""
    
    For c = 0 To mTabs - 1
        iChr = ""
        If mTabData(c).Enabled And mTabData(c).Visible Then
            iPos = InStr(mTabData(c).Caption, "&")
            If iPos > 0 Then
                iChr = LCase$(Mid$(mTabData(c).Caption, iPos + 1, 1))
                If (iChr <> "") Then
                    iAsc = Asc(iChr)
                    If Not (((iAsc > 47) And (iAsc < 58)) Or ((iAsc > 96) And (iAsc < 123))) Then
                        iChr = ""
                    End If
                End If
            End If
        End If
        iAK = iAK & iChr
        If iChr = "" Then iChr = Chr$(0)
        mAccessKeys = mAccessKeys & iChr
    Next c
    UserControl.AccessKeys = iAK
    mAccessKeysSet = True
End Sub

Private Sub SetPicToUse(ByVal nTab As Long)
    Dim iHasPicNN As Boolean
    
    If mTabData(nTab).PicToUseSet Then Exit Sub
    
    ' Any of the three, not just Pic16: setting only Pic24 used to fall through to
    ' Picture and be ignored, which cannot be what the developer meant by setting it
    iHasPicNN = Not mTabData(nTab).Pic16 Is Nothing Or Not mTabData(nTab).Pic20 Is Nothing Or Not mTabData(nTab).Pic24 Is Nothing
    If iHasPicNN Then
        ' ScalePicturesForDPI deliberately not consulted: supplying a picture under a
        ' name that declares a DPI is itself the statement that it should follow the
        ' DPI. ScalePicturesForDPI only governs Picture, which declares nothing
        Set mTabData(nTab).PicToUse = PicToUseFromPicNN(nTab)
    ElseIf Not mTabData(nTab).Picture Is Nothing Then
        If mTabData(nTab).PicTargetWidth > 0 Then
            ' someone outside the picture said how big it should be - today only TDI Forms does.
            Set mTabData(nTab).PicToUse = PictureScaledToSize(mTabData(nTab).Picture, mTabData(nTab).PicTargetWidth, mTabData(nTab).PicTargetHeight)
        Else
            Set mTabData(nTab).PicToUse = PictureScaledForDPI(mTabData(nTab).Picture)
        End If
    Else
        Set mTabData(nTab).PicToUse = Nothing
    End If
    mTabData(nTab).PicToUseSet = True
    ' PicToUse was just recomputed, so any cached disabled version of the old one
    ' no longer matches
    ResetPicDisabled nTab
End Sub

' Scales a picture authored for 96 DPI to the size it should have at the current
' one. Returns the original untouched whenever scaling would not pay: switched
' off, inside the dead band, or the scaler could not read the source - so the
' caller never has to test anything.
'
' Any size is reachable, not just whole multiples: mNewTabPicScale magnifies to
' the power of two at or above the target and reduces by area from there, so the
' enlarging step is always a pixel art magnifier and the shrinking step never
' invents detail. That replaced a nearest neighbour magnifier that only ran above
' 144 DPI and only by whole factors, which is why 120 and 144 DPI now scale at
' all - the old ladder left them at their 96 DPI size.
'
' Icons are no longer excluded either. The exclusion existed because that
' magnifier went through picAux.PaintPicture, which flattens an icon onto
' picAux's BackColor and loses its transparency; nothing here does that.
Private Function PictureScaledForDPI(nPic As StdPicture) As StdPicture
    Dim iSrcWidth As Long
    Dim iSrcHeight As Long
    Dim iTargetWidth As Long
    Dim iTargetHeight As Long
    Dim iFactor As Single
    
    Set PictureScaledForDPI = nPic
    If mScalePicturesForDPI = ntScalePicturesDisabled Then Exit Function
    If nPic Is Nothing Then Exit Function
    If nPic.Handle = 0 Then Exit Function
    
    ' cheap way out before measuring anything: at this DPI no picture authored for
    ' 96 would move enough to be worth rebuilding
    iFactor = mDPIX / cPicScaleSourceDPI
    If Abs(iFactor - 1) < cPicScaleDeadBand Then Exit Function
    
    PictureSizeInPixels nPic, iSrcWidth, iSrcHeight
    If iSrcWidth <= 0 Or iSrcHeight <= 0 Then Exit Function
    iTargetWidth = Round(iSrcWidth * mDPIX / cPicScaleSourceDPI)
    iTargetHeight = Round(iSrcHeight * mDPIY / cPicScaleSourceDPI)
    ' whether that target is worth acting on is PictureScaledToSize's decision, and
    ' it applies the same dead band to the sizes - a small picture can round back
    ' onto its own size even when the DPI factor did not
    Set PictureScaledForDPI = PictureScaledToSize(nPic, iTargetWidth, iTargetHeight)
End Function

' Scales nPic to an explicit pixel size. Gives the original back whenever there is
' nothing worth doing - it is already that size within the dead band, or the
' scaler could not read it - so no caller has to test what it gets. That is what
' the assignment on the first line is for: every exit below is a plain Exit
' Function and still returns something usable
Private Function PictureScaledToSize(nPic As StdPicture, ByVal nTargetWidth As Long, ByVal nTargetHeight As Long) As StdPicture
    Dim iSrcWidth As Long
    Dim iSrcHeight As Long
    Dim iMaskColor As Long
    Dim iHIcon As LongPtr
    
    Set PictureScaledToSize = nPic
    If nPic Is Nothing Then Exit Function
    If nPic.Handle = 0 Then Exit Function
    If nTargetWidth <= 0 Or nTargetHeight <= 0 Then Exit Function
    PictureSizeInPixels nPic, iSrcWidth, iSrcHeight
    If iSrcWidth <= 0 Or iSrcHeight <= 0 Then Exit Function
    If PicSizeFitsTarget(iSrcWidth, iSrcHeight, nTargetWidth, nTargetHeight) Then Exit Function
    ' resolved here and not inside the scaler, so that module stays free of the
    ' control's colour machinery. -1 means the source carries its own transparency
    If mUseMaskColor Then
        iMaskColor = TranslatedColor(mMaskColor)
    Else
        iMaskColor = -1
    End If
    iHIcon = ScalePictureToIcon(nPic, iMaskColor, iSrcWidth, iSrcHeight, nTargetWidth, nTargetHeight, PicScaleMode)
    ' CreatePicture takes ownership of the handle, the same as in IconToGrayScale
    If iHIcon <> 0 Then Set PictureScaledToSize = CreatePicture(iHIcon, vbPicTypeIcon)
End Function

' Disabled only switches off the DPI scaling of Picture: the scalings to an explicit size
' (PicNN, TDI form icons) still run, balanced
Private Function PicScaleMode() As NTPicScaleModeConstants
    Select Case mScalePicturesForDPI
        Case ntScalePicturesSmooth
            PicScaleMode = ntPicScaleSmooth
        Case ntScalePicturesCrisp
            PicScaleMode = ntPicScaleCrisp
        Case Else
            PicScaleMode = ntPicScaleBalanced
    End Select
End Function

Private Sub PictureSizeInPixels(nPic As StdPicture, nWidth As Long, nHeight As Long)
    nWidth = Round(pScaleX(nPic.Width, vbHimetric, vbPixels))
    nHeight = Round(pScaleY(nPic.Height, vbHimetric, vbPixels))
End Sub

' Chooses among Pic16, Pic20 and Pic24 and scales the chosen one if it is not
' already the right size.
'
' Three steps, in this order: work out what size the icon should be here, use any
' picture that already is that size, and only otherwise scale the one that will
' come out least damaged. The first two are what makes the common cases free -
' at 96, 120 and 144 DPI with the matching picture supplied, nothing is scaled
Private Function PicToUseFromPicNN(ByVal nTab As Long) As StdPicture
    Dim iPic(0 To 2) As StdPicture
    Dim iDPI(0 To 2) As Long
    Dim iWidth(0 To 2) As Long
    Dim iHeight(0 To 2) As Long
    Dim iUsable(0 To 2) As Boolean
    Dim iCompatible(0 To 2) As Boolean
    Dim iIdx As Long
    Dim iRef As Long
    Dim iBest As Long
    Dim iTargetWidth As Long
    Dim iTargetHeight As Long
    Dim iBestWidth As Long
    Dim iDistance As Long
    Dim iBestDistance As Long
    
    Set iPic(0) = mTabData(nTab).Pic16
    Set iPic(1) = mTabData(nTab).Pic20
    Set iPic(2) = mTabData(nTab).Pic24
    iDPI(0) = cPicNNDeclaredDPI16
    iDPI(1) = cPicNNDeclaredDPI20
    iDPI(2) = cPicNNDeclaredDPI24
    For iIdx = 0 To 2
        If Not iPic(iIdx) Is Nothing Then
            If iPic(iIdx).Handle <> 0 Then
                PictureSizeInPixels iPic(iIdx), iWidth(iIdx), iHeight(iIdx)
                iUsable(iIdx) = (iWidth(iIdx) > 0 And iHeight(iIdx) > 0)
            End If
        End If
    Next
    
    ' 1. The reference: the picture drawn for the DPI closest to the one in use.
    iRef = -1
    For iIdx = 0 To 2
        If iUsable(iIdx) Then
            iDistance = Abs(iDPI(iIdx) - mDPIX)
            If iRef = -1 Or iDistance <= iBestDistance Then
                iBestDistance = iDistance
                iRef = iIdx
            End If
        End If
    Next
    If iRef = -1 Then Exit Function
    iTargetWidth = Round(CDbl(iWidth(iRef)) * mDPIX / iDPI(iRef))
    iTargetHeight = Round(CDbl(iHeight(iRef)) * mDPIY / iDPI(iRef))
    
    ' Only a candidate that agrees with the reference about the size may stand in for it.
    For iIdx = 0 To 2
        If iUsable(iIdx) Then
            iCompatible(iIdx) = PicSizeFitsTarget(Round(CDbl(iWidth(iIdx)) * mDPIX / iDPI(iIdx)), Round(CDbl(iHeight(iIdx)) * mDPIY / iDPI(iIdx)), iTargetWidth, iTargetHeight)
        End If
    Next
    iCompatible(iRef) = True
    
    ' 2. Anything already that size, within the dead band, is used untouched. No resampling beats
    ' the pixels the developer drew.
    If PicSizeFitsTarget(iWidth(iRef), iHeight(iRef), iTargetWidth, iTargetHeight) Then
        Set PicToUseFromPicNN = iPic(iRef)
        Exit Function
    End If
    For iIdx = 0 To 2
        If iUsable(iIdx) And iCompatible(iIdx) And iIdx <> iRef Then
            If PicSizeFitsTarget(iWidth(iIdx), iHeight(iIdx), iTargetWidth, iTargetHeight) Then
                Set PicToUseFromPicNN = iPic(iIdx)
                Exit Function
            End If
        End If
    Next
    
    ' 3. Nothing fits: scale the largest one there is.
    iBest = -1
    For iIdx = 0 To 2
        If iUsable(iIdx) And iCompatible(iIdx) Then
            If iBest = -1 Or iWidth(iIdx) > iBestWidth Then
                iBestWidth = iWidth(iIdx)
                iBest = iIdx
            End If
        End If
    Next
    Set PicToUseFromPicNN = PictureScaledToSize(iPic(iBest), iTargetWidth, iTargetHeight)
End Function

' Close enough to the wanted size on both axes that rescaling would cost more
' than it buys
Private Function PicSizeFitsTarget(ByVal nWidth As Long, ByVal nHeight As Long, ByVal nTargetWidth As Long, ByVal nTargetHeight As Long) As Boolean
    If nWidth <= 0 Or nHeight <= 0 Then Exit Function
    If Abs(CDbl(nTargetWidth) / nWidth - 1) > cPicScaleDeadBand Then Exit Function
    If Abs(CDbl(nTargetHeight) / nHeight - 1) > cPicScaleDeadBand Then Exit Function
    PicSizeFitsTarget = True
End Function

Private Function PictureToGrayScale(nPic As StdPicture, ByVal nBackColor As Long) As StdPicture
    Dim utBmp As BITMAP
    Dim utBI As BITMAPINFO
    Dim iBackR As Long
    Dim iBackG As Long
    Dim iBackB As Long
    Dim iBits() As Byte
    Dim iDCScreen As LongPtr
    Dim iDCSrc As LongPtr
    Dim iDCDest As LongPtr
    Dim iBmpDest As LongPtr
    Dim iOldBmpSrc As LongPtr
    Dim iOldBmpDest As LongPtr
    Dim iMaskRef As Long
    Dim iColor As Long
    Dim iPos As Long
    Dim iCount As Long

    ' Works on the bitmap bits directly instead of looping GetPixel/SetPixelV over
    ' two PictureBoxes: one DIB round trip instead of two API calls per pixel, and
    ' the size comes from the bitmap itself rather than from a HIMETRIC conversion.
    If nPic Is Nothing Then Exit Function
    If nPic.Handle = 0 Then Exit Function
    If GetObjectW(nPic.Handle, Len(utBmp), utBmp) = 0 Then Exit Function
    If utBmp.bmWidth <= 0 Or utBmp.bmHeight <= 0 Then Exit Function

    ' The mask colour is compared translated, the same way DrawImage receives it at
    ' draw time; comparing against the raw OLE_COLOR missed every system colour
    iMaskRef = TranslatedColor(mMaskColor)
    ' split once and not inside the per pixel loop
    iBackR = nBackColor And 255
    iBackG = (nBackColor \ 256) And 255
    iBackB = (nBackColor \ 65536) And 255

    ' The source picture belongs to the caller, so the bits are grayed on a copy
    iDCScreen = GetDC(0)
    iDCSrc = CreateCompatibleDC(iDCScreen)
    iOldBmpSrc = SelectObject(iDCSrc, nPic.Handle)
    iDCDest = CreateCompatibleDC(iDCScreen)
    iBmpDest = CreateCompatibleBitmap(iDCScreen, utBmp.bmWidth, utBmp.bmHeight)
    iOldBmpDest = SelectObject(iDCDest, iBmpDest)
    BitBlt iDCDest, 0, 0, utBmp.bmWidth, utBmp.bmHeight, iDCSrc, 0, 0, vbSrcCopy
    SelectObject iDCDest, iOldBmpDest
    DeleteDC iDCDest
    SelectObject iDCSrc, iOldBmpSrc
    DeleteDC iDCSrc

    utBI.bmiHeader.biSize = Len(utBI.bmiHeader)
    utBI.bmiHeader.biWidth = utBmp.bmWidth
    utBI.bmiHeader.biHeight = -utBmp.bmHeight
    utBI.bmiHeader.biPlanes = 1
    utBI.bmiHeader.biBitCount = 32
    utBI.bmiHeader.biCompression = 0
    iCount = utBmp.bmWidth * utBmp.bmHeight * 4
    ReDim iBits(0 To iCount - 1)
    If GetDIBits(iDCScreen, iBmpDest, 0, utBmp.bmHeight, iBits(0), utBI, 0) <> 0 Then
        ' DIB pixels are stored as B, G, R, A
        For iPos = 0 To iCount - 4 Step 4
            iColor = RGB(iBits(iPos + 2), iBits(iPos + 1), iBits(iPos))
            If iColor <> iMaskRef Then
                iColor = ToGray(iColor, iBackR, iBackG, iBackB)
                iBits(iPos) = (iColor \ 65536) And 255
                iBits(iPos + 1) = (iColor \ 256) And 255
                iBits(iPos + 2) = iColor And 255
            End If
        Next
        SetDIBits iDCScreen, iBmpDest, 0, utBmp.bmHeight, iBits(0), utBI, 0
    End If
    ReleaseDC 0, iDCScreen

    ' Do NOT delete iBmpDest - CreatePicture is called with fOwn, so the returned
    ' picture takes ownership of it
    Set PictureToGrayScale = CreatePicture(iBmpDest, vbPicTypeBitmap)
End Function

Private Function IconToGrayScale(nPic As StdPicture, ByVal nBackColor As Long) As StdPicture
    Dim utIconSrc As ICONINFO
    Dim utIconDest As ICONINFO
    Dim utBmp As BITMAP
    Dim utBI As BITMAPINFO
    Dim iBackR As Long
    Dim iBackG As Long
    Dim iBackB As Long
    Dim iBits() As Byte
    Dim iDCScreen As LongPtr
    Dim iDCColor As LongPtr
    Dim iDCMask As LongPtr
    Dim iOldBmpColor As LongPtr
    Dim iOldBmpMask As LongPtr
    Dim iIconNew As LongPtr
    Dim iGray As Long
    Dim iPos As Long
    Dim iCount As Long
    Dim iHasAlpha As Boolean

    ' dest = dest AND NOT src
    Const DSna As Long = &H220326

    ' An icon carries its own transparency, so it cannot go through PictureToGrayScale: that one
    ' would flatten it against a background colour and return a plain bitmap.
    If nPic Is Nothing Then Exit Function
    If nPic.Handle = 0 Then Exit Function
    If GetIconInfo(nPic.Handle, utIconSrc) = 0 Then Exit Function
    ' split once and not inside the per pixel loop
    iBackR = nBackColor And 255
    iBackG = (nBackColor \ 256) And 255
    iBackB = (nBackColor \ 65536) And 255

    ' A monochrome icon has no colour bitmap, so there is nothing to gray out
    If utIconSrc.hbmColor <> 0 Then
        If GetObjectW(utIconSrc.hbmColor, Len(utBmp), utBmp) <> 0 Then
            If utBmp.bmWidth > 0 And utBmp.bmHeight > 0 Then
                iDCScreen = GetDC(0)
                utBI.bmiHeader.biSize = Len(utBI.bmiHeader)
                utBI.bmiHeader.biWidth = utBmp.bmWidth
                ' negative height asks for top-down rows
                utBI.bmiHeader.biHeight = -utBmp.bmHeight
                utBI.bmiHeader.biPlanes = 1
                ' always ask for 32bpp so the alpha byte of an alpha icon survives the
                ' round trip - GetPixel/SetPixelV would zero it and make such an icon
                ' disappear instead of graying it
                utBI.bmiHeader.biBitCount = 32
                utBI.bmiHeader.biCompression = 0
                iCount = utBmp.bmWidth * utBmp.bmHeight * 4
                ReDim iBits(0 To iCount - 1)
                If GetDIBits(iDCScreen, utIconSrc.hbmColor, 0, utBmp.bmHeight, iBits(0), utBI, 0) <> 0 Then
                    ' An ordinary 32bpp DDB has an unused fourth byte that reads back as zero, so
                    ' alpha only means something when at least one pixel has a non zero one.
                    For iPos = 3 To iCount - 1 Step 4
                        If iBits(iPos) <> 0 Then
                            iHasAlpha = True
                            Exit For
                        End If
                    Next
                    ' DIB pixels are stored as B, G, R, A
                    For iPos = 0 To iCount - 4 Step 4
                        If (Not iHasAlpha) Or (iBits(iPos + 3) <> 0) Then
                            iGray = ToGray(RGB(iBits(iPos + 2), iBits(iPos + 1), iBits(iPos)), iBackR, iBackG, iBackB)
                            iBits(iPos) = (iGray \ 65536) And 255
                            iBits(iPos + 1) = (iGray \ 256) And 255
                            iBits(iPos + 2) = iGray And 255
                        End If
                    Next
                    SetDIBits iDCScreen, utIconSrc.hbmColor, 0, utBmp.bmHeight, iBits(0), utBI, 0
                End If

                ' A classic icon is drawn as (dest AND mask) XOR colour, so the colour bitmap has to
                ' be pure black wherever the AND mask is set, or the gray leaks out as a box behind
                ' the icon.
                If utIconSrc.hbmMask <> 0 Then
                    iDCColor = CreateCompatibleDC(iDCScreen)
                    iOldBmpColor = SelectObject(iDCColor, utIconSrc.hbmColor)
                    iDCMask = CreateCompatibleDC(iDCScreen)
                    iOldBmpMask = SelectObject(iDCMask, utIconSrc.hbmMask)
                    SetTextColorAPI iDCColor, vbBlack
                    SetBkColorAPI iDCColor, vbWhite
                    BitBlt iDCColor, 0, 0, utBmp.bmWidth, utBmp.bmHeight, iDCMask, 0, 0, DSna
                    SelectObject iDCMask, iOldBmpMask
                    DeleteDC iDCMask
                    SelectObject iDCColor, iOldBmpColor
                    DeleteDC iDCColor
                End If

                ReleaseDC 0, iDCScreen
            End If
        End If
    End If

    utIconDest.fIcon = 1
    utIconDest.hbmMask = utIconSrc.hbmMask
    utIconDest.hbmColor = utIconSrc.hbmColor
    If utIconDest.hbmMask <> 0 Then iIconNew = CreateIconIndirect(utIconDest)

    ' CreateIconIndirect copies both bitmaps, so the copies GetIconInfo handed us
    ' are ours to release
    If utIconSrc.hbmMask <> 0 Then DeleteObject utIconSrc.hbmMask
    If utIconSrc.hbmColor <> 0 Then DeleteObject utIconSrc.hbmColor

    Set IconToGrayScale = CreatePicture(iIconNew, vbPicTypeIcon)
End Function

' The disabled variant of one pixel of a picture. It is the same rule the caption, the font
' icons and the 'x' go by: the pixel loses its colour and then moves
' cDisabledStateForeApproachFactor of the way toward the body of the tab it sits on. Sharing
' the factor is what makes two tabs that differ only in the kind of icon come out at the same
' tone, which no amount of calibrating a formula of its own was going to reach.
' A picture goes fully grey while a caption keeps a fifth of its saturation, on purpose: a
' caption is one colour and a picture is many at once, and leaving each of them a trace of its
' own hue reads as a faded picture rather than as a disabled one.
' What this replaced: a pair of formulas that scaled the picture's own contrast by the
' brightness of the background, so on a dark tab the whole image collapsed into a band ten
' levels wide - a flat silhouette - while on a light one it kept 60%. A threshold at lightness
' 200 picked between them and hid the collapse; the two agree only around lightness 210, which
' is why it went unnoticed for as long as the backgrounds stayed light
Private Function ToGray(ByVal nColor As Long, ByVal nBackR As Long, ByVal nBackG As Long, ByVal nBackB As Long) As Long
    Dim iR As Long
    Dim iG As Long
    Dim iB As Long
    Dim iC As Long
    Dim iBase As Double
    
    iR = nColor And 255
    iG = (nColor \ 256) And 255
    iB = (nColor \ 65536) And 255
    iC = (0.2125 * iR + 0.7154 * iG + 0.0721 * iB)
    
    ' Both terms are within 0 to 255 and the two weights add up to one, so no channel can
    ' overflow what RGB takes
    iBase = iC * (1 - cDisabledStateForeApproachFactor)
    ToGray = RGB(iBase + nBackR * cDisabledStateForeApproachFactor, iBase + nBackG * cDisabledStateForeApproachFactor, iBase + nBackB * cDisabledStateForeApproachFactor)
End Function

' The single colour the body of a tab reads as. Not the base colour: the selected tab's
' highlight is not a mouse effect, it is permanent and it covers the body, so a caption on a
' theme that fills the active tab with its highlight colour was fading toward a background it
' never sits on - white, in Ghost Tab, over a tab painted teal. A gradient is answered with the
' average of its two ends: the fill really does change across the tab and a derivation can only
' take one colour, so the middle of it is the honest answer rather than either end
Private Function TabBodyFillColorEffective(ByVal nHighlighted As Boolean, ByVal nHighlightGradient As Long, ByVal nHighlightColor As Long, ByVal nBaseColor As Long) As Long
    Dim iBase As Long
    Dim iGlow As Long
    
    If mVisualStylesActive Or (Not nHighlighted) Or (nHighlightGradient = ntGradientNone) Then
        ' under uxtheme the body is none of our colours; the sampled one answers for it in
        ' DisabledPicBackColor, and DisabledForeColorVariant declines to derive at all
        TabBodyFillColorEffective = nBaseColor
    ElseIf nHighlightGradient = ntGradientPlain Then
        TabBodyFillColorEffective = nHighlightColor
    Else
        ' translated before the bytes are read: a per tab custom colour reaches here as the
        ' developer wrote it, system constants included
        iBase = TranslatedColor(nBaseColor)
        iGlow = TranslatedColor(nHighlightColor)
        TabBodyFillColorEffective = RGB(((iBase And 255) + (iGlow And 255)) \ 2, (((iBase \ 256) And 255) + ((iGlow \ 256) And 255)) \ 2, (((iBase \ 65536) And 255) + ((iGlow \ 65536) And 255)) \ 2)
    End If
End Function

' The colour a disabled picture is derived against. Where uxtheme paints the body there is no
' colour of ours that is on the screen, so the one sampled off DrawThemeBackground answers
' instead of the tab colour the caller resolved - which is the same reason
' DisabledForeColorVariant refuses to derive anything at all in that case
Private Function DisabledPicBackColor(ByVal nTabBackColor As Long) As Long
    If mVisualStylesActive Then
        DisabledPicBackColor = RGB(mThemedBodyBackColor_R, mThemedBodyBackColor_G, mThemedBodyBackColor_B)
    Else
        ' a per tab custom colour reaches here as the developer wrote it, system constants
        ' included, and the derivation reads the bytes
        DisabledPicBackColor = TranslatedColor(nTabBackColor)
    End If
End Function

' The disabled variant of this tab's picture, against the colour its body is painted in. The
' slot is chosen by tab state and reused only when it was built against this same colour, so
' a background that moves - ShowDisabledState, Enabled, a custom colour, a theme - is caught
' here rather than at every place that can move one
Private Function TabPicDisabled(ByVal nTab As Long, ByVal nActive As Boolean, ByVal nBackColor As Long) As StdPicture
    If nActive Then
        If (Not mTabData(nTab).PicDisabledSelectedSet) Or (mTabData(nTab).PicDisabledSelectedBackColor <> nBackColor) Then
            Set mTabData(nTab).PicDisabledSelected = GrayScaledPicture(mTabData(nTab).PicToUse, nBackColor)
            mTabData(nTab).PicDisabledSelectedBackColor = nBackColor
            mTabData(nTab).PicDisabledSelectedSet = True
        End If
        Set TabPicDisabled = mTabData(nTab).PicDisabledSelected
    Else
        If (Not mTabData(nTab).PicDisabledSet) Or (mTabData(nTab).PicDisabledBackColor <> nBackColor) Then
            Set mTabData(nTab).PicDisabled = GrayScaledPicture(mTabData(nTab).PicToUse, nBackColor)
            mTabData(nTab).PicDisabledBackColor = nBackColor
            mTabData(nTab).PicDisabledSet = True
        End If
        Set TabPicDisabled = mTabData(nTab).PicDisabled
    End If
End Function

' An icon carries its own transparency and a bitmap does not, so they need different
' treatments; a metafile gets none and is handed back as it came, the way it always was
Private Function GrayScaledPicture(nPic As StdPicture, ByVal nBackColor As Long) As StdPicture
    If nPic Is Nothing Then Exit Function
    If nPic.Type = vbPicTypeBitmap Then
        Set GrayScaledPicture = PictureToGrayScale(nPic, nBackColor)
    ElseIf nPic.Type = vbPicTypeIcon Then
        Set GrayScaledPicture = IconToGrayScale(nPic, nBackColor)
    Else
        Set GrayScaledPicture = nPic
    End If
End Function

' Both disabled variants of one tab. Anything that invalidates one invalidates the other:
' they come from the same PicToUse and differ only in the background they were derived
' against. One place so that a slot added later cannot be missed at eight call sites
Private Sub ResetPicDisabled(ByVal nTab As Long)
    mTabData(nTab).PicDisabledSet = False
    mTabData(nTab).PicDisabledSelectedSet = False
End Sub

Private Sub ResetAllPicsDisabled()
    Dim t As Long
    
    For t = 0 To mTabs - 1
        ResetPicDisabled t
    Next t
End Sub

' PicDisabled is derived from PicToUse, so dropping one drops the other. Not
' relying on SetPicToUse to clear PicDisabledSet on its way through: that only
' happens for tabs that are actually redrawn
Private Sub ResetAllPicsToUse()
    Dim t As Long
    
    For t = 0 To mTabs - 1
        mTabData(t).PicToUseSet = False
        ResetPicDisabled t
    Next t
End Sub

Private Function MouseIsOverAContainedControl() As Boolean
    Dim iPt As POINTAPI
    Dim iCtl As Object
    Dim iWidth As Long
    
    GetCursorPos iPt
    ScreenToClient mUserControlHwnd, iPt
    ' Raw VB6 twips: compared against Left/Top of the contained controls, which VB6 reports with its rounded TwipsPerPixel
    iPt.X = iPt.X * Screen.TwipsPerPixelX
    iPt.Y = iPt.Y * Screen.TwipsPerPixelY
    
    On Error Resume Next
    For Each iCtl In UserControlContainedControls
        iWidth = -1
        iWidth = iCtl.Width
        If iWidth <> -1 Then
            If iCtl.Left <= iPt.X Then
                If iCtl.Left + iCtl.Width >= iPt.X Then
                    If iCtl.Top <= iPt.Y Then
                        If iCtl.Top + iCtl.Height >= iPt.Y Then
                            MouseIsOverAContainedControl = True
                            Err.Clear
                            Exit Function
                        End If
                    End If
                End If
            End If
        End If
    Next
    Err.Clear
End Function


Private Sub DrawDelayed()
    If mAmbientUserMode And mSubclassed Then
        PostDrawMessage
    Else
        ' The whole point of this routine is that the caller does not pay for the draw.
        If mInIDE Then
            tmrDraw.Enabled = True
        Else
            Draw
        End If
    End If
End Sub

Private Sub PostDrawMessage()
    If mCanPostDrawMessage Then
        If Not mDrawMessagePosted Then
            PostMessage mUserControlHwnd, WM_DRAW, 0&, 0&
            mDrawMessagePosted = True
        End If
    Else
        tmrDraw.Enabled = True
    End If
End Sub

Friend Property Get TabControlsNames(ByVal nTab As Variant) As Object
    Dim iIndex As Long
    
    iIndex = GetTabIndex(nTab)
    If Not IsValidTabIndex(iIndex) Then
        RaiseError 381, TypeName(Me) ' invalid property array index
        Exit Property
    End If
    Set TabControlsNames = mTabData(iIndex).Controls
End Property

Friend Property Set TabControlsNames(ByVal nTab As Variant, nValue As Object)
    Dim iIndex As Long
    
    iIndex = GetTabIndex(nTab)
    If Not IsValidTabIndex(iIndex) Then
        RaiseError 381, TypeName(Me) ' invalid property array index
        Exit Property
    End If
    Set mTabData(iIndex).Controls = nValue
End Property

Friend Sub HideAllContainedControls()
    Dim iCtl As Object
    Dim c As Long
    Dim iHwnd As LongPtr
    Dim iIsLine As Boolean
    
    If mUserControlTerminated Then Exit Sub
    
    If mSubclassedControlsForMoveHwnds.Count > 0 Then
        For c = 1 To mSubclassedControlsForMoveHwnds.Count
            iHwnd = mSubclassedControlsForMoveHwnds(c)
            DetachMessage Me, iHwnd, WM_WINDOWPOSCHANGING
        Next c
        Set mSubclassedControlsForMoveHwnds = New Collection
    End If
    
    On Error Resume Next
    For Each iCtl In UserControlContainedControls
        iIsLine = TypeName(iCtl) = "Line"
        If iIsLine Then
            If iCtl.X1 > -mLeftThresholdHidden Then
                iCtl.X1 = iCtl.X1 - mLeftOffsetToHide
                iCtl.X2 = iCtl.X2 - mLeftOffsetToHide
            End If
        Else
            If iCtl.Left > -mLeftThresholdHidden Then
                iCtl.Left = iCtl.Left - mLeftOffsetToHide
            End If
        End If
    Next
    Err.Clear
End Sub

Friend Sub MakeContainedControlsInSelTabVisible()
    Dim iCtl As Object
    Dim iCtlName As Variant
    Dim iHwnd As LongPtr
    Dim c As Long
    Dim iIsLine As Boolean
    
    If mUserControlTerminated Then Exit Sub
    
    If mSubclassedControlsForMoveHwnds.Count > 0 Then
        For c = 1 To mSubclassedControlsForMoveHwnds.Count
            iHwnd = mSubclassedControlsForMoveHwnds(c)
            DetachMessage Me, iHwnd, WM_WINDOWPOSCHANGING
        Next c
        Set mSubclassedControlsForMoveHwnds = New Collection
    End If
    
    On Error Resume Next
    For Each iCtlName In mTabData(mTab).Controls
        Set iCtl = GetContainedControlByName(iCtlName)
        If Not iCtl Is Nothing Then
            iIsLine = TypeName(iCtl) = "Line"
            If iIsLine Then
                If iCtl.X1 < -mLeftThresholdHidden Then
                    iCtl.X1 = iCtl.X1 + mLeftOffsetToHide
                    iCtl.X2 = iCtl.X2 + mLeftOffsetToHide
                End If
            Else
                If iCtl.Left < -mLeftThresholdHidden Then
                    iCtl.Left = iCtl.Left + mLeftOffsetToHide
                End If
            End If
            If mAmbientUserMode And mSubclassed And (Not mOnlySubclassUserControl) Then
                iHwnd = 0
                iHwnd = GetControlHwnd(iCtl)
                If iHwnd <> 0 Then
                    mSubclassedControlsForMoveHwnds.Add iHwnd
                    AttachMessage Me, iHwnd, WM_WINDOWPOSCHANGING
                End If
            End If
        End If
    Next
    Err.Clear
End Sub

Private Sub CheckContainedControlsConsistency(Optional nCheckControlsThatChangedToArray As Boolean)
    Dim t As Long
    Dim iCCList As Collection
    Dim iAllCtInTabs As Collection
    Dim c As Long
    Dim iStr As String
    Dim iCtl As Object
    Dim iCtlName As Variant
    Dim iCtlName2 As Variant
    Dim iCtlsInTabsToRemove As Collection
    Dim iShowedNewControls As Boolean
    Dim iThereAreMissingControls As Boolean
    Dim iAuxFound As Boolean
    Dim iCtlsTypesAndRects As Collection
    Dim iAuxTypeAndRect_CtrlInTab As String
    Dim iAuxTypeAndRect_CC As String
    Dim iFound As Boolean
    Dim t2 As Long
    Dim c2 As Long
    Dim iListCtlsNowArrayToUpdateInfo As Collection
    Dim iIsLine As Boolean
    
    Set iCCList = New Collection
    For Each iCtl In UserControlContainedControls
        iStr = ControlName(iCtl)
        iCCList.Add iStr, iStr
    Next
    
    On Error Resume Next
    Set iAllCtInTabs = New Collection
    For t = 0 To mTabs - 1
        For c = 1 To mTabData(t).Controls.Count
            iStr = mTabData(t).Controls(c)
            iAllCtInTabs.Add iStr, iStr
        Next c
    Next t
    On Error GoTo 0
    
    iThereAreMissingControls = False
    For Each iCtlName In iAllCtInTabs
        iAuxFound = False
        For Each iCtlName2 In iCCList
            If iCtlName2 = iCtlName Then
                iAuxFound = True
                Exit For
            End If
        Next
        If Not iAuxFound Then
            iThereAreMissingControls = True
            If nCheckControlsThatChangedToArray Then
                iAuxFound = False
                For Each iCtlName2 In iCCList
                    If iCtlName2 = iCtlName & "(0)" Then
                        iAuxFound = True
                        Exit For
                    End If
                Next
                If iAuxFound Then
                    If iListCtlsNowArrayToUpdateInfo Is Nothing Then Set iListCtlsNowArrayToUpdateInfo = New Collection
                    iListCtlsNowArrayToUpdateInfo.Add iCtlName, iCtlName
                End If
            Else
                Exit For
            End If
        End If
    Next
    
    If iThereAreMissingControls Then
        If nCheckControlsThatChangedToArray Then
            If Not iListCtlsNowArrayToUpdateInfo Is Nothing Then
                For t = 0 To mTabs - 1
                    For c = 1 To mTabData(t).Controls.Count
                        iStr = mTabData(t).Controls(c)
                        iFound = False
                        For Each iCtlName In iListCtlsNowArrayToUpdateInfo
                            If iCtlName = iStr Then
                                iFound = True
                            End If
                        Next
                        If iFound Then
                            iStr = iStr & "(0)"
                            mTabData(t).Controls.Add iStr, iStr, c
                            mTabData(t).Controls.Remove (c + 1)
                        End If
                    Next c
                Next t
            End If
        Else
            ' This fixes SSTab paste bug, read http://www.vbforums.com/showthread.php?871285&p=5359379&viewfull=1#post5359379
            Set iCtlsTypesAndRects = New Collection
            For Each iCtl In UserControlContainedControls
                iStr = ControlName(iCtl)
                iCtlsTypesAndRects.Add GetControlTypeAndRect(iStr), iStr
            Next
            
            For t = 0 To mTabs - 1 ' enumerate tabs
                For c = 1 To mTabData(t).Controls.Count ' enumerate controls that are in that tab
                    iStr = mTabData(t).Controls(c) ' in iStr: get the name of one control in the "current" tab
                    iAuxTypeAndRect_CtrlInTab = GetControlTypeAndRect(iStr)
                    If iAuxTypeAndRect_CtrlInTab = "-" Then ' if the control is not found it may have been en converted to an array
                        iAuxTypeAndRect_CtrlInTab = GetControlTypeAndRect(iStr & "(0)")
                    End If
                    For Each iCtlName In iCCList ' iCCList has al the Contained Controls that are in the UserControl (inside the NewTab)
                        iAuxTypeAndRect_CC = GetControlTypeAndRect(CStr(iCtlName))
                        If iAuxTypeAndRect_CC = iAuxTypeAndRect_CtrlInTab Then
                            iFound = False
                            For t2 = 0 To mTabs - 1
                                For c2 = 1 To mTabData(t).Controls.Count
                                    If mTabData(t).Controls(c2) = iCtlName Then
                                        iFound = True
                                    End If
                                Next c2
                            Next t2
                            If Not iFound Then
                                mTabData(t).Controls.Add iCtlName, iCtlName, c
                                mTabData(t).Controls.Remove (c + 1)
                            End If
                        End If
                    Next
                Next c
            Next t
            
            On Error Resume Next
            Set iAllCtInTabs = New Collection
            For t = 0 To mTabs - 1
                For c = 1 To mTabData(t).Controls.Count
                    iStr = mTabData(t).Controls(c)
                    iAllCtInTabs.Add iStr, iStr
                Next c
            Next t
            On Error GoTo 0
        End If
    End If
    
    If nCheckControlsThatChangedToArray Then Exit Sub
    
    ' check if contained control is on any tab
    iShowedNewControls = False
    On Error Resume Next
    For Each iCtlName In iCCList
        iStr = ""
        iStr = iAllCtInTabs(iCtlName)
        If iStr = "" Then ' the control is not placed on any tab
            ' place it in the visible tab
            mTabData(mTab).Controls.Add iCtlName, iCtlName
            Set iCtl = GetContainedControlByName(iCtlName)
            iIsLine = TypeName(iCtl) = "Line"
            If iIsLine Then
                If iCtl.X1 <= -mLeftThresholdHidden Then
                    iCtl.X1 = iCtl.X1 + mLeftOffsetToHide
                    iCtl.X2 = iCtl.X2 + mLeftOffsetToHide
                    iShowedNewControls = True
                End If
            Else
                If iCtl.Left <= -mLeftThresholdHidden Then
                    iCtl.Left = iCtl.Left + mLeftOffsetToHide
                    iShowedNewControls = True
                End If
            End If
        End If
    Next
    
    If iShowedNewControls Then
        mSubclassControlsPaintingPending = True
        mRepaintSubclassedControls = True
        SubclassControlsPainting
    End If
    
    ' now check the inverse: if there are controls in tabs but they don't exists
    Set iCtlsInTabsToRemove = New Collection
    For Each iCtlName In iAllCtInTabs
        iStr = ""
        iStr = iCCList(iCtlName)
        If iStr = "" Then ' the control doesn't exist
            iCtlsInTabsToRemove.Add CStr(iCtlName), CStr(iCtlName)
        End If
    Next
    
    ' remove the controls that don't exists, if any
    If iCtlsInTabsToRemove.Count > 0 Then
        For t = 0 To mTabs - 1
            ' Backwards and by position: removing items from a collection while walking it with
            ' For Each skips the item after each removed one
            For c = mTabData(t).Controls.Count To 1 Step -1
                iStr = ""
                iStr = iCtlsInTabsToRemove(mTabData(t).Controls(c))
                If iStr <> "" Then ' the control name is in the list of controls to remove
                    mTabData(t).Controls.Remove c
                End If
            Next
        Next t
    End If
    Err.Clear
End Sub

Private Sub CheckIfContainedControlChangedToArray()
    CheckContainedControlsConsistency True
End Sub

Private Function GetControlTypeAndRect(iCtlName As String) As String
    Dim iCtl As Object
    Dim iSng As Long
    
    Set iCtl = GetParentControlByName(iCtlName)
    If Not iCtl Is Nothing Then
        On Error Resume Next
        GetControlTypeAndRect = TypeName(iCtl) & "."
        iSng = 0
        iSng = iCtl.Left
        GetControlTypeAndRect = GetControlTypeAndRect & CStr(iSng) & "."
        iSng = 0
        iSng = iCtl.Top
        GetControlTypeAndRect = GetControlTypeAndRect & CStr(iSng) & "."
        iSng = 0
        iSng = iCtl.Width
        GetControlTypeAndRect = GetControlTypeAndRect & CStr(iSng) & "."
        iSng = 0
        iSng = iCtl.Height
        GetControlTypeAndRect = GetControlTypeAndRect & CStr(iSng)
    Else
        GetControlTypeAndRect = "-"
    End If
    Err.Clear
End Function

Private Function GetParentControlByName(ByVal nControlName As String) As Object
    Dim iCtl As Object
    
    On Error GoTo ErrorExit
    For Each iCtl In UserControl.Parent.Controls
        If StrComp(nControlName, ControlName(iCtl), vbTextCompare) = 0 Then
            Set GetParentControlByName = iCtl
            Exit For
        End If
    Next
    
ErrorExit:
End Function

Public Property Get Controls() As VBRUN.ContainedControls
Attribute Controls.VB_Description = "Returns a collection of the controls that were added to the control."
    Set Controls = UserControlContainedControls
End Property

Private Sub RaiseError(ByVal Number As Long, Optional ByVal Source As Variant, Optional ByVal Description As Variant, Optional ByVal HelpFile As Variant, Optional ByVal HelpContext As Variant)
    If mInIDE Then
        On Error Resume Next
        Err.Raise Number, Source, Description, HelpFile, HelpContext
        MsgBox "Error " & Err.Number & ". " & Err.Description, vbCritical
    Else
        Err.Raise Number, Source, Description, HelpFile, HelpContext
    End If
End Sub

Private Function MakeTrue(Value As Boolean) As Boolean
    MakeTrue = True
    Value = True
End Function

Private Function ControlHasFocus() As Boolean
    ControlHasFocus = mHasFocus And mFormIsActive
End Function

Private Sub RearrangeContainedControlsPositions()
    Dim iCtl As Object
    Dim iBodyStart As Single
    Dim iBodyStart_Prev As Single
    Dim iIsLine As Boolean
    
    If (mTabOrientation = ssTabOrientationTop) Or (mTabOrientation = ntTabOrientationTopRight) Or (mTabOrientation = ssTabOrientationBottom) Or (mTabOrientation = ntTabOrientationBottomRight) Then
        iBodyStart = pScaleY(mBodyStart - 5, vbPixels, vbTwips)
    Else
        iBodyStart = pScaleX(mBodyStart - 5, vbPixels, vbTwips)
    End If
    If (mTabOrientation_Prev = ssTabOrientationTop) Or (mTabOrientation_Prev = ntTabOrientationTopRight) Or (mTabOrientation_Prev = ssTabOrientationBottom) Or (mTabOrientation_Prev = ntTabOrientationBottomRight) Then
        iBodyStart_Prev = pScaleY(mBodyStart_Prev - 5, vbPixels, vbTwips)
    Else
        iBodyStart_Prev = pScaleX(mBodyStart_Prev - 5, vbPixels, vbTwips)
    End If
    
    On Error Resume Next
    If mTabOrientation = mTabOrientation_Prev Then
        For Each iCtl In UserControlContainedControls
            iIsLine = TypeName(iCtl) = "Line"
            If (mTabOrientation = ssTabOrientationTop) Or (mTabOrientation = ntTabOrientationTopRight) Then
                If iIsLine Then
                    iCtl.Y1 = iCtl.Y1 - iBodyStart_Prev + iBodyStart
                    iCtl.Y2 = iCtl.Y2 - iBodyStart_Prev + iBodyStart
                Else
                    iCtl.Top = iCtl.Top - iBodyStart_Prev + iBodyStart
                End If
            ElseIf mOrientationIsBottom Then
                If iIsLine Then
                    iCtl.Y1 = iCtl.Y1 + iBodyStart_Prev - iBodyStart
                    iCtl.Y2 = iCtl.Y2 + iBodyStart_Prev - iBodyStart
                Else
                    iCtl.Top = iCtl.Top + iBodyStart_Prev - iBodyStart
                End If
            ElseIf (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Or (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationLeftBottomHorizontal) Then
                If iIsLine Then
                    iCtl.X1 = iCtl.X1 - iBodyStart_Prev + iBodyStart
                    iCtl.X2 = iCtl.X2 - iBodyStart_Prev + iBodyStart
                Else
                    iCtl.Left = iCtl.Left - iBodyStart_Prev + iBodyStart
                End If
            ElseIf (mTabOrientation = ssTabOrientationRight) Or (mTabOrientation = ntTabOrientationRightBottom) Or (mTabOrientation = ntTabOrientationRightHorizontal) Or (mTabOrientation = ntTabOrientationRightBottomHorizontal) Then
                If iIsLine Then
                    iCtl.X1 = iCtl.X1 + iBodyStart_Prev - iBodyStart
                    iCtl.X2 = iCtl.X2 + iBodyStart_Prev - iBodyStart
                Else
                    iCtl.Left = iCtl.Left + iBodyStart_Prev - iBodyStart
                End If
            End If
        Next
    Else
        For Each iCtl In UserControlContainedControls
            iIsLine = TypeName(iCtl) = "Line"
            If (mTabOrientation_Prev = ssTabOrientationTop) Or (mTabOrientation_Prev = ntTabOrientationTopRight) Then
                If iIsLine Then
                    iCtl.Y1 = iCtl.Y1 - iBodyStart_Prev
                    iCtl.Y2 = iCtl.Y2 - iBodyStart_Prev
                Else
                    iCtl.Top = iCtl.Top - iBodyStart_Prev
                End If
            ElseIf (mTabOrientation_Prev = ssTabOrientationBottom) Or (mTabOrientation_Prev = ntTabOrientationBottomRight) Then
                '
            ElseIf (mTabOrientation_Prev = ssTabOrientationLeft) Or (mTabOrientation_Prev = ntTabOrientationLeftTop) Or (mTabOrientation_Prev = ntTabOrientationLeftHorizontal) Or (mTabOrientation_Prev = ntTabOrientationLeftBottomHorizontal) Then
                If iIsLine Then
                    iCtl.X1 = iCtl.X1 - iBodyStart_Prev
                    iCtl.X2 = iCtl.X2 - iBodyStart_Prev
                Else
                    iCtl.Left = iCtl.Left - iBodyStart_Prev
                End If
            ElseIf (mTabOrientation_Prev = ssTabOrientationRight) Or (mTabOrientation_Prev = ntTabOrientationRightBottom) Or (mTabOrientation_Prev = ntTabOrientationRightHorizontal) Or (mTabOrientation_Prev = ntTabOrientationRightBottomHorizontal) Then
                '
            End If
        
            If (mTabOrientation = ssTabOrientationTop) Or (mTabOrientation = ntTabOrientationTopRight) Then
                If iIsLine Then
                    iCtl.Y1 = iCtl.Y1 + iBodyStart
                    iCtl.Y2 = iCtl.Y2 + iBodyStart
                Else
                    iCtl.Top = iCtl.Top + iBodyStart
                End If
            ElseIf mOrientationIsBottom Then
                '
            ElseIf (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Or (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationLeftBottomHorizontal) Then
                If iIsLine Then
                    iCtl.X1 = iCtl.X1 + iBodyStart
                    iCtl.X2 = iCtl.X2 + iBodyStart
                Else
                    iCtl.Left = iCtl.Left + iBodyStart
                End If
            ElseIf (mTabOrientation = ssTabOrientationRight) Or (mTabOrientation = ntTabOrientationRightBottom) Or (mTabOrientation = ntTabOrientationRightHorizontal) Or (mTabOrientation = ntTabOrientationRightBottomHorizontal) Then
                '
            End If
        Next
    End If
    Err.Clear
End Sub

Public Property Get TabControls(ByVal nTab As Variant, Optional IncludeChildren As Boolean = True) As Collection
Attribute TabControls.VB_Description = "Returns a collection of the controls that are inside a tab."
    Dim iCtlName As Variant
    Dim iCtl As Object
    Dim iCtl2 As Object
    Dim iObj As Object
    Dim iFailed As Boolean
    
    nTab = GetTabIndex(nTab, iFailed)
    If iFailed Then Exit Property
    ' the upper bound is mTabs - 1 and not TabsWithoutNewTabButton, so the new tab button is
    ' accepted here, against the rule the rest of the public members follow.
    If (nTab < 0) Or (nTab > (mTabs - 1)) Then
        RaiseError 381, TypeName(Me) ' invalid property array index
        Exit Property
    End If
    
    Set TabControls = New Collection
    
    If IncludeChildren Then
        If Not mTabStopsInitialized Then
            StoreControlsTabStop True
            mTabStopsInitialized = True
        End If
    End If
    
    For Each iCtlName In mTabData(nTab).Controls
        Set iCtl = GetContainedControlByName(iCtlName)
        If Not iCtl Is Nothing Then
            Set iObj = iCtl
            TabControls.Add iObj, iCtlName
            If IncludeChildren Then
                If ControlIsContainer(iCtlName) Then
                    For Each iCtl2 In GetContainedControlsInControlContainer(iCtl)
                        Set iObj = iCtl2
                        TabControls.Add iObj, iCtl2.Name
                    Next
                End If
            End If
        End If
    Next
    
End Property

Public Property Get EndOfTabs() As Single
Attribute EndOfTabs.VB_Description = "Returns a value that indicates where the last tab ends. This value is in units of the container."
    EnsureDrawn
    If (mTabOrientation = ssTabOrientationTop) Or (mTabOrientation = ntTabOrientationTopRight) Or (mTabOrientation = ssTabOrientationBottom) Or (mTabOrientation = ntTabOrientationBottomRight) Then
        EndOfTabs = FixRoundingError(ToContainerSizeX(mEndOfTabs, vbPixels))
    Else
        EndOfTabs = FixRoundingError(ToContainerSizeY(mEndOfTabs, vbPixels))
    End If
End Property

Public Property Get MinSizeNeeded() As Single
Attribute MinSizeNeeded.VB_Description = "Returns the minimum Width (or Height, depending on the TabOrientation setting) of the control needed to show all the tabs in one row (without adding new rows). This value is in units of the container."
Attribute MinSizeNeeded.VB_ProcData.VB_Invoke_Property = ";Data"
    Dim iTotal As Long
    Dim iVisibleTabs As Long
    Dim iExtent As Long
    Dim iMinWidthPixels As Long
    Dim iMaxWidthPixels As Long
    Dim iStripExtent As Long
    Dim iTabWidthFixed As Long
    Dim t As Long
    Dim iZoneNewTabWidthPrev As Long
    
    EnsureDrawn
    ' Resolved before either branch: the Fixed branch needs the maximum too
    GetTabWidthLimitsPixels iMinWidthPixels, iMaxWidthPixels
    If Not mTabsAreRotatedButCaptionsAreHorizontal Then
        If mTabWidthStyle2 = ntTWEqualWidth Then
            ' Fixed hands every tab the same width - the room divided by TabsPerRow - and that is
            ' what the tab is going to be, its caption never enters the layout.
            iStripExtent = mScaleWidth
            If (mTabOrientation <> ssTabOrientationTop) And (mTabOrientation <> ntTabOrientationTopRight) And (mTabOrientation <> ssTabOrientationBottom) And (mTabOrientation <> ntTabOrientationBottomRight) Then
                iStripExtent = mScaleHeight
            End If
            ' Visible tabs and not mTabs, and without the new tab button, so this branch counts
            ' the same population the measuring branch below does: a hidden tab holds no place in
            ' the grid, and the button is furniture
            iTabWidthFixed = (iStripExtent - 1) / mTabsPerRow
            ' The same ceiling SetTabsLayout puts on iTabWidth for this style: with TabMaxWidth
            ' set, the tab that gets drawn is narrower than the plain division, and without this
            ' the answer ran over by exactly the difference
            If iMaxWidthPixels > 0 Then
                If iTabWidthFixed > iMaxWidthPixels Then iTabWidthFixed = iMaxWidthPixels
            End If
            ' mVisibleTabs and not VisibleTabsWithoutNewTabButton: the button is a real tab that
            ' takes a real slot in the grid, so the room it needs belongs in the total. What does
            ' not belong is a hidden tab, which is why this is not mTabs either
            iTotal = iTabWidthFixed * mVisibleTabs
        End If
    End If
    
    If iTotal = 0 Then
        ' Built here rather than left behind by Draw: no other member of the control reads this, so
        ' computing it on every Draw was work done for nobody.
        For t = 0 To mTabs - 1
            If mTabData(t).Visible And Not (mTabData(t).IsNewTabButton And (mNewTabButtonPosition = ntNBStripEnd)) Then
                If mTabData(t).FixedWidth <> 0 Then
                    ' TabFixedWidth is the last word in both layout branches - it is assigned after
                    ' everything else, the clamps included - and in both it sets the extent ALONG
                    ' the strip, so one test here covers the two branches below.
                    iExtent = pScaleX(mTabData(t).FixedWidth, vbHimetric, vbPixels)
                ElseIf mTabsAreRotatedButCaptionsAreHorizontal Then
                    If (mTabHeightStyleForHorizontal = ntTHFill) Or (mTabHeightStyleForHorizontal = ntTHStretchToFill) Then
                        ' Fill hands every tab a share of the whole strip, so Width answers with the
                        ' strip it was given. Re-measured against the column it sits in, which is
                        ' what the caption wraps inside.
                        iExtent = MeasureTabHeightForHorizontalCaptions(t, mTabData(t).ColumnWidthHC)
                    Else
                        iExtent = mTabData(t).Width
                    End If
                Else
                    iExtent = MeasureTabIconAndCaption(t)
                    ' The same two clamps the measuring loop in Draw applies, and skipped for the
                    ' new tab button for the same reason given there: it is furniture holding a single
                    ' glyph, and neither clamp is about it
                    If Not mTabData(t).IsNewTabButton Then
                        If iMinWidthPixels > 0 Then
                            If (iExtent + 2 * mTabPaddingWidthDPIScaled) < iMinWidthPixels Then
                                iExtent = iMinWidthPixels - 2 * mTabPaddingWidthDPIScaled
                            End If
                        End If
                        If iMaxWidthPixels > 0 Then
                            If (iExtent + 2 * mTabPaddingWidthDPIScaled) > iMaxWidthPixels Then
                                iExtent = iMaxWidthPixels - 2 * mTabPaddingWidthDPIScaled
                            End If
                        End If
                    End If
                    iExtent = iExtent + 2 * mTabPaddingWidthDPIScaled
                End If
                iTotal = iTotal + iExtent
                iVisibleTabs = iVisibleTabs + 1
            End If
        Next t
        If iVisibleTabs > 1 Then
            iTotal = iTotal + (iVisibleTabs - 1) * mTabSeparation2
        End If
        ' The room the strip never gets. pScaleX and not pScaleY because this is the as-Top frame,
        ' where the strip always runs along X - the same call SetTabsLayout makes to build
        ' iScaleWidthForTabs.
        mStripCloseButtonWidth = StripCloseButtonWidth
        ' one row with everything in it: the '+' is in the zone only when it always goes there
        iZoneNewTabWidthPrev = mZoneNewTabWidth
        mZoneNewTabWidth = 0
        If mNewTabButtonPosition = ntNBStripEnd Then
            If TabIsNewTabButton(mTabs - 1) Then
                If mTabData(mTabs - 1).Visible Then mZoneNewTabWidth = NewTabZoneWidth
            End If
        End If
        iTotal = iTotal + pScaleX(mStripEndFreeSpace, vbHimetric, vbPixels) + StripButtonsReserve + RowLostToEdges()
        mZoneNewTabWidth = iZoneNewTabWidthPrev
    End If
    
    If (mTabOrientation = ssTabOrientationTop) Or (mTabOrientation = ntTabOrientationTopRight) Or (mTabOrientation = ssTabOrientationBottom) Or (mTabOrientation = ntTabOrientationBottomRight) Then
        MinSizeNeeded = FixRoundingError(ToContainerSizeX(iTotal, vbPixels))
    Else
        MinSizeNeeded = FixRoundingError(ToContainerSizeY(iTotal, vbPixels))
    End If
End Property

Public Property Get HandleHighContrastTheme() As Boolean
Attribute HandleHighContrastTheme.VB_Description = "When True (default setting), handles the system changes to High contrast theme automatically."
Attribute HandleHighContrastTheme.VB_ProcData.VB_Invoke_Property = ";Behavior"
    HandleHighContrastTheme = mHandleHighContrastTheme
End Property

Public Property Let HandleHighContrastTheme(ByVal nValue As Boolean)
    If nValue <> mHandleHighContrastTheme Then
        mHandleHighContrastTheme = nValue
        SetPropertyChanged "HandleHighContrastTheme"
        mSetAutoTabHeightPending = True
        If mHandleHighContrastTheme Then
            CheckHighContrastTheme
        End If
        SetColors
        DrawDelayed
    End If
End Property


Friend Function pScaleX(Width As Variant, Optional ByVal FromScale As Variant, Optional ByVal ToScale As Variant) As Single
    Select Case True
        Case ToScale = vbPixels
            Select Case FromScale
                Case vbCentimeters
                    pScaleX = Width * mDPIX / 2.54
                Case vbCharacters
                    pScaleX = Width / 1440 * mDPIX * 120
                Case vbHimetric
                    pScaleX = Width * mDPIX / 2540
                Case vbInches
                    pScaleX = Width * mDPIX
                Case vbMillimeters
                    pScaleX = Width * mDPIX / 25.4
                Case vbPixels
                    pScaleX = Width
                Case vbPoints
                    pScaleX = Width / 1440 * mDPIX * 20
                Case vbTwips
                    pScaleX = Width / 1440 * mDPIX
                Case Else
                    pScaleX = UserControl.ScaleX(Width, FromScale, ToScale)
            End Select
        Case FromScale = vbPixels
            Select Case ToScale
                Case vbCentimeters
                    pScaleX = Width / mDPIX * 2.54
                Case vbCharacters
                    pScaleX = Width * 1440 / mDPIX / 120
                Case vbHimetric
                    pScaleX = Width / mDPIX * 2540
                Case vbInches
                    pScaleX = Width / mDPIX
                Case vbMillimeters
                    pScaleX = Width / mDPIX * 25.4
                Case vbPixels
                    pScaleX = Width
                Case vbPoints
                    pScaleX = Width * 1440 / mDPIX / 20
                Case vbTwips
                    pScaleX = Width * 1440 / mDPIX
                Case vbUser
                    pScaleX = UserControl.ScaleX(Width, FromScale, ToScale)
                Case Else
                    pScaleX = UserControl.ScaleX(Width, FromScale, ToScale)
            End Select
        Case Else
            pScaleX = UserControl.ScaleX(Width, FromScale, ToScale)
    End Select
End Function

Friend Function pScaleY(Height As Variant, Optional ByVal FromScale As Variant, Optional ByVal ToScale As Variant) As Single
    Select Case True
        Case ToScale = vbPixels
            Select Case FromScale
                Case vbCentimeters
                    pScaleY = Height * mDPIY / 2.54
                Case vbCharacters
                    pScaleY = Height / 1440 * mDPIY * 120
                Case vbHimetric
                    pScaleY = Height * mDPIY / 2540
                Case vbInches
                    pScaleY = Height * mDPIY
                Case vbMillimeters
                    pScaleY = Height * mDPIY / 25.4
                Case vbPixels
                    pScaleY = Height
                Case vbPoints
                    pScaleY = Height / 1440 * mDPIY * 20
                Case vbTwips
                    pScaleY = Height / 1440 * mDPIY
                Case Else
                    pScaleY = UserControl.ScaleY(Height, FromScale, ToScale)
            End Select
        Case FromScale = vbPixels
            Select Case ToScale
                Case vbCentimeters
                    pScaleY = Height / mDPIY * 2.54
                Case vbCharacters
                    pScaleY = Height * 1440 / mDPIY / 120
                Case vbHimetric
                    pScaleY = Height / mDPIY * 2540
                Case vbInches
                    pScaleY = Height / mDPIY
                Case vbMillimeters
                    pScaleY = Height / mDPIY * 25.4
                Case vbPixels
                    pScaleY = Height
                Case vbPoints
                    pScaleY = Height * 1440 / mDPIY / 20
                Case vbTwips
                    pScaleY = Height * 1440 / mDPIY
                Case vbUser
                    pScaleY = UserControl.ScaleY(Height, FromScale, ToScale)
                Case Else
                    pScaleY = UserControl.ScaleY(Height, FromScale, ToScale)
            End Select
        Case Else
            pScaleY = UserControl.ScaleY(Height, FromScale, ToScale)
    End Select
End Function

Private Sub SetDPI()
    Dim iDC As LongPtr
    Dim iTx As Single
    Dim iTY As Single
    
    iDC = GetDC(0)
    mDPIX = GetDeviceCaps(iDC, LOGPIXELSX)
    mDPIY = GetDeviceCaps(iDC, LOGPIXELSY)
    ReleaseDC 0, iDC
    
    iTx = 1440 / mDPIX
    iTY = 1440 / mDPIY
    
    mXCorrection = iTx / Screen.TwipsPerPixelX
    mYCorrection = iTY / Screen.TwipsPerPixelY
    
    SetLeftOffsetToHide Screen_TwipsPerPixelX
    mDPIScale = 1 / 96 * mDPIX
    SetDPIScaledValues
End Sub

' Every *DPIScaled value is its property - or its constant - times the scale, and nothing
' else. Called from SetDPI, so the family follows mDPIScale instead of staying frozen at
' whatever it was when the process started: the three constant based ones have no other
' place that recomputes them, and without that the icon and close button hit testing would
' drift away from what is painted. The property setters call it again because their own
' base value has just changed
Private Sub SetDPIScaledValues()
    mTabSeparationDPIScaled = mTabSeparation * mDPIScale
    ' Scaled per side and doubled at the point of use, not the other way round: the tab has to
    ' end up exactly twice the inset wider, and scaling the total would leave the two disagreeing
    ' by a pixel wherever the scale lands on a half
    mTabPaddingWidthDPIScaled = mTabPaddingWidth * mDPIScale
    mCloseButtonPaddingDPIScaled = mCloseButtonPadding * mDPIScale
    mTabPaddingHeightDPIScaled = mTabPaddingHeight * mDPIScale
    mFlatRoundnessTopDPIScaled = mFlatRoundnessTop * mDPIScale
    mFlatRoundnessBottomDPIScaled = mFlatRoundnessBottom * mDPIScale
    mFlatRoundnessTabsDPIScaled = mFlatRoundnessTabs * mDPIScale
    mFlatBarHeightDPIScaled = mFlatBarHeight * mDPIScale
    mFlatBarGripHeightDPIScaled = mFlatBarGripHeight * mDPIScale
    mFlatTabBodyGapDPIScaled = mFlatTabBodyGap * mDPIScale
    mFlatBodySeparationLineHeightDPIScaled = mFlatBodySeparationLineHeight * mDPIScale
    mTabIconDistanceToCaptionDPIScaled = cTabIconDistanceToCaption * mDPIScale
    mCloseButtonMarginDPIScaled = cCloseButtonMargin * mDPIScale
    mIconClickExtendDPIScaled = cIconClickExtend * mDPIScale
    mBacksheetTopInsetDPIScaled = cBacksheetTopInset * mDPIScale
End Sub

' Single and not Long: the twips per pixel is fractional at 175%, 200% and 225%, and a Long
' parameter would round it away at the call, leaving both callers no better than the raw
' Screen.TwipsPerPixelX they are here to avoid
Private Sub SetLeftOffsetToHide(ByVal nTwipsPerPixel As Single)
    If nTwipsPerPixel >= 6 Then
        mLeftOffsetToHide = 75000 ' compatible with original SSTab up to 250% DPI
        mLeftThresholdHidden = 15000
    Else
        mLeftOffsetToHide = nTwipsPerPixel * 16384 * 0.6 ' Windows has a limit on controls positions out of screen (in pixels), need to handle that for very hight DPI setting (> 250%) https://www.vbforums.com/showthread.php?888201
        If mLeftOffsetToHide > 30000 Then
            mLeftThresholdHidden = 15000
        Else
            mLeftThresholdHidden = mLeftOffsetToHide / 2
        End If
    End If
End Sub

Private Function Screen_TwipsPerPixelX() As Single
    Screen_TwipsPerPixelX = Screen.TwipsPerPixelX * mXCorrection
End Function

Private Function Screen_TwipsPerPixelY() As Single
    Screen_TwipsPerPixelY = Screen.TwipsPerPixelY * mYCorrection
End Function


Public Property Get Object() As Object
Attribute Object.VB_Description = "Returns the control instance without the extender."
    Set Object = Me
End Property

Private Function IsMsgBoxShown() As Boolean
    Dim iHwnd As LongPtr
     
    Do Until IsWindowLocal(iHwnd)
        iHwnd = FindWindowEx(0&, iHwnd, StrPtr("#32770"), 0&)
        If iHwnd = 0 Then Exit Function
    Loop
    IsMsgBoxShown = True
End Function

Private Function IsWindowLocal(ByVal nHwnd As LongPtr) As Boolean
    Dim iIdProcess As Long
    
    Call GetWindowThreadProcessId(nHwnd, iIdProcess)
    IsWindowLocal = (iIdProcess = GetCurrentProcessId())
End Function

' The system's answer to "can visual styles be drawn right now". Cached because it is
' two syscalls and it can only change on a theme change, which is where it is refreshed.
' IsThemeActive alone is not enough: the modern high contrast themes are msstyles and
' report themselves active, so the high contrast test has to be explicit
Private Sub RefreshSystemVisualStylesAvailable()
    mSystemVisualStylesAvailable = (IsThemeActive() <> 0) And (Not IsHighContrastTheme())
End Sub

' mVisualStyles is the developer's answer - it now mirrors the appearance resolving to
' ntTAWindows, whether that came from TabAppearance itself or from Style = ntStyleWindows
' through ntTAAuto - and it stays pure. Folding the system state into it is not an option:
' Property Let
' VisualStyles stashes BackColorTabs and BackColorSelectedTab and overwrites both with
' vbButtonFace, so every trip in and out of high contrast would fire that swap and
' destroy the colors. High contrast wins here whatever HandleHighContrastTheme says:
' that property governs colors, while whether uxtheme can draw a tab at all is a fact
' about the system, not a preference
Private Function VisualStylesEffective() As Boolean
    VisualStylesEffective = mVisualStyles And mSystemVisualStylesAvailable
End Function

Private Function IsHighContrastTheme() As Boolean
    Dim iHC As tagHIGHCONTRAST
    
    iHC.cbSize = Len(iHC)
    SystemParametersInfo SPI_GETHIGHCONTRAST, Len(iHC), iHC, 0
    IsHighContrastTheme = (iHC.dwFlags And HCF_HIGHCONTRASTON) = HCF_HIGHCONTRASTON
End Function

Private Function SystemAnimationsOn() As Boolean
    ' The Windows "animation effects" setting. Where the call fails (XP has no such setting) the
    ' animations stay on
    Dim iOn As Long
    
    If SystemParametersInfoLong(SPI_GETCLIENTAREAANIMATION, 0, iOn, 0) = 0 Then
        SystemAnimationsOn = True
    Else
        SystemAnimationsOn = (iOn <> 0)
    End If
End Function

Private Sub CheckHighContrastTheme()
    Dim iPrevBackColor As Long
    
    If mHighContrastThemeOn <> IsHighContrastTheme Then
        mHighContrastThemeOn = Not mHighContrastThemeOn
        ' The contained controls were painted with the colors as they were BEFORE this toggle, so
        ' those values are the only bridge that can find them again - and for an automatic
        ' BackColorSelectedTab the recompute below is about to destroy it.
        iPrevBackColor = BackColorSelectedTabEffective
        If mBackColorSelectedTab_IsAutomatic Then
            mBackColorSelectedTab = GetAutomaticBackColorSelectedTab
        End If
        SetColors
        ' SetColors and Draw repaint the control itself, but the contained controls hold their
        ' colors in their own properties, so without a redelivery they kept the previous palette
        ' until the next tab change.
        If mAmbientUserMode And Not mReadingProperties Then
            ' iPrevBackColor travels as the PREVIOUS color, which is what it is: the children were
            ' painted before the toggle and that value is the only thing that finds them again.
            If mChangeControlsBackColor Then SetControlsProperBackColor iPrevBackColor
            ' No previous color for the fore side, deliberately. mForeColorSelectedTab used to
            ' travel here and it is not what the children hold whenever the active tab has a custom
            ' ForeColorSelectedTab.
            If mChangeControlsForeColor Then SetControlsProperForeColor
        End If
        mBodyReset = True
        DrawDelayed
    End If
End Sub

Public Property Get LeftOffsetToHide() As Long
Attribute LeftOffsetToHide.VB_Description = "Returns the shift to the left in twips that it is using to hide the controls in not active tabs."
Attribute LeftOffsetToHide.VB_ProcData.VB_Invoke_Property = ";Data"
    LeftOffsetToHide = mLeftOffsetToHide
End Property


Public Property Get ControlLeft(nControl As Variant) As Single
Attribute ControlLeft.VB_Description = "Returns/sets the left of the contained control whose name was provided by the ControlName parameter."
Attribute ControlLeft.VB_ProcData.VB_Invoke_Property = ";Position"
    Dim iCtl As Object
    Dim iFound As Boolean
    Dim iWithIndex As Boolean
    Dim iName As String
    Dim iIndex As Long
    Dim iLeft As Single
    Dim iIsLine As Boolean
    Dim iControlName As String
    Dim iObj As Object
    
    If IsObject(nControl) Then
        On Error Resume Next
        Set iObj = nControl
        iControlName = LCase$(ControlName(iObj))
        On Error GoTo 0
        If iControlName = "" Then
            RaiseError 5, TypeName(Me) ' Invalid procedure call or argument
            Exit Property
        End If
    ElseIf VarType(nControl) = vbString Then
        iControlName = LCase$(nControl)
    Else
        RaiseError 5, TypeName(Me) ' Invalid procedure call or argument
        Exit Property
    End If
    
    iWithIndex = InStr(iControlName, "(") > 0
    For Each iCtl In UserControlContainedControls
        iName = LCase$(iCtl.Name)
        If iWithIndex Then
            iIndex = -1
            On Error Resume Next
            iIndex = iCtl.Index
            On Error GoTo 0
            If iIndex <> -1 Then
                iName = iName & "(" & iIndex & ")"
            End If
        End If
        If iName = iControlName Then
            iFound = True
            Exit For
        End If
    Next
    If Not iFound Then
        RaiseError 1501, , "nControl not found."
    Else
        iIsLine = TypeName(iCtl) = "Line"
        iLeft = 0
        On Error Resume Next
        If iIsLine Then
            iLeft = iCtl.X1
        Else
            iLeft = iCtl.Left
        End If
        On Error GoTo 0
        If iLeft < -mLeftThresholdHidden Then
           ControlLeft = iLeft + mLeftOffsetToHide + mPendingLeftOffset
        Else
            ControlLeft = iLeft
        End If
    End If
End Property

Public Property Let ControlLeft(nControl As Variant, ByVal Left As Single)
    Dim iCtl As Object
    Dim iFound As Boolean
    Dim iWithIndex As Boolean
    Dim iName As String
    Dim iIndex As Long
    Dim iControlName As String
    Dim iObj As Object
    
    Left = Left - mPendingLeftOffset
    
    If IsObject(nControl) Then
        On Error Resume Next
        Set iObj = nControl
        iControlName = LCase$(ControlName(iObj))
        On Error GoTo 0
        If iControlName = "" Then
            RaiseError 5, TypeName(Me) ' Invalid procedure call or argument
            Exit Property
        End If
    ElseIf VarType(nControl) = vbString Then
        iControlName = LCase$(nControl)
    Else
        RaiseError 5, TypeName(Me) ' Invalid procedure call or argument
        Exit Property
    End If
    
    iWithIndex = InStr(iControlName, "(") > 0
    For Each iCtl In UserControlContainedControls
        iName = LCase$(iCtl.Name)
        If iWithIndex Then
            iIndex = -1
            On Error Resume Next
            iIndex = iCtl.Index
            On Error GoTo 0
            If iIndex <> -1 Then
                iName = iName & "(" & iIndex & ")"
            End If
        End If
        If iName = iControlName Then
            iFound = True
            Exit For
        End If
    Next
    If Not iFound Then
        RaiseError 1501, , "Control not found."
    Else
        If iCtl.Left < -mLeftThresholdHidden Then
            iCtl.Left = Left - mLeftOffsetToHide
        Else
            iCtl.Left = Left
        End If
    End If
End Property

Public Sub ControlMove(nControl As Variant, ByVal Left As Single, ByVal Top As Single, Optional ByVal Width As Variant, Optional ByVal Height As Variant, Optional ByVal TabToMoveTheControl As Variant)
Attribute ControlMove.VB_Description = "Replaces the ControlName.Move method. The difference is that it takes into account the Left offset of controls on inactive tabs."
    Dim iCtl As Object
    Dim iFound As Boolean
    Dim iWithIndex As Boolean
    Dim iName As String
    Dim iIndex As Long
    Dim t As Long
    Dim iCtlName As String
    Dim c As Long
    Dim iIsLine As Boolean
    Dim iAuxLeft As Single
    Dim iControlName As String
    Dim iObj As Object
    Dim iTabToMoveTheControl As Long
    
    If Not IsMissing(TabToMoveTheControl) Then
        iTabToMoveTheControl = GetTabIndex(TabToMoveTheControl)
    Else
        iTabToMoveTheControl = -1
    End If
    Left = Left - mPendingLeftOffset
    
    If IsObject(nControl) Then
        On Error Resume Next
        Set iObj = nControl
        iControlName = LCase$(ControlName(iObj))
        On Error GoTo 0
        If iControlName = "" Then
            RaiseError 5, TypeName(Me) ' Invalid procedure call or argument
            Exit Sub
        End If
    ElseIf VarType(nControl) = vbString Then
        iControlName = LCase$(nControl)
    Else
        RaiseError 5, TypeName(Me) ' Invalid procedure call or argument
        Exit Sub
    End If
    
    iWithIndex = InStr(iControlName, "(") > 0
    For Each iCtl In UserControlContainedControls
        iName = LCase$(iCtl.Name)
        If iWithIndex Then
            iIndex = -1
            On Error Resume Next
            iIndex = iCtl.Index
            On Error GoTo 0
            If iIndex <> -1 Then
                iName = iName & "(" & iIndex & ")"
            End If
        End If
        If iName = iControlName Then
            iFound = True
            Exit For
        End If
    Next
    
    If Not iFound Then
        RaiseError 1501, , "Control not found."
    Else
        iAuxLeft = 0
        iIsLine = False
        If TypeName(iCtl) = "Line" Then
            iAuxLeft = iCtl.X1
            iIsLine = True
        Else
            iAuxLeft = iCtl.Left
        End If
        If iIsLine Then
            If IsMissing(Width) Then
                Width = Abs(iCtl.X2 - iCtl.X1)
            End If
            If IsMissing(Height) Then
                Height = Abs(iCtl.Y2 - iCtl.Y1)
            End If
            If iAuxLeft < -mLeftThresholdHidden Then
                iCtl.X1 = Left - mLeftOffsetToHide
            Else
                iCtl.X1 = Left
            End If
            iCtl.X2 = iCtl.X1 + Width
            iCtl.Y1 = Top
            iCtl.Y2 = iCtl.Y1 + Height
            iAuxLeft = iCtl.X1
        Else
            If IsMissing(Width) Then
                Width = iCtl.Width
            End If
            If IsMissing(Height) Then
                Height = iCtl.Height
            End If
            If iAuxLeft < -mLeftThresholdHidden Then
                iCtl.Move Left - mLeftOffsetToHide, Top, Width, Height
            Else
                iCtl.Move Left, Top, Width, Height
            End If
            iAuxLeft = iCtl.Left
        End If
        If iTabToMoveTheControl > -1 Then
            iCtlName = ControlName(iCtl)
            iFound = False
            For t = 0 To mTabs - 1
                For c = 1 To mTabData(t).Controls.Count
                    If mTabData(t).Controls(c) = iCtlName Then
                        If t <> iTabToMoveTheControl Then
                            mTabData(t).Controls.Remove iCtlName
                        Else
                            iFound = True
                            Exit For
                        End If
                    End If
                Next
                If iFound Then Exit For
            Next
            On Error Resume Next
            mTabData(iTabToMoveTheControl).Controls.Add iCtlName, iCtlName
            On Error GoTo 0
            If (iAuxLeft < -mLeftThresholdHidden) And (iTabToMoveTheControl = mTab) Then
                If iIsLine Then
                    iCtl.X1 = iCtl.X1 + mLeftOffsetToHide
                    iCtl.X2 = iCtl.X2 + mLeftOffsetToHide
                Else
                    iCtl.Left = iCtl.Left + mLeftOffsetToHide
                End If
            ElseIf (iAuxLeft >= -mLeftThresholdHidden) And (iTabToMoveTheControl <> mTab) Then
                If iIsLine Then
                    iCtl.X1 = iCtl.X1 - mLeftOffsetToHide
                    iCtl.X2 = iCtl.X2 - mLeftOffsetToHide
                Else
                    iCtl.Left = iCtl.Left - mLeftOffsetToHide
                End If
            End If
        End If
    End If
End Sub

Public Function ControlGetTab(nControl As Variant) As Long
Attribute ControlGetTab.VB_Description = "Returns the tab where a control is."
    Dim iTab As Long
    Dim iControlName As String
    Dim iObj As Object
    
    If IsObject(nControl) Then
        On Error Resume Next
        Set iObj = nControl
        iControlName = LCase$(ControlName(iObj))
        On Error GoTo 0
        If iControlName = "" Then
            RaiseError 5, TypeName(Me) ' Invalid procedure call or argument
            Exit Function
        End If
    ElseIf VarType(nControl) = vbString Then
        iControlName = LCase$(nControl)
    Else
        RaiseError 5, TypeName(Me) ' Invalid procedure call or argument
        Exit Function
    End If
    
    ControlGetTab = -1
    For iTab = 0 To mTabs - 1
        If ControlIsInTab2(iControlName, iTab) Then
            ControlGetTab = iTab
            Exit For
        End If
    Next
End Function

Public Sub ControlSetTab(nControl As Variant, ByVal nTab As Variant)
Attribute ControlSetTab.VB_Description = "Sets or change the tab where a contained control is."
    Dim iCtl As Object
    Dim iWithIndex As Boolean
    Dim iName As String
    Dim iIndex As Long
    Dim iCtlArrayIndex As Long
    Dim iFailed As Boolean
    Dim iFound As Boolean
    Dim iControlName As String
    Dim iObj As Object
    
    iIndex = GetTabIndex(nTab, iFailed)
    If iFailed Then Exit Sub
    ' this is a method, not a property array, so the error is 5 and not the 381 the indexed
    ' properties raise. The new tab button is rejected along with the out of range values:
    ' it is a command and cannot hold controls
    If Not IsValidTabIndex(iIndex) Then
        RaiseError 5, TypeName(Me) ' Invalid procedure call or argument
        Exit Sub
    End If
    If IsObject(nControl) Then
        On Error Resume Next
        Set iObj = nControl
        iControlName = LCase$(ControlName(iObj))
        On Error GoTo 0
        If iControlName = "" Then
            RaiseError 5, TypeName(Me) ' Invalid procedure call or argument
            Exit Sub
        End If
    ElseIf VarType(nControl) = vbString Then
        iControlName = LCase$(nControl)
    Else
        RaiseError 5, TypeName(Me) ' Invalid procedure call or argument
        Exit Sub
    End If
    
    If ControlGetTab(iControlName) <> iIndex Then
        iWithIndex = InStr(iControlName, "(") > 0
        For Each iCtl In UserControlContainedControls
            iName = LCase$(iCtl.Name)
            If iWithIndex Then
                ' the control array element index needs its own variable.
                iCtlArrayIndex = -1
                On Error Resume Next
                iCtlArrayIndex = iCtl.Index
                On Error GoTo 0
                If iCtlArrayIndex <> -1 Then
                    iName = iName & "(" & iCtlArrayIndex & ")"
                End If
            End If
            If iName = iControlName Then
                iFound = True
                Exit For
            End If
        Next
        If Not iFound Then
            RaiseError 1501, , "Control not found."
        Else
            If TypeName(iCtl) = "Line" Then
                ControlMove iControlName, ControlLeft(iControlName), iCtl.Y1, iCtl.X2 - iCtl.X1, iCtl.Y2 - iCtl.Y1, iIndex
            Else
                ControlMove iControlName, ControlLeft(iControlName), iCtl.Top, iCtl.Width, iCtl.Height, iIndex
            End If
        End If
    End If
End Sub

Private Sub SetAutoTabHeight()
    Dim iHeight As Single
    Dim t As Long
    Dim iIconExtentHimetric As Long
    Dim iOrigHeight As Long
    Dim iVerticalSpaceFromIconToCaption As Long
    Dim iCloseInkHeight As Single
    Dim iStripInkHeight As Long
    Dim iStripInkHimetric As Single
    
    If Not mAutoTabHeight Then
        mSetAutoTabHeightPending = False
        Exit Sub
    End If
    
    ' Set here: Draw calls this before it assigns the flag itself. It is a pure function of
    ' mTabOrientation
    mTabsAreRotatedButCaptionsAreHorizontal = (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationLeftBottomHorizontal) Or (mTabOrientation = ntTabOrientationRightHorizontal) Or (mTabOrientation = ntTabOrientationRightBottomHorizontal)
    mTabsOrderReversed = (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationRightBottomHorizontal)
    
    If Not picAux2.Font Is mFont Then
        Set picAux2.Font = mFont
    End If
    
    iHeight = pScaleY(picAux2.TextHeight("Atjq_"), picAux2.ScaleMode, vbHimetric)
    ' The close button is content as much as the caption is, and its glyph does not shrink with the
    ' tab - its font size is fixed.
    SetupCloseButtonFont
    If mCloseButtonGlyphInkHeight > 0 Then
        For t = 0 To mTabs - 1
            If mTabData(t).Visible Then
                If TabCloseButtonAllowed(t) Then
                    iCloseInkHeight = pScaleY(mCloseButtonGlyphInkHeight, vbPixels, vbHimetric)
                    Exit For
                End If
            End If
        Next t
    End If
    ' The 8 this used to add was the vertical half of the same air TabPaddingWidth gives along the
    ' caption, and it was already the only one of the two that scaled with the DPI.
    mTabHeight = iHeight * 1.02
    If iCloseInkHeight > mTabHeight Then mTabHeight = iCloseInkHeight
    ' By the setting and not by the overflow: the height feeds the column extent of the *Horizontal,
    ' so tying it to whether the row overflows would loop
    If mTabsOverflow <> ntTOMultiRow Then
        iStripInkHeight = mStripButtonsGlyphInkHeight
        If mTabsOverflow = ntTOScrollWithList Then
            If mStripListGlyphInkHeight > iStripInkHeight Then iStripInkHeight = mStripListGlyphInkHeight
        End If
        If iStripInkHeight > 0 Then
            iStripInkHimetric = pScaleY(iStripInkHeight, vbPixels, vbHimetric)
            If iStripInkHimetric > mTabHeight Then mTabHeight = iStripInkHimetric
        End If
    End If
    mTabHeight = mTabHeight + pScaleY(2 * mTabPaddingHeightDPIScaled, vbPixels, vbHimetric)
    iOrigHeight = mTabHeight
    
    ' StackedIconGap, in himetric
    iVerticalSpaceFromIconToCaption = pScaleY(CLng(pScaleY(mTabHeight, vbHimetric, vbPixels) * 0.05 + mDPIScale), vbPixels, vbHimetric)
    For t = 0 To mTabs - 1
        If Not mTabData(t).Visible Then
            ' deliberately nothing.
        ElseIf (Not mTabData(t).DoNotUseIconFont) And (mTabData(t).IconChar <> 0) Then
            Dim iIconCharacter As String
            Dim iIconCharRect As RECT
            Dim iFlags As Long
            Dim iIconFont As StdFont
            Dim iIconPadding As Long
            
            If mTabData(t).IconFont Is Nothing Then
                Set iIconFont = mDefaultIconFont
            Else
                Set iIconFont = mTabData(t).IconFont
            End If
            iIconPadding = pScaleY(3 * mDPIScale + iIconFont.Size * 0.22, vbPixels, vbHimetric)
            iIconCharacter = ChrU(mTabData(t).IconChar)
            iIconCharRect.Left = 0
            iIconCharRect.Top = 0
            iIconCharRect.Right = 0
            iIconCharRect.Bottom = 0
            iFlags = DT_CALCRECT Or DT_SINGLELINE Or DT_CENTER
            Set picAuxIconFont.Font = iIconFont
            DrawTextW picAuxIconFont.hDC, StrPtr(iIconCharacter), -1, iIconCharRect, iFlags Or IIf(mRightToLeft, DT_RTLREADING, 0)
            ' Same axis question as the picture branch below, and the same answer: the four
            ' *Horizontal orientations paint their icons upright, after the rotation, so what runs
            ' along the strip is the glyph's line box and not its advance width.
            If (mTabOrientation = ssTabOrientationTop) Or (mTabOrientation = ntTabOrientationTopRight) Or (mTabOrientation = ssTabOrientationBottom) Or (mTabOrientation = ntTabOrientationBottomRight) Or mTabsAreRotatedButCaptionsAreHorizontal Then
                iIconExtentHimetric = (iIconCharRect.Bottom - iIconCharRect.Top)
            Else
                iIconExtentHimetric = (iIconCharRect.Right - iIconCharRect.Left)
            End If
            iIconExtentHimetric = pScaleY(iIconExtentHimetric, vbPixels, vbHimetric)
            If (mIconAlignment = ntIconAlignAtTop) Or (mIconAlignment = ntIconAlignAtBottom) Then
                If (iOrigHeight + iIconExtentHimetric + iVerticalSpaceFromIconToCaption) > mTabHeight Then
                    mTabHeight = iOrigHeight + iIconExtentHimetric + iVerticalSpaceFromIconToCaption
                End If
            ElseIf iIconExtentHimetric + iIconPadding > mTabHeight Then
                mTabHeight = iIconExtentHimetric + iIconPadding
            End If
        Else
            If Not mTabData(t).PicToUseSet Then SetPicToUse t
    
            iIconExtentHimetric = 0
            If Not mTabData(t).PicToUse Is Nothing Then
                ' Which side of the icon runs along the strip, which is what this routine is
                ' measuring.
                If (mTabOrientation = ssTabOrientationTop) Or (mTabOrientation = ntTabOrientationTopRight) Or (mTabOrientation = ssTabOrientationBottom) Or (mTabOrientation = ntTabOrientationBottomRight) Or mTabsAreRotatedButCaptionsAreHorizontal Then
                    iIconExtentHimetric = mTabData(t).PicToUse.Height
                Else
                    iIconExtentHimetric = mTabData(t).PicToUse.Width
                End If
            End If
            ' Stacked, the same way the font icon branch above already was: with AtTop or AtBottom
            ' the icon sits over or under the caption instead of beside it, so the tab has to be as
            ' tall as the two of them plus the gap.
            If iIconExtentHimetric > 0 Then
                If (mIconAlignment = ntIconAlignAtTop) Or (mIconAlignment = ntIconAlignAtBottom) Then
                    If (iOrigHeight + iIconExtentHimetric + iVerticalSpaceFromIconToCaption) > mTabHeight Then
                        mTabHeight = iOrigHeight + iIconExtentHimetric + iVerticalSpaceFromIconToCaption
                    End If
                Else
                    ' The counterpart of iIconPadding in the font branch, and like it, only when
                    ' there is an icon to pad.
                    iIconExtentHimetric = iIconExtentHimetric + pScaleY(6 * mDPIScale, vbPixels, vbHimetric)
                    If iIconExtentHimetric > mTabHeight Then
                        mTabHeight = iIconExtentHimetric
                    End If
                End If
            End If
        End If
    Next
    
    If mAppearanceIsFlat And (Not mTabsAreRotatedButCaptionsAreHorizontal) Then
        If mHighlightFlatBar Or mHighlightFlatBarSelectedTab Then
            mTabHeight = mTabHeight + pScaleY(mFlatBarHeightDPIScaled, vbPixels, vbHimetric)
            If mHighlightFlatBarWithGrip Or mHighlightFlatBarWithGripSelectedTab Then
                If mFlatBarGripHeightDPIScaled < 0 Then
                    mTabHeight = mTabHeight - pScaleY(mFlatBarGripHeightDPIScaled, vbPixels, vbHimetric)
                End If
            End If
        End If
        mTabHeight = mTabHeight + pScaleY(mFlatTabBodyGapDPIScaled, vbPixels, vbHimetric)
    End If
    If mTDIMode = ntTDIModeForms Then
        ' A floor so the strip does not come out cramped. It used to be 37, which is 32 plus padding
        ' - a form icon is 32x32 and there was no way to ask for anything else.
        If mTabHeight < pScaleY(cTDIFormsMinTabHeight, vbPixels, vbHimetric) Then
            mTabHeight = pScaleY(cTDIFormsMinTabHeight, vbPixels, vbHimetric)
        End If
    End If
    mSetAutoTabHeightPending = False
    ' The property window has no other way to learn the new height: TabHeight is derived while
    ' AutoTabHeight is on, but the developer still reads it there after changing the font or the
    ' padding, and without this it went on showing the old number until the browser was refreshed.
    If Not mControlJustAdded Then SetPropertyChanged "TabHeight"
End Sub

Private Property Get UserControlContainedControlsCount() As Long
    On Error Resume Next
    UserControlContainedControlsCount = UserControl.ContainedControls.Count
    Err.Clear
End Property


Private Property Get UserControlContainedControls() As Object
    On Error Resume Next
    Set UserControlContainedControls = UserControl.ContainedControls
    If UserControlContainedControls Is Nothing Then
        Set UserControlContainedControls = New Collection
    End If
    Err.Clear
End Property

Friend Property Get UserControlWidth() As Single
    UserControlWidth = UserControl.Width
End Property

Friend Property Get UserControlHeight() As Single
    UserControlHeight = UserControl.Height
End Property


Public Property Get OLEDropOnOtherTabs() As Boolean
Attribute OLEDropOnOtherTabs.VB_Description = "Returns/sets a value that determines if the user in a OLE drag operation will be able to drop over inactive tabs or just over the selected tab."
Attribute OLEDropOnOtherTabs.VB_ProcData.VB_Invoke_Property = ";Behavior"
    OLEDropOnOtherTabs = mOLEDropOnOtherTabs
End Property

Public Property Let OLEDropOnOtherTabs(ByVal nValue As Boolean)
    If nValue <> mOLEDropOnOtherTabs Then
        mOLEDropOnOtherTabs = nValue
        SetPropertyChanged "OLEDropOnOtherTabs"
    End If
End Property


Public Property Get TabMousePointerHand() As Boolean
Attribute TabMousePointerHand.VB_Description = "Returns/sets a value that determines if the mouse pointer over tabs will be the hand."
Attribute TabMousePointerHand.VB_ProcData.VB_Invoke_Property = ";Behavior"
    TabMousePointerHand = mTabMousePointerHand
End Property

Public Property Let TabMousePointerHand(ByVal nValue As Boolean)
    If nValue <> mTabMousePointerHand Then
        mTabMousePointerHand = nValue
        SetPropertyChanged "TabMousePointerHand"
    End If
