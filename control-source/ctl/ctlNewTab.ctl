' The close button has the same five color slots the icon has, and the names match one to
' one on purpose: CloseButtonColor / ...SelectedTab / ...MouseHover / ...MouseHoverSelectedTab
' / ...TabHighlighted. TabHighlighted only ever reaches a tab that is not the selected one,
' because the selected tab has its own pair, so five slots cover every combination and there
' is no sixth "highlighted and selected" state to add - the icon does not have one either
Public Property Get CloseButtonColor() As OLE_COLOR
Attribute CloseButtonColor.VB_Description = "Returns/sets the color used to draw the close button (the 'x') of the tabs."
Attribute CloseButtonColor.VB_ProcData.VB_Invoke_Property = ";Buttons"
    CloseButtonColor = mCloseButtonColor
End Property

Public Property Let CloseButtonColor(ByVal nValue As OLE_COLOR)
    Dim iAutomatic As Boolean
    
    ' The four blocks that pushed this colour into the rest of the family are gone.
    
    iAutomatic = (nValue = -1)
    If Not iAutomatic Then
        If Not IsValidOLE_COLOR(nValue) Then RaiseError 380, TypeName(Me): Exit Property
    End If
    If (iAutomatic <> mCloseButtonColor_IsAutomatic) Or ((Not iAutomatic) And (nValue <> mCloseButtonColor)) Then
        mCloseButtonColor_IsAutomatic = iAutomatic
        SetPropertyChanged "CloseButtonColor"
        ApplyChainColors ntChainCloseButtonColor, nValue
    End If
End Property


Public Property Get CloseButtonColorSelectedTab() As OLE_COLOR
Attribute CloseButtonColorSelectedTab.VB_Description = "Returns/sets the color used to draw the close button (the 'x') of the selected tab."
Attribute CloseButtonColorSelectedTab.VB_ProcData.VB_Invoke_Property = ";Buttons"
    CloseButtonColorSelectedTab = mCloseButtonColorSelectedTab
End Property

Public Property Let CloseButtonColorSelectedTab(ByVal nValue As OLE_COLOR)
    Dim iAutomatic As Boolean
    
    iAutomatic = (nValue = -1)
    If Not iAutomatic Then
        If Not IsValidOLE_COLOR(nValue) Then RaiseError 380, TypeName(Me): Exit Property
    End If
    If (iAutomatic <> mCloseButtonColorSelectedTab_IsAutomatic) Or ((Not iAutomatic) And (nValue <> mCloseButtonColorSelectedTab)) Then
        mCloseButtonColorSelectedTab_IsAutomatic = iAutomatic
        SetPropertyChanged "CloseButtonColorSelectedTab"
        ApplyChainColors ntChainCloseButtonColorSelectedTab, nValue
    End If
End Property


Public Property Get CloseButtonColorMouseHover() As OLE_COLOR
Attribute CloseButtonColorMouseHover.VB_Description = "Returns/sets the color used to draw the close button (the 'x') of a tab when the mouse pointer is over it."
Attribute CloseButtonColorMouseHover.VB_ProcData.VB_Invoke_Property = ";Buttons"
    CloseButtonColorMouseHover = mCloseButtonColorMouseHover
End Property

Public Property Let CloseButtonColorMouseHover(ByVal nValue As OLE_COLOR)
    ' No automatic flag, unlike the rest of the foreground family, and it is not an omission.
    If nValue = -1 Then nValue = cPropDef_CloseButtonColorMouseHover
    If nValue <> mCloseButtonColorMouseHover Then
        If Not IsValidOLE_COLOR(nValue) Then RaiseError 380, TypeName(Me): Exit Property
        mCloseButtonColorMouseHover = nValue
        SetPropertyChanged "CloseButtonColorMouseHover"
        ' No redraw: the 'x' only shows this colour with the pointer on it
    End If
End Property


Public Property Get CloseButtonColorMouseHoverSelectedTab() As OLE_COLOR
Attribute CloseButtonColorMouseHoverSelectedTab.VB_Description = "Returns/sets the color used to draw the close button (the 'x') of the selected tab when the mouse pointer is over it."
Attribute CloseButtonColorMouseHoverSelectedTab.VB_ProcData.VB_Invoke_Property = ";Buttons"
    CloseButtonColorMouseHoverSelectedTab = mCloseButtonColorMouseHoverSelectedTab
End Property

Public Property Let CloseButtonColorMouseHoverSelectedTab(ByVal nValue As OLE_COLOR)
    ' No automatic flag, unlike the rest of the foreground family, and it is not an omission.
    If nValue = -1 Then nValue = cPropDef_CloseButtonColorMouseHover
    If nValue <> mCloseButtonColorMouseHoverSelectedTab Then
        If Not IsValidOLE_COLOR(nValue) Then RaiseError 380, TypeName(Me): Exit Property
        mCloseButtonColorMouseHoverSelectedTab = nValue
        SetPropertyChanged "CloseButtonColorMouseHoverSelectedTab"
        ' No redraw: the 'x' only shows this colour with the pointer on it
    End If
End Property


Public Property Get CloseButtonColorTabHighlighted() As OLE_COLOR
Attribute CloseButtonColorTabHighlighted.VB_Description = "Returns/sets the color used to draw the close button (the 'x') of a tab when the tab is highlighted (not the 'x' itself)."
Attribute CloseButtonColorTabHighlighted.VB_ProcData.VB_Invoke_Property = ";Buttons"
    CloseButtonColorTabHighlighted = mCloseButtonColorTabHighlighted
End Property

Public Property Let CloseButtonColorTabHighlighted(ByVal nValue As OLE_COLOR)
    Dim iAutomatic As Boolean
    
    iAutomatic = (nValue = -1)
    If Not iAutomatic Then
        If Not IsValidOLE_COLOR(nValue) Then RaiseError 380, TypeName(Me): Exit Property
    End If
    If (iAutomatic <> mCloseButtonColorTabHighlighted_IsAutomatic) Or ((Not iAutomatic) And (nValue <> mCloseButtonColorTabHighlighted)) Then
        mCloseButtonColorTabHighlighted_IsAutomatic = iAutomatic
        SetPropertyChanged "CloseButtonColorTabHighlighted"
        ApplyChainColors ntChainCloseButtonColorTabHighlighted, nValue
    End If
