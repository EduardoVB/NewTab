Public Property Let NewTabButtonToolTipText(ByVal nValue As String)
    If nValue <> mNewTabButtonToolTipText Then
        mNewTabButtonToolTipText = nValue
        ' written straight into the button: TabToolTipText refuses its index once it is flagged
        If TabIsNewTabButton(mTabs - 1) Then
            mTabData(mTabs - 1).ToolTipText = nValue
            CheckIfThereAreTabsToolTipTexts
        End If
        SetPropertyChanged "NewTabButtonToolTipText"
    End If
End Property

