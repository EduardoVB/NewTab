Attribute VB_Name = "NewTab"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Attribute VB_Description = "NewTab: tabbed control"
Option Explicit

' Set the line below to 0 to disable the IDE protection (with IDE protection some features are be lost in the IDE-uncompiled when it is set to 1, like changing tabs with a click at design time)
#Const NOSUBCLASSINIDE = 1

' Prints the font metrics the close button glyph is centred with, once per control
#Const CLOSEBUTTONGLYPHDIAG = 0 ' TEMP diagnostic

' Dumps the width numbers of the stacked pair - AtTop and AtBottom only - on both sides of the
' fence: what MeasureTabIconAndCaption reserved for the tab, and where DrawTabIconAndCaption then
' put the icon inside it.
#Const STACKEDICONDIAG = 0 ' TEMP diagnostic
' Dumps both sides of the fence for the new tab button: what MeasureTabIconAndCaption
' reserved for it and what DrawTabIconAndCaption ended up drawing. The button holds one
' glyph and no caption, which is the case none of the nine alignments were written for
#Const NEWTABBUTTONDIAG = 0 ' TEMP diagnostic
' Counts, per Draw, how many FillCurvedGradient2 calls and how many scanlines were solid and how
' many carried a real gradient, and how long the routine took in total against the whole Draw.
#Const SOLIDFILLDIAG = 0 ' TEMP diagnostic
' Splits the rotation stage of Draw into its steps and prints one line per Draw: the two full
' surface operations that open the painting, the capture of the as-Top image, the Cls that detaches
' it from picDraw's persistent bitmap, the rotation itself, the picDraw resize the *Horizontal ones
' do and the final paste.
#Const ROTATIONDIAG = 0 ' TEMP diagnostic
' The rotated image of the previous Draw, reused when the part of the as-Top image below the tab
' strip is byte for byte the one that produced it, so only the strip has to be rotated again.
#Const ROTATECACHE = 1

' Prints the numbers behind the caption band of the *Horizontal orientations: the column width the
' tabs were sized to, and the band each caption is then measured and drawn inside.
#Const HORIZCAPTIONDIAG = 0 ' TEMP diagnostic
' Dumps the chain that ends up placing a caption vertically inside its tab: the tab rect the tab was
' given, the band GetTabSpaceRect carves out of it, the height DrawText measured for the caption,
' the offset CenterOffset answers and the rect the text is finally drawn in.
#Const CAPTIONPOSDIAG = 0 ' TEMP diagnostic
' Dumps how the width of a row is shared out, which is the one thing three readings of the code in a
' row got wrong.
#Const ROWWIDTHDIAG_RWDIAG = 0 ' TEMP diagnostic
#Const ROWWIDTHDIAG_DTDIAG = 0 ' TEMP diagnostic
' One line per tab of the LAST row, printed at the end of DrawTab, answering a single question: how
' far down does that tab's rectangle reach against where the body's frame actually starts.
#Const LASTROWBOTTOMDIAG = 0 ' TEMP diagnostic
' Measures how far a tab paints outside its own rectangle.
#Const TABCLIPDIAG = 0 ' TEMP diagnostic
' Follows one probe pixel through the four stages of a Draw, so that a stray pixel can be attributed
' to a stage instead of argued about: p0 after the strip and after the hover base has been restored
' or kept, p1 after the hover replay, p2 after the body, p3 after the active tab.
#Const HOVERCLIPDIAG = 0 ' TEMP diagnostic
' Reads picDraw.Point(1, mBodyStart - 1) at three moments - after each tab's left line, at the end
' of each tab, and in DrawBody right after the body's left twin - to find who clears the pixel where
' the tab's light column hands over to the body's.
#Const TWINJOINDIAG = 0 ' TEMP diagnostic
' Prints the body's far-end column (as-Top x = mBodyWidth - 1) after the body and after the active tab.
#Const BODYEDGEDIAG = 0 ' TEMP diagnostic
#Const SHEETDIAG = 0 ' TEMP diagnostic

Implements IBSSubclass

Private Type STYLESTRUCT
   styleOld As Long
   styleNew As Long
End Type

Private Type RECT
    Left As Long
    Top As Long
    Right As Long
    Bottom As Long
End Type

Private Type POINTAPI
    X As Long
    Y As Long
End Type

' The three below serve one question: where the ink of a single glyph really sits inside
' the line box the font declares. Member names are prefixed because the API ones collide
' with reserved words (FIXED.value)
Private Type NTFIXED
    nFract As Integer
    nWhole As Integer
End Type

Private Type MAT2
    eM11 As NTFIXED
    eM12 As NTFIXED
    eM21 As NTFIXED
    eM22 As NTFIXED
End Type

Private Type GLYPHMETRICS
    gmBlackBoxX As Long
    gmBlackBoxY As Long
    gmptGlyphOrigin As POINTAPI
    gmCellIncX As Integer
    gmCellIncY As Integer
End Type

Private Type TEXTMETRICW
    tmHeight As Long
    tmAscent As Long
    tmDescent As Long
    tmInternalLeading As Long
    tmExternalLeading As Long
    tmAveCharWidth As Long
    tmMaxCharWidth As Long
    tmWeight As Long
    tmOverhang As Long
    tmDigitizedAspectX As Long
    tmDigitizedAspectY As Long
    tmFirstChar As Integer
    tmLastChar As Integer
    tmDefaultChar As Integer
    tmBreakChar As Integer
    tmItalic As Byte
    tmUnderlined As Byte
    tmStruckOut As Byte
    tmPitchAndFamily As Byte
    tmCharSet As Byte
End Type

Private Type WINDOWPOS
   hWnd As LongPtr
   hWndInsertAfter As LongPtr
   X As Long
   Y As Long
   cx As Long
   cy As Long
   Flags As Long
End Type

'Bitmap type used to store Bitmap Data
Private Type BITMAP
  bmType As Long
  bmWidth As Long
  bmHeight As Long
  bmWidthBytes As Long
  bmPlanes As Integer
  bmBitsPixel As Integer
  bmBits As LongPtr
End Type

Private Type ICONINFO
  fIcon As Long
  xHotspot As Long
  yHotspot As Long
  hbmMask As LongPtr
  hbmColor As LongPtr
End Type

Private Type RGBQUAD
  rgbBlue As Byte
  rgbGreen As Byte
  rgbRed As Byte
  rgbReserved As Byte
End Type

Private Type BITMAPINFOHEADER
  biSize As Long
  biWidth As Long
  biHeight As Long
  biPlanes As Integer
  biBitCount As Integer
  biCompression As Long
  biSizeImage As Long
  biXPelsPerMeter As Long
  biYPelsPerMeter As Long
  biClrUsed As Long
  biClrImportant As Long
End Type

Private Type BITMAPINFO
  bmiHeader As BITMAPINFOHEADER
  bmiColors(0 To 0) As RGBQUAD
End Type

Private Type LOGFONTW
    LFHeight As Long
    LFWidth As Long
    LFEscapement As Long
    LFOrientation As Long
    LFWeight As Long
    LFItalic As Byte
    LFUnderline As Byte
    LFStrikeOut As Byte
    LFCharset As Byte
    LFOutPrecision As Byte
    LFClipPrecision As Byte
    LFQuality As Byte
    LFPitchAndFamily As Byte
    LFFaceName(0 To 31) As Integer
End Type

Private Type MENUITEMINFOW
    cbSize As Long
    fMask As Long
    fType As Long
    fState As Long
    wID As Long
    hSubMenu As LongPtr
    hbmpChecked As LongPtr
    hbmpUnchecked As LongPtr
    dwItemData As LongPtr
    dwTypeData As LongPtr
    cch As Long
    hbmpItem As LongPtr
End Type

Private Type NONCLIENTMETRICSW
    cbSize As Long
    iBorderWidth As Long
    iScrollWidth As Long
    iScrollHeight As Long
    iCaptionWidth As Long
    iCaptionHeight As Long
    lfCaptionFont As LOGFONTW
    iSMCaptionWidth As Long
    iSMCaptionHeight As Long
    lfSMCaptionFont As LOGFONTW
    iMenuWidth As Long
    iMenuHeight As Long
    lfMenuFont As LOGFONTW
    lfStatusFont As LOGFONTW
    lfMessageFont As LOGFONTW
    iPaddedBorderWidth As Long
End Type

Private Type PAINTSTRUCT
    hDC                     As LongPtr
    fErase                  As Long
    rcPaint                 As RECT
    fRestore                As Long
    fIncUpdate              As Long
    rgbReserved(1 To 32)    As Byte
End Type

Private Type T_MSG
    hWnd As LongPtr
    Message As Long
    wParam As LongPtr
    lParam As LongPtr
    time As Long
    pt As POINTAPI
End Type

Private Type tagHIGHCONTRAST
    cbSize As Long
    dwFlags As Long
    lpszDefaultScheme As LongPtr
End Type

Private Type XFORM
    eM11 As Single
    eM12 As Single
    eM21 As Single
    eM22 As Single
    eDx As Single
    eDy As Single
End Type

Private Type PICTDESC
    cbSizeOfStruct As Long
    PicType As Long
    hImage As LongPtr
    XExt As Long
    YExt As Long
End Type
 
Private Type CLSID
    Data1 As Long
    Data2 As Integer
    Data3 As Integer
    Data4(0 To 7) As Byte
End Type

