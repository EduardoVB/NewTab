' Properties

' Returns/sets the background color.
Public Property Get BackColor() As OLE_COLOR
Attribute BackColor.VB_Description = "Returns/sets the background color used to display text and graphics in an object."
Attribute BackColor.VB_ProcData.VB_Invoke_Property = ";Colors"
Attribute BackColor.VB_UserMemId = -501
Attribute BackColor.VB_MemberFlags = "c"
    BackColor = mBackColor
End Property

Public Property Let BackColor(ByVal nValue As OLE_COLOR)
    Dim iFromAmbient As Boolean
    
    ' -1 is how the developer says "follow the container again".
    iFromAmbient = mBackColorIsFromAmbient
    If nValue = -1 Then
        iFromAmbient = True
        nValue = Ambient.BackColor
    ElseIf Not mSettingColorFromAmbient Then
        ' An assignment is a decision, so it unhooks the color from the container, even when the
        ' value happens to equal Ambient.BackColor.
        iFromAmbient = False
    End If
    If (nValue <> mBackColor) Or (iFromAmbient <> mBackColorIsFromAmbient) Then
        If Not IsValidOLE_COLOR(nValue) Then RaiseError 380, TypeName(Me): Exit Property
        mBackColorIsFromAmbient = iFromAmbient
        mBackColor = nValue
        SetPropertyChanged "BackColor"
        UserControl.BackColor = mBackColor
        ApplyChainColors
        ResetCachedThemeImages
        DrawDelayed
    End If
End Property


' Returns a Font object.
Public Property Get Font() As StdFont
Attribute Font.VB_Description = "Returns/sets the Font that will be used to draw the tab captions."
Attribute Font.VB_ProcData.VB_Invoke_Property = ";Font"
Attribute Font.VB_UserMemId = -512
    Set Font = mFont
End Property

Public Property Let Font(ByVal nValue As StdFont)
    Set Font = nValue
End Property

Public Property Set Font(ByVal nValue As StdFont)
    If Not nValue Is mFont Then
        Set mFont = nValue
        SetPropertyChanged "Font"
        SetFont
        mSetAutoTabHeightPending = True
        DrawDelayed
    End If
End Property


Public Property Get IconFont() As StdFont
Attribute IconFont.VB_Description = "Returns/sets the Font that will be used to draw the icon of the currently selected tab."
Attribute IconFont.VB_ProcData.VB_Invoke_Property = ";Icon"
    Set IconFont = TabIconFont(mTab)
End Property

Public Property Let IconFont(ByVal nValue As StdFont)
    Set TabIconFont(mTab) = nValue
End Property

Public Property Set IconFont(ByVal nValue As StdFont)
    Set TabIconFont(mTab) = nValue
End Property


Public Property Get TabIconFont(ByVal nTab As Variant) As StdFont
Attribute TabIconFont.VB_Description = "Returns/sets the Font that will be used to draw the icon in the tab pointed by the Index parameter."
Attribute TabIconFont.VB_ProcData.VB_Invoke_Property = ";Icon"
    Dim iIndex As Long
    
    iIndex = GetTabIndex(nTab)
    If Not IsValidTabIndex(iIndex) Then
        RaiseError 381, TypeName(Me) ' invalid property array index
        Exit Property
    End If
    If mTabData(iIndex).IconFont Is Nothing Then
        Set mTabData(iIndex).IconFont = CloneFont(mDefaultIconFont)
        mTabIconFontsEventsHandler.AddFont mTabData(iIndex).IconFont, CLng(iIndex)
    End If
    Set TabIconFont = mTabData(iIndex).IconFont
End Property

Public Property Let TabIconFont(ByVal nTab As Variant, ByVal nValue As StdFont)
    Dim iIndex As Long
    
    iIndex = GetTabIndex(nTab)
    If Not IsValidTabIndex(iIndex) Then
        RaiseError 381, TypeName(Me) ' invalid property array index
        Exit Property
    End If
    Set TabIconFont(iIndex) = nValue
End Property

Public Property Set TabIconFont(ByVal nTab As Variant, ByVal nValue As StdFont)
    Dim iIndex As Long
    
    iIndex = GetTabIndex(nTab)
    If Not IsValidTabIndex(iIndex) Then
        RaiseError 381, TypeName(Me) ' invalid property array index
        Exit Property
    End If
    If Not nValue Is mTabData(iIndex).IconFont Then
        If Not mTabData(iIndex).IconFont Is Nothing Then mTabIconFontsEventsHandler.RemoveFont mTabData(iIndex).IconFont, CLng(iIndex)
        Set mTabData(iIndex).IconFont = nValue
        If Not mTabData(iIndex).IconFont Is Nothing Then
            mTabIconFontsEventsHandler.AddFont mTabData(iIndex).IconFont, CLng(iIndex)
            mTabData(iIndex).IconFontName = nValue.Name
        Else
            mTabData(iIndex).IconFontName = ""
        End If
        mTabData(iIndex).DoNotUseIconFont = False
        SetPropertyChanged "IconFont"
        mSetAutoTabHeightPending = True
        DrawDelayed
    End If
End Property


Private Sub SetFont()
    On Error Resume Next
    If mFont Is Nothing Then
        Set mFont = Ambient.Font
    End If
    If mFont Is Nothing Then
        Set mFont = UserControl.Font
    End If
    Set UserControl.Font = mFont
    Set picDraw.Font = CloneFont(mFont)
    Set picAux.Font = picDraw.Font
    Err.Clear
End Sub

' Determines if the control is enabled.
Public Property Get Enabled() As Boolean
Attribute Enabled.VB_Description = "Returns/sets a value that determines whether a form or control can respond to user-generated events."
Attribute Enabled.VB_ProcData.VB_Invoke_Property = ";Behavior"
Attribute Enabled.VB_UserMemId = -514
    Enabled = mEnabled
End Property

Public Property Let Enabled(ByVal nValue As Boolean)
    Dim iRedraw As Boolean
    Dim iWv As Boolean
    
    If nValue <> mEnabled Then
        mEnabled = nValue
        UserControl.Enabled = mEnabled Or (Not mAmbientUserMode)
        SetPropertyChanged "Enabled"
        If mChangeControlsBackColor Then
            If mShowDisabledState Then
                mBodyReset = True
                iWv = IsWindowVisible(mUserControlHwnd) <> 0
                If iWv Then SendMessage mUserControlHwnd, WM_SETREDRAW, False, 0&
                ' no previous color passed on purpose: mControlsBackColor_PrevColor holds
                ' exactly what was delivered last, which the explicit pair here got wrong
                ' whenever the active tab had a custom color
                SetControlsProperBackColor
                If iWv Then
                    SendMessage mUserControlHwnd, WM_SETREDRAW, True, 0&
                    iRedraw = True
                End If
            End If
        End If
        mSubclassControlsPaintingPending = True
        mRepaintSubclassedControls = True
        DrawDelayed
        If iRedraw Then
            RedrawWindow mUserControlHwnd, ByVal 0&, 0&, RDW_INVALIDATE Or RDW_ALLCHILDREN
        End If
    End If
End Property

            
' The parent that shares this colour's state: same tab state, more generic role. It wins ties
' with the role axis, because at the moment a highlighted tab is drawn what defines it is that
' it is highlighted, and the background of that state may have moved too
'
' The icons, the close button and the '+' are three independent branches of the caption, and
' none of them hangs from another. IconColor is the colour of content - the drawings the
' developer chose to put on the tabs - while the 'x' and the '+' are furniture, parts of the
' control's own interface: wanting the icons in a colour of their own is not wanting the two
' buttons in it too, and either of them can be set on its own. What the three do share is the
' caption of their state, which is the one move they are meant to follow together
Private Function ChainParentSameState(ByVal nChainIndex As Long) As Long
    Select Case nChainIndex
        Case ntChainIconColor: ChainParentSameState = ntChainForeColor
        Case ntChainIconColorSelectedTab: ChainParentSameState = ntChainForeColorSelectedTab
        Case ntChainIconColorTabHighlighted: ChainParentSameState = ntChainForeColorHighlighted
        Case ntChainCloseButtonColor: ChainParentSameState = ntChainForeColor
        Case ntChainCloseButtonColorSelectedTab: ChainParentSameState = ntChainForeColorSelectedTab
        Case ntChainCloseButtonColorTabHighlighted: ChainParentSameState = ntChainForeColorHighlighted
        Case ntChainNewTabButtonColor: ChainParentSameState = ntChainForeColor
        Case ntChainNewTabButtonColorHighlighted: ChainParentSameState = ntChainForeColorHighlighted
        Case Else: ChainParentSameState = -1
    End Select
End Function

' The parent that shares this colour's role: same element, more generic tab state
Private Function ChainParentSameRole(ByVal nChainIndex As Long) As Long
    Select Case nChainIndex
        Case ntChainForeColorSelectedTab: ChainParentSameRole = ntChainForeColor
        Case ntChainForeColorHighlighted: ChainParentSameRole = ntChainForeColor
        Case ntChainIconColorSelectedTab: ChainParentSameRole = ntChainIconColor
        Case ntChainIconColorTabHighlighted: ChainParentSameRole = ntChainIconColor
        Case ntChainIconColorMouseHover: ChainParentSameRole = ntChainIconColorTabHighlighted
        Case ntChainIconColorMouseHoverSelectedTab: ChainParentSameRole = ntChainIconColorSelectedTab
        Case ntChainCloseButtonColorSelectedTab: ChainParentSameRole = ntChainCloseButtonColor
        Case ntChainCloseButtonColorTabHighlighted: ChainParentSameRole = ntChainCloseButtonColor
        Case ntChainStripButtonsColorHighlighted: ChainParentSameRole = ntChainStripButtonsColor
        Case ntChainNewTabButtonColorHighlighted: ChainParentSameRole = ntChainNewTabButtonColor
        Case Else: ChainParentSameRole = -1
    End Select
End Function

' True for the colours that are on screen without the pointer doing anything. The rest only
' show while a tab is highlighted or hovered, and the hover that reveals them repaints on its
' own, so moving one of those does not have to cost a redraw
Private Function ChainColorIsOnScreenAtRest(ByVal nChainIndex As Long) As Boolean
    Select Case nChainIndex
        Case ntChainForeColor, ntChainForeColorSelectedTab, ntChainIconColor, ntChainIconColorSelectedTab
            ChainColorIsOnScreenAtRest = True
        Case ntChainFlatTabBorderColorSelectedTab, ntChainCloseButtonColor, ntChainCloseButtonColorSelectedTab, ntChainStripButtonsColor, ntChainNewTabButtonColor, ntChainFlatTabBorderColorInactive
            ChainColorIsOnScreenAtRest = True
    End Select
End Function

' The tree has to be in level order or the single ascending pass of ResolveChainColors reads a
' parent that has not been resolved yet, and answers with its previous value without failing
Private Function ChainTreeIsInLevelOrder() As Boolean
    Dim c As Long
    
    For c = 0 To cChainColorLast
        If ChainParentSameState(c) >= c Then Exit Function
        If ChainParentSameRole(c) >= c Then Exit Function
    Next c
    ChainTreeIsInLevelOrder = True
End Function

Private Property Get ChainColorIsSet(ByVal nChainIndex As Long) As Boolean
    Select Case nChainIndex
        ' The root. Its own automatic axis is the Ambient, which is a different question and
        ' already answered by the time anything gets here: mForeColor always holds a colour
        Case ntChainForeColor: ChainColorIsSet = True
        Case ntChainForeColorSelectedTab: ChainColorIsSet = Not mForeColorSelectedTab_IsAutomatic
        Case ntChainForeColorHighlighted: ChainColorIsSet = Not mForeColorHighlighted_IsAutomatic
        Case ntChainIconColor: ChainColorIsSet = Not mIconColor_IsAutomatic
        Case ntChainFlatTabBorderColorHighlighted: ChainColorIsSet = Not mFlatTabBorderColorHighlighted_IsAutomatic
        Case ntChainFlatTabBorderColorSelectedTab: ChainColorIsSet = Not mFlatTabBorderColorSelectedTab_IsAutomatic
        Case ntChainIconColorSelectedTab: ChainColorIsSet = Not mIconColorSelectedTab_IsAutomatic
        Case ntChainIconColorTabHighlighted: ChainColorIsSet = Not mIconColorTabHighlighted_IsAutomatic
        Case ntChainCloseButtonColor: ChainColorIsSet = Not mCloseButtonColor_IsAutomatic
        Case ntChainStripButtonsColor: ChainColorIsSet = Not mStripButtonsColor_IsAutomatic
        Case ntChainIconColorMouseHover: ChainColorIsSet = Not mIconColorMouseHover_IsAutomatic
        Case ntChainIconColorMouseHoverSelectedTab: ChainColorIsSet = Not mIconColorMouseHoverSelectedTab_IsAutomatic
        Case ntChainCloseButtonColorSelectedTab: ChainColorIsSet = Not mCloseButtonColorSelectedTab_IsAutomatic
        Case ntChainCloseButtonColorTabHighlighted: ChainColorIsSet = Not mCloseButtonColorTabHighlighted_IsAutomatic
        Case ntChainStripButtonsColorHighlighted: ChainColorIsSet = Not mStripButtonsColorHighlighted_IsAutomatic
        Case ntChainNewTabButtonColor: ChainColorIsSet = Not mNewTabButtonColor_IsAutomatic
        Case ntChainNewTabButtonColorHighlighted: ChainColorIsSet = Not mNewTabButtonColorHighlighted_IsAutomatic
        Case ntChainFlatTabBorderColorInactive: ChainColorIsSet = Not mFlatTabBorderColorInactive_IsAutomatic
    End Select
End Property

Private Property Get ChainColorValue(ByVal nChainIndex As Long) As Long
    Select Case nChainIndex
        Case ntChainForeColor: ChainColorValue = mForeColor
        Case ntChainForeColorSelectedTab: ChainColorValue = mForeColorSelectedTab
        Case ntChainForeColorHighlighted: ChainColorValue = mForeColorHighlighted
        Case ntChainIconColor: ChainColorValue = mIconColor
        Case ntChainFlatTabBorderColorHighlighted: ChainColorValue = mFlatTabBorderColorHighlighted
        Case ntChainFlatTabBorderColorSelectedTab: ChainColorValue = mFlatTabBorderColorSelectedTab
        Case ntChainIconColorSelectedTab: ChainColorValue = mIconColorSelectedTab
        Case ntChainIconColorTabHighlighted: ChainColorValue = mIconColorTabHighlighted
        Case ntChainCloseButtonColor: ChainColorValue = mCloseButtonColor
        Case ntChainStripButtonsColor: ChainColorValue = mStripButtonsColor
        Case ntChainIconColorMouseHover: ChainColorValue = mIconColorMouseHover
        Case ntChainIconColorMouseHoverSelectedTab: ChainColorValue = mIconColorMouseHoverSelectedTab
        Case ntChainCloseButtonColorSelectedTab: ChainColorValue = mCloseButtonColorSelectedTab
        Case ntChainCloseButtonColorTabHighlighted: ChainColorValue = mCloseButtonColorTabHighlighted
        Case ntChainStripButtonsColorHighlighted: ChainColorValue = mStripButtonsColorHighlighted
        Case ntChainNewTabButtonColor: ChainColorValue = mNewTabButtonColor
        Case ntChainNewTabButtonColorHighlighted: ChainColorValue = mNewTabButtonColorHighlighted
        Case ntChainFlatTabBorderColorInactive: ChainColorValue = mFlatTabBorderColorInactive
    End Select
End Property

Private Property Let ChainColorValue(ByVal nChainIndex As Long, ByVal nValue As Long)
    Select Case nChainIndex
        Case ntChainForeColor: mForeColor = nValue
        Case ntChainForeColorSelectedTab: mForeColorSelectedTab = nValue
        Case ntChainForeColorHighlighted: mForeColorHighlighted = nValue
        Case ntChainIconColor: mIconColor = nValue
        Case ntChainFlatTabBorderColorHighlighted: mFlatTabBorderColorHighlighted = nValue
        Case ntChainFlatTabBorderColorSelectedTab: mFlatTabBorderColorSelectedTab = nValue
        Case ntChainIconColorSelectedTab: mIconColorSelectedTab = nValue
        Case ntChainIconColorTabHighlighted: mIconColorTabHighlighted = nValue
        Case ntChainCloseButtonColor: mCloseButtonColor = nValue
        Case ntChainStripButtonsColor: mStripButtonsColor = nValue
        Case ntChainIconColorMouseHover: mIconColorMouseHover = nValue
        Case ntChainIconColorMouseHoverSelectedTab: mIconColorMouseHoverSelectedTab = nValue
        Case ntChainCloseButtonColorSelectedTab: mCloseButtonColorSelectedTab = nValue
        Case ntChainCloseButtonColorTabHighlighted: mCloseButtonColorTabHighlighted = nValue
        Case ntChainStripButtonsColorHighlighted: mStripButtonsColorHighlighted = nValue
        Case ntChainNewTabButtonColor: mNewTabButtonColor = nValue
        Case ntChainNewTabButtonColorHighlighted: mNewTabButtonColorHighlighted = nValue
        Case ntChainFlatTabBorderColorInactive: mFlatTabBorderColorInactive = nValue
    End Select
End Property

' Fills every slot nobody set with the colour of the nearest ancestor somebody did set, and at
' equal distance the state axis wins. The distance travels with the value, which is what makes
' one ascending pass right: the obvious VB6 shape - a recursion climbing the first parent -
' answers with the wrong ancestor and does it in silence, because with ForeColorSelectedTab
' unset and IconColor set it would take IconColorSelectedTab to ForeColor, at distance two,
' instead of to IconColor, at distance one.
'
' Everything arrives by parameter and no module variable is read on purpose: the per tab custom
' colours have the same tree and need the same answer, and the only way two faces stay in step
' is by running the same code, not by two copies of the same rule
Private Sub ResolveChainColors(ByRef nIsSet() As Boolean, ByRef nColor() As Long)
    Dim iDistance(cChainColorLast) As Long
    Dim iDistanceSameState As Long
    Dim iDistanceSameRole As Long
    Dim iParentSameState As Long
    Dim iParentSameRole As Long
    Dim c As Long
    
    Debug.Assert nIsSet(ntChainForeColor)
    For c = 0 To cChainColorLast
        If Not nIsSet(c) Then
            iParentSameState = ChainParentSameState(c)
            iParentSameRole = ChainParentSameRole(c)
            iDistanceSameState = cChainNoAncestor
            iDistanceSameRole = cChainNoAncestor
            If iParentSameState >= 0 Then iDistanceSameState = iDistance(iParentSameState) + 1
            If iParentSameRole >= 0 Then iDistanceSameRole = iDistance(iParentSameRole) + 1
            If (iParentSameState >= 0) And (iDistanceSameState <= iDistanceSameRole) Then
                nColor(c) = nColor(iParentSameState)
                iDistance(c) = iDistanceSameState
            ElseIf iParentSameRole >= 0 Then
                nColor(c) = nColor(iParentSameRole)
                iDistance(c) = iDistanceSameRole
            End If
        End If
    Next c
End Sub

' The one place the inherited foreground colours are recomputed. It gathers the property
' variables, resolves whatever nobody set, writes back only what moved, and carries the side
' effects that used to ride on the Property Let of each child. Until the pushes were removed a
' colour reached its children by calling their Let, and the contained controls, the TDI form
' icons and the '+' were refreshed from inside those. With the pushes gone nothing reaches
' them any more, so the three effects live here and are driven by what actually changed.
'
' nChainIndex and nNewColor carry the assignment that triggered the call, so the property
' variable is written here and not in the Let. That is what keeps "did this slot move" a plain
' comparison instead of a flag every caller has to remember to raise.
'
' nSilent is for the load and reset paths, which have their own redraw and their own
' invalidation and run before there is anything on screen to repaint
' StripButtonsColor has no parent in the tree: the buttons at the end of the strip sit on BackColor
' and not on the tabs, so its automatic value is not a colour of the tabs.
' The three FlatTabBorderColor are roots too: the border is the accent of its state, as the bar is,
' and not a colour of the text, so they take the bar of their state and not ForeColor
Private Sub SeedChainRoots(ByRef nIsSet() As Boolean, ByRef nColor() As Long)
    If Not nIsSet(ntChainStripButtonsColor) Then nColor(ntChainStripButtonsColor) = AutomaticStripButtonsColor(nColor(ntChainForeColor))
    If Not nIsSet(ntChainFlatTabBorderColorHighlighted) Then nColor(ntChainFlatTabBorderColorHighlighted) = mFlatBarColorHighlighted
    If Not nIsSet(ntChainFlatTabBorderColorSelectedTab) Then nColor(ntChainFlatTabBorderColorSelectedTab) = mFlatBarColorSelectedTab
    If Not nIsSet(ntChainFlatTabBorderColorInactive) Then nColor(ntChainFlatTabBorderColorInactive) = mFlatBarColorInactive
End Sub

' The per tab side of SeedChainRoots: a tab with a bar colour of its own gives it to its border
Private Sub SeedTabChainRoots(ByRef nIsSet() As Boolean, ByRef nColor() As Long, ByVal nFlatBarColorHighlighted As Variant, ByVal nFlatBarColorSelectedTab As Variant, ByVal nFlatBarColorInactive As Variant)
    If Not nIsSet(ntChainFlatTabBorderColorHighlighted) Then
        If Not IsEmpty(nFlatBarColorHighlighted) Then nColor(ntChainFlatTabBorderColorHighlighted) = CLng(nFlatBarColorHighlighted)
    End If
    If Not nIsSet(ntChainFlatTabBorderColorSelectedTab) Then
        If Not IsEmpty(nFlatBarColorSelectedTab) Then nColor(ntChainFlatTabBorderColorSelectedTab) = CLng(nFlatBarColorSelectedTab)
    End If
    If Not nIsSet(ntChainFlatTabBorderColorInactive) Then
        If Not IsEmpty(nFlatBarColorInactive) Then nColor(ntChainFlatTabBorderColorInactive) = CLng(nFlatBarColorInactive)
    End If
End Sub

' The container's text colour goes with a BackColor taken from the container. When BackColor was set
' to something it does not read on, ForeColor, and failing that black or white
Private Function AutomaticStripButtonsColor(ByVal nForeColor As Long) As Long
    Dim iAmbientForeColor As Long
    
    iAmbientForeColor = vbButtonText
    On Error Resume Next
    iAmbientForeColor = Ambient.ForeColor
    On Error GoTo 0
    If ColorsHaveEnoughContrast(mBackColor, iAmbientForeColor) Then
        AutomaticStripButtonsColor = iAmbientForeColor
    ElseIf ColorsHaveEnoughContrast(mBackColor, nForeColor) Then
        AutomaticStripButtonsColor = nForeColor
    ElseIf ColorsHaveEnoughContrast(mBackColor, vbBlack) Then
        AutomaticStripButtonsColor = vbBlack
    Else
        AutomaticStripButtonsColor = vbWhite
    End If
End Function

Private Sub ApplyChainColors(Optional ByVal nChainIndex As Long = -1, Optional ByVal nNewColor As Long = 0, Optional ByVal nSilent As Boolean)
    Dim iIsSet(cChainColorLast) As Boolean
    Dim iColor(cChainColorLast) As Long
    Dim iMoved(cChainColorLast) As Boolean
    Dim iPrevForeColorSelectedTab As Long
    Dim iRedraw As Boolean
    Dim c As Long
    
    For c = 0 To cChainColorLast
        iIsSet(c) = ChainColorIsSet(c)
        iColor(c) = ChainColorValue(c)
    Next c
    If nChainIndex >= 0 Then iColor(nChainIndex) = nNewColor
    iPrevForeColorSelectedTab = mForeColorSelectedTab
    
    SeedChainRoots iIsSet, iColor
    ResolveChainColors iIsSet, iColor
    
    For c = 0 To cChainColorLast
        If iColor(c) <> ChainColorValue(c) Then
            iMoved(c) = True
            ChainColorValue(c) = iColor(c)
            If ChainColorIsOnScreenAtRest(c) Then iRedraw = True
        End If
    Next c
    ' The tabs inherit from the resolved general colours, so their pass runs after the write
    ' back - and before the side effects below, two of which read a per tab colour
    ApplyTabChainColors
    If nSilent Then Exit Sub
    
    If iMoved(ntChainForeColorSelectedTab) Then
        If mChangeControlsForeColor Then
            SetControlsProperForeColor iPrevForeColorSelectedTab
        End If
        If mTDIMode <> ntTDIModeNone Then
            If Not mAmbientUserMode Then lblTDILabel.ForeColor = mForeColorSelectedTab
        End If
    End If
    If iMoved(ntChainIconColor) Or iMoved(ntChainIconColorSelectedTab) Or iMoved(ntChainIconColorTabHighlighted) Then
        TDIInvalidateFormIcons
    End If
    If iMoved(ntChainNewTabButtonColor) Or iMoved(ntChainNewTabButtonColorHighlighted) Then
        NewTabButtonApplyColors
    End If
    If iRedraw Then DrawDelayed
End Sub

' The per tab slot a chain node reads, as a Variant so that Empty - "nobody set this one" -
' travels with the value. StripButtonsColor* and NewTabButtonColor* have no per tab slot and answer Empty: the
' '+' is a tab of mTabData and its two colours are seeded into the IconColor slots of that tab,
' so a per tab NewTabButtonColor would be a second authority over the same pixels
Private Function TabChainSlot(ByVal nTab As Long, ByVal nChainIndex As Long) As Variant
    Select Case nChainIndex
        Case ntChainForeColor: TabChainSlot = mTabData(nTab).CustomColors.ForeColor
        Case ntChainForeColorSelectedTab: TabChainSlot = mTabData(nTab).CustomColors.ForeColorSelectedTab
        Case ntChainForeColorHighlighted: TabChainSlot = mTabData(nTab).CustomColors.ForeColorHighlighted
        Case ntChainIconColor: TabChainSlot = mTabData(nTab).CustomColors.IconColor
        Case ntChainFlatTabBorderColorHighlighted: TabChainSlot = mTabData(nTab).CustomColors.FlatTabBorderColorHighlighted
        Case ntChainFlatTabBorderColorSelectedTab: TabChainSlot = mTabData(nTab).CustomColors.FlatTabBorderColorSelectedTab
        Case ntChainFlatTabBorderColorInactive: TabChainSlot = mTabData(nTab).CustomColors.FlatTabBorderColorInactive
        Case ntChainIconColorSelectedTab: TabChainSlot = mTabData(nTab).CustomColors.IconColorSelectedTab
        Case ntChainIconColorTabHighlighted: TabChainSlot = mTabData(nTab).CustomColors.IconColorTabHighlighted
        Case ntChainCloseButtonColor: TabChainSlot = mTabData(nTab).CustomColors.CloseButtonColor
        Case ntChainIconColorMouseHover: TabChainSlot = mTabData(nTab).CustomColors.IconColorMouseHover
        Case ntChainIconColorMouseHoverSelectedTab: TabChainSlot = mTabData(nTab).CustomColors.IconColorMouseHoverSelectedTab
        Case ntChainCloseButtonColorSelectedTab: TabChainSlot = mTabData(nTab).CustomColors.CloseButtonColorSelectedTab
        Case ntChainCloseButtonColorTabHighlighted: TabChainSlot = mTabData(nTab).CustomColors.CloseButtonColorTabHighlighted
    End Select
End Function

' The chain node a per tab colour ID names, or -1 for the nine that are outside the tree: the
' seven of the background family, governed by the _ColorAutomatic network inside SetColors, and
' the two mouse hover reds of the 'x', which fall on a constant and not on a parent.
' TabChainSlot goes the other way and the two are the only translation between the two numbering
' schemes, which is why neither is inlined anywhere
' The chain node a general colour property names, or -1. ForeColor is left out: the root's
' automatic axis is the Ambient
Private Function ChainIndexFromPropertyName(ByVal nPropertyName As String) As Long
    ChainIndexFromPropertyName = -1
    Select Case nPropertyName
        Case "ForeColorSelectedTab": ChainIndexFromPropertyName = ntChainForeColorSelectedTab
        Case "ForeColorHighlighted": ChainIndexFromPropertyName = ntChainForeColorHighlighted
        Case "IconColor": ChainIndexFromPropertyName = ntChainIconColor
        Case "FlatTabBorderColorHighlighted": ChainIndexFromPropertyName = ntChainFlatTabBorderColorHighlighted
        Case "FlatTabBorderColorSelectedTab": ChainIndexFromPropertyName = ntChainFlatTabBorderColorSelectedTab
        Case "FlatTabBorderColorInactive": ChainIndexFromPropertyName = ntChainFlatTabBorderColorInactive
        Case "IconColorSelectedTab": ChainIndexFromPropertyName = ntChainIconColorSelectedTab
        Case "IconColorTabHighlighted": ChainIndexFromPropertyName = ntChainIconColorTabHighlighted
        Case "CloseButtonColor": ChainIndexFromPropertyName = ntChainCloseButtonColor
        Case "StripButtonsColor": ChainIndexFromPropertyName = ntChainStripButtonsColor
        Case "IconColorMouseHover": ChainIndexFromPropertyName = ntChainIconColorMouseHover
        Case "IconColorMouseHoverSelectedTab": ChainIndexFromPropertyName = ntChainIconColorMouseHoverSelectedTab
        Case "CloseButtonColorSelectedTab": ChainIndexFromPropertyName = ntChainCloseButtonColorSelectedTab
        Case "CloseButtonColorTabHighlighted": ChainIndexFromPropertyName = ntChainCloseButtonColorTabHighlighted
        Case "StripButtonsColorHighlighted": ChainIndexFromPropertyName = ntChainStripButtonsColorHighlighted
        Case "NewTabButtonColor": ChainIndexFromPropertyName = ntChainNewTabButtonColor
        Case "NewTabButtonColorHighlighted": ChainIndexFromPropertyName = ntChainNewTabButtonColorHighlighted
    End Select
End Function

Private Function ChainIndexFromCustomColorID(ByVal nColorID As NTTabCustomColorIDConstants) As Long
    ChainIndexFromCustomColorID = -1
    Select Case nColorID
        Case ntCCFlatTabBorderColorHighlighted: ChainIndexFromCustomColorID = ntChainFlatTabBorderColorHighlighted
        Case ntCCFlatTabBorderColorSelectedTab: ChainIndexFromCustomColorID = ntChainFlatTabBorderColorSelectedTab
        Case ntCCFlatTabBorderColorInactive: ChainIndexFromCustomColorID = ntChainFlatTabBorderColorInactive
        Case ntCCForeColor: ChainIndexFromCustomColorID = ntChainForeColor
        Case ntCCForeColorHighlighted: ChainIndexFromCustomColorID = ntChainForeColorHighlighted
        Case ntCCForeColorSelectedTab: ChainIndexFromCustomColorID = ntChainForeColorSelectedTab
        Case ntCCIconColor: ChainIndexFromCustomColorID = ntChainIconColor
        Case ntCCIconColorSelectedTab: ChainIndexFromCustomColorID = ntChainIconColorSelectedTab
        Case ntCCIconColorMouseHover: ChainIndexFromCustomColorID = ntChainIconColorMouseHover
        Case ntCCIconColorMouseHoverSelectedTab: ChainIndexFromCustomColorID = ntChainIconColorMouseHoverSelectedTab
        Case ntCCIconColorTabHighlighted: ChainIndexFromCustomColorID = ntChainIconColorTabHighlighted
        Case ntCCCloseButtonColor: ChainIndexFromCustomColorID = ntChainCloseButtonColor
        Case ntCCCloseButtonColorSelectedTab: ChainIndexFromCustomColorID = ntChainCloseButtonColorSelectedTab
        Case ntCCCloseButtonColorTabHighlighted: ChainIndexFromCustomColorID = ntChainCloseButtonColorTabHighlighted
    End Select
End Function

' The general property behind a per tab colour ID, for the nine that are outside the chain. It
' reads through the public Property Get and not the module variable on purpose: those are the
' ones whose Get answers something else than what it stores, and this has to hand back what the
' developer would read.
'
' Only those nine are reachable: TabAutomaticCustomColor sends every chain node to the resolver
' before getting here, because for those the general property is no longer the answer
Private Function GeneralColorForCustomColorID(ByVal nColorID As NTTabCustomColorIDConstants) As Long
    Select Case nColorID
        Case ntCCBackColorTab: GeneralColorForCustomColorID = BackColorTabs
        Case ntCCBackColorSelectedTab: GeneralColorForCustomColorID = BackColorSelectedTab
        Case ntCCHighlightColor: GeneralColorForCustomColorID = HighlightColor
        Case ntCCHighlightColorSelectedTab: GeneralColorForCustomColorID = HighlightColorSelectedTab
        Case ntCCHighlightGradientColor: GeneralColorForCustomColorID = HighlightGradientColor
        Case ntCCHighlightGradientColorSelectedTab: GeneralColorForCustomColorID = HighlightGradientColorSelectedTab
        Case ntCCFlatBarColorInactive: GeneralColorForCustomColorID = FlatBarColorInactive
        Case ntCCFlatBarColorHighlighted: GeneralColorForCustomColorID = FlatBarColorHighlighted
        Case ntCCFlatBarColorSelectedTab: GeneralColorForCustomColorID = FlatBarColorSelectedTab
        Case ntCCCloseButtonColorMouseHover: GeneralColorForCustomColorID = CloseButtonColorMouseHover
        Case ntCCCloseButtonColorMouseHoverSelectedTab: GeneralColorForCustomColorID = CloseButtonColorMouseHoverSelectedTab
        Case Else
            Debug.Assert False
    End Select
End Function

' Resolves the inherited foreground colours of one tab into its cache, running the same pass the
' general properties run and not a copy of the rule. The input arrays say: a slot counts as set
' if the tab set it or the control did, and the value is the tab's whenever it has one.
'
' What that buys, and what it costs. A general colour somebody set sits at distance 0 of its own
' node and beats an ancestor of the tab at distance 1, so "all the icons are green" stays a more
' specific statement about the icon than "the caption of this tab is red". And a tab that set no
' colour of its own gets exactly the general colours, bit for bit, because its input array is
' the general one and the pass is deterministic: such a tab cannot move, which is what makes
' this change auditable.
'
' The '+' button is out of the inheritance and inside the cache. Its slots are seeded by
' NewTabButtonApplyColors and the rest have to keep falling straight through to the control, so
' that the two it deliberately leaves Empty - IconColorSelectedTab and its hover variant, which
' a button that can never be the active tab must never need - stay a diagnostic instead of
' quietly inheriting a colour and switching themselves off
Private Sub ApplyTabChainColorsForTab(ByVal nTab As Long)
    Dim iIsSet(cChainColorLast) As Boolean
    Dim iColor(cChainColorLast) As Long
    Dim iSlot As Variant
    Dim c As Long
    
    For c = 0 To cChainColorLast
        iSlot = TabChainSlot(nTab, c)
        If IsEmpty(iSlot) Then
            ' ChainColorValue is already resolved by ApplyChainColors, so a general node nobody
            ' set still hands back a real colour here and never a marker
            iIsSet(c) = ChainColorIsSet(c)
            iColor(c) = ChainColorValue(c)
        Else
            iIsSet(c) = True
            iColor(c) = CLng(iSlot)
        End If
    Next c
    If Not mTabData(nTab).IsNewTabButton Then
        SeedTabChainRoots iIsSet, iColor, FlatBarColorHighlightedFor(nTab), mTabData(nTab).CustomColors.FlatBarColorSelectedTab, mTabData(nTab).CustomColors.FlatBarColorInactive
        ResolveChainColors iIsSet, iColor
    End If
    For c = 0 To cChainColorLast
        mTabData(nTab).CustomColors.ResolvedChainColor(c) = iColor(c)
    Next c
End Sub

' Index -1 is walked on purpose. mTabData is dimensioned from -1 and that spare slot is read
' while there is no tab under the mouse and no active tab, so leaving its cache at zero would
' paint black exactly where the code used to fall through to the general colour
Private Sub ApplyTabChainColors()
    Dim t As Long
    
    For t = -1 To UBound(mTabData)
        ApplyTabChainColorsForTab t
    Next t
End Sub

' The three of the Ambient axis. What they answer is not "nobody set this" but "this one is
' hooked to the container", which is a different question with the same consequence: a caller
' that reads the Get and assigns it somewhere else turns the hook into a value and unhooks the
' destination. CopyControlProperties, ModifyColors and GetThemeStringFromControl are the three
' callers that need to tell the two apart
Friend Property Get BackColor_IsFromAmbient() As Boolean
    BackColor_IsFromAmbient = mBackColorIsFromAmbient
End Property

Friend Property Get ForeColor_IsFromAmbient() As Boolean
    ForeColor_IsFromAmbient = mForeColorIsFromAmbient
End Property

Friend Property Get BackColorTabs_IsFromAmbient() As Boolean
    BackColorTabs_IsFromAmbient = mBackColorTabsIsFromAmbient
End Property

' The property pages and the theme module ask through these. Friend is enough: they all live in
' this project
Friend Property Get ForeColorSelectedTab_IsAutomatic() As Boolean
    ForeColorSelectedTab_IsAutomatic = mForeColorSelectedTab_IsAutomatic
End Property

Friend Property Get ForeColorHighlighted_IsAutomatic() As Boolean
    ForeColorHighlighted_IsAutomatic = mForeColorHighlighted_IsAutomatic
End Property

Friend Property Get IconColor_IsAutomatic() As Boolean
    IconColor_IsAutomatic = mIconColor_IsAutomatic
End Property

Friend Property Get FlatTabBorderColorHighlighted_IsAutomatic() As Boolean
    FlatTabBorderColorHighlighted_IsAutomatic = mFlatTabBorderColorHighlighted_IsAutomatic
End Property

Friend Property Get FlatTabBorderColorSelectedTab_IsAutomatic() As Boolean
    FlatTabBorderColorSelectedTab_IsAutomatic = mFlatTabBorderColorSelectedTab_IsAutomatic
End Property

Friend Property Get FlatTabBorderColorInactive_IsAutomatic() As Boolean
    FlatTabBorderColorInactive_IsAutomatic = mFlatTabBorderColorInactive_IsAutomatic
End Property

Friend Property Get IconColorSelectedTab_IsAutomatic() As Boolean
    IconColorSelectedTab_IsAutomatic = mIconColorSelectedTab_IsAutomatic
End Property

Friend Property Get IconColorTabHighlighted_IsAutomatic() As Boolean
    IconColorTabHighlighted_IsAutomatic = mIconColorTabHighlighted_IsAutomatic
End Property

Friend Property Get CloseButtonColor_IsAutomatic() As Boolean
    CloseButtonColor_IsAutomatic = mCloseButtonColor_IsAutomatic
End Property

Friend Property Get StripButtonsColor_IsAutomatic() As Boolean
    StripButtonsColor_IsAutomatic = mStripButtonsColor_IsAutomatic
End Property

Friend Property Get IconColorMouseHover_IsAutomatic() As Boolean
    IconColorMouseHover_IsAutomatic = mIconColorMouseHover_IsAutomatic
End Property

Friend Property Get IconColorMouseHoverSelectedTab_IsAutomatic() As Boolean
    IconColorMouseHoverSelectedTab_IsAutomatic = mIconColorMouseHoverSelectedTab_IsAutomatic
End Property

Friend Property Get CloseButtonColorSelectedTab_IsAutomatic() As Boolean
    CloseButtonColorSelectedTab_IsAutomatic = mCloseButtonColorSelectedTab_IsAutomatic
End Property

Friend Property Get CloseButtonColorTabHighlighted_IsAutomatic() As Boolean
    CloseButtonColorTabHighlighted_IsAutomatic = mCloseButtonColorTabHighlighted_IsAutomatic
End Property

Friend Property Get StripButtonsColorHighlighted_IsAutomatic() As Boolean
    StripButtonsColorHighlighted_IsAutomatic = mStripButtonsColorHighlighted_IsAutomatic
End Property

Friend Property Get NewTabButtonColor_IsAutomatic() As Boolean
    NewTabButtonColor_IsAutomatic = mNewTabButtonColor_IsAutomatic
End Property

Friend Property Get NewTabButtonColorHighlighted_IsAutomatic() As Boolean
    NewTabButtonColorHighlighted_IsAutomatic = mNewTabButtonColorHighlighted_IsAutomatic
End Property

' Returns/sets the text color.
Public Property Get ForeColor() As OLE_COLOR
Attribute ForeColor.VB_Description = "Returns/sets the color used to draw the captions of inactive tabs. This setting is inherited by other foreground color properties if they are not set specifically."
Attribute ForeColor.VB_ProcData.VB_Invoke_Property = ";Colors"
Attribute ForeColor.VB_UserMemId = -513
Attribute ForeColor.VB_MemberFlags = "c"
    ForeColor = mForeColor
End Property

Public Property Let ForeColor(ByVal nValue As OLE_COLOR)
    Dim iFromAmbient As Boolean
    
    ' See Let BackColor for both halves of this: why an assignment clears the hook
    ' instead of comparing, and why -1 is the way back onto it
    iFromAmbient = mForeColorIsFromAmbient
    If nValue = -1 Then
        iFromAmbient = True
        nValue = Ambient.ForeColor
    ElseIf Not mSettingColorFromAmbient Then
        iFromAmbient = False
    End If
    If (nValue <> mForeColor) Or (iFromAmbient <> mForeColorIsFromAmbient) Then
        If Not IsValidOLE_COLOR(nValue) Then RaiseError 380, TypeName(Me): Exit Property
        mForeColorIsFromAmbient = iFromAmbient
        SetPropertyChanged "ForeColor"
        ' The root of the inherited foreground colours.
        ApplyChainColors ntChainForeColor, nValue
    End If
End Property


Public Property Get ForeColorSelectedTab() As OLE_COLOR
Attribute ForeColorSelectedTab.VB_Description = "Returns/sets the color used to draw the selected tab caption. "
Attribute ForeColorSelectedTab.VB_ProcData.VB_Invoke_Property = ";Colors"
    ForeColorSelectedTab = mForeColorSelectedTab
End Property

Public Property Let ForeColorSelectedTab(ByVal nValue As OLE_COLOR)
    Dim iAutomatic As Boolean
    
    ' -1 means "the control decides", and what it decides is in ApplyChainColors: the nearest
    ' ancestor somebody set.
    iAutomatic = (nValue = -1)
    If Not iAutomatic Then
        If Not IsValidOLE_COLOR(nValue) Then RaiseError 380, TypeName(Me): Exit Property
    End If
    If (iAutomatic <> mForeColorSelectedTab_IsAutomatic) Or ((Not iAutomatic) And (nValue <> mForeColorSelectedTab)) Then
        mForeColorSelectedTab_IsAutomatic = iAutomatic
        SetPropertyChanged "ForeColorSelectedTab"
        ApplyChainColors ntChainForeColorSelectedTab, nValue
    End If
End Property

Private Sub SetControlsProperForeColor(Optional nPrevColor As Long = -1)
    Dim iForeColorSelectedTab As Long
    Dim iBackColor As Long
    Dim iDeliberate As Boolean
    
    ' mTab is -1 while every tab is hidden. Reading mTabData(-1) would not fail - the array is
    ' dimensioned from -1 and that spare slot reads Empty - so the guard is not here to protect the
    ' read.
    If Not TabIndexIsUsable(mTab) Then Exit Sub
    iForeColorSelectedTab = mTabData(mTab).CustomColors.ResolvedChainColor(ntChainForeColorSelectedTab)
    ' The body the children sit on, which a tab with a color of its own changes
    If IsEmpty(mTabData(mTab).CustomColors.BackColorSelectedTab) Then
        iBackColor = mBackColorSelectedTab
    Else
        iBackColor = mTabData(mTab).CustomColors.BackColorSelectedTab
    End If
    ' A color chosen on purpose for this body is not second-guessed: the tab's own one, or the
    ' general one over the general body. Only a color that got here by inheritance is checked
    iDeliberate = Not IsEmpty(mTabData(mTab).CustomColors.ForeColorSelectedTab)
    If Not iDeliberate Then
        If (Not mForeColorSelectedTab_IsAutomatic) And IsEmpty(mTabData(mTab).CustomColors.BackColorSelectedTab) Then
            iDeliberate = (iForeColorSelectedTab = mForeColorSelectedTab)
        End If
    End If
    If iDeliberate Then
        SetControlsForeColor iForeColorSelectedTab, nPrevColor
        Exit Sub
    End If
    
    If ColorsHaveEnoughContrast(iBackColor, iForeColorSelectedTab) Then
        SetControlsForeColor iForeColorSelectedTab, nPrevColor
    ElseIf ColorsHaveEnoughContrast(iBackColor, mForeColor) Then
        SetControlsForeColor mForeColor, nPrevColor
    ElseIf ColorsHaveEnoughContrast(iBackColor, Ambient.ForeColor) Then
        SetControlsForeColor Ambient.ForeColor, nPrevColor
    ElseIf ColorsHaveEnoughContrast(iBackColor, iForeColorSelectedTab, 80) Then
        SetControlsForeColor iForeColorSelectedTab, nPrevColor
    ElseIf ColorsHaveEnoughContrast(iBackColor, mForeColor, 80) Then
        SetControlsForeColor mForeColor, nPrevColor
    ElseIf ColorsHaveEnoughContrast(iBackColor, Ambient.ForeColor, 80) Then
        SetControlsForeColor Ambient.ForeColor, nPrevColor
    ElseIf ColorsHaveEnoughContrast(iBackColor, vbBlack) Then
        SetControlsForeColor vbBlack, nPrevColor
    Else
        ' never left undelivered: the children would keep the color of another tab
        SetControlsForeColor vbWhite, nPrevColor
    End If
End Sub

' True when an index can be used to reach into mTabData. Not IsValidTabIndex: that one
' answers a different question - whether the index names a tab the public per tab
' properties will accept - and it rejects the new tab button, which is a real element of
' the array and safe to read. What this one exists for is mTab = -1, the value it takes
' while every tab is hidden, which the color resolvers can be reached with
Private Function TabIndexIsUsable(ByVal nIndex As Long) As Boolean
    TabIndexIsUsable = (nIndex >= 0) And (nIndex <= UBound(mTabData))
End Function

' The one answer to "what color is the body of the active tab painted with right now",
' which is by definition the color the contained controls have to match. It is the twin
' of SetControlsProperForeColor: the decision lives here, the delivery in
' SetControlsBackColor, and the ten callers keep their own reasons to deliver.
'
' Deliberately does NOT consult mChangeControlsBackColor. That property answers a
' different question - whether to deliver at all - and it stays at the call sites, because
' with it off the right thing is to touch nothing, not to deliver vbButtonFace. The one
' exception is Let ChangeControlsBackColor itself, which needs this color as the previous
' one precisely because the property is already off by the time it delivers.
'
' Returns a property value mixed with a derived RGB: mBackColorSelectedTabDisabled comes
' out of ColorFromHLS while the other two can still be system color constants. That is
' what SetControlsBackColor already expects, and the high contrast substitution there
' needs to see the untranslated value
Private Function BackColorSelectedTabEffective() As Long
    ' SetColors derives it from the custom color of the active tab when there is one, so the
    ' disabled state follows a per tab color without a slot of its own.
    If (Not mEnabled) And mShowDisabledState And mAmbientUserMode Then
        BackColorSelectedTabEffective = mBackColorSelectedTabDisabled
    ElseIf Not TabIndexIsUsable(mTab) Then
        BackColorSelectedTabEffective = mBackColorSelectedTab
    ElseIf IsEmpty(mTabData(mTab).CustomColors.BackColorSelectedTab) Then
        BackColorSelectedTabEffective = mBackColorSelectedTab
    Else
        BackColorSelectedTabEffective = mTabData(mTab).CustomColors.BackColorSelectedTab
    End If
End Function

Private Sub SetControlsProperBackColor(Optional nPrevColor As Long = -1)
    SetControlsBackColor BackColorSelectedTabEffective, nPrevColor
End Sub

Public Property Get ForeColorHighlighted() As OLE_COLOR
Attribute ForeColorHighlighted.VB_Description = "Returns/sets the color used to draw the captions of tabs when they are highlighted."
Attribute ForeColorHighlighted.VB_ProcData.VB_Invoke_Property = ";Colors"
    ForeColorHighlighted = mForeColorHighlighted
End Property

Public Property Let ForeColorHighlighted(ByVal nValue As OLE_COLOR)
    Dim iAutomatic As Boolean
    
    ' No redraw here or in ApplyChainColors for this one. It only reaches the screen while the
    ' pointer is over a tab, and the hover that shows it repaints on its own
    
    iAutomatic = (nValue = -1)
    If Not iAutomatic Then
        If Not IsValidOLE_COLOR(nValue) Then RaiseError 380, TypeName(Me): Exit Property
    End If
    If (iAutomatic <> mForeColorHighlighted_IsAutomatic) Or ((Not iAutomatic) And (nValue <> mForeColorHighlighted)) Then
        mForeColorHighlighted_IsAutomatic = iAutomatic
        SetPropertyChanged "ForeColorHighlighted"
        ApplyChainColors ntChainForeColorHighlighted, nValue
    End If
End Property


Public Property Get FlatTabBorderColorHighlighted() As OLE_COLOR
Attribute FlatTabBorderColorHighlighted.VB_Description = "Returns/sets the color that is used to highlight the tabs with a border when the mouse hovers on them, and the HighlightMode property has the corresponding flag ntHLFlatDrawBorder. Automatic (-1) takes FlatBarColorHighlighted."
