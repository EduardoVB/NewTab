Public Property Get TabsPerRow() As Long
Attribute TabsPerRow.VB_Description = "Returns/sets the number of tabs to appear on each row. It applies when TabWidthStyle is ntTWEqualWidth, ntTWTabCaptionWidth or ntTWGeneralFixedWidth; with the other settings the control decides how many tabs go on a row."
Attribute TabsPerRow.VB_ProcData.VB_Invoke_Property = "pagNewTabStrip;Strip"
    TabsPerRow = mTabsPerRow
End Property

Public Property Let TabsPerRow(ByVal nValue As Long)
    If (nValue < 1) Then
        RaiseError 380, TypeName(Me) ' invalid property value
        Exit Property
