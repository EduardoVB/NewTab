    If (nValue <> mFlatBorderColor) Or (iAutomatic <> mFlatBorderColor_IsAutomatic) Then
        If Not IsValidOLE_COLOR(nValue) Then RaiseError 380, TypeName(Me): Exit Property
        mFlatBorderColor = nValue
        mFlatBorderColor_IsAutomatic = iAutomatic
        SetPropertyChanged "FlatBorderColor"
        SetColors
        DrawDelayed
    End If
End Property


