Public Property Get CanReorderTabs() As Boolean
Attribute CanReorderTabs.VB_Description = "Returns/sets a value that determines whether the user will be able to change tab positions by dragging them."
Attribute CanReorderTabs.VB_ProcData.VB_Invoke_Property = ";Behavior"
    CanReorderTabs = mCanReorderTabs
End Property

Public Property Let CanReorderTabs(ByVal nValue As Boolean)
    If nValue <> mCanReorderTabs Then
        mCanReorderTabs = nValue
        If mDragState = cDragStateActive Then MoveTabInternal mTab, mDragStartIndex
        DragEnd
        SetPropertyChanged "CanReorderTabs"
    End If
End Property


Public Property Get TDIMode() As NTTDIModeConstants
Attribute TDIMode.VB_Description = "Returns/sets a value that determines if the control will be used for TDI (tabbed document interface) and which mode (controls or forms). The control behavior changes significantly in this mode because some things are automated. At run time it can only be set before the control is shown."
Attribute TDIMode.VB_ProcData.VB_Invoke_Property = ";Behavior"
    TDIMode = mTDIMode
End Property

Public Property Let TDIMode(ByVal nValue As NTTDIModeConstants)
    Dim iRefusal As String
    
    If nValue <> mTDIMode Then
        iRefusal = TDIModeChangeRefusal
        If iRefusal <> "" Then
            If mAmbientUserMode Then
                RaiseError 1391, TypeName(Me), iRefusal
            Else
                MsgBox iRefusal, vbExclamation
            End If
            Exit Property
        End If
        If mTDIMode = ntTDIModeForms Then
            If mAmbientUserMode Then UninstallCBTHook
        End If
        mTDIMode = nValue
        TDIConfigureTDIModeOnce
        If mAmbientUserMode And (mTDIMode = ntTDIModeForms) Then
            If mTabData(0).Caption = "Tab 0" Then TabCaption(0) = "Home"
        End If
        ' at run time the mode starts in UserControl_Show, as it does for a control loaded from its form,
        ' so that the template controls can be put in tab 0 after setting the mode
        If (mTDIMode <> ntTDIModeNone) And (Not mAmbientUserMode) Then TDISetTDIMode
        NewTabButtonApply ' leaving TDI does not go through TDISetTDIMode, and with ntYNAuto the button has to go with the mode
        If Not Ambient.UserMode Then lblTDILabel.Visible = (mTDIMode <> ntTDIModeNone)
        If mTDIMode = ntTDIModeControls Then
            lblTDILabel.Caption = "Tabbed Document Interface mode 'Controls'. Use Tab 0 as a template. Add all controls here, all them must be control arrays with Index = 0."
        ElseIf mTDIMode = ntTDIModeForms Then
            lblTDILabel.Caption = "Tabbed Document Interface mode 'Forms'. It is like MDI (Multimple Document Interface) but with tabs. This form must be the main/startup form, and this tab will be as a menu. Put here the controls that go in the main form."
        End If
        SetPropertyChanged "TDIMode"
        mSetAutoTabHeightPending = True
        mControlJustAdded = True
    End If
End Property

' So that a property page offers the change only when Let TDIMode takes it
Friend Function TDIModeCanChange() As Boolean
    TDIModeCanChange = (TDIModeChangeRefusal = "")
End Function

' Why TDIMode cannot change now, or "" if it can. At run time only until the mode has started,
' which is when the control is shown (for a TDI Forms control loaded from its form, on loading)
Private Function TDIModeChangeRefusal() As String
    If mAmbientUserMode Then
        If mTDIModeAlreadySet Or mUserControlShown Then
            TDIModeChangeRefusal = "At run time TDIMode can only be changed before the control is shown."
            Exit Function
        End If
    End If
    If Not mControlJustAdded Then
        TDIModeChangeRefusal = "This property needs to be set immediately after adding the " & TypeName(Me) & " control (without changing other properties first)"
    ElseIf (mTDIMode = ntTDIModeNone) And (mTabs <> cPropDef_Tabs) And (mTabs <> 2) Then
        TDIModeChangeRefusal = "This property needs to be set immediately after adding the " & TypeName(Me) & " control (without changing other properties first)"
    ElseIf ContainedControls.Count > 0 Then
        TDIModeChangeRefusal = "This property needs to be set when there is still no contained control inside the " & TypeName(Me) & " control."
    End If
End Function


Public Property Get Theme() As String
Attribute Theme.VB_Description = "Returns/sets a value in string format that determines a set of property settings with a name, called ""theme""."
Attribute Theme.VB_ProcData.VB_Invoke_Property = "pagNewTabThemes;Appearance"
Attribute Theme.VB_MemberFlags = "200"
    If mCurrentTheme Is Nothing Then SetCurrentTheme
    Theme = mCurrentThemeName
End Property

Private Sub SetCurrentTheme()
    Dim iTheme As NewTabTheme
    
    Set mCurrentTheme = New NewTabTheme
    mCurrentTheme.ThemeString = GetThemeStringFromControl(Me)
    If mThemesCollection Is Nothing Then Set mThemesCollection = New NewTabThemes
    For Each iTheme In mThemesCollection
        If iTheme.Hash = mCurrentTheme.Hash Then
            mCurrentTheme.Name = iTheme.Name
            Exit For
        End If
    Next
    mCurrentThemeName = mCurrentTheme.Name
    If mCurrentThemeName = "" Then mCurrentThemeName = "Custom"
End Sub

Public Property Let Theme(ByVal nValue As String)
    nValue = LCase$(Trim$(nValue))
    If nValue = "custom" Then Exit Property
    If mCurrentTheme Is Nothing Then SetCurrentTheme
    If nValue = mCurrentThemeName Then Exit Property
    If mThemesCollection Is Nothing Then Set mThemesCollection = New NewTabThemes
    If Not mThemesCollection.Exists(nValue) Then
        RaiseError 380, TypeName(Me)
        Exit Property
    End If
    mCurrentThemeName = nValue
    ApplyThemeToControl mThemesCollection(mCurrentThemeName).Data, Me, Ambient.BackColor, Ambient.ForeColor
End Property


Public Property Get Themes() As NewTabThemes
Attribute Themes.VB_Description = "Returns a collection of NewTabTheme objects. They basically provide the names of the themes that are available (and you can set in the Theme property)."
Attribute Themes.VB_ProcData.VB_Invoke_Property = ";Appearance"
    If mThemesCollection Is Nothing Then Set mThemesCollection = New NewTabThemes
    Set Themes = mThemesCollection
End Property

Friend Property Set Themes(ByVal nThemes As NewTabThemes)
    Dim iTheme As NewTabTheme
    
    If Not nThemes Is Nothing Then
        For Each iTheme In mThemesCollection
            If iTheme.Custom Then
                mThemesCollection.Remove iTheme.Name
            End If
        Next
        For Each iTheme In nThemes
            If iTheme.Custom Then
                mThemesCollection.Add iTheme
            End If
        Next
    End If
    SetPropertyChanged "Themes"
End Property


Public Property Get TabData(ByVal nTab As Variant) As Long
Attribute TabData.VB_Description = "Used to store any data in Long format, similar to ListBox's ItemData. If the tabs are reordered, it will keep this data for this tab."
Attribute TabData.VB_ProcData.VB_Invoke_Property = ";Tabs"
    Dim iIndex As Long
    
    iIndex = GetTabIndex(nTab)
    If Not IsValidTabIndex(iIndex) Then
        RaiseError 381, TypeName(Me) ' invalid property array index
        Exit Property
    End If
    TabData = mTabData(iIndex).Data
End Property

Public Property Let TabData(ByVal nTab As Variant, ByVal nValue As Long)
    Dim iIndex As Long
    
    iIndex = GetTabIndex(nTab)
    If Not IsValidTabIndex(iIndex) Then
        RaiseError 381, TypeName(Me) ' invalid property array index
        Exit Property
    End If
    If nValue <> mTabData(iIndex).Data Then
        mTabData(iIndex).Data = nValue
        SetPropertyChanged "TabData"
    End If
End Property


Public Property Get TabTag(ByVal nTab As Variant) As String
Attribute TabTag.VB_Description = "Returns/sets a custom String data for each tab."
Attribute TabTag.VB_ProcData.VB_Invoke_Property = ";Tabs"
    Dim iIndex As Long
    
    iIndex = GetTabIndex(nTab)
    If Not IsValidTabIndex(iIndex) Then
        RaiseError 381, TypeName(Me) ' invalid property array index
        Exit Property
    End If
    TabTag = mTabData(iIndex).Tag
End Property

Public Property Let TabTag(ByVal nTab As Variant, ByVal nValue As String)
    Dim iIndex As Long
    
    iIndex = GetTabIndex(nTab)
    If Not IsValidTabIndex(iIndex) Then
        RaiseError 381, TypeName(Me) ' invalid property array index
        Exit Property
    End If
    If nValue <> mTabData(iIndex).Tag Then
        mTabData(iIndex).Tag = nValue
        SetPropertyChanged "TabTag"
    End If
End Property


Public Property Get TabKey(ByVal nTab As Variant) As String
Attribute TabKey.VB_Description = "A key that can be used to set the current/active/selected tab with the 'Tab' property.  Keys are case insensitive."
Attribute TabKey.VB_ProcData.VB_Invoke_Property = ";Tabs"
    Dim iIndex As Long
    
    iIndex = GetTabIndex(nTab)
    If Not IsValidTabIndex(iIndex) Then
        RaiseError 381, TypeName(Me) ' invalid property array index
        Exit Property
    End If
    TabKey = mTabData(iIndex).Key
End Property

Public Property Let TabKey(ByVal nTab As Variant, ByVal nValue As String)
    Dim iIndex As Long
    
    iIndex = GetTabIndex(nTab)
    If Not IsValidTabIndex(iIndex) Then
        RaiseError 381, TypeName(Me) ' invalid property array index
        Exit Property
    End If
    ' the two checks are kept apart on purpose: IsValidTabKey and TabKeyExists answer
    ' different questions and neither raises, so each caller raises the error that fits what
    ' it just checked. AddTab runs the same two before growing the array
    If nValue <> "" Then
        If Not IsValidTabKey(nValue) Then
            RaiseError 380, TypeName(Me), "The TabKey must not start with a number.", vbExclamation
            Exit Property
        End If
    End If
    If nValue <> mTabData(iIndex).Key Then
        If nValue <> "" Then
            If TabKeyExists(nValue, iIndex) Then
                RaiseError 457, TypeName(Me)
                Exit Property
            End If
        End If
        mTabData(iIndex).Key = nValue
        SetPropertyChanged "TabKey"
    End If
End Property


Public Property Get SubclassingMethod() As NTSubclassingMethodConstants
Attribute SubclassingMethod.VB_Description = "Returns/sets the subclassing method, what to subclass (only the UserControl or the Form too) and if the subclassing will be enabled at all. If subclassing is disabled or partially disabled some features may not work."
Attribute SubclassingMethod.VB_ProcData.VB_Invoke_Property = ";Advanced"
    SubclassingMethod = mSubclassingMethod
End Property

Public Property Let SubclassingMethod(ByVal nValue As NTSubclassingMethodConstants)
    Dim iPrev As NTSubclassingMethodConstants
    
    If (nValue < ntSMSetWindowSubclass) Or (nValue > ntSM_SWLOnlyUserControl) Then
        RaiseError 380, TypeName(Me) ' invalid property value
        Exit Property
    End If
    If nValue <> SubclassingMethod Then
        iPrev = mSubclassingMethod
        mSubclassingMethod = nValue
        SetPropertyChanged "SubclassingMethod"
        If iPrev <> ntSMDisabled Then
            Unsubclass
        End If
        gSubclassWithSetWindowLong = (mSubclassingMethod = ntSMSetWindowLong) Or (mSubclassingMethod = ntSM_SWLOnlyUserControl)
        mOnlySubclassUserControl = (mSubclassingMethod = ntSM_SWSOnlyUserControl) Or (mSubclassingMethod = ntSM_SWLOnlyUserControl)
        If mSubclassingMethod <> ntSMDisabled Then
            mSubclassed = True
            #If NOSUBCLASSINIDE Then
                If mInIDE Then
                    mSubclassed = False
                End If
            #End If
            Set mSubclassedControlsForPaintingHwnds = New Collection
            Set mSubclassedFramesHwnds = New Collection
            Set mSubclassedControlsForMoveHwnds = New Collection
            If mSubclassed Then
                SubclassUserControl
                SubclassForm
            End If
        End If
    End If
End Property


Private Sub ShowPicCover()
    Dim iRect As RECT
    Const LWA_ALPHA = &H2&
    Const WS_EX_LAYERED = &H80000
    Const GWL_EXSTYLE = (-20)
    Const WS_EX_TOOLWINDOW = &H80
    Const WS_EX_TRANSPARENT As Long = &H20
    Dim iWindowStyle As Long
    Dim iDC As LongPtr
    Static sShowing As Boolean
    Dim iClipRect As RECT
    Dim iPt1 As POINTAPI
    Dim iPt2 As POINTAPI
    Dim iClipHwnd As LongPtr
    Dim iSrcLeft As Long
    Dim iSrcTop As Long
    
    If sShowing Or mSettingTDIMode Then Exit Sub
    ' The cover is a top-level window: with the form in the background it would flash over
    ' whatever the user has in front
    If GetForegroundWindow() <> GetAncestor(mUserControlHwnd, GA_ROOT) Then Exit Sub
    If picCover.Visible And (Not mTabTransitionFramePainted) Then
        ' Another change in the same synchronous burst (code walking the tabs): nothing has been
        ' repainted on screen since the cover was taken, so it already shows the right picture
        mTabTransitionStartMark = AnimTimeMark
        Exit Sub
    End If
    sShowing = True
    If picCover.Visible Then
        tmrTabTransition.Enabled = False
        HidePicCover
    End If
    
    GetWindowRect mUserControlHwnd, iRect
    iRect.Right = iRect.Left + mBodyRect.Right
    iRect.Bottom = iRect.Top + mBodyRect.Bottom
    iRect.Left = iRect.Left + mBodyRect.Left
    iRect.Top = iRect.Top + mBodyRect.Top
    iSrcLeft = iRect.Left
    iSrcTop = iRect.Top
    
    ' The cover is a top-level window, so nothing clips it but this: every ancestor up to the
    ' form. Both corners are mapped because a mirrored window maps its origin to the right edge
    iClipHwnd = UserControl.ContainerHwnd
    Do While iClipHwnd <> 0
        GetClientRect iClipHwnd, iClipRect
        iPt1.X = 0: iPt1.Y = 0
        iPt2.X = iClipRect.Right: iPt2.Y = iClipRect.Bottom
        ClientToScreen iClipHwnd, iPt1
        ClientToScreen iClipHwnd, iPt2
        If iPt1.X > iPt2.X Then
            iClipRect.Left = iPt2.X
            iClipRect.Right = iPt1.X
        Else
            iClipRect.Left = iPt1.X
            iClipRect.Right = iPt2.X
        End If
        If iRect.Left < iClipRect.Left Then iRect.Left = iClipRect.Left
        If iRect.Right > iClipRect.Right Then iRect.Right = iClipRect.Right
        If iRect.Top < iPt1.Y Then iRect.Top = iPt1.Y
        If iRect.Bottom > iPt2.Y Then iRect.Bottom = iPt2.Y
        If GetAncestor(iClipHwnd, GA_ROOT) = iClipHwnd Then Exit Do
        iClipHwnd = GetParent(iClipHwnd)
    Loop
    If (iRect.Right <= iRect.Left) Or (iRect.Bottom <= iRect.Top) Then
        sShowing = False
        Exit Sub
    End If
    iSrcLeft = mBodyRect.Left + iRect.Left - iSrcLeft
    iSrcTop = mBodyRect.Top + iRect.Top - iSrcTop
    
    picCover.Visible = False
    SetParent picCover.hWnd, 0
    MoveWindow picCover.hWnd, -100, -100, 1, 1, 0
    
    iWindowStyle = GetWindowLong(picCover.hWnd, GWL_EXSTYLE)
    iWindowStyle = iWindowStyle Or WS_EX_TOOLWINDOW Or WS_EX_LAYERED Or WS_EX_TRANSPARENT
    SetWindowLong picCover.hWnd, GWL_EXSTYLE, iWindowStyle
    SetLayeredWindowAttributes picCover.hWnd, 0, 0, LWA_ALPHA
    picCover.Visible = True ' for some reason this is necessary to avoid a flicker the first time
    SetLayeredWindowAttributes picCover.hWnd, 0, cTabTransitionStartAlpha, LWA_ALPHA
    picCover.Visible = False
    
    picCover.Visible = True
    
    mTabTransitionFramePainted = False
    tmrTabTransition.Enabled = True
    MoveWindow picCover.hWnd, iRect.Left, iRect.Top, iRect.Right - iRect.Left, iRect.Bottom - iRect.Top, 0
    iDC = GetDC(mUserControlHwnd)
    BitBlt picCover.hDC, 0, 0, iRect.Right - iRect.Left, iRect.Bottom - iRect.Top, iDC, iSrcLeft, iSrcTop, vbSrcCopy
    ReleaseDC mUserControlHwnd, iDC
    picCover.Refresh
    
    WaitForCoverOnScreen
    ' The hold above is not part of the fade: no message is pumped before this line, so no tick
    ' can have read the mark yet
    mTabTransitionStartMark = AnimTimeMark

    sShowing = False
End Sub

' Holds until the compositor has presented the cover, so the new body is never seen without it.
' Without composition (XP, or Vista and 7 with it turned off) there is nothing to wait on, and a
' fixed hold is kept
Private Sub WaitForCoverOnScreen()
    Dim iResult As Long
    Static sNoDwmApi As Boolean
    
    If Not sNoDwmApi Then
        On Error Resume Next
        iResult = DwmFlush()
        If Err.Number <> 0 Then
            sNoDwmApi = True
            iResult = -1
        End If
        Err.Clear
        On Error GoTo 0
        If iResult = 0 Then Exit Sub
    End If
    Sleep 30
End Sub

Private Sub HidePicCover()
    Const WS_EX_LAYERED = &H80000
    Const GWL_EXSTYLE = (-20)
    Const WS_EX_TOOLWINDOW = &H80
    Dim iWindowStyle As Long
    
    picCover.Visible = False
    picCover.Cls
    SetParent picCover.hWnd, mUserControlHwnd
    iWindowStyle = GetWindowLong(picCover.hWnd, GWL_EXSTYLE)
    iWindowStyle = iWindowStyle And Not WS_EX_TOOLWINDOW And Not WS_EX_LAYERED
    SetWindowLong picCover.hWnd, GWL_EXSTYLE, iWindowStyle
End Sub

Friend Property Get AmbientFont() As StdFont
    On Error Resume Next
    Set AmbientFont = Ambient.Font
    Err.Clear
End Property

Friend Property Get AmbientBackColor() As Long
    On Error Resume Next
    AmbientBackColor = Ambient.BackColor
    Err.Clear
End Property

Friend Property Get AmbientForeColor() As Long
    On Error Resume Next
    AmbientForeColor = Ambient.ForeColor
    Err.Clear
End Property

Private Function GetAutomaticBackColorSelectedTab() As Long
    Dim iBackColorTabs_H As Integer
    Dim iBackColorTabs_L As Integer
    Dim iBackColorTabs_S As Integer
    Dim iBCol As Long
    
    If mStyle = ntStyleFlat Then

        ' No high contrast branch here on purpose.
        iBCol = TranslatedColor(mBackColorTabs)
        ColorRGBToHLS iBCol, iBackColorTabs_H, iBackColorTabs_L, iBackColorTabs_S
        ' The active tab is the tabs background moved along the lightness axis and nothing else:
        ' same hue, same colourfulness. The saturation factor is 1 because there is nothing left for
        ' it to do.
        GetAutomaticBackColorSelectedTab = ColorWithLightnessAndFade(iBCol, AutomaticSelectedTabLightness(iBackColorTabs_L), 1)
    Else
        GetAutomaticBackColorSelectedTab = mBackColorTabs
    End If
End Function

' Where the active tab sits on the lightness axis, given the lightness of the tabs
' background. The result is deliberately not clamped to 0-240 here: ColorWithLightnessAndFade
' is the single place that range is enforced, and DisabledColorVariant hands it a raw sum the
' same way. Clamping in both would only hide which one is responsible.
' Written as a function of its own, and not inline, because the branches of
' GetAutomaticBackColorSelectedTab used to carry a copy of this each and drifted into two
' different factors and one boundary where the answer went backwards. The interpolated step
' keeps the result monotonic: the multiplier on the background lightness stays positive, so a
' lighter background can never produce a darker active tab
Private Function AutomaticSelectedTabLightness(ByVal nBackColorTabsLightness As Integer) As Long
    Dim iRoom As Long
    Dim iDelta As Long
    
    iRoom = 240 - CLng(nBackColorTabsLightness)
    If iRoom >= cAutomaticSelectedTabMinRoom Then
        iDelta = cAutomaticSelectedTabLightenDeltaLight + (cAutomaticSelectedTabLightenDeltaDark - cAutomaticSelectedTabLightenDeltaLight) * iRoom / 240
        AutomaticSelectedTabLightness = CLng(nBackColorTabsLightness) + iDelta
    Else
        AutomaticSelectedTabLightness = CLng(nBackColorTabsLightness) - cAutomaticSelectedTabDarkenDelta
    End If
End Function

Private Function CloneFont(nOrigFont As iFont) As StdFont
    If nOrigFont Is Nothing Then Exit Function
    nOrigFont.Clone CloneFont
End Function

Private Function FontsAreEqual(nFont1 As StdFont, nFont2 As StdFont) As Boolean
    If nFont1 Is Nothing Or nFont2 Is Nothing Then Exit Function
    
    If (nFont1 Is Nothing) And (nFont2 Is Nothing) Then
        FontsAreEqual = True
        Exit Function
    End If
    If (nFont1 Is Nothing) Then Exit Function
    If (nFont2 Is Nothing) Then Exit Function
    
    If nFont1.Name = nFont2.Name Then
        If nFont1.Size = nFont2.Size Then
            If nFont1.Bold = nFont2.Bold Then
                If nFont1.Italic = nFont2.Italic Then
                    If nFont1.Strikethrough = nFont2.Strikethrough Then
                        If nFont1.Underline = nFont2.Underline Then
                            If nFont1.Weight = nFont2.Weight Then
                                If nFont1.Charset = nFont2.Charset Then
                                    FontsAreEqual = True
                                    Exit Function
                                End If
                            End If
                        End If
                    End If
                End If
            End If
        End If
    End If
End Function

Private Function ChrU(ByVal nCharCodeU As Long) As String
    Const cPOW10 As Long = 2 ^ 10
    
    If nCharCodeU <= &HFFFF& Then
        ChrU = ChrW$(nCharCodeU)
    Else
        ChrU = ChrW$(&HD800& + (nCharCodeU - &H10000) \ cPOW10) & ChrW$(&HDC00& + (nCharCodeU And (cPOW10 - 1)))
    End If
End Function

' Whether the style is one of the three that used to sink their inactive tabs by two pixels of
' their own. Style and nothing else on purpose: TabAppearance says how a tab is drawn and must
' not reach into the highlight mode. mAppearanceIsPP cannot be used here - it is resolved
' inside Draw and both callers of this run well before any draw.
' Whether the selected tab is drawn SelectedTabWideningPixels wider on each side. It used to be
' mAppearanceIsPP alone, so the widening came with the appearance and could not be separated
' from it; it is a highlight flag now, so a theme can ask for SSTab's geometry painted with
' Windows styles. The appearance stays in the condition because tabbed dialog and flat have
' never been drawn widened: the flag is ignored there until each is measured.
' The defaults of HighlightTabExtraHeight and HighlightTabCaptionShift, in himetric. Every
' reader goes through these, so the default is written in one place. In twips and DPI scaled
' like the properties themselves, decided against pixel counts: those matched the native
' TabStrip at four DPIs but left the defaults out of step with every value a developer sets
Friend Function DefaultHighlightTabExtraHeightHimetric() As Long
    DefaultHighlightTabExtraHeightHimetric = Round(pScaleY(cPropDef_HighlightTabExtraHeight, vbTwips, vbHimetric))
End Function

Friend Function DefaultHighlightTabCaptionShiftHimetric() As Long
    DefaultHighlightTabCaptionShiftHimetric = Round(pScaleY(cPropDef_HighlightTabCaptionShift, vbTwips, vbHimetric))
End Function

Friend Function HighlightTabExtraHeightIsDefault() As Boolean
    HighlightTabExtraHeightIsDefault = (Round(mHighlightTabExtraHeight) = DefaultHighlightTabExtraHeightHimetric)
End Function

Friend Function HighlightTabCaptionShiftIsDefault() As Boolean
    HighlightTabCaptionShiftIsDefault = (Round(mHighlightTabCaptionShift) = DefaultHighlightTabCaptionShiftHimetric)
End Function

' The room each end of a row keeps for the selected tab to widen into: SelectedTabWideningPixels when
' it is widened, none when it is not. RowStartX and RowEndMargin used to carry this inside their
' 2 and their 3 without saying so, which left a tab that does not widen two columns short of the
' body's border at both ends - measured 2026-09-10, 120 DPI, SSTab with Windows styles theme: first
' inactive tab on column 2 and last tab on 295 against the border on 297, active or not
Private Function SelectedTabWideningSpace() As Long
    ' Either widening asks for the same room: with the mouse's one on, a hovered tab at the end of a
    ' row reaches exactly where the selected tab reaches, and a row measured edge to edge would send
    ' it over the body's border.
    If SelectedTabIsWidened Or HighlightedTabIsWidened Then SelectedTabWideningSpace = SelectedTabWideningPixels
End Function

' Through himetric and Round, the same road the default of HighlightTabExtraHeight takes, so that
' with the same twips the widening and the sink come out equal at every DPI: 2 at 96, 3 at 120
Private Function SelectedTabWideningPixels() As Long
    SelectedTabWideningPixels = pScaleX(Round(pScaleX(cPPSelectedTabWideningTwips, vbTwips, vbHimetric)), vbHimetric, vbPixels)
End Function

Private Function SelectedTabIsWidened() As Boolean
    ' The appearance was taken out of this question on 2026-09-15: it is the flag that decides, the
    ' way 24.114 said it should.
    SelectedTabIsWidened = mHighlightWidenSelectedTab
End Function

' The same question for a tab that is NOT the selected one: the mouse's own widening. Kept
' apart from SelectedTabIsWidened rather than folded into one function taking a tab index,
' because the selected tab's widening is applied on the STORED rect in Draw and this
' one on DrawTab's local copy - two mechanisms that only share an amount
Private Function HighlightedTabIsWidened() As Boolean
    ' Same as SelectedTabIsWidened: the flag decides, not the appearance
    HighlightedTabIsWidened = mHighlightWidenTab
End Function

' Whether this tab is painted wider than its stored rect by the mouse's widening. One
' place for the question, asked by DrawTab to do it and by Draw to keep the columns
' from being painted over afterwards: the two have to agree tab by tab or the clip
' protects columns nobody widened, or worse, leaves the widened ones open
' A tab on its way out - mFadeOutTab - is NOT included, and that is a decision: it goes
' back to its own width the moment the mouse leaves and only the colour keeps fading. Two
' widened tabs side by side fight over the same columns, because the widening of one lands
' inside the rect of the other, and the one arriving would come out with its left edge
' missing. Only one tab widens at a time this way
Private Function TabIsDrawnWidened(ByVal nTab As Long) As Boolean
    ' The selected tab widens through its stored rect in Draw, after the body is
    ' painted and after everything this answer is used for
    If nTab = mTab Then Exit Function
    If Not HighlightedTabIsWidened Then Exit Function
    If Not mAmbientUserMode Then Exit Function
    If DragOffsetsShown Then Exit Function
    If Not mEnabled Then Exit Function
    If Not mTabData(nTab).Enabled Then Exit Function
    TabIsDrawnWidened = mTabData(nTab).Hovered
End Function

' The sheet's top line, in two pieces around the tab the sheet belongs to. A sheet is the
' continuation of its own tab, so along the tab there is no line: a line there draws the
' tab shut. The gap is taken from the tab's own rect and widens with it, so a widened tab
' carries its sheet along. It spans both border columns, so the two segments touch the
' tab's own border; since picDraw.Line does not paint its end point (24.138), reaching the
' column before iGapLeft means naming iGapLeft itself. Also used for the twin row at
' nTop + 1, for the same reason (24.149). nGapLeftInset is what that row does not share
' with nTop: there the tab is over and nothing else puts a border on the gap's first
' column, so it has to start one column later. Decided against painting the background
' back from DrawTab afterwards, which destroyed columns belonging to the sheet
Private Sub DrawSheetTopLine(ByVal nLeftEnd As Long, ByVal nRightEnd As Long, ByVal nRow As Long, ByVal nTab As Long, ByVal nColor As Long, Optional ByVal nGapLeftInset As Long = 0, Optional ByVal nEdgeLeftColor As Long = -1, Optional ByVal nEdgeRightColor As Long = -1, Optional ByVal nEdgesAsLeft As Boolean = False)
    Dim iGapLeft As Long
    Dim iGapRight As Long
    Dim iWiden As Long
    
    iWiden = 0
    If TabIsDrawnWidened(nTab) Then iWiden = SelectedTabWideningPixels
    iGapLeft = mTabData(nTab).TabRect.Left - iWiden + nGapLeftInset
    iGapRight = mTabData(nTab).TabRect.Right + iWiden
    If iGapLeft > nLeftEnd Then picDraw.Line (nLeftEnd, nRow)-(iGapLeft, nRow), nColor
    If iGapRight < nRightEnd Then picDraw.Line (iGapRight + 1, nRow)-(nRightEnd, nRow), nColor
    ' The gap is not empty: its two outer columns are the tab's own border and the sheet has to
    ' carry them on this row (24.154).
    If nEdgeLeftColor <> -1 Then
        If (iGapLeft >= nLeftEnd) And (iGapLeft <= nRightEnd) Then picDraw.PSet (iGapLeft, nRow), nEdgeLeftColor
    End If
    If nEdgeRightColor <> -1 Then
        If ((iGapRight - 1) > iGapLeft) And ((iGapRight - 1) <= nRightEnd) Then picDraw.PSet (iGapRight - 1, nRow), nEdgeRightColor
        If iGapRight < nRightEnd Then picDraw.PSet (iGapRight, nRow), m3DDKShadow
    End If
    ' Property page in the four Left orientations, as measured on SSTab: the line runs over the
    ' tab's dark column, and the shadow and the lit edge reach this row.
    If nEdgesAsLeft Then
        If (iGapLeft >= nLeftEnd) And (iGapLeft < nRightEnd) Then picDraw.PSet (iGapLeft, nRow), nColor
        If (iGapLeft + 1) < iGapRight Then picDraw.PSet (iGapLeft + 1, nRow), m3DShadow
        If iGapRight < nRightEnd Then picDraw.PSet (iGapRight, nRow), m3DHighlightH
    End If
End Sub

' Which tab is being painted wider than its rect, or -1. Only one can be at a time, which
' is what TabIsDrawnWidened guarantees by leaving the fading tab out
Private Function WidenedTabIndex() As Long
    Dim iWidenScan As Long
    
    WidenedTabIndex = -1
    For iWidenScan = 0 To mTabs - 1
        If TabIsDrawnWidened(iWidenScan) Then
            WidenedTabIndex = iWidenScan
            Exit Function
        End If
    Next iWidenScan
End Function


Private Function StyleUsesPropertyPageTabs() As Boolean
    StyleUsesPropertyPageTabs = (mStyle = ssStylePropertyPage) Or (mStyle = ntStyleTabStrip) Or (mStyle = ntStyleWindows)
End Function

' What ntTWAuto resolves to. Friend so the Strip page can show it
Friend Function AutoTabWidthStyle() As NTTabWidthStyleConstants
    If NewTabButtonEffective Then
        ' The button is a real tab, so it obeys the width style like any other one and any style
        ' that gives a tab a width other than its caption's stretches the button too.
        AutoTabWidthStyle = ntTWTabCaptionWidthFillRows
    ElseIf mTDIMode <> ntTDIModeNone Then
        AutoTabWidthStyle = ntTWTabCaptionWidthFillRows
    ElseIf mStyle = ntStyleTabStrip Then
        AutoTabWidthStyle = ntTWTabStripEmulation
    ElseIf mStyle = ssStylePropertyPage Then
        AutoTabWidthStyle = ntTWTabCaptionWidth
    ElseIf (mStyle = ntStyleFlat) Or (mStyle = ntStyleWindows) Then
        AutoTabWidthStyle = ntTWStretchToFill
    Else
        AutoTabWidthStyle = ntTWEqualWidth
    End If
End Function

' What ntHLAuto resolves to for the current Style. Friend so the Highlight page can show it
' What TabAppearance asks for once Auto is read off Style. Whether the theme is available is asked later
Private Function ResolvedTabAppearance() As NTTabAppearanceConstants
    If mTabAppearance <> ntTAAuto Then
        ResolvedTabAppearance = mTabAppearance
        Exit Function
    End If
    Select Case mStyle
        Case ntStyleWindows
            ResolvedTabAppearance = ntTAWindows
        Case ntStyleTabStrip
            ResolvedTabAppearance = ntTATabStrip
        Case ssStylePropertyPage
            ResolvedTabAppearance = ntTAPropertyPage
        Case ntStyleFlat
            ResolvedTabAppearance = ntTAFlat
        Case Else
            ResolvedTabAppearance = ntTATabbedDialog
    End Select
End Function

' The highlight flags that do something in the current appearance, for the Highlight page.
' ntHLBackgroundPlain stands for having a background at all and ntHLBackgroundGradient for its two gradient kinds
Friend Function HighlightFlagsWithEffect(ByVal nSelectedTab As Boolean) As Long
    Dim iAppearance As NTTabAppearanceConstants
    Dim iFlags As Long
    
    iFlags = ntHLCaptionBold Or ntHLCaptionUnderlined Or ntHLExtraHeight Or ntHLShiftCaption Or ntHLWidenTab
    iAppearance = ResolvedTabAppearance
    If (iAppearance = ntTAWindows) And VisualStylesEffective And (mBackStyle <> ntTransparent) Then
        ' The theme has a single hot state, and paints the selected tab on its own
        If Not nSelectedTab Then iFlags = iFlags Or ntHLBackgroundPlain
    Else
        iFlags = iFlags Or ntHLBackgroundPlain Or ntHLBackgroundGradient Or ntHLBackgroundLight
        If iAppearance = ntTAFlat Then iFlags = iFlags Or ntHLFlatBar Or ntHLFlatBarGrip Or ntHLFlatDrawBorder Or ntHLRoundBottom
        If (iAppearance = ntTAFlat) And (Not nSelectedTab) Then iFlags = iFlags Or ntHLFlatShapeInactive
    End If
    HighlightFlagsWithEffect = iFlags
End Function

Friend Function AutoHighlightMode(ByVal nSelectedTab As Boolean) As Long
    Dim iMode As Long
    
    If mStyle = ntStyleFlat Then
        iMode = (ntHLBackgroundGradient Or ntHLBackgroundLight Or ntHLFlatBar)
    ElseIf nSelectedTab And (mStyle = ssStyleTabbedDialog) Then
        iMode = ntHLCaptionBold
    ElseIf (Not nSelectedTab) And (mStyle = ntStyleWindows) Then
        ' Any background flag asks the theme for its hot state
        iMode = ntHLBackgroundPlain
    End If
    ' The originals of these three styles raise and widen the selected tab, and TabStrip and Windows
    ' also move its caption the whole two pixels the tab grows, where SSTab property page moves it one
    If nSelectedTab And StyleUsesPropertyPageTabs Then
        iMode = iMode Or ntHLExtraHeight Or ntHLWidenTab
        If (mStyle = ntStyleTabStrip) Or (mStyle = ntStyleWindows) Then iMode = iMode Or ntHLShiftCaption
    End If
    ' ntHLNone is a value of its own and not a flag: mixed into the others it reads as a background type
    If iMode = 0 Then iMode = ntHLNone
    AutoHighlightMode = iMode
End Function

Private Sub SetHighlightMode()
    Dim iHighlightMode As NTHighlightModeFlagsConstants
    Dim iHighlightModeSelectedTab As NTHighlightModeFlagsConstants
    
    iHighlightMode = mHighlightMode
    If iHighlightMode = ntHLAuto Then iHighlightMode = AutoHighlightMode(False)
    If (iHighlightMode And ntHLBackgroundTypeFilter) = ntHLBackgroundDoubleGradient Then
        mHighlightGradient = ntGradientDouble
    ElseIf (iHighlightMode And ntHLBackgroundTypeFilter) = ntHLBackgroundGradient Then
        mHighlightGradient = ntGradientSimple
    ElseIf (iHighlightMode And ntHLBackgroundTypeFilter) = ntHLBackgroundPlain Then
        mHighlightGradient = ntGradientPlain
    Else
        mHighlightGradient = ntGradientNone
    End If
    
    mHighlightCaptionBold = (iHighlightMode <> ntHLNone) And ((iHighlightMode And ntHLCaptionBold) = ntHLCaptionBold)
    mHighlightCaptionUnderlined = (iHighlightMode <> ntHLNone) And ((iHighlightMode And ntHLCaptionUnderlined) = ntHLCaptionUnderlined)
    If (iHighlightMode <> ntHLNone) And ((iHighlightMode And ntHLBackgroundLight) = ntHLBackgroundLight) Then
        mHighlightIntensity = ntHighlightIntensityLight
    Else
        mHighlightIntensity = ntHighlightIntensityStrong
    End If
    mHighlightFlatBar = (iHighlightMode <> ntHLNone) And ((iHighlightMode And ntHLFlatBar) = ntHLFlatBar)
    mHighlightFlatBarWithGrip = mHighlightFlatBar And ((iHighlightMode And ntHLFlatBarGrip) = ntHLFlatBarGrip)
    mHighlightAddExtraHeight = (iHighlightMode <> ntHLNone) And ((iHighlightMode And ntHLExtraHeight) = ntHLExtraHeight)
    mHighlightShiftCaption = (iHighlightMode <> ntHLNone) And ((iHighlightMode And ntHLShiftCaption) = ntHLShiftCaption)
    mHighlightFlatDrawBorder = (iHighlightMode <> ntHLNone) And ((iHighlightMode And ntHLFlatDrawBorder) = ntHLFlatDrawBorder)
    ' Read off the mouse's mode the same way mHighlightWidenSelectedTab is read off the
    ' selected tab's. Until this line the bit was parsed nowhere, so a mode carrying it did
    ' nothing at all - it was not a guard ignoring it, there was no reader
    mHighlightWidenTab = (iHighlightMode <> ntHLNone) And ((iHighlightMode And ntHLWidenTab) = ntHLWidenTab)
    mHighlightRoundBottom = (iHighlightMode <> ntHLNone) And ((iHighlightMode And ntHLRoundBottom) = ntHLRoundBottom)
    mHighlightFlatShapeInactive = (iHighlightMode <> ntHLNone) And ((iHighlightMode And ntHLFlatShapeInactive) = ntHLFlatShapeInactive) And (mHighlightRoundBottom Or mHighlightFlatDrawBorder)
    
    iHighlightModeSelectedTab = mHighlightModeSelectedTab
    If iHighlightModeSelectedTab = ntHLAuto Then iHighlightModeSelectedTab = AutoHighlightMode(True)
    
    If (iHighlightModeSelectedTab And ntHLBackgroundTypeFilter) = ntHLBackgroundDoubleGradient Then
        mHighlightGradientSelectedTab = ntGradientDouble
    ElseIf (iHighlightModeSelectedTab And ntHLBackgroundTypeFilter) = ntHLBackgroundGradient Then
        mHighlightGradientSelectedTab = ntGradientSimple
    ElseIf (iHighlightModeSelectedTab And ntHLBackgroundTypeFilter) = ntHLBackgroundPlain Then
        mHighlightGradientSelectedTab = ntGradientPlain
    Else
        mHighlightGradientSelectedTab = ntGradientNone
    End If
    
    mHighlightCaptionBoldSelectedTab = (iHighlightModeSelectedTab <> ntHLNone) And ((iHighlightModeSelectedTab And ntHLCaptionBold) = ntHLCaptionBold)
    mHighlightCaptionUnderlinedSelectedTab = (iHighlightModeSelectedTab <> ntHLNone) And ((iHighlightModeSelectedTab And ntHLCaptionUnderlined) = ntHLCaptionUnderlined)
    If (iHighlightModeSelectedTab <> ntHLNone) And ((iHighlightModeSelectedTab And ntHLBackgroundLight) = ntHLBackgroundLight) Then
        mHighlightIntensitySelectedTab = ntHighlightIntensityLight
    Else
        mHighlightIntensitySelectedTab = ntHighlightIntensityStrong
    End If
    mHighlightFlatBarSelectedTab = (iHighlightModeSelectedTab <> ntHLNone) And ((iHighlightModeSelectedTab And ntHLFlatBar) = ntHLFlatBar)
    mHighlightFlatBarWithGripSelectedTab = mHighlightFlatBarSelectedTab And ((iHighlightModeSelectedTab And ntHLFlatBarGrip) = ntHLFlatBarGrip)
    mHighlightAddExtraHeightSelectedTab = (iHighlightModeSelectedTab <> ntHLNone) And ((iHighlightModeSelectedTab And ntHLExtraHeight) = ntHLExtraHeight)
    mHighlightShiftCaptionSelectedTab = (iHighlightModeSelectedTab <> ntHLNone) And ((iHighlightModeSelectedTab And ntHLShiftCaption) = ntHLShiftCaption)
    mHighlightWidenSelectedTab = (iHighlightModeSelectedTab <> ntHLNone) And ((iHighlightModeSelectedTab And ntHLWidenTab) = ntHLWidenTab)
    mHighlightRoundBottomSelectedTab = (iHighlightModeSelectedTab <> ntHLNone) And ((iHighlightModeSelectedTab And ntHLRoundBottom) = ntHLRoundBottom)
    mHighlightFlatDrawBorderSelectedTab = (iHighlightModeSelectedTab <> ntHLNone) And ((iHighlightModeSelectedTab And ntHLFlatDrawBorder) = ntHLFlatDrawBorder)
    
    If mHighlightIntensitySelectedTab = ntHighlightIntensityStrong Then
        mGlowColor_Sel = mGlowColor_Sel_Bk
        mGradColor_Sel = mGradColor_Sel_Bk
    Else
        mGlowColor_Sel = mGlowColor_Sel_Light
        mGradColor_Sel = mGradColor_Sel_Light
    End If
    ' A tab under the mouse keeps the colours resolved when the mouse entered it
    If (mHoverAnimTab > -1) And (mHoverAnimTab < mTabs) Then
        ResolveHoverAnimation mHoverAnimTab, cSlotIn
        SetHoverGlow cSlotIn, mHoverPercent(cSlotIn)
    End If
    If (mFadeOutTab > -1) And (mFadeOutTab < mTabs) Then
        ResolveHoverAnimation mFadeOutTab, cSlotOut
        SetHoverGlow cSlotOut, mHoverPercent(cSlotOut)
    End If
End Sub

Public Function GetTabLeft(ByVal nTab As Variant) As Single
Attribute GetTabLeft.VB_Description = "Returns the left position of a tab, in twips. It is already mirrored under RightToLeft. The new tab button is accepted, at index Tabs."
    Dim iIndex As Long
    Dim iWindowRect As RECT
    
    iIndex = GetTabIndex(nTab)
    If Not IsValidTabIndexOrNewTabButton(iIndex) Then
        RaiseError 5, TypeName(Me) ' Invalid procedure call or argument
        Exit Function
    End If
    EnsureDrawn
    ' Mirrored here for the same reason as ClientLeft
    If mRightToLeft Then
        GetClientRect mUserControlHwnd, iWindowRect
        GetTabLeft = FixRoundingError(pScaleX(iWindowRect.Right - mTabData(iIndex).TabRect.Right - 1, vbPixels, vbTwips))
    Else
        GetTabLeft = FixRoundingError(pScaleX(mTabData(iIndex).TabRect.Left, vbPixels, vbTwips))
    End If
End Function

Public Function GetTabTop(ByVal nTab As Variant) As Single
Attribute GetTabTop.VB_Description = "Returns the top position of a tab, in twips. The new tab button is accepted, at index Tabs."
    Dim iIndex As Long
    
    iIndex = GetTabIndex(nTab)
    If Not IsValidTabIndexOrNewTabButton(iIndex) Then
        RaiseError 5, TypeName(Me) ' Invalid procedure call or argument
        Exit Function
    End If
    EnsureDrawn
    GetTabTop = FixRoundingError(pScaleY(TabHitTop(iIndex), vbPixels, vbTwips))
End Function

Public Function GetTabWidth(ByVal nTab As Variant) As Single
Attribute GetTabWidth.VB_Description = "Returns the width of a tab, in twips. The new tab button is accepted, at index Tabs."
    Dim iIndex As Long
    
    iIndex = GetTabIndex(nTab)
    If Not IsValidTabIndexOrNewTabButton(iIndex) Then
        RaiseError 5, TypeName(Me) ' Invalid procedure call or argument
        Exit Function
    End If
    EnsureDrawn
    GetTabWidth = FixRoundingError(pScaleX(mTabData(iIndex).TabRect.Right - mTabData(iIndex).TabRect.Left, vbPixels, vbTwips))
End Function

Public Function GetTabHeight(ByVal nTab As Variant) As Single
Attribute GetTabHeight.VB_Description = "Returns the height of a tab, in twips. The new tab button is accepted, at index Tabs."
    Dim iIndex As Long
    
    iIndex = GetTabIndex(nTab)
    If Not IsValidTabIndexOrNewTabButton(iIndex) Then
        RaiseError 5, TypeName(Me) ' Invalid procedure call or argument
        Exit Function
    End If
    EnsureDrawn
    GetTabHeight = FixRoundingError(pScaleY(mTabData(iIndex).TabRect.Bottom - TabHitTop(iIndex), vbPixels, vbTwips))
End Function

Private Sub SetPropertyChanged(Optional nPropertyName As String)
    ' mReadingProperties is what keeps merely opening a form from marking it as modified.
    If mPropertiesReady And (Not mReadingProperties) Then
        If Not mSettingTDIMode Then
            PropertyChanged nPropertyName
            mControlJustAdded = False
            Set mCurrentTheme = Nothing
        End If
    End If
End Sub

Public Function AddTab(Optional ByVal Caption As Variant, Optional ByVal Key As String, Optional ByVal ToolTipText As String, Optional ByVal CloseButton As NTAutoYesNoConstants = ntYNAuto, Optional ByVal Index As Long = -1) As Long
Attribute AddTab.VB_Description = "Adds a tab and returns the index it ended up at, or -1 if it could not be added. Without Index the tab is appended after the last one. Not available in TDI modes."
    Dim iCaption As String
    Dim iCaptionSupplied As Boolean
    Dim iCaptionFailed As Boolean
    Dim iPrevTabs As Long
    Dim iNewTab As Long
    
    ' Everything that can fail is checked before the count grows. The other way round leaves
    ' the developer with an error and a tab he did not ask for, which he then has to clean up
    If mTDIMode <> ntTDIModeNone Then
        RaiseError 1387, TypeName(Me), "AddTab is not available in TDI modes."
        AddTab = -1
        Exit Function
    End If
    iPrevTabs = TabsWithoutNewTabButton
    ' one more than MoveTab takes: with R tabs there are R positions to move an existing tab
    ' to, but R + 1 gaps to insert a new one into. The TabIsOwnedByControl check MoveTab also
    ' does is not needed here, because this upper bound is exactly the index the button is at
    If (Index < -1) Or (Index > iPrevTabs) Then
        RaiseError 5, TypeName(Me) ' Invalid procedure call or argument
        AddTab = -1
        Exit Function
    End If
    ' Caption is a Variant for one reason only: so that an omitted one can be told apart from an
    ' empty one.
    iCaptionSupplied = Not IsMissing(Caption)
    If iCaptionSupplied Then
        On Error Resume Next
        Err.Clear
        iCaption = CStr(Caption)
        iCaptionFailed = (Err.Number <> 0)
        On Error GoTo 0
        If iCaptionFailed Then
            RaiseError 5, TypeName(Me), "The Caption argument cannot be converted to a String."
            AddTab = -1
            Exit Function
        End If
    End If
    If Key <> "" Then
        ' an empty Key means a tab without a key, so it is not put through the checks at all.
        ' Neither of the two raises anything, which is why the errors are spelled out here as
        ' well as in Property Let TabKey: only the caller knows which check it just ran
        If Not IsValidTabKey(Key) Then
            RaiseError 380, TypeName(Me), "The TabKey must not start with a number.", vbExclamation
            AddTab = -1
            Exit Function
        End If
        If TabKeyExists(Key) Then
            RaiseError 457, TypeName(Me)
            AddTab = -1
            Exit Function
        End If
    End If
    ' checked here as well, even though Property Let TabCloseButton checks it again further
    ' down: left to that one alone, a bad value would raise after the tab already exists
    If (CloseButton <> ntNo) And (CloseButton <> ntYes) And (CloseButton <> ntYNAuto) Then
        RaiseError 380, TypeName(Me) ' invalid property value
        AddTab = -1
        Exit Function
    End If
    
    ' Property Let Tabs and not SetTabCount: it already speaks the count the developer sees, without
    ' the button, and parks the button back at the last index by itself.
    Tabs = iPrevTabs + 1
    If TabsWithoutNewTabButton <> (iPrevTabs + 1) Then
        AddTab = -1
        Exit Function
    End If
    iNewTab = iPrevTabs ' appended, and the button if there is one already moved past it
    If Index > -1 Then
        If Index < iNewTab Then
            ' MoveTabInternal and not the public MoveTab: this is a tab being placed where it was
            ' asked for, not a reorder of tabs that were already there, so BeforeTabReorder must not
            ' be raised.
            MoveTabInternal iNewTab, Index
            iNewTab = Index
        End If
    End If
    
    ' written through the properties rather than into mTabData: Property Let TabCaption is
    ' what clears mAccessKeysSet, and that is what rebuilds the access keys of a caption
    ' carrying an "&"
    If iCaptionSupplied Then
        TabCaption(iNewTab) = iCaption
    Else
        ' numbered with the index it ended up at, not the one it was created at. It can repeat
        ' the caption of another tab, exactly as growing Tabs already can: the default is only
        ' there so that something shows, the captions belong to the developer
        TabCaption(iNewTab) = "Tab " & CStr(iNewTab)
    End If
    If Key <> "" Then TabKey(iNewTab) = Key
    If ToolTipText <> "" Then TabToolTipText(iNewTab) = ToolTipText
    TabCloseButton(iNewTab) = CloseButton
    DrawDelayed
    AddTab = iNewTab
End Function


Public Function RemoveTab(ByVal nTab As Variant) As Boolean
Attribute RemoveTab.VB_Description = "Removes the tab given by its index, TabKey or Caption, and returns True if it was removed. The tab must hold no contained controls. The last remaining tab can only be removed at run time. Not available in TDI modes."
    Dim iIndex As Long
    Dim iFailed As Boolean
    Dim iTarget As Long
    
    ' Everything that can fail is checked before anything moves, the same way AddTab checks before
    ' it grows.
    If mTDIMode <> ntTDIModeNone Then
        RaiseError 1388, TypeName(Me), "RemoveTab is not available in TDI modes."
        Exit Function
    End If
    iIndex = GetTabIndex(nTab, iFailed)
    If iFailed Then Exit Function ' GetTabIndex already raised the error for this value
    If Not IsValidTabIndex(iIndex) Then
        ' this is also what turns down the new tab button, which is not the developer's to
        ' remove: IsValidTabIndex counts up to TabsWithoutNewTabButton
        RaiseError 5, TypeName(Me) ' Invalid procedure call or argument
        Exit Function
    End If
    ' The floor is counted without the button: SetTabCount asks for one entry in mTabData, which
    ' with a button present would be met by the button alone.
    If TabsWithoutNewTabButton <= MinimumTabCount Then
        RaiseError 1389, TypeName(Me), "Can't remove the last tab."
        Exit Function
    End If
    If FirstTabWithControls(iIndex, iIndex) > -1 Then
        RaiseError_CantRemoveTabsWithControls iIndex
        Exit Function
    End If
    
    ' The selection is taken off the tab before the tab goes away, and not afterwards: once the
    ' record is gone the clamp at the end of SetTabCount is what decides, and that one lands on the
    ' last index, which is the button.
    If mTab = iIndex Then
        iTarget = NeighborTabForSelection(iIndex)
        If iTarget > -1 Then
            TabSel = iTarget
            ' a BeforeClick handler can cancel the change, and then the selection is still on the
            ' tab that was about to be removed.
            If mTab = iIndex Then Exit Function
        End If
        ' iTarget = -1 means no tab is visible at all, and TabSel refuses invisible tabs, so
        ' there is nothing to select here. What keeps mTab off the button in that case is the
        ' guard at the end of SetTabCount
    End If
    ' Moved past the button and not to the last real position: with the tab one index beyond it the
    ' button slides down by itself and is last again as soon as the count shrinks, because shrinking
    ' cuts the last slot.
    MoveTabInternal iIndex, mTabs - 1
    SetTabCount mTabs - 1
    DrawDelayed
    RemoveTab = True
End Function


Public Sub MoveTab(ByVal CurrentIndex As Long, ByVal NewIndex As Long)
Attribute MoveTab.VB_Description = "Moves a tab to another position."
    Dim iCanceled As Boolean
    Dim iTempTabData As T_TabData
    Dim c As Long
    Dim iCurTab As Boolean
    Dim iRedraw As Boolean
    Dim iLastIndex As Long
    
    If NewIndex = CurrentIndex Then Exit Sub
    DragSettleCancel
    ' the new tab button owns the last index: it can't be moved away from it and nothing can be
    ' dropped after it.
    iLastIndex = TabsWithoutNewTabButton - 1
    If (CurrentIndex < 0) Or (CurrentIndex > iLastIndex) Or (NewIndex < 0) Or (NewIndex > iLastIndex) Then
        RaiseError 5, TypeName(Me)
        Exit Sub
    ElseIf TabIsOwnedByControl(CurrentIndex) Or TabIsOwnedByControl(NewIndex) Then
        RaiseError 5, TypeName(Me)
        Exit Sub
    End If
    
    RaiseEvent BeforeTabReorder(CurrentIndex, NewIndex, iCanceled)
    If NewIndex = CurrentIndex Then Exit Sub
    If iCanceled Then Exit Sub
    
    mMovingATab = True
    iRedraw = Redraw
    Redraw = False
    iCurTab = (CurrentIndex = mTab)
    
    iTempTabData = mTabData(CurrentIndex)
    If NewIndex > CurrentIndex Then
        For c = CurrentIndex + 1 To NewIndex
            mTabData(c - 1) = mTabData(c)
        Next
        mTabData(NewIndex) = iTempTabData
    Else
        For c = CurrentIndex - 1 To NewIndex Step -1
            mTabData(c + 1) = mTabData(c)
        Next
        mTabData(NewIndex) = iTempTabData
    End If
    ' the access keys are positional, so they have to be rebuilt whenever the records move.
    ' Set here and not at the end next to RecreateTabIconFontsEventHandler so that the first
    ' draw after the reorder is already the one that rebuilds them
    mAccessKeysSet = False
    If iCurTab Then
        mTab = -1
        ' read from mTabData and not through Property Get TabVisible: these indexes walk the
        ' internal array, so they can land on the new tab button, and the public per tab
        ' properties refuse it. Anything internal that can see the button reads the record
        If mTabData(NewIndex).Visible Then
            TabSel = NewIndex
            Draw
        End If
    Else
        ' mTab follows the shuffle, with the same three cases MoveTabInternal uses.
        If NewIndex > CurrentIndex Then
            If (mTab > CurrentIndex) And (mTab <= NewIndex) Then mTab = mTab - 1
        Else
            If (mTab >= NewIndex) And (mTab < CurrentIndex) Then mTab = mTab + 1
        End If
        For c = 0 To mTabs - 1
            If mTabData(c).Selected Then
                If mTabData(c).Visible Then
                    TabSel = c
                End If
                Exit For
            End If
        Next
        Draw
    End If
    RecreateTabIconFontsEventHandler
    Redraw = iRedraw
    RaiseEvent TabReordered(NewIndex, CurrentIndex)
    mMovingATab = False
End Sub

Private Sub RecreateTabIconFontsEventHandler()
    Dim t As Long
    
    mTabIconFontsEventsHandler.Release
    Set mTabIconFontsEventsHandler = New cFontEventHandlers
    
    For t = 0 To mTabs - 1
        If Not mTabData(t).IconFont Is Nothing Then
            mTabIconFontsEventsHandler.AddFont mTabData(t).IconFont, t
        End If
    Next
End Sub

Public Property Get VisibleTabs() As Long
Attribute VisibleTabs.VB_Description = "Returns the numbers of tabs that are visible. [TabVisible(Index) = True]."
Attribute VisibleTabs.VB_ProcData.VB_Invoke_Property = ";Data"
    EnsureDrawn
    ' without the new tab button, for the same reason the Tabs property leaves it out
    VisibleTabs = VisibleTabsWithoutNewTabButton
End Property


Private Property Get DraggingATab() As Boolean
    DraggingATab = (mDragState = cDragStateActive)
End Property

' True also while the tabs settle after a drop: the drawing keeps applying the offsets
Private Property Get DragOffsetsShown() As Boolean
    DragOffsetsShown = (mDragState = cDragStateActive) Or mDragSettling
End Property

Private Sub DragSnapshotTabRects()
    ' Once the as-Top image has been flipped or rotated into the real orientation, Draw rewrites
    ' every TabRect into final screen coordinates, so by the time Draw has returned the rectangles
    ' are no longer in the as-Top frame: for Bottom they are flipped, and for the Left, Right and
    ' Horizontal families they are transposed.
    Dim t As Long
    Dim iAxis As Long
    Dim iLng As Long
    
    If mTabs < 1 Then Exit Sub
    If mDragTabRectsCount <> mTabs Then
        ReDim mDragTabRectAsTop(0 To mTabs - 1)
        mDragTabRectsCount = mTabs
    End If
    For t = 0 To mTabs - 1
        mDragTabRectAsTop(t) = mTabData(t).TabRect
    Next
    ' In the two reversed orientations the drag works on the strip as their unreversed sibling lays
    ' it out, so that every calculation of it can keep reading the index as growing to the right.
    ' DragMapToAsTop brings the mouse in that way and the two offsets handed out go back.
    If mTabsOrderReversed Then
        For t = 0 To mTabs - 1
            If mTabData(t).Visible And (mTabData(t).RowPos > -1) Then
                If mTabData(t).RowPos <= UBound(mRowMirrorAxis) Then
                    iAxis = mRowMirrorAxis(mTabData(t).RowPos)
                    iLng = mDragTabRectAsTop(t).Left
                    mDragTabRectAsTop(t).Left = iAxis - mDragTabRectAsTop(t).Right
                    mDragTabRectAsTop(t).Right = iAxis - iLng
                End If
            End If
        Next
    End If
End Sub

Private Sub DragBegin()
    If mDragTabRectsCount <> mTabs Then Exit Sub ' nothing drawn yet, nothing to drag
    DragSettleCancel
    
    mDragState = cDragStateActive
    mDragStartIndex = mTab
    mDragLastMoveX = -999999
    mDragLastMoveY = -999999
    mDragLogicalDX = 0
    mDragLogicalDY = 0
    mDragRawDX = 0
    mDragRawDY = 0
    mDragDrawOffsetX = 0
    mDragDrawOffsetY = 0
    DragClearGapOffsets
    DragAnimReset
    DragStripCacheRelease
    mDragStripCacheAllowed = False
    mDragOriginLeft = mDragTabRectAsTop(mTab).Left
    mDragOriginTop = mDragTabRectAsTop(mTab).Top
    
    DragSetZone
    DragSetSegment
    DragClearHoverStates
End Sub

Private Sub DragSetZone()
    ' The stretch of the array the dragged tab may be moved inside.
    Dim t As Long
    
    mDragZoneFirst = 0
    mDragZoneLast = mTabs - 1
    For t = mTab - 1 To 0 Step -1
        If Not TabIsMovableEffective(t) Then
            mDragZoneFirst = t + 1
            Exit For
        End If
    Next
    For t = mTab + 1 To mTabs - 1
        If Not TabIsMovableEffective(t) Then
            mDragZoneLast = t - 1
            Exit For
        End If
    Next
End Sub

Private Sub DragSetSegment()
    ' How far the dragged tab may travel.
    Dim t As Long
    Dim iRowCenter As Long
    Dim iViewLeft As Long
    Dim iViewRight As Long
    Dim iTabWidth As Long
    
    mDragSegmentLeft = mDragTabRectAsTop(mTab).Left
    mDragSegmentRight = mDragTabRectAsTop(mTab).Right
    mDragSegmentTop = mDragTabRectAsTop(mTab).Top
    mDragSegmentBottom = mDragTabRectAsTop(mTab).Bottom
    
    If mRows = 1 Then
        ' A single row: the tab stays inside the stretch of movable tabs around it
        t = PreviousVisibleTabInRow(mTab)
        Do While t > -1
            If Not TabIsMovableEffective(t) Then Exit Do
            mDragSegmentLeft = mDragTabRectAsTop(t).Left
            t = PreviousVisibleTabInRow(t)
        Loop
        t = NextVisibleTabInRow(mTab)
        Do While t > -1
            If Not TabIsMovableEffective(t) Then Exit Do
            mDragSegmentRight = mDragTabRectAsTop(t).Right
            t = NextVisibleTabInRow(t)
        Loop
    Else
        ' More than one row. Along the strip the tab has to be able to cross all of it to reach
        ' another row.
        mDragSegmentTop = mDragTabRectAsTop(mTab).Top + (mDragTabRectAsTop(mTab).Bottom - mDragTabRectAsTop(mTab).Top) \ 2
        mDragSegmentBottom = mDragSegmentTop
        For t = 0 To mTabs - 1
            If mTabData(t).Visible Then
                If mDragTabRectAsTop(t).Left < mDragSegmentLeft Then mDragSegmentLeft = mDragTabRectAsTop(t).Left
                If mDragTabRectAsTop(t).Right > mDragSegmentRight Then mDragSegmentRight = mDragTabRectAsTop(t).Right
                iRowCenter = mDragTabRectAsTop(t).Top + (mDragTabRectAsTop(t).Bottom - mDragTabRectAsTop(t).Top) \ 2
                If iRowCenter < mDragSegmentTop Then mDragSegmentTop = iRowCenter
                If iRowCenter > mDragSegmentBottom Then mDragSegmentBottom = iRowCenter
            End If
        Next
        ' The tabs only reach as far as the longest row, but a drop after the last tab of any row
        ' lands up to where rows end, and the tab has to be able to get there
        If mDragSegmentRight < (mBodyWidth - RowEndMargin()) Then mDragSegmentRight = mBodyWidth - RowEndMargin()
        ' Rows aligned at the end have their free room before the first tab, and a drop there lands in it
        If mDragSegmentLeft > RowStartX() Then mDragSegmentLeft = RowStartX()
    End If
    ' A scrolled strip only lets the tab travel inside the window; the rest is reached by scrolling
    If mStripScrolls Then
        DragViewBounds iViewLeft, iViewRight
        iTabWidth = mDragTabRectAsTop(mTab).Right - mDragTabRectAsTop(mTab).Left
        If mDragSegmentLeft < iViewLeft Then mDragSegmentLeft = iViewLeft
        If mDragSegmentRight > iViewRight Then mDragSegmentRight = iViewRight
        If (mDragSegmentRight - mDragSegmentLeft) < iTabWidth Then
            If mDragSegmentLeft = iViewLeft Then
                mDragSegmentRight = mDragSegmentLeft + iTabWidth
            Else
                mDragSegmentLeft = mDragSegmentRight - iTabWidth
            End If
        End If
    End If
End Sub

Private Sub DragClearHoverStates()
    ' Hover is not tracked while a tab is being dragged.
    Dim t As Long
    
    If mMouseIsOverCloseButton_Tab > -1 Then RaiseEvent CloseButtonMouseLeave(mMouseIsOverCloseButton_Tab)
    If mMouseIsOverIcon_Tab > -1 Then RaiseEvent IconMouseLeave(mMouseIsOverIcon_Tab)
    mMouseIsOverIcon = False
    mMouseIsOverIcon_Tab = -1
    mMouseIsOverCloseButton = False
    mMouseIsOverCloseButton_Tab = -1
    For t = 0 To mTabs - 1
        mTabData(t).CloseButtonHovered = False
    Next
End Sub

Private Sub DragEnd()
    mDragState = cDragStateNone
    mDragLogicalDX = 0
    mDragLogicalDY = 0
    mDragRawDX = 0
    mDragRawDY = 0
    mDragDrawOffsetX = 0
    mDragDrawOffsetY = 0
    DragClearGapOffsets
    DragStripCacheRelease
    mDragStripCacheAllowed = False
    ' The hover base was taken before the drag and is not refreshed while it lasts, so a drop that
    ' reorders the strip leaves it holding the old order.
    HoverCacheRelease
    mHoverCacheAllowed = False
    tmrTabDragging.Enabled = False
    tmrDragAnim.Enabled = False
    mDragGapShownCount = 0
    mDragSettling = False
    mDragAutoScrollDir = 0
End Sub

#If ROTATIONDIAG = 1 Then ' TEMP diagnostic
' Accumulates the time of one step of the rotation stage into its own slot. Slot 0 only
' restarts the clock; any other slot adds the time gone by since the previous mark, so two
' consecutive marks measure the statement between them. The slots are printed by the Draw
' wrapper, one line per outermost Draw
Private Sub RotDiagMark(ByVal nSlot As Long)
    Dim iNow As Currency
    
    QueryPerformanceCounter iNow
    If nSlot > 0 Then
        mRotDiagSlot(nSlot) = mRotDiagSlot(nSlot) + (iNow - mRotDiagLastMark)
    End If
    mRotDiagLastMark = iNow
End Sub

Private Function RotDiagMs(ByVal nSlot As Long, ByVal nFreq As Currency) As String
    RotDiagMs = Format$(CDbl(mRotDiagSlot(nSlot)) / CDbl(nFreq) * 1000#, "0.00")
End Function
#End If

Private Sub DragMapToAsTop(ByVal nX As Single, ByVal nY As Single, ByRef nAsTopX As Single, ByRef nAsTopY As Single)
    ' Everything is laid out as if the orientation were Top, so anything measured in mouse
    ' coordinates has to be brought into that same frame.
    If (mTabOrientation = ssTabOrientationBottom) Or (mTabOrientation = ntTabOrientationBottomRight) Then
        nAsTopX = nX
        nAsTopY = -nY
    ElseIf (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Or (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationLeftBottomHorizontal) Then
        nAsTopX = -nY
        nAsTopY = nX
    ElseIf (mTabOrientation = ssTabOrientationRight) Or (mTabOrientation = ntTabOrientationRightBottom) Or (mTabOrientation = ntTabOrientationRightHorizontal) Or (mTabOrientation = ntTabOrientationRightBottomHorizontal) Then
        nAsTopX = nY
        nAsTopY = -nX
    Else
        nAsTopX = nX
        nAsTopY = nY
    End If
    If mTabsOrderReversed Then nAsTopX = -nAsTopX
End Sub

Private Sub DragUpdateFromMouse(ByVal nXPixels As Single, ByVal nYPixels As Single)
    Dim iDeltaX As Single
    Dim iDeltaY As Single
    Dim iLimit As Long
    Dim iHalf As Single
    
    mDragPointerX = nXPixels
    mDragPointerY = nYPixels
    mDragAutoScrollDir = DragAutoScrollDirection(nXPixels, nYPixels)
    If mDragAutoScrollDir = 0 Then
        tmrTabDragging.Enabled = False
    ElseIf Not tmrTabDragging.Enabled Then
        tmrTabDragging.Interval = 200
        tmrTabDragging.Enabled = True
    End If
    iDeltaX = nXPixels - mDragAnchorX
    iDeltaY = nYPixels - mDragAnchorY
    DragMapToAsTop iDeltaX, iDeltaY, mDragLogicalDX, mDragLogicalDY
    
    ' The delta is kept as it comes as well, before the clamps below trim it, because the
    ' pointer goes where the dragged tab may not: it leaves the strip, and it crosses the
    ' whole row even when the tab is wide enough that the clamps leave it hardly any travel
    mDragRawDX = mDragLogicalDX
    mDragRawDY = mDragLogicalDY
    
    ' With a single row the tab never leaves it
    If mRows = 1 Then mDragLogicalDY = 0
    
    iLimit = mDragSegmentRight - (mDragTabRectAsTop(mTab).Right - mDragTabRectAsTop(mTab).Left)
    If (mDragOriginLeft + mDragLogicalDX) < mDragSegmentLeft Then mDragLogicalDX = mDragSegmentLeft - mDragOriginLeft
    If (mDragOriginLeft + mDragLogicalDX) > iLimit Then mDragLogicalDX = iLimit - mDragOriginLeft
    
    If mRows > 1 Then
        ' Across the rows it is the tab's centre that gets clamped, not its edges.
        iHalf = (mDragTabRectAsTop(mTab).Bottom - mDragTabRectAsTop(mTab).Top) / 2
        If (mDragOriginTop + mDragLogicalDY + iHalf) < mDragSegmentTop Then mDragLogicalDY = mDragSegmentTop - iHalf - mDragOriginTop
        If (mDragOriginTop + mDragLogicalDY + iHalf) > mDragSegmentBottom Then mDragLogicalDY = mDragSegmentBottom - iHalf - mDragOriginTop
    End If
    
    ' The gap is worked out here and not in Draw because the tabs that are not being dragged are
    ' painted before Draw reaches the point where the snapshot is refreshed.
    DragUpdateGapOffsets
End Sub

Private Sub DragUpdateDrawOffset()
    ' The dragged tab is drawn where the pointer put it, which is its position when the drag started
    ' plus everything the pointer has travelled since.
    If mDragState <> cDragStateActive Then Exit Sub
    If (mTab < 0) Or (mTab > (mTabs - 1)) Then Exit Sub
    If mDragTabRectsCount <> mTabs Then Exit Sub
    
    mDragDrawOffsetX = (mDragOriginLeft + mDragLogicalDX) - mDragTabRectAsTop(mTab).Left
    mDragDrawOffsetY = (mDragOriginTop + mDragLogicalDY) - mDragTabRectAsTop(mTab).Top
    If mTabsOrderReversed Then mDragDrawOffsetX = -mDragDrawOffsetX
    
    ' The same offset expressed in final screen coordinates, for whatever is drawn after
    ' Draw has rotated the image and converted the rectangles
    DragMapToFinal mDragDrawOffsetX, mDragDrawOffsetY, mDragDrawOffsetXFinal, mDragDrawOffsetYFinal
End Sub

Private Sub DragMapToFinal(ByVal nAsTopX As Long, ByVal nAsTopY As Long, ByRef nFinalX As Long, ByRef nFinalY As Long)
    ' Takes a vector of the as-Top frame into final screen coordinates. This is the
    ' inverse of the mapping DragMapToAsTop applies to the mouse delta
    If (mTabOrientation = ssTabOrientationBottom) Or (mTabOrientation = ntTabOrientationBottomRight) Then
        nFinalX = nAsTopX
        nFinalY = -nAsTopY
    ElseIf (mTabOrientation = ssTabOrientationLeft) Or (mTabOrientation = ntTabOrientationLeftTop) Or (mTabOrientation = ntTabOrientationLeftHorizontal) Or (mTabOrientation = ntTabOrientationLeftBottomHorizontal) Then
        nFinalX = nAsTopY
        nFinalY = -nAsTopX
    ElseIf (mTabOrientation = ssTabOrientationRight) Or (mTabOrientation = ntTabOrientationRightBottom) Or (mTabOrientation = ntTabOrientationRightHorizontal) Or (mTabOrientation = ntTabOrientationRightBottomHorizontal) Then
        nFinalX = -nAsTopY
        nFinalY = nAsTopX
    Else
        nFinalX = nAsTopX
        nFinalY = nAsTopY
    End If
End Sub

Private Sub DragOffsetTabRect(ByRef nRect As RECT, ByVal nTab As Long)
    ' Shifts a rectangle to where the drag has that tab drawn: the tab being dragged goes where the
    ' pointer took it, any other one goes where the gap it has to open leaves it.
    Dim iOffsetX As Long
    Dim iOffsetY As Long
    Dim iGap As Long
    
    If nTab = mTab Then
        If mOrientationIsBottom Or mTabsAreRotatedButCaptionsAreHorizontal Then
            iOffsetX = mDragDrawOffsetXFinal
            iOffsetY = mDragDrawOffsetYFinal
        Else
            iOffsetX = mDragDrawOffsetX
            iOffsetY = mDragDrawOffsetY
        End If
    Else
        iGap = DragGapOffset(nTab)
        If iGap = 0 Then Exit Sub
        If mOrientationIsBottom Or mTabsAreRotatedButCaptionsAreHorizontal Then
            DragMapToFinal iGap, 0, iOffsetX, iOffsetY
        Else
            iOffsetX = iGap
        End If
    End If
    nRect.Left = nRect.Left + iOffsetX
    nRect.Right = nRect.Right + iOffsetX
    nRect.Top = nRect.Top + iOffsetY
    nRect.Bottom = nRect.Bottom + iOffsetY
End Sub

Private Function HoverStateIsSimple(ByRef nTab As Long) As Boolean
    ' Answers whether the whole difference between this frame and a strip at rest is one inactive
    ' tab, and which one.
    Dim t As Long
    Dim iCount As Long

    nTab = -1
    ' Not simple while a tab is being widened, whatever the flags say: answering True here
    ' is what turns the replay on, and the replay cannot be trusted with the order once a
    ' tab paints outside its own rect. See the note in HoverCacheUsable
    If WidenedTabIndex() > -1 Then Exit Function
    If Not mAmbientUserMode Then
        HoverStateIsSimple = True
        Exit Function
    End If
    For t = 0 To mTabs - 1
        If mTabData(t).Visible And (t <> mTab) Then
            If mTabData(t).Hovered Or mTabData(t).CloseButtonHovered Then
                iCount = iCount + 1
                If iCount > 1 Then Exit Function
                nTab = t
            End If
        End If
    Next t
    ' A tab walking out is painted highlighted and is not in the loop above, because Hovered is
    ' already False by then.
    If (mFadeOutTab > -1) And (mFadeOutTab <> mTab) Then
        If mTabData(mFadeOutTab).Visible Then
            iCount = iCount + 1
            If iCount > 1 Then Exit Function
            nTab = mFadeOutTab
        End If
    End If
    ' The icon of a tab is drawn in its hover colour from state of its own, which the flags
    ' above do not carry. As long as it names the same tab it is covered, because that tab is
    ' painted again on top of the base; naming another one would bake a highlight into the base
    If (mMouseIsOverIcon_Tab > -1) And (mMouseIsOverIcon_Tab <> nTab) Then Exit Function
    If tmrHighlightIcon.Enabled Then
        If Val(tmrHighlightIcon.Tag) <> nTab Then Exit Function
    End If
    HoverStateIsSimple = True
End Function

Private Function HoverCacheUsable(ByVal nWidth As Long, ByVal nHeight As Long) As Boolean
    ' Whether the base kept on an earlier frame may be pasted instead of painting the strip again.
    If WidenedTabIndex() > -1 Then Exit Function
    If Not mHoverCacheValid Then Exit Function
    If mHoverCacheDC = 0 Then Exit Function
    If DragOffsetsShown Then Exit Function
    If (mHoverCacheWidth <> nWidth) Or (mHoverCacheHeight <> nHeight) Then Exit Function
    If mHoverCacheTabs <> mTabs Then Exit Function
    If mHoverCacheTab <> mTab Then Exit Function
    If mHoverCacheLayoutKey <> mStripLayoutKey Then Exit Function
    ' With the extra height in the highlight mode the hovered tab is measured taller, so the layout
    ' itself depends on which tab is hovered and a base taken with another one under the mouse would
    ' hold the wrong rectangles.
    If mHighlightAddExtraHeight Then Exit Function
    HoverCacheUsable = True
End Function

Private Sub HoverCacheStore(ByVal nWidth As Long, ByVal nHeight As Long)
    HoverCacheRelease
    If (nWidth < 1) Or (nHeight < 1) Then Exit Sub
    If mTabs < 1 Then Exit Sub
    If mHighlightAddExtraHeight Then Exit Sub
    
    ' Same symmetric pattern as DragSaveTabPixels and DragStripCacheStore, and it carries no
    ' SetLayout for the same reason: under RightToLeft the mirroring picDraw's layout applies
    ' on the way out is applied again, the opposite way, on the way back in
    mHoverCacheDC = CreateCompatibleDC(picDraw.hDC)
    If mHoverCacheDC = 0 Then Exit Sub
    mHoverCacheBmp = CreateCompatibleBitmap(picDraw.hDC, nWidth, nHeight)
    If mHoverCacheBmp = 0 Then
        DeleteDC mHoverCacheDC
        mHoverCacheDC = 0
        Exit Sub
    End If
    mHoverCacheOldBmp = SelectObject(mHoverCacheDC, mHoverCacheBmp)
    BitBlt mHoverCacheDC, 0, 0, nWidth, nHeight, picDraw.hDC, 0, 0, vbSrcCopy
    
    mHoverCacheWidth = nWidth
    mHoverCacheHeight = nHeight
    mHoverCacheTabs = mTabs
    mHoverCacheTab = mTab
    mHoverCacheLayoutKey = mStripLayoutKey
    mHoverCacheValid = True
End Sub

' Where the strip lies along its axis, read before the themed band shift so the base is stored
' and checked against the same frame. A scroll step moves it without any of the other keys of the
' hover base changing, and a hover in between would otherwise hand the next Draw the old strip.
' The packing of the Horizontal family on its own: a column closes when the next tab no longer fits
' in nCapacity. Each tab takes its measured Width, or with nUniformExtent that extent, unless it
' carries its own width. Returns the number of columns; with nAssign it also writes Row, PosH and
' the two ends.
Private Function HCPackColumns(ByVal nCapacity As Long, ByVal nAssign As Boolean, ByVal nUniformExtent As Long) As Long
    Dim t As Long
    Dim iColumn As Long
    Dim iPosH As Long
    Dim iAccum As Long
    Dim iPrev As Long
    Dim iExtent As Long
    
    iPrev = -1
    For t = 0 To mTabs - 1
        If mTabData(t).Visible Then
            If nUniformExtent = 0 Then
                iExtent = mTabData(t).Width
            ElseIf mTabData(t).FixedWidth <> 0 Then
                iExtent = pScaleX(mTabData(t).FixedWidth, vbHimetric, vbPixels)
            Else
                iExtent = nUniformExtent
            End If
            If iPosH > 0 Then
                If iAccum + mTabSeparation2 + iExtent > nCapacity Then
                    If nAssign Then mTabData(iPrev).RightTab = True
                    iColumn = iColumn + 1
                    iPosH = 0
                End If
            End If
            If iPosH = 0 Then
                iAccum = iExtent
            Else
                iAccum = iAccum + mTabSeparation2 + iExtent
            End If
            iPosH = iPosH + 1
            If nAssign Then
                mTabData(t).Row = iColumn
                mTabData(t).PosH = iPosH
                mTabData(t).LeftTab = (iPosH = 1)
                mTabData(t).RightTab = False
            End If
            iPrev = t
        ElseIf nAssign Then
            mTabData(t).Row = -1
        End If
    Next t
    If iPrev > -1 Then
        If nAssign Then mTabData(iPrev).RightTab = True
        HCPackColumns = iColumn + 1
    End If
End Function

' Every visible tab's place goes into the key, not only the first one's: a tab hidden or shown can
' leave the first visible tab exactly where the previous first one was
Private Function StripLayoutKey() As Long
    Dim t As Long
    Dim iKey As Long
    
    For t = 0 To mTabs - 1
        If mTabData(t).Visible Then
            With mTabData(t).TabRect
                iKey = (iKey Mod 1000003) * 131 + ((t + 1) * 7 + .Left * 3 + .Right * 5 + .Top) Mod 65521
            End With
        End If
    Next t
    StripLayoutKey = iKey
End Function

Private Sub HoverCacheRestore(ByVal nWidth As Long, ByVal nHeight As Long)
    BitBlt picDraw.hDC, 0, 0, nWidth, nHeight, mHoverCacheDC, 0, 0, vbSrcCopy
End Sub

Private Sub HoverCacheRelease()
    If mHoverCacheDC <> 0 Then
        SelectObject mHoverCacheDC, mHoverCacheOldBmp
        DeleteDC mHoverCacheDC
        mHoverCacheDC = 0
    End If
    If mHoverCacheBmp <> 0 Then
        DeleteObject mHoverCacheBmp
        mHoverCacheBmp = 0
    End If
    mHoverCacheOldBmp = 0
    mHoverCacheWidth = 0
    mHoverCacheHeight = 0
    mHoverCacheTabs = 0
    mHoverCacheTab = -1
    mHoverCacheValid = False
End Sub

Private Function DragStripCacheUsable(ByVal nWidth As Long, ByVal nHeight As Long) As Boolean
    ' Whether the image kept on the previous frame may be pasted instead of painted again.
    Dim t As Long
    
    If Not mDragStripCacheValid Then Exit Function
    If mDragStripCacheDC = 0 Then Exit Function
    If mDragState <> cDragStateActive Then Exit Function
    If (mDragStripCacheWidth <> nWidth) Or (mDragStripCacheHeight <> nHeight) Then Exit Function
    If mDragStripCacheTabs <> mTabs Then Exit Function
    If mDragStripCacheTab <> mTab Then Exit Function
    If mDragGapOffsetsCount <> mTabs Then Exit Function
    If mDragStripCacheLayoutKey <> mStripLayoutKey Then Exit Function
    
    ' The gap is compared and not deduced from the insertion index: the row slide DragGapSlide
    ' adds can change without that index changing
    For t = 0 To mTabs - 1
        If mDragStripCacheGapX(t) <> DragGapDrawnX(t) Then Exit Function
    Next t
    DragStripCacheUsable = True
End Function

Private Sub DragStripCacheStore(ByVal nWidth As Long, ByVal nHeight As Long)
    Dim t As Long
    
    DragStripCacheRelease
    If (nWidth < 1) Or (nHeight < 1) Then Exit Sub
    If mTabs < 1 Then Exit Sub
    If mDragGapOffsetsCount <> mTabs Then Exit Sub
    
    ' Same pattern as DragSaveTabPixels, and it carries no SetLayout for the same reason: under
    ' RightToLeft whatever mirroring the picDraw layout applies on the way out is applied again, the
    ' opposite way, on the way back in, and both calls use the very same rectangle.
    mDragStripCacheDC = CreateCompatibleDC(picDraw.hDC)
    If mDragStripCacheDC = 0 Then Exit Sub
    mDragStripCacheBmp = CreateCompatibleBitmap(picDraw.hDC, nWidth, nHeight)
    If mDragStripCacheBmp = 0 Then
        DeleteDC mDragStripCacheDC
        mDragStripCacheDC = 0
        Exit Sub
    End If
    mDragStripCacheOldBmp = SelectObject(mDragStripCacheDC, mDragStripCacheBmp)
    BitBlt mDragStripCacheDC, 0, 0, nWidth, nHeight, picDraw.hDC, 0, 0, vbSrcCopy
    
    mDragStripCacheLayoutKey = mStripLayoutKey
    ReDim mDragStripCacheGapX(0 To mTabs - 1)
    For t = 0 To mTabs - 1
        mDragStripCacheGapX(t) = DragGapDrawnX(t)
    Next t
    mDragStripCacheWidth = nWidth
    mDragStripCacheHeight = nHeight
    mDragStripCacheTabs = mTabs
    mDragStripCacheTab = mTab
    mDragStripCacheValid = True
End Sub

Private Sub DragStripCacheRestore(ByVal nWidth As Long, ByVal nHeight As Long)
    BitBlt picDraw.hDC, 0, 0, nWidth, nHeight, mDragStripCacheDC, 0, 0, vbSrcCopy
End Sub

Private Sub DragStripCacheRelease()
    If mDragStripCacheDC <> 0 Then
        SelectObject mDragStripCacheDC, mDragStripCacheOldBmp
        DeleteDC mDragStripCacheDC
        mDragStripCacheDC = 0
    End If
    If mDragStripCacheBmp <> 0 Then
        DeleteObject mDragStripCacheBmp
        mDragStripCacheBmp = 0
    End If
    mDragStripCacheOldBmp = 0
    mDragStripCacheWidth = 0
    mDragStripCacheHeight = 0
    mDragStripCacheTabs = 0
    mDragStripCacheTab = -1
    mDragStripCacheValid = False
End Sub

Private Function DragSaveTabPixels(ByRef nRect As RECT, ByRef nBmp As LongPtr, ByRef nOldBmp As LongPtr) As LongPtr
    ' Keeps aside the pixels the dragged tab occupies on picDraw, so that they can be put back after
    ' the other tabs' captions have been painted over them.
    Dim iWidth As Long
    Dim iHeight As Long
    Dim iDC As LongPtr
    
    If nRect.Left < 0 Then nRect.Left = 0
    If nRect.Top < 0 Then nRect.Top = 0
    If nRect.Right > picDraw.ScaleWidth Then nRect.Right = picDraw.ScaleWidth
    If nRect.Bottom > picDraw.ScaleHeight Then nRect.Bottom = picDraw.ScaleHeight
    iWidth = nRect.Right - nRect.Left
    iHeight = nRect.Bottom - nRect.Top
    If (iWidth < 1) Or (iHeight < 1) Then Exit Function
    
    iDC = CreateCompatibleDC(picDraw.hDC)
    If iDC = 0 Then Exit Function
    nBmp = CreateCompatibleBitmap(picDraw.hDC, iWidth, iHeight)
    If nBmp = 0 Then
        DeleteDC iDC
        Exit Function
    End If
    nOldBmp = SelectObject(iDC, nBmp)
    BitBlt iDC, 0, 0, iWidth, iHeight, picDraw.hDC, nRect.Left, nRect.Top, vbSrcCopy
    DragSaveTabPixels = iDC
End Function

Private Sub DragRestoreTabPixels(ByRef nRect As RECT, ByVal nDC As LongPtr, ByVal nBmp As LongPtr, ByVal nOldBmp As LongPtr)
    BitBlt picDraw.hDC, nRect.Left, nRect.Top, nRect.Right - nRect.Left, nRect.Bottom - nRect.Top, nDC, 0, 0, vbSrcCopy
    SelectObject nDC, nOldBmp
    DeleteObject nBmp
    DeleteDC nDC
End Sub

Private Function DragGapOffset(ByVal nTab As Long) As Long
    ' How far this tab is drawn from its slot to make room for the tab being dragged.
    ' Zero for the dragged tab itself, which is placed by mDragDrawOffset*, and zero
    ' whenever there is no drag going on
    If Not DragOffsetsShown Then Exit Function
    If mDragGapOffsetsCount <> mTabs Then Exit Function
    If (nTab < 0) Or (nTab > (mTabs - 1)) Then Exit Function
    DragGapOffset = DragGapDrawnX(nTab)
    ' The gap is worked out on the unreversed strip, see DragSnapshotTabRects
    If mTabsOrderReversed Then DragGapOffset = -DragGapOffset
End Function

Private Function DragGapDrawnX(ByVal nTab As Long) As Long
    If mDragGapShownCount <> mTabs Then
        DragGapDrawnX = mDragGapOffsetX(nTab)
    Else
        DragGapDrawnX = Int(mDragGapShownX(nTab) + 0.5)
    End If
End Function

Private Sub DragAnimReset()
    If mTabs < 1 Then
        mDragGapShownCount = 0
        Exit Sub
    End If
    ReDim mDragGapShownX(0 To mTabs - 1)
    ReDim mDragGapFromX(0 To mTabs - 1)
    ReDim mDragGapTargetX(0 To mTabs - 1)
    ReDim mDragGapStartMark(0 To mTabs - 1)
    mDragGapShownCount = mTabs
    mDragAnimOn = mAmbientUserMode And SystemAnimationsOn
    tmrDragAnim.Enabled = False
End Sub

' A tab whose target moved starts a new slide from wherever it is drawn now, so a target that
' changes halfway never makes it jump
Private Sub DragAnimRetarget()
    Dim t As Long
    Dim iNow As Currency
    
    If mDragGapShownCount <> mTabs Then Exit Sub
    If mDragGapOffsetsCount <> mTabs Then Exit Sub
    QueryPerformanceCounter iNow
    For t = 0 To mTabs - 1
        If mDragGapOffsetX(t) <> mDragGapTargetX(t) Then
            mDragGapTargetX(t) = mDragGapOffsetX(t)
            If mDragAnimOn Then
                mDragGapFromX(t) = mDragGapShownX(t)
                mDragGapStartMark(t) = iNow
                tmrDragAnim.Enabled = True
            Else
                mDragGapShownX(t) = mDragGapTargetX(t)
            End If
        End If
    Next t
End Sub

' Advances every slide to where the clock says it should be (24.89). Returns whether any drawn
' position changed; nStillMoving says whether another frame is needed
Private Function DragAnimStep(ByRef nStillMoving As Boolean) As Boolean
    Dim t As Long
    Dim iFraction As Single
    Dim iBefore As Long
    
    nStillMoving = False
    If mDragGapShownCount <> mTabs Then Exit Function
    For t = 0 To mTabs - 1
        If mDragGapShownX(t) <> mDragGapTargetX(t) Then
            iBefore = Int(mDragGapShownX(t) + 0.5)
            iFraction = AnimElapsedMs(mDragGapStartMark(t)) / cDragAnimDurationMs
            If iFraction >= 1 Then
                mDragGapShownX(t) = mDragGapTargetX(t)
            Else
                iFraction = 1 - (1 - iFraction) ^ 3
                mDragGapShownX(t) = mDragGapFromX(t) + (mDragGapTargetX(t) - mDragGapFromX(t)) * iFraction
                nStillMoving = True
            End If
            If Int(mDragGapShownX(t) + 0.5) <> iBefore Then DragAnimStep = True
        End If
    Next t
End Function

Private Sub tmrDragAnim_Timer()
    Dim iStillMoving As Boolean
    
    If mDragSettling Then
        DragSettleStep
        Exit Sub
    End If
    If mDragState <> cDragStateActive Then
        tmrDragAnim.Enabled = False
        Exit Sub
    End If
    If DragAnimStep(iStillMoving) Then
        mDragStripCacheAllowed = True
        DrawDelayed
        UserControl.Refresh
    End If
    If Not iStillMoving Then tmrDragAnim.Enabled = False
End Sub

Private Sub DragSettleCapture()
    Dim t As Long
    
    mDragSettleCount = 0
    If Not mDragAnimOn Then Exit Sub
    If (mDragTabRectsCount <> mTabs) Or (mDragGapShownCount <> mTabs) Then Exit Sub
    If (mTab < 0) Or (mTab > (mTabs - 1)) Then Exit Sub
    ReDim mDragSettleKey(0 To mTabs - 1)
    ReDim mDragSettleOldLeft(0 To mTabs - 1)
    ReDim mDragSettleOldTop(0 To mTabs - 1)
    For t = 0 To mTabs - 1
        If mTabData(t).Visible And (mTabData(t).RowPos > -1) Then
            mDragSettleKey(t) = ObjPtr(mTabData(t).CustomColors)
            If t = mTab Then
                mDragSettleOldLeft(t) = mDragOriginLeft + mDragLogicalDX
                mDragSettleOldTop(t) = mDragOriginTop + mDragLogicalDY
            Else
                mDragSettleOldLeft(t) = mDragTabRectAsTop(t).Left + DragGapDrawnX(t)
                mDragSettleOldTop(t) = mDragTabRectAsTop(t).Top
            End If
        End If
    Next t
    mDragSettleActiveKey = ObjPtr(mTabData(mTab).CustomColors)
    mDragSettleCount = mTabs
End Sub

' Called after the drop has moved the records. A layout pass with the window not repainting gives
' the new slots, and every tab starts drawn where it was before the drop. Only the dropped tab
' changes rows while it settles; any other tab that landed in another band just appears there
Private Sub DragSettleBegin()
    Dim t As Long
    Dim o As Long
    Dim iKey As LongPtr
    Dim iWv As Boolean
    Dim iNow As Currency
    Dim iAny As Boolean
    
    If mDragSettleCount <> mTabs Then
        mDragSettleCount = 0
        Exit Sub
    End If
    mDragSettleCount = 0
    iWv = IsWindowVisible(mUserControlHwnd) <> 0
    If iWv Then SendMessage mUserControlHwnd, WM_SETREDRAW, False, 0&
    Draw
    If iWv Then SendMessage mUserControlHwnd, WM_SETREDRAW, True, 0&
    If mDragTabRectsCount <> mTabs Then Exit Sub
    If (mTab < 0) Or (mTab > (mTabs - 1)) Then Exit Sub
    
    DragClearGapOffsets
    DragAnimReset
    If (Not mDragAnimOn) Or (mDragGapShownCount <> mTabs) Then Exit Sub
    QueryPerformanceCounter iNow
    mDragSettleFromX = 0
    mDragSettleFromY = 0
    For t = 0 To mTabs - 1
        If mTabData(t).Visible And (mTabData(t).RowPos > -1) Then
            iKey = ObjPtr(mTabData(t).CustomColors)
            For o = 0 To mTabs - 1
                If mDragSettleKey(o) = iKey Then Exit For
            Next o
            If o < mTabs Then
                If iKey = mDragSettleActiveKey Then
                    If t = mTab Then
                        mDragSettleFromX = mDragSettleOldLeft(o) - mDragTabRectAsTop(t).Left
                        mDragSettleFromY = mDragSettleOldTop(o) - mDragTabRectAsTop(t).Top
                    End If
                ElseIf mDragSettleOldTop(o) = mDragTabRectAsTop(t).Top Then
                    mDragGapFromX(t) = mDragSettleOldLeft(o) - mDragTabRectAsTop(t).Left
                    mDragGapShownX(t) = mDragGapFromX(t)
                    mDragGapStartMark(t) = iNow
                    If mDragGapShownX(t) <> 0 Then iAny = True
                End If
            End If
        End If
    Next t
    If (mDragSettleFromX <> 0) Or (mDragSettleFromY <> 0) Then iAny = True
    If Not iAny Then
        mDragGapShownCount = 0
        Exit Sub
    End If
    mDragSettleShownX = mDragSettleFromX
    mDragSettleShownY = mDragSettleFromY
    mDragSettleMark = iNow
    mDragSettling = True
    DragSettleApplyActive
    tmrDragAnim.Enabled = True
End Sub

Private Sub DragSettleApplyActive()
    mDragDrawOffsetX = Int(mDragSettleShownX + 0.5)
    mDragDrawOffsetY = Int(mDragSettleShownY + 0.5)
    If mTabsOrderReversed Then mDragDrawOffsetX = -mDragDrawOffsetX
    DragMapToFinal mDragDrawOffsetX, mDragDrawOffsetY, mDragDrawOffsetXFinal, mDragDrawOffsetYFinal
End Sub

Private Sub DragSettleStep()
    Dim iStillMoving As Boolean
    Dim iMoved As Boolean
    Dim iFraction As Single
    Dim iBeforeX As Long
    Dim iBeforeY As Long
    
    iMoved = DragAnimStep(iStillMoving)
    iBeforeX = mDragDrawOffsetX
    iBeforeY = mDragDrawOffsetY
    iFraction = AnimElapsedMs(mDragSettleMark) / cDragAnimDurationMs
    If iFraction >= 1 Then
        mDragSettleShownX = 0
        mDragSettleShownY = 0
    Else
        iFraction = 1 - (1 - iFraction) ^ 3
        mDragSettleShownX = mDragSettleFromX * (1 - iFraction)
        mDragSettleShownY = mDragSettleFromY * (1 - iFraction)
        iStillMoving = True
    End If
    DragSettleApplyActive
    If (mDragDrawOffsetX <> iBeforeX) Or (mDragDrawOffsetY <> iBeforeY) Then iMoved = True
    If Not iStillMoving Then
        DragSettleCancel
        UserControl.Refresh
    ElseIf iMoved Then
        DrawDelayed
        UserControl.Refresh
    End If
End Sub

' Ends the settling at once, with every tab in its slot. Anything that changes the strip from
' outside goes through here first
Private Sub DragSettleCancel()
    If Not mDragSettling Then Exit Sub
    mDragSettling = False
    mDragGapShownCount = 0
    DragClearGapOffsets
    mDragDrawOffsetX = 0
    mDragDrawOffsetY = 0
    mDragDrawOffsetXFinal = 0
    mDragDrawOffsetYFinal = 0
    tmrDragAnim.Enabled = False
    DrawDelayed
End Sub

Private Sub DragClearGapOffsets()
    Dim t As Long
    
    If mTabs < 1 Then
        mDragGapOffsetsCount = 0
        Exit Sub
    End If
    If mDragGapOffsetsCount <> mTabs Then
        ReDim mDragGapOffsetX(0 To mTabs - 1) ' a fresh array is already all zeros
        mDragGapOffsetsCount = mTabs
        Exit Sub
    End If
    For t = 0 To mTabs - 1
        mDragGapOffsetX(t) = 0
    Next
End Sub

Private Sub DragUpdateGapOffsets()
    ' Nothing is reordered while a drag is going on.
    Dim t As Long
    Dim iCandidate As Long
    Dim iRow As Long
    Dim iAdvance As Long
    Dim iLeftShift As Long
    Dim iRightShift As Long
    Dim iSlide As Long
    
    DragClearGapOffsets
    If mDragState <> cDragStateActive Then Exit Sub
    If mDragTabRectsCount <> mTabs Then Exit Sub
    If (mTab < 0) Or (mTab > (mTabs - 1)) Then Exit Sub
    
    DragResolveInsertion iCandidate, iRow
    If iCandidate = -2 Then Exit Sub
    iAdvance = DragTabAdvance
    iLeftShift = DragGapLeftShift(iCandidate, iRow, iAdvance)
    iRightShift = iAdvance - iLeftShift
    
    If mTabData(mTab).RowPos = iRow Then
        ' The tab would drop into its own row.
        If iCandidate >= mTab Then
            For t = mTab + 1 To iCandidate
                If mTabData(t).Visible Then
                    If mTabData(t).RowPos = iRow Then mDragGapOffsetX(t) = -iAdvance
                End If
            Next
        Else
            For t = iCandidate + 1 To mTab - 1
                If mTabData(t).Visible Then
                    If mTabData(t).RowPos = iRow Then mDragGapOffsetX(t) = iAdvance
                End If
            Next
        End If
    Else
        ' Another row.
        For t = 0 To mTabs - 1
            If mTabData(t).Visible Then
                If mTabData(t).RowPos = iRow Then
                    If t <= iCandidate Then
                        mDragGapOffsetX(t) = -iLeftShift
                    Else
                        mDragGapOffsetX(t) = iRightShift
                    End If
                End If
            End If
        Next
    End If
    
    ' A row with no room to spare is slid back as a block so that the end nearest the gap
    ' stays in sight (see DragGapSlide). It is the same slide the landing places already
    ' carry, so the gap is drawn exactly where the choice between them put it
    iSlide = DragGapSlide(iCandidate, iRow, iAdvance)
    If iSlide > 0 Then
        For t = 0 To mTabs - 1
            If mTabData(t).Visible Then
                If mTabData(t).RowPos = iRow Then mDragGapOffsetX(t) = mDragGapOffsetX(t) - iSlide
            End If
        Next
    End If
    DragAnimRetarget
End Sub

Private Function TabIsNewTabButton(ByVal nTab As Long) As Boolean
    ' Single place that answers whether a tab is the new tab button. The mark used to be
    ' Data = -1, which could not survive the button leaving TDI mode: Data is a public
    ' property, so a developer storing -1 in a tab of his own would have turned it into
    ' the button. The flag is ours, and it travels with the tab record through MoveTab,
    ' MoveTabInternal and the whole record copies of the layout
    If (nTab < 0) Or (nTab > (mTabs - 1)) Then Exit Function
    TabIsNewTabButton = mTabData(nTab).IsNewTabButton
End Function

Private Function TabIsOwnedByControl(ByVal nTab As Long) As Boolean
    ' Tabs the developer did not put there and cannot reorder: the new tab button, and the
    ' placeholder each TDI mode keeps at one end.
    If (nTab < 0) Or (nTab > (mTabs - 1)) Then Exit Function
    If TabIsNewTabButton(nTab) Then
        TabIsOwnedByControl = True
    ElseIf mTDIMode <> ntTDIModeNone Then
        TabIsOwnedByControl = (nTab = 0) ' the TDI Forms placeholder and the TDI Controls template
    End If
End Function

Private Function NewTabButtonInvariantHolds() As Boolean
    ' Checked with Debug.Assert in Draw, so it costs nothing in the compiled control: VB drops
    ' those lines.
    Dim c As Long
    Dim iCount As Long
    
    For c = 0 To mTabs - 1
        If mTabData(c).IsNewTabButton Then
            iCount = iCount + 1
            If c <> (mTabs - 1) Then Exit Function
        End If
    Next c
    NewTabButtonInvariantHolds = (iCount < 2)
End Function

Private Function TabsWithoutNewTabButton() As Long
    ' The tab count as the developer sees it.
    TabsWithoutNewTabButton = mTabs
    If TabIsNewTabButton(mTabs - 1) Then TabsWithoutNewTabButton = mTabs - 1
End Function

Private Function VisibleTabsWithoutNewTabButton() As Long
    ' The same idea as TabsWithoutNewTabButton, applied to mVisibleTabs. mVisibleTabs itself is not
    ' changed: it is what the layout counts with, and the button is drawn, so there it belongs.
    VisibleTabsWithoutNewTabButton = mVisibleTabs
    If TabIsNewTabButton(mTabs - 1) Then
        If mTabData(mTabs - 1).Visible Then VisibleTabsWithoutNewTabButton = mVisibleTabs - 1
    End If
End Function

Private Function IsValidTabIndex(ByVal nTabIndex As Long) As Boolean
    ' Used by every per tab property to validate the index it was given. Deliberately not
    ' used by Property Let TabSel, which has to keep accepting the button: clicking it is
    ' how a new tab gets added, and that click arrives here as TabSel = <button index>
    IsValidTabIndex = (nTabIndex >= 0) And (nTabIndex < TabsWithoutNewTabButton)
End Function

' For the members that only report where something is drawn: the new tab button is drawn like a tab
Private Function IsValidTabIndexOrNewTabButton(ByVal nTabIndex As Long) As Boolean
    IsValidTabIndexOrNewTabButton = (nTabIndex >= 0) And (nTabIndex < mTabs)
End Function

' Read from the records and not from mVisibleTabs, which is only brought up to date by Draw
Private Function RealTabVisible() As Boolean
    Dim c As Long
    
    For c = 0 To mTabs - 1
        If mTabData(c).Visible And (Not TabIsNewTabButton(c)) Then
            RealTabVisible = True
            Exit Function
        End If
    Next
End Function

' At run time the control can be left with no tab of the developer's own, as with all of them hidden:
' the strip shows the new tab button alone if there is one, and Tab is -1. At design time a control
' saved without tabs is not something anyone needs
Private Function MinimumTabCount() As Long
    If Not mAmbientUserMode Then MinimumTabCount = 1
End Function

Private Function IsValidTabKey(ByVal nKey As String) As Boolean
    ' An empty string is an acceptable value for the TabKey property, it means "no key", but it is
    ' deliberately NOT a valid key, and the callers gate on nKey <> "" before asking.
    If nKey = "" Then Exit Function
    IsValidTabKey = Not IsNumeric(Left$(nKey, 1))
End Function

Private Function TabKeyExists(ByVal nKey As String, Optional ByVal nExcludeTab As Long = -1) As Boolean
    ' Built on FindTab so that a single place decides how two keys compare.
    Dim iFound As Long

    ' FindTab would match the first tab that has no key at all, so "" never reaches it
    If nKey = "" Then Exit Function
    iFound = FindTab(nKey, ntFindKey)
    If (iFound >= 0) And (iFound = nExcludeTab) Then
        ' the only match is the tab being renamed. Keep looking instead of assuming keys are
        ' unique: ReadProperties assigns them without validating, so a hand edited form file
        ' can bring duplicates in
        iFound = FindTab(nKey, ntFindKey, iFound + 1)
    End If
    TabKeyExists = (iFound <> -1)
End Function

Private Function FirstTabWithControls(ByVal nFrom As Long, ByVal nTo As Long) As Long
    Dim c As Long
    Dim c2 As Long
    
    FirstTabWithControls = -1
    For c = nFrom To nTo
        ' At run time a tab's list is rebuilt only when the tab is left, so a control unloaded while
        ' its tab was not selected is still named in it
        If mAmbientUserMode Then
            For c2 = mTabData(c).Controls.Count To 1 Step -1
                If GetContainedControlByName(mTabData(c).Controls(c2)) Is Nothing Then mTabData(c).Controls.Remove c2
            Next
        End If
        If mTabData(c).Controls.Count > 0 Then
            FirstTabWithControls = c
            Exit Function
        End If
    Next c
End Function

Private Sub RaiseError_CantRemoveTabsWithControls(ByVal nTab As Long)
    ' One number for the condition, whatever member ran into it, and not the 380 this used to raise.
    RaiseError 1390, TypeName(Me), "Can't remove tabs with controls. Tab " & CStr(nTab) & " has contained controls, remove them first."
End Sub

Private Function TabCountChangeAllowed() As Boolean
    ' In TDI mode the control owns the tab model, so the developer is not allowed to change
    ' the count at design time. The internal paths set mTDIChangingTabCount around their own
    ' calls, which is what tells the two apart
    If mTDIMode <> ntTDIModeNone Then
        If Not mAmbientUserMode Then
            If Not mTDIChangingTabCount Then
                RaiseError 1380, TypeName(Me), "Can't change Tabs in TDI mode"
                Exit Function
            End If
        End If
    End If
    TabCountChangeAllowed = True
End Function

Private Function TabIsSelectableEffective(ByVal nTab As Long) As Boolean
    ' Keyboard navigation must skip the new tab button.
    If (nTab < 0) Or (nTab > (mTabs - 1)) Then Exit Function
    TabIsSelectableEffective = mTabData(nTab).Enabled And mTabData(nTab).Visible And Not TabIsNewTabButton(nTab)
End Function

Private Function NeighborTabForSelection(ByVal nFrom As Long) As Long
    ' Picks the tab the selection lands on when the one at nFrom stops being available, and returns
    ' -1 when there is none.
    Dim c As Long
    
    NeighborTabForSelection = -1
    c = nFrom - 1
    Do Until c < 0
        If TabIsSelectableEffective(c) Then
            Exit Do
        End If
        c = c - 1
    Loop
    If c = -1 Then
        c = nFrom + 1
        Do Until c = mTabs
            If TabIsSelectableEffective(c) Then
                Exit Do
            End If
            c = c + 1
        Loop
    End If
    If (c < 0) Or (c > (mTabs - 1)) Then
        c = nFrom - 1
        Do Until c < 0
            If mTabData(c).Visible And Not TabIsNewTabButton(c) Then
                Exit Do
            End If
            c = c - 1
        Loop
        If c = -1 Then
            c = nFrom + 1
            Do Until c = mTabs
                If mTabData(c).Visible And Not TabIsNewTabButton(c) Then
                    Exit Do
                End If
                c = c + 1
            Loop
        End If
    End If
    If (c > -1) And (c < mTabs) Then NeighborTabForSelection = c
End Function

' The buttons of the strip are placed against a tab of the row, and a tab that is drawn taller than
' the rest is no reference: they would rise and fall with the pointer
Private Function TabIsDrawnWithExtraHeight(ByVal nTab As Long) As Boolean
    If nTab = mTab Then
        TabIsDrawnWithExtraHeight = mHighlightAddExtraHeightSelectedTab
    Else
        TabIsDrawnWithExtraHeight = mHighlightAddExtraHeight And TabShowsDiscreteHighlight(nTab)
    End If
End Function

Private Function TabIsMovableEffective(ByVal nTab As Long) As Boolean
    ' A tab that may not be moved is also a tab that others cannot push out of the way, so it splits
    ' the strip into zones a drag cannot cross (see DragSetZone).
    TabIsMovableEffective = True
    If (nTab < 0) Or (nTab > (mTabs - 1)) Then Exit Function
    If TabIsOwnedByControl(nTab) Then TabIsMovableEffective = False
    If Not mTabData(nTab).Movable Then TabIsMovableEffective = False
End Function

Private Function NextVisibleTabInRow(ByVal nTab As Long) As Long
    Dim t As Long
    
    NextVisibleTabInRow = -1
    If (nTab < 0) Or (nTab > (mTabs - 1)) Then Exit Function
    For t = nTab + 1 To mTabs - 1
        If mTabData(t).Visible Then
            If mTabData(t).RowPos = mTabData(nTab).RowPos Then NextVisibleTabInRow = t
            Exit For
        End If
    Next
End Function

Private Function PreviousVisibleTabInRow(ByVal nTab As Long) As Long
    Dim t As Long
    
    PreviousVisibleTabInRow = -1
    If (nTab < 0) Or (nTab > (mTabs - 1)) Then Exit Function
    For t = nTab - 1 To 0 Step -1
        If mTabData(t).Visible Then
            If mTabData(t).RowPos = mTabData(nTab).RowPos Then PreviousVisibleTabInRow = t
            Exit For
        End If
    Next
End Function

Private Function FirstVisibleTab() As Long
    Dim t As Long
    
    FirstVisibleTab = -1
    For t = 0 To mTabs - 1
        If mTabData(t).Visible Then
            FirstVisibleTab = t
            Exit Function
        End If
    Next
End Function

Private Function PreviousVisibleTab(ByVal nTab As Long) As Long
    Dim t As Long
    
    PreviousVisibleTab = -1
    For t = nTab - 1 To 0 Step -1
        If mTabData(t).Visible Then
            PreviousVisibleTab = t
            Exit For
        End If
    Next
End Function

Private Sub MoveTabInternal(ByVal nCurrentIndex As Long, ByVal nNewIndex As Long)
    ' Reorders mTabData and nothing else: no events, no reselection, no rebuilding of the icon font
    ' handlers. This is what a tab being dragged uses to hop from one position to the next.
    Dim iTempTabData As T_TabData
    Dim c As Long
    
    If nNewIndex = nCurrentIndex Then Exit Sub
    If (nCurrentIndex < 0) Or (nCurrentIndex > (mTabs - 1)) Then Exit Sub
    If (nNewIndex < 0) Or (nNewIndex > (mTabs - 1)) Then Exit Sub
    
    iTempTabData = mTabData(nCurrentIndex)
    If nNewIndex > nCurrentIndex Then
        For c = nCurrentIndex + 1 To nNewIndex
            mTabData(c - 1) = mTabData(c)
        Next
    Else
        For c = nCurrentIndex - 1 To nNewIndex Step -1
            mTabData(c + 1) = mTabData(c)
        Next
    End If
    mTabData(nNewIndex) = iTempTabData
    If mTab = nCurrentIndex Then
        mTab = nNewIndex
    ElseIf nNewIndex > nCurrentIndex Then
        If (mTab > nCurrentIndex) And (mTab <= nNewIndex) Then mTab = mTab - 1
    Else
        If (mTab >= nNewIndex) And (mTab < nCurrentIndex) Then mTab = mTab + 1
    End If
    ' The icon font handlers live in a collection keyed by ObjPtr(font) and tab index, so that one
    ' Font object registered on several tabs can be dropped from one of them alone.
    RecreateTabIconFontsEventHandler
    ' mAccessKeys is positional too: UserControl_AccessKeyPress turns the position of the
    ' character inside that string into a tab index, so once the records move, Alt+letter
    ' activates whichever tab now sits where the old one was. Rebuilt on the next draw
    mAccessKeysSet = False
End Sub


