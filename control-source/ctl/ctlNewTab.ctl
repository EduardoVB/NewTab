Public Property Get ShowDisabledState() As Boolean
Attribute ShowDisabledState.VB_Description = "Returns/sets a value that determines if the tabs are painted in a disabled variant of their color when the control is disabled."
Attribute ShowDisabledState.VB_ProcData.VB_Invoke_Property = ";Appearance"
    ShowDisabledState = mShowDisabledState
End Property

Public Property Let ShowDisabledState(ByVal nValue As Boolean)
    If nValue <> mShowDisabledState Then
        mShowDisabledState = nValue
        SetPropertyChanged "ShowDisabledState"
        mBodyReset = True
        DrawDelayed
        If mChangeControlsBackColor Then
            SetControlsProperBackColor
        End If
    End If
End Property


Public Property Get Redraw() As Boolean
Attribute Redraw.VB_Description = "Returns/sets a value that determines if the drawing of the control is enabled."
Attribute Redraw.VB_MemberFlags = "400"
    Redraw = mRedraw
End Property

Public Property Let Redraw(ByVal nValue As Boolean)
    If nValue <> mRedraw Then
        mRedraw = nValue
        If mRedraw Then
            If mNeedToDraw Or mDrawMessagePosted Or tmrDraw.Enabled Then
                Draw
            End If
        End If
    End If
End Property


Public Property Get UseMaskColor() As Boolean
Attribute UseMaskColor.VB_Description = "Returns/sets a value that determines whether the color assigned in the MaskColor property is used as a mask. (That is, used to create transparent regions.)"
Attribute UseMaskColor.VB_ProcData.VB_Invoke_Property = ";Icon"
    UseMaskColor = mUseMaskColor
End Property

Public Property Let UseMaskColor(ByVal nValue As Boolean)
    If nValue <> mUseMaskColor Then
        mUseMaskColor = nValue
        ' same two regimes as MaskColor: baked into PicToUse when the picture is
        ' scaled, applied at draw time when it is not
        ResetAllPicsToUse
        SetPropertyChanged "UseMaskColor"
        DrawDelayed
    End If
End Property


Public Property Get ScalePicturesForDPI() As NTScalePicturesForDPIConstants
Attribute ScalePicturesForDPI.VB_Description = "Returns/sets whether the pictures set in TabPicture are scaled to the current DPI, and what the scaler favors when it does: smooth curves, sharp angles, or a balance of both. They are assumed to be authored for 96 DPI."
Attribute ScalePicturesForDPI.VB_ProcData.VB_Invoke_Property = ";Icon"
    ScalePicturesForDPI = mScalePicturesForDPI
End Property

Public Property Let ScalePicturesForDPI(ByVal nValue As NTScalePicturesForDPIConstants)
    Select Case nValue
        Case ntScalePicturesDisabled, ntScalePicturesSmooth, ntScalePicturesCrisp, ntScalePicturesBalanced
        Case Else
            RaiseError 380, TypeName(Me) ' invalid property value
            Exit Property
    End Select
    If nValue <> mScalePicturesForDPI Then
        mScalePicturesForDPI = nValue
        ResetAllPicsToUse
        mSetAutoTabHeightPending = True
        SetPropertyChanged "ScalePicturesForDPI"
        DrawDelayed
    End If
End Property


Public Property Get TDIFormsIconSize() As NTTDIFormsIconSizeConstants
Attribute TDIFormsIconSize.VB_Description = "When in TDI mode forms, returns/sets the size the icons of the hosted forms are shown at, given as their size at 96 DPI - so it follows the DPI, like the TabPic16/20/24 properties do. Form icons are 32x32, which is usually too large for a tab. The TDIFormsShowTabIcon event can override it for one tab."
Attribute TDIFormsIconSize.VB_ProcData.VB_Invoke_Property = ";Icon"
    TDIFormsIconSize = mTDIFormsIconSize
End Property

Public Property Let TDIFormsIconSize(ByVal nValue As NTTDIFormsIconSizeConstants)
    Select Case nValue
        Case ntTDIFormsIconNative, ntTDIFormsIcon16, ntTDIFormsIcon20, ntTDIFormsIcon24, ntTDIFormsIcon32, ntTDIFormsIcon48
        Case Else
            RaiseError 380, TypeName(Me) ' invalid property value
            Exit Property
    End Select
    If nValue <> mTDIFormsIconSize Then
        mTDIFormsIconSize = nValue
        ' the size is decided while syncing from the form, so the sync has to run
        ' again before the new value can reach anything
        TDIInvalidateFormIcons
        ResetAllPicsToUse
        SetPropertyChanged "TDIFormsIconSize"
        DrawDelayed
    End If
End Property


