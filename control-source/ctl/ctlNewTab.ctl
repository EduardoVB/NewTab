    TabVisible = mTabData(iIndex).Visible
End Property

Public Property Let TabVisible(ByVal nTab As Variant, ByVal nValue As Boolean)
    Dim c As Long
    Dim iSetSelectedTab As Boolean
    Dim iIndex As Long
    
    iIndex = GetTabIndex(nTab)
    If Not IsValidTabIndex(iIndex) Then
        RaiseError 381, TypeName(Me) ' invalid property array index
        Exit Property
    End If
    If nValue <> mTabData(iIndex).Visible Then
        If mNoTabVisible Then
            If nValue Then
                iSetSelectedTab = True
            End If
        End If
        ' And Not nValue: everything in here looks for a replacement for a selection that is about
        ' to disappear, which makes no sense while a tab is being shown.
        If (mTab = iIndex) And (Not nValue) Then
            ' The tab being hidden is the selected one, so the selection has to land
            ' somewhere else. The search lives in NeighborTabForSelection because RemoveTab
            ' needs the very same one, for the very same reason
            c = NeighborTabForSelection(mTab)
            If c > -1 Then
                TabSel = c
                If mTab = c Then ' the change could had been canceled through the BeforeClick event, in that case TabSel woudn't change
                    mTabData(iIndex).Visible = nValue
                    mTabData(iIndex).Selected = False
                End If
            Else
                mNoTabVisible = True
                mTabData(iIndex).Visible = nValue
                mTabData(iIndex).Selected = False
                mTab = -1
                HideAllContainedControls
            End If
        Else
            mTabData(iIndex).Visible = nValue
            If ((mTab < 0) Or (mTab > (mTabs - 1))) And (Not iSetSelectedTab) Then
                TabSel = iIndex
                mTabData(iIndex).Selected = True
            End If
        End If
        ' A tab is on screen again after every one of them had been hidden.
        If iSetSelectedTab Then
            mNoTabVisible = False
            mReSelTab = True
            TabSel = iIndex
            mReSelTab = False
        End If
        mAccessKeysSet = False
        SetPropertyChanged "TabVisible"
        mBodyReset = True
        ' the height is the tallest icon among the tabs, so hiding or showing one
        ' can change it - and a TDI tab is closed by being hidden, not removed
        mSetAutoTabHeightPending = True
        DrawDelayed
    End If
End Property


